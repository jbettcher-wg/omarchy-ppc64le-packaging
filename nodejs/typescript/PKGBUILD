# Contributor: Felix Yan <felixonmars@archlinux.org>
# Contributor: Bruno Galeotti <bgaleotti at gmail dot com>

_name=TypeScript
pkgname=typescript
pkgver=6.0.3
pkgrel=1
pkgdesc='JavaScript with syntax for types'
arch=(any)
url=http://www.typescriptlang.org
license=(Apache-2.0)
depends=(nodejs)
makedepends=(
  git
  npm
  rsync
)
source=("git+https://github.com/microsoft/$_name.git#tag=v$pkgver")
b2sums=('88d24a857f85e695e32b5d4b1bdff74cdbe6f3e46c12c00cebdf927412d9446e2592b34b9d05bd089c89ab9a0d4fd76ec77845be1b69b78fadc32dedffd06e74')

prepare() {
  cd $_name
  # --ignore-scripts, and it is ppc64le-specific: the `dprint` CLI devDependency
  # ships a prebuilt binary and its install.js aborts with "Unsupported
  # architecture ppc64. Only x64, aarch64, and riscv64 binaries are available."
  # Nothing in `hereby LKG` runs it -- it backs only the format/check-format
  # tasks and the `format` npm script. The @dprint/formatter and
  # @dprint/typescript packages that scripts/dtsBundler.mjs does use are wasm
  # (createFromBuffer on a .wasm) and are arch-independent, so they still work.
  #
  # Arch POWER's 5.8.3 recipe solved this with 0001-Remove-dprint.patch; that
  # patch deletes 223 lines of package-lock.json and does not survive the bump
  # to 6.0.3. One flag replaces it. The stale 000{1,2,3}-*.patch files in this
  # directory are from 5.8.3 and are no longer referenced.
  npm ci --ignore-scripts
}

build() {
  cd $_name
  npx hereby LKG
}

check() {
  cd $_name
  npm run test
}

package() {
  local mod_dir=/usr/lib/node_modules/$pkgname

  install -d "$pkgdir"/{usr/bin,$mod_dir}
  ln -s $mod_dir/bin/{tsc,tsserver} "$pkgdir"/usr/bin

  cd $_name
  rsync -r --exclude=.gitattributes bin lib package.json "$pkgdir"/$mod_dir
  install -Dm644 -t "$pkgdir"/usr/share/doc/$pkgname README.md SECURITY.md
  install -Dm644 -t "$pkgdir"/usr/share/licenses/$pkgname \
    ThirdPartyNoticeText.txt
}

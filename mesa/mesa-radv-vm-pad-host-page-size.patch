From: Jordan Bettcher <thebettcher@gmail.com>
Date: Tue, 22 Sep 2026 16:50:00 -0600
Subject: [PATCH] radv/amdgpu: size the VM_PAD_1PAGE padding by the host page
 size

radv_amdgpu_bo_va_op() rounds the size of every VA operation up to the
host page size:

    size = align64(size, getpagesize());

but the RADEON_FLAG_VM_PAD_1PAGE padding page is both reserved and
placed assuming a 4096-byte page:

    radv_amdgpu_bo_va_size():
        return align64(bo_size, 4096) + 4096;

    radv_amdgpu_winsys_bo_create():
        radv_amdgpu_bo_va_op(ws, kms_handle, 0, 4096,
                             va + align64(size, 4096), ...);

On a host whose page size is 4096 these agree. On a host with a larger
page size they do not: the BO's own mapping is rounded up to the host
page size, so it already covers the address the padding page is placed
at. The kernel refuses the overlapping map in amdgpu_vm_bo_map():

    tmp = amdgpu_vm_it_iter_first(&vm->va, saddr, eaddr);
    if (tmp) {
            /* bo and tmp overlap, invalid addr */
            dev_err(adev->dev, "bo %p va 0x%010llx-0x%010llx conflict "
                    "with 0x%010llx-0x%010llx\n", ...);
            return -EINVAL;
    }

Observed on ppc64le (POWER9, 64KiB pages) with a Vega 10 (Radeon Pro
WX 9100), where every Vulkan client died on startup:

  amdgpu 0003:03:00.0: bo ... va 0x0800100091-0x08001000a0 \
      conflict with 0x0800100090-0x08001000a0

The two ranges are one 4096-byte GPU page apart -- exactly the
hardcoded padding offset -- and each spans 64KiB, the host page size.

RADEON_FLAG_VM_PAD_1PAGE is set when has_smem_partial_oob_access_bug is
set, which is GFX9 except Renoir and Raven2, so this only affects Vega
on large-page hosts; GFX10+ never takes the path.

Use getpagesize() for both the reservation and the placement so the VA
layout matches the granularity the mapping actually uses.
---
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c | 22 +++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
@@ -93,8 +93,13 @@
 radv_amdgpu_bo_va_size(uint64_t bo_size, uint32_t flags)
 {
    if (flags & RADEON_FLAG_VM_PAD_1PAGE) {
-      const uint64_t va_padding = 4096;
-      return align64(bo_size, 4096) + va_padding;
+      /* radv_amdgpu_bo_va_op() rounds every VA operation up to the host page size, so the VA
+       * reservation has to use that same granularity. Assuming 4096 here under-reserves on hosts
+       * with a larger page size (e.g. 64KiB on ppc64le), and the padding page then lands inside
+       * the BO's own mapping.
+       */
+      const uint64_t va_padding = getpagesize();
+      return align64(bo_size, va_padding) + va_padding;
    }

    return bo_size;
@@ -651,9 +656,14 @@
    }

    if (flags & RADEON_FLAG_VM_PAD_1PAGE) {
-      /* Map the first page of the same BO as read-only after the BO itself. */
-      r = radv_amdgpu_bo_va_op(ws, kms_handle, 0, 4096, va + align64(size, 4096), flags | RADEON_FLAG_READ_ONLY, 0,
-                               AMDGPU_VA_OP_MAP);
+      /* Map the first page of the same BO as read-only after the BO itself. The BO's own mapping
+       * above was rounded up to the host page size by radv_amdgpu_bo_va_op(), so the padding page
+       * must be placed with the same alignment, otherwise it overlaps that mapping and the kernel
+       * rejects the map with -EINVAL.
+       */
+      const uint64_t va_padding = getpagesize();
+      r = radv_amdgpu_bo_va_op(ws, kms_handle, 0, va_padding, va + align64(size, va_padding),
+                               flags | RADEON_FLAG_READ_ONLY, 0, AMDGPU_VA_OP_MAP);
       if (r) {
          result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
          goto error_va_map;

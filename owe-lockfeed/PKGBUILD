# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Upstream maintainer: owe contributors
#
# The lock screen video feed QML module for OWE (Owe.LockFeed). Omarchy 4.5's
# migration 1789764927 installs it together with owe. Taken from upstream's
# own recipe (github.com/omacom/omarchy-pkgs, pkgbuilds/owe-lockfeed at
# 914afbff9505); the version is Omarchy's stable channel
# (pkgs.omarchy.org/stable owe-lockfeed 0.2.11-1). It builds the qml-plugin/
# directory of the owe v0.2.11 tag, which is why it trails owe's 0.2.14.
#
# ppc64le: powerpc64le added to arch=(), nothing else. A small Qt 6 C++ plugin
# with nothing architecture-specific in it.

pkgname=owe-lockfeed
pkgver=0.2.11
pkgrel=1
pkgdesc="Lock screen video feed module for the OWE wallpaper engine"
arch=('x86_64' 'aarch64' 'powerpc64le')
url="https://github.com/omacom/owe"
license=('MIT')
depends=('qt6-declarative')
makedepends=('cmake' 'qt6-declarative')
source=("$pkgname-$pkgver.tar.gz::https://github.com/omacom/owe/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f82260781a711e0e168a5c80ac7d793cab91bfc0e0e5108b9e4c715e734fecc7')

build() {
  cmake -S "$srcdir/owe-$pkgver/qml-plugin" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # QML resolves the module by this directory; fail rather than ship a
  # package the lock screen cannot import.
  test -s "$pkgdir/usr/lib/qt6/qml/Owe/LockFeed/qmldir"
  test -f "$pkgdir/usr/lib/qt6/qml/Owe/LockFeed/libowe_lockfeed.so"
}

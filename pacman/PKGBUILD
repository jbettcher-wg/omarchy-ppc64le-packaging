pkgver() {
  cd "$pkgname"
  git describe --abbrev=7 --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$pkgname"

  # apply patch level commits on top of annotated tag
  if [[ -n ${_git_patch_level_commit} ]]; then
    if [[ v${_git_tag} != $(git describe --tags --abbrev=0 "${_git_patch_level_commit}") ]] then
      error "patch level commit ${_git_patch_level_commit} is not a descendant of v${_git_tag}"
      exit 1
    fi
    git rebase "${_git_patch_level_commit}"
  fi

  # handle patches
  local -a patches
  patches=($(printf '%s\n' "${source[@]}" | grep '.patch'))
  patches=("${patches[@]%%::*}")
  patches=("${patches[@]##*/}")

  if (( ${#patches[@]} != 0 )); then
    for patch in "${patches[@]}"; do
      if [[ $patch =~ revertme-* ]]; then
        msg2 "Reverting patch $patch..."
        patch -RNp1 < "../$patch"
      else
        msg2 "Applying patch $patch..."
        patch -Np1 < "../$patch"
      fi
    done
  fi

  if [[ $CARCH == powerpc64le ]]; then
    _power_confs
  fi
}

# Omarchy for POWER: Arch's pacman.conf, makepkg.conf, fortran.conf and
# rust.conf describe x86_64. Retarget them at the pool this package is built
# for, so each pool's pacman ships the flags that pool's own packages are built
# with: -mcpu/-mtune come from this build's CFLAGS, power9 in omarchy-power9
# and power8 in omarchy-ppc64le (the POWER8 drop-in rewrites them). Only flags
# x86 alone has go (-march=x86-64, -fcf-protection,
# -mno-omit-leaf-frame-pointer), plus -fno-plt, which neither pool is built
# with. The rest is Arch's, _FORTIFY_SOURCE=3 and DT_RELR included. The
# asserts make an Arch change to these files fail the build instead of
# shipping x86 flags.
_power_confs() {
  local cpu tune
  cpu=$(grep -o -- '-mcpu=power[0-9]*' <<< "$CFLAGS" | tail -n1)
  tune=$(grep -o -- '-mtune=power[0-9]*' <<< "$CFLAGS" | tail -n1)
  cpu=${cpu#-mcpu=} tune=${tune#-mtune=}
  case $cpu in
    power8|power9) ;;
    *) error "CFLAGS name no -mcpu=power8 or power9: $CFLAGS"; return 1 ;;
  esac
  tune=${tune:-$cpu}

  local f
  for f in makepkg.conf fortran.conf; do
    sed -i -e 's/^CARCH="x86_64"$/CARCH="powerpc64le"/' \
           -e 's/^CHOST="x86_64-pc-linux-gnu"$/CHOST="powerpc64le-unknown-linux-gnu"/' \
           -e "s/-march=x86-64 -mtune=generic/-mcpu=$cpu -mtune=$tune/" \
           -e 's/ -fno-plt\b//g; s/ -fcf-protection\b//g' \
           -e 's/ -mno-omit-leaf-frame-pointer\b//g' \
           "$srcdir/$f"
  done
  grep -q target-cpu "$srcdir/rust.conf" ||
    sed -i "s/^RUSTFLAGS=\"/&-C target-cpu=pwr${cpu#power} /" "$srcdir/rust.conf"

  # The pools first, then Arch POWER for what they do not carry yet. The
  # pools are unsigned until package signing rolls out (PackageNever: a
  # missing .sig on R2 returns a 404 page larger than pacman accepts).
  local p9='#'
  [[ $cpu == power9 ]] && p9=
  cat > "$srcdir/omarchy-repos" <<EOF
# Omarchy for POWER. [omarchy-ppc64le] runs on POWER8 and later.
# [omarchy-power9] holds POWER9-tuned builds and is opt-in: listed above
# the baseline pool, its build wins where both carry a package.
${p9}[omarchy-power9]
${p9}SigLevel = PackageNever DatabaseOptional TrustAll
${p9}Server = https://omappc64le.download/omarchy-power9

[omarchy-ppc64le]
SigLevel = PackageNever DatabaseOptional TrustAll
Server = https://omappc64le.download/omarchy-ppc64le

# Arch POWER, for what the pools above do not carry yet.
[base-any]
Server = https://repo.archlinuxpower.org/base/any

[base]
Server = https://repo.archlinuxpower.org/base/\$arch
EOF
  # Replace Arch's repository block, from the testing note through the
  # commented [multilib] entry; the [custom] example after it stays.
  awk -v r="$srcdir/omarchy-repos" '
    /^# The testing repositories are disabled by default/ {
      while ((getline l < r) > 0) print l
      skip = 1; n++; next
    }
    skip && prev == "#[multilib]" && /^#Include = / { skip = 0; next }
    skip { prev = $0; next }
    { print }
    END { exit (n == 1 && !skip) ? 0 : 1 }' "$srcdir/pacman.conf" > "$srcdir/pacman.conf.new" ||
    { error "pacman.conf: Arch's repository block is not where expected"; return 1; }
  mv "$srcdir/pacman.conf.new" "$srcdir/pacman.conf"

  local bad
  if bad=$(grep -hvE '^[[:space:]]*#' "$srcdir"/{makepkg,fortran}.conf |
           grep -E 'x86|-march=|generic|-fcf-protection|-fno-plt|leaf-frame-pointer'); then
    error "x86 flags survived the retarget: $bad"; return 1
  fi
  grep -qx 'CARCH="powerpc64le"' "$srcdir/makepkg.conf" &&
    grep -qx 'CHOST="powerpc64le-unknown-linux-gnu"' "$srcdir/makepkg.conf" &&
    grep -q -- "-mcpu=$cpu -mtune=$tune" "$srcdir/makepkg.conf" &&
    grep -q -- "-mcpu=$cpu -mtune=$tune" "$srcdir/fortran.conf" &&
    grep -q "target-cpu=pwr${cpu#power} " "$srcdir/rust.conf" &&
    grep -qx '\[omarchy-ppc64le\]' "$srcdir/pacman.conf" &&
    ! grep -qE '^\[(core|extra)\]|^Include' "$srcdir/pacman.conf" ||
    { error "retargeting pacman's config files did not take"; return 1; }
  msg2 "config files retargeted at $cpu (-mtune=$tune)"
}

build() {
  cd "$pkgname"

  meson --prefix=/usr \
        --buildtype=plain \
        -Ddoc=enabled \
        -Ddoxygen=enabled \
        -Dscriptlet-shell=/usr/bin/bash \
        -Dldconfig=/usr/bin/ldconfig \
        build

  meson compile -C build
}

check() {
  cd "$pkgname"

  meson test -C build
}

package() {
  cd "$pkgname"

  DESTDIR="$pkgdir" meson install -C build

  # install Arch specific stuff
  install -dm755 "$pkgdir/etc"
  install -m644 "$srcdir/pacman.conf" "$pkgdir/etc"
  install -m644 "$srcdir/makepkg.conf" "$pkgdir/etc"
  install -D -m644 "$srcdir/alpm.sysusers" "${pkgdir}"/usr/lib/sysusers.d/alpm.conf
  install -m644 "$srcdir/fortran.conf" "$pkgdir/etc/makepkg.conf.d"
  install -m644 "$srcdir/rust.conf" "$pkgdir/etc/makepkg.conf.d"

  local wantsdir="$pkgdir/usr/lib/systemd/system/sockets.target.wants"
  install -dm755 "$wantsdir"

  local unit
  for unit in dirmngr gpg-agent gpg-agent-{browser,extra,ssh} keyboxd; do
    ln -s "../${unit}@.socket" "$wantsdir/${unit}@etc-pacman.d-gnupg.socket"
  done
}


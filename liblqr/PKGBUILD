# POWER Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
# Maintainer: Tobias Powalowski <tpowa@archlinux.org>

pkgname=liblqr
pkgver=0.4.3
pkgrel=1.1
pkgdesc='A seam-carving C/C++ library called Liquid Rescale'
arch=(x86_64 powerpc64le powerpc64 powerpc riscv64)
url='https://liblqr.wikidot.com/'
license=(GPL-3.0-or-later)
depends=(glib2
         glibc)
makedepends=(git)
source=(git+https://github.com/carlobaldassi/liblqr#tag=v$pkgver)
sha256sums=('1b1d26ab3138b0ec34062c3f1b8cd808d5c7a85e37fdbb9c6fd6722f52b2122d')
options=(!emptydirs)

build() {
  cd $pkgname
  # liblqr declares lqr_carver_generate_rcache_* the old way, which C23 reads
  # as taking no parameters -- gcc 16 defaults to C23, so every definition
  # then "conflicts" with its own declaration. Upstream Arch sets the same
  # flag for the same reason.
  CFLAGS+=' -std=gnu17'
  ./configure \
    --prefix=/usr 
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}

# Ghidra names its native output directories per host OS/CPU; map uname -m
# to the buildNatives_<os> task and distribution zip suffix.
case "$(uname -m)" in
  x86_64)  _ghos=linux_x86_64 ;;
  aarch64) _ghos=linux_arm_64 ;;
  ppc64le) _ghos=linux_ppc64le ;;
esac

prepare() {
  cd ghidra-Ghidra_${pkgver}_build

  # linux_ppc64le platform: native build lists, protoc, and the runtime
  # Platform/Architecture enums (README.md). Harmless on other arches.
  patch -Np1 -i ../ghidra-linux-ppc64le.patch

  # Check dependency expectations
  _check_dep "yajsw-stable-${_yajsw}.zip"
  _check_dep "java-sarif-${_jsarif}-modified.jar"
  _check_dep "protobuf-${_protobuf}-"
  _check_dep "psutil-${_psutil}.tar.gz"
  _check_dep "setuptools-${_setuptools}-"
  _check_dep "wheel-${_wheel}-"
  _check_dep "jpype1-${_jpype1}-"
  _check_dep "packaging-${_packaging}-"
  _check_dep "typing_extensions-${_typing_extensions}-"

  # Copy needed libraries into flat repo folder
  install -Dm 644 \
    ../AXMLPrinter2.jar ../ghidra-data/lib/java-sarif-${_jsarif}-modified.jar \
    -t dependencies/flatRepo
  install -Dm 644 ../psutil-${_psutil}.tar.gz -t dependencies/Debugger-rmi-trace
  install -Dm 644 ../jpype1-${_jpype1}.tar.gz -t dependencies/PyGhidra/

  # Debugger model
  install -Dm 644 ../ghidra-data/Debugger/dbgmodel.tlb -t dependencies/Debugger-agent-dbgeng/

  # YAJSW expects this symlink
  ln -sf ghidra-Ghidra_${pkgver}_build ../ghidra.bin
  install -Dm 644 ../yajsw-stable-${_yajsw}.zip -t dependencies/GhidraServer

  # Add FID datasets
  install -Dm 644 ../ghidra-data/FunctionID/*.fidb -t Ghidra/Features/FunctionID/src/main/fidb

  # Ignore lack of licensing for YAJSW zip, packed FID datasets, and the native binaries
  sed -i '/FileTree tree/a\\t\texclude "yajsw-stable-**.zip"\n\t\texclude "src/main/fidb/**.fidb"\n\t\texclude "os/linux64/**"' gradle/support/ip.gradle

  # z3 dependencies
  install -Dm 644 /usr/lib/libz3* -t dependencies/SymbolicSummaryZ3/os/${_ghos}
  install -Dm 644 /usr/share/java/com.microsoft.z3.jar -t dependencies/flatRepo
}

_check_dep() {
  local dep=$1
  if ! grep -m1 "${dep}" --quiet gradle/support/fetchDependencies.gradle; then
    error "Dependency expectation failed: ${dep}"
    return 1
  fi
}

build() {
  cd ghidra-Ghidra_${pkgver}_build

  export GRADLE_HOME="$(pwd)/usr/share/java/gradle/"
  export JAVA_HOME="/usr/lib/jvm/java-${_jdkver}-openjdk"
  export PATH="${JAVA_HOME}/bin:${PATH}"
  export PATH="$(pwd)/usr/share/java/gradle/bin/:${PATH}"

  # ppc64le: JAVA_HOME is what selects the JDK here, since bq's sysroot never
  # runs the archlinux-java hook; it must exist. --no-daemon because a daemon
  # outlives makepkg with this build's /usr mounted, and the next build in
  # another sandbox (the other pool's) would reuse it and compile against the
  # wrong toolchain. Workers follow makepkg's -j, not nproc.
  [[ -x $JAVA_HOME/bin/javac ]] || { error "no JDK ${_jdkver} at $JAVA_HOME"; return 1; }
  local _gradle=(gradle --no-daemon --console=plain)
  local _jobs
  _jobs=$(grep -oP '(?<=-j)\s*[0-9]+' <<<"${MAKEFLAGS:-}" | tr -d ' ' | head -n1)
  [[ -n $_jobs ]] && _gradle+=(--max-workers="$_jobs")
  # Ghidra 12.2 needs Gradle >= 9.1, and the gradle that runs must be the
  # system one on JDK 25.
  local _out _gmaj _gmin
  _out=$("${_gradle[@]}" --version)
  read -r _gmaj _gmin < <(sed -n 's/^Gradle \([0-9]*\)\.\([0-9]*\).*/\1 \2/p' <<<"$_out")
  (( _gmaj > 9 || (_gmaj == 9 && _gmin >= 1) )) \
    || { error "gradle ${_gmaj:-?}.${_gmin:-?} is older than 9.1"; return 1; }
  grep -q "^Launcher JVM: *${_jdkver}[.+]" <<<"$_out" \
    || { error "gradle is not running on JDK ${_jdkver}"; return 1; }

  # Gradle's native build ignores CFLAGS: decompile, sleigh, the demanglers
  # and lzfse get the compiler's default -mcpu. On the POWER8 baseline that
  # default must not be POWER9 (the pool gcc's is power8; assert, not assume).
  if (( ${_power8_compat:-0} )); then
    _out=$(gcc -dM -E -x c /dev/null; g++ -dM -E -x c++ /dev/null)
    grep -q '_ARCH_PWR8' <<<"$_out" || { error "cannot read the compiler's ISA"; return 1; }
    if grep -q '_ARCH_PWR9' <<<"$_out"; then
      error "gcc/g++ default to POWER9; the baseline natives would be ISA 3.0"
      return 1
    fi
  fi

  # Build dependencies
  _build_python_dependency protobuf-${_protobuf} Debugger-rmi-trace
  _build_python_dependency setuptools-${_setuptools} Debugger-rmi-trace PyGhidra
  _build_python_dependency wheel-${_wheel} Debugger-rmi-trace PyGhidra
  _build_python_dependency packaging-${_packaging} PyGhidra
  _build_python_dependency typing_extensions-${_typing_extensions} PyGhidra
  _build_python_dependency jpype1-${_jpype1} PyGhidra

  # Ghidra build
  "${_gradle[@]}" yajswDevUnpack
  "${_gradle[@]}" buildNatives_${_ghos}
  "${_gradle[@]}" sleighCompile
  "${_gradle[@]}" buildGhidra

  _assert_dist
}

# Here and not in check(): bq builds with makepkg --nocheck. The distribution
# must carry this platform's natives, built for this CPU and linked by GNU ld,
# no ELF in any other platform's os/ directory, and the Z3 extension must
# carry the Z3 libraries.
_assert_dist() {
  local _zip=(build/dist/ghidra_*_*.zip) _chk="$srcdir/dist-check" _n _f _hits
  [[ ${#_zip[@]} -eq 1 && -f ${_zip[0]} ]] || { error "expected one dist zip: ${_zip[*]}"; return 1; }
  rm -rf "$_chk"; mkdir -p "$_chk"
  bsdtar -xf "${_zip[0]}" -C "$_chk" "*/os/*" "*SymbolicSummaryZ3.zip"
  # GCC on ppc64le accepts -m64, so without the patch's buildable rule Gradle
  # built ppc64le binaries into os/linux_x86_64 as well.
  while IFS= read -r -d '' _f; do
    [[ $_f == */os/${_ghos}/* ]] && continue
    [[ $(od -An -tx1 -N4 "$_f") == " 7f 45 4c 46" ]] || continue
    error "ELF outside os/${_ghos}: ${_f#"$_chk"/}"; return 1
  done < <(find "$_chk" -path '*/os/*' -type f -print0)
  for _n in decompile sleigh demangler_gnu_v2_41 demangler_gnu_v2_24 lzfse; do
    _f=$(find "$_chk" -path "*/os/${_ghos}/${_n}" -type f)
    [[ -n $_f && $(wc -l <<<"$_f") -eq 1 ]] || { error "dist lacks os/${_ghos}/${_n}"; return 1; }
    _out=$(readelf -h "$_f")
    grep -q 'Machine:.*PowerPC64' <<<"$_out" || { error "$_n is not a PowerPC64 ELF"; return 1; }
    _out=$(readelf -p .comment "$_f")
    if grep -q 'Linker: LLD' <<<"$_out"; then
      error "$_n was linked by LLD"; return 1
    fi
  done
  _f=$(find "$_chk" -name '*SymbolicSummaryZ3.zip' -type f)
  [[ -n $_f ]] || { error "dist lacks the SymbolicSummaryZ3 extension"; return 1; }
  _out=$(bsdtar -tf "$_f")
  _hits=$(grep -cE "/os/${_ghos}/libz3(java)?\.so\$" <<<"$_out")
  [[ $_hits -eq 2 ]] || { error "SymbolicSummaryZ3 lacks libz3.so/libz3java.so for ${_ghos}"; return 1; }
  rm -rf "$_chk"
}

_build_python_dependency() {
  local folder=$1; shift
  local targets=("$@")
  local target

  msg "Building python dependency ${folder} for ${targets[*]}"
  pushd "../${folder}"
  [[ -f pyproject.toml ]] && sed 's/,<4//' -i pyproject.toml
  python -m build --wheel --no-isolation
  for target in "${targets[@]}"; do
    install -Dm 644 dist/*.whl -t "../ghidra-Ghidra_${pkgver}_build/dependencies/${target}"
  done
  popd
}

package() {
  depends+=(
    "java-environment>=${_jdkver}"
  )

  cd ghidra-Ghidra_${pkgver}_build

  # Extract built archive into destination folder
  install -d "${pkgdir}"/{opt,usr/bin}
  _appver=$(grep -oP '(?<=^application.version=).*$' Ghidra/application.properties)
  _relname=$(grep -oP '(?<=^application.release.name=).*$' Ghidra/application.properties)
  bsdtar xf "build/dist/ghidra_${_appver}_${_relname}"_*.zip -C "${pkgdir}"/opt

  # Simplify some directory and binary names
  mv "${pkgdir}"/opt/ghidra{_*,}
  ln -s /opt/ghidra/ghidraRun "${pkgdir}"/usr/bin/ghidra
  ln -s /opt/ghidra/support/pyghidraRun "${pkgdir}"/usr/bin/pyghidra
  ln -s /opt/ghidra/support/analyzeHeadless "${pkgdir}"/usr/bin/ghidra-analyzeHeadless

  # Install desktop file
  install -Dm644 ../ghidra.desktop "${pkgdir}"/usr/share/applications/$pkgname.desktop

  # Install icons
  for _size in 16 24 32 48 128 256; do
    install -vDm 644 Ghidra/Framework/Gui/src/main/resources/images/GhidraIcon$_size.png \
      "$pkgdir/usr/share/icons/hicolor/${_size}x${_size}/apps/${pkgname}.png"
  done
}


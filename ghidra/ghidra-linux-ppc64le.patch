diff -ruN a/GPL/nativeBuildProperties.gradle b/GPL/nativeBuildProperties.gradle
--- a/GPL/nativeBuildProperties.gradle
+++ b/GPL/nativeBuildProperties.gradle
@@ -34,6 +34,18 @@
 		}
 	}	
 
+	// On linux_ppc64le, GCC accepts -m64, so Gradle's built-in Intel64 target configuration
+	// claims it can build linux_x86_64 as well, and assemble fills os/linux_x86_64 with
+	// ppc64le binaries. Build only the current platform there.
+	binaries {
+		withType(NativeBinarySpec) { b ->
+			if (getCurrentPlatformName() == "linux_ppc64le" &&
+					b.targetPlatform.name != "linux_ppc64le") {
+				b.buildable = false
+			}
+		}
+	}
+
 	// The toolChains block is needed because Gradle doesn't find the native toolchain in various
 	// scenarios. These checks, can be removed when Gradle fixes them, and we advertise a
 	// minimum Gradle version that includes the fix.
diff -ruN a/GPL/nativePlatforms.gradle b/GPL/nativePlatforms.gradle
--- a/GPL/nativePlatforms.gradle
+++ b/GPL/nativePlatforms.gradle
@@ -24,6 +24,7 @@
 	[name: "win_arm_64", os: "windows", arch: "arm64"],
 	[name: "linux_x86_64", os: "linux", arch: "x86_64"],
 	[name: "linux_arm_64", os: "linux", arch: "arm64"],
+	[name: "linux_ppc64le", os: "linux", arch: "ppc64le"],
 	[name: "mac_x86_64", os: "osx", arch: "x86_64"],
 	[name: "mac_arm_64", os: "osx", arch: "arm64"],
 	[name: "freebsd_x86_64", os: "freebsd", arch: "x86_64"],
@@ -82,6 +83,9 @@
 		case "arm64":
 			arch = "arm_64"
 			break
+		case "ppc64le":
+			arch = "ppc64le"
+			break
 		default:
 			throw new GradleException("Unrecognized platform architecture: $arch" )
 	}

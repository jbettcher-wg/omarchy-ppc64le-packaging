prepare() {
  cd z3
  patch -Np1 -i ../z3-python-do-not-rebuild.patch
  # upstream TAGS wheel map has no ppc64le entry: KeyError ('linux','ppc64le')
  patch -Np1 -i ../z3-python-wheel-ppc64le.patch
}

build() {
  cd z3

  # Name the JDK outright: bq's sysroot never runs the archlinux-java hook, so
  # /usr/lib/jvm/default (what FindJava/FindJNI fall back to) is not to be
  # trusted there. jdk-openjdk is the newest JDK; --release 8 below keeps the
  # jar loadable by any JRE.
  local _jvm
  _jvm=$(printf '%s\n' /usr/lib/jvm/java-*-openjdk | sort -V | tail -n1)
  [[ -x $_jvm/bin/javac ]] || { error "no JDK under /usr/lib/jvm"; return 1; }
  export JAVA_HOME=$_jvm PATH="$_jvm/bin:$PATH"

  # /usr/bin/z3 uses malloc_usable_size, which is incompatible with fortification level 3
  export CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  export CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

  cmake \
    -Bbuild \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_JAVA_COMPILE_FLAGS='--release;8' \
    -DZ3_INCLUDE_GIT_DESCRIBE=OFF \
    -DZ3_INCLUDE_GIT_HASH=OFF \
    -DZ3_LINK_TIME_OPTIMIZATION=1 \
    -DZ3_BUILD_PYTHON_BINDINGS=1 \
    -DZ3_BUILD_JAVA_BINDINGS=1 \
    -DPYTHON_EXECUTABLE=/usr/bin/python
  cmake --build build
  cmake --build build --target test-z3

  # check() never runs under bq (makepkg --nocheck): at least solve something.
  local _r
  _r=$(printf '(declare-const x Int)\n(assert (> (* x x) 49))\n(assert (< x 0))\n(check-sat)\n' | ./build/z3 -in)
  [[ $_r == sat ]] || { error "z3 smoke test answered: $_r"; return 1; }

  cd src/api/python
  python -m build --wheel --no-isolation
}

check() {
  cd z3
  ./build/test-z3 -a
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv -v "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_z3() {
  depends=(
    libgcc
    libstdc++
    glibc
  )
  provides=(
    libz3
    libz3.so
  )

  cd z3

  # use PEP517 installation instead of custom cmake dist
  pushd src/api/python
  # python-installer 1.0.0 resolves each destination against the LIVE root,
  # not --destdir. With python-z3-solver installed on the build host,
  # site-packages/z3/lib/libz3.so is a symlink to /usr/lib/libz3.so, so the
  # install aborts with "Attempting to write z3/lib/libz3.so outside of the
  # target directory". z3/{include,lib} are deleted straight after the install
  # anyway, so install a copy of the wheel (same file name) without them.
  local _whl=(dist/*.whl)
  mkdir -p "$srcdir/wheel-noblobs"
  python - "${_whl[0]}" "$srcdir/wheel-noblobs/${_whl[0]##*/}" <<'EOF'
import sys, zipfile
src, dst = sys.argv[1], sys.argv[2]
skip = ("z3/lib/", "z3/include/")
with zipfile.ZipFile(src) as zi, zipfile.ZipFile(dst, "w", zipfile.ZIP_DEFLATED) as zo:
    for info in zi.infolist():
        if info.filename.startswith(skip):
            continue
        data = zi.read(info)
        if info.filename.endswith(".dist-info/RECORD"):
            data = b"".join(l for l in data.splitlines(True)
                            if not l.startswith(tuple(x.encode() for x in skip)))
        zo.writestr(info, data)
EOF
  python -m installer --destdir="$pkgdir/" "$srcdir/wheel-noblobs/${_whl[0]##*/}"
  cd "$pkgdir"
  [[ ! -e $(echo "${pkgdir}"/usr/lib/python*/site-packages/z3/lib) ]] || {
    error "z3/lib survived the wheel filter"; return 1; }
  _pick python usr/lib/python*
  rm -r "${pkgdir}"/*
  popd

  DESTDIR="$pkgdir" cmake --install build
  rm -r "${pkgdir}"/usr/lib/python*/
  install -Dm644 "${srcdir}/z3/LICENSE.txt" -t "$pkgdir"/usr/share/licenses/$pkgname

  cd "$pkgdir"
  _pick java usr/lib/libz3java.so
  _pick java usr/share/java/com.microsoft.z3.jar
}

package_z3-java() {
  depends=(
    glibc
    java-runtime
    libgcc
    libstdc++
    z3
  )
  mv java/* "$pkgdir"
  install -Dm644 z3/LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname
}

package_python-z3-solver() {
  depends=(
    python
    z3
  )
  replaces=(python-z3)
  conflicts=(python-z3)

  mv python/* "$pkgdir"

  # Support consumers expecting wheel library layout
  local _site_packages
  _site_packages=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
  install -dm755 "${pkgdir}${_site_packages}/z3/lib"
  ln -s /usr/lib/libz3.so "${pkgdir}${_site_packages}/z3/lib/libz3.so"

  install -Dm644 z3/LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname
}


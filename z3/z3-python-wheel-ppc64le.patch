Add the missing ppc64le wheel platform tag to z3's Python bindings, so
`python -m build` no longer dies with KeyError: ('linux', 'ppc64le') in
bdist_wheel.finalize_options. Same shape as the existing riscv64 and
loongarch64 entries; linux_* tags are provisional until auditwheel anyway.

--- a/src/api/python/setup.py
+++ b/src/api/python/setup.py
@@ -352,6 +352,7 @@
                 ("linux", "aarch64"): "linux_aarch64",
                 ('linux', "riscv64"): "linux_riscv64",
                 ("linux", "loongarch64"): "linux_loongarch64",
+                ("linux", "ppc64le"): "linux_ppc64le",
                 ("win", "x64"): "win_amd64",
                 ("win", "x86"): "win32",
                 ("win", "arm64"): "win_arm64",

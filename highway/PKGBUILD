# POWER Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
# Maintainer: Daniel Bermond <dbermond@archlinux.org>

pkgname=highway
pkgver=1.4.0
pkgrel=2.2
pkgdesc='A C++ library that provides portable SIMD/vector intrinsics'
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url='https://github.com/google/highway/'
license=('Apache-2.0 OR BSD-3-Clause')
depends=(
    'glibc'
    'gtest'
    'libgcc'
    'libstdc++')
makedepends=(
    'cmake')
source=("https://github.com/google/highway/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz"
        ppc64le-no-ppc10-target.patch)
sha256sums=('e72241ac9524bb653ae52ced768b508045d4438726a303f10181a38f764a453c'
            '71f08ceae247521ce777f53ee44d36439d7986269a266d34de85bd9811852699')

# The PPC10 (POWER10) target leaked: libjxl 0.12.0 in the POWER9 pool ran a
# POWER10 `pla` on a POWER9 (SIGILL in JxlEncoderProcessOutput), reached
# without going through dispatch. The patch makes PPC10 a broken target by
# default in the installed headers, so libhwy, libhwy_contrib and every
# consumer compiled against them (libjxl, libvips, ...) stop generating it, in
# both pools. HWY_BROKEN_PPC10=0 restores it. The baseline lane additionally
# compiles the static target only (its drop-in's HWY_COMPILE_ONLY_STATIC).
prepare() {
    patch -d "${pkgname}-${pkgver}" -Np1 -i "${srcdir}/ppc64le-no-ppc10-target.patch"
}

# check() below skips ctest on powerpc64le, so the test binaries are never
# run -- but upstream wires every one of them to gtest_discover_tests with
# DISCOVERY_TIMEOUT 60, which executes the freshly linked binary during
# build() to enumerate its cases. On a loaded builder the largest of them
# (table_test) overruns that budget, discovery returns nothing, and CMake
# fails parsing the empty JSON. Building tests we do not run is waste; not
# building them removes the failure and the waste together.
#
# But not with HWY_ENABLE_TESTS=OFF, which 1.4.0-1 used. That switch also gates
# *installing* libhwy_test, its hwy/tests/*.h headers and libhwy-test.pc --
# public API that Arch's highway ships and downstream test suites include.
# libjxl's tests stopped compiling against it (hwy/tests/hwy_gtest.h: No such
# file). The executables and their gtest_discover_tests are gated by
# HWY_ENABLE_TESTS *and* BUILD_TESTING, so turning off only BUILD_TESTING keeps
# the full install while still building and discovering no test at all.
build() {
    cmake -B build -S "${pkgname}-${pkgver}" \
        -G 'Unix Makefiles' \
        -DCMAKE_BUILD_TYPE:STRING='None' \
        -DCMAKE_INSTALL_PREFIX:PATH='/usr' \
        -DBUILD_SHARED_LIBS:BOOL='ON' \
        -DHWY_SYSTEM_GTEST:BOOL='ON' \
        -DHWY_ENABLE_TESTS:BOOL='ON' \
        -DBUILD_TESTING:BOOL='OFF' \
        -Wno-dev #${_cmake_options[@]}
    cmake --build build
}

check() {
    case "${CARCH}" in
        powerpc64le) return 0 ;;
    esac

    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -D -m644 "${pkgname}-${pkgver}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

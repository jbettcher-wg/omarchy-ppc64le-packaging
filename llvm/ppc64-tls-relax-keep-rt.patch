+    // the small-model form, addi rT, r2, x@got@tlsld; without this case it
+    // fell through to llvm_unreachable (llvm#240311).
+    uint32_t rt = readFromHalf16(ctx, loc) & (0x1f << 21);
+    writeFromHalf16(ctx, loc, 0x3c0d0000 | rt); // addis rT, r13, 0
     break;
+  }
   case R_PPC64_GOT_TLSLD_PCREL34:
     // Relax from paddi r3, 0, x1@got@tlsld@pcrel, 1 to
     //            paddi r3, r13, 0x1000, 0
@@ -1651,10 +1663,13 @@
     return;
   case R_PPC64_GOT_TLSGD16:
   case R_PPC64_GOT_TLSGD16_LO: {
-    // Relax from addi  r3, rA, sym@got@tlsgd@l to

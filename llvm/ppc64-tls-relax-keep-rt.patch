+    uint32_t insn = readFromHalf16(ctx, loc);
+    uint32_t rt = insn & (0x1f << 21);
+    uint32_t ra = insn & (0x1f << 16);
+    writeFromHalf16(ctx, loc, 0xe8000000 | rt | ra);

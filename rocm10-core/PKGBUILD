# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: Greg Land <landjgregory at gmail dot com>

pkgname=rocm10-core
pkgver=10.0
pkgrel=1
pkgdesc='AMD ROCm core package (version files)'
license=('MIT')
arch=('x86_64' 'powerpc64le')
depends=(
    'glibc'
    'libgcc'
    'python'
    'python-prettytable'
    'python-pyaml'
    'python-pyelftools'
)
makedepends=('cmake')
source=("rocm-$pkgver.tar.gz::https://github.com/ROCm/rocm-systems/archive/refs/tags/therock-$pkgver.tar.gz"
        'rocm-ld.conf'
        'rocm-profile.sh'
        'rocm.fish')
b2sums=('7c9845e186e4df47767b7898c665a5c9ccfb34f3c188ce91563ed707ed840a3e13c3a4041c7c7966b80a8d4bf51cd6a6fbbb0f4036f89ec7b0e5a0737f580e9c'
        'd045c357d8e7e8a4840ab137404f12cd08419444ffc478046c13ed3bd13a5d33358c1443bf76ee571a7a062454e2bdda1a5507a70edbd001bce004f18775e4b2'
        '4372bcbe97d7c95d4918ad4beacc4fe9bfc8bfb8cafcf08d9ebbcba7df3e3bf535ff51f90c2d0f653858b0ae03b108ac3cb32b61b4ecac3abb609acc06be3ee3'
        '16bae84aeb429a298d548945860102be13b80b06f823abae13fd37a9d3b571de732f2e304fe67625520b414595fd070944dd29855b0405883d713b5a966c66b9')
url='https://rocm.docs.amd.com/en/latest/'
# Upstream project directory, which is NOT $pkgname: our package is renamed
# rocm10-core so the ROCm 7 generation can stay installed alongside it, while
# the tarball still calls it rocm-core.
_project=rocm-core
_projectDir="rocm-systems-therock-$pkgver/projects/$_project"
# Upstream tags omit a zero patch (therock-10.0).
# ROCM_VERSION needs major.minor.patch.
_rocm_version=$pkgver
[[ $_rocm_version == *.*.* ]] || _rocm_version+=.0

build() {
  local cmake_args=(
	-Wno-author
    -B build
    -S $_projectDir
    -D CMAKE_BUILD_TYPE=None
    -D BUILD_SHARED_LIBS=ON
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D ROCM_VERSION=$_rocm_version
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 rocm-ld.conf "$pkgdir/etc/ld.so.conf.d/rocm.conf"
  install -Dm644 rocm-profile.sh "$pkgdir/etc/profile.d/rocm.sh"
  install -Dm644 rocm.fish -t "$pkgdir/usr/share/fish/vendor_conf.d"
  install -Dm644 "$srcdir/$_projectDir/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# ppc64le: Omarchy -- Arch's recipe built from the tag archive instead of a git
# clone (KiCad's history is GBs; the archive is 258 MB), plus
# kicad-recreatetoolbars-null-settings.patch.

pkgbase=kicad
pkgname=('kicad' 'kicad-demos')
pkgver=10.0.8
pkgrel=1.1
pkgdesc='Electronic schematic and printed circuit board (PCB) design tools'
arch=(x86_64 powerpc64le)
url='http://kicad.org/'
license=(GPL-3.0-or-later)
depends=(
  boost-libs
  fontconfig
  zstd
  abseil-cpp
  freetype2
  hicolor-icon-theme
  libsecret
  glibc
  glib2
  gtk3
  wayland
  glu
  cairo
  harfbuzz
  libstdc++
  libgcc
  libglvnd
  libspnav
  wxwidgets-common
  zlib
  curl
  glm
  ngspice
  opencascade
  python
  python-wxpython
  wxwidgets-gtk3
  webkit2gtk-4.1
  unixodbc
  libgit2
  nng
  protobuf
  poppler-glib
)
makedepends=(
  cmake
  ninja
  mesa
  boost
  swig
)
source=(
  "$pkgname-$pkgver.tar.gz::https://gitlab.com/kicad/code/kicad/-/archive/$pkgver/kicad-$pkgver.tar.gz"
  fix-version-string.patch
  kicad-recreatetoolbars-null-settings.patch
)
sha256sums=('0723fedd82522fcd33cb9d8ad53979a35f6e4d3ec627c4e2e2708dfcba360574'
            'e512fac78720eb31d5a89f9ce4447f33a0a733388e9a8f55db81ca38fb030e07'
            'af40eb7e27e395a010f6600b3947a89bf91df2e01b3acc36986b041bb66478f1')

prepare() {
  cd "$pkgname-$pkgver"

  patch -p1 -i "$srcdir/fix-version-string.patch"
  # Preferences OK segfaulted with the KiPython console open (null toolbar settings).
  patch -p1 -i "$srcdir/kicad-recreatetoolbars-null-settings.patch"
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgname-$pkgver"
    -G Ninja
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D KICAD_USE_EGL=ON
    -D KICAD_BUILD_I18N=ON
    -D KICAD_I18N_UNIX_STRICT_PATH=ON
    -D KICAD_BUILD_QA_TESTS=OFF
    -D KICAD_USE_CMAKE_FINDPROTOBUF=OFF
    -D KICAD_UPDATE_CHECK=OFF
    -W no-author
  )

  cmake "${cmake_options[@]}"

  cmake --build build

  # ppc64le: built from an archive, not git, so the version comes from
  # cmake/KiCadVersion.cmake rather than git describe.  It must still say
  # $pkgver, and the null-settings guard must be in what was compiled.
  local hdr
  hdr=$(find build -maxdepth 3 -name kicad_build_version.h | head -1)
  grep -q "\"$pkgver" "$hdr" \
    || { echo "kicad: ${hdr:-kicad_build_version.h} does not carry $pkgver" >&2; return 1; }
  grep -q 'if( !m_toolbarSettings )' "$pkgname-$pkgver/common/eda_base_frame.cpp" \
    || { echo "kicad: the RecreateToolbars null guard is missing" >&2; return 1; }
}

package_kicad() {
  optdepends=(
    'kicad-demos: demo projects'
    'kicad-library: for footprints, symbols and templates'
    'kicad-library-3d: for 3D models of components'
  )

  DESTDIR="$pkgdir" cmake --install build

  strip "$STRIP_SHARED" "${pkgdir}"/usr/lib/python*/site-packages/_pcbnew.so
  mv "$pkgdir/usr/share/kicad/demos" .
}

package_kicad-demos() {
  pkgdesc='Demo projects for KiCad'
  depends=('kicad' 'python')

  install -dm755 "$pkgdir/usr/share/kicad/"
  mv demos "$pkgdir/usr/share/kicad/"
}


# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Upstream maintainer: Emir Beganovic <emir@omarchy.org>
#
# Omarchy's network speed test client, run by omarchy-network-speedtest.
# omarchy 4.5.0 hard-depends on it. Taken from upstream's own recipe
# (github.com/omacom/omarchy-pkgs, pkgbuilds/omarchy-speedtest); the version is
# Omarchy's stable channel (pkgs.omarchy.org/stable omarchy-speedtest 0.2.1-1).
#
# ppc64le: powerpc64le added to arch=(), nothing else. Plain Go with no cgo
# beyond the external link and no assembly; GOPPC64 comes from the build
# environment (build-ppc64le.sh pins power8 for the baseline pool).

pkgname=omarchy-speedtest
pkgver=0.2.1
pkgrel=1
pkgdesc="Omarchy's network speed test client"
arch=(x86_64 aarch64 powerpc64le)
url='https://github.com/omacom/omarchy-speedtest'
license=(MIT)
options=(!debug)
depends=(glibc)
makedepends=(go)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ae939a2e7db8b2eba58c9d728808b0331508c8f848c5bbc309f5286b4da11bb3')

build() {
  cd "$pkgname-$pkgver"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  go build -ldflags "-linkmode external -extldflags \"$LDFLAGS\" -X main.version=$pkgver" -o omarchy-speedtest .
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 omarchy-speedtest "$pkgdir/usr/lib/omarchy/speedtest"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

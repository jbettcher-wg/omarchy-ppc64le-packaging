# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: acxz <akashpatel2008 at yahoo dot com>

pkgbase=rocm10-hip-runtime
# No -nvidia subpackage: _nvidia_depends is ('cuda'), which is a makedepend,
# and there is no CUDA on this host. The AMD runtime is the point here.
# Both ROCm generations install into /opt/rocm with identical paths, so without
# these pacman cannot swap them: it reports a wall of "exists in both" file
# conflicts and the only way through is --overwrite, which resolves the wrong
# way round -- a swap done that way left rocm-core 7.2.4's 19 files on disk
# while rocm10-core was recorded as owning them, and /opt/rocm/.info/version
# still read 7.2.4.
#
# conflicts, deliberately WITHOUT replaces: replaces would make every -Syu
# migrate ROCm 7 users to ROCm 10, and ROCm 10 dropped gfx900, which is the
# entire reason the rocm7 generation exists. conflicts asks instead.
# provides keeps existing dependents resolvable across the swap -- llama.cpp-hip
# depends on rocblas and hip-runtime-amd by name.

pkgname=(rocm10-hip-runtime-amd)
pkgver=10.0
pkgrel=2
_pkgdesc="Heterogeneous Interface for Portability"
arch=('x86_64' 'powerpc64le')
url='https://rocm.docs.amd.com/projects/HIP/en/latest/'
license=('MIT')
# rocm10-hsa-rocr is listed explicitly: it was absent from Arch's array, so
# the build picked up whatever hsa-rocr the host had (7.2.4) through bq's /opt
# overlay and failed on 1092 missing new-in-10.0 HSA symbols.
_amd_depends=('rocm10-core' 'bash' 'perl' 'glibc' 'libgcc' 'numactl'
         'mesa' 'rocm10-comgr' 'rocm10-rocminfo' 'rocm10-llvm' 'libelf'
         'rocm10-hsa-rocr' 'rocprofiler-register')
# rocm-llvm-static dropped: our rocm10-llvm keeps its static archives.
makedepends=('git' 'cmake' 'python' 'python-cppheaderparser'
             "${_amd_depends[@]}")
_tag="tag=therock-$pkgver"
_release="https://github.com/ROCm/rocm-systems/releases/download/therock-$pkgver"
# HIPCC compiler wrapper
_hipcc='https://github.com/ROCm/llvm-project'
source=("$pkgbase-clr-$pkgver.tar.gz::$_release/clr.tar.gz"
        "$pkgbase-hip-$pkgver.tar.gz::$_release/hip.tar.gz"
        "$pkgbase-hipother-$pkgver.tar.gz::$_release/hipother.tar.gz"
        "$pkgbase-hipcc::git+$_hipcc#$_tag"
        # https://github.com/ROCm/rocm-systems/pull/12596
        "$pkgbase-no-host-noinline.patch::https://github.com/ROCm/rocm-systems/commit/5d7969b1005b2c688057097a46a0a63860d7367c.patch")
sha256sums=('07caed9d726232008a2120da24f4e4bbc4998accbeadd309181fce04a9da9f99'
            '373958090db3cab854fa8a0baa5e4f9afe0ea423def204b241bfcbe74f6ce0ca'
            '6a9c7fe1d61b2682be9287c512d95c4e37773c8ffd6ab3752bc87a515567d1c8'
            '55ade468dfcb50bc6dbfd6c3a53c801744893cbd6d685d6d1da421d399e2cf58'
            'eebeb2ae0ec4c33627b2a445eb97832d737f4ec77d4cd74c55d4b9348bded591')

options=(!lto)

prepare() {
  # clr installed include dir in bulk, so we need to exclude the *.orig file
  patch -Np2 --no-backup-if-mismatch -i "$srcdir/$pkgbase-no-host-noinline.patch"
}

build() {
  local hipcc_common_args=(
    -Wno-dev
    -S "$srcdir/$pkgbase-hipcc/amd/hipcc"
    -D CMAKE_BUILD_TYPE=None
  )

  local hipcc_amd_args=(
    "${hipcc_common_args[@]}"
    -B build-amd-hipcc
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
  )
  cmake "${hipcc_amd_args[@]}"
  cmake --build build-amd-hipcc

  local hip_amd_args=(
    -Wno-dev
    -S "$srcdir/clr"
    -B build-amd
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/opt/rocm/
    -DHIP_PLATFORM=amd
    -DLLVM_ROOT=/opt/rocm/lib/llvm
    -DClang_ROOT=/opt/rocm/lib/llvm
    -DHIP_COMMON_DIR="$srcdir/hip"
    -DHIPCC_BIN_DIR="$srcdir/build-amd-hipcc"
    -DHIPNV_DIR="$srcdir/hipother/hipnv"
    -DHIP_CATCH_TEST=0
    -DCLR_BUILD_HIP=ON
    -DCLR_BUILD_OCL=OFF
  )
  cmake "${hip_amd_args[@]}"
  cmake --build build-amd

  # No nvidia build: the -nvidia subpackage is not produced (no CUDA here),
  # and -DHIP_PLATFORM=nvidia needs the CUDA toolkit at configure time.
}

package_rocm10-hip-runtime-amd() {
  # see the note at the top of this file
  conflicts=('hip-runtime-amd')
  provides=("hip-runtime-amd=$pkgver")
  pkgdesc="$_pkgdesc (AMD runtime)"
  depends=("${_amd_depends[@]}")
  optdepends=('inetutils: Print hostname in hipconfig'
              )
  replaces=("hip")
  provides=("hip=${pkgver}")
  DESTDIR="$pkgdir" cmake --install build-amd
  install -Dm644 "$srcdir/hip/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}


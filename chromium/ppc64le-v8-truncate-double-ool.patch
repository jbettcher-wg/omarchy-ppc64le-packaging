-    case kArchTruncateDoubleToI:
-      __ TruncateDoubleToI(isolate(), zone(), i.OutputRegister(),
-                           i.InputDoubleRegister(0), DetermineStubCallMode(),
-                           kScratchDoubleReg);
+    case kArchTruncateDoubleToI: {
+      Register result = i.OutputRegister();
+      DoubleRegister input = i.InputDoubleRegister(0);
+      auto ool = zone()->New<OutOfLineTruncateDoubleToI>(
+          this, result, input, DetermineStubCallMode());
+      // The fast path of MacroAssembler::TruncateDoubleToI: fctidz, mffprd,
+      // then TestIfInt32's extsw+cmpd.  The DoubleToI stub call is out of
+      // line, so the common case runs straight through the join.
+      DCHECK(input != kScratchDoubleReg);
+      __ ConvertDoubleToInt64(input, result, kScratchDoubleReg);
+      __ TestIfInt32(result);
+      __ bne(ool->entry());
+      __ bind(ool->exit());
       DCHECK_EQ(LeaveRC, i.OutputRCBit());
       break;
+    }

  private:
+  // Returns true if {index} is the result of an operation that, by IEEE 754,
+  // returns a quiet NaN whenever it returns a NaN at all. SilenceNaN of such a
+  // value is a no-op and can be dropped.
+  //
+  // IEEE 754-2019 7.2 requires every general-computational operation to signal
+  // the invalid operation exception and deliver a *quiet* NaN when handed a
+  // signalling NaN, and 6.2 requires a NaN produced by an invalid operation to
+  // be quiet as well. Addition, subtraction, multiplication, division and
+  // squareRoot are general-computational and are a single hardware instruction
+  // on every backend, so their result is never signalling whatever their
+  // inputs were.
+  //
+  // Deliberately *not* listed here:
+  //  - kAbs and kNegate. These are 5.5.1 sign bit operations, not arithmetic:
+  //    they copy the operand and change the sign bit, leaving a signalling NaN
+  //    signalling. The FloatBinop reducer above relies on the same fact when it
+  //    refuses to turn `x * -1` into `-x` with signalling NaNs around.
+  //  - kMin and kMax. These cannot create a NaN, they can only propagate an
+  //    input one, and whether that propagation quiets depends on the lowering:
+  //    x64 branches to an out-of-line canonical NaN, ppc64 routes the unordered
+  //    case through fadd, arm64 relies on fmin/fmax. That is eight backend
+  //    sequences to audit rather than one IEEE guarantee.
+  //  - kMod, kPower and the transcendentals. These are C calls (std::fmod,
+  //    base::ieee754), and a libm is free to return its NaN argument unchanged.
+  //  - kRoundDown/kRoundUp/kRoundToZero/kRoundTiesEven. roundToIntegral* are
+  //    general-computational, but not every backend implements them with one
+  //    instruction: RISC-V's MacroAssembler::RoundHelper fmv_d's the operand
+  //    straight to the destination and needs a separate fmin_d to canonicalise
+  //    the NaN case, so this family wants a per-backend audit too.
+  //  - float32 -> float64 conversion. convertFormat is general-computational,
+  //    but ppc64 holds single precision in double format and lowers
+  //    kPPC_Float32ToDouble to a register move, which does not quiet.
+  //
+  // Nothing here depends on {signalling_nan_possible}: the claim is about what
+  // the operation produces, not about what reaches it.
+  bool CannotProduceSignallingNaN(V<Float> index, FloatRepresentation rep) {
+    if (const FloatBinopOp* binop = matcher_.TryCast<FloatBinopOp>(index)) {
+      if (binop->rep != rep) return false;
+      switch (binop->kind) {
+        case FloatBinopOp::Kind::kAdd:
+        case FloatBinopOp::Kind::kSub:
+        case FloatBinopOp::Kind::kMul:
+        case FloatBinopOp::Kind::kDiv:
+          return true;
+        default:
+          return false;
+      }
+    }
+    if (const FloatUnaryOp* unop = matcher_.TryCast<FloatUnaryOp>(index)) {
+      if (unop->rep != rep) return false;
+      // kSilenceNaN itself is idempotent.
+      return unop->kind == FloatUnaryOp::Kind::kSqrt ||
+             unop->kind == FloatUnaryOp::Kind::kSilenceNaN;
+    }
+    return false;
+  }

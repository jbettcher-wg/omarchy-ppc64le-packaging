 void CodeGenerator::AssembleArchSelect(Instruction* instr,
                                        FlagsCondition condition) {
-  UNIMPLEMENTED();
+  PPCOperandConverter i(this, instr);
+  ArchOpcode op = instr->arch_opcode();
+  CRegister cr = cr0;
+
+  // The result register is always the last output of the instruction, and the
+  // true/false values are always the last two inputs -- the condition may have
+  // consumed any number of inputs before them.
+  size_t output_index = instr->OutputCount() - 1;
+  DCHECK_GE(instr->InputCount(), 2);
+  size_t true_value_index = instr->InputCount() - 2;
+  size_t false_value_index = instr->InputCount() - 1;
+
+  Condition cond = FlagsConditionToCondition(condition, op);
+  // isel reads a literal zero rather than the register when ra == r0. r0 is
+  // not in ALLOCATABLE_GENERAL_REGISTERS, so the allocator cannot supply it
+  // here, but assert it rather than rely on that silently.
+  DCHECK_NE(i.InputRegister(true_value_index), r0);
+  __ isel(cond, i.OutputRegister(output_index),
+          i.InputRegister(true_value_index),
+          i.InputRegister(false_value_index), cr);
 }
 

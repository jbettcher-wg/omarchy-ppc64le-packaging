+++ b/v8/src/compiler/backend/ppc/code-generator-ppc.cc
@@ -341,6 +341,8 @@
           return overflow64;
         case kPPC_Add32:
         case kPPC_Sub32:
+          // Detected with extsw+cmpd rather than XER; CR0 holds the compare.
+          return ne;
         case kPPC_Neg32:
         case kPPC_Mul32:
           return overflow32;
@@ -357,6 +359,8 @@
           return nooverflow64;
         case kPPC_Add32:
         case kPPC_Sub32:
+          // See kOverflow above.
+          return eq;
         case kPPC_Neg32:
         case kPPC_Mul32:

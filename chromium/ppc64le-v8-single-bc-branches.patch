@@ -5249,6 +5260,14 @@ void MacroAssembler::Switch(Register scratch, Register value,
   int entry_size_log2 = 2;
   ShiftLeftU32(value, value, Operand(entry_size_log2));
 
+  // Same reach problem as BaselineAssembler::Switch, at 4 bytes per case
+  // instead of 8: above 8192 cases `fallthrough`, bound at the far end of the
+  // table inside the scope below, is out of the `bge` above's +-32 KB reach,
+  // and no pool can be emitted once the scope is open. Flush after the bge so
+  // it is outstanding, and before the scope. Measured boundary without this:
+  // 8100 cases OK, 8200 fatal in bind_to()'s CHECK_NE(trampoline_pos, ...).
+  ForceTrampolinePoolEmission();
+
   Assembler::BlockTrampolinePoolScope block_trampoline_pool(this);
   DCHECK(!AreAliased(scratch, value, r0));
   GetLabelAddress(scratch, &jump_table);


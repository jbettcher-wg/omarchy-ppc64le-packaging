diff --git a/v8/src/baseline/ppc/baseline-assembler-ppc-inl.h b/v8/src/baseline/ppc/baseline-assembler-ppc-inl.h
index 6dc92aaa86..cae539f1df 100644
--- a/v8/src/baseline/ppc/baseline-assembler-ppc-inl.h
+++ b/v8/src/baseline/ppc/baseline-assembler-ppc-inl.h
@@ -603,6 +603,14 @@ void BaselineAssembler::Switch(Register reg, int case_value_base,
 
   // Mostly copied from code-generator-arm.cc
   JumpIf(kUnsignedGreaterThanEqual, reg, Operand(num_labels), &fallthrough);
+  // The jump table below is 8 bytes per case and is emitted inside a
+  // BlockTrampolinePoolScope, with `fallthrough` bound at its far end, so the
+  // bounds-check branch above can end up out of reach. Flush the pool here:
+  // after that branch, so it is outstanding and gets a slot, and before the
+  // scope opens, since once inside no pool can be emitted at all. It must not
+  // go any later -- a pool between bind(&jump_table) and the table body would
+  // move the table away from the address GetLabelAddress computes.
+  masm_->ForceTrampolinePoolEmission();
   // Ensure to emit the constant pool first if necessary.
   int entry_size_log2 = 3;
   __ ShiftLeftU32(reg, reg, Operand(entry_size_log2));


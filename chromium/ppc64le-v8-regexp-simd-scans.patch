+// ---------------------------------------------------------------------------
+// SIMD scan loops.
+//
+// Everything below is ISA 2.07 (POWER8-legal): VMX compares/permutes/shifts,
+// lxvd2x/lxsdx/xxpermdi (2.06), mtvsrd/mfvsrd/vbpermq (2.07), popcntd (2.06).
+// No ISA 3.0 instruction is emitted (lxvx, mtvsrdd, xxspltib, cnttzd are all
+// 3.0), so the code runs unchanged on POWER8 and POWER9.
+//
+// Lane layout. Subject bytes are loaded with lxvd2x, which on little-endian
+// fills VSR doubleword 0 (the BE-high half) with subject bytes 0..7 and
+// doubleword 1 with bytes 8..15, each as a native little-endian integer. That
+// is the "natural" LE lane order (lane i == subject byte i) with the two
+// doublewords swapped. Every per-lane operation used here (compare, and,
+// byte shift, nibble lookup) is layout-agnostic, so instead of paying an
+// xxswapd per iteration (which the V8 assembler does not even expose) the
+// swap is absorbed, once, into the vbpermq control vector that turns a
+// compare result into a bit mask: see LoadMovemaskControl.
+
+bool RegExpMacroAssemblerPPC::SkipUntilBitInTableUseSimd(int advance_by) {
+  // We only use SIMD instead of the scalar version if we advance by 1 byte
+  // in each iteration. For higher values the scalar version performs better.
+  // We only implemented the SIMD version in one-byte mode.
+  return v8_flags.regexp_simd && char_size() == 1 &&
+         advance_by <= v8_flags.regexp_simd_ppc_max_advance &&
+         advance_by <= static_cast<int>(
+                           compiler_constants::kMaxLookaheadForBoyerMoore);
+}
+
+bool RegExpMacroAssemblerPPC::SkipUntilCharAndUseSimd(int advance_by) {
+  return v8_flags.regexp_simd && advance_by == 1;
+}
+
+bool RegExpMacroAssemblerPPC::SkipUntilCharUseSimd(int advance_by) {
+  return v8_flags.regexp_simd && advance_by == 1;
+}
+
+bool RegExpMacroAssemblerPPC::SkipUntilCharOrCharUseSimd(int advance_by) {
+  return v8_flags.regexp_simd && advance_by == 1;
+}
+
+bool RegExpMacroAssemblerPPC::SkipUntilOneOfMasked3UseSimd(
+    const SkipUntilOneOfMasked3Args& args) {
+  return v8_flags.regexp_simd && char_size() == 1;
+}
+
+// dst = 16 subject bytes starting at current position + cp_offset, in the
+// lxvd2x lane layout described above.
+void RegExpMacroAssemblerPPC::LoadInputVector(Simd128Register dst,
+                                              int cp_offset,
+                                              Register scratch) {
+  Register offset = current_input_offset();
+  if (cp_offset != 0) {
+    if (is_int16(cp_offset * char_size())) {
+      __ addi(scratch, current_input_offset(),
+              Operand(cp_offset * char_size()));
+    } else {
+      __ mov(scratch, Operand(cp_offset * char_size()));
+      __ add(scratch, scratch, current_input_offset());
+    }
+    offset = scratch;
+  }
+  __ lxvd(dst, MemOperand(end_of_input_address(), offset));
+}
+
+// Splat one subject character (1 or 2 bytes, per mode()) into every lane.
+void RegExpMacroAssemblerPPC::SplatCharacter(Simd128Register dst,
+                                             uint32_t value,
+                                             Register scratch) {
+  __ mov(scratch, Operand(value & char_mask()));
+  if (char_size() == 1) {
+    __ I8x16Splat(dst, scratch);  // mtvsrd + vspltb
+  } else {
+    __ I16x8Splat(dst, scratch);  // mtvsrd + vsplth
+  }
+}
+
+void RegExpMacroAssemblerPPC::VectorCompareEqual(Simd128Register dst,
+                                                 Simd128Register a,
+                                                 Simd128Register b,
+                                                 RCBit rc) {
+  if (char_size() == 1) {
+    __ vcmpequb(dst, a, b, rc);
+  } else {
+    __ vcmpequh(dst, a, b, rc);
+  }
+}
+
+// dst.dword[0] = high, dst.dword[1] = low (ISA doubleword numbering, i.e.
+// dword 0 is the most significant half). mtvsrd x2 + xxpermdi with DM=0
+// (the V8 assembler's 3-operand xxpermdi), which is xxmrghd.
+void RegExpMacroAssemblerPPC::LoadConst128(Simd128Register dst, uint64_t high,
+                                           uint64_t low, Register scratch1,
+                                           Register scratch2,
+                                           Simd128Register scratch_vec) {
+  __ mov(scratch1, Operand(static_cast<intptr_t>(high)));
+  __ mov(scratch2, Operand(static_cast<intptr_t>(low)));
+  __ mtvsrd(dst, scratch1);
+  __ mtvsrd(scratch_vec, scratch2);
+  __ xxpermdi(dst, dst, scratch_vec);
+}
+
+// vbpermq control that gathers the MSB of every lane of an lxvd2x-layout
+// vector into a 16-bit mask in x86 pmovmskb order: bit i of the result is
+// the MSB of subject byte i. Subject byte i sits in BE byte (15 - i) ^ 8 of
+// the register (doublewords swapped), whose MSB is bit 8 * ((15 - i) ^ 8);
+// perm bit j (j = 0 is the MSB of the 16-bit field) selects for subject byte
+// 15 - j, so control byte j = 8 * (j ^ 8). For the natural lane order the two
+// doublewords would simply be exchanged (cf. MacroAssembler::I8x16BitMask).
+void RegExpMacroAssemblerPPC::LoadMovemaskControl(Simd128Register dst,
+                                                  Register scratch1,
+                                                  Register scratch2,
+                                                  Simd128Register scratch_vec) {
+  LoadConst128(dst, 0x4048505860687078ULL, 0x0008101820283038ULL, scratch1,
+               scratch2, scratch_vec);
+}
+
+// dst = 16-bit mask, bit i set iff lane i of |cmp| is all-ones (a compare
+// result). vbpermq leaves the 16 bits in the low half of doubleword 0, which
+// is what mfvsrd reads.
+void RegExpMacroAssemblerPPC::EmitMovemask(Register dst, Simd128Register cmp,
+                                           Simd128Register control,
+                                           Simd128Register scratch_vec) {
+  __ vbpermq(scratch_vec, cmp, control);
+  __ mfvsrd(dst, scratch_vec);
+}
+
+// dst = number of trailing zero bits of src (src != 0). cnttzd is ISA 3.0;
+// popcntd((src - 1) & ~src) is the 2.06 way.
+void RegExpMacroAssemblerPPC::CountTrailingZeros(Register dst, Register src,
+                                                 Register scratch) {
+  __ addi(scratch, src, Operand(-1));
+  __ andc(scratch, scratch, src);
+  __ popcntd(dst, scratch);
+}
+
+void RegExpMacroAssemblerPPC::EmitSkipUntilBitInTableSimdHelper(
+    int cp_offset, int advance_by, Handle<ByteArray> nibble_table_handle,
+    int bounds_check_offset, Label* scalar_fallback,
+    base::FunctionRef<void(Register, Register)> on_match) {
+  // This function uses r3, r4, r5 as scratch, and v0..v9 for simd.
+  DCHECK(!nibble_table_handle.is_null());
+
+  Label simd_loop, advance_vector, process_next_bit;
+  // Currently this helper is only used for LATIN1.
+  DCHECK_EQ(mode(), RegExpMacroAssembler::LATIN1);
+  const int kCharsPerVector = kVectorSize / char_size();
+
+  // Hoist the bounds check, there is one more copy before the loop backedge.
+  //
+  // Fallback to scalar version if there are less than kCharsPerVector chars
+  // left in the subject. We subtract 1 because CheckPosition assumes we are
+  // reading 1 character plus cp_offset. So the -1 is the character that is
+  // assumed to be read by default.
+  CheckPosition(bounds_check_offset + kCharsPerVector + kCheckPositionOffset,
+                scalar_fallback);
+
+  // Hoist constants.
+  //
+  // The nibble table (see BoyerMooreLookahead::GetSkipTable in
+  // regexp-compiler.cc for the layout) is wanted in natural lane order, lane
+  // k == table[k], because vperm indexes lanes. Two lxsdx and an xxpermdi
+  // (DM=0) give exactly that: doubleword 0 = table[8..15], doubleword 1 =
+  // table[0..7], each as a little-endian integer.
+  Simd128Register nibble_table = v0;
+  __ mov(r3, Operand(nibble_table_handle));
+  __ addi(r3, r3, Operand(OFFSET_OF_DATA_START(ByteArray) - kHeapObjectTag));
+  __ li(r4, Operand(8));
+  __ lxsdx(v1, MemOperand(r3, r4));  // table[8..15] -> v1.dword[0]
+  __ lxsdx(v2, MemOperand(r0, r3));  // table[0..7]  -> v2.dword[0]
+  __ xxpermdi(nibble_table, v1, v2);
+  Simd128Register four = v1;
+  __ vspltisb(four, Operand(4));
+  Simd128Register one = v2;
+  __ vspltisb(one, Operand(1));
+  Simd128Register movemask_control = v3;
+  LoadMovemaskControl(movemask_control, r3, r4, v4);
+
+  __ bind(&simd_loop);
+  // Load next characters into vector.
+  Simd128Register input_vec = v4;
+  LoadInputVector(input_vec, cp_offset, r3);
+
+  // Get rows of the nibble table based on the low nibbles.
+  // row = nibble_table[lo_nibbles]
+  // vperm addresses lanes in big-endian order (control byte value n selects
+  // BE lane n, i.e. natural lane 15 - n), and only the low five bits of each
+  // control byte are used, so with the table as both sources ~input selects
+  // natural lane (input & 0x0f): the vnor is the mask and the index swap in
+  // one instruction.
+  Simd128Register index_vec = v5;
+  __ vnor(index_vec, input_vec, input_vec);
+  Simd128Register row = v6;
+  __ vperm(row, nibble_table, nibble_table, index_vec);
+
+  // Check if the high nibble is set in the row.
+  // bitmask = 1 << (hi_nibbles & 0x7)
+  // vsrb shifts each byte by the low three bits of the shift lane, so
+  // hi_nibbles = input >> 4 needs no masking, and vslb likewise uses only the
+  // low three bits of the count, which is the & 0x7 for free.
+  Simd128Register hi_nibbles = v7;
+  __ vsrb(hi_nibbles, input_vec, four);
+  Simd128Register bitmask = v8;
+  __ vslb(bitmask, one, hi_nibbles);
+
+  // result = row & bitmask == bitmask; the record form sets CR6.EQ when no
+  // lane matched, which is the common case and needs no mask extraction.
+  Simd128Register result = v9;
+  __ vand(result, row, bitmask);
+  __ vcmpequb(result, result, bitmask, SetRC);
+  __ beq(&advance_vector, cr6);
+
+  // Copy the most significant bit of each result lane to r3.
+  Register mask = r3;
+  Register index = r4;
+  EmitMovemask(mask, result, movemask_control, v5);
+
+  __ bind(&process_next_bit);
+  // Extract the position of the lowest set bit.
+  CountTrailingZeros(index, mask, r5);
+
+  // We've found a match and loaded the bit position into r4. r3 MUST be
+  // preserved across this call if execution continues in the fallthrough path.
+  on_match(index, mask);
+
+  // Clear the lowest set bit.
+  __ addi(r5, mask, Operand(-1));
+  __ and_(mask, mask, r5, SetRC);
+  __ bne(&process_next_bit);
+
+  // The maximum lookahead for boyer moore is less than vector size, so we can
+  // ignore advance_by in the vectorized version.
+  DCHECK_LE(advance_by, compiler_constants::kMaxLookaheadForBoyerMoore);
+  DCHECK_LT(compiler_constants::kMaxLookaheadForBoyerMoore, kCharsPerVector);
+
+  __ bind(&advance_vector);
+  AdvanceCurrentPosition(kCharsPerVector);
+  CheckPosition(bounds_check_offset + kCharsPerVector + kCheckPositionOffset,
+                scalar_fallback);
+  __ b(&simd_loop);
+}
+
+// Shared tail of the three SkipUntilChar* loops: |cmp| holds a compare
+// result with at least one all-ones lane. Advance to the first such lane,
+// reload the current character and leave for on_match. The movemask control
+// is materialized here rather than before the loop because this block runs
+// at most once per scan, whereas the loop entry runs once per match attempt.
+void RegExpMacroAssemblerPPC::EmitSkipUntilFoundTail(Simd128Register cmp,
+                                                     int cp_offset,
+                                                     Label* on_match) {
+  Simd128Register control = v5;
+  LoadMovemaskControl(control, r3, r4, v6);
+  EmitMovemask(r3, cmp, control, v6);
+  // Both bytes of a matching UC16 lane are set; the lowest bit is the even
+  // one, so the result is the byte offset in either mode.
+  CountTrailingZeros(r4, r3, r5);
+  __ add(current_input_offset(), current_input_offset(), r4);
+  LoadCurrentCharacterUnchecked(cp_offset, 1);
+  BranchOrBacktrack(al, on_match);
+}
+
+void RegExpMacroAssemblerPPC::SkipUntilCharSimd(int cp_offset, int advance_by,
+                                                unsigned character,
+                                                int bounds_check_offset,
+                                                Label* on_match,
+                                                Label* on_no_match) {
+  Label scalar, simd_loop, found;
+  const int kCharsPerVector = kVectorSize / char_size();
+
+  const int check_offset =
+      bounds_check_offset + kCharsPerVector + kCheckPositionOffset;
+  DCHECK_GE(check_offset, 0);
+  CheckPosition(check_offset, &scalar);
+
+  Simd128Register char_vec = v0;
+  SplatCharacter(char_vec, character, r3);
+
+  __ bind(&simd_loop);
+  Simd128Register input_vec = v1;
+  LoadInputVector(input_vec, cp_offset, r3);
+  Simd128Register eq = v2;
+  VectorCompareEqual(eq, input_vec, char_vec, SetRC);
+  __ bne(&found, cr6);
+
+  AdvanceCurrentPosition(kCharsPerVector);
+  __ CmpS64(current_input_offset(), Operand(-check_offset * char_size()));
+  __ blt(&simd_loop);
+  __ b(&scalar);
+
+  __ bind(&found);
+  EmitSkipUntilFoundTail(eq, cp_offset, on_match);
+
+  __ bind(&scalar);
+}
+
+void RegExpMacroAssemblerPPC::SkipUntilCharAndSimd(
+    int cp_offset, int advance_by, unsigned character, unsigned mask,
+    int bounds_check_offset, Label* on_match, Label* on_no_match) {
+  Label scalar, simd_loop, found;
+  const int kCharsPerVector = kVectorSize / char_size();
+
+  const int check_offset =
+      bounds_check_offset + kCharsPerVector + kCheckPositionOffset;
+  DCHECK_GE(check_offset, 0);
+  CheckPosition(check_offset, &scalar);
+
+  Simd128Register char_vec = v0;
+  Simd128Register mask_vec = v1;
+  SplatCharacter(char_vec, character, r3);
+  SplatCharacter(mask_vec, mask, r3);
+
+  __ bind(&simd_loop);
+  Simd128Register input_vec = v2;
+  LoadInputVector(input_vec, cp_offset, r3);
+  Simd128Register eq = v3;
+  __ vand(eq, input_vec, mask_vec);
+  VectorCompareEqual(eq, eq, char_vec, SetRC);
+  __ bne(&found, cr6);
+
+  AdvanceCurrentPosition(kCharsPerVector);
+  __ CmpS64(current_input_offset(), Operand(-check_offset * char_size()));
+  __ blt(&simd_loop);
+  __ b(&scalar);
+
+  __ bind(&found);
+  EmitSkipUntilFoundTail(eq, cp_offset, on_match);
+
+  __ bind(&scalar);
+}
+
+void RegExpMacroAssemblerPPC::SkipUntilCharOrCharSimd(
+    int cp_offset, int advance_by, unsigned char1, unsigned char2,
+    int bounds_check_offset, Label* on_match, Label* on_no_match) {
+  Label scalar, simd_loop, found;
+  const int kCharsPerVector = kVectorSize / char_size();
+
+  const int check_offset =
+      bounds_check_offset + kCharsPerVector + kCheckPositionOffset;
+  DCHECK_GE(check_offset, 0);
+  CheckPosition(check_offset, &scalar);
+
+  Simd128Register char1_vec = v0;
+  Simd128Register char2_vec = v1;
+  SplatCharacter(char1_vec, char1, r3);
+  SplatCharacter(char2_vec, char2, r3);
+
+  // Two record-form compares, each feeding a branch, cost less than or-ing
+  // the results and testing the union (vor has no record form). The found
+  // block recomputes both so that the earliest match of either character
+  // wins, whichever compare took the branch.
+  __ bind(&simd_loop);
+  Simd128Register input_vec = v2;
+  LoadInputVector(input_vec, cp_offset, r3);
+  Simd128Register eq1 = v3;
+  Simd128Register eq2 = v4;
+  VectorCompareEqual(eq1, input_vec, char1_vec, SetRC);
+  __ bne(&found, cr6);
+  VectorCompareEqual(eq2, input_vec, char2_vec, SetRC);
+  __ bne(&found, cr6);
+
+  AdvanceCurrentPosition(kCharsPerVector);
+  __ CmpS64(current_input_offset(), Operand(-check_offset * char_size()));
+  __ blt(&simd_loop);
+  __ b(&scalar);
+
+  __ bind(&found);
+  VectorCompareEqual(eq1, input_vec, char1_vec, LeaveRC);
+  VectorCompareEqual(eq2, input_vec, char2_vec, LeaveRC);
+  __ vor(eq1, eq1, eq2);
+  EmitSkipUntilFoundTail(eq1, cp_offset, on_match);
+
+  __ bind(&scalar);
+}
+
+void RegExpMacroAssemblerPPC::SkipUntilOneOfMasked3(
+    const SkipUntilOneOfMasked3Args& args) {
+  // See the definition of the kSkipUntilOneOfMasked3 peephole bytecode for
+  // more context. The initial bytecode sequence is:
+  //
+  // sequence offset name
+  // bc0   0  SkipUntilBitInTable
+  // bc1  24  Load4CurrentChars
+  // bc2  30  AndCheck4Chars
+  // bc3  40  AdvanceCpAndGoto
+  // bc4  48  Load4CurrentChars
+  // bc5  54  AndCheck4Chars
+  // bc6  64  AndCheck4Chars
+  // bc7  74  AndCheckNot4Chars
+
+  if (!SkipUntilOneOfMasked3UseSimd(args)) {
+    // If we cannot optimize the entire sequence, fall back to the generic
+    // implementation. Note we may still use simd to optimize a subsequence
+    // there.
+    RegExpMacroAssembler::SkipUntilOneOfMasked3(args);
+    return;
+  }
+
+  DCHECK(!args.bc0_nibble_table.is_null());
+  DCHECK(!args.bc0_table.is_null());
+
+  Label scalar_fallback;
+
+  // We need to load 4 chars at bc1 and bc4.
+  static constexpr int kCharsPerLoad = 4;
+  int bounds_check_offset =
+      std::max(args.bc1_bounds_check_offset, args.bc4_bounds_check_offset);
+  DCHECK_LE(args.bc0_cp_offset, bounds_check_offset);
+
+  EmitSkipUntilBitInTableSimdHelper(
+      args.bc0_cp_offset, args.bc0_advance_by, args.bc0_nibble_table,
+      bounds_check_offset, &scalar_fallback,
+      [&](Register index, Register callee_saved) {
+        // SkipUntilBitInTable has matched at offset `index`. Bounds checks
+        // have ensured we can safely perform the below loads without checks.
+        //
+        // The following inner checks are done using simple scalar code.
+        Label bc4_load, continue_outer_loop, goto_bc5_on_equal,
+            goto_bc6_on_equal;
+
+        // The current position is temporarily advanced for this inner block.
+        // If no match is found, it is reverted to the previous state before
+        // returning to simd code for the next loop iteration. The
+        // callee_saved register must be preserved across the inner block.
+        // r6 and r7 are free scratch registers that none of the scalar
+        // helpers below touch (they use r0, r3, r25, r28 and the assembler
+        // scratch r11), so no stack traffic on the mismatch path.
+        __ mr(r6, current_input_offset());
+        __ mr(r7, callee_saved);

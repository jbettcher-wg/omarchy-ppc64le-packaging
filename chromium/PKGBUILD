  'git'
  'go'
  'gperf'
  'java-runtime-headless'
  'lld'
  'ninja'
  'nodejs'
  'opus'
  'pipewire'
  'python'
  'qt6-base'
  # Versioned: crubit's revision (_crubit_rev) is paired with this rustc.
  'rust>=1:1.99.1'
  'rust-bindgen'
  # crubit links rustc's own crates (rustc-dev) and reads std's source.
  'rust-src'
  'rustc-dev'
  'vulkan-headers'
  # Versioned deliberately. 153's devtools needs TypeScript 6.x: with 5.8.3 the
  # build gets ~20 minutes in and then fails on TS2345 (AllowSharedBufferSource)
  # and TS4113 (Map override modifiers), both 5.x->6.x lib typing changes. Bare
  # 'typescript' is satisfied by 5.8.3, so the constraint is what turns a long
  # build failure into a plan-time one. Not a runtime dep -- chromium does not
  # need tsc to run, only to build.
  'typescript>=6.0.0'
  # Likewise: 157's DEPS pins gn 0035961837fb, and its BUILD files use
  # check_includes_strict and allow_circular_includes_from_allowlist, which
  # older gn rejects at `gn gen`. Our pool's gn is that revision, so Arch's
  # 610-line chromium-157-revert-gn-check-includes patch is not needed.
  'gn>=0.2595'
)

# Google API keys (see https://www.chromium.org/developers/how-tos/api-keys)
# Note: These are for Arch Linux use ONLY. For your own distribution, please
# get your own set of keys.
#
# Starting with Chromium 89 (2021-03-02) the OAuth2 credentials have been left
# out: https://archlinux.org/news/chromium-losing-sync-support-in-early-march/
_google_api_key=AIzaSyDwr302FpOSkGRpLlUpPThNTDPbXcIn_FM

prepare() {
  # rustup install nightly

  if (( _manual_clone )); then
    ./fetch-chromium-release $pkgver
  fi
  cd chromium-$pkgver

  # Allow building against system libraries in official builds
  sed -i 's/OFFICIAL_BUILD/GOOGLE_CHROME_BUILD/' \
    tools/generate_shim_headers/generate_shim_headers.py

  # https://crbug.com/893950
  sed -i -e 's/\<xmlMalloc\>/malloc/' -e 's/\<xmlFree\>/free/' \
         -e '1i #include <cstdlib>' \
    third_party/blink/renderer/core/xml/*.cc \
    third_party/blink/renderer/core/xml/parser/xml_document_parser.cc \
    third_party/libxml/chromium/*.cc

  # Use the --oauth2-client-id= and --oauth2-client-secret= switches for
  # setting GOOGLE_DEFAULT_CLIENT_ID and GOOGLE_DEFAULT_CLIENT_SECRET at
  # runtime -- this allows signing into Chromium without baked-in values
  patch -Np1 -i ../use-oauth2-client-switches-as-default.patch

  # Upstream fixes

  # Fixes from Gentoo
  patch -Np1 -i ../chromium-138-nodejs-version-check.patch

  # Allow libclang_rt.builtins from compiler-rt >= 16 to be used
  patch -Np1 -i ../compiler-rt-adjust-paths.patch

  # Increase _FORTIFY_SOURCE level to match Arch's default flags
  patch -Np1 -i ../increase-fortify-level.patch

  # clang 22 lacks -fsanitize-ignore-for-ubsan-feature, which is needed to use
  # -fsanitize=array-bounds without triggering UBSan feature detection. Without
  # feature detection suppression, V8 compiles in __sanitizer_set_death_callback
  # calls that require the UBSan runtime, which is not linked in a trap-mode
  # build. Drop the entire sanitize_c_array_bounds cflags block.
  # Can be dropped when arch has LLVM 23.
  patch -Np1 -i ../chromium-149-drop-unknown-clang-flag.patch

  # Causes a build failure with our clang version
  patch -Np1 -i ../chromium-147-revert-clang-no-lifetime-dse-flag.patch

  # https://crbug.com/456218403
  patch -Np1 -i ../chromium-145-fix-SYS_SECCOMP.patch

  patch -Np1 -i ../chromium-149-build-with-wasm-rollup.patch

  patch -Np1 -i ../chromium-147-rust-1.95-bytemuck.patch

  # enable widevine for arm64
  patch -Np1 -i ../enable-widevine-arm64.patch

  # https://crbug.com/456677057
  patch -Np1 -i ../glibc-2.42-baud-rate-fix.patch

  patch -Np1 -i ../chromium-149-use-of-undeclared-identifier-ERROR.patch

  # Fix issue about missing AVX functions
  # Credit: https://github.com/ungoogled-software/ungoogled-chromium/pull/3837
  patch -Np1 -i ../chromium-150-revert-avx-flag-change.patch

  # Just the reverted commit 8dab8b761385b7946588232e4e2a8c116f9293c3
  patch -Np1 -i "$srcdir/chromium-152-fix-gn-no-public_inputs.patch" -d third_party/devtools-frontend/src

  # Chromium bundles a patched minizip with extra features.
  patch -Np1 -i ../chromium-152-unbundle-minizip-undo-unicode.patch

  patch -Np1 -i ../chromium-152-unbundle-opus-devtools.patch

  # Use system python3 instead of the hermetic cpython3 interpreter
  # https://github.com/ungoogled-software/ungoogled-chromium/pull/3946
  patch -Np1 -i ../chromium-153-hermetic-python.patch

  # third_party/iamf_tools includes vendored Opus via relative "include/opus.h"
  # paths that only resolve against a real bundled Opus checkout; fix them up
  # for the unbundled system Opus build
  patch -Np1 -i ../chromium-153-iamf-tools-unbundled-opus.patch

  # Work around TypeScript becoming a build dependency: disable tsgo for the
  # WebUI and point devtools at the system tsc binary
  # https://github.com/ungoogled-software/ungoogled-chromium/pull/3946
  patch -Np1 -i ../chromium-153-typescript.patch

  patch -Np1 -i ../chromium-153-crubit.patch

  if [[ $CARCH == powerpc64le ]]; then
    # swiftshader bundles a stripped LLVM 10.0 (src/Reactor/BUILD.gn pins
    # llvm_dir to third_party/llvm-10.0; the llvm-16.0 tree beside it is never
    # loaded). Its PPC target compiles PPCXCOFFObjectWriter.cpp and
    # PPCMCAsmInfo.cpp, which subclass MC{XCOFFObjectTargetWriter,AsmInfoXCOFF}
    # -- but the base-class .cpp files are not in the source set, producing
    # undefined symbols at link time. Linux ppc64le uses ELF, but the vtables
    # still need to resolve. Debian's third_party/0001-swiftshader-fix-build
    # patches llvm-16.0/BUILD.gn instead, because Debian also carries
    # debianization/swiftshader-use-llvm-16.patch; without that it is a no-op,
    # so it is skipped below and this one applied.
    patch -Np1 -i ../swiftshader-ppc-xcoff-baseclasses.patch

    # Teach dawn's cipd_deps helper about ppc64le so tint's generate_sources
    # action can locate our go symlink (see linking of go binary below). Not
    # the same fix as Debian's dawn-fix-ppc64le-detection.patch, which orders
    # the __PPC__/__PPC64__ tests in src/utils/platform.h so the pointer-width
    # block does not hit #error; both are needed.
    patch -Np1 -i ../chromium-151-dawn-cipd-add-ppc64le.patch
  fi

  # ppc64le patches (Debian chromium-team, series-ordered). r4 is
  # debian/patches/ppc64le at tag debian/153.0.8010.52-1 of
  # https://salsa.debian.org/chromium-team/chromium -- the exact upload Debian
  # built for this release on ppc64el -- with debian-series being that tag's
  # `ppc64le/` series entries. Refresh from the tag matching pkgver, not
  # master: master tracks the next major, and its regenerated xnnpack and
  # ffmpeg configs and rust-linking rebase did not apply to this one.
  if [[ $CARCH == powerpc64le ]]; then
    # Series entries this recipe does not apply, with the reason. Each was
    # checked against this release's tree, not taken on faith.
    local -A _skip=(
      # Edits swiftshader's llvm-16.0/BUILD.gn, which stock chromium does not
      # build (see swiftshader-ppc-xcoff-baseclasses.patch above).
      [third_party/0001-swiftshader-fix-build.patch]='stock builds swiftshader against llvm-10.0'
      # Stock rtc_base/system/arch.h already has an `#elif defined(__PPC__)`
      # branch that sets 64_BITS and LITTLE_ENDIAN from __PPC64__ and
      # __LITTLE_ENDIAN__ (both defined by clang on ppc64le). The Debian hunk
      # lands inside the MIPS-only `#if defined(__MIPSEL__)` block, so it is
      # dead preprocessor text on every arch, and WEBRTC_ARCH_PPC_FAMILY has
      # no users anywhere in third_party/webrtc.
      [webrtc/Rtc_base-system-arch.h-PPC.patch]='stock arch.h already handles __PPC__; hunk is dead code'
    )
    # POWER9 build: skip the patch that pins v8's GN toolchain config to
    # -mcpu=power8 -maltivec -mvsx. Stock v8/BUILD.gn already sets
    # -mcpu=pwr9 for non-simulator ppc64, and the command-line -mcpu set in
    # build() lands last anyway.
    if (( ! _power8_compat )); then
      _skip[third_party/0001-Force-baseline-POWER8-AltiVec-VSX-CPU-features-when-.patch]='POWER9 build'
    fi

    local _p _rel
    while IFS= read -r _p; do
      [[ -z $_p || $_p == \#* ]] && continue
      [[ $_p == ppc64le/* ]] || continue
      _rel=${_p#ppc64le/}

      if [[ -n ${_skip[$_rel]+set} ]]; then
        msg2 "Skipping ppc64le patch (${_skip[$_rel]}): $_rel"
        continue
      fi

      msg2 "Applying ppc64le patch: $_rel"
      patch -Np1 -i "$srcdir/ppc64le-patches/$_rel"
    done < "$srcdir/ppc64le-patches/debian-series"

    # core/baseline-isa-3-0.patch is commented out of debian-series because it
    # is POWER9-only. Apply it explicitly for the POWER9 build. Since r3 it
    # raises build/config/compiler_cpu_abi.gn, libvpx and the three skia
    # -mcpu=power8 sites that skia-vsx-instructions.patch inserts to power9,
    # and switches on the ISA 3.0 half-float conversions (xvcvhpsp/xvcvsphp)
    # in skia's raster pipeline that the same patch adds behind `#elif 0`.
    if (( ! _power8_compat )); then
      msg2 "Applying ppc64le patch (POWER9 build): core/baseline-isa-3-0.patch"
      # Drop the v8/BUILD.gn hunk. It rewrites the "-mcpu=power8" line that
      # Force-baseline-POWER8-AltiVec-VSX *inserts*, so with that patch skipped
      # there is nothing for it to match -- and stock v8/BUILD.gn already
      # carries cflags += [ "-mcpu=pwr9" ] for non-simulator ppc64, so the
      # hunk is not needed either. Every other hunk applies to what the
      # series left behind and is what actually raises the baseline.
      awk '/^Index: /{skip = ($0 ~ /v8\/BUILD\.gn/)} !skip' \
        "$srcdir/ppc64le-patches/core/baseline-isa-3-0.patch" | patch -Np1
    fi

    # Debian/Raptor's ppc64 seccomp-bpf support writes emulated syscall results
    # back with the sc convention only. glibc uses scv on POWER9, so a denied
    # broker call reads back as success (e.g. -ENOENT as fd 2), which crashes
    # the GPU process on --disable-gpu. Standalone so it reads and upstreams
    # cleanly; see docs/chromium-software-raster-crash.md.
    # Debian's disable/lint.patch. The WebUI eslint/stylelint steps shell out to
    # the hermetic-node path, which prepare() symlinks to the system node. On
    # ppc64le that node (26.4.0) dies inside its own V8 running the eslint
    # loader:
    #
    #   # Fatal error in , line 0
    #   # Check failed: trampoline_pc >= 0.
    #   exit=-5
    #
    # It killed the build at [43841/55987] on gen/chrome/browser/resources/
    # webui_toolbar/eslint.config.mjs. These are lint steps -- they validate
    # TypeScript and produce nothing that ships -- so Debian replaces both
    # scripts with a build/touch.py that creates the expected outputs and exits,
    # which satisfies ninja without running node at all. Debian applies it on
    # every architecture ("implemented in Node.js code that breaks on older
    # systems"); we need it specifically because of the ppc64le V8 fault.
    #
    # The underlying node/V8 ppc64le bug is untouched by this and will bite
    # anything else that drives node hard.
    msg2 "Applying patch: debian-disable-lint.patch"
    patch -Np1 -i "$srcdir/debian-disable-lint.patch"

    msg2 "Applying ppc64le patch: ppc64le-seccomp-scv-return-abi.patch"
    patch -Np1 -i "$srcdir/ppc64le-seccomp-scv-return-abi.patch"

    # Upstream V8 unconditionally emits addpcis (ISA 3.0 / POWER9) in LoadPC,
    # causing an illegal instruction crash in builtin prologues on real POWER8.
    if (( _power8_compat )); then
      msg2 "Applying ppc64le patch (_power8_compat=1): ppc64le-v8-power8-loadpc.patch"
      patch -Np1 -i "$srcdir/ppc64le-v8-power8-loadpc.patch"
    fi

    # V8 ppc64le patch series -- see V8-PPC64LE-PATCHES.md.
    #
    # Unconditional: every instruction these emit is absent from ISA 3.0C
    # Book III Table 1 ("Instructions Controlled by the V 2.07 Bit"), i.e.
    # ISA 2.07, so they are POWER8-legal and benefit both lanes equally.
    # The series carries no _ARCH_PWR9 guards, so what gets compiled is
    # identical on both lanes and identical to what was measured.
    #
    # Must come after the loadpc conditional above: six of the eleven files
    # are shared with it, and that is the order verified against the real
    # extracted tree on both lanes.
    local _vp
    for _vp in maglev-correctness regexp-simd-scans \
               select-roundtieseven-minmax single-bc-branches; do
      msg2 "Applying ppc64le patch: ppc64le-v8-$_vp.patch"
      patch -Np1 -i "$srcdir/ppc64le-v8-$_vp.patch"
    done

    # POWER8 only. mcrxr has been emulated rather than implemented since
    # POWER4 (2805 ns measured against 0.551 for nop), and loadpc routes int32
    # multiply overflow through it, costing 2862 ns/op against 7.0 after this
    # patch -- Octane 6996 -> 19259/19891 on a max-cpu-compat=power8 guest.
    #
    # Not applied on POWER9: there mcrxrx is real hardware and the synthesised
    # sequence measures 4.581 ns against 4.606 for mullwo+mcrxrx+mfcr, i.e.
    # parity. No gain, so no reason to put unexercised codegen into that lane.
    if (( _power8_compat )); then
      msg2 "Applying ppc64le patch (_power8_compat=1): ppc64le-v8-mul32-overflow-synth.patch"
      patch -Np1 -i "$srcdir/ppc64le-v8-mul32-overflow-synth.patch"
      msg2 "Applying ppc64le patch (_power8_compat=1): ppc64le-v8-ov64-overflow-synth.patch"
      patch -Np1 -i "$srcdir/ppc64le-v8-ov64-overflow-synth.patch"
    fi

    # skia-vsx-instructions.patch hardcodes an -mcpu/-mtune into skia's
    # config("default") -- all of skia, not just the vsx TU. r2 wrote power9
    # there; r3+ write power8 and leave the bump to baseline-isa-3-0, which
    # the POWER8 build does not apply, so this is now a safety net: make sure
    # POWER8-legality never depends on what the series happens to say.
    if (( _power8_compat )); then
      msg2 "Pinning skia back to POWER8 (_power8_compat=1)"
      sed -i -e 's/-mcpu=power9/-mcpu=power8/g' -e 's/-mtune=power9/-mtune=power8/g' \
        skia/BUILD.gn third_party/skia/gn/skia/BUILD.gn third_party/skia/BUILD.gn
    fi
  fi

  # Link to system tools required by the build. Go lives under a CIPD-arch
  # directory that dawn's cipd_deps.get_cipd_platform() looks up at build
  # time — pick the matching name per arch.
  local _cipd_arch=linux-amd64
  [[ $CARCH == powerpc64le ]] && _cipd_arch=linux-ppc64le

  mkdir -p third_party/node/linux/node-linux-x64/bin \
           third_party/jdk/current/bin \
           third_party/rust-toolchain/bin \
           "third_party/dawn/tools/golang/$_cipd_arch/bin"

  ln -s /usr/bin/node third_party/node/linux/node-linux-x64/bin/
  ln -s /usr/bin/java third_party/jdk/current/bin/
  if (( !_manual_clone )); then
    ln -s /usr/bin/rustc third_party/rust-toolchain/bin/
    ln -s /usr/bin/go "third_party/dawn/tools/golang/$_cipd_arch/bin/"
  fi

  # remove x86_64 binary and use our own
  rm -f third_party/gperf/cipd/bin/gperf
  ln -s /usr/bin/gperf third_party/gperf/cipd/bin/

  if (( !_system_clang )); then
    # Use prebuilt rust as system rust cannot be used due to the error:
    #   error: the option `Z` is only accepted on the nightly compiler
    ./tools/rust/update_rust.py

    # To link to rust libraries we need to compile with prebuilt clang
    ./tools/clang/scripts/update.py
  fi

  # Remove bundled libraries for which we will use the system copies; this
  # *should* do what the remove_bundled_libraries.py script does, with the
  # added benefit of not having to list all the remaining libraries
  local _lib
  for _lib in ${_unwanted_bundled_libs[@]}; do
    find "third_party/$_lib" -type f \
      \! -path "third_party/$_lib/chromium/*" \
      \! -path "third_party/$_lib/google/*" \
      \! -path "third_party/harfbuzz-ng/utils/hb_scoped.h" \
      \! -regex '.*\.\(gn\|gni\|isolate\)' \
      -delete
  done

  ./build/linux/unbundle/replace_gn_files.py \
    --system-libraries "${!_system_libs[@]}"

  # Generate missing header
  if (( _manual_clone )); then
    python3 build/util/lastchange.py -m DAWN_COMMIT_HASH \
      -s third_party/dawn --revision gpu/webgpu/DAWN_VERSION \
      --header gpu/webgpu/dawn_commit_hash.h
  fi
}

build() {
  # Pin LAUNCHER_VERSION to pkgver-pkgrel. Without this, the launcher's Makefile
  # falls through to `git describe` which walks up into any parent git repo
  # (e.g. our own working tree) and picks whatever tag it finds there.
  sed -i "s@\$(shell git describe 2>/dev/null || echo v8)@$pkgver-$pkgrel@" \
    chromium-launcher-$_launcher_ver/Makefile
  make -C chromium-launcher-$_launcher_ver

  cd chromium-$pkgver

  if (( _system_clang )); then
    export CC=clang
    export CXX=clang++
    export AR=ar
    export NM=nm
  else
    local _clang_path="$PWD/third_party/llvm-build/Release+Asserts/bin"
    export CC=$_clang_path/clang
    export CXX=$_clang_path/clang++
    export AR=$_clang_path/llvm-ar
    export NM=$_clang_path/llvm-nm
  fi

  local _flags=(
    # GN invokes the compiler directly unless told otherwise, so without
    # this every compile bypasses ccache and a rebuild of the same tree
    # pays full cost -- measured at 8.5% hits across a whole chromium run.
    'cc_wrapper="ccache"'
    'custom_toolchain="//build/toolchain/linux/unbundle:default"'
    'host_toolchain="//build/toolchain/linux/unbundle:default"'
    'is_official_build=true' # implies is_cfi=true on x86_64
    'symbol_level=0' # sufficient for backtraces on x86(_64)
    'treat_warnings_as_errors=false'
    'fatal_linker_warnings=false'
    'disable_fieldtrial_testing_config=true'
    'blink_enable_generated_code_formatting=false'
    'ffmpeg_branding="Chrome"'
    'proprietary_codecs=true'
    'rtc_use_pipewire=true'
    'link_pulseaudio=true'
    'use_custom_libcxx=true' # https://github.com/llvm/llvm-project/issues/61705
    'use_sysroot=false'
    'use_system_libffi=true'
    'enable_hangout_services_extension=true'
    'enable_widevine=true'
    'use_qt5=false'
    'use_qt6=true'
    'moc_qt6_path="/usr/lib/qt6"'
    "google_api_key=\"$_google_api_key\""
    'use_clang_modules=false'
  )

  if [[ -n ${_system_libs[icu]+set} ]]; then
    _flags+=('icu_use_data_file=false')
  fi

  if (( _system_clang )); then
     local _clang_version=$(
       clang --version | grep -m1 version | sed 's/.* \([0-9]\+\).*/\1/')

    _flags+=(
      'clang_base_path="/usr"'
      'clang_use_chrome_plugins=false'
      "clang_version=\"$_clang_version\""
      'chrome_pgo_phase=0' # needs newer clang to read the bundled PGO profile
    )

    # Allow the use of nightly features with stable Rust compiler
    # https://github.com/ungoogled-software/ungoogled-chromium/pull/2696#issuecomment-1918173198
    export RUSTC_BOOTSTRAP=1

    _flags+=(
      'rust_sysroot_absolute="/usr"'
      'rust_bindgen_root="/usr"'
      "rustc_version=\"$(rustc --version | awk '{ print $2 ;}')\""
    )
  fi

  # Facilitate deterministic builds (taken from build/config/compiler/BUILD.gn)
  CFLAGS+='   -Wno-builtin-macro-redefined'
  CXXFLAGS+=' -Wno-builtin-macro-redefined'
  CPPFLAGS+=' -D__DATE__=  -D__TIME__=  -D__TIMESTAMP__='

  # Do not warn about unknown warning options
  CFLAGS+='   -Wno-unknown-warning-option'
  CXXFLAGS+=' -Wno-unknown-warning-option'

  # Let Chromium set its own symbol level
  CFLAGS=${CFLAGS/-g }
  CXXFLAGS=${CXXFLAGS/-g }

  # https://github.com/ungoogled-software/ungoogled-chromium-archlinux/issues/123
  CFLAGS=${CFLAGS/-fexceptions}
  CFLAGS=${CFLAGS/-fcf-protection}
  CXXFLAGS=${CXXFLAGS/-fexceptions}
  CXXFLAGS=${CXXFLAGS/-fcf-protection}

  # This appears to cause random segfaults when combined with ThinLTO
  # https://bugs.archlinux.org/task/73518
  CFLAGS=${CFLAGS/-fstack-clash-protection}
  CXXFLAGS=${CXXFLAGS/-fstack-clash-protection}

  # https://crbug.com/957519#c122
  CXXFLAGS=${CXXFLAGS/-Wp,-D_GLIBCXX_ASSERTIONS}

  if [[ $CARCH == aarch64 ]] || [[ $CARCH == riscv64 ]]; then
    # On aarch64 and riscv64, certain files (e.g. in libvpx and libyuv) needs to
    # be compiled with additional arch features (e.g. dotprod, sve, sme, rvv)
    # Having an arch setting in the C(XX)FLAGS overrides those
    # and causes compilation failure
    CFLAGS="${CFLAGS/-march=*([^ ]) }"
    CXXFLAGS="${CXXFLAGS/-march=*([^ ]) }"
  fi

  if [[ $CARCH == powerpc64le ]]; then
    # GN's unbundle toolchain (custom_toolchain= below) passes $CFLAGS and
    # $CXXFLAGS through verbatim and appends them AFTER GN's own config flags,
    # so the last -mcpu on the command line wins. Set it here explicitly rather
    # than inheriting whatever the build host's makepkg.conf carries -- the
    # ppc64le -mcpu strip that used to live here was dropped in the 150->151
    # rebase, which is how a "POWER8-legal" recipe started emitting ISA 3.0.
    CFLAGS="${CFLAGS/-mcpu=*([^ ]) }";     CFLAGS="${CFLAGS/-mtune=*([^ ]) }"
    CXXFLAGS="${CXXFLAGS/-mcpu=*([^ ]) }"; CXXFLAGS="${CXXFLAGS/-mtune=*([^ ]) }"
    if (( _power8_compat )); then
      CFLAGS+=" -mcpu=power8 -mtune=power8"
      CXXFLAGS+=" -mcpu=power8 -mtune=power8"
    else
      CFLAGS+=" -mcpu=power9 -mtune=power9"
      CXXFLAGS+=" -mcpu=power9 -mtune=power9"
    fi
    msg2 "ppc64le ISA level: _power8_compat=$_power8_compat"
  fi

  gn gen out/Release --args="${_flags[*]}"
  # NINJAFLAGS carries the -j bq was given; ninja otherwise takes every CPU.
  ninja ${NINJAFLAGS:-} -C out/Release chrome chrome_sandbox chromedriver.unstripped
}

package() {
  cd chromium-launcher-$_launcher_ver
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dvm644 LICENSE \
    "$pkgdir/usr/share/licenses/chromium/LICENSE.launcher"

  cd ../chromium-$pkgver

  install -Dv out/Release/chrome "$pkgdir/usr/lib/chromium/chromium"
  install -Dv out/Release/chromedriver.unstripped "$pkgdir/usr/bin/chromedriver"
  install -Dvm4755 out/Release/chrome_sandbox "$pkgdir/usr/lib/chromium/chrome-sandbox"

  install -Dvm644 chrome/installer/linux/common/desktop.template \
    "$pkgdir/usr/share/applications/chromium.desktop"
  install -Dvm644 chrome/app/resources/manpage.1.in \
    "$pkgdir/usr/share/man/man1/chromium.1"
  sed -i \
    -e 's/@@MENUNAME/Chromium/g' \
    -e 's/@@PACKAGE/chromium/g' \
    -e 's/@@usr_bin_symlink_name/chromium/g' \
    -e 's|@@uri_scheme|x-scheme-handler/chromium;|g' \
    -e 's/@@extra_desktop_entries//g' \
    "$pkgdir/usr/share/applications/chromium.desktop" \
    "$pkgdir/usr/share/man/man1/chromium.1"

  # Fill in common Chrome/Chromium AppData template with Chromium info
  (
    tmpl_file=chrome/installer/linux/common/appdata.xml.template
    info_file=chrome/installer/linux/common/chromium-browser.info
    . $info_file; PACKAGE=chromium
    export $(grep -o '^[A-Z_]*' $info_file)
    sed -E -e 's/@@([A-Z_]*)/\${\1}/g' -e '/<update_contact>/d' $tmpl_file | envsubst
  ) \
  | install -Dvm644 /dev/stdin "$pkgdir/usr/share/metainfo/chromium.appdata.xml"

  local toplevel_files=(
    chrome_100_percent.pak
    chrome_200_percent.pak
    chrome_crashpad_handler
    libqt6_shim.so
    resources.pak
    v8_context_snapshot.bin

    # ANGLE
    libEGL.so
    libGLESv2.so

    # SwiftShader ICD
    libvk_swiftshader.so
    libvulkan.so.1
    vk_swiftshader_icd.json
  )

  if [[ -z ${_system_libs[icu]+set} ]]; then
    toplevel_files+=(icudtl.dat)
  fi

  cp "${toplevel_files[@]/#/out/Release/}" "$pkgdir/usr/lib/chromium/"
  install -Dvm644 -t "$pkgdir/usr/lib/chromium/locales" out/Release/locales/*.pak

  for size in 24 48 64 128 256; do
    install -Dvm644 "chrome/app/theme/chromium/product_logo_$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/chromium.png"
  done

  for size in 16 32; do
    install -Dvm644 "chrome/app/theme/default_100_percent/chromium/product_logo_$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/chromium.png"
  done

  install -Dvm644 LICENSE "$pkgdir/usr/share/licenses/chromium/LICENSE"

  # Which ISA variant this package is. The POWER9 and POWER8 builds come out of
  # one recipe with identical pkgname, pkgver and pkgrel, so the *only* thing
  # distinguishing the two files is which pool they were put in -- and a POWER9
  # build misfiled into the baseline pool installs happily and then SIGILLs.
  #
  # This records intent and is greppable without objdump. It is NOT the check:
  # a toggle that silently failed to apply would still write the right value
  # here. The check is an ISA scan of usr/lib/chromium/chromium -- the POWER9
  # build carries ~58k ISA 3.0 instructions, the POWER8 build must carry none
  # beyond the benign runtime-dispatch and jump-table classes. Verify the
  # artifact, not the marker; see README.md.
  if [[ $CARCH == powerpc64le ]]; then
    install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/chromium/ISA-LEVEL" <<EOF
_power8_compat=$_power8_compat
isa=$( (( _power8_compat )) && echo "2.07 (POWER8-legal)" || echo "3.0 (POWER9)" )
EOF
  fi
}

# vim:set ts=2 sw=2 et:

prepare() {
  cd bun

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ $src = *.patch ]] || continue
    printf 'Applying %s\n' "$src"
    patch -Np1 -i "$srcdir/$src"
  done
}

build() {
  cd bun

  # The WebKit source the `webkit` package installed. Bun checks only for
  # CMakeLists.txt here.
  export BUN_WEBKIT_PATH=/usr/src/bun-webkit

  # The self-hosting driver, by absolute path. This is not cosmetic:
  # findBun() in scripts/build/tools.ts prefers a bun at ~/.bun/bin/bun, so a
  # developer's own install would otherwise silently become the codegen driver
  # -- and on this architecture that is as likely to be an x86_64 binary under
  # binfmt, which works, slowly, and produces a build nobody can reproduce.
  local bootstrap=/usr/lib/bun-bootstrap/bun
  export PATH="$(dirname "$bootstrap"):$PATH"

  # -j is bounded deliberately. The default is nproc+2, and on a 176-thread
  # POWER9 that exhausts 446 GiB: the C++ translation units in JavaScriptCore
  # and bun's unified sources peak in the multi-GiB range EACH. 30 is what fits
  # with room for the rest of the machine.
  local jobs="${MAKEFLAGS##*-j}"
  [[ $jobs =~ ^[0-9]+$ ]] || jobs=30
  (( jobs > 30 )) && jobs=30

  # The nested WebKit cmake runs as ONE ninja edge, so the -j above does not
  # bound it; it would pick nproc+2 on its own. CMAKE_BUILD_PARALLEL_LEVEL is
  # the only lever, because bun's dep_build rule passes no -j.
  export CMAKE_BUILD_PARALLEL_LEVEL="$jobs"

  "$bootstrap" scripts/build.ts --profile=release --webkit=local -j"$jobs" --configure-only

  # CONTROL, before the expensive part: the driver baked into build.ninja must
  # be the bootstrap we chose and must be a PowerPC binary. Both halves have
  # been wrong in practice -- the first when ~/.bun/bin/bun outranked it, the
  # second when the bootstrap was still the emulated x86_64 one.
  local driver
  driver="$(grep -m1 -oE '^  command = [^ ]+/bun ' build/release/build.ninja | awk '{print $3}')"
  [[ -n $driver ]] || { echo 'CONTROL FAILED: build.ninja names no bun driver' >&2; return 1; }
  file -L "$driver" | grep -q PowerPC \
    || { echo "CONTROL FAILED: codegen driver is not a PowerPC bun ($driver)" >&2; return 1; }
  [[ "$(readlink -f "$driver")" == "$(readlink -f "$bootstrap")" ]] \
    || { echo "CONTROL FAILED: driver is $driver, not $bootstrap" >&2; return 1; }
  printf 'codegen driver: %s\n' "$driver"

  "$bootstrap" scripts/build.ts --profile=release --webkit=local -j"$jobs"
}

check() {
  cd bun
  # Smoke only. The full suite needs a display, a network and ~40 minutes; the
  # cgroup-capped runner in powerpc64le-handbook/tools/jsc-test-runner is the
  # thing to use for that, because JSTests/stress has memoryHog! tests that
  # will take the whole machine otherwise.
  ./build/release/bun --version
  ./build/release/bun -e 'if (2 + 2 !== 4) throw new Error("arithmetic")'
}

package() {
  cd bun
  install -Dm755 build/release/bun "$pkgdir/usr/bin/bun"
  ln -s bun "$pkgdir/usr/bin/bunx"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"

  # Shell completions, if this revision ships them.
  if [[ -f completions/bun.zsh ]]; then
    install -Dm644 completions/bun.zsh "$pkgdir/usr/share/zsh/site-functions/_bun"
  fi
  if [[ -f completions/bun.bash ]]; then
    install -Dm644 completions/bun.bash "$pkgdir/usr/share/bash-completion/completions/bun"
  fi
  if [[ -f completions/bun.fish ]]; then
    install -Dm644 completions/bun.fish "$pkgdir/usr/share/fish/vendor_completions.d/bun.fish"
  fi
}

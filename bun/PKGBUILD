# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Bun on ppc64le (POWER8+, little-endian, glibc).
#
# Two things about this build are worth knowing before changing it.
#
# 1. Bun is SELF-HOSTING: its build runs a bun to drive ~131 codegen steps. The
#    first native ppc64le bun was produced by running an x86_64 bun under
#    fastppcx86 on POWER9 hardware -- no x86 machine was involved at any point.
#    That bootstrap is closed now and this package needs only `bun` in
#    makedepends, but a machine with no native bun at all has to redo that one
#    emulated step. See bun-bootstrap.
#
# 2. WebKit is NOT built from a tarball here. Bun's own build drives WebKit's
#    cmake (`--webkit=local`, reading $BUN_WEBKIT_PATH), and the `webkit`
#    package ships that source tree. Do not switch this to `--webkit=prebuilt`:
#    prebuilt tarballs are published per {os, arch, musl, debug|lto, asan} and
#    none exists for ppc64le, and the ASAN setting MUST match bun's because
#    WTF::Vector's layout changes with it -- mismatching corrupts memory
#    silently rather than failing to link.

pkgname=bun
pkgdesc='Incredibly fast JavaScript runtime, bundler, test runner and package manager'
_commit=471b5868b6b3a6aec4e738b4c08b868f409c1673
pkgver=1.4.3
pkgrel=1
arch=('powerpc64le')
url='https://bun.sh'
license=('MIT')
depends=('glibc' 'gcc-libs' 'libstdc++5')
makedepends=('git' 'cmake' 'ninja' 'clang' 'lld' 'llvm' 'rust' 'ruby' 'python'
             'perl' 'pkgconf' 'webkit' 'bun-bootstrap')
provides=('bun')
options=('!lto')   # Bun drives its own LTO settings through scripts/build.ts

source=(
  "bun::git+https://github.com/oven-sh/bun.git#commit=$_commit"
  patches/0001-Port-bun-to-ppc64le-POWER8-little-endian-glibc.patch
  patches/0002-ppc64le-build-JSC-with-the-Baseline-JIT-on.patch
  patches/0003-ppc64le-teach-the-test-runner-the-host-architecture.patch
  patches/0004-ppc64le-wrap-the-glibc-symbols-a-native-build-refere.patch
  patches/0005-ppc64le-give-V8-s-callback-exit-frame-its-constant-p.patch
  patches/0006-ppc64le-make-the-arch-hardcoded-and-page-size-bound-.patch
  patches/0007-ppc64le-termios-c_lflag-bits-are-per-ABI-not-darwin-.patch
  patches/0008-ppc64le-the-arch-name-bun-calls-itself-and-the-regis.patch
  patches/0009-bun-ffi-cc-compile-with-the-system-C-compiler-where-.patch
  patches/0010-ppc64le-turn-WebAssembly-and-the-sampling-profiler-o.patch
)


+    /// `cc()` where TinyCC has no code generator for the target
+    /// (`!ENABLE_TINYCC`: ppc64le, android, freebsd).
+    ///
+    /// The sources go to the system C compiler as a shared object, which is
+    /// then loaded exactly like `dlopen()` loads any other library — including
+    /// the JS↔C thunks, which JavaScriptCore builds from the signature
+    /// (`Bun__CreateJSCFFIFunction`). None of TinyCC's scaffolding is
+    /// reproduced: no generated `JSFunctionCall` wrapper, no `FFI.h`, no
+    /// `libtcc1.c` compiler-rt and no `ffi-std*.h` stand-in headers.
+    ///
+    /// `napi_env` is the one thing this cannot carry. TinyCC's wrapper
+    /// materialised it out of an injected symbol; a JSC signature has no slot
+    /// for it (`FFI::Type` reserves the tag). `napi_value` is a JSValue and
+    /// works.
+    #[cfg(unix)]
+    fn cc_with_system_compiler(
+        global_this: &JSGlobalObject,
+        mut compile_c: CompileC,
+    ) -> JsResult<JSValue> {
+        for function in compile_c.symbols.map.values() {
+            if function.arg_types.contains(&ABIType::NapiEnv) {
+                return Err(global_this.throw(format_args!(
+                    "bun:ffi cc(): napi_env arguments need the TinyCC backend, which has no code generator for this target. napi_value works; take the env from a napi_value instead."
+                )));
+            }
+        }
+
+        let object_path = match compile_c.compile_with_system_compiler(global_this) {
+            Ok(path) => path,
+            Err(err) => return Err(err),
+        };
+
+        let dylib = match bun_sys::DynLib::open(object_path.as_bytes()) {
+            Ok(d) => d,
+            Err(_) => {
+                let dlerror_msg = get_dl_error();
+                // The object is only useful for a post-mortem, and only while
+                // it is still on disk.
+                let _ = bun_sys::unlink(object_path.as_zstr());
+                return Err(global_this.throw(format_args!(
+                    "bun:ffi cc(): the compiled object did not load: {}",
+                    BStr::new(&dlerror_msg)
+                )));
+            }
+        };
+        // POSIX keeps the mapping alive across an unlink, so the temporary
+        // does not outlive the process that made it.
+        let _ = bun_sys::unlink(object_path.as_zstr());
+
+        let mut symbols = core::mem::take(&mut compile_c.symbols.map);
+        let mut size = symbols.values().len();
+        if size >= 63 {
+            size = 0;
+        }
+        let obj = JSValue::create_empty_object(global_this, size);
+        let _obj_guard = obj.protected();
+
+        let lib_ptr: *mut FFI = bun_core::heap::into_raw(Box::new(FFI::default()));
+        // SAFETY: `lib_ptr` is the fresh allocation from into_raw above.
+        let js_object = unsafe { FFI::to_js_ptr(lib_ptr, global_this) };
+        let _js_object_guard = js_object.protected();
+
+        for function in symbols.values_mut() {
+            let function_name = ZBox::from_bytes(function.base_name.as_bytes());
+            let Some(target) = dylib.lookup::<*mut c_void>(&function_name) else {
+                let ret = global_this.to_invalid_arguments(format_args!(
+                    "\"{}\" is missing from {}. Was it included in the source code?",
+                    BStr::new(function_name.as_bytes()),
+                    BStr::new(compile_c.source.first().as_bytes())
+                ));
+                dylib.close();
+                // SAFETY: lib_ptr is the live, JS-owned FFI allocation.
+                unsafe { &*lib_ptr }.do_close();
+                return Ok(ret);
+            };
+            function.symbol_from_dynamic_library = Some(target);
+
+            let symbol_name = EncodedSlice::utf8(function_name.as_bytes());
+            let cb = match create_jsc_ffi_function(
+                global_this,
+                &symbol_name,
+                function,
+                target,
+                js_object,
+            ) {
+                Ok(cb) if !cb.is_empty() => cb,
+                result => {
+                    let ret = result.map(|_| {
+                        global_this.to_invalid_arguments(format_args!(
+                            "Failed to create FFI function for symbol \"{}\"",
+                            BStr::new(function_name.as_bytes())
+                        ))
+                    });
+                    dylib.close();
+                    // SAFETY: lib_ptr is the live, JS-owned FFI allocation.
+                    unsafe { &*lib_ptr }.do_close();
+                    return ret;
+                }
+            };
+            obj.put(global_this, symbol_name, cb);
+        }
+
+        // SAFETY: lib_ptr is the live, JS-owned FFI allocation.
+        let lib_ref = unsafe { &*lib_ptr };
+        lib_ref.functions.set(symbols);
+        lib_ref.dylib.set(Some(dylib));
+        symbols_value_set_cached(js_object, global_this, obj);
+        Ok(js_object)
+    }
+
+    #[cfg(not(unix))]
+    fn cc_with_system_compiler(
+        global_this: &JSGlobalObject,
+        _compile_c: CompileC,
+    ) -> JsResult<JSValue> {
+        Err(global_this.throw(format_args!(
+            "bun:ffi cc() is not available in this build (TinyCC is disabled)"
+        )))
+    }

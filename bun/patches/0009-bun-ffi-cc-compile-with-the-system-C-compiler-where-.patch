 use super::get_dl_error;
 
+/// The C compiler `cc()` shells out to where TinyCC is unavailable. `$CC`
+/// wins if it is set — and if it is set and cannot be found, that is an error
+/// rather than a reason to fall through to a different compiler.
+#[cfg(unix)]
+fn resolve_system_cc(buf: &mut bun_paths::PathBuffer) -> Option<ZBox> {
+    let path_env = bun_core::util::getenv_z(zstr!("PATH")).unwrap_or(b"");
+    if let Some(cc) = bun_core::util::getenv_z(zstr!("CC"))
+        && !cc.is_empty()
+    {
+        if bun_core::strings::contains_char(cc, b'/') {
+            return Some(ZBox::from_bytes(cc));
+        }
+        return bun_which::which(buf, path_env, b".", cc).map(|z| ZBox::from_bytes(z.as_bytes()));
+    }
+    for candidate in [b"clang".as_slice(), b"cc".as_slice(), b"gcc".as_slice()] {
+        if let Some(found) = bun_which::which(buf, path_env, b".", candidate) {
+            return Some(ZBox::from_bytes(found.as_bytes()));
+        }
+    }
+    None
+}
+
+/// `<tmpdir>/bun-cc-XXXX.so`, absolute so both the compiler's `-o` and
+/// `dlopen` can use it.
+#[cfg(unix)]
+fn system_cc_output_path() -> Option<ZBox> {
+    let mut name_buf = bun_paths::path_buffer_pool::get();
+    let name =
+        Fs::FileSystem::tmpname(b"bun-cc", &mut name_buf.0, bun_core::fast_random()).ok()?;
+    let mut path = Vec::new();
+    path.extend_from_slice(Fs::RealFS::tmpdir_path());
+    if !path.ends_with(b"/") {
+        path.push(b'/');
+    }
+    path.extend_from_slice(name.as_bytes());
+    path.extend_from_slice(b".so");
+    Some(ZBox::from_bytes(&path))
+}
+
 /// Run a function that needs to write to JIT-protected memory.

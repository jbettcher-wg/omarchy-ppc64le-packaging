 /// This is dangerous as it allows overwriting executable regions of memory.
@@ -608,6 +647,117 @@ impl CompileC {
             .filter(|d| !d.is_empty())
     }
 
+    /// Build the sources into a shared object with the system C compiler and
+    /// return its path. Diagnostics go to bun's own stderr: a real compiler
+    /// has one, unlike TinyCC's error callback, and the user gets clang's
+    /// output verbatim rather than a re-wrapped copy.
+    ///
+    /// No compiler version is required. The flags are `-shared -fPIC`, a
+    /// language standard, and the `-I`/`-D`/`-L`/`-l` the caller asked for;
+    /// all of them predate clang 3.1 and gcc 4.7.
+    #[cfg(unix)]
+    pub(crate) fn compile_with_system_compiler(
+        &mut self,
+        global_this: &JSGlobalObject,
+    ) -> JsResult<ZBox> {
+        let mut which_buf = bun_paths::PathBuffer::ZEROED;
+        let Some(cc) = resolve_system_cc(&mut which_buf) else {
+            return Err(global_this.throw(format_args!(
+                "bun:ffi cc() needs a C compiler on PATH (clang, cc or gcc), or $CC pointing at one. This build has no TinyCC for this target."
+            )));
+        };
+
+        let Some(out_path) = system_cc_output_path() else {
+            return Err(
+                global_this.throw(format_args!("bun:ffi cc(): could not create a temporary file"))
+            );
+        };
+
+        let mut argv: Vec<Vec<u8>> = Vec::new();
+        argv.push(cc.as_bytes().to_vec());
+        argv.push(b"-shared".to_vec());
+        argv.push(b"-fPIC".to_vec());
+
+        // Same precedence as the TinyCC path: an explicit `flags` option
+        // replaces the defaults, otherwise $BUN_CC_OPTIONS, otherwise these.
+        // $BUN_TCC_OPTIONS is deliberately not read here — its documented
+        // value carries TinyCC-only spellings such as
+        // `-Wl,--export-all-symbols`, which a real linker rejects.
+        if !self.flags.is_empty() {
+            for word in bun_core::strings::split_any(self.flags.as_bytes(), b" \t") {
+                if !word.is_empty() {
+                    argv.push(word.to_vec());
+                }
+            }
+        } else if let Some(opts) = bun_core::util::getenv_z(zstr!("BUN_CC_OPTIONS")) {
+            for word in bun_core::strings::split_any(opts, b" \t") {
+                if !word.is_empty() {
+                    argv.push(word.to_vec());
+                }
+            }
+        } else {
+            argv.push(b"-std=c11".to_vec());
+            argv.push(b"-O2".to_vec());
+            argv.push(b"-g".to_vec());
+        }
+
+        for include_dir in self.include_dirs.items.iter() {
+            argv.push(b"-I".to_vec());
+            argv.push(include_dir.as_bytes().to_vec());
+        }
+        for define in self.define.iter() {
+            let mut arg = b"-D".to_vec();
+            arg.extend_from_slice(define[0].as_bytes());
+            if !define[1].is_empty() {
+                arg.push(b'=');
+                arg.extend_from_slice(define[1].as_bytes());
+            }
+            argv.push(arg);
+        }
+
+        match &self.source {
+            Source::File(file) => argv.push(file.as_bytes().to_vec()),
+            Source::Files(files) => {
+                for file in files.iter() {
+                    argv.push(file.as_bytes().to_vec());
+                }
+            }
+        }
+
+        for library_dir in self.library_dirs.items.iter() {
+            argv.push(b"-L".to_vec());
+            argv.push(library_dir.as_bytes().to_vec());
+        }
+        for library in self.libraries.items.iter() {
+            let mut arg = b"-l".to_vec();
+            arg.extend_from_slice(library.as_bytes());
+            argv.push(arg);
+        }
+
+        argv.push(b"-o".to_vec());
+        argv.push(out_path.as_bytes().to_vec());
+
+        let status = match bun_core::util::spawn_sync_inherit_no_stdin(&argv) {
+            Ok(status) => status,
+            Err(_) => {
+                return Err(global_this.throw(format_args!(
+                    "bun:ffi cc(): could not run {}",
+                    BStr::new(cc.as_bytes())
+                )));
+            }
+        };
+        if !status.is_ok() {
+            let _ = bun_sys::unlink(out_path.as_zstr());
+            return Err(global_this.throw(format_args!(
+                "bun:ffi cc(): {} failed to compile {} (its diagnostics are above)",
+                BStr::new(cc.as_bytes()),
+                BStr::new(self.source.first().as_bytes())
+            )));
+        }
+
+        Ok(out_path)
+    }

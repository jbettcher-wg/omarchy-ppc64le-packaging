diff --git a/test/harness.ts b/test/harness.ts
index 3e4c5c8c..34399351 100644
--- a/test/harness.ts
+++ b/test/harness.ts
@@ -63,6 +63,30 @@ function detectASAN(): boolean {
   return basename(process.execPath).includes("bun-asan");
 }
 
+let cachedPageSize: number | undefined;
+
+/**
+ * The kernel page size in bytes: 4 KiB on most hosts, 16 KiB on Apple silicon,
+ * 64 KiB on POWER and some arm64 distributions.
+ *
+ * RSS is accounted in whole pages, and the allocator's expansion steps are
+ * page-quantised too, so a test that bounds an RSS delta has a noise floor that
+ * moves with this number. Scale both the workload and the bound by
+ * `pageSize() / 4096` rather than adding a second hardcoded megabyte figure —
+ * the leak stays the same multiple of the bound on every host.
+ */
+export function pageSize(): number {
+  if (cachedPageSize === undefined) {
+    cachedPageSize = 4096;
+    if (!isWindows) {
+      const probe = Bun.spawnSync({ cmd: ["getconf", "PAGESIZE"], stdout: "pipe", stderr: "ignore" });
+      const parsed = Number(probe.stdout?.toString().trim());
+      if (Number.isSafeInteger(parsed) && parsed > 0) cachedPageSize = parsed;
+    }
+  }
+  return cachedPageSize;
+}

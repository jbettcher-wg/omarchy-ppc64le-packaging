+    #[cfg(target_arch = "powerpc64")]
+    {
+        // PowerPC does NOT use the in-band negative-errno convention the
+        // other two arms get for free: the kernel returns a *positive* errno
+        // in r3 and signals failure out-of-band by setting the summary
+        // overflow bit (SO) of CR0. Reproducing that in inline asm means
+        // reading CR and masking bit 3, which is easy to get subtly wrong.
+        // glibc's `syscall(2)` wrapper already does it, so go through libc
+        // and re-encode the result into the `-errno` form the C caller in
+        // `epoll_kqueue.c` decodes. The extra call is irrelevant here (these
+        // are blocking epoll waits).
+        //
+        // SAFETY: same contract as the other arms — the caller guarantees the
+        // arguments are valid for `nr`.
+        let ret = unsafe {
+            libc::syscall(
+                nr as libc::c_long,
+                a1 as libc::c_long,
+                a2 as libc::c_long,
+                a3 as libc::c_long,
+                a4 as libc::c_long,
+                a5 as libc::c_long,
+                a6 as libc::c_long,
+            )
+        };
+        if ret == -1 {
+            // SAFETY: `__errno_location` is always valid on glibc/musl.
+            let e = unsafe { *libc::__errno_location() };
+            return -(e as isize);
+        }
+        return ret as isize;
+    }
+    #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64", target_arch = "powerpc64")))]
     compile_error!("raw_syscall6: unsupported architecture");
 }
 

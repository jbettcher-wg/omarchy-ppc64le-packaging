# POWER Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: dtag <dtag00@gmail.com>
pkgname=ceres-solver
pkgver=2.2.0
pkgrel=5
pkgdesc="Solver for nonlinear least squares problems"
arch=(x86_64 powerpc64le powerpc64 powerpc espresso)
url="http://ceres-solver.org/"
license=('Apache-2.0')
depends=('google-glog' 'suitesparse' 'lapack' 'libstdc++' 'glibc' 'libgcc')
makedepends=('cmake' 'ninja' 'eigen')
optdepends=('openmp')
# ceres-solver.org stopped answering on both 80 and 443 (checked 2026-10-31),
# so the release tarball is unfetchable. The upstream git tag is the same
# source -- include/ceres/version.h reads 2.2.0 -- so take it from GitHub.
source=("$pkgname-$pkgver.tar.gz::https://github.com/ceres-solver/ceres-solver/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('12efacfadbfdc1bbfa203c236e96f4d3c210bed96994288b3ff0c8e7c6f350d4')
options=('staticlibs')

prepare() {
  cd $srcdir/ceres-solver-$pkgver
  # eigen 5.x compat
  sed -i "s|Eigen3 3.3|Eigen3|g" CMakeLists.txt
  sed -i "s|Eigen3 \${CERES_EIGEN_VERSION}|Eigen3|g" cmake/CeresConfig.cmake.in
}

build() {
  cd $pkgname-$pkgver
  cmake \
      -Bbuild \
      -GNinja \
      -DCMAKE_BUILD_TYPE=None \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DEIGENSPARSE=ON \
      -DBUILD_SHARED_LIBS=ON \
      -DBUILD_TESTING=OFF \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_BENCHMARKS=OFF

  ninja -C build
}

package() {
  cd $pkgname-$pkgver
  DESTDIR=$pkgdir ninja -C build install
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: Markus Näther <naether.markus@gmail.com>

pkgname=rocm10-hipblas
# Upstream project name, separate from $pkgname: ours is renamed so the ROCm 7
# generation stays in the pool, while the monorepo path keeps the upstream one.
_project=hipblas
pkgver=7.2.4
pkgrel=1
pkgdesc='ROCm BLAS marshalling library'
arch=('x86_64' 'powerpc64le')  # ppc64le: see README.md
url='https://rocm.docs.amd.com/projects/hipBLAS/en/latest/index.html'
license=('MIT')
# ppc64le: no rocsolver (BUILD_WITH_SOLVER=OFF below), see README.md.
depends=(
    'glibc'
    'rocm10-hip-runtime-amd'
    'rocm10-hipblas-common'
    'libgcc'
    'rocm10-rocblas'
    'rocm10-core'
)
makedepends=('rocm-cmake' 'git' 'cmake' 'gcc-fortran')
_git='https://github.com/ROCm/rocm-libraries'
# Both ROCm generations install into /opt/rocm with identical paths, so without
# these pacman cannot swap them: it reports a wall of "exists in both" file
# conflicts and the only way through is --overwrite, which resolves the wrong
# way round -- a swap done that way left rocm-core 7.2.4's 19 files on disk
# while rocm10-core was recorded as owning them, and /opt/rocm/.info/version
# still read 7.2.4.
#
# conflicts, deliberately WITHOUT replaces: replaces would make every -Syu
# migrate ROCm 7 users to ROCm 10, and ROCm 10 dropped gfx900, which is the
# entire reason the rocm7 generation exists. conflicts asks instead.
# provides keeps existing dependents resolvable across the swap -- llama.cpp-hip
# depends on rocblas and hip-runtime-amd by name.
conflicts=('hipblas')
provides=("hipblas=$pkgver")

source=("rocm-libraries::git+$_git.git#tag=rocm-$pkgver")
sha256sums=('b476acbcd0f4017c800e4b05533e6dfb875bde32242729c8df557d4624379623')
_dirname="rocm-libraries/projects/$_project"

build() {
  # What an installed rocm-core exports from /etc/profile.d/rocm.sh.  Without
  # it hipcc's clang deduces the ROCm root as /opt/rocm/lib and cannot find
  # hip/hip_runtime.h (see ../rocm-llvm/README.md); bq runs in a non-login
  # environment, so set it here.
  export ROCM_PATH=/opt/rocm
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  local cmake_args=(
    -Wno-dev
    -S "$_dirname"
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_CXX_COMPILER=/opt/rocm/bin/hipcc
    -D CMAKE_CXX_FLAGS="${CXXFLAGS} -fcf-protection=none"
    # ppc64le: hipBLAS's LAPACK-style entry points (getrf, getrs, ...)
    # marshal to rocSOLVER, which needs rocSPARSE; neither exists for
    # ppc64le and llama.cpp uses only the BLAS half.  README.md.
    -D BUILD_WITH_SOLVER=OFF
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

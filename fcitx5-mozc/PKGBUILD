# ppc64le: bazelisk fetches three build-time tools for the host it runs on, and
# _bazel_deps above carries them for x86_64 and aarch64 only. None of them is
# shipped, and each has a ppc64le route:
#  - bazel, the build driver: our own package (packaging/bazel), built from
#    its dist zip at the release src/.bazeliskrc names. It takes bazelisk's
#    place in makedepends.
#  - python-build-standalone, the interpreter rules_python runs mozc's
#    generator scripts with: published for ppc64le, added below.
#  - protoc: built from source by bazel, through protobuf's own
#    prefer_prebuilt_protoc flag, rather than the prebuilt
#    protoc-*-linux-ppcle_64.zip, so no downloaded compiler runs in the build.
# prepare() checks each value below against the source that sets it, through
# ppc64le-pins.py; for a bump, `./ppc64le-pins.py <_mozc_commit>` prints them.
# See README.md.
_bazel_version=9.0.2    # USE_BAZEL_VERSION in mozc's src/.bazeliskrc
_protobuf_version=34.1  # the protobuf bazel_dep in mozc's src/MODULE.bazel
_pbs_python=3.11.14     # rules_python's MINOR_MAPPING for its python.defaults()
_pbs_release=20251031   # the release rules_python's versions.bzl names for it
_bazel_deps_powerpc64le=(
    https://github.com/astral-sh/python-build-standalone/releases/download/${_pbs_release}/cpython-${_pbs_python}+${_pbs_release}-ppc64le-unknown-linux-gnu-install_only.tar.gz
)


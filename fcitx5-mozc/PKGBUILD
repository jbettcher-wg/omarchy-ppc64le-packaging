# ppc64le: what a bq build needs that Arch's clean chroot gives for free. Sets
# _bazel_startup and _bazel_args, which pkgver() and build() splice into their
# bazel calls; both stay empty elsewhere.
_ppc64le_setup() {
  _bazel_startup=() _bazel_args=()
  [[ $CARCH == powerpc64le ]] || return 0
  # bazel's server runs on JAVA_HOME, else on the default java, and a bq host's
  # default need not be the 21 our bazel depends on.
  export JAVA_HOME=/usr/lib/jvm/java-21-openjdk
  [[ -x $JAVA_HOME/bin/java ]] || { echo "ppc64le: no JDK 21 at $JAVA_HOME" >&2; return 1; }
  # bazel caches its own actions; give cc_configure the compiler itself, not
  # the ccache shim bq can put first in PATH.
  export CC=/usr/bin/gcc
  # The output and install base in the build tree, not ~/.cache/bazel, and no
  # server outliving a failed build by hours.
  _bazel_startup=(--output_user_root="$srcdir/bazel-user-root" --max_idle_secs=300)
  # Nothing comes from the network: a file missing from source=() fails the
  # build instead of being fetched. Every http(s) URL is rewritten to a closed
  # local port, keeping its path, so the --distdir lookup (by basename) still
  # matches and anything else is refused at once. The obvious flags do not
  # work: --repository_disable_download also refuses the file:// patches the
  # local registry carries, and a "block *" config makes bazel give up before
  # it looks in the distdir.
  printf '%s\n' 'rewrite (.*) 127.0.0.1:9/fcitx5-mozc-builds-offline/$1' \
    > "$srcdir/ppc64le-offline.cfg"
  _bazel_args=(
    # pkgver() resolves modules too, so it needs the local registry and the
    # distdir as much as build() does.
    --distdir="$srcdir" --registry="file://$srcdir/bazel-central-registry"
    --downloader_config="$srcdir/ppc64le-offline.cfg"
    # protoc built from source, not protoc-*-linux-ppcle_64.zip.
    --@com_google_protobuf//bazel/flags:prefer_prebuilt_protoc=false
  )
  # bazel ignores MAKEFLAGS and takes every core; carry makepkg's -j over.
  local _j
  _j=$(grep -oE '(^| )-j *[0-9]+' <<<" ${MAKEFLAGS:-}" | grep -oE '[0-9]+' | tail -n1)
  [[ -n $_j ]] && _bazel_args+=(--jobs="$_j" --local_resources=cpu="$_j")
  return 0
}

# ppc64le: bazel compiles with its own toolchain's flags, and makepkg's reach it
# only through the --conlyopt/--cxxopt in build(). Read bazel's execution log of
# the build that just ran (every spawn it executed, with its argv) and require
# makepkg's -mcpu (power8 in the baseline pool) as the last -mcpu of every C/C++
# compile in the target configuration. Exec-configuration tools, protoc among
# them, are build-time only and do not ship. An aquery cannot do this: run
# after the build it reports nothing (--skyframe_state), and the after-build
# dump leaves out command lines.
_ppc64le_assert_mcpu() {
  local _mcpu _log=$srcdir/ppc64le-exec.json
  _mcpu=$(grep -oE -- '-mcpu=[^ ]+' <<<"$CFLAGS" | tail -n1)
  [[ -n $_mcpu ]] || { echo "ppc64le: CFLAGS names no -mcpu" >&2; return 1; }
  python -I -c '
import collections, json, sys
want, path = sys.argv[1:3]
s = open(path).read()
dec, i = json.JSONDecoder(), 0
cc, bad, runners, exec_cc = 0, [], collections.Counter(), 0
while True:
    while i < len(s) and s[i].isspace():
        i += 1
    if i >= len(s):
        break
    r, i = dec.raw_decode(s, i)
    if r.get("mnemonic") != "CppCompile":
        continue
    out = (r.get("listedOutputs") or ["?/?"])[0]
    out = out.get("path", "?/?") if isinstance(out, dict) else out
    if "-exec" in out.split("/")[1]:
        exec_cc += 1
        continue
    cc += 1
    runners[r.get("runner")] += 1
    if [a for a in r.get("commandArgs", []) if a.startswith("-mcpu=")][-1:] != [want]:
        bad.append(r)
print("ppc64le: %d target C/C++ compiles ran (%s), %d without %s as their last -mcpu;"
      " %d exec-config compiles not checked"
      % (cc, ", ".join("%s %d" % kv for kv in runners.items()), len(bad), want, exec_cc))
for r in bad[:5]:
    print("  " + " ".join(r.get("commandArgs", []))[:400])
sys.exit(1 if bad or not cc else 0)' "$_mcpu" "$_log" || return 1
  rm -f "$_log"  # some 260 MB; kept when the check fails
}

pkgver(){
  _ppc64le_setup
  cd mozc/src
  # https://github.com/google/mozc/discussions/1429
  # REVISION in mozc_version_template.bzl is no longer used by Bazel builds.
  # REVISION will be probably removed once GYP builds are completely removed.
  bazel "${_bazel_startup[@]}" build "${_bazel_args[@]}" --config oss_linux --config stable_channel --config release_build --config no_sframe base:mozc_version_txt >/dev/null 2>&1
  if [[ $CARCH == powerpc64le && ! -s bazel-bin/base/mozc_version.txt ]]; then
    # ppc64le: otherwise the version silently comes out as "...".
    echo "ppc64le: bazel did not produce base/mozc_version.txt" >&2
    return 1
  fi
  source <(grep -E '^(MAJOR|MINOR|BUILD_OSS|REVISION)\s*=' bazel-bin/base/mozc_version.txt)
   _bzr_ver="$MAJOR.$MINOR.$BUILD_OSS.$REVISION"
  printf "%s" "${_bzr_ver}"
}

prepare() {
  # Bazel's distdir lookup uses the original URL basenames.
  ln -sf abseil-py-2.1.0.tar.gz "$srcdir/v2.1.0.tar.gz"
  ln -sf bats-core-1.10.0.tar.gz "$srcdir/v1.10.0.tar.gz"
  if [[ $CARCH == powerpc64le ]]; then
    # ppc64le: fail here, not deep inside bazel, when a bump moves something
    # the pins at the top of this file name.
    python -I "$srcdir/ppc64le-pins.py" --check "$srcdir" \
      _bazel_version="$_bazel_version" _protobuf_version="$_protobuf_version" \
      _pbs_python="$_pbs_python" _pbs_release="$_pbs_release"
    local _have
    _have=$(bazel --version)
    [[ $_have == "bazel $_bazel_version" ]] || {
      echo "ppc64le: $_have is installed; src/.bazeliskrc wants $_bazel_version" >&2; return 1; }
    # ppc64le: rules_python's ppc64le interpreter says cpu:ppc, the host is
    # cpu:ppc64le, and no python toolchain matches. See the patch's header.
    # Applied the way mozc patches rules_cc: a single_version_override, so the
    # BCR's own patch for rules_python still applies underneath.
    cp "$srcdir/rules_python-ppc64le-cpu.patch" mozc/src/bazel/
    grep -q 'rules_python-ppc64le-cpu.patch' mozc/src/MODULE.bazel ||
      printf '%s\n' '' \
        '# ppc64le: added by fcitx5-mozc'"'"'s PKGBUILD.' \
        'single_version_override(' \
        '    module_name = "rules_python",' \
        '    patch_strip = 1,' \
        '    patches = ["bazel/rules_python-ppc64le-cpu.patch"],' \
        ')' >> mozc/src/MODULE.bazel
  fi
}

build() {
  cd mozc/src
  _ppc64le_setup
  if [[ $CARCH == powerpc64le ]]; then
    # ppc64le: log every spawn, for _ppc64le_assert_mcpu.
    _bazel_args+=(--execution_log_json_file="$srcdir/ppc64le-exec.json" --execution_log_sort=false)
  fi

  # Use srcdir for pre-download files and override registry with local mirror.
  # bazel only respects CC from environment, not CXXFLAGS and LDFLAGS.
  # Pass them with --cxxopt, and --linkopt.
  bazel "${_bazel_startup[@]}" build "${_bazel_args[@]}" \
      --config oss_linux \
      --config stable_channel \
      --config release_build \
      --config no_sframe \
      --distdir="${srcdir}" \
      --registry="file://${srcdir}/bazel-central-registry" \
      --copt=-DNDEBUG \
      $(echo "${CFLAGS}"|xargs -n1 echo "--conlyopt") \
      $(echo "${CXXFLAGS}"|xargs -n1 echo "--cxxopt") \
      --nostart_end_lib \
      --linkopt=-fuse-ld=bfd \
      $(echo "${LDFLAGS}"|xargs -n1 echo "--linkopt") \
      --copt="-Wno-uninitialized" \
      --host_copt="-Wno-uninitialized" --verbose_failures \
      unix/fcitx5:fcitx5-mozc.so \
      server:mozc_server \
      gui/tool:mozc_tool
  if [[ $CARCH == powerpc64le ]]; then
    _ppc64le_assert_mcpu
    bazel "${_bazel_startup[@]}" shutdown
  fi
}

package() {
  cd mozc/src
  export PREFIX="${pkgdir}/usr"
  ../scripts/install_server_bazel
  ../scripts/install_fcitx5_bazel

  install -d "${pkgdir}/usr/share/licenses/$pkgname/"
  install -m 644 ../LICENSE data/installer/*.html "${pkgdir}/usr/share/licenses/${pkgname}/"
}

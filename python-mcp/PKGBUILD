# Maintainer: Felix Yan <felixonmars@archlinux.org>
# ppc64le: Omarchy -- held at the last 1.x.  Arch's recipe is 2.x, split into
# python-mcp and python-mcp-types; kicad-mcp pins mcp<2.

pkgname=python-mcp
pkgver=1.30.0
pkgrel=1
pkgdesc='Model Context Protocol SDK'
arch=(any)
url='https://github.com/modelcontextprotocol/python-sdk'
license=(MIT)
depends=(
  python
  python-anyio
  python-cryptography
  python-httpx
  python-httpx-sse
  python-jsonschema
  python-pydantic
  python-pydantic-settings
  python-pyjwt
  python-python-multipart
  python-sse-starlette
  python-starlette
  python-typing-inspection
  python-typing_extensions
  uvicorn
)
makedepends=(
  git
  python-build
  python-hatchling
  python-installer
  python-uv-dynamic-versioning
)
optdepends=(
  'python-dotenv: for the mcp CLI'
  'python-typer: for the mcp CLI'
  'python-rich: for the mcp CLI'
  'python-websockets: for the WebSocket transport'
)
source=("git+https://github.com/modelcontextprotocol/python-sdk.git#tag=v$pkgver")
b2sums=('SKIP')

build() {
  cd python-sdk
  python -m build --wheel --no-isolation

  # ppc64le: bq builds --nocheck, so the smoke test lives here.  Install the
  # wheel to a scratch root and round-trip one tool call in memory.
  local t="$srcdir/smoke"
  rm -rf "$t"
  python -m installer --destdir="$t" dist/*.whl
  PYTHONPATH="$(echo "$t"/usr/lib/python3*/site-packages)" python - <<'EOF'
import anyio
from mcp.server.fastmcp import FastMCP
from mcp.shared.memory import create_connected_server_and_client_session

server = FastMCP("smoke")

@server.tool()
def add(a: int, b: int) -> int:
    return a + b

async def main():
    async with create_connected_server_and_client_session(server._mcp_server) as c:
        r = await c.call_tool("add", {"a": 2, "b": 40})
        assert r.content[0].text == "42", r
    print("mcp smoke: tool call ok")

anyio.run(main)
EOF
}

package() {
  cd python-sdk
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Upstream maintainer: David Heinemeier Hansson <david@hey.com>
#
# Hype, Omarchy's Markdown presentation app with a visual slide editor.
# Omarchy 4.5 installs it through omarchy-pkg-add. Taken from upstream's own
# recipe (github.com/omacom/omarchy-pkgs, pkgbuilds/hype at 96299ad6cbcf);
# the version is Omarchy's stable channel (pkgs.omarchy.org/stable hype
# 0.6.0-1). A later commit at the same version (8982800d, "build with cmake")
# only added cmake to makedepends and was never built into stable, whose
# makedepends are gcc and make; omarchy-pkgs HEAD is at 0.7.x.
#
# ppc64le: powerpc64le added to arch=(). Plain Qt 6 C++/QML; zlib and libwebp
# are linked, source-highlight and ffmpeg are run as programs. Nothing
# architecture-specific. The build is upstream's bin/build written out, with
# two changes that matter on the build box rather than for the architecture,
# the same ones ours/omacut makes:
#  - qmake is handed makepkg's CFLAGS/CXXFLAGS/LDFLAGS. qmake ignores them in
#    the environment, which would drop the hardening flags and the baseline
#    pool's -mcpu=power8.
#  - make runs without bin/build's -j$(nproc), so bq's MAKEFLAGS apply.
# bin/build's other job, refusing a Qt older than 6.9, is what the versioned
# qt6-* depends already guarantee.

pkgname=hype
pkgver=0.6.0
pkgrel=1
pkgdesc='Simple Markdown presentations with a visual slide editor'
arch=('x86_64' 'aarch64' 'powerpc64le')
url='https://github.com/omacom/hype'
license=('MIT')
install='hype.install'
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'qt6-base>=6.9'
  'qt6-declarative>=6.9'
  'qt6-multimedia>=6.9'
  'qt6-imageformats'
  'qt6-svg'
  'source-highlight'
  'zlib'
  'libwebp'
  'xdg-desktop-portal'
)
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b42aba45493bafac8fa30fd4cef86fae0c0b171d7a95811e3c7ded4bdb893f13')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  mkdir -p build
  cd build
  qmake6 "$srcdir/$pkgname-$pkgver/hype.pro" \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/hype "$pkgdir/usr/bin/hype"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/hype.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/hype.svg"
  install -Dm644 pkgbuild/hype.desktop "$pkgdir/usr/share/applications/hype.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

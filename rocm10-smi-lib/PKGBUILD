# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: acxz <akashpatel2008 at yahoo dot com>

pkgname=rocm10-smi-lib
# Upstream project name, deliberately separate from $pkgname: ours is renamed
# so the ROCm 7 generation can stay in the pool, while the tarball, the URL
# and the directory inside the archive still use the upstream name.
_project=rocm-smi-lib
pkgver=10.0
pkgrel=1
pkgdesc='ROCm System Management Interface Library'
arch=('x86_64' 'powerpc64le')
url='https://rocm.docs.amd.com/projects/rocm_smi_lib/en/latest'
license=('NCSA')
depends=(
    'glibc'
    'rocm10-hsa-rocr'
    'libgcc'
    'python'
    'rocm10-core'
)
makedepends=('cmake')
_git='https://github.com/ROCm/rocm-systems'
# Both ROCm generations install into /opt/rocm with identical paths, so without
# these pacman cannot swap them: it reports a wall of "exists in both" file
# conflicts and the only way through is --overwrite, which resolves the wrong
# way round -- a swap done that way left rocm-core 7.2.4's 19 files on disk
# while rocm10-core was recorded as owning them, and /opt/rocm/.info/version
# still read 7.2.4.
#
# conflicts, deliberately WITHOUT replaces: replaces would make every -Syu
# migrate ROCm 7 users to ROCm 10, and ROCm 10 dropped gfx900, which is the
# entire reason the rocm7 generation exists. conflicts asks instead.
# provides keeps existing dependents resolvable across the swap -- llama.cpp-hip
# depends on rocblas and hip-runtime-amd by name.
conflicts=('rocm-smi-lib')
provides=("rocm-smi-lib=$pkgver")

source=("$_project-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/$_project.tar.gz")
sha256sums=('031cdcf1649bc0bf22d0c326e709ba78ad67b8e4c8c5f27023624b03a056c525')
options=(!lto)

build() {
  local cmake_args=(
    -Wno-dev
    -S "$_project"
    -B build
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D CMAKE_BUILD_TYPE=None
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$_project/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Omarchy 4's settings package, repackaged for ppc64le.
#
# Like omarchy itself this is genuinely arch=any -- zero ELF files, asserted at
# the top of package() -- so there is no port.  Its depends (bash curl gum sudo
# hicolor-icon-theme plymouth) all resolve on ppc64le unchanged.  **No
# dependency change was needed and none was made**; provides and backup are
# upstream's, minus the Limine files package() deletes.
#
# Changes to the shipped tree, each for a reason specific to POWER and provable
# rather than cautious:
#
#   1. The ppc64le platforms' pacman templates, mkinitcpio HOOKS baseline and
#      mise configuration (agent CLIs with no ppc64le build fetched as their
#      arm64 builds for POWERarm; mise's gh and crush disabled in favour of
#      ours), as patches from the ppc64le-platform branch.  4.0.4 had to delete
#      etc/mkinitcpio.conf.d outright; 4.5.0 guards every drop-in there by
#      platform or by what the kernel has, so patching 00-omarchy-hooks.conf
#      is enough and the directory now ships.  See package().
#   2. The .INSTALL scriptlet is replaced with one that does not rewrite /etc,
#      but keeps upstream's passwordless-sudo grant lifecycle verbatim.  See
#      omarchy-settings.install.
#   3. The Limine entry-tool configuration is removed, and the browser menu is
#      culled to the browsers that exist on POWER.
#
# Retired at 4.5.0: the Antigravity menu backport (0001-menu-antigravity.patch).
# Upstream's menu has setup.default.agent.agy now.
#
# Everything else ships byte-for-byte as upstream built it, including the
# /etc drop-ins that merely configure software (sddm, logind, resolved, sysctl,
# sudoers).  Those are what Omarchy *is*; removing them would ship something
# that is not Omarchy.  They are inventoried in the README notes rather than
# silently dropped.
#
# Upstream publishes no PKGBUILD, so the source is the published package, and
# its sha256 is the one recorded in https://pkgs.omarchy.org/x86_64/omarchy.db.
#
# arch=(any) was correct as it stood.  No architecture change was needed.

pkgname=omarchy-settings
pkgver=4.5.0
# pkgrel above upstream's marks this as locally modified: upstream's own build
# is 4.5.0-3 (_upstream_rel below).
pkgrel=5
pkgdesc='Omarchy user defaults, /etc/skel content, fonts, plymouth theme, and support helpers (ppc64le: no destructive /etc overrides, no mkinitcpio drop-in)'
arch=(any)
url='https://github.com/basecamp/omarchy'
license=(MIT)
makedepends=(file)

depends=(
  bash
  curl
  gum
  sudo
  hicolor-icon-theme
  plymouth
)
# 4.5.0 moved omarchy-sudo-passwordless and its library here from omarchy;
# omarchy depends on the library by this name.
provides=(omarchy-security-functions)

# Upstream's backup list. Upstream adds the last four only on x86_64, because
# older sources left those files out of the aarch64 package; a source with
# default/settings-runtime-profile (4.5.0 has it) ships them everywhere and they
# decide at runtime, so they are configuration here too. The two
# etc/limine-entry-tool.d files are left out because package() deletes them.
backup=(
  etc/fastfetch/config.jsonc
  etc/docker/daemon.json
  etc/gnupg/dirmngr.conf
  etc/sysctl.d/99-omarchy-sysctl.conf
  etc/sysctl.d/90-omarchy-file-watchers.conf
  etc/systemd/logind.conf.d/10-ignore-power-button.conf
  etc/systemd/logind.conf.d/20-inhibit-delay.conf
  etc/systemd/resolved.conf.d/10-disable-multicast.conf
  etc/systemd/resolved.conf.d/20-docker-dns.conf
  etc/systemd/system.conf.d/10-faster-shutdown.conf
  etc/systemd/system/user@.service.d/10-faster-shutdown.conf
  etc/systemd/system/docker.service.d/no-block-boot.conf
  etc/systemd/system/plocate-updatedb.service.d/ac-only.conf
  etc/systemd/system.conf.d/20-omarchy-nofile.conf
  etc/systemd/user.conf.d/20-omarchy-nofile.conf
  etc/sddm.conf.d/10-theme.conf
  etc/sddm.conf.d/10-wayland.conf
  etc/udev/rules.d/60-omarchy-io-scheduler.rules
  etc/udev/rules.d/99-omarchy-power-profile.rules
  etc/udev/rules.d/99-omarchy-wifi-powersave.rules
  etc/mkinitcpio.conf.d/omarchy_hooks.conf
  etc/mkinitcpio.conf.d/00-omarchy-hooks.conf
  etc/sysctl.d/90-omarchy-arp.conf
  etc/mkinitcpio.conf.d/thunderbolt_module.conf
  etc/modprobe.d/omarchy-usb-autosuspend.conf
  etc/systemd/oomd.conf.d/10-omarchy.conf
  etc/systemd/zram-generator.conf
)

optdepends=(
  'omarchy: Full Omarchy desktop'
  'inxi: System information for omarchy-debug'
  'fastfetch: System information for omarchy-upload-log'
  'zram-generator: Reads the shipped /etc/systemd/zram-generator.conf to create the compressed swap device'
  'snapper: Used with the shipped /etc/snapper/config-templates/omarchy template'
)
# Upstream's limine, limine-mkinitcpio-hook and limine-snapper-sync optdepends
# are dropped: they describe drop-ins for a bootloader that does not apply on
# OPAL/petitboot.

conflicts=(omarchy-settings-dev)

install="${pkgname}.install"

# Upstream's published artifact, from the stable channel. Upstream labels it
# arch=x86_64 (4.0.2 shipped as -any), but the content did not change class:
# re-verified for 4.5.0-3 -- sha256 matches
# https://pkgs.omarchy.org/stable/x86_64/omarchy.db, 761 files, zero ELF or
# object files. The files the patches touch were checked byte-identical to the
# v4.5.0 tag before generating them, and every file package() names was
# verified present in the 4.5.0-3 tree.
#
# The relabel is in their build pipeline, not the source. _assert_upstream()
# keeps enforcing zero machine code, so this stays arch=(any); if upstream ever ships a real
# binary here, the build fails instead of trusting the label.
_upstream_arch=x86_64
_upstream_rel=3
_srcpkg="${pkgname}-${pkgver}-${_upstream_rel}-${_upstream_arch}.pkg.tar.zst"
source=("https://pkgs.omarchy.org/stable/${_upstream_arch}/${_srcpkg}"
        "${pkgname}.install"
        0001-ppc64le-platform-default.patch
        0002-ppc64le-platform-etc.patch)
noextract=("${_srcpkg}")
sha256sums=('14a4f0cae0717df80fe2c08e7a3b0ba37b3935f09b31904d94c25b6baa141a87'
            'SKIP'
            '28e54413689d3b2e3752ec09caf9f6d45b6ec4373a0b07cef11b00771e6ed88b'
            '7a8a2dacc40bff8fc0e0d3fd71996738df0b8173471059cced1614747d6e967b')

_unpack() {
  bsdtar -xf "${srcdir}/${_srcpkg}" -C "$1" \
    --no-same-owner \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL
}

# Not check(): bq builds with makepkg --nocheck, so a check() never runs for a
# package that ships. Through 4.0.4-4 these assertions sat in check() and were
# inert. package() calls this first instead.
_assert_upstream() {
  local found
  rm -rf "${srcdir}/upstream"
  mkdir -p "${srcdir}/upstream"
  _unpack "${srcdir}/upstream"

  # arch=any must be honest -- see the omarchy PKGBUILD for why this is checked
  # rather than trusted.
  found=$(find "${srcdir}/upstream" -type f -print0 \
    | xargs -0 file -N --mime-type 2>/dev/null \
    | awk -F': ' '$2 ~ /^application\/x-(pie-)?(executable|sharedlib)|x-object|x-archive/ { print $1 }' \
    | sed "s|^${srcdir}/upstream/||" | sort)

  if [ -n "$found" ]; then
    printf 'omarchy-settings %s is not arch=any after all -- ELF payload found:\n%s\n' \
      "$pkgver" "$found" >&2
    return 1
  fi

  # The files package() patches or removes must exist, or a removal silently
  # no-ops.
  [ -f "${srcdir}/upstream/etc/mkinitcpio.conf.d/00-omarchy-hooks.conf" ]
  [ -d "${srcdir}/upstream/etc/limine-entry-tool.d" ]
  [ -f "${srcdir}/upstream/usr/share/omarchy/default/omarchy/omarchy-menu.jsonc" ]

  # omarchy-settings.install copies upstream's passwordless-sudo grant
  # lifecycle verbatim. If upstream changes it, stop rather than ship a stale
  # copy of a security mechanism.
  bsdtar -xf "${srcdir}/${_srcpkg}" -C "${srcdir}/upstream" .INSTALL
  local _fns='_passwordless_package_transition pre_remove pre_upgrade post_remove'
  if ! diff -u \
      <(bash -c "source '${srcdir}/upstream/.INSTALL' >/dev/null 2>&1; declare -f $_fns") \
      <(bash -c "source '${srcdir}/${pkgname}.install' >/dev/null 2>&1; declare -f $_fns") >&2; then
    echo "omarchy-settings: upstream's sudo-grant lifecycle changed; re-copy it into ${pkgname}.install" >&2
    return 1
  fi

  # The theming contract this package is actually here to satisfy: the
  # templates omarchy-theme-set-templates renders into the per-user theme
  # state.  neovim.lua.tpl is the one the Neovim theme plugins read through.
  [ -f "${srcdir}/upstream/usr/share/omarchy/default/themed/neovim.lua.tpl" ]
}

package() {
  _assert_upstream
  _unpack "${pkgdir}"

  # ppc64le: the platforms' pacman templates and mkinitcpio HOOKS baseline.
  #
  # 4.0.4 deleted etc/mkinitcpio.conf.d whole. Its omarchy_hooks.conf replaced
  # HOOKS with a busybox line ending in btrfs-overlayfs (from
  # limine-mkinitcpio-hook, which cannot exist here), and thunderbolt_module.conf
  # put an unconditional MODULES=(thunderbolt) on a kernel with no such module;
  # either made mkinitcpio fail, and the second aborted a full install run.
  #
  # 4.5.0 fixed the shape of the problem: 00-omarchy-hooks.conf sets HOOKS per
  # platform from omarchy-hw-platform, thunderbolt and i2c-hid-of load only where
  # modinfo or the detector finds them, and omarchy_hooks.conf only filters kms
  # for NVIDIA. So the directory ships and the patch adds the POWER line --
  # base systemd plymouth autodetect modconf kms keyboard keymap sd-vconsole
  # block filesystems fsck: no btrfs-overlayfs, no microcode, and no encryption
  # hook, since petitboot cannot read an encrypted /boot. It is the line .24 and
  # the installer's own drop-in already use, so on an installed system the
  # effective HOOKS do not change.
  #
  # Paths are upstream's git paths: default/ lands under usr/share/omarchy,
  # etc/ at the package root.
  patch -p1 -d "${pkgdir}/usr/share/omarchy" < "${srcdir}/0001-ppc64le-platform-default.patch"
  patch -p1 -d "${pkgdir}" < "${srcdir}/0002-ppc64le-platform-etc.patch"
  grep -qF 'ppc64le | ppc64le-power9)' "${pkgdir}/etc/mkinitcpio.conf.d/00-omarchy-hooks.conf" ||
    { echo "omarchy-settings: the POWER HOOKS line did not apply" >&2; return 1; }
  bash -n "${pkgdir}/etc/mkinitcpio.conf.d/00-omarchy-hooks.conf"
  # POWER's mise fragment, and the aqua overlay it names by absolute path.
  # omarchy's migration 1794867648 waits for the fragment before reshimming.
  grep -qF 'file:///usr/share/omarchy/default/mise/aqua-powerpc64.yaml' "${pkgdir}/etc/mise/conf.d/platform-ppc64le.toml" ||
    { echo "omarchy-settings: POWER's mise fragment is missing or no longer names the overlay" >&2; return 1; }
  [ -s "${pkgdir}/usr/share/omarchy/default/mise/aqua-powerpc64.yaml" ] ||
    { echo "omarchy-settings: the aqua overlay for POWER is missing" >&2; return 1; }
  grep -qF 'platforms_linux_powerpc64_' "${pkgdir}/etc/mise/conf.d/omarchy-tools.toml" ||
    { echo "omarchy-settings: omarchy-tools.toml lost its POWER platform keys" >&2; return 1; }
  local _p
  for _p in ppc64le ppc64le-power9; do
    grep -qx 'Architecture = powerpc64le' "${pkgdir}/usr/share/omarchy/default/pacman/${_p}/pacman-stable.conf" ||
      { echo "omarchy-settings: no stable pacman template for ${_p}" >&2; return 1; }
    [ -s "${pkgdir}/usr/share/omarchy/default/pacman/${_p}/mirrorlist-stable" ] ||
      { echo "omarchy-settings: no stable mirrorlist for ${_p}" >&2; return 1; }
  done

  # Remove the limine boot-entry configuration.
  #
  # Inert without limine, so this is housekeeping rather than a fix: these
  # files configure limine-entry-tool, a package that is not and cannot be a
  # dependency here.  Dropped so the shipped tree matches the dependency list
  # rather than carrying dead configuration for a bootloader this platform
  # does not use.
  rm -rf "${pkgdir}/etc/limine-entry-tool.d"

  # Note deliberately NOT removed:
  #   etc/sddm.conf.d/*        -- sddm is installed but disabled here
  #                               (display-manager.service -> cosmic-greeter),
  #                               so these are inert until the user chooses
  #                               sddm.  They are part of Omarchy proper.
  #   etc/skel/**              -- seeds new accounts only; never touches an
  #                               existing $HOME.
  #   etc/sudoers.d/omarchy-*  -- four narrowly-scoped NOPASSWD grants shipped
  #                               by upstream.  Kept as-is; they are inventoried
  #                               in the report rather than silently altered.
  #   usr/share/omarchy/etc-overrides/**
  #                            -- kept as *files*.  What changed is that they
  #                               are no longer applied automatically; see
  #                               omarchy-settings.install.

  local _menu="${pkgdir}/usr/share/omarchy/default/omarchy/omarchy-menu.jsonc"
  if [ -f "$_menu" ]; then
    # ppc64le: cull the browser menu to the browsers that exist here.
    #
    # Three lists mention browsers: install.browser.*, setup.default.browser.*
    # and remove.browser.*. The install ones are what do harm: they offer
    # google-chrome, microsoft-edge-stable-bin, brave-bin, brave-origin-bin and
    # zen-browser-bin, every one an x86-64 binary package with no ppc64le build,
    # so the menu invites an install that cannot succeed. Dropping the matching
    # setup.default.browser.* entries is tidiness rather than a fix: those are
    # already gated on `when: omarchy-cmd-present <binary>`, and remove.* on
    # `omarchy-pkg-present`, so neither appears unless the browser is somehow
    # installed anyway. They go for coherence: a Remove entry for a browser that
    # is no longer offered in Install makes no sense.
    #
    # Chromium is not in the install list upstream either -- it comes from our own
    # repo -- so afterwards Install offers Firefox alone, and Default Browser
    # offers Chromium and Firefox.
    #
    # Each entry is one line ending in "}," and the parent keys do not enumerate
    # their children (they are found by key prefix), so deleting whole lines
    # cannot unbalance the file. The '":' in each pattern is what stops .brave
    # from also matching .brave-origin -- and the key prefixes are what stop
    # "edge" from matching update.channel.edge, which is the release channel and
    # has nothing to do with Microsoft Edge. A bare /edge/d would break it.
    #
    # Revisit when the webkit work lands: Brave and the other Chromium forks
    # become candidates then, and this block is where to re-add them.
    local _b _k
    for _b in chrome brave brave-origin edge zen; do
      sed -i -E "/\"(setup\.default\.browser|install\.browser|remove\.browser)\.${_b}\":/d" "$_menu"
    done
    for _b in chrome brave brave-origin edge zen; do
      ! grep -q "browser\.${_b}\"" "$_menu" ||
        { echo "omarchy-settings: browser cull left $_b behind in the menu" >&2; return 1; }
    done
    for _b in chromium firefox; do
      grep -q "setup\.default\.browser\.${_b}\"" "$_menu" ||
        { echo "omarchy-settings: browser cull removed $_b, which must stay" >&2; return 1; }
    done
    for _k in 'install\.browser\.firefox' 'remove\.browser\.firefox' 'update\.channel\.edge'; do
      grep -q "\"$_k\"" "$_menu" ||
        { echo "omarchy-settings: browser cull removed $_k, which must stay" >&2; return 1; }
    done
  fi

  "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"
}

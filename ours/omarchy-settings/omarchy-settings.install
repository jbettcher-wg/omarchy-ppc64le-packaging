# omarchy-settings.install -- replaces upstream's .INSTALL scriptlet.
#
# Upstream's post_install/post_upgrade runs _etc_overrides_apply, which is
# destructive by design.  Its own comment says so:
#
#   "NOTE: these cp -f's are intentionally destructive on every install/upgrade.
#    Users who customize /etc/os-release, /etc/plymouth/plymouthd.conf, ...
#    WILL have their changes reset to Omarchy defaults each time
#    omarchy-settings is upgraded."
#
# Concretely it does `rm -f /etc/os-release` and then overwrites
# /etc/os-release, /etc/security/faillock.conf, /etc/nsswitch.conf,
# /etc/plymouth/plymouthd.conf, /etc/skel/.bashrc and (when present) two CUPS
# configs -- files pacman does not track, on every upgrade.
#
# That is the correct behaviour on a machine installed *as* Omarchy.  This
# machine is not one: it is an existing Arch ppc64le workstation running COSMIC,
# where Omarchy is being back-filled package by package.  Two specifics:
#
#   - /etc/os-release here is a symlink to ../usr/lib/os-release.  The scriptlet
#     would replace it with a regular file declaring ID=omarchy, changing the
#     system's advertised identity for every tool that reads it.
#   - /etc/nsswitch.conf would be replaced.  The shipped version happens to be
#     benign on this host (it adds mdns_minimal, and nss-mdns is installed), but
#     nsswitch.conf is the file that decides whether the machine can resolve
#     names at all, and rewriting it unattended is not something a back-fill
#     package should do.
#
# So the overrides are still shipped, at /usr/share/omarchy/etc-overrides/, and
# still applied by exactly the same commands -- but by the user, deliberately,
# once they have read what changes.  Nothing about the theming layer, which is
# what this package is being installed for, depends on any of it.
#
# Local workaround, not upstreamable.
#
# What is NOT replaced (4.5.0): upstream's scriptlet also manages the temporary
# passwordless-sudo grants (/etc/sudoers.d/99-omarchy-nopasswd-*) that
# omarchy-sudo-passwordless publishes.  It revokes them before an upgrade or
# removal and clears the publication blocker once the package is installed.
# That is a security lifecycle, not a convenience, so it is copied below
# verbatim -- _passwordless_package_transition, pre_remove, pre_upgrade and
# post_remove -- and post_install still runs its "installed" step before the
# notice.  The PKGBUILD's check() fails the build if upstream changes any of
# those four functions, so this copy cannot silently fall behind.
#
# ---- verbatim from upstream omarchy-settings 4.5.0-3 .INSTALL ----

# This lock and removal marker are shared with omarchy-sudo-passwordless.
# Keep the marker through removal so no grant can be published after its boot
# cleanup prerequisite disappears. A completed installation clears it again.
_passwordless_package_transition() (
  local action=$1 lock_fd directory rule
  # Scriptlets run under ordinary Bash with pacman's environment. The sweep
  # below relies on pathname expansion, so it must not inherit glob state.
  unset GLOBIGNORE
  set +f
  shopt -u failglob
  [[ -d /run && ! -L /run ]] || return 1
  [[ $(/usr/bin/stat -Lc '%u' /run) == "0" ]] || return 1
  ! (( 8#$(/usr/bin/stat -Lc '%a' /run) & 022 )) || return 1
  umask 077
  case "$action" in
    begin|installed)
      # Refuse publication before waiting for the lock: a timeout, a failed
      # lock directory, or an interrupted transaction must not leave the
      # namespace unguarded. The publisher rechecks this marker after it
      # publishes, so it needs no lock to take effect.
      : >/run/omarchy-sudo-passwordless-package-removing || return 1
      ;;
  esac
  [[ -d /run/lock && ! -L /run/lock ]] || return 1
  [[ $(/usr/bin/stat -Lc '%u' /run/lock) == "0" ]] || return 1
  ! (( 8#$(/usr/bin/stat -Lc '%a' /run/lock) & 022 )) || return 1
  exec {lock_fd}>/run/lock/omarchy-sudo-passwordless.lock || return 1
  # Grant operations are short; a stalled holder must not hang pacman's
  # transaction indefinitely.
  /usr/bin/flock -x -w 60 "$lock_fd" || return 1
  case "$action" in
    begin)
      /usr/bin/rm -f -- /etc/sudoers.d/99-omarchy-nopasswd-* || return 1
      ;;
    removed)
      /usr/bin/rm -f -- /etc/sudoers.d/99-omarchy-nopasswd-* || return 1
      ;;
    installed)
      # pacman does not stop a transaction on a failed scriptlet, so a failed
      # or interrupted pre-transaction cleanup can be followed by this step,
      # and a fresh install has no earlier step at all. The blocker written
      # above holds while sweeping, so a failure here leaves publication
      # refused; certify completion only with the reserved namespace empty.
      /usr/bin/rm -f -- /etc/sudoers.d/99-omarchy-nopasswd-* || return 1
      for rule in /etc/sudoers.d/99-omarchy-nopasswd-*; do
        [[ ! -e $rule && ! -L $rule ]] || return 1
      done
      [[ -f /etc/tmpfiles.d/omarchy-nopasswd-sudo.conf ]] || return 1
      /usr/bin/rm -f -- /run/omarchy-sudo-passwordless-package-removing || return 1
      ;;
    *) return 1 ;;
  esac
)

pre_remove() {
  _passwordless_package_transition begin || {
    echo "ERROR: Could not revoke temporary Omarchy sudo grants before removing their boot cleanup. Administrator cleanup is required." >&2
    return 1
  }
}

pre_upgrade() {
  pre_remove
}
# ---- end verbatim ----

_omarchy_overrides_notice() {
  cat <<'EOF'

omarchy-settings (ppc64le): /etc overrides were NOT applied automatically.

Upstream's scriptlet rewrites these unconditionally on every install and
upgrade. They are shipped but left for you to apply deliberately:

  /usr/share/omarchy/etc-overrides/os-release              -> /etc/os-release
  /usr/share/omarchy/etc-overrides/nsswitch.conf           -> /etc/nsswitch.conf
  /usr/share/omarchy/etc-overrides/security-faillock.conf  -> /etc/security/faillock.conf
  /usr/share/omarchy/etc-overrides/plymouth-plymouthd.conf -> /etc/plymouth/plymouthd.conf
  /usr/share/omarchy/etc-overrides/dot.bashrc              -> /etc/skel/.bashrc
  /usr/share/omarchy/etc-overrides/cups-cups-browsed.conf  -> /etc/cups/cups-browsed.conf
  /usr/share/omarchy/etc-overrides/cups-cups-files.conf    -> /etc/cups/cups-files.conf

Note /etc/os-release is currently a symlink into /usr/lib; replacing it makes
the machine report ID=omarchy. To undo: ln -sf ../usr/lib/os-release /etc/os-release

None of this is needed for Omarchy theming. Themes work without it.

EOF
}

post_install() {
  local status=0
  # Upstream's first step, unchanged: recover the grant lifecycle.
  _passwordless_package_transition installed || {
    echo "ERROR: Temporary Omarchy sudo grants remain or their boot cleanup is missing; passwordless sudo stays disabled until this package installs cleanly." >&2
    status=1
  }
  # Upstream's second step, _etc_overrides_apply, is what this file replaces.
  _omarchy_overrides_notice
  return "$status"
}

post_upgrade() {
  post_install
}

# ---- verbatim from upstream omarchy-settings 4.5.0-3 .INSTALL ----
post_remove() {
  _passwordless_package_transition removed || {
    echo "ERROR: Temporary Omarchy sudo grants could not be removed. Administrator cleanup is required." >&2
    return 1
  }
}
# ---- end verbatim ----

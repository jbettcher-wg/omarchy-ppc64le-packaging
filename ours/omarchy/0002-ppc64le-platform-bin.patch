Subject: [PATCH] ppc64le platform: the detector, its helpers and package defaults

omarchy-hw-platform names ppc64le (POWER8-legal baseline) and ppc64le-power9
(POWER9 and later, from /proc/cpuinfo), and refuses an unknown CPU instead
of falling through to x86. omarchy-hw-ppc64le and omarchy-hw-ppc64le-power9
are the family predicates. omarchy-pkg-defaults composes base + ppc64le
(+ ppc64le-power9) and skips the x86_64-only and ppc64le-unavailable lists.
omarchy-hw-powerarm-guest detects a shell running as an AArch64 guest under
POWERarm, and omarchy-migrate refuses to run there, since the guest's pacman
database is not this system's.

Generated from the ppc64le-platform branch (v4.5.0 + 380bd7170 "Add the
ppc64le platform", 296d4d7ee "Refuse an unsupported CPU instead of calling
it x86", 9d077ad8d "Skip a platform's unavailable packages in
omarchy-pkg-add", a6cc8fc83 "Install base's disktree-bin on POWER",
8f89ed9d4 "Install POWERarm on every POWER platform", 53bfb9e91 "Run agent
CLIs with no POWER build as their arm64 builds", 5187c8230 "Install
sleeve on POWER" and bb2372aca "Refuse to run migrations inside a POWERarm
guest") with:

    git diff v4.5.0..ppc64le-platform -- bin/

Paths are upstream's git paths. The PKGBUILD applies it with
patch -p1 -d "$pkgdir/usr", which lands them on the installed layout.

diff --git a/bin/omarchy-hw-platform b/bin/omarchy-hw-platform
index d912986b1..f8a02cfff 100755
--- a/bin/omarchy-hw-platform
+++ b/bin/omarchy-hw-platform
@@ -1,12 +1,22 @@
 #!/bin/bash -p
 
-# omarchy:summary=Print the hardware platform: x86, aarch64, aarch64-apple, aarch64-qualcomm, aarch64-n1x or aarch64-gb10.
+# omarchy:summary=Print the hardware platform: x86, aarch64, aarch64-apple, aarch64-qualcomm, aarch64-n1x, aarch64-gb10, ppc64le or ppc64le-power9.
 
 # Platform names are the CPU architecture, then the hardware family when it
 # needs handling of its own: x86, aarch64 (every ARM machine without one),
 # aarch64-apple (Apple Silicon), aarch64-qualcomm (Snapdragon), aarch64-n1x
-# (NVIDIA N1x) and aarch64-gb10 (NVIDIA GB10 desktops). A later family is
-# aarch64-<family>, so "aarch64*" always means ARM (AGENTS.md, Platforms).
+# (NVIDIA N1x), aarch64-gb10 (NVIDIA GB10 desktops), ppc64le (every
+# little-endian POWER machine, POWER8 and newer) and ppc64le-power9 (POWER9 and
+# newer, which run ISA 3.0 code). A later family is aarch64-<family> or
+# ppc64le-<family>, so "aarch64*" always means ARM and "ppc64le*" always means
+# POWER (AGENTS.md, Platforms).
+#
+# A POWER machine's generation is the "cpu" line of /proc/cpuinfo: POWER8,
+# POWER9 (raw), POWER10 and so on. Under a hypervisor's compatibility mode it
+# reads "(architected)" with the generation the guest is limited to, which is
+# the ISA it can really run, so a POWER8-mode guest on POWER9 hardware is
+# ppc64le. A generation that cannot be read is the baseline, which runs on
+# every POWER machine.
 #
 # Device-tree ARM laptops have no DMI, so the board identity is the root node of
 # the device tree the firmware hands the kernel: "apple,<model>" from Asahi's
@@ -147,7 +157,7 @@ image_platform() {
     generic) platform=x86 ;;
     qualcomm) platform=aarch64-qualcomm ;;
   esac
-  if [[ ! $platform =~ ^(x86|aarch64|aarch64-apple|aarch64-qualcomm|aarch64-n1x|aarch64-gb10)$ ]]; then
+  if [[ ! $platform =~ ^(x86|aarch64|aarch64-apple|aarch64-qualcomm|aarch64-n1x|aarch64-gb10|ppc64le|ppc64le-power9)$ ]]; then
     echo "Error: the image manifest $manifest names no known platform: ${platform:-none}" >&2
     return 1
   fi
@@ -157,11 +167,11 @@ image_platform() {
 
 if [[ -n $image_dir ]] && [[ -e $manifest || -L $manifest ]] && ! booted; then
   platform=$(image_platform) || exit 1
-  if [[ $platform == "x86" ]]; then
-    [[ $machine != "aarch64" ]] || contradiction "$manifest names $platform hardware but the CPU is $machine"
-  else
-    [[ $machine == "aarch64" ]] || contradiction "$manifest names $platform hardware but the CPU is $machine"
-  fi
+  case $platform in
+    x86) [[ $machine == "x86_64" ]] ;;
+    ppc64le*) [[ $machine == "ppc64le" ]] ;;
+    *) [[ $machine == "aarch64" ]] ;;
+  esac || contradiction "$manifest names $platform hardware but the CPU is $machine"
   echo "$platform"
   exit 0
 fi
@@ -243,6 +253,26 @@ if [[ -n $gb10_source ]]; then
   exit 0
 fi
 
+if [[ $machine == "ppc64le" ]]; then
+  [[ $vendor != apple && $vendor != qcom ]] ||
+    contradiction "$vendor_source names $vendor hardware but the CPU is $machine"
+  generation=0
+  if [[ -n $proc && -r $proc/cpuinfo ]]; then
+    while IFS= read -r line; do
+      if [[ $line =~ ^cpu[[:space:]]*:[[:space:]]*POWER([0-9]+) ]]; then
+        generation=${BASH_REMATCH[1]}
+        break
+      fi
+    done <"$proc/cpuinfo"
+  fi
+  if (( generation >= 9 )); then
+    echo ppc64le-power9
+  else
+    echo ppc64le
+  fi
+  exit 0
+fi
+
 case $vendor in
   apple | qcom)
     [[ $machine == "aarch64" ]] || contradiction "$vendor_source names $vendor hardware but the CPU is $machine"
@@ -253,10 +283,13 @@ case $vendor in
     fi
     ;;
   *)
-    if [[ $machine == "aarch64" ]]; then
-      echo aarch64
-    else
-      echo x86
-    fi
+    case $machine in
+      aarch64) echo aarch64 ;;
+      x86_64) echo x86 ;;
+      *)
+        echo "Error: unsupported CPU architecture: $machine" >&2
+        exit 1
+        ;;
+    esac
     ;;
 esac
diff --git a/bin/omarchy-hw-powerarm-guest b/bin/omarchy-hw-powerarm-guest
new file mode 100755
index 000000000..69e4b6097
--- /dev/null
+++ b/bin/omarchy-hw-powerarm-guest
@@ -0,0 +1,22 @@
+#!/bin/bash
+
+# omarchy:summary=Detect whether this shell runs as an AArch64 guest under POWERarm on a POWER machine.
+
+# POWERarm runs AArch64 binaries on ppc64le through binfmt_misc, against its own
+# AArch64 root filesystem. A shell started there (an arm64 editor's terminal, say)
+# sees uname -m report aarch64 and a pacman whose database is the guest's, not
+# this system's. The emulator is mapped into every process it runs, this one
+# included, so look for it there rather than guess from the architecture. After
+# a powerarm upgrade binfmt_misc can still pin the previous emulator, which then
+# reads "(deleted)". OMARCHY_PROC_ROOT points the check at a fixture proc tree.
+
+maps="${OMARCHY_PROC_ROOT:-/proc}/self/maps"
+status=1
+
+while read -r _ _ _ _ _ path; do
+  if [[ $path =~ /POWERarm( \(deleted\))?$ ]]; then
+    status=0
+  fi
+done <"$maps"
+
+exit "$status"
diff --git a/bin/omarchy-hw-ppc64le b/bin/omarchy-hw-ppc64le
new file mode 100755
index 000000000..fef4850f2
--- /dev/null
+++ b/bin/omarchy-hw-ppc64le
@@ -0,0 +1,5 @@
+#!/bin/bash
+
+# omarchy:summary=Detect whether the CPU is ppc64le (every little-endian POWER machine, POWER8 and newer).
+
+[[ $(uname -m) == "ppc64le" ]]
diff --git a/bin/omarchy-hw-ppc64le-power9 b/bin/omarchy-hw-ppc64le-power9
new file mode 100755
index 000000000..eb9dd2ea0
--- /dev/null
+++ b/bin/omarchy-hw-ppc64le-power9
@@ -0,0 +1,17 @@
+#!/bin/bash -p
+
+# omarchy:summary=Detect whether the computer is a POWER9 or newer machine, which runs ISA 3.0 code.
+
+# Callers run this by absolute path, from systemd and from the shell, so use the
+# detector shipped beside it rather than whichever one PATH finds. -p keeps a
+# root caller's exported functions out, so a launch without it is refused, and
+# nothing here searches PATH.
+if [[ $- != *p* ]]; then
+  echo "Refusing an unsafe Bash startup." >&2
+  exit 126
+fi
+
+dir=${BASH_SOURCE[0]%/*}
+[[ $dir != "${BASH_SOURCE[0]}" ]] || dir=.
+platform=$("$dir/omarchy-hw-platform") || exit 1
+[[ $platform == "ppc64le-power9" ]]
diff --git a/bin/omarchy-migrate b/bin/omarchy-migrate
index e64aae32d..9741c0148 100755
--- a/bin/omarchy-migrate
+++ b/bin/omarchy-migrate
@@ -65,6 +65,16 @@ if [[ $mode == "pending" ]]; then
   fi
 fi
 
+# Migrations query and install packages through pacman. A shell running under
+# POWERarm is an AArch64 guest with its own root filesystem and pacman database,
+# so every migration there would check the guest instead of this system and stop
+# at the first package the guest lacks.
+if omarchy-hw-powerarm-guest; then
+  echo "This shell runs under POWERarm, as an AArch64 guest with its own pacman database." >&2
+  echo "Run omarchy-migrate from a native terminal instead." >&2
+  exit 1
+fi
+
 wait_for_pacman_transaction() {
   local lock_file=/var/lib/pacman/db.lck
 
diff --git a/bin/omarchy-pkg-add b/bin/omarchy-pkg-add
index 1f5e40913..864902e5d 100755
--- a/bin/omarchy-pkg-add
+++ b/bin/omarchy-pkg-add
@@ -5,6 +5,28 @@
 # omarchy:examples=omarchy pkg add jq ripgrep
 # omarchy:requires-sudo=true
 
+# A platform names the packages it has no build for in its unavailable list,
+# the one omarchy-pkg-defaults leaves out of the platform's set. Asking for one
+# there is not an install failure: say so and install the rest, so a migration
+# that adds it alongside others carries on instead of stopping every migration
+# after it.
+case $(omarchy-hw-platform 2>/dev/null) in
+  ppc64le | ppc64le-power9) unavailable="${OMARCHY_PATH:-/usr/share/omarchy}/install/omarchy-ppc64le-unavailable.packages" ;;
+  *) unavailable="" ;;
+esac
+if [[ -n $unavailable && -r $unavailable ]]; then
+  available=()
+  for pkg in "$@"; do
+    if sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$unavailable" | grep -Fxq -- "$pkg"; then
+      echo "Skipping $pkg: no build for this platform (see $unavailable)" >&2
+    else
+      available+=("$pkg")
+    fi
+  done
+  set -- "${available[@]}"
+  (($#)) || exit 0
+fi
+
 if omarchy-pkg-missing "$@"; then
   if (( EUID == 0 )); then
     pacman -S --noconfirm --needed -- "$@" || exit 1
diff --git a/bin/omarchy-pkg-defaults b/bin/omarchy-pkg-defaults
index 8fa54a25f..afac1be14 100755
--- a/bin/omarchy-pkg-defaults
+++ b/bin/omarchy-pkg-defaults
@@ -1,7 +1,7 @@
 #!/bin/bash
 
 # omarchy:summary=Print the default package set for this computer's platform, or for the named one: the base list plus its architecture's and platform's additions.
-# omarchy:args=[x86|aarch64|aarch64-apple|aarch64-qualcomm|aarch64-n1x|aarch64-gb10]
+# omarchy:args=[x86|aarch64|aarch64-apple|aarch64-qualcomm|aarch64-n1x|aarch64-gb10|ppc64le|ppc64le-power9]
 # omarchy:hidden=true
 
 set -eo pipefail
@@ -23,6 +23,8 @@ case $platform in
   x86) lists=(base) ;;
   aarch64) lists=(base aarch64) ;;
   aarch64-apple | aarch64-qualcomm | aarch64-n1x | aarch64-gb10) lists=(base aarch64 "$platform") ;;
+  ppc64le) lists=(base ppc64le) ;;
+  ppc64le-power9) lists=(base ppc64le "$platform") ;;
   *)
     echo "Error: unknown platform '$platform'" >&2
     exit 1
@@ -43,12 +45,21 @@ names() {
   sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$@"
 }
 
-# One name per line, first occurrence kept, in list order. An aarch64 platform
-# leaves out the base packages that only x86_64 builds.
-if [[ $platform == "x86" ]]; then
+# One name per line, first occurrence kept, in list order. Every architecture
+# but x86 leaves out the base packages that only x86_64 builds, and POWER also
+# leaves out those that build for x86_64 and aarch64 but not for ppc64le.
+skips=()
+if [[ $platform != "x86" ]]; then
+  skips+=("$OMARCHY_PATH/install/omarchy-x86_64-only.packages")
+fi
+if [[ $platform == ppc64le* ]]; then
+  skips+=("$OMARCHY_PATH/install/omarchy-ppc64le-unavailable.packages")
+fi
+
+if (( ${#skips[@]} == 0 )); then
   names "${files[@]}" | awk '!seen[$0]++'
 else
-  names "${files[@]}" | awk -v skips=<(names "$OMARCHY_PATH/install/omarchy-x86_64-only.packages") '
+  names "${files[@]}" | awk -v skips=<(names "${skips[@]}") '
     BEGIN { while ((getline name < skips) > 0) skip[name] = 1 }
     !skip[$0] && !seen[$0]++'
 fi

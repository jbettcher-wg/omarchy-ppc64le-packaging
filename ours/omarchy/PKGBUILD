# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Omarchy 4's base package, repackaged for ppc64le.
#
# There is no port here.  The content is architecture-independent: as of 4.5.0
# all 1,652 shipped files are shell, Lua, QML, TOML, desktop entries and images,
# with zero machine code.  Upstream labelled 4.0.2 arch=any and
# relabelled 4.0.3 arch=x86_64 without changing that -- see the note at source=.
# Unlike omarchy-nvim, which declared any while vendoring two x86-64 ELF
# binaries, the content here is honest even where the label is not.
# _assert_upstream() enforces zero machine code, so if upstream ever starts vendoring a binary
# the build fails instead of shipping a foreign one.
#
# What this package needs instead is dependency surgery, and it is not
# cosmetic.  Upstream depends on limine, limine-mkinitcpio-hook,
# limine-snapper-sync and snapper.  limine is an x86/aarch64 UEFI+BIOS
# bootloader; POWER9 boots through OPAL/petitboot.  So limine is not merely
# unpackaged for this architecture, it is the wrong component -- the one
# dependency here that could never be satisfied by porting harder.
#
# Changes to the shipped tree are each justified at the point they are made in
# package().  Everything else ships byte-for-byte as upstream built it.
#
# 4.5.0 is the first release with a platform model (omarchy-hw-platform,
# per-platform package lists and pacman templates).  Our ppc64le and
# ppc64le-power9 platforms are carried as patches generated from the
# ppc64le-platform branch of upstream/omarchy-ppc64le-platform, kept in
# upstream's git paths so the same files are what we would send upstream.
#
# Retired at 4.5.0: the Antigravity backport (0001-agent-antigravity.patch and
# omarchy-agent-usage-agy).  Upstream ships agy in omarchy-default-agent,
# omarchy-agent and its own omarchy-agent-usage-agy now.
#
# Note for whoever next reads omarchy-other.packages: 4.0.4 renamed upstream's
# own kernel package from linux-ptl to **linux-omarchy**, which is the name our
# baseline POWER8 kernel already uses (ours/linux-omarchy).  Nothing breaks --
# the names only collide across repositories we do not serve together, and the
# arch differs -- but the collision is now real and worth knowing before anyone
# wires the two package sets together.
#
# Upstream publishes no PKGBUILD -- the Omarchy repo distributes built packages
# only -- so the source *is* the upstream package, exactly as for omarchy-nvim.
# Its sha256 is the one recorded in https://pkgs.omarchy.org/x86_64/omarchy.db,
# so this recipe is pinned to the artifact upstream actually published.
#
# arch=(any) was correct as it stood.  No architecture change was needed.

pkgname=omarchy
pkgver=4.5.0
# pkgrel above upstream's marks this as locally modified: upstream's own build
# is 4.5.0-3 (_upstream_rel below).
pkgrel=9
pkgdesc='Beautiful, modern, and opinionated Arch Linux by DHH (ppc64le: limine and update-guard removed)'
arch=(any)
url='https://github.com/basecamp/omarchy'
license=(MIT)
makedepends=(file)

# Upstream's depends, minus four entries. (omarchy-keyring was a fifth until
# 4.5.0-8: 4.5's `omarchy update` installs and refreshes it on every platform,
# so it is packaged here now and depended on as upstream does.)
#
#   limine                   x86/aarch64 bootloader.  POWER9 boots via
#   limine-mkinitcpio-hook   OPAL/petitboot.  Wrong component, not a missing
#   limine-snapper-sync      port.
#   snapper                  Present only to feed limine-snapper-sync's boot
#                            entries.  Not in the ppc64le repos, and without
#                            limine there is nothing to sync snapshots to.
#                            Demoted to optdepends: snapper itself is useful,
#                            the boot integration is what does not apply.
#
# Everything else is either installed on this machine or already built in this
# repo (hyprland, quickshell, uwsm, xdg-desktop-portal-hyprland), so the
# dependency closure genuinely resolves on ppc64le.
depends=(
  "omarchy-settings=${pkgver}"
  omarchy-keyring
  # New in 4.5.0: the theme intro videos ship separately, the network speed
  # test runs its own client, and omarchy-update needs the sudo-grant library
  # that omarchy-settings now provides.
  omarchy-themes-intros
  omarchy-speedtest
  omarchy-security-functions
  hyprland
  quickshell
  uwsm
  # Every app binding goes through omarchy-launch-*, and 11 of those scripts
  # exec `uwsm-app -- xdg-terminal-exec ...`. Upstream never declares it, so a
  # system without it gets a Hyprland session where SUPER+RETURN and every other
  # launch binding fail silently -- the compositor is fine, nothing starts, and
  # there is no error anywhere the user will look.
  xdg-terminal-exec
  sddm
  xdg-desktop-portal-hyprland
  wireplumber
  pipewire
  gnome-keyring
  gum
  jq
  git
  perl
  fakeroot
  pacman-contrib
  ttf-jetbrains-mono-nerd-basic
)

optdepends=(
  'snapper: btrfs snapshots (omarchy-snapshot); upstream also uses it to feed limine boot entries, which do not apply on OPAL/petitboot'
  'plocate: file indexing for the Omarchy menu search'
  'inxi: system information for omarchy-debug'
)

conflicts=(omarchy-dev)

# Upstream's published artifact, from the stable channel. Upstream labels it
# arch=x86_64 (4.0.2 shipped as -any), but the content did not change class:
# re-verified for 4.5.0-3 -- sha256 matches
# https://pkgs.omarchy.org/stable/x86_64/omarchy.db, 1,652 files, zero ELF or
# object files. Every file the patches below touch was checked byte-identical
# to the v4.5.0 tag before generating them, and every sed/awk anchor in
# package() was re-checked against the 4.5.0-3 tree.
#
# The relabel is in their build pipeline, not the source. _assert_upstream()
# keeps enforcing zero machine code, so this stays arch=(any); if upstream ever ships a real
# binary here, the build fails instead of trusting the label.
_upstream_arch=x86_64
_upstream_rel=3
_srcpkg="${pkgname}-${pkgver}-${_upstream_rel}-${_upstream_arch}.pkg.tar.zst"
source=("https://pkgs.omarchy.org/stable/${_upstream_arch}/${_srcpkg}"
        omarchy-pkg-aur-precheck
        0001-agent-distro-package.patch
        0002-ppc64le-platform-bin.patch
        0003-ppc64le-platform-install.patch)
noextract=("${_srcpkg}")
# The first from %SHA256SUM% in the upstream omarchy.db, not computed from a
# local copy.
sha256sums=('bfe75d086c8b5c919280372afdd72e8cc7b0f66745f052d826b5a588fdad33eb'
            '46a884384a9fc4e4cf787e91a4db0c7b5fe691312b5c9ae04690915bc0d7743b'
            '4dbcc6e5b77bd530d5493bc7523ef346a8c4d3653c5e2c93581bae43afbc2a8b'
            '0779d35dd682ab88c4cadf79f067e5432ab08d2334aa0d374376498757d7e835'
            '7a6b3681448a441f1cadc4b91db25594cd5f1acbf43a3f7fa21ac5a188bb3100')

_unpack() {
  bsdtar -xf "${srcdir}/${_srcpkg}" -C "$1" \
    --no-same-owner \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL
}

# Not check(): bq builds with makepkg --nocheck, so a check() never runs for a
# package that ships. Through 4.0.4-6 these assertions sat in check() and were
# inert. package() calls this first instead.
_assert_upstream() {
  # The premise of this package: arch=any is honest, i.e. not one byte of
  # machine code.  Verified true through 4.5.0.  If a future version vendors a
  # prebuilt x86-64 helper the way omarchy-nvim vendored stylua and shfmt,
  # fail here rather than shipping a binary that cannot run.
  local found
  rm -rf "${srcdir}/upstream"
  mkdir -p "${srcdir}/upstream"
  _unpack "${srcdir}/upstream"

  found=$(find "${srcdir}/upstream" -type f -print0 \
    | xargs -0 file -N --mime-type 2>/dev/null \
    | awk -F': ' '$2 ~ /^application\/x-(pie-)?(executable|sharedlib)|x-object|x-archive/ { print $1 }' \
    | sed "s|^${srcdir}/upstream/||" | sort)

  if [ -n "$found" ]; then
    printf 'omarchy %s is not arch=any after all -- ELF payload found:\n%s\n' \
      "$pkgver" "$found" >&2
    return 1
  fi

  # The two files package() removes must actually be there.  If upstream
  # renames or drops them, the removal below would silently no-op and this
  # package would quietly regain the behaviour it exists to remove.
  [ -f "${srcdir}/upstream/usr/share/libalpm/hooks/00-omarchy-update-guard.hook" ]
}

package() {
  _assert_upstream
  _unpack "${pkgdir}"

  # Remove the pacman update guard.
  #
  # 00-omarchy-update-guard.hook triggers on Operation=Upgrade, Target=* with
  # AbortOnFail, and runs omarchy-update-pacman-guard, which exits 1 for any
  # `pacman -Syu` telling the user to run `omarchy update` instead.  That is
  # the right default on x86 Omarchy, where `omarchy update` works.
  #
  # It is the wrong default here.  `omarchy update` expects the Omarchy pacman
  # channel (no ppc64le tree), omarchy-keyring and snapper snapshots -- none of
  # which exist on this machine.  Leaving the hook in place would make the
  # guard fail closed against the *only* working update path on a daily-driver
  # workstation: every `pacman -Syu` would abort, and the alternative it names
  # cannot run.  The escape hatch (OMARCHY_ALLOW_DIRECT_PACMAN=1) exists, but
  # requiring it for every routine upgrade is not a defensible default.
  #
  # Local workaround, not upstreamable: the hook is correct for the platform it
  # was written for.
  rm -f "${pkgdir}/usr/share/libalpm/hooks/00-omarchy-update-guard.hook"

  # The other two libalpm hooks (10-/90- hyprland reload around
  # omarchy-settings upgrades) are kept.  They are not AbortOnFail, so a host
  # with no Hyprland session running fails them harmlessly.

  # Fail the build if any shipped ELF records a build-tree path.  This package
  # ships no ELF at all, so the guard should report zero files -- which is
  # itself the assertion worth keeping, and costs nothing.
  "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"

  # Claude Code needs nothing of its own here any more. It publishes no ppc64le
  # build; omarchy-settings' POWER mise fragment points mise's aqua recipe for
  # it at the linux/arm64 build, which POWERarm (a default package on POWER)
  # runs through binfmt_misc. So claude installs through mise like every other
  # agent, keeps the agent-account wrapper, and self-updates with auto_update.
  # omarchy-install-claude-powerarm and its agent_installer routing are retired.

  # ppc64le: let a packaged agent satisfy omarchy-default-agent.
  #
  # Without this, selecting Crush from the menu runs `mise use -g crush`, whose
  # aqua backend resolves release assets by platform and finds none for
  # powerpc64le -- "no asset found: crush_0.98.1_Linux_powerpc64.tar.gz" -- even
  # though /usr/bin/crush is installed and current from our own pool. Upstream
  # already refuses to shadow an install mise did not make (see user_install);
  # this extends the same rule to a distribution package, after the user's own
  # install and before mise.
  #
  # Carried as a real patch rather than sed: its paths are upstream's git paths
  # (bin/...), so `-p1 -d "$pkgdir/usr"` lands them on the installed layout and
  # the same file is what we would send upstream, and patch(1) fails loudly when
  # upstream moves the context. Rebased onto 4.5.0, where presence is
  # `mise where "$agent_tool"` and install goes through omarchy-mise-default-tools.
  patch -p1 -d "${pkgdir}/usr" < "${srcdir}/0001-agent-distro-package.patch"
  grep -q 'distro_install()' "${pkgdir}/usr/bin/omarchy-default-agent" ||
    { echo "omarchy: distro-package patch applied but distro_install is absent" >&2; return 1; }
  grep -qF 'user_install || distro_install || mise where' "${pkgdir}/usr/bin/omarchy-default-agent" ||
    { echo "omarchy: distro_install present but not wired into agent_present" >&2; return 1; }
  grep -qF '{ user_install || distro_install; } && return' "${pkgdir}/usr/bin/omarchy-default-agent" ||
    { echo "omarchy: distro_install present but not wired into agent_install" >&2; return 1; }

  # ppc64le: the ppc64le and ppc64le-power9 platforms.
  #
  # Generated from the ppc64le-platform branch; each patch's header names the
  # commits and the command. bin/ lands under usr/, install/ and migrations/
  # under usr/share/omarchy/, as upstream's own package() lays them out. Without this,
  # omarchy-hw-platform calls a POWER machine x86, omarchy-pkg-defaults hands
  # it the x86 package set, and the pacman helpers have no template for it.
  patch -p1 -d "${pkgdir}/usr" < "${srcdir}/0002-ppc64le-platform-bin.patch"
  patch -p1 -d "${pkgdir}/usr/share/omarchy" < "${srcdir}/0003-ppc64le-platform-install.patch"
  # The two family predicates and the POWERarm guest check are new files.
  # patch(1) honours the git mode line, but say it rather than rely on it, and
  # give them the absolute usr/share/omarchy/bin symlink every other command has.
  local _hw
  for _hw in omarchy-hw-ppc64le omarchy-hw-ppc64le-power9 omarchy-hw-powerarm-guest; do
    chmod 755 "${pkgdir}/usr/bin/${_hw}"
    ln -sf "/usr/bin/${_hw}" "${pkgdir}/usr/share/omarchy/bin/${_hw}"
  done
  grep -q 'echo ppc64le-power9' "${pkgdir}/usr/bin/omarchy-hw-platform" ||
    { echo "omarchy: platform patch applied but the detector cannot name ppc64le-power9" >&2; return 1; }
  grep -qF 'unsupported CPU architecture' "${pkgdir}/usr/bin/omarchy-hw-platform" ||
    { echo "omarchy: the detector still falls through to x86 on an unknown CPU" >&2; return 1; }
  [ -s "${pkgdir}/usr/share/omarchy/install/omarchy-ppc64le.packages" ] ||
    { echo "omarchy: the ppc64le package list is missing" >&2; return 1; }
  # Rebuilds mise's system shims once omarchy-settings ships POWER's mise
  # fragment; without it an upgraded system keeps the lazy gh and crush shims
  # that shadow /usr/bin.
  [ -f "${pkgdir}/usr/share/omarchy/migrations/1794867648.sh" ] ||
    { echo "omarchy: the POWER mise migration is missing" >&2; return 1; }
  # A terminal in an arm64 app is an AArch64 guest under POWERarm with its own
  # pacman database; migrations run there check the guest's packages instead.
  grep -qx 'if omarchy-hw-powerarm-guest; then' "${pkgdir}/usr/bin/omarchy-migrate" ||
    { echo "omarchy: omarchy-migrate does not refuse a POWERarm guest" >&2; return 1; }
  # Migrations install packages through omarchy-pkg-add, and omarchy-migrate
  # stops at the first that fails; on POWER it must skip what the platform
  # lists as unavailable (localsend) rather than stop every later migration.
  grep -qF 'omarchy-ppc64le-unavailable.packages' "${pkgdir}/usr/bin/omarchy-pkg-add" ||
    { echo "omarchy: omarchy-pkg-add does not skip the platform's unavailable packages" >&2; return 1; }
  local _f
  for _f in usr/bin/omarchy-hw-platform usr/bin/omarchy-hw-ppc64le \
            usr/bin/omarchy-hw-ppc64le-power9 usr/bin/omarchy-pkg-defaults \
            usr/bin/omarchy-default-agent usr/bin/omarchy-migrate \
            usr/bin/omarchy-hw-powerarm-guest \
            usr/share/omarchy/install/helpers/pacman.sh \
            usr/share/omarchy/install/helpers/image-target.sh \
            usr/share/omarchy/migrations/1794867648.sh; do
    bash -n "${pkgdir}/${_f}"
  done

  # ppc64le: report our repos as the stable channel.
  #
  # omarchy-version-channel (the channel line under OS in fastfetch) only
  # recognises omarchy.org mirror and pkgs URLs, so a system installed from
  # [omarchy-ppc64le] or [omarchy-power9] reports "unknown". 4.0.4-6 matched
  # only omarchy-power<N>, so the baseline pool still said "unknown"; the
  # match now takes both. Until these packages are served from
  # Omarchy's own URLs, a pacman.conf that enables our repo is the stable
  # channel. Upstreamable form: match the repo section by name, not the URL.
  # The real script is usr/bin; usr/share/omarchy/bin/ holds an absolute symlink
  # to it (as for all 441 entries there), which must stay a symlink.
  local _ch="${pkgdir}/usr/bin/omarchy-version-channel"
  [ -f "$_ch" ] && [ ! -L "$_ch" ] ||
    { echo "omarchy: usr/bin/omarchy-version-channel is not a regular file" >&2; return 1; }
  local _anchor='if [[ $mirror == $pkgs ]]; then'
  grep -qxF "$_anchor" "$_ch" ||
    { echo "omarchy: omarchy-version-channel changed upstream; redo the stable override" >&2; return 1; }
  _OVERRIDE='if grep -qE "^\[omarchy-(power[0-9]+|ppc64le)\]" /etc/pacman.conf; then
  mirror="stable"
  pkgs="stable"
fi
' awk -v anchor="$_anchor" '$0 == anchor { print ENVIRON["_OVERRIDE"] } { print }' "$_ch" > "${srcdir}/omarchy-version-channel"
  install -m "$(stat -c %a "$_ch")" "${srcdir}/omarchy-version-channel" "$_ch"
  bash -n "$_ch"
  grep -qF '[omarchy-(power[0-9]+|ppc64le)' "$_ch" ||
    { echo "omarchy: stable channel override did not apply" >&2; return 1; }

  # ppc64le: look before yay builds an AUR package.
  #
  # omarchy-pkg-aur-install passes the picked names straight to
  # `yay -S --noconfirm`. yay then builds x86-only binary repacks anyway (it
  # passes --ignorearch; AUR openarena installed the release zip's .x86_64
  # binaries, labelled powerpc64le, runnable only through FEX's binfmt), and
  # stops mid-build on dependencies that are official Arch packages not yet built
  # for POWER. omarchy-pkg-aur-precheck reports both before anything builds and
  # asks before continuing. Upstreamable in spirit: the same check keyed on the
  # machine's own architecture helps Omarchy on ARM too.
  install -Dm755 "${srcdir}/omarchy-pkg-aur-precheck" "${pkgdir}/usr/bin/omarchy-pkg-aur-precheck"
  # usr/share/omarchy/bin holds an absolute symlink for every command.
  ln -sf /usr/bin/omarchy-pkg-aur-precheck "${pkgdir}/usr/share/omarchy/bin/omarchy-pkg-aur-precheck"
  local _aur="${pkgdir}/usr/bin/omarchy-pkg-aur-install"
  [ -f "$_aur" ] && [ ! -L "$_aur" ] ||
    { echo "omarchy: usr/bin/omarchy-pkg-aur-install is not a regular file" >&2; return 1; }
  local _aur_anchor='if [[ -n $pkg_names ]]; then'
  grep -qxF "$_aur_anchor" "$_aur" ||
    { echo "omarchy: omarchy-pkg-aur-install changed upstream; redo the precheck hook" >&2; return 1; }
  _PRECHECK='  # ppc64le: report binary repacks and unbuildable dependencies first.
  omarchy-pkg-aur-precheck $pkg_names || exit 1
' awk -v anchor="$_aur_anchor" '{ print } $0 == anchor { printf "%s", ENVIRON["_PRECHECK"] }' "$_aur" > "${srcdir}/omarchy-pkg-aur-install"
  install -m "$(stat -c %a "$_aur")" "${srcdir}/omarchy-pkg-aur-install" "$_aur"
  bash -n "$_aur"
  grep -qF 'omarchy-pkg-aur-precheck $pkg_names' "$_aur" ||
    { echo "omarchy: precheck hook did not apply" >&2; return 1; }
}

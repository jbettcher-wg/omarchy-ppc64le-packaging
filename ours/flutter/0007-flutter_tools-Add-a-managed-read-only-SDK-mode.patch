@@ -242,6 +242,62 @@ class Cache {
   // Explore making this field lazy to catch non-initialized access.
   static String? flutterRoot;
 
+  /// The name of the file in `bin/cache` that marks a managed SDK.
+  static const managedByFileName = 'managed-by';
+
+  /// Who manages the Flutter SDK at [flutterRoot], or null if nobody does.
+  ///
+  /// A distribution package can install the SDK read-only (for example to
+  /// /usr/lib/flutter), with every artifact already in `bin/cache`, every
+  /// stamp written and the tool snapshot built. It marks such an install with
+  /// `bin/cache/managed-by`, whose first line names the package (for example
+  /// `pacman (flutter 3.41.9-1)`). A managed SDK is never written to and never
+  /// downloads anything:
+  ///
+  ///  * [lock] does not create the lockfile,
+  ///  * [updateAll] checks that the required artifacts are present and fails
+  ///    if they are not, instead of downloading them,
+  ///  * the version comes from `bin/cache/flutter.version.json`, never from
+  ///    git, and is not checked for freshness (see `FlutterVersion`),
+  ///  * `flutter upgrade`, `channel` and `downgrade`, and
+  ///    `precache --force`, refuse to run.
+  static String? managedSdkOwner(FileSystem fileSystem, String flutterRoot) {
+    final File marker = fileSystem.file(
+      fileSystem.path.join(flutterRoot, 'bin', 'cache', managedByFileName),
+    );
+    if (!marker.existsSync()) {
+      return null;
+    }
+    String owner;
+    try {
+      owner = marker.readAsLinesSync().firstOrNull?.trim() ?? '';
+    } on FileSystemException {
+      owner = '';
+    }
+    return owner.isEmpty ? 'a package manager' : owner;
+  }
+
+  /// Who manages this Flutter SDK, or null; see [managedSdkOwner].
+  late final String? managedBy = switch (_rootOverride?.path ?? flutterRoot) {
+    final String root => managedSdkOwner(_fileSystem, root),
+    null => null,
+  };
+
+  /// Whether this Flutter SDK is managed; see [managedSdkOwner].
+  bool get isManaged => managedBy != null;
+
+  /// Throws a [ToolExit] if this Flutter SDK is managed, because [action]
+  /// would modify it.
+  void checkNotManaged(String action) {
+    final String? owner = managedBy;
+    if (owner != null) {
+      throwToolExit(
+        'Cannot $action: this Flutter SDK is managed by $owner and is read-only. '
+        'Update it through $owner instead.',
+      );
+    }
+  }
+

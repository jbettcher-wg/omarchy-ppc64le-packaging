+  /// Traced by [_task], cannot be used for concurrent actions.
+  ///
+  /// Use [_fileSystemUntraced] for actions that must not be traced.
+  ///
+  /// This uses [_fileSystemUntraced] under the hood.
+  late final TracingFileSystem _fileSystem;

+    required this.dartExecutable,
+    required FileSystem fileSystem,
+    required this.packageLayout,
+    Duration? singleHookTimeout,
+    Map<String, String>? hookEnvironment,
+    this.userDefines,
+  }) : _fileSystemUntraced = fileSystem,

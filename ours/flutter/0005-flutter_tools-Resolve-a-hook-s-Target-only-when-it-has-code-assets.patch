 import '../fake_native_assets_build_runner.dart';
 
 void main() {
@@ -81,6 +85,73 @@ void main() {
     expect(Architecture.fromString('ppc64'), Architecture.ppc64);
   });
 
+  testUsingContext(
+    'linux_ppc64 hooks that produce no code assets need no ppc64 Target',
+    overrides: <Type, Generator>{
+      FeatureFlags: () => TestFeatureFlags(isNativeAssetsEnabled: true),
+      ProcessManager: () => FakeProcessManager.empty(),
+    },
+    () async {
+      final File packageConfig = environment.projectDir.childFile('.dart_tool/package_config.json');
+      await packageConfig.create(recursive: true);
+      final buildRunner = FakeFlutterNativeAssetsBuildRunner(
+        packagesWithNativeAssetsResult: <String>['objective_c'],
+        buildResult: FakeFlutterNativeAssetsBuilderResult.fromAssets(),
+      );
+
+      final DartHooksResult result = await runFlutterSpecificHooks(
+        environmentDefines: <String, String>{kBuildMode: BuildMode.release.cliName},
+        targetPlatform: TargetPlatform.linux_ppc64,
+        projectUri: projectUri,
+        fileSystem: fileSystem,
+        buildRunner: buildRunner,
+      );
+      expect(buildRunner.buildInvocations, 1);
+      expect(result.codeAssets, isEmpty);
+    },
+  );
+
+  testUsingContext(
+    'linux_ppc64 code assets get the linux_ppc64 Target when the SDK has one',
+    overrides: <Type, Generator>{
+      FeatureFlags: () => TestFeatureFlags(isNativeAssetsEnabled: true),
+      ProcessManager: () => FakeProcessManager.empty(),
+    },
+    () async {
+      final File packageConfig = environment.projectDir.childFile('.dart_tool/package_config.json');
+      await packageConfig.create(recursive: true);
+      final buildRunner = FakeFlutterNativeAssetsBuildRunner(
+        packagesWithNativeAssetsResult: <String>['bar'],
+        buildResult: FakeFlutterNativeAssetsBuilderResult.fromAssets(
+          codeAssets: <CodeAsset>[
+            CodeAsset(
+              package: 'bar',
+              name: 'bar.dart',
+              linkMode: DynamicLoadingBundled(),
+              file: Uri.file('/build/libbar.so'),
+            ),
+          ],
+        ),
+      );
+      Future<DartHooksResult> run() => runFlutterSpecificHooks(
+        environmentDefines: <String, String>{kBuildMode: BuildMode.release.cliName},
+        targetPlatform: TargetPlatform.linux_ppc64,
+        projectUri: projectUri,
+        fileSystem: fileSystem,
+        buildRunner: buildRunner,
+      );
+
+      // Only the ppc64 port of the Dart SDK has the linux_ppc64 ABI.
+      final hooks_runner.Target? linuxPpc64 = hooks_runner.Target.linuxPpc64;
+      if (linuxPpc64 == null) {
+        await expectLater(run(), throwsArgumentError);
+      } else {
+        final DartHooksResult result = await run();
+        expect(result.codeAssets.single.target, same(linuxPpc64));
+      }
+    },
+  );
+
   testUsingContext(
     'does not throw if clang not present but no native assets present',
     overrides: <Type, Generator>{ProcessManager: () => FakeProcessManager.empty()},

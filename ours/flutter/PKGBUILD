# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Flutter 3.41.9 for ppc64le (POWER8+, little-endian, ELFv2, glibc): the
# framework packages and the `flutter` tool, installed as a *managed*,
# read-only SDK in /usr/lib/flutter with /usr/bin/flutter. The engine
# (libflutter_linux_gtk.so, gen_snapshot, flutter_tester, the patched SDK)
# is the flutter-engine package, installed into the same tree; the Dart SDK
# is the dart package, linked as bin/cache/dart-sdk.
#
# Class: local workaround (distribution packaging). The tool changes are
# classified patch by patch, in each patch's Class: line (table below).
#
# Eight things about this build are worth knowing before changing it.
#
# 1. THE TOOL IS PATCHED, NOT THE FRAMEWORK. The numbered NNNN-*.patch files
#    are `git format-patch` output of the unpublished branch
#    ppc64-tool-3.41.9 (flutter-port work/flutter-tool/flutter), applied with
#    `patch -Np1` at the monorepo root. They teach flutter_tools a
#    linux_ppc64 host and target, carry dart-lang/native's code_assets and
#    hooks_runner with Architecture.ppc64 (vendored in third_party/pkg), and
#    add the managed SDK mode this package relies on (0007).
#
# 2. A MANAGED SDK NEVER WRITES UNDER /usr/lib/flutter AND NEVER DOWNLOADS.
#    bin/cache/managed-by marks the install (0007): bin/flutter execs the
#    prebuilt snapshot without git, pub or a rebuild; the cache lock is
#    skipped; a missing artifact is an error naming the package to install
#    instead of a download; the version comes from bin/cache/
#    flutter.version.json; upgrade/channel/downgrade refuse; analytics
#    default to off. Everything the tool would otherwise write at run time is
#    pre-generated here by write-managed-metadata.sh: the marker, the version
#    files, engine_stamp.json, every artifact stamp, the dart-sdk link.
#    build() proves it: the smoke app's whole create/pub/test/build cycle
#    leaves every file under the staged SDK untouched (gate W).
#
# 3. SOURCES: the monorepo is fetched in prepare(), shallow, by commit
#    (flutter-engine does the same), and gated by git tree hash: gate 1 is
#    the tag's tree, gate 2 the branch's tree after the series. The
#    flutter_tools dependencies are fetched by `dart pub get
#    --enforce-lockfile` against flutter_tools-pubspec.lock (pins every
#    archive's sha256), the smoke app's by `dart pub get`, both in prepare()
#    (pub.dev; bq shares the host's network namespace). The material fonts and the Gradle wrapper (universal
#    artifacts the tool checks on every command) are checksummed source=()
#    zips from Flutter's storage bucket. build() and package() are offline.
#
# 4. THE PREBUILT IS THE POOL'S OWN dart, AS A DRIVER ONLY. It runs `pub get`
#    and makes flutter_tools.snapshot, an app-jit snapshot: JIT code for
#    that exact VM build. Hence the exact dart=$_dart_pkgver-$_dart_pkgrel and the PKGREL
#    RULE below. CONTROL refuses a dart that is not a native linux_ppc64 one
#    from this pool (an emulated arm64 dart at the same path runs through
#    binfmt_misc and would bake arm64 code into the snapshot).
#
# 5. THE ENGINE AND dart MUST AGREE ON THE DART SDK HASH. The tool compiles
#    kernels with dart's frontend_server (dart-sdk/bin/snapshots/
#    frontend_server_aot.dart.snapshot) against flutter-engine's
#    flutter_patched_sdk, and the engine's VM and gen_snapshot read them.
#    Gate H compiles a program that way; with an engine built on a different
#    hash (measured 2026-11-19: 627460b45a, the git HEAD of the engine's
#    patched Dart tree) it fails with "Unexpected Kernel SDK Version".
#    flutter-engine pins dart_sdk_verification_hash for that reason.
#
# 6. ISA. This package installs no native code (gate E: no ELF in the
#    stage; the snapshot is a Dart app-jit file, not an ELF). The smoke
#    app's libapp.so, made by flutter-engine's gen_snapshot through this
#    tool, must carry 0 ISA 3.0 instructions in BOTH pools: Dart codegen is
#    ISA 2.07. It is scanned with objdump -D -z -j .text (a stripped
#    libapp.so has only two OBJECT symbols over its code, and -d hex-dumps
#    them: 25% coverage measured), with a coverage gate (>= 99% of .text
#    words decoded) and a mid-.text control word that must count 1.
#
# 7. bq RUNS makepkg --nocheck. Every gate is in prepare() or build().
#    Inside bq /usr is a read-only overlay (which is the managed SDK's
#    normal state) and $HOME is the real home, so HOME, PUB_CACHE and
#    XDG_CONFIG_HOME point into $srcdir. package() runs under fakeroot and
#    only copies files.
#
# 8. BUILD THIS NATIVELY: through bq / tools/build-ppc64le.sh, or makepkg in
#    a native shell, never inside the POWERarm aarch64 sleeve Claude
#    sessions run in. An agent reaches the native shell with:
#    ssh -n -i ~/.ssh/id_claude_omarchy -o BatchMode=yes localhost
#
# Reproducibility: flutter_tools.snapshot comes from a timed JIT training
# run and embeds the build tree's file:// URIs, like dart's three app-jit
# snapshots; nothing gates its bytes, and makepkg's "reference to $srcdir"
# warning names it. Every installed text file is gated free of $srcdir.
#
# PKGREL RULE. pacman compares versions, not contents: bump pkgrel whenever
# dart or flutter-engine is rebuilt (the snapshot is tied to that dart's VM;
# the stamps to that engine), and whenever the series or this recipe
# changes. Then bump everything built with flutter (localsend).
#
# THE PATCH SERIES (flutter-port work/flutter-tool/patches, branch
# ppc64-tool-3.41.9 128dc992), with each patch's Class: line:
# 0001 [flutter_tools] Take the Linux host architecture from the Dart ABI, not uname
#      Class: upstreamable fix (backport of upstream #185369 + #190480).
# 0002 [flutter_tools] Vendor code_assets 1.0.0 and hooks_runner 1.0.1
#      Class: local workaround (carry mechanism; no functional change).
# 0003 [third_party/pkg] Add Architecture.ppc64 and the linux_ppc64 target
#      Class: upstreamable fix (to dart-lang/native); dart's series 0034 is
#        the same change in the SDK's own copy.
# 0004 [flutter_tools] Add the linux_ppc64 host and target platform
#      Class: upstreamable in form (follows #178711, linux_riscv64); local
#        until the Dart VM has an upstream ppc64 backend.
# 0005 [flutter_tools] Resolve a hook's Target only when it has code assets
#      Class: upstreamable fix; defensive here.
# 0006 [flutter_tools] Stop rewriting the iOS USB artifact stamps on non-macOS hosts
#      Class: upstreamable fix.
# 0007 [flutter_tools] Add a managed, read-only SDK mode for distribution packages
#      Class: local workaround (distribution packaging).
# 0008 [flutter_tools] doctor: accept the dart that bin/cache/dart-sdk links to
#      Class: local workaround (packaging layout).
# 0009 [flutter_tools] Fix icon tree shaking when building for desktop (backport)
#      Class: upstreamable fix, already upstream (#184249).

pkgname=flutter
pkgver=3.41.9
pkgrel=1
pkgdesc='Flutter SDK: the framework and the flutter tool, as a managed read-only SDK (ppc64le port)'
arch=('powerpc64le')
url='https://flutter.dev'
license=('BSD-3-Clause')

_url=https://github.com/flutter/flutter.git
_commit=00b0c91f06209d9e4a41f71b7a512d6eb3b9c694       # tag 3.41.9
_commit_time='Wed Apr 29 17:03:19 2026 +0000'           # git log -1 --format=%cd 3.41.9
_commit_date_iso='2026-04-29 17:03:19 +0000'            # for flutter.version.json
# Gate 1: the tag's tree (git rev-parse 3.41.9^{tree}); flutter-engine's too.
_base_tree=77bb2e2312ad0f9cdf8e44d868396dc3751b1ed8
# Gate 2: the monorepo after the series = ppc64-tool-3.41.9^{tree} (128dc992).
_tree=6666747b51907fc4096ea5898ac9b4ebb63ce853
# bin/internal/engine.version at the tag: the engine revision every engine
# stamp holds; flutter-engine's .pkginfo records the same value.
_engine_revision=42d3d75a56efe1a2e9902f52dc8006099c45d937
_dart_pkgver=3.11.5
# Exact builds: the tool snapshot is JIT code for that dart's VM, and the
# stamps and the hash gate describe that flutter-engine (PKGREL RULE).
_dart_pkgrel=1
_engine_pkgrel=1
_sdk_hash=c70f78e7d6          # Dart SDK hash: dart's tag, 10 hex digits
_dart_tree=c5aba92a8a98e5187a38d8942ffac4b1f186d428   # dart's patched tree (34 patches)
_materialfontsver=3012db47f3130e62f7cc0beabff968a33cbec8d8   # bin/internal/material_fonts.version
_gradlewver=fd5c1f2c013565a3bea56ada6df9d2b8e96d56aa         # bin/internal/gradle_wrapper.version

# The managed SDK runs bin/flutter (bash), finds tools with `which`, and pub
# needs git for git dependencies. `flutter build linux` needs the C/C++
# toolchain, CMake, ninja, pkg-config and GTK 3 headers (the runner and
# plugins are compiled on the user's machine).
depends=("dart=$_dart_pkgver-$_dart_pkgrel" "flutter-engine=$pkgver-$_engine_pkgrel"
         'bash' 'which' 'git' 'clang' 'cmake' 'ninja' 'pkgconf' 'gtk3')
optdepends=('lld: ld.lld for native-assets build hooks (else binutils ld next to clang)'
            'llvm: llvm-ar for native-assets build hooks (else binutils ar next to clang)')
# The smoke build in build() is a real `flutter build linux`, so it needs
# what `depends` names for that, plus objdump/readelf for the gates.
makedepends=("dart=$_dart_pkgver-$_dart_pkgrel" "flutter-engine=$pkgver-$_engine_pkgrel" 'git' 'patch' 'file' 'binutils'
             'clang' 'cmake' 'ninja' 'pkgconf' 'gtk3')
# !strip: nothing here is a native ELF (gate E), and the pub cache is source.
options=('!strip' '!debug' '!lto')

# --- POWER8 / POWER9 ---------------------------------------------------------
# Set by tools/build-ppc64le.sh for the baseline pool. This package has no
# native code of its own; the pool only selects which dart and flutter-engine
# CONTROL accepts, and is recorded in .pkginfo.
_power8_compat=${_power8_compat:-0}

# --- scratch builds only -----------------------------------------------------
# The gates and the smoke cycle read the installed dart and flutter-engine
# at these paths. A scratch build (flutter-port work/packaging/pkgtest/
# flutter/harness) runs makepkg in a bwrap whose read-only /usr overlays the
# extracted packages there, so nothing here changes for it.
# _interim_engine=1 (set only by that harness's PKGBUILD.harness) accepts an
# engine tree without flutter-engine's .pkginfo (the engine track's stage),
# and .pkginfo then says INTERIM; a pool build never sets it.
_interim_engine=0
_dart_root=/usr/lib/dart
_engine_root=/usr/lib/flutter/bin/cache

_patches=(
  0001-flutter_tools-Take-the-Linux-host-architecture-from-the-Dart-ABI.patch
  0002-flutter_tools-Vendor-code_assets-1.0.0-and-hooks_runner-1.0.1.patch
  0003-third_party-pkg-Add-Architecture.ppc64-and-the-linux_ppc64-target.patch
  0004-flutter_tools-Add-the-linux_ppc64-host-and-target-platform.patch
  0005-flutter_tools-Resolve-a-hook-s-Target-only-when-it-has-code-assets.patch
  0006-flutter_tools-Stop-rewriting-the-iOS-USB-artifact-stamps.patch
  0007-flutter_tools-Add-a-managed-read-only-SDK-mode.patch
  0008-flutter_tools-doctor-accept-the-dart-that-bin-cache-dart-sdk-links-to.patch
  0009-flutter_tools-Fix-icon-tree-shaking-when-building-for-desktop.patch
)
source=(
  "material_fonts-$_materialfontsver.zip::https://storage.googleapis.com/flutter_infra_release/flutter/fonts/$_materialfontsver/fonts.zip"
  "gradle_wrapper-$_gradlewver.tar.gz::https://storage.googleapis.com/flutter_infra_release/gradle-wrapper/$_gradlewver/gradle-wrapper.tgz"
  'write-managed-metadata.sh'
  'flutter_tools-pubspec.lock'
  "${_patches[@]}"
)
noextract=("material_fonts-$_materialfontsver.zip" "gradle_wrapper-$_gradlewver.tar.gz")
sha256sums=('e56fa8e9bb4589fde964be3de451f3e5b251e4a1eafb1dc98d94add034dd5a86'

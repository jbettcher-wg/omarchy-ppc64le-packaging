# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Omarchy's LazyVim configuration, rebuilt so it is architecture-honest.
#
# Upstream ships omarchy-nvim as arch=any, but it is not: it vendors an x86-64
# ELF binary under etc/skel/.local/share/nvim/mason/packages -- shfmt, at
# 2026.9.21 -- and nothing else in the ~56 MiB package (mostly plugin clones)
# is machine code.  (Up to 2026.8.13 it vendored stylua as well; the
# 2026.9.21 build carries shfmt only.)  That is the entire binary surface of
# Omarchy's default editor, and shfmt is packaged natively for this
# architecture, so the fix is to drop the vendored copy and point mason's bin/
# link at the system binary.
# The package then really is arch=any, and the architecture dependence lives
# where it belongs: in depends=(shfmt).
#
# stylua stays in depends even though nothing vendored is replaced by it any
# more: LazyVim's mason defaults are ensure_installed = { "stylua", "shfmt" },
# which on x86_64 mason fetches at first start.  With mason off here (below),
# depends is what keeps both formatters present.
#
# The second change is configuration, not packaging: mason's registry has no
# ppc64le assets at all, so a drop-in disables its automatic installs and lets
# every tool resolve from $PATH.  See no-mason-downloads.lua.
#
# Source.  Omarchy now has a recipe for this, omacom/omarchy-pkgs
# pkgbuilds/omarchy-nvim@60551aaddc09 (2026.9.21-5, what their stable channel
# ships), but it produces the package by running `nvim --headless "+Lazy!
# sync"` inside build(): every plugin is cloned over the network at whatever
# revision is current, from a LazyVim starter fetched as a moving `main`
# tarball, and only the resulting lazy-lock.json records what was taken.  The
# built package is the one fixed point, so it remains the source here: the
# stable channel's omarchy-nvim-2026.9.21-5-any.pkg.tar.zst, whose sha256
# below matches the one in https://pkgs.omarchy.org/stable/x86_64/omarchy.db.
# package() unpacks it, swaps the binary and adds the drop-ins.

pkgname=omarchy-nvim
pkgver=2026.9.21
# Above Omarchy's pkgrel (_uprel), never below it. Their migrations compare
# against their own versions: 1788996284 refuses to run until omarchy-nvim is
# 2026.9.21-2 or newer, and our -1 of their -5 content stopped omarchy-migrate
# there. package() enforces this.
pkgrel=6
pkgdesc='Pre-built LazyVim configuration with cached plugins (native tools, no mason downloads)'
arch=(any)
url='https://github.com/LazyVim/LazyVim'
license=(MIT)
makedepends=(file)
depends=(
  'neovim>=0.9.0'
  git
  shfmt
  stylua
)
optdepends=(
  'bash-language-server: LSP for shell scripts'
  'eslint: JavaScript/TypeScript linting'
  'gopls: LSP for Go'
  'lua-language-server: LSP for Lua'
  'marksman: LSP for Markdown'
  'ripgrep: snacks.nvim grep picker'
  'fd: snacks.nvim file picker'
  'taplo-cli: TOML formatting and LSP'
  'yaml-language-server: LSP for YAML'
  "rust: build blink.cmp's fuzzy matcher (falls back to the Lua one without it)"
)
conflicts=(omarchy-lazyvim)
# Omarchy's pkgrel of the package repackaged here; ours must stay above it.
_uprel=5
_upkg="${pkgname}-${pkgver}-${_uprel}-any.pkg.tar.zst"
source=("https://pkgs.omarchy.org/stable/x86_64/${_upkg}"
        no-mason-downloads.lua
        jit_startup.lua
        blink-cmp-build-fuzzy.lua)
noextract=("${_upkg}")
sha256sums=('b46d41973cacfcf2d8be371351336a3f689e2eb7b9bacdb7ca81939354cbcbc9'
            '2425c048171ccded73e92293501d66462a008ec7624f328e44f470a1a1067d5b'
            'f639707ccb384d0ad8a696ee4f2809a4b77995ba1ec4fee8ede45a9584adb3dc'
            '7cb7765e1732501c367113d2f31967c301a6a0c1943b8649eaf0b96ce3d946d4')

_mason=etc/skel/.local/share/nvim/mason
# The one vendored binary, as named by mason's receipt in this build.
_shfmt="${_mason}/packages/shfmt/shfmt_v3.14.1_linux_amd64"

prepare() {
  rm -rf "${srcdir}/upstream"
  mkdir -p "${srcdir}/upstream"
  bsdtar -xf "${srcdir}/${_upkg}" -C "${srcdir}/upstream" \
    --no-same-owner \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL
}

package() {
  [[ $(vercmp "$pkgver-$pkgrel" "$pkgver-$_uprel") -gt 0 ]] ||
    { echo "omarchy-nvim: pkgrel $pkgrel must be above Omarchy's $_uprel (migrations compare versions)" >&2; return 1; }
  # The premise of this package: exactly one foreign binary, and it is the one
  # we replace.  If upstream ever vendors another, fail loudly rather than
  # shipping it.  Here rather than in check(): bq runs makepkg --nocheck, so
  # check() never runs on a real build.
  local found
  found=$(find "${srcdir}/upstream" -type f -print0 \
    | xargs -0 file -N --mime-type 2>/dev/null \
    | awk -F': ' '$2 ~ /^application\/x-(pie-)?(executable|sharedlib)/ { print $1 }' \
    | sed "s|^${srcdir}/upstream/||" | sort)
  if [ "$found" != "$_shfmt" ]; then
    printf 'unexpected ELF payload in omarchy-nvim:\n%s\n' "$found" >&2
    return 1
  fi
  # And the replacement must exist (shfmt is a depend, so bq stages it).
  [ -x /usr/bin/shfmt ] || {
    printf 'omarchy-nvim: /usr/bin/shfmt missing; it replaces the vendored copy\n' >&2
    return 1
  }

  # Unpack straight into $pkgdir rather than copying the prepare() tree.
  # --no-same-owner: this tree is built unprivileged (no passwordless sudo on
  # the build host, so fakeroot's chown interception does not take effect in
  # the build namespace); makepkg assigns ownership when it creates the
  # package, exactly as for every other package in this repo.
  bsdtar -xf "${srcdir}/${_upkg}" -C "${pkgdir}" \
    --no-same-owner \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL

  # Drop the vendored x86-64 binary; mason's bin/ symlink already points at
  # this path, so pointing it at the system binary keeps mason's own view of
  # the world consistent (its receipt still names the package) while what
  # actually runs is the native build.
  rm -f "${pkgdir}/${_shfmt}"
  ln -sf /usr/bin/shfmt "${pkgdir}/${_shfmt}"

  # Turn mason's automatic installs off, in both copies of the config the
  # package owns (the /etc/skel seed and the /usr/share fallback).
  install -Dm644 "${srcdir}/no-mason-downloads.lua" \
    "${pkgdir}/etc/skel/.config/nvim/lua/plugins/no-mason-downloads.lua"
  install -Dm644 "${srcdir}/no-mason-downloads.lua" \
    "${pkgdir}/usr/share/omarchy-nvim/config/lua/plugins/no-mason-downloads.lua"

  # blink.cmp's Rust matcher: build it, do not download it (no ppc64le asset).
  # Header of the file has the reasoning; same two copies as above.
  install -Dm644 "${srcdir}/blink-cmp-build-fuzzy.lua" \
    "${pkgdir}/etc/skel/.config/nvim/lua/plugins/blink-cmp-build-fuzzy.lua"
  install -Dm644 "${srcdir}/blink-cmp-build-fuzzy.lua" \
    "${pkgdir}/usr/share/omarchy-nvim/config/lua/plugins/blink-cmp-build-fuzzy.lua"

  # Turn LuaJIT's trace compiler off for the duration of init.lua.  Startup
  # is run-once code, and compiling it costs about 20% of the time to first
  # dashboard: 173 traces and 100 aborted recordings, almost none of it
  # entered again in the session.  Measured on ppc64le (LuaJIT design doc
  # S7.6): 37.4 -> 30.4 ms by lazy.stats().startuptime, with every JIT-bound
  # workload unchanged.  The reasoning is architecture-neutral -- it is
  # LuaJIT's compiler, not the backend -- it is simply visible here because
  # this is where it was measured.
  local d
  for d in "${pkgdir}/etc/skel/.config/nvim" \
           "${pkgdir}/usr/share/omarchy-nvim/config"; do
    install -Dm644 "${srcdir}/jit_startup.lua" "${d}/lua/config/jit_startup.lua"
    # Upstream's init.lua is exactly a comment plus the require.  Fail the
    # build if it ever stops being that, rather than silently rewriting
    # something else.
    grep -qx 'require("config.lazy")' "${d}/init.lua"
    cat > "${d}/init.lua" <<'INIT'
-- bootstrap lazy.nvim, LazyVim and your plugins
local ljit = require("config.jit_startup")
ljit.off()
require("config.lazy")
ljit.on()
INIT
  done
}

+LocationSummary* FloatCompareInstr::MakeLocationSummary(Zone* zone,
+                                                        bool opt) const {
+  const intptr_t kNumInputs = 2;
+  const intptr_t kNumTemps = 0;
+  LocationSummary* result = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  result->set_in(0, Location::RequiresFpuRegister());
+  result->set_in(1, Location::RequiresFpuRegister());
+  result->set_out(0, Location::RequiresRegister());
+  return result;
+}
+
+void FloatCompareInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  const FpuRegister lhs = locs()->in(0).fpu_reg();
+  const FpuRegister rhs = locs()->in(1).fpu_reg();
+  const Register result = locs()->out(0).reg();
+
+  Condition condition;
+  switch (op_kind()) {
+    case Token::kEQ:
+      condition = EQ;
+      break;
+    case Token::kLT:
+      condition = LT;
+      break;
+    case Token::kLTE:
+      condition = LE;
+      break;
+    case Token::kGT:
+      condition = GT;
+      break;
+    case Token::kGTE:
+      condition = GE;
+      break;
+    default:
+      UNREACHABLE();
+  }
+  __ DoubleCompare(lhs, rhs);
+  __ SetIfDouble(condition, result);  // lhs op rhs ? 1 : 0, false on NaN
+  __ neg(result, result);             // lhs op rhs ? -1 : 0
+}
+
+LocationSummary* InvokeMathCFunctionInstr::MakeLocationSummary(Zone* zone,
+                                                               bool opt) const {
+  ASSERT((InputCount() == 1) || (InputCount() == 2));
+  const intptr_t kNumTemps = 0;
+  LocationSummary* result = new (zone) LocationSummary(
+      zone, InputCount(), kNumTemps, LocationSummary::kNativeLeafCall);
+  // ELFv2: double arguments in f1, f2; the result in f1.
+  result->set_in(0, Location::FpuRegisterLocation(F1));
+  if (InputCount() == 2) {
+    result->set_in(1, Location::FpuRegisterLocation(F2));
+  }
+  result->set_out(0, Location::FpuRegisterLocation(F1));
+  return result;
+}
+
+void InvokeMathCFunctionInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  if (compiler->intrinsic_mode()) {
+    // Would also need to preserve CODE_REG and ARGS_DESC_REG.
+    UNIMPLEMENTED();
+  }
+
+  compiler::LeafRuntimeScope rt(compiler->assembler(),
+                                /*frame_size=*/0,
+                                /*preserve_registers=*/false);
+  ASSERT(locs()->in(0).fpu_reg() == F1);
+  if (InputCount() == 2) {
+    ASSERT(locs()->in(1).fpu_reg() == F2);
+  }
+  rt.Call(TargetFunction(), InputCount());
+  ASSERT(locs()->out(0).fpu_reg() == F1);
+}

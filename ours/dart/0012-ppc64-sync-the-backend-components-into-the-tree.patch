+
+void BoxInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  const Register out_reg = locs()->out(0).reg();
+  const Register temp_reg = locs()->temp(0).reg();
+  const FpuRegister value = locs()->in(0).fpu_reg();
+
+  BoxAllocationSlowPath::Allocate(compiler, this,
+                                  compiler->BoxClassFor(from_representation()),
+                                  out_reg, temp_reg);
+
+  switch (from_representation()) {
+    case kUnboxedDouble:
+      __ StoreDFieldToOffset(value, out_reg, ValueOffset());
+      break;
+    case kUnboxedFloat:
+      // A float is already held as a double-format value: no conversion.
+      __ StoreDFieldToOffset(value, out_reg, ValueOffset());
+      break;
+    case kUnboxedFloat32x4:
+    case kUnboxedFloat64x2:
+    case kUnboxedInt32x4:
+      UNREACHABLE();  // No unboxed SIMD on ppc64 (ABI-SPEC 7.7).
+      break;
+    default:
+      UNREACHABLE();
+      break;
+  }
+}
+
+// One temp, as on RISC-V, for the integer unboxing paths of il_ppc64_b.cc
+// (EmitSmiConversion, EmitLoadInt{32,64}FromBoxOrSmi), which may use it.
+LocationSummary* UnboxInstr::MakeLocationSummary(Zone* zone, bool opt) const {
+  ASSERT(!RepresentationUtils::IsUnsignedInteger(representation()));
+  const intptr_t kNumInputs = 1;
+  const intptr_t kNumTemps = 1;
+  const bool is_floating_point =
+      !RepresentationUtils::IsUnboxedInteger(representation());
+  LocationSummary* summary = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  summary->set_in(0, Location::RequiresRegister());
+  summary->set_temp(0, Location::RequiresRegister());
+  summary->set_out(0, is_floating_point ? Location::RequiresFpuRegister()
+                                        : Location::RequiresRegister());
+  return summary;
+}
+
+void UnboxInstr::EmitLoadFromBox(FlowGraphCompiler* compiler) {
+  const Register box = locs()->in(0).reg();
+
+  switch (representation()) {
+    case kUnboxedInt64: {
+      const Register result = locs()->out(0).reg();
+      __ LoadFieldFromOffset(result, box, ValueOffset());
+      break;
+    }
+
+    case kUnboxedDouble: {
+      const FpuRegister result = locs()->out(0).fpu_reg();
+      __ LoadDFieldFromOffset(result, box, ValueOffset());
+      break;
+    }
+
+    case kUnboxedFloat: {
+      const FpuRegister result = locs()->out(0).fpu_reg();
+      __ LoadDFieldFromOffset(result, box, ValueOffset());
+      __ frsp(result, result);
+      break;
+    }
+
+    case kUnboxedFloat32x4:
+    case kUnboxedFloat64x2:
+    case kUnboxedInt32x4:
+      UNREACHABLE();  // No unboxed SIMD on ppc64.
+      break;
+
+    default:
+      UNREACHABLE();
+      break;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Doubles and floats (ABI-SPEC 7.7).
+// ---------------------------------------------------------------------------
+
+// After DoubleCompare: branch to labels.true_label when |true_condition|
+// holds (with BranchIfDouble's NaN rule), else to labels.false_label. A
+// double condition has no NaN-correct inverse in general (!(a < b) is not
+// a >= b), so the false edge is an unconditional jump when needed.
+static void EmitDoubleBranch(FlowGraphCompiler* compiler,
+                             Condition true_condition,
+                             BranchLabels labels) {
+  __ BranchIfDouble(true_condition, labels.true_label);
+  if (labels.fall_through != labels.false_label) {
+    __ Jump(labels.false_label);
+  }
+}
+
+// Dart's Math.min/max on doubles (IEEE 754-2019 minimum/maximum, as ARM64's
+// fmin/fmax): NaN if either input is NaN; -0.0 < 0.0. With fcmpu and
+// branches (ABI-SPEC 7.7 (simple); xsmindp/xsmaxdp have other NaN rules).
+// |result| may alias neither input. Clobbers CR0 and TMP.
+static void EmitDoubleMinMax(FlowGraphCompiler* compiler,
+                             bool is_min,
+                             FpuRegister result,
+                             FpuRegister left,
+                             FpuRegister right) {
+  ASSERT(result != left && result != right);
+  compiler::Label done, take_left, take_right, equal, unordered;
+  __ fcmpu(CRF0, left, right);
+  __ BranchIfCR(true, CRF0, kCRBitSO, &unordered,
+                compiler::Assembler::kNearJump);
+  __ BranchIfCR(true, CRF0, kCRBitEQ, &equal, compiler::Assembler::kNearJump);
+  __ BranchIfCR(true, CRF0, is_min ? kCRBitGT : kCRBitLT, &take_right,
+                compiler::Assembler::kNearJump);
+  __ Bind(&take_left);
+  __ fmr(result, left);
+  __ Jump(&done, compiler::Assembler::kNearJump);
+
+  __ Bind(&take_right);
+  __ fmr(result, right);
+  __ Jump(&done, compiler::Assembler::kNearJump);
+
+  __ Bind(&unordered);
+  // NaN + x is a (quiet) NaN.
+  __ fadd(result, left, right);
+  __ Jump(&done, compiler::Assembler::kNearJump);
+
+  // Equal values are bit-identical unless they are zeros of different sign:
+  // min takes the negative one, max the positive one. Decide on the sign bit
+  // of left.
+  __ Bind(&equal);
+  __ mfvsrd(TMP, left);
+  __ CompareImmediate(TMP, 0);
+  __ BranchIf(is_min ? LT : GE, &take_left, compiler::Assembler::kNearJump);
+  __ Jump(&take_right, compiler::Assembler::kNearJump);
+
+  __ Bind(&done);
+}
+
+LocationSummary* BinaryDoubleOpInstr::MakeLocationSummary(Zone* zone,
+                                                          bool opt) const {
+  const intptr_t kNumInputs = 2;
+  const intptr_t kNumTemps = 0;
+  LocationSummary* summary = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  summary->set_in(0, Location::RequiresFpuRegister());
+  summary->set_in(1, Location::RequiresFpuRegister());
+  summary->set_out(0, Location::RequiresFpuRegister());
+  return summary;
+}
+
+void BinaryDoubleOpInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  const FpuRegister left = locs()->in(0).fpu_reg();
+  const FpuRegister right = locs()->in(1).fpu_reg();
+  const FpuRegister result = locs()->out(0).fpu_reg();
+  const bool is_double = representation() == kUnboxedDouble;
+  ASSERT(is_double || representation() == kUnboxedFloat);
+  switch (op_kind()) {
+    case Token::kADD:
+      if (is_double) {
+        __ fadd(result, left, right);
+      } else {
+        __ fadds(result, left, right);
+      }
+      break;
+    case Token::kSUB:
+      if (is_double) {
+        __ fsub(result, left, right);
+      } else {
+        __ fsubs(result, left, right);
+      }
+      break;
+    case Token::kMUL:
+      if (is_double) {
+        __ fmul(result, left, right);
+      } else {
+        __ fmuls(result, left, right);
+      }
+      break;
+    case Token::kDIV:
+      if (is_double) {
+        __ fdiv(result, left, right);
+      } else {
+        __ fdivs(result, left, right);
+      }
+      break;
+    case Token::kMIN:
+    case Token::kMAX: {
+      // Exact for floats too: the result is one of the (single) inputs or a
+      // NaN.
+      const FpuRegister out = (result == left || result == right) ? FpuTMP
+                                                                  : result;
+      EmitDoubleMinMax(compiler, op_kind() == Token::kMIN, out, left, right);
+      __ MoveUnboxedDouble(result, out);
+      break;
+    }
+    default:
+      UNREACHABLE();
+  }
+}
+
+LocationSummary* DoubleTestOpInstr::MakeLocationSummary(Zone* zone,
+                                                        bool opt) const {
+  const bool needs_temp = op_kind() != MethodRecognizer::kDouble_getIsNaN;
+  const intptr_t kNumInputs = 1;
+  const intptr_t kNumTemps = needs_temp ? 1 : 0;
+  LocationSummary* summary = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  summary->set_in(0, Location::RequiresFpuRegister());
+  if (needs_temp) {
+    summary->set_temp(0, Location::RequiresRegister());
+  }
+  summary->set_out(0, Location::RequiresRegister());
+  return summary;
+}
+
+Condition DoubleTestOpInstr::EmitConditionCode(FlowGraphCompiler* compiler,
+                                               BranchLabels labels) {
+  ASSERT(compiler->is_optimizing());
+  const FpuRegister value = locs()->in(0).fpu_reg();
+  const bool is_negated = kind() != Token::kEQ;
+
+  switch (op_kind()) {
+    case MethodRecognizer::kDouble_getIsNaN: {
+      // x != x exactly when x is NaN; NE is true on unordered.
+      __ DoubleCompare(value, value);
+      EmitDoubleBranch(compiler, is_negated ? EQ : NE, labels);
+      return kInvalidCondition;
+    }
+    case MethodRecognizer::kDouble_getIsInfinite: {
+      const Register temp = locs()->temp(0).reg();
+      __ mfvsrd(temp, value);
+      // Mask off the sign.
+      __ clrldi(temp, temp, 1);
+      // Compare with +infinity.
+      __ CompareImmediate(temp, 0x7FF0000000000000LL);
+      return is_negated ? NE : EQ;
+    }
+    case MethodRecognizer::kDouble_getIsNegative: {
+      const Register temp = locs()->temp(0).reg();
+      // NaN is not negative; -0.0 is.
+      __ DoubleCompare(value, value);
+      __ BranchIfDouble(NE, is_negated ? labels.true_label : labels.false_label);
+      __ mfvsrd(temp, value);
+      __ CompareImmediate(temp, 0);
+      return is_negated ? GE : LT;
+    }
+    default:
+      UNREACHABLE();
+  }
+}

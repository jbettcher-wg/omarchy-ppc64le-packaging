+LocationSummary* MathMinMaxInstr::MakeLocationSummary(Zone* zone,
+                                                      bool opt) const {
+  if (representation() == kUnboxedDouble) {
+    const intptr_t kNumInputs = 2;
+    const intptr_t kNumTemps = 0;
+    LocationSummary* summary = new (zone)
+        LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+    summary->set_in(0, Location::RequiresFpuRegister());
+    summary->set_in(1, Location::RequiresFpuRegister());
+    summary->set_out(0, Location::RequiresFpuRegister());
+    return summary;
+  }
+  ASSERT(representation() == kUnboxedInt64);
+  const intptr_t kNumInputs = 2;
+  const intptr_t kNumTemps = 0;
+  LocationSummary* summary = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  summary->set_in(0, Location::RequiresRegister());
+  summary->set_in(1, Location::RequiresRegister());
+  // Reuse the left register so that code can be made shorter.
+  summary->set_out(0, Location::SameAsFirstInput());
+  return summary;
+}
+
+void MathMinMaxInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  ASSERT((op_kind() == MethodRecognizer::kMathMin) ||
+         (op_kind() == MethodRecognizer::kMathMax));
+  const bool is_min = (op_kind() == MethodRecognizer::kMathMin);
+  if (representation() == kUnboxedDouble) {
+    const FpuRegister left = locs()->in(0).fpu_reg();
+    const FpuRegister right = locs()->in(1).fpu_reg();
+    const FpuRegister result = locs()->out(0).fpu_reg();
+    const FpuRegister out =
+        (result == left || result == right) ? FpuTMP : result;
+    EmitDoubleMinMax(compiler, is_min, out, left, right);
+    __ MoveUnboxedDouble(result, out);
+    return;
+  }
+
+  ASSERT(representation() == kUnboxedInt64);
+  const Register left = locs()->in(0).reg();
+  const Register right = locs()->in(1).reg();
+  const Register result = locs()->out(0).reg();
+  ASSERT(result == left);
+  compiler::Label done;
+  // min: keep left unless left > right; max: keep left unless left < right.
+  __ CompareRegisters(left, right);
+  __ BranchIf(is_min ? LE : GE, &done, compiler::Assembler::kNearJump);
+  __ MoveRegister(result, right);
+  __ Bind(&done);
+}
+
+LocationSummary* UnaryDoubleOpInstr::MakeLocationSummary(Zone* zone,
+                                                         bool opt) const {
+  const intptr_t kNumInputs = 1;
+  const intptr_t kNumTemps = 0;
+  LocationSummary* summary = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  summary->set_in(0, Location::RequiresFpuRegister());
+  summary->set_out(0, Location::RequiresFpuRegister());
+  return summary;
+}
+
+void UnaryDoubleOpInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  const FpuRegister result = locs()->out(0).fpu_reg();
+  const FpuRegister value = locs()->in(0).fpu_reg();
+  if (representation() == kUnboxedDouble) {
+    switch (op_kind()) {
+      case Token::kABS:
+        __ fabs(result, value);
+        break;
+      case Token::kNEGATE:
+        __ fneg(result, value);
+        break;
+      case Token::kSQRT:
+        __ fsqrt(result, value);
+        break;
+      case Token::kSQUARE:
+        __ fmul(result, value, value);
+        break;
+      case Token::kTRUNCATE:
+        __ friz(result, value);
+        break;
+      case Token::kFLOOR:
+        __ frim(result, value);
+        break;
+      case Token::kCEILING:
+        __ frip(result, value);
+        break;
+      default:
+        UNREACHABLE();
+    }
+  } else {
+    ASSERT(representation() == kUnboxedFloat);
+    switch (op_kind()) {
+      case Token::kABS:
+        __ fabs(result, value);
+        break;
+      case Token::kNEGATE:
+        __ fneg(result, value);
+        break;
+      case Token::kRECIPROCAL:
+        __ LoadDImmediate(FpuTMP, 1.0);
+        __ fdivs(result, FpuTMP, value);
+        break;
+      case Token::kRECIPROCAL_SQRT:
+        __ LoadDImmediate(FpuTMP, 1.0);
+        __ fdivs(result, FpuTMP, value);
+        __ fsqrts(result, result);
+        break;
+      case Token::kSQRT:
+        __ fsqrts(result, value);
+        break;
+      case Token::kSQUARE:
+        __ fmuls(result, value, value);
+        break;
+      // Rounding a single to an integral value yields a single.
+      case Token::kTRUNCATE:
+        __ friz(result, value);
+        break;
+      case Token::kFLOOR:
+        __ frim(result, value);
+        break;
+      case Token::kCEILING:
+        __ frip(result, value);
+        break;
+      default:
+        UNREACHABLE();
+    }
+  }
+}

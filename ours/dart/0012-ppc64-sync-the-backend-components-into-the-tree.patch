+++ b/runtime/vm/compiler/backend/il_ppc64_a.cc
@@ -240,28 +240,32 @@ void ConstantInstr::EmitMoveToLocation(FlowGraphCompiler* compiler,
         // No unboxed SIMD on ppc64 (ABI-SPEC 7.7).
         UNREACHABLE();
     }
-  } else if (destination.IsDoubleStackSlot()) {
-    ASSERT(representation() == kUnboxedDouble);
-    __ LoadDImmediate(FpuTMP, Double::Cast(value_).value());
+  } else if (destination.IsDoubleStackSlot() ||
+             (destination.IsStackSlot() &&
+              RepresentationUtils::IsUnboxedFloat(representation()))) {
+    // An FPR holds a double-format value (ABI-SPEC 7.7), and EmitMove spills
+    // and reloads FPRs with stfd/lfd in both double and word stack slots. So
+    // on ppc64 an unboxed float in a Dart stack slot is stored in DOUBLE
+    // format, not as ARM64's raw single bits in the low word (which only work
+    // there because S aliases the low half of D). One format everywhere.
+    if (representation() == kUnboxedFloat) {
+      __ LoadSImmediate(FpuTMP, Double::Cast(value_).value());
+    } else {
+      ASSERT(representation() == kUnboxedDouble);
+      __ LoadDImmediate(FpuTMP, Double::Cast(value_).value());
+    }
     const intptr_t dest_offset = destination.ToStackSlotOffset();
     __ StoreDToOffset(FpuTMP, destination.base_reg(), dest_offset);
   } else {
     ASSERT(destination.IsStackSlot());
     ASSERT(tmp != kNoRegister);
     const intptr_t dest_offset = destination.ToStackSlotOffset();
-    compiler::OperandSize operand_size = compiler::kWordBytes;
     if (RepresentationUtils::IsUnboxedInteger(representation())) {

+// ---------------------------------------------------------------------------
+// FFI: calls into C, callbacks from C (ABI-SPEC 3.5, 4.2, 7.6;
+// STUBS-SPEC 3, 4).
+// ---------------------------------------------------------------------------
+
+// The operand size that canonicalises a narrow integer of |type| to the
+// 32-in-64 invariant (ABI-SPEC 7.6), or kEightBytes if |type| needs nothing.
+static compiler::OperandSize NarrowIntegerOperandSize(
+    const compiler::ffi::NativeType& type) {
+  if (!type.IsInt()) return compiler::kEightBytes;
+  const bool is_signed = type.IsSigned();
+  switch (type.SizeInBytes()) {
+    case 1:
+      return is_signed ? compiler::kByte : compiler::kUnsignedByte;
+    case 2:
+      return is_signed ? compiler::kTwoBytes : compiler::kUnsignedTwoBytes;
+    case 4:
+      return is_signed ? compiler::kFourBytes : compiler::kUnsignedFourBytes;
+    default:
+      return compiler::kEightBytes;
+  }

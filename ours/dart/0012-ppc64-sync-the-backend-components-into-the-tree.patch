+// shared assembler_test.cc checks ("on all architectures, the result is
+// zero-extended for non-word-sized sz"; ARM64's W-register AND). An int32
+// consumer that needs the sign-extended form (ABI-SPEC 7.6) adds extsw. Or
+// and Xor have no such shared contract and canonicalise by size.
 void Assembler::AndImmediate(Register dst,
                              Register src,
                              int64_t imm,
@@ -597,12 +602,11 @@ void Assembler::AndImmediate(Register dst,
   if (sz != kEightBytes) {
     ASSERT(Utils::IsInt(32, imm) || Utils::IsUint(32, imm));
     const uint64_t mask = static_cast<uint32_t>(imm);
-    // Every form below yields a zero-extended result: andi./andis. and
+    // Every form below yields the zero-extended result: andi./andis. and
     // rlwinm (MB <= ME) clear the upper word, and the mask in R0 is
     // zero-extended.
     if (mask == 0) {
       li(dst, 0);
-      return;
     } else if (IsUint16(mask)) {
       andi_(dst, src, mask);
     } else if ((mask & 0xffff) == 0) {
@@ -614,10 +618,6 @@ void Assembler::AndImmediate(Register dst,
       LoadImmediate(R0, mask);
       and_(dst, src, R0);
     }
-    // An int32 result whose bit 31 may be set must be sign-extended.
-    if ((sz == kFourBytes) && ((mask & 0x80000000u) != 0)) {
-      extsw(dst, dst);
-    }
     return;
   }
 

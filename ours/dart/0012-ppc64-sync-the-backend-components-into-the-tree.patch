       const bool ok = compiler::HasIntegerValue(value_, &v);
       RELEASE_ASSERT(ok);
       // There is no zero register: zero is an li like any other value.
       __ LoadImmediate(tmp, CanonicalIntegerConstant(representation(), v));
-    } else if (representation() == kUnboxedFloat) {
-      // The raw single bits, as on ARM64 and RISC-V; read back with lfs.
-      const int32_t float_bits =
-          bit_cast<int32_t, float>(Double::Cast(value_).value());
-      __ LoadImmediate(tmp, float_bits);
-      operand_size = compiler::kFourBytes;
     } else {
       ASSERT(representation() == kTagged);
       if (value_.IsNull()) {
@@ -270,7 +274,7 @@ void ConstantInstr::EmitMoveToLocation(FlowGraphCompiler* compiler,
         __ LoadObject(tmp, value_);
       }

+LocationSummary* DoubleToIntegerInstr::MakeLocationSummary(Zone* zone,
+                                                           bool opt) const {
+  const intptr_t kNumInputs = 1;
+  const intptr_t kNumTemps = 0;
+  LocationSummary* result = new (zone) LocationSummary(
+      zone, kNumInputs, kNumTemps, LocationSummary::kCallOnSlowPath);
+  result->set_in(0, Location::RequiresFpuRegister());
+  result->set_out(0, Location::RequiresRegister());
+  return result;
+}
+
+void DoubleToIntegerInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  const Register result = locs()->out(0).reg();
+  const FpuRegister value_double = locs()->in(0).fpu_reg();
+
+  DoubleToIntegerSlowPath* slow_path =
+      new DoubleToIntegerSlowPath(this, value_double);
+  compiler->AddSlowPathCode(slow_path);
+
+  // DoubleToInt64 is fctidz (truncate) and saturates: NaN and -overflow give
+  // INT64_MIN, +overflow INT64_MAX. None of them survives the Smi round trip
+  // below, so all three take the slow path, which implements Dart's
+  // semantics; saturation is never the result.
+  switch (recognized_kind()) {
+    case MethodRecognizer::kDoubleToInteger:
+      __ DoubleToInt64(TMP, value_double);
+      break;
+    case MethodRecognizer::kDoubleFloorToInt:
+      __ frim(FpuTMP, value_double);
+      __ DoubleToInt64(TMP, FpuTMP);
+      break;
+    case MethodRecognizer::kDoubleCeilToInt:
+      __ frip(FpuTMP, value_double);
+      __ DoubleToInt64(TMP, FpuTMP);
+      break;
+    default:
+      UNREACHABLE();
+  }
+
+  // Check for overflow and that it fits into Smi.
+  __ SmiTag(result, TMP);
+  __ SmiUntag(TMP2, result);
+  __ CompareRegisters(TMP, TMP2);
+  __ BranchIf(NE, slow_path->entry_label());
+  __ Bind(slow_path->exit_label());
+}
+
+LocationSummary* DoubleToSmiInstr::MakeLocationSummary(Zone* zone,
+                                                       bool opt) const {
+  const intptr_t kNumInputs = 1;
+  const intptr_t kNumTemps = 0;
+  LocationSummary* result = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  result->set_in(0, Location::RequiresFpuRegister());
+  result->set_out(0, Location::RequiresRegister());

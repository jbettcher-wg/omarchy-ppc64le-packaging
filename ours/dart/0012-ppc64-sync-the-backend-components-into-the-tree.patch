+// Should be kept in sync with integers.cc Multiply64Hash (and with
+// il_riscv.cc's 64-bit EmitHashIntegerCodeSequence).
+static void EmitHashIntegerCodeSequence(FlowGraphCompiler* compiler,
+                                        const Register value,
+                                        const Register result) {
+  ASSERT(value != TMP);
+  ASSERT(result != TMP);
+  ASSERT(result != value);
+  __ LoadImmediate(TMP, 0x2d51);
+  __ mulld(result, TMP, value);   // low 64 bits of value * 0x2d51
+  __ mulhdu(TMP, TMP, value);     // high 64 bits (unsigned)
+  __ xor_(result, result, TMP);
+  __ sradi(TMP, result, 32);
+  __ xor_(result, result, TMP);
+  __ AndImmediate(result, result, 0x3fffffff);
+}
+
+LocationSummary* HashDoubleOpInstr::MakeLocationSummary(Zone* zone,
+                                                        bool opt) const {
+  const intptr_t kNumInputs = 1;
+  const intptr_t kNumTemps = 3;
+  LocationSummary* summary = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+
+  summary->set_in(0, Location::RequiresFpuRegister());
+  summary->set_temp(0, Location::RequiresRegister());
+  summary->set_temp(1, Location::RequiresRegister());
+  summary->set_temp(2, Location::RequiresFpuRegister());
+  summary->set_out(0, Location::RequiresRegister());
+  return summary;
+}
+
+// As il_riscv.cc (64-bit): a double that converts to int64 and back exactly
+// hashes as that integer; every other one (non-integral, NaN, infinite) as
+// the xor of its two words. No runtime call: that path of the template is
+// unreachable at 64 bits.
+void HashDoubleOpInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  const FpuRegister value = locs()->in(0).fpu_reg();
+  const Register result = locs()->out(0).reg();
+  const Register temp = locs()->temp(0).reg();
+  const Register temp1 = locs()->temp(1).reg();
+  const FpuRegister temp_double = locs()->temp(2).fpu_reg();
+
+  compiler::Label hash_double_value, done;
+  __ DoubleToInt64(temp1, value);  // Saturates; NaN gives INT64_MIN.
+  __ Int64ToDouble(temp_double, temp1);
+  __ DoubleCompare(value, temp_double);
+  // NE is also taken for NaN and for an infinity (saturated, so unequal).
+  __ BranchIfDouble(NE, &hash_double_value);
+
+  // integer hash of temp1
+  EmitHashIntegerCodeSequence(compiler, temp1, result);
+  __ Jump(&done);
+
+  // double hi/lo words are in (temp:temp1)
+  __ Bind(&hash_double_value);
+  __ mfvsrd(temp1, value);
+  __ srdi(temp, temp1, 32);
+  __ xor_(result, temp1, temp);
+  __ AndImmediate(result, result, compiler::target::kSmiMax);
+
+  __ Bind(&done);
+}

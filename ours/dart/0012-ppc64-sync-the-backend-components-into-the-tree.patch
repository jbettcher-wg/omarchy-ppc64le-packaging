--- a/runtime/vm/compiler/assembler/assembler_ppc64.cc
+++ b/runtime/vm/compiler/assembler/assembler_ppc64.cc
@@ -294,9 +294,12 @@ void Assembler::PushImmediate(int64_t immediate) {
 // There are two chains, so that a link never has to span more than its own
 // field can hold:
 //   * 24-bit b (Jump, and the b of the 8-byte far conditional form) through
-//     Label::position_ (the generic Label's link);
-//   * 4-byte bc through Label::unresolved_near_positions_[0] (the generic
-//     Label's near slot, which x64 uses the same way).
+//     Label::unresolved_b_;
+//   * 4-byte bc through Label::unresolved_bc_.
+// Both are fields of ppc64's own Label (assembler_base.h, mirroring RISC-V's),
+// whose IsLinked() is true while either chain is non-empty. The generic Label
+// cannot be used: its IsLinked() looks only at the b link, so a label reached
+// only by a bc would read as unlinked and shared code would skip its Bind.
 // A near link that does not fit 14 bits means the earlier near use cannot
 // reach any target after this one either: that is the far-branch bailout.
 // ---------------------------------------------------------------------------
@@ -347,14 +350,16 @@ void Assembler::PatchBranch(intptr_t position, intptr_t target_position) {
 void Assembler::Bind(Label* label) {
   ASSERT(!label->IsBound());
   const intptr_t bound_pc = CodeSize();
-  while (label->IsLinked()) {
-    const intptr_t position = label->LinkPosition();
+  // The b chain (ppc64 Label, assembler_base.h).
+  while (label->unresolved_b_ != -1) {
+    const intptr_t position = label->unresolved_b_;
     const int32_t link = DecodeLI(Read32(position));
     PatchBranch(position, bound_pc);  // FATAL beyond +/-32 MiB
-    label->position_ = (link == 0) ? 0 : position + link + Label::kBias;
+    label->unresolved_b_ = (link == 0) ? -1 : position + link;
   }
-  while (label->HasNear()) {
-    const intptr_t position = label->unresolved_near_positions_[0];
+  // The bc chain.
+  while (label->unresolved_bc_ != -1) {
+    const intptr_t position = label->unresolved_bc_;
     const int32_t link = DecodeBD(Read32(position));
     if (!IsBranch14Offset(bound_pc - position)) {
       if (far_branch_level() == 0) {
@@ -363,11 +368,7 @@ void Assembler::Bind(Label* label) {
       FATAL("ppc64: near conditional branch out of range");  // kNearJump
     }
     PatchBranch(position, bound_pc);
-    if (link == 0) {
-      label->unresolved_ = 0;
-    } else {
-      label->unresolved_near_positions_[0] = position + link;
-    }
+    label->unresolved_bc_ = (link == 0) ? -1 : position + link;
   }
   label->BindTo(bound_pc);
 }
@@ -379,8 +380,8 @@ void Assembler::Jump(Label* label, JumpDistance distance) {
     return;
   }
   const intptr_t position = CodeSize();
-  b(label->IsLinked() ? label->LinkPosition() - position : 0);
-  label->LinkTo(position);
+  b(label->unresolved_b_ != -1 ? label->unresolved_b_ - position : 0);
+  label->unresolved_b_ = position;
 }
 
 void Assembler::Jump(const Address& address) {
@@ -412,8 +413,8 @@ void Assembler::BranchIfCR(bool if_set,
   const intptr_t position = CodeSize();
   if (distance == kNearJump || far_branch_level() == 0) {
     int64_t link = 0;
-    if (label->HasNear()) {
-      link = label->unresolved_near_positions_[0] - position;
+    if (label->unresolved_bc_ != -1) {
+      link = label->unresolved_bc_ - position;
       if (!IsBranch14Offset(link)) {
         // The previous near use is already out of reach of any target.
         if (far_branch_level() == 0) {
@@ -423,15 +424,14 @@ void Assembler::BranchIfCR(bool if_set,
       }
     }
     bc(bo, bi, link);
-    label->unresolved_near_positions_[0] = position;
-    label->unresolved_ = 1;
+    label->unresolved_bc_ = position;
     return;
   }
   // Far form: bc <inverted>,$+8 ; b target. The b carries the link.
   bc(InvertBranchOption(bo), bi, 2 * Instr::kInstrSize);
   const intptr_t b_position = CodeSize();
-  b(label->IsLinked() ? label->LinkPosition() - b_position : 0);
-  label->LinkTo(b_position);
+  b(label->unresolved_b_ != -1 ? label->unresolved_b_ - b_position : 0);
+  label->unresolved_b_ = b_position;
 }
 

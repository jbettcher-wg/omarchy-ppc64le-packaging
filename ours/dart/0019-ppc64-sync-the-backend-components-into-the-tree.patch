+  EXPECT_EQ(kMinInt64, CallID(d2i, nan));
+  EXPECT_EQ(kMaxInt64, CallID(d2i, 1e19));
+  EXPECT_EQ(kMinInt64, CallID(d2i, -1e19));
+  EXPECT_EQ(-1, CallID(d2i, -1.9));
+  EXPECT_EQ(0, CallID(d2i, -0.0));
+  const uword i2d =
+      GenerateEntry("Int64ToDouble", [](Assembler* a) { a->Int64ToDouble(F1, R3); });
+  for (uint64_t v : kValues) {
+    EXPECT_EQ(Bits(static_cast<double>(static_cast<int64_t>(v))),

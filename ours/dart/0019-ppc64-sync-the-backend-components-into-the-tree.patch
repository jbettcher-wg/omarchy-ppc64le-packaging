+        store_size = a->CodeSize();
+      });
+      EXPECT_EQ(Assembler::MemoryAccessLength(off, sz, /*is_store=*/false) *
+                    Instr::kInstrSize,
+                load_size);
+      EXPECT_EQ(Assembler::MemoryAccessLength(off, sz, /*is_store=*/true) *
+                    Instr::kInstrSize,
+                store_size);
+      for (uint64_t v : kValues) {
+        memset(base + off - 8, 0x5a, n + 16);
+        Call(store, v, reinterpret_cast<int64_t>(base));
+        uint64_t raw = 0;
+        memcpy(&raw, base + off, n);
+        const uint64_t mask = n == 8 ? ~uint64_t{0} : (uint64_t{1} << (8 * n)) - 1;
+        EXPECT_EQ(v & mask, raw);
+        EXPECT_EQ(0x5a, base[off - 1]);
+        EXPECT_EQ(0x5a, base[off + n]);
+        uint64_t want = raw;
+        if (sz == kFourBytes) want = SExt32(raw);
+        if (sz == kTwoBytes) want = static_cast<int64_t>(static_cast<int16_t>(raw));
+        if (sz == kByte) want = static_cast<int64_t>(static_cast<int8_t>(raw));
+        EXPECT_EQ(static_cast<int64_t>(want),
+                  Call(load, 0, reinterpret_cast<int64_t>(base)));
+      }
+    }
+  }
+  // StoreZero, and an indexed Address (base + index register).
+  const uword zero = GenerateEntry("StoreZero", [](Assembler* a) {
+    a->StoreZero(Address(R3, 16));
+    a->StoreZero(Address(R3, 0x12340));
+  });
+  const uword indexed = GenerateEntry("Indexed", [](Assembler* a) {
+    a->Load(R3, Address(R3, R4));
+  });
+  memset(base, 0xff, 32);
+  memset(base + 0x12340, 0xff, 8);
+  Call(zero, reinterpret_cast<int64_t>(base));
+  uint64_t w0, w1;
+  memcpy(&w0, base + 16, 8);
+  memcpy(&w1, base + 0x12340, 8);
+  EXPECT_EQ(0u, w0);
+  EXPECT_EQ(0u, w1);
+  const uint64_t marker = 0x1122334455667788ull;
+  memcpy(base + 24, &marker, 8);
+  EXPECT_EQ(static_cast<int64_t>(marker),
+            Call(indexed, reinterpret_cast<int64_t>(base), 24));
+}

+// Element addressing on a real Array and TypedData (5.3).
+ASSEMBLER_TEST_GENERATE(ElementAddress, assembler) {
+  EnterTestFrame(assembler);
+  // Called as f(code, thread, array, smi_index).
+  __ LoadIndexedPayload(R7, R5, target::Array::data_offset(), R6,
+                        TIMES_HALF_WORD_SIZE);
+  const Address element = __ ElementAddressForRegIndex(
+      /*is_external=*/false, kArrayCid, target::kWordSize,
+      /*index_unboxed=*/false, R5, R6, R8);
+  __ Load(R9, element);
+  __ CompareRegisters(R7, R9);
+  Label fail, done;
+  __ BranchIf(NE, &fail);
+  __ ComputeElementAddressForRegIndex(R10, false, kArrayCid, target::kWordSize,
+                                      false, R5, R6);
+  __ Load(R9, Address(R10, 0));
+  __ CompareRegisters(R7, R9);
+  __ BranchIf(NE, &fail);
+  __ MoveRegister(R3, R7);
+  __ Jump(&done);
+  __ Bind(&fail);
+  __ LoadImmediate(R3, 0);
+  __ Bind(&done);
+  LeaveTestFrame(assembler);
+  __ Ret();
+}

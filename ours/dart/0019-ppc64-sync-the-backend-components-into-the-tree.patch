+  EnterTestFrame(assembler);
+  __ LoadIsolate(R5);
+  __ LoadIsolateGroup(R6);
+  __ MoveRegister(R3, R5);
+  __ xor_(R3, R3, R6);  // isolate ^ group, checked by the runner
+  LeaveTestFrame(assembler);
+  __ Ret();

+// The registers the [vm] tests need, saved and set as on ARM64 / RISC-V:
+// entered as f(CodePtr code, Thread* thread) by InvokeWithCodeAndThread.
+// THR, CODE_REG, PP, NULL_REG and WRITE_BARRIER_STATE are ELFv2 non-volatile
+// (r29, r28, r30, r26, r27), so they are saved; EnterFrame saves LR.
+void EnterTestFrame(Assembler* assembler) {
+  __ EnterFrame(0);
+  __ PushRegister(CODE_REG);
+  __ PushRegister(THR);
+  __ PushRegister(WRITE_BARRIER_STATE);
+  __ PushRegister(NULL_REG);
+  __ PushRegister(PP);
+  __ MoveRegister(CODE_REG, R3);
+  __ MoveRegister(THR, R4);
+  __ RestorePinnedRegisters();  // NULL_REG, WRITE_BARRIER_STATE
+  __ LoadPoolPointer(PP);
+}
+
+void LeaveTestFrame(Assembler* assembler) {
+  __ PopRegister(PP);
+  __ PopRegister(NULL_REG);
+  __ PopRegister(WRITE_BARRIER_STATE);
+  __ PopRegister(THR);
+  __ PopRegister(CODE_REG);
+  __ LeaveFrame();
+}
+
+// Called from assembler_test.cc as f(value, growable_array, thread).
+ASSEMBLER_TEST_GENERATE(StoreIntoObject, assembler) {
+  __ PushLinkRegister();
+  __ PushNativeCalleeSavedRegisters();
+  __ MoveRegister(THR, R5);
+  __ RestorePinnedRegisters();  // WRITE_BARRIER_STATE
+  __ StoreIntoObject(R4, FieldAddress(R4, GrowableObjectArray::data_offset()),
+                     R3);
+  __ PopNativeCalleeSavedRegisters();
+  __ PopLinkRegister();
+  __ Ret();
+}

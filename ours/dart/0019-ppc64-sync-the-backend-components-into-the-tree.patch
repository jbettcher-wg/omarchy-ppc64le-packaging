+  const uword r2f = GenerateEntry("RegisterToFloatBits",
+                                  [](Assembler* a) { a->RegisterToFloatBits(F1, R3); });
+  for (float f : {0.0f, -0.0f, 1.5f, 0.1f, 3.4028235e38f,

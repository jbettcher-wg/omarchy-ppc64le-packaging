+static bool Holds(Condition c, int64_t a, int64_t b, OperandSize width) {
+  if (width != kEightBytes) {
+    a = static_cast<int32_t>(a);
+    b = static_cast<int32_t>(b);
+  }
+  const uint64_t ua = width == kEightBytes ? static_cast<uint64_t>(a)
+                                           : static_cast<uint32_t>(a);
+  const uint64_t ub = width == kEightBytes ? static_cast<uint64_t>(b)
+                                           : static_cast<uint32_t>(b);
+  switch (c) {
+    case EQ: return a == b;
+    case NE: return a != b;
+    case LT: return a < b;
+    case GE: return a >= b;
+    case GT: return a > b;
+    case LE: return a <= b;
+    case CC: return ua < ub;
+    case CS: return ua >= ub;
+    case HI: return ua > ub;
+    case LS: return ua <= ub;
+    default: UNREACHABLE();
+  }
+}

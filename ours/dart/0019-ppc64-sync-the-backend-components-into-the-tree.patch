+    const intptr_t n = Assembler::OperandSizeInBits(sz) / 8;
+    for (int32_t off : offsets) {
+      intptr_t load_size = 0, store_size = 0;
+      const uword load = GenerateEntry("Load", [&](Assembler* a) {

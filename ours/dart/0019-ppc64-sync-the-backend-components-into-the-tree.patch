+// Shifts (7.6): immediates at every count; LslRegister gives 0 for any
+// count >= 64 (Dart semantics, Amendment A3), where sld alone wraps at 128.
+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_Shifts) {
+  for (OperandSize sz : {kEightBytes, kFourBytes, kUnsignedFourBytes}) {
+    const int bits = sz == kEightBytes ? 64 : 32;
+    for (int shift : {0, 1, 7, 15, 16, 31, 32, 52, 63}) {
+      if (shift >= bits) continue;
+      const uword lsl = GenerateEntry("LslImmediate", [&](Assembler* a) {
+        a->LslImmediate(R3, R4, shift, sz);
+      });
+      for (uint64_t v : kValues) {
+        const uint64_t want =
+            sz == kEightBytes ? (v << shift)
+                              : Extend(static_cast<uint32_t>(v) << shift, sz);
+        EXPECT_EQ(static_cast<int64_t>(want), Call(lsl, 0, v));
+      }
+    }
+  }
+  for (int shift : {0, 1, 31, 32, 63}) {
+    const uword lsr =
+        GenerateEntry("LsrImmediate", [&](Assembler* a) { a->LsrImmediate(R3, shift); });
+    const uword asr = GenerateEntry("ASR", [&](Assembler* a) {
+      a->ArithmeticShiftRightImmediate(R3, R4, shift);
+    });
+    for (uint64_t v : kValues) {
+      EXPECT_EQ(static_cast<int64_t>(v >> shift), Call(lsr, v));
+      EXPECT_EQ(static_cast<int64_t>(v) >> shift, Call(asr, 0, v));
+    }
+  }
+  const uword lsl_reg =
+      GenerateEntry("LslRegister", [](Assembler* a) { a->LslRegister(R3, R4); });
+  for (uint64_t v : kValues) {
+    for (uint64_t n : {0ull, 1ull, 31ull, 32ull, 63ull, 64ull, 65ull, 127ull,
+                       128ull, 129ull, 0xffffffffffffffffull}) {
+      EXPECT_EQ(static_cast<int64_t>(n < 64 ? (v << n) : 0), Call(lsl_reg, v, n));
+    }

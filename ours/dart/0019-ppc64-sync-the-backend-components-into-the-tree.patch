+                          static_cast<int64_t>(0xffffffffffff0000ull),
+                          0x0123456789abcdef};
+  for (OperandSize sz : {kEightBytes, kFourBytes, kUnsignedFourBytes}) {
+    for (int64_t imm : imms) {
+      if (sz != kEightBytes && !Utils::IsInt(32, imm) && !Utils::IsUint(32, imm)) {
+        continue;
+      }
+      const uword and_imm = GenerateEntry("AndImmediate", [&](Assembler* a) {
+        a->AndImmediate(R3, R4, imm, sz);
+      });
+      const uword or_imm = GenerateEntry("OrImmediate", [&](Assembler* a) {
+        a->OrImmediate(R3, R4, imm, sz);
+      });
+      const uword xor_imm = GenerateEntry("XorImmediate", [&](Assembler* a) {
+        a->XorImmediate(R3, R4, imm, sz);
+      });
+      for (uint64_t x : kValues) {

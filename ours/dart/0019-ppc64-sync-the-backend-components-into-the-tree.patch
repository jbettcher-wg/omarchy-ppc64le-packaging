+// A fresh anonymous page that has only been read maps the shared zero page;
+// the first stcx. takes a copy-on-write fault and loses the reservation, so
+// a single larx/stcx. attempt fails there deterministically [MEASURED M1:
+// 0/1000]. CompareAndSwap and AtomicFetchAndOp retry and must succeed. The
+// single-shot control must fail, or the test proves nothing.
+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_FreshPageCAS) {
+  const uword single_shot = GenerateEntry("single-shot", [](Assembler* a) {
+    a->ldarx(R7, kNoRegister, R3);
+    a->stdcx_(R4, kNoRegister, R3);
+    a->mfocrf(R3, CRF0);
+    a->rlwinm(R3, R3, 3, 31, 31);  // CR0[EQ]: 1 = stored
+  });
+  const uword strong = GenerateEntry("CompareAndSwap", [](Assembler* a) {
+    a->LoadImmediate(R5, 0);
+    a->CompareAndSwap(R3, R5, R4, R7, nullptr);
+    a->mfocrf(R3, CRF0);
+    a->rlwinm(R3, R3, 3, 31, 31);
+  });
+  const uword fetch_or = GenerateEntry("AtomicFetchAndOp", [](Assembler* a) {
+    a->AtomicFetchAndOp(Assembler::kAtomicOr, R3, R4, R7);
+    a->MoveRegister(R3, R7);
+  });
+  const intptr_t page = VirtualMemory::PageSize();
+  intptr_t single_ok = 0, strong_ok = 0, fetch_ok = 0;
+  const intptr_t kTrials = 100;
+  for (intptr_t i = 0; i < kTrials; i++) {
+    for (int which = 0; which < 3; which++) {
+      void* p = mmap(nullptr, page, PROT_READ | PROT_WRITE,
+                     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+      RELEASE_ASSERT(p != MAP_FAILED);
+      (void)*static_cast<volatile uint64_t*>(p);  // read-only touch
+      const int64_t addr = reinterpret_cast<int64_t>(p);
+      if (which == 0) single_ok += Call(single_shot, addr, 42);
+      if (which == 1) {
+        strong_ok += Call(strong, addr, 42) == 1 &&
+                     *static_cast<uint64_t*>(p) == 42;
+      }
+      if (which == 2) {
+        fetch_ok += Call(fetch_or, addr, 5) == 0 && *static_cast<uint64_t*>(p) == 5;
+      }
+      munmap(p, page);
+    }
+  }
+  EXPECT_EQ(0, single_ok);  // the control
+  EXPECT_EQ(kTrials, strong_ok);
+  EXPECT_EQ(kTrials, fetch_ok);
+}

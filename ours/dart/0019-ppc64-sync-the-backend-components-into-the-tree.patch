+// A Dart function that writes every register Dart code may write: all the
+// allocatable GPRs (CODE_REG included), every FPR (f14-f31 are
+// allocatable and ELFv2 non-volatile), then returns null.
+static void GenerateClobberEverything(compiler::Assembler* assembler) {
+  __ EnterDartFrame(0);
+  for (intptr_t r = 0; r < kNumberOfCpuRegisters; r++) {
+    if ((kDartAvailableCpuRegs & (1 << r)) != 0) {
+      __ LoadImmediate(static_cast<Register>(r), 0x6c6f62626572ll + r);
+    }
+  }
+  for (intptr_t f = 0; f < kNumberOfFpuRegisters; f++) {
+    __ LoadDImmediate(static_cast<FpuRegister>(f), -1.5 * (f + 1));
+  }
+  __ LoadObject(R3, Object::null_object());
+  __ LeaveDartFrame();
+  __ Ret();
+}

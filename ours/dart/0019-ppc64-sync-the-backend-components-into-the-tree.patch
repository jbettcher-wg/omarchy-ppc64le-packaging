+static uint64_t Extend(uint64_t x, OperandSize sz) {
+  switch (sz) {
+    case kEightBytes: return x;
+    case kFourBytes: return SExt32(x);
+    case kUnsignedFourBytes: return static_cast<uint32_t>(x);
+    case kTwoBytes: return static_cast<int64_t>(static_cast<int16_t>(x));
+    case kUnsignedTwoBytes: return static_cast<uint16_t>(x);
+    case kByte: return static_cast<int64_t>(static_cast<int8_t>(x));
+    case kUnsignedByte: return static_cast<uint8_t>(x);
+    default: UNREACHABLE();
+  }
+}

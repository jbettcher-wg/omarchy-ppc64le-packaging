+// The 32-in-64 invariant at a C boundary (7.6): a foreign callee may return
+// an int32 with a dirty upper word; the result is re-canonicalised on
+// arrival. Loads produce canonical values on their own.
+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_Int32Canonical) {
+  const uword dirty = GenerateEntry("C result", [](Assembler* a) {
+    a->EnterCFrame(0);
+    a->CallCFunction(R3);
+    a->LeaveCFrame();
+  });
+  EXPECT_EQ(static_cast<int64_t>(0xdeadbeef80000001ull),
+            Call(dirty, reinterpret_cast<int64_t>(&ppc64_dirty_int32_result)));
+  const uword canonical = GenerateEntry("C result, canonical", [](Assembler* a) {
+    a->EnterCFrame(0);
+    a->CallCFunction(R3);
+    a->LeaveCFrame();
+    a->ExtendValue(R3, R3, kFourBytes);
+  });
+  EXPECT_EQ(static_cast<int64_t>(0xffffffff80000001ull),
+            Call(canonical, reinterpret_cast<int64_t>(&ppc64_dirty_int32_result)));
+  const uword unsigned_canonical = GenerateEntry("C result, uint32", [](Assembler* a) {
+    a->EnterCFrame(0);
+    a->CallCFunction(R3);
+    a->LeaveCFrame();
+    a->ExtendValue(R3, R3, kUnsignedFourBytes);
+  });
+  EXPECT_EQ(0x80000001,
+            Call(unsigned_canonical,
+                 reinterpret_cast<int64_t>(&ppc64_dirty_int32_result)));
+  int32_t m = -2;
+  const uword lwa = GenerateEntry("Load int32", [](Assembler* a) {
+    a->Load(R3, Address(R3, 0), kFourBytes);
+  });
+  const uword lwz = GenerateEntry("Load uint32", [](Assembler* a) {
+    a->Load(R3, Address(R3, 0), kUnsignedFourBytes);
+  });
+  EXPECT_EQ(-2, Call(lwa, reinterpret_cast<int64_t>(&m)));
+  EXPECT_EQ(0xfffffffe, Call(lwz, reinterpret_cast<int64_t>(&m)));
+}

+uint64_t Ppc64GprSentinel(intptr_t reg) {
+  return 0x5e710000ull + reg * 0x101;
+}
+uint64_t Ppc64FprSentinel(intptr_t reg) {
+  return (0x40f00000ull << 32) | reg;
+}
+// CR2 = 0xa, CR3 = 0x5, CR4 = 0xc (bits 23..12 of the mfcr image).
+constexpr uint64_t kPpc64CrSentinel = 0x00a5c000;
+constexpr uint64_t kPpc64CalleeSavedCrMask = 0x00fff000;
+
+// Checks an out[] filled by ppc64_sentinel_call: every callee-saved GPR, FPR
+// and CR field came back, and r2 is unchanged.
+void Ppc64ExpectCalleeSavedIntact(const uint64_t* out) {
+  for (intptr_t r = 14; r <= 31; r++) {
+    EXPECT_EQ(Ppc64GprSentinel(r), out[r - 14]);
+  }
+  for (intptr_t f = 14; f <= 31; f++) {
+    EXPECT_EQ(Ppc64FprSentinel(f), out[18 + f - 14]);
+  }
+  EXPECT_EQ(kPpc64CrSentinel, out[36] & kPpc64CalleeSavedCrMask);
+  EXPECT_EQ(out[38], out[37]);
+}

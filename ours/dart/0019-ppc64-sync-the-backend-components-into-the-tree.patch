+  __ LoadImmediate(R4, 0);
+  __ Bind(&start);
+  __ AddImmediate(R4, R4, 1);
+  __ CompareImmediate(R4, 3);
+  __ BranchIf(EQ, &done);
+  for (intptr_t i = 0; i < 9000; i++) {
+    __ nop();
+  }
+  __ CompareImmediate(R4, 3);
+  __ BranchIf(LT, &start);
+  __ Bind(&done);
+  __ MoveRegister(R3, R4);
+  __ Ret();

+// LoadImmediate (6.1), including every value in [0x7fff8000, 0x7fffffff]
+// in steps of 0x1000 (the lis sign-extension edge); LoadImmediateLength must
+// agree with what is emitted.
+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_LoadImmediate) {
+  std::vector<int64_t> values = {0,
+                                 1,
+                                 -1,
+                                 0x7fff,
+                                 0x8000,
+                                 -0x8000,
+                                 -0x8001,
+                                 0xffff,
+                                 0x10000,
+                                 0x7fffffff,
+                                 0x80000000,
+                                 0xffffffff,
+                                 0x100000000,
+                                 -0x80000000ll,
+                                 -0x80000001ll,
+                                 0x0123456789abcdef,
+                                 kMaxInt64,
+                                 kMinInt64,
+                                 static_cast<int64_t>(0x9287436598237465)};
+  for (int64_t v = 0x7fff8000; v <= 0x7fffffff; v += 0x1000) {
+    values.push_back(v);
+  }
+  for (int64_t v : values) {
+    intptr_t size = 0;
+    const uword entry = GenerateEntry("LoadImmediate", [&](Assembler* a) {
+      a->LoadImmediate(R3, v);
+      size = a->CodeSize();
+    });
+    EXPECT_EQ(v, Call(entry));
+    EXPECT_EQ(Assembler::LoadImmediateLength(v) * Instr::kInstrSize, size);
+  }
+}

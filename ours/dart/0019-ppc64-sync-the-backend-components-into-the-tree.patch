+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_FloatingPoint) {
+  alignas(16) static uint8_t buffer[0x30000];
+  uint8_t* base = buffer + 0x18000;
+  const double doubles[] = {0.0,  -0.0, 1.0,   0.1, 1e300, -1e300, 1e-50,
+                            1.401298464324817e-45, 3.4028235677973366e38,
+                            std::numeric_limits<double>::infinity(),
+                            std::numeric_limits<double>::quiet_NaN(),
+                            std::numeric_limits<double>::denorm_min()};
+  for (int32_t off : {0, 8, -8, 32760, 32768, -32776, 0x12340}) {
+    const uword load_d = GenerateEntry("LoadDFromOffset", [&](Assembler* a) {
+      a->LoadDFromOffset(F1, R3, off);
+    });
+    const uword store_d = GenerateEntry("StoreDToOffset", [&](Assembler* a) {
+      a->StoreDToOffset(F1, R3, off);
+    });
+    const uword store_s = GenerateEntry("StoreSToOffset", [&](Assembler* a) {
+      a->StoreSToOffset(F1, R3, off);
+    });
+    const uword load_s = GenerateEntry("LoadSFromOffset", [&](Assembler* a) {
+      a->LoadSFromOffset(F1, R3, off);
+    });
+    for (double d : doubles) {
+      CallVPD(store_d, base, d);
+      EXPECT_EQ(Bits(d), Bits(CallDP(load_d, base)));
+      // stfs alone would truncate (0.1 -> 0x3dcccccc, 1e300 finite): frsp.
+      CallVPD(store_s, base, d);
+      uint32_t f32;
+      memcpy(&f32, base + off, 4);
+      volatile double vd = d;
+      const float want = static_cast<float>(vd);
+      EXPECT_EQ(FBits(want), f32);
+      const double loaded = CallDP(load_s, base);
+      if (std::isnan(d)) {
+        EXPECT(std::isnan(loaded));
+      } else {
+        EXPECT_EQ(Bits(static_cast<double>(want)), Bits(loaded));
+      }
+    }
+  }
+  for (double d : doubles) {
+    const uword imm = GenerateEntry("LoadDImmediate", [&](Assembler* a) {
+      a->LoadDImmediate(F5, d);
+      a->MoveUnboxedDouble(F1, F5);
+    });
+    EXPECT_EQ(Bits(d), Bits(CallD(imm)));
+  }
+  for (float f : {0.0f, -0.0f, 1.0f, 0.1f, 3.4028235e38f,
+                  std::numeric_limits<float>::denorm_min()}) {
+    const uword imm = GenerateEntry("LoadSImmediate", [&](Assembler* a) {
+      a->LoadSImmediate(F1, f);
+    });
+    EXPECT_EQ(Bits(static_cast<double>(f)), Bits(CallD(imm)));
+  }
+  // Compare and branch with NaN on either side: only NE is true on NaN.
+  const double nan = std::numeric_limits<double>::quiet_NaN();
+  const double operands[] = {nan, -1.0, -0.0, 0.0, 1.0,
+                             std::numeric_limits<double>::infinity()};
+  for (Condition c : {EQ, NE, LT, GT, LE, GE, VS, VC}) {
+    const uword branch = GenerateEntry("BranchIfDouble", [&](Assembler* a) {
+      Label taken;
+      a->LoadImmediate(R3, 1);
+      a->DoubleCompare(F1, F2);
+      a->BranchIfDouble(c, &taken);
+      a->LoadImmediate(R3, 0);
+      a->Bind(&taken);
+    });
+    const uword set = GenerateEntry("SetIfDouble", [&](Assembler* a) {
+      a->DoubleCompare(F1, F2);
+      a->SetIfDouble(c, R3);
+    });
+    for (double x : operands) {
+      for (double y : operands) {
+        bool want = false;
+        switch (c) {
+          case EQ: want = x == y; break;
+          case NE: want = x != y; break;
+          case LT: want = x < y; break;
+          case GT: want = x > y; break;
+          case LE: want = x <= y; break;
+          case GE: want = x >= y; break;
+          case VS: want = std::isunordered(x, y); break;
+          case VC: want = !std::isunordered(x, y); break;
+          default: UNREACHABLE();
+        }
+        EXPECT_EQ(want ? 1 : 0, CallID(branch, x, y));
+        EXPECT_EQ(want ? 1 : 0, CallID(set, x, y));
+      }
+    }

+    EXPECT_EQ(static_cast<int64_t>(FBits(f)), CallID(f2r, static_cast<double>(f)));
+    EXPECT_EQ(Bits(static_cast<double>(f)),
+              Bits(CallDI(r2f, 0xdeadbeef00000000ll | FBits(f))));

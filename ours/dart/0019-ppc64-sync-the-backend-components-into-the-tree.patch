+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_RangeCopyCompare) {
+  for (auto cond : {Assembler::kIfInRange, Assembler::kIfNotInRange}) {
+    const uword range = GenerateEntry("RangeCheck", [&](Assembler* a) {
+      Label t;
+      a->LoadImmediate(R9, 1);
+      a->RangeCheck(R3, R4, 10, 20, cond, &t);
+      a->LoadImmediate(R9, 0);
+      a->Bind(&t);
+      a->MoveRegister(R3, R9);
+    });
+    for (int64_t v : {int64_t{9}, int64_t{10}, int64_t{15}, int64_t{20},
+                      int64_t{21}, int64_t{-1}, kMinInt64}) {
+      const bool in = v >= 10 && v <= 20;
+      EXPECT_EQ((cond == Assembler::kIfInRange) == in ? 1 : 0, Call(range, v));
+    }
+  }
+  const uword copy = GenerateEntry("CopyMemoryWords", [](Assembler* a) {
+    a->CopyMemoryWords(R3, R4, R5, R6);
+  });
+  uint64_t src[6] = {1, 2, 3, 4, 5, 6}, dst[6] = {0, 0, 0, 0, 0, 0};
+  Call(copy, reinterpret_cast<int64_t>(src), reinterpret_cast<int64_t>(dst),
+       4 * 8);
+  EXPECT_EQ(4u, dst[3]);
+  EXPECT_EQ(0u, dst[4]);
+  const uword compare = GenerateEntry("CompareWords", [](Assembler* a) {
+    Label equal;
+    a->LoadImmediate(R9, 0);
+    a->CompareWords(R3, R4, 16, R5, R6, &equal);
+    a->MoveRegister(R3, R9);
+    a->Ret();
+    a->Bind(&equal);
+    a->LoadImmediate(R3, 1);
+  });
+  uint64_t x[6] = {0, 0, 7, 8, 9, 10}, y[6] = {0, 0, 7, 8, 9, 11};
+  EXPECT_EQ(1, Call(compare, reinterpret_cast<int64_t>(x) + kHeapObjectTag,
+                    reinterpret_cast<int64_t>(y) + kHeapObjectTag, 3));
+  EXPECT_EQ(0, Call(compare, reinterpret_cast<int64_t>(x) + kHeapObjectTag,
+                    reinterpret_cast<int64_t>(y) + kHeapObjectTag, 4));
+}

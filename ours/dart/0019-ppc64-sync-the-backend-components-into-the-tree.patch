+// ----------------------------------------------------------------------------
+// Harness.
+// ----------------------------------------------------------------------------
+
+// Generated code as an ELFv2 C function.
+static int64_t Call(uword entry,
+                    int64_t a0 = 0,
+                    int64_t a1 = 0,
+                    int64_t a2 = 0,
+                    int64_t a3 = 0) {
+  typedef int64_t (*F)(int64_t, int64_t, int64_t, int64_t);
+  return reinterpret_cast<F>(entry)(a0, a1, a2, a3);
+}
+static double CallD(uword entry, double a0 = 0, double a1 = 0) {
+  typedef double (*F)(double, double);
+  return reinterpret_cast<F>(entry)(a0, a1);
+}
+static int64_t CallID(uword entry, double a0, double a1 = 0) {
+  typedef int64_t (*F)(double, double);
+  return reinterpret_cast<F>(entry)(a0, a1);
+}
+static double CallDI(uword entry, int64_t a0) {
+  typedef double (*F)(int64_t);
+  return reinterpret_cast<F>(entry)(a0);
+}
+// (pointer r3, double f1): the double consumes a GPR slot (ELFv2).
+static void CallVPD(uword entry, void* p, double d) {
+  typedef void (*F)(void*, double);
+  reinterpret_cast<F>(entry)(p, d);
+}
+static double CallDP(uword entry, void* p) {
+  typedef double (*F)(void*);
+  return reinterpret_cast<F>(entry)(p);
+}
+
+// Assembles |gen| plus a final blr into an installed Code object. (Not
+// AssemblerTest::Generate: in 3.11.5 it ignores its generator.)
+static const Code& Generate(const char* name,
+                            const std::function<void(Assembler*)>& gen) {
+  ObjectPoolBuilder object_pool_builder;
+  Assembler assembler(&object_pool_builder, /*far_branch_level=*/0);
+  AssemblerTest test(name, &assembler, Thread::Current()->zone());
+  gen(&assembler);
+  assembler.Ret();
+  test.Assemble();
+  return test.code();
+}
+static uword GenerateEntry(const char* name,
+                           const std::function<void(Assembler*)>& gen) {
+  return Generate(name, gen).EntryPoint();
+}
+
+static uint64_t Bits(double d) {
+  return bit_cast<uint64_t>(d);
+}
+static uint32_t FBits(float f) {
+  return bit_cast<uint32_t>(f);
+}
+static uint64_t SExt32(uint64_t x) {
+  return static_cast<uint64_t>(static_cast<int64_t>(static_cast<int32_t>(x)));
+}

+// Overflow from sign bits into CR0 (7.5, Amendment A3): both outcomes, every
+// aliasing of rd/rs1/rs2. r9 = 1 iff the branch was taken.
+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_Overflow) {
+  struct Alias {
+    Register rd, rs1, rs2;
+  };
+  const Alias aliases[] = {{R6, R3, R4}, {R3, R3, R4}, {R4, R3, R4},
+                           {R6, R3, R3}, {R3, R3, R3}};
+  intptr_t overflowed = 0, clean = 0;
+  for (int op = 0; op < 3; op++) {
+    for (const Alias& al : aliases) {
+      const uword code = GenerateEntry("BranchOverflow", [&](Assembler* a) {
+        Label ov;
+        a->LoadImmediate(R9, 1);
+        if (op == 0) a->AddBranchOverflow(al.rd, al.rs1, al.rs2, &ov);
+        if (op == 1) a->SubtractBranchOverflow(al.rd, al.rs1, al.rs2, &ov);
+        if (op == 2) a->MultiplyBranchOverflow(al.rd, al.rs1, al.rs2, &ov);
+        a->LoadImmediate(R9, 0);
+        a->Bind(&ov);
+        a->MoveRegister(R3, R9);
+      });
+      const uword value = GenerateEntry("BranchOverflow value", [&](Assembler* a) {
+        Label ov;
+        if (op == 0) a->AddBranchOverflow(al.rd, al.rs1, al.rs2, &ov);
+        if (op == 1) a->SubtractBranchOverflow(al.rd, al.rs1, al.rs2, &ov);
+        if (op == 2) a->MultiplyBranchOverflow(al.rd, al.rs1, al.rs2, &ov);
+        a->Bind(&ov);
+        a->MoveRegister(R3, al.rd);
+      });
+      for (uint64_t x : kValues) {
+        for (uint64_t y : kValues) {
+          const int64_t b = (al.rs1 == al.rs2) ? x : y;
+          int64_t want = 0;
+          bool ov = false;
+          if (op == 0) ov = __builtin_add_overflow(static_cast<int64_t>(x), b, &want);
+          if (op == 1) ov = __builtin_sub_overflow(static_cast<int64_t>(x), b, &want);
+          if (op == 2) ov = __builtin_mul_overflow(static_cast<int64_t>(x), b, &want);
+          EXPECT_EQ(ov ? 1 : 0, Call(code, x, y));
+          EXPECT_EQ(want, Call(value, x, y));
+          (ov ? overflowed : clean)++;
+        }
+      }
+    }
+  }
+  EXPECT(overflowed > 100);
+  EXPECT(clean > 100);
+  const int64_t imms[] = {1, -1, 0x7fff, -0x8000, 0x8000, kMaxInt64,
+                          kMinInt64, 0x100000000};
+  for (int op = 0; op < 3; op++) {
+    for (int64_t imm : imms) {
+      const uword code = GenerateEntry("ImmediateBranchOverflow",
+                                       [&](Assembler* a) {
+        Label ov;
+        a->LoadImmediate(R9, 1);
+        if (op == 0) a->AddImmediateBranchOverflow(R6, R3, imm, &ov);
+        if (op == 1) a->SubtractImmediateBranchOverflow(R6, R3, imm, &ov);
+        if (op == 2) a->MultiplyImmediateBranchOverflow(R6, R3, imm, &ov);
+        a->LoadImmediate(R9, 0);
+        a->Bind(&ov);
+        a->MoveRegister(R3, R9);
+      });
+      for (uint64_t x : kValues) {
+        int64_t want = 0;
+        bool ov = false;
+        if (op == 0) ov = __builtin_add_overflow(static_cast<int64_t>(x), imm, &want);
+        if (op == 1) ov = __builtin_sub_overflow(static_cast<int64_t>(x), imm, &want);
+        if (op == 2) ov = __builtin_mul_overflow(static_cast<int64_t>(x), imm, &want);
+        EXPECT_EQ(ov ? 1 : 0, Call(code, x));
+      }
+    }
+  }
+  const uword smi_ov = GenerateEntry("SmiTagAndBranchIfOverflow", [](Assembler* a) {
+    Label ov;
+    a->LoadImmediate(R9, 1);
+    a->SmiTagAndBranchIfOverflow(R3, &ov);
+    a->LoadImmediate(R9, 0);
+    a->Bind(&ov);
+    a->MoveRegister(R3, R9);

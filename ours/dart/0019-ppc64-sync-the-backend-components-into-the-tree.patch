+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_Atomics) {
+  alignas(16) uint64_t words[4];
+  const OperandSize sizes[] = {kEightBytes, kFourBytes, kUnsignedFourBytes,
+                               kUnsignedTwoBytes, kUnsignedByte};
+  for (OperandSize sz : sizes) {
+    const intptr_t n = Assembler::OperandSizeInBits(sz) / 8;
+    // r3 = address, r4 = expected, r5 = desired -> r3 = old, r9 = mismatch.
+    const uword cas = GenerateEntry("CompareAndSwap", [&](Assembler* a) {
+      Label miss;
+      a->LoadImmediate(R9, 1);
+      a->CompareAndSwap(R3, R4, R5, R7, &miss, Assembler::kRelaxedNonAtomic, sz);
+      a->LoadImmediate(R9, 0);
+      a->Bind(&miss);
+      a->sldi(R9, R9, 62);
+      a->or_(R3, R7, R9);  // the flag in bit 62, the old value below
+    });
+    const uword fetch_add = GenerateEntry("AtomicFetchAndOp", [&](Assembler* a) {
+      a->AtomicFetchAndOp(Assembler::kAtomicAdd, R3, R4, R7, Assembler::kRelease,
+                          sz);
+      a->MoveRegister(R3, R7);
+    });
+    for (uint64_t cur : {uint64_t{0x11}, uint64_t{0x8081}, uint64_t{0x80000001}}) {
+      words[0] = words[1] = words[2] = 0x3c3c3c3c3c3c3c3cull;
+      memcpy(&words[1], &cur, n);
+      const uint64_t mask = n == 8 ? ~uint64_t{0} : (uint64_t{1} << (8 * n)) - 1;
+      // A matching expected, sign-extended from the access width: the
+      // macro compares the access width only (sub-word: zero-extended in R0).
+      uint64_t expected = cur;
+      if (n == 4) expected = SExt32(cur);
+      if (n == 2) expected = static_cast<int64_t>(static_cast<int16_t>(cur));
+      if (n == 1) expected = static_cast<int64_t>(static_cast<int8_t>(cur));
+      // Mismatch: memory unchanged, old returned, flag set.
+      int64_t r = Call(cas, reinterpret_cast<int64_t>(&words[1]),
+                       (cur ^ 1) & mask, 0x42);
+      EXPECT_EQ(1, (r >> 62) & 1);
+      // Match, with a sign-extended expected for the narrow sizes.
+      r = Call(cas, reinterpret_cast<int64_t>(&words[1]), expected, 0x42);
+      EXPECT_EQ(0, (r >> 62) & 1);
+      uint64_t now = 0;
+      memcpy(&now, &words[1], n);
+      EXPECT_EQ(0x42u, now);
+      EXPECT_EQ(0x3c3c3c3c3c3c3c3cull, words[0]);
+      EXPECT_EQ(0x3c3c3c3c3c3c3c3cull, words[2]);
+      const int64_t old = Call(fetch_add, reinterpret_cast<int64_t>(&words[1]), 5);
+      EXPECT_EQ(0x42, old);
+      memcpy(&now, &words[1], n);
+      EXPECT_EQ(0x47u, now);
+    }
+  }
+  const uword acquire = GenerateEntry("LoadAcquire", [](Assembler* a) {
+    a->LoadAcquire(R3, Address(R3, 8), kFourBytes);
+  });
+  const uword release = GenerateEntry("StoreRelease", [](Assembler* a) {
+    a->StoreRelease(R4, Address(R3, 8));
+    a->StoreStoreFence();
+    a->FullFence();
+  });
+  Call(release, reinterpret_cast<int64_t>(words), 0x00000000fffffff0ll);
+  EXPECT_EQ(0x00000000fffffff0ull, words[1]);
+  EXPECT_EQ(-16, Call(acquire, reinterpret_cast<int64_t>(words)));
+}

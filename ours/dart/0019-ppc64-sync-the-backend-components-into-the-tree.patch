+ASSEMBLER_TEST_GENERATE(LoadObjects, assembler) {
+  EnterTestFrame(assembler);
+  Label fail, done;
+  __ LoadObject(R5, Object::null_object());
+  __ CompareRegisters(R5, NULL_REG);
+  __ BranchIf(NE, &fail);
+  __ LoadObject(R6, Bool::True());
+  __ CompareObject(R6, Bool::True());
+  __ BranchIf(NE, &fail);
+  __ LoadObject(R7, Smi::ZoneHandle(Smi::New(-12345)));
+  __ CompareImmediate(R7, target::ToRawSmi(-12345));
+  __ BranchIf(NE, &fail);
+  __ PushObject(Bool::False());
+  __ PopRegister(R8);
+  __ CompareObject(R8, Bool::False());
+  __ BranchIf(NE, &fail);
+  __ LoadImmediate(R3, 42);
+  __ Jump(&done);
+  __ Bind(&fail);
+  __ LoadImmediate(R3, 0);
+  __ Bind(&done);
+  LeaveTestFrame(assembler);
+  __ Ret();
+}
+
+ASSEMBLER_TEST_RUN(LoadObjects, test) {
+  EXPECT_EQ(42, test->InvokeWithCodeAndThread<int64_t>());
+}

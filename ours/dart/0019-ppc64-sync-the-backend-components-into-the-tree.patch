+  compiler::ObjectPoolBuilder object_pool_builder;
+  compiler::Assembler assembler(&object_pool_builder);
+  GenerateClobberEverything(&assembler);
+  SafepointWriteRwLocker ml(thread, thread->isolate_group()->program_lock());
+  const Code& code = Code::Handle(Code::FinalizeCodeAndNotify(
+      *CreateFunction(kName), nullptr, &assembler,
+      Code::PoolAttachment::kAttachPool));
+  const Function& function = RegisterFakeFunction(kName, code);
+
+  // The ordinary way in first: DartEntry.
+  Object& result = Object::Handle(
+      DartEntry::InvokeFunction(function, Object::empty_array()));
+  EXPECT(result.IsNull());
+
+  // Then the stub directly, entered from ppc64_sentinel_call, in the state
+  // DartEntry's own scope establishes (generated, no long jump base).
+  const Array& arguments_descriptor =
+      Array::Handle(ArgumentsDescriptor::NewBoxed(/*type_args_len=*/0,
+                                                  /*num_arguments=*/0));
+  uint64_t out[40];
+  uint64_t returned;
+  {
+    TransitionToGenerated transition(thread);
+    LongJumpScope* const saved_long_jump_base = thread->long_jump_base();
+    thread->set_long_jump_base(nullptr);
+    returned = ppc64_sentinel_call(
+        StubCode::InvokeDartCode().EntryPoint(),
+        static_cast<uint64_t>(static_cast<uword>(code.ptr())),
+        static_cast<uint64_t>(static_cast<uword>(arguments_descriptor.ptr())),
+        static_cast<uint64_t>(static_cast<uword>(Object::empty_array().ptr())),
+        reinterpret_cast<uint64_t>(thread), out);
+    thread->set_long_jump_base(saved_long_jump_base);
+  }
+  EXPECT_EQ(static_cast<uint64_t>(static_cast<uword>(Object::null())),
+            returned);
+  Ppc64ExpectCalleeSavedIntact(out);
+}
+
+// A Dart function that throws through the Throw runtime entry.
+static void GenerateThrow(compiler::Assembler* assembler,
+                          const Instance& exception) {
+  __ EnterDartFrame(0);
+  __ PushObject(Object::null_object());  // Return slot.
+  __ PushObject(exception);              // Argument: the exception.
+  ASSERT(kThrowRuntimeEntry.argument_count() == 1);
+  __ CallRuntime(kThrowRuntimeEntry, 1);
+  __ Breakpoint();  // Throw does not return.
+}
+
+ISOLATE_UNIT_TEST_CASE(ExceptionAcrossCFrame) {
+  extern const Function& RegisterFakeFunction(const char* name,
+                                              const Code& code);
+  const char* kName = "Test_ExceptionAcrossCFrame";
+  const String& exception =
+      String::ZoneHandle(String::New("ppc64 exception", Heap::kOld));
+  compiler::ObjectPoolBuilder object_pool_builder;
+  compiler::Assembler assembler(&object_pool_builder);
+  GenerateThrow(&assembler, exception);
+  SafepointWriteRwLocker ml(thread, thread->isolate_group()->program_lock());
+  const Code& code = Code::Handle(Code::FinalizeCodeAndNotify(
+      *CreateFunction(kName), nullptr, &assembler,
+      Code::PoolAttachment::kAttachPool));
+  code.set_exception_handlers(Object::empty_exception_handlers());
+  const Function& function = RegisterFakeFunction(kName, code);
+  const Object& result = Object::Handle(
+      DartEntry::InvokeFunction(function, Object::empty_array()));
+  EXPECT(result.IsUnhandledException());
+  if (result.IsUnhandledException()) {
+    EXPECT(UnhandledException::Cast(result).exception() == exception.ptr());
+  }
+}

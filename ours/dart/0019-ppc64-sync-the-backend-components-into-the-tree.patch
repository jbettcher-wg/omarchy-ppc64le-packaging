+// The deferred compare (7.4): every condition, register and immediate forms
+// (int16, uint16-only, 32-bit, 64-bit), 64- and 32-bit widths; BranchIf,
+// SetIf and ZeroIf all consume it.
+ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_CompareAndBranch) {
+  const Condition conds[] = {EQ, NE, LT, GE, GT, LE, CC, CS, HI, LS};
+  const int64_t imms[] = {0, 5, -5, 0xfff0, 0x12345678, -0x12345678,
+                          0x123456789ll};
+  const int64_t values[] = {0,          5,          -5,          0xfff0,
+                            0x12345678, -0x12345678, 0x123456789ll,
+                            kMinInt64,  kMaxInt64,  0x80000000,  -1};
+  for (Condition c : conds) {
+    for (OperandSize width : {kEightBytes, kFourBytes}) {
+      if (width == kEightBytes) {
+        const uword branch = GenerateEntry("BranchIf reg", [&](Assembler* a) {
+          Label taken;
+          a->LoadImmediate(R5, 1);
+          a->CompareRegisters(R3, R4);
+          a->BranchIf(c, &taken);
+          a->LoadImmediate(R5, 0);
+          a->Bind(&taken);
+          a->MoveRegister(R3, R5);
+        });
+        const uword set = GenerateEntry("SetIf", [&](Assembler* a) {
+          a->CompareRegisters(R3, R4);
+          a->SetIf(c, R3);
+        });
+        const uword zero_if = GenerateEntry("ZeroIf", [&](Assembler* a) {
+          a->CompareRegisters(R3, R4);
+          a->ZeroIf(c, R3, R5);
+        });
+        for (int64_t x : values) {
+          for (int64_t y : values) {
+            const bool want = Holds(c, x, y, kEightBytes);
+            EXPECT_EQ(want ? 1 : 0, Call(branch, x, y));
+            EXPECT_EQ(want ? 1 : 0, Call(set, x, y));
+            EXPECT_EQ(want ? 0 : 77, Call(zero_if, x, y, 77));
+          }
+        }
+      }
+      for (int64_t imm : imms) {
+        if (width == kFourBytes && !Utils::IsInt(32, imm)) continue;
+        const uword branch_imm = GenerateEntry("BranchIf imm", [&](Assembler* a) {
+          Label taken;
+          a->LoadImmediate(R5, 1);
+          a->CompareImmediate(R3, imm, width);
+          a->BranchIf(c, &taken);
+          a->LoadImmediate(R5, 0);
+          a->Bind(&taken);
+          a->MoveRegister(R3, R5);
+        });
+        for (int64_t x : values) {
+          EXPECT_EQ(Holds(c, x, imm, width) ? 1 : 0, Call(branch_imm, x));
+        }
+      }
+    }
+  }
+  // 32-bit memory compare: the upper half of the register is ignored.
+  const uword mem = GenerateEntry("CompareWithMemoryValue", [](Assembler* a) {
+    Label equal;
+    a->LoadImmediate(R5, 1);
+    a->CompareWithMemoryValue(R3, Address(R4, 0), kFourBytes);
+    a->BranchIf(EQ, &equal);
+    a->LoadImmediate(R5, 0);
+    a->Bind(&equal);
+    a->MoveRegister(R3, R5);
+  });
+  int32_t word = -7;
+  EXPECT_EQ(1, Call(mem, 0xdeadbeeffffffff9ll, reinterpret_cast<int64_t>(&word)));
+  EXPECT_EQ(0, Call(mem, 0xdeadbeeffffffff8ll, reinterpret_cast<int64_t>(&word)));
+}

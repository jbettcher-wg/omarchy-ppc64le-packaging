+// A conditional branch over more than 32 KiB: the first attempt bails out
+// (ASSEMBLER_TEST_RUN retries with far_branch_level 1, 7.2) and the far form
+// bc <inverted>,+8 ; b target is used.
+ASSEMBLER_TEST_GENERATE(FarBranchForward, assembler) {
+  Label target;
+  __ CompareImmediate(R3, 0);
+  __ BranchIf(EQ, &target);
+  for (intptr_t i = 0; i < 9000; i++) {
+    __ nop();
+  }
+  __ LoadImmediate(R3, 7);
+  __ Ret();
+  __ Bind(&target);
+  __ LoadImmediate(R3, 42);
+  __ Ret();

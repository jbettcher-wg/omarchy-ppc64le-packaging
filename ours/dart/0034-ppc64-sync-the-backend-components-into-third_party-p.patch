diff --git a/third_party/pkg/native/pkgs/code_assets/test/code_assets/architecture_test.dart b/third_party/pkg/native/pkgs/code_assets/test/code_assets/architecture_test.dart
new file mode 100644
index 0000000..ef8ae76
--- /dev/null
+++ b/third_party/pkg/native/pkgs/code_assets/test/code_assets/architecture_test.dart
@@ -0,0 +1,53 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+import 'dart:ffi';
+
+import 'package:code_assets/code_assets.dart';
+import 'package:code_assets/src/code_assets/architecture.dart'
+    show ArchitectureSyntaxExtension, architectureFromAbiName;
+import 'package:code_assets/src/code_assets/syntax.g.dart'
+    show ArchitectureSyntax;
+import 'package:test/test.dart';
+
+void main() {
+  test('ppc64 round-trips through its name', () {
+    expect(Architecture.ppc64.name, 'ppc64');
+    expect(Architecture.ppc64.toString(), 'ppc64');
+    expect(Architecture.fromString('ppc64'), Architecture.ppc64);
+    expect(Architecture.values, contains(Architecture.ppc64));
+    expect(ArchitectureSyntax.fromJson('ppc64').isKnown, isTrue);
+    expect(Architecture.ppc64.toSyntax(), ArchitectureSyntax.ppc64);
+  });
+
+  test('architectureFromAbiName', () {
+    expect(architectureFromAbiName('linux_ppc64'), Architecture.ppc64);
+    expect(architectureFromAbiName('linux_riscv64'), Architecture.riscv64);
+    expect(architectureFromAbiName('windows_ia32'), Architecture.ia32);
+    expect(architectureFromAbiName('linux_sparc64'), isNull);
+    expect(architectureFromAbiName('bogus'), isNull);
+  });
+
+  test('the ABI name agrees with the ABI table for every Abi of this SDK', () {
+    // This checks the assumption architectureFromAbiName rests on: that
+    // Abi.toString() is '<os>_<architecture>' with an Architecture.name.
+    for (final abi in Abi.values) {
+      expect(
+        architectureFromAbiName(abi.toString()),
+        Architecture.fromAbi(abi),
+        reason: '$abi',
+      );
+    }
+    expect(Architecture.current, Architecture.fromAbi(Abi.current()));
+  });
+
+  test('Architecture.fromAbi knows linux_ppc64 when the SDK does', () {
+    final linuxPpc64 = Abi.values
+        .where((abi) => abi.toString() == 'linux_ppc64')
+        .firstOrNull;
+    if (linuxPpc64 != null) {
+      expect(Architecture.fromAbi(linuxPpc64), Architecture.ppc64);
+    }
+  });
+}
diff --git a/third_party/pkg/native/pkgs/hooks_runner/lib/src/model/target.dart b/third_party/pkg/native/pkgs/hooks_runner/lib/src/model/target.dart
index 6c9bb76..01e8e99 100644

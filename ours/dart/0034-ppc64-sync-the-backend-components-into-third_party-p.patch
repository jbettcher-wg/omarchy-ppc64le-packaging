+
+  test('Target fromAbiName', () async {
+    expect(Target.fromAbiName('linux_riscv64')!.abi, Abi.linuxRiscv64);
+    expect(Target.fromAbiName('linux_bogus'), isNull);
+    for (final target in Target.values) {

+      expect(byName.abi, target.abi);
+      expect(byName.toString(), target.toString());
+    }
+  });
+
+  test('Target osFromAbiName agrees with os for every Target', () async {
+    for (final target in Target.values) {
+      expect(
+        Target.osFromAbiName(target.abi.toString()),
+        target.os,
+        reason: '$target',
+      );
+    }
+    expect(Target.osFromAbiName('linux_ppc64'), OS.linux);
+  });
+
+  test('Target linuxPpc64 exists only on SDKs with linux_ppc64', () async {
+    final sdkHasAbi = Abi.values.any((abi) => abi.toString() == 'linux_ppc64');
+    expect(Target.linuxPpc64 != null, sdkHasAbi);
+    if (sdkHasAbi) {
+      final target = Target.linuxPpc64!;
+      expect(target.toString(), 'linux_ppc64');
+      expect(target.os, OS.linux);
+      expect(target.architecture, Architecture.ppc64);
+      expect(Target.values, contains(target));
+      expect(
+        Target.fromArchitectureAndOS(Architecture.ppc64, OS.linux),
+        same(target),
+      );
+      expect(Target.fromString('linux_ppc64'), same(target));
+    } else {
+      expect(
+        () => Target.fromArchitectureAndOS(Architecture.ppc64, OS.linux),
+        throwsArgumentError,
+      );
+    }
+  });
 }

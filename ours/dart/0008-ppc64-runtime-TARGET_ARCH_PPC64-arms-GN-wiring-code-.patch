+namespace dart {
+
+class Code;
+class ICData;
+class Object;
+class ObjectPool;
+
+// The code shapes decoded here are those of ABI-SPEC 4.1 and 6.2. Call
+// targets and IC data are patched by rewriting object pool slots, never
+// instructions; only AOT relocation rewrites a "bl"/"b" (before the code
+// ever runs).
+//
+//   pool load (Assembler::LoadWordFromPoolIndex; PP = r30 is untagged):
+//       ld dst,off(r30)                            offset < 32 KiB
+//       addis X,r30,ha(off) ; ld dst,lo(off)(X)    X = dst, or TMP if dst = r0
+//   JIT call through a Code object (BranchLink, Call(FieldAddress(r28, ..))):
+//       <pool load of r28> ; li r0,entry-1 ; ldx r0,r28,r0 ; mtctr r0 ; bctrl
+//   AOT call through an entry point in the pool:
+//       <pool load of r0> ; mtctr r0 ; bctrl
+//   IC / megamorphic / switchable call (JIT): two consecutive pool slots,
+//       <pool load of r28 (slot i)> ; <pool load of r8 (slot i+1)> ;
+//       li r0,entry-1 ; ldx r0,r28,r0 ; mtctr r0 ; bctrl
+//   native call: <pool load of r8 (native function)> ; <JIT call>
+class InstructionPattern : public AllStatic {
+ public:
+  // Decodes a pool load ending at |end| (the load's last instruction is the
+  // one before |end|). Returns the address of its first instruction, and the
+  // loaded register and pool index in |reg| and |index|.
+  static uword DecodeLoadWordFromPool(uword end,
+                                      Register* reg,
+                                      intptr_t* index);
+
+  // Decodes a call through the object pool whose return address is |pc|:
+  // either shape above (JIT through Code, AOT through an entry point).
+  // Returns the address of its first instruction; |reg| is the register the
+  // pool slot was loaded into (CODE_REG, or R0 for the AOT shape).
+  static uword DecodeCallThroughPool(uword pc, Register* reg, intptr_t* index);
+
+  // The branch-through-CTR tail of every call: "mtctr r0 ; bctrl" ending at
+  // |pc|.
+  static bool IsCallThroughCtr(uword pc);
+};
+
+class CallPattern : public ValueObject {
+ public:
+  CallPattern(uword pc, const Code& code);
+
+  CodePtr TargetCode() const;
+  void SetTargetCode(const Code& target) const;
+
+ private:
+  const ObjectPool& object_pool_;
+
+  intptr_t target_code_pool_index_;
+
+  DISALLOW_COPY_AND_ASSIGN(CallPattern);
+};
+
+class ICCallPattern : public ValueObject {
+ public:
+  ICCallPattern(uword pc, const Code& caller_code);
+
+  ObjectPtr Data() const;
+  void SetData(const Object& data) const;
+
+  CodePtr TargetCode() const;
+  void SetTargetCode(const Code& target) const;
+
+ private:
+  const ObjectPool& object_pool_;
+
+  intptr_t target_pool_index_;

diff --git a/runtime/vm/instructions_ppc64.cc b/runtime/vm/instructions_ppc64.cc
new file mode 100644
index 00000000..c49f38c1
--- /dev/null
+++ b/runtime/vm/instructions_ppc64.cc
@@ -0,0 +1,345 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/globals.h"  // Needed here to get TARGET_ARCH_PPC64.
+#if defined(TARGET_ARCH_PPC64)
+
+#include "vm/instructions.h"
+#include "vm/instructions_ppc64.h"
+
+#include "vm/constants.h"
+#include "vm/cpu.h"
+#include "vm/object.h"
+#include "vm/object_store.h"
+#include "vm/reverse_pc_lookup_cache.h"
+
+namespace dart {
+
+// The instructions of the call shapes (instructions_ppc64.h).
+static constexpr uint32_t kMtctrR0 = kPpcMtctr | (0u << 21);       // mtctr r0
+static constexpr uint32_t kLdxR0CodeR0 =                            // ldx r0,r28,r0
+    kPpcLdx | (0u << 21) | (static_cast<uint32_t>(CODE_REG) << 16) | (0u << 11);
+
+static bool IsLi(const Instr* instr, Register rt) {  // addi rt,0,si
+  return instr->IsD(kPpcAddi) && instr->RTField() == rt &&
+         instr->RAField() == R0;
+}
+
+uword InstructionPattern::DecodeLoadWordFromPool(uword end,
+                                                 Register* reg,
+                                                 intptr_t* index) {
+  // 1. ld dst,off(PP)
+  // or
+  // 2. addis X,PP,ha(off) ; ld dst,lo(off)(X)    X = dst, or TMP if dst = r0
+  uword start = end - Instr::kInstrSize;
+  const Instr* ld = Instr::At(start);
+  RELEASE_ASSERT(ld->IsDS(kPpcLd));
+  *reg = ld->RTField();
+  intptr_t offset = ld->DSField();
+  const Register base = ld->RAField();
+  if (base != PP) {
+    ASSERT(base == *reg || (*reg == R0 && base == TMP));
+    start -= Instr::kInstrSize;
+    const Instr* addis = Instr::At(start);
+    RELEASE_ASSERT(addis->IsD(kPpcAddis) && addis->RTField() == base &&
+                   addis->RAField() == PP);
+    offset += static_cast<intptr_t>(addis->SIField()) << 16;
+  }
+  // PP is untagged on PPC64.
+  ASSERT(Utils::IsAligned(offset, 8));
+  *index = ObjectPool::IndexFromOffset(offset - kHeapObjectTag);
+  return start;
+}
+
+bool InstructionPattern::IsCallThroughCtr(uword pc) {
+  return Instr::At(pc - Instr::kInstrSize)->IsBctrl() &&
+         Instr::At(pc - 2 * Instr::kInstrSize)->InstructionBits() == kMtctrR0;
+}
+
+uword InstructionPattern::DecodeCallThroughPool(uword pc,
+                                                Register* reg,
+                                                intptr_t* index) {
+  RELEASE_ASSERT(IsCallThroughCtr(pc));
+  uword end = pc - 2 * Instr::kInstrSize;  // the mtctr
+  if (Instr::At(end - Instr::kInstrSize)->InstructionBits() == kLdxR0CodeR0) {
+    // JIT: <pool load of CODE_REG> ; li r0,entry-1 ; ldx r0,r28,r0
+    RELEASE_ASSERT(IsLi(Instr::At(end - 2 * Instr::kInstrSize), R0));
+    end -= 2 * Instr::kInstrSize;
+    const uword start = DecodeLoadWordFromPool(end, reg, index);
+    ASSERT(*reg == CODE_REG);
+    return start;
+  }
+  // AOT: <pool load of r0>
+  const uword start = DecodeLoadWordFromPool(end, reg, index);
+  ASSERT(*reg == R0);
+  return start;
+}
+
+CallPattern::CallPattern(uword pc, const Code& code)
+    : object_pool_(ObjectPool::Handle(code.GetObjectPool())),
+      target_code_pool_index_(-1) {
+  ASSERT(code.ContainsInstructionAt(pc));
+  Register reg;
+  InstructionPattern::DecodeCallThroughPool(pc, &reg,
+                                            &target_code_pool_index_);
+}
+
+// The two pool loads (target, then data) of the IC / switchable call;
+// returns the target's pool index, the data's is the next one.
+static intptr_t DecodeTwoSlotCall(uword pc, uword* start) {
+  RELEASE_ASSERT(InstructionPattern::IsCallThroughCtr(pc));
+  uword end = pc - 2 * Instr::kInstrSize;
+  RELEASE_ASSERT(Instr::At(end - Instr::kInstrSize)->InstructionBits() ==
+                 kLdxR0CodeR0);
+  RELEASE_ASSERT(IsLi(Instr::At(end - 2 * Instr::kInstrSize), R0));
+  end -= 2 * Instr::kInstrSize;
+  Register data_reg, code_reg;
+  intptr_t data_index, target_index;
+  end = InstructionPattern::DecodeLoadWordFromPool(end, &data_reg, &data_index);
+  ASSERT(data_reg == IC_DATA_REG);
+  end = InstructionPattern::DecodeLoadWordFromPool(end, &code_reg,
+                                                   &target_index);
+  ASSERT(code_reg == CODE_REG);
+  RELEASE_ASSERT(target_index + 1 == data_index);
+  if (start != nullptr) *start = end;
+  return target_index;
+}
+
+ICCallPattern::ICCallPattern(uword pc, const Code& code)
+    : object_pool_(ObjectPool::Handle(code.GetObjectPool())),
+      target_pool_index_(-1),
+      data_pool_index_(-1) {
+  ASSERT(code.ContainsInstructionAt(pc));
+  target_pool_index_ = DecodeTwoSlotCall(pc, nullptr);
+  data_pool_index_ = target_pool_index_ + 1;
+}
+
+NativeCallPattern::NativeCallPattern(uword pc, const Code& code)
+    : object_pool_(ObjectPool::Handle(code.GetObjectPool())),
+      end_(pc),
+      native_function_pool_index_(-1),
+      target_code_pool_index_(-1) {
+  ASSERT(code.ContainsInstructionAt(pc));
+  Register reg;
+  const uword native_function_load_end = InstructionPattern::DecodeCallThroughPool(
+      end_, &reg, &target_code_pool_index_);
+  ASSERT(reg == CODE_REG);
+  InstructionPattern::DecodeLoadWordFromPool(native_function_load_end, &reg,
+                                             &native_function_pool_index_);
+  // The native-call stubs take the native function in R8 (STUBS-SPEC 2.3).
+  ASSERT(reg == R8);
+}
+
+CodePtr NativeCallPattern::target() const {
+  return static_cast<CodePtr>(object_pool_.ObjectAt(target_code_pool_index_));
+}
+
+void NativeCallPattern::set_target(const Code& target) const {
+  object_pool_.SetObjectAt<std::memory_order_release>(target_code_pool_index_,
+                                                      target);
+  // No need to flush the instruction cache, since the code is not modified.
+}
+
+NativeFunction NativeCallPattern::native_function() const {
+  return reinterpret_cast<NativeFunction>(
+      object_pool_.RawValueAt(native_function_pool_index_));
+}
+
+void NativeCallPattern::set_native_function(NativeFunction func) const {
+  object_pool_.SetRawValueAt<std::memory_order_relaxed>(
+      native_function_pool_index_, reinterpret_cast<uword>(func));
+}
+
+bool DecodeLoadObjectFromPoolOrThread(uword pc, const Code& code, Object* obj) {
+  ASSERT(code.ContainsInstructionAt(pc));
+  const Instr* instr = Instr::At(pc);
+  if (!instr->IsDS(kPpcLd)) {
+    return false;
+  }
+  intptr_t offset = instr->DSField();
+  Register base = instr->RAField();
+  if (base != PP && base != THR) {
+    // The far pool form: addis X,PP,ha ; ld dst,lo(X).
+    const Instr* addis = Instr::At(pc - Instr::kInstrSize);
+    if (!addis->IsD(kPpcAddis) || addis->RTField() != base ||
+        (addis->RAField() != PP && addis->RAField() != THR)) {
+      return false;
+    }
+    offset += static_cast<intptr_t>(addis->SIField()) << 16;
+    base = addis->RAField();
+  }
+  if (base == PP) {
+    // PP is untagged on PPC64.
+    ASSERT(Utils::IsAligned(offset, 8));
+    const intptr_t index = ObjectPool::IndexFromOffset(offset - kHeapObjectTag);
+    return ObjectAtPoolIndex(code, index, obj);
+  }
+  return Thread::ObjectAtOffset(offset, obj);
+}
+
+CodePtr CallPattern::TargetCode() const {
+  return static_cast<CodePtr>(object_pool_.ObjectAt(target_code_pool_index_));
+}
+
+void CallPattern::SetTargetCode(const Code& target) const {
+  object_pool_.SetObjectAt<std::memory_order_release>(target_code_pool_index_,
+                                                      target);
+  // No need to flush the instruction cache, since the code is not modified.
+}
+
+ObjectPtr ICCallPattern::Data() const {
+  return object_pool_.ObjectAt<std::memory_order_acquire>(data_pool_index_);
+}
+
+void ICCallPattern::SetData(const Object& data) const {
+  ASSERT(data.IsArray() || data.IsICData() || data.IsMegamorphicCache());
+  object_pool_.SetObjectAt<std::memory_order_release>(data_pool_index_, data);
+}
+
+CodePtr ICCallPattern::TargetCode() const {
+  return static_cast<CodePtr>(object_pool_.ObjectAt(target_pool_index_));
+}
+
+void ICCallPattern::SetTargetCode(const Code& target) const {
+  object_pool_.SetObjectAt<std::memory_order_release>(target_pool_index_,
+                                                      target);
+  // No need to flush the instruction cache, since the code is not modified.
+}
+
+SwitchableCallPatternBase::SwitchableCallPatternBase(
+    const ObjectPool& object_pool)
+    : object_pool_(object_pool), data_pool_index_(-1), target_pool_index_(-1) {}
+
+ObjectPtr SwitchableCallPatternBase::data() const {
+  return object_pool_.ObjectAt<std::memory_order_acquire>(data_pool_index_);
+}
+
+void SwitchableCallPatternBase::SetDataRelease(const Object& data) const {
+  ASSERT(!Object::Handle(object_pool_.ObjectAt(data_pool_index_)).IsCode());
+  object_pool_.SetObjectAt<std::memory_order_release>(data_pool_index_, data);
+}
+
+SwitchableCallPattern::SwitchableCallPattern(uword pc, const Code& code)
+    : SwitchableCallPatternBase(ObjectPool::Handle(code.GetObjectPool())) {
+  ASSERT(code.ContainsInstructionAt(pc));
+  target_pool_index_ = DecodeTwoSlotCall(pc, nullptr);
+  data_pool_index_ = target_pool_index_ + 1;
+}
+
+ObjectPtr SwitchableCallPattern::target() const {
+  return object_pool_.ObjectAt(target_pool_index_);
+}
+
+void SwitchableCallPattern::SetTargetRelease(const Code& target) const {
+  ASSERT(Object::Handle(object_pool_.ObjectAt(target_pool_index_)).IsCode());
+  object_pool_.SetObjectAt<std::memory_order_release>(target_pool_index_,
+                                                      target);
+}
+
+BareSwitchableCallPattern::BareSwitchableCallPattern(uword pc)
+    : SwitchableCallPatternBase(ObjectPool::Handle(
+          IsolateGroup::Current()->object_store()->global_object_pool())) {
+  // TODO(ppc64): decode the AOT switchable call once
+  // FlowGraphCompiler::EmitInstanceCallAOT defines it (M3-BOOT-PLAN 4.3,
+  // "AOT, later"). Until then nothing can construct this pattern.
+  UNIMPLEMENTED();
+}
+
+uword BareSwitchableCallPattern::target_entry() const {
+  return object_pool_.RawValueAt<std::memory_order_relaxed>(target_pool_index_);
+}
+
+void BareSwitchableCallPattern::SetTargetRelease(const Code& target) const {
+  ASSERT(object_pool_.TypeAt(target_pool_index_) ==
+         ObjectPool::EntryType::kImmediate);
+  object_pool_.SetRawValueAt<std::memory_order_release>(
+      target_pool_index_, target.MonomorphicEntryPoint());
+}
+
+ReturnPattern::ReturnPattern(uword pc) : pc_(pc) {}
+
+bool ReturnPattern::IsValid() const {
+  return Instr::At(pc_)->IsBlr();
+}
+
+bool PcRelativeCallPattern::IsValid() const {
+  return Instr::At(pc_)->IsBl();
+}
+
+bool PcRelativeTailCallPattern::IsValid() const {
+  return Instr::At(pc_)->IsB();
+}
+
+// The fixed words of the trampoline (instructions_ppc64.h). Words 4 and 5
+// carry the displacement.
+static constexpr uint32_t kTrampolineMflrR0 = kPpcMflr | (0u << 21);
+static constexpr uint32_t kTrampolineMflrR12 = kPpcMflr | (12u << 21);
+static constexpr uint32_t kTrampolineMtlrR0 = kPpcMtlr | (0u << 21);
+static constexpr uint32_t kTrampolineAddis = kPpcAddis | (12u << 21) | (12u << 16);
+static constexpr uint32_t kTrampolineAddi = kPpcAddi | (12u << 21) | (12u << 16);
+static constexpr uint32_t kTrampolineMtctrR12 = kPpcMtctr | (12u << 21);
+
+void PcRelativeTrampolineJumpPattern::Initialize() {
+  uint32_t* pattern = reinterpret_cast<uint32_t*>(pattern_start_);
+  pattern[0] = kTrampolineMflrR0;
+  pattern[1] = kPpcBclNextInstr;
+  pattern[2] = kTrampolineMflrR12;
+  pattern[3] = kTrampolineMtlrR0;
+  pattern[4] = kTrampolineAddis;
+  pattern[5] = kTrampolineAddi;
+  pattern[6] = kTrampolineMtctrR12;
+  pattern[7] = kPpcBctr;
+  set_distance(0);
+}
+
+int32_t PcRelativeTrampolineJumpPattern::distance() {
+  const uint32_t* pattern = reinterpret_cast<uint32_t*>(pattern_start_);
+  const int32_t hi = static_cast<int16_t>(pattern[4] & 0xffff);
+  const int32_t lo = static_cast<int16_t>(pattern[5] & 0xffff);
+  return static_cast<int32_t>((static_cast<int64_t>(hi) << 16) + lo +
+                              kPcReadOffset);
+}
+
+void PcRelativeTrampolineJumpPattern::set_distance(int32_t distance) {
+  uint32_t* pattern = reinterpret_cast<uint32_t*>(pattern_start_);
+  const int64_t d = static_cast<int64_t>(distance) - kPcReadOffset;
+  pattern[4] = kTrampolineAddis | EncodeSI(HighAdjusted16(d));
+  pattern[5] = kTrampolineAddi | EncodeSI(Low16(d));
+  ASSERT(IsValid());
+}
+
+bool PcRelativeTrampolineJumpPattern::IsValid() const {
+  const uint32_t* pattern = reinterpret_cast<uint32_t*>(pattern_start_);
+  return pattern[0] == kTrampolineMflrR0 && pattern[1] == kPpcBclNextInstr &&
+         pattern[2] == kTrampolineMflrR12 && pattern[3] == kTrampolineMtlrR0 &&
+         (pattern[4] & ~0xffffu) == kTrampolineAddis &&
+         (pattern[5] & ~0xffffu) == kTrampolineAddi &&
+         pattern[6] == kTrampolineMtctrR12 && pattern[7] == kPpcBctr;
+}
+
+intptr_t TypeTestingStubCallPattern::GetSubtypeTestCachePoolIndex() {
+  // Calls to the type testing stubs look like (GenerateIndirectTTSCall):
+  //   ... ; ld r6,stc(PP) ; mtctr rX ; bctrl
+  // or (AOT, PC-relative):
+  //   ld r6,stc(PP) ; bl tts
+  // where r6 = TypeTestABI::kSubtypeTestCacheReg.
+  uword pc = pc_ - Instr::kInstrSize;
+  const Instr* call = Instr::At(pc);
+  if (call->IsBctrl()) {
+    pc -= Instr::kInstrSize;
+    RELEASE_ASSERT(Instr::At(pc)->IsSprMove(kPpcMtctr));
+  } else {
+    PcRelativeCallPattern pattern(pc);
+    RELEASE_ASSERT(pattern.IsValid());
+  }
+  Register reg;
+  intptr_t pool_index = -1;
+  InstructionPattern::DecodeLoadWordFromPool(pc, &reg, &pool_index);
+  ASSERT_EQUAL(reg, TypeTestABI::kSubtypeTestCacheReg);
+  return pool_index;
+}

+
+  DISALLOW_COPY_AND_ASSIGN(ICCallPattern);
+};
+
+class NativeCallPattern : public ValueObject {
+ public:
+  NativeCallPattern(uword pc, const Code& code);
+
+  CodePtr target() const;
+  void set_target(const Code& target) const;
+
+  NativeFunction native_function() const;
+  void set_native_function(NativeFunction target) const;
+
+ private:
+  const ObjectPool& object_pool_;
+
+  uword end_;
+  intptr_t native_function_pool_index_;
+  intptr_t target_code_pool_index_;
+
+  DISALLOW_COPY_AND_ASSIGN(NativeCallPattern);
+};
+
+// Instance call that can switch between a direct monomorphic call, an IC
+// call, and a megamorphic call.
+//   load guarded cid            load ICData             load MegamorphicCache
+//   load monomorphic target <-> load ICLookup stub  ->  load MMLookup stub
+//   call target.entry           call stub.entry         call stub.entry
+class SwitchableCallPatternBase : public ValueObject {
+ public:
+  explicit SwitchableCallPatternBase(const ObjectPool& object_pool);
+
+  ObjectPtr data() const;
+  void SetDataRelease(const Object& data) const;
+
+ protected:
+  const ObjectPool& object_pool_;
+  intptr_t data_pool_index_;
+  intptr_t target_pool_index_;
+
+ private:
+  DISALLOW_COPY_AND_ASSIGN(SwitchableCallPatternBase);
+};
+
+// See [SwitchableCallBase] for a switchable calls in general.
+//
+// The target slot is always a [Code] object: Either the code of the
+// monomorphic function or a stub code.
+class SwitchableCallPattern : public SwitchableCallPatternBase {
+ public:
+  SwitchableCallPattern(uword pc, const Code& code);
+
+  ObjectPtr target() const;
+  void SetTargetRelease(const Code& target) const;
+
+ private:
+  DISALLOW_COPY_AND_ASSIGN(SwitchableCallPattern);
+};
+
+// See [SwitchableCallBase] for a switchable calls in general.
+//
+// The target slot is always a direct entrypoint address: Either the entry
+// point of the monomorphic function or a stub entry point.
+//
+// AOT only. The AOT switchable call (FlowGraphCompiler::EmitInstanceCallAOT)
+// is not written yet (M3 is JIT); this pattern follows it when it is.
+class BareSwitchableCallPattern : public SwitchableCallPatternBase {
+ public:
+  explicit BareSwitchableCallPattern(uword pc);
+
+  uword target_entry() const;
+  void SetTargetRelease(const Code& target) const;
+
+ private:
+  DISALLOW_COPY_AND_ASSIGN(BareSwitchableCallPattern);
+};
+
+class ReturnPattern : public ValueObject {
+ public:
+  explicit ReturnPattern(uword pc);
+
+  // blr = 1 instruction.
+  static constexpr int kLengthInBytes = 1 * Instr::kInstrSize;
+
+  int pattern_length_in_bytes() const { return kLengthInBytes; }
+
+  bool IsValid() const;
+
+ private:
+  const uword pc_;
+};
+
+// "bl target" / "b target": a signed 26-bit byte offset (24-bit LI field
+// times 4), +/-32 MiB (ABI-SPEC 4.4).
+class PcRelativePatternBase : public ValueObject {
+ public:
+  static constexpr intptr_t kLowerCallingRange = -(1 << 25);
+  static constexpr intptr_t kUpperCallingRange = (1 << 25) - Instr::kInstrSize;
+
+  explicit PcRelativePatternBase(uword pc) : pc_(pc) {}
+
+  static constexpr int kLengthInBytes = 1 * Instr::kInstrSize;
+
+  int32_t distance() { return Instr::At(pc_)->LIField(); }
+
+  void set_distance(int32_t distance) {
+    ASSERT(IsBranch24Offset(distance));
+    Instr* instr = Instr::At(pc_);
+    instr->SetInstructionBits((instr->InstructionBits() & ~0x03fffffcu) |
+                              EncodeLI(distance));
+  }
+
+  bool IsValid() const;
+
+ protected:
+  uword pc_;
+};
+
+class PcRelativeCallPattern : public PcRelativePatternBase {
+ public:
+  explicit PcRelativeCallPattern(uword pc) : PcRelativePatternBase(pc) {}
+
+  bool IsValid() const;
+};
+
+class PcRelativeTailCallPattern : public PcRelativePatternBase {
+ public:
+  explicit PcRelativeTailCallPattern(uword pc) : PcRelativePatternBase(pc) {}
+
+  bool IsValid() const;
+};
+
+// Instruction pattern for a tail call to a signed 32-bit PC-relative offset.
+//
+// The AOT compiler emits PC-relative calls ("bl"). If the destination is not
+// in range for "bl", the code relocator inserts this trampoline, which is in
+// range, and which tail-calls the final destination with a full signed
+// 32-bit offset. It must be position independent (a snapshot has no
+// relocations), so it reads the PC -- the one place this backend does
+// (ABI-SPEC 4.4, 6.5):
+//
+//     mflr  r0
+//     bcl   20,31,$+4
+//     mflr  r12              r12 = address of this instruction (start + 8)
+//     mtlr  r0               the original call's return address restored
+//     addis r12,r12,ha(d)    d = target - (start + 8)
+//     addi  r12,r12,lo(d)
+//     mtctr r12
+//     bctr
+//
+// Clobbers r0, r12 and CTR, which are dead at every Dart call boundary.
+class PcRelativeTrampolineJumpPattern : public ValueObject {
+ public:
+  explicit PcRelativeTrampolineJumpPattern(uword pattern_start)
+      : pattern_start_(pattern_start) {
+    USE(pattern_start_);
+  }
+
+  static constexpr int kLengthInBytes = 8 * Instr::kInstrSize;
+
+  void Initialize();
+
+  // The distance from the start of the trampoline to the target.
+  int32_t distance();
+  void set_distance(int32_t distance);
+  bool IsValid() const;
+
+ private:
+  // The PC that "bcl 20,31,$+4" leaves in LR, relative to the start.
+  static constexpr intptr_t kPcReadOffset = 2 * Instr::kInstrSize;
+
+  uword pattern_start_;
+};

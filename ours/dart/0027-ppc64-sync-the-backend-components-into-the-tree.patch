From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jordan Bettcher <thebettcher@gmail.com>
Date: Thu, 19 Nov 2026 05:58:40 -0600
Subject: [PATCH] [ppc64] sync the backend components into the tree

  runtime/vm/compiler/relocation_test.cc

Sources:
  asm 17929b0
  stubs 5e6c02b (uncommitted there, not synced: stub_code_compiler_ppc64.cc)
  il 8df2468
  aot a66c213
---
 runtime/vm/compiler/relocation_test.cc | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/runtime/vm/compiler/relocation_test.cc b/runtime/vm/compiler/relocation_test.cc
index 754a8196..27b67a24 100644
--- a/runtime/vm/compiler/relocation_test.cc
+++ b/runtime/vm/compiler/relocation_test.cc
@@ -36,6 +36,9 @@ struct RelocatorTestHelper {
   static constexpr intptr_t kOffsetOfCall = 4;
 #elif defined(TARGET_ARCH_RISCV64)
   static constexpr intptr_t kOffsetOfCall = 4;
+#elif defined(TARGET_ARCH_PPC64)
+  // "mflr r11 ; li r3,0" precede the "bl".
+  static constexpr intptr_t kOffsetOfCall = 8;
 #else
   static constexpr intptr_t kOffsetOfCall = 0;
 #endif
@@ -88,6 +91,15 @@ struct RelocatorTestHelper {
       SPILLS_RETURN_ADDRESS_FROM_LR_TO_REGISTER(__ PushList((1 << LR)));
 #elif defined(TARGET_ARCH_RISCV32) || defined(TARGET_ARCH_RISCV64)
           __ PushRegister(RA);
+#elif defined(TARGET_ARCH_PPC64)
+      // The return address is kept in TMP (r11) across the call: the
+      // relocator's far-call trampoline clobbers only r0, r12 and CTR
+      // (ABI-SPEC 4.4), and the 20-byte caller has no room for a frame.
+      __ mflr(TMP);
+      // Poison the result register, so the test fails unless the callee
+      // really runs: the C++ caller may already hold the expected 42 in r3
+      // (clang 22 emits "li r3,42" right before the "bctrl").
+      __ LoadImmediate(R3, 0);
 #endif
       __ GenerateUnRelocatedPcRelativeCall();
       AddPcRelativeCallTargetAt(__ CodeSize(), code, target);
@@ -100,6 +112,8 @@ struct RelocatorTestHelper {
       RESTORES_RETURN_ADDRESS_FROM_REGISTER_TO_LR(__ PopList((1 << LR)));
 #elif defined(TARGET_ARCH_RISCV32) || defined(TARGET_ARCH_RISCV64)
           __ PopRegister(RA);
+#elif defined(TARGET_ARCH_PPC64)
+      __ mtlr(TMP);
 #endif
       __ Ret();
     });
@@ -114,6 +128,8 @@ struct RelocatorTestHelper {
       __ LoadImmediate(R0, 42);
 #elif defined(TARGET_ARCH_RISCV32) || defined(TARGET_ARCH_RISCV64)
           __ LoadImmediate(A0, 42);
+#elif defined(TARGET_ARCH_PPC64)
+      __ LoadImmediate(R3, 42);
 #endif
       __ Ret();
     });
@@ -200,7 +216,8 @@ struct RelocatorTestHelper {
     EXPECT_EQ(42, reinterpret_cast<Fun>(entrypoint)());
 #elif defined(TARGET_ARCH_ARM) || defined(TARGET_ARCH_RISCV32)
     EXPECT_EQ(42, EXECUTE_TEST_CODE_INT32(Fun, entrypoint));
-#elif defined(TARGET_ARCH_ARM64) || defined(TARGET_ARCH_RISCV64)
+#elif defined(TARGET_ARCH_ARM64) || defined(TARGET_ARCH_RISCV64) ||          \
+    defined(TARGET_ARCH_PPC64)
     EXPECT_EQ(42, EXECUTE_TEST_CODE_INT64(Fun, entrypoint));
 #endif
   }

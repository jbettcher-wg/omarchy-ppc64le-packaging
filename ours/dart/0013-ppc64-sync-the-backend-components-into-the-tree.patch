+// ---------------------------------------------------------------------------
+// FlowGraphCompiler FFI native-move hooks. Moved here from
+// flow_graph_compiler_ppc64.cc by IL-A (they are in IL-C's row of
+// M3-BOOT-PLAN section 7).
+// See ABI-SPEC 7.6 (re-canonicalise FFI results and callback arguments on
+// arrival) and Amendment A7 (FPU values in Dart stack slots are double
+// format).
+// ---------------------------------------------------------------------------
+
+// The architecture half of FlowGraphCompiler::EmitNativeMove: the shared
+// code (flow_graph_compiler.cc) has already split stack-to-stack moves,
+// moved sign/zero extension into registers and reconciled payload and
+// container sizes, so what arrives here is a single register/FPU/stack
+// move, possibly extending.
+//
+// ppc64 specifics:
+// - Narrow integers are extended to 64 bits by their signedness (ABI-SPEC
+//   7.6 and ELFv2's caller-extends rule): ExtendValue for 1/2/4 bytes, a
+//   shift pair for the 3/5/6/7-byte payloads of aggregate chunks.
+// - An FPR holds a double-format value (ABI-SPEC 7.7): a float goes to and
+//   from a GPR as its single-precision bits (FloatBitsToRegister,
+//   RegisterToFloatBits) and to memory through StoreSToOffset (frsp; stfs).
+// - GPR -> FPR float with an 8-byte source is the ELFv2 HFA split
+//   B(GPR doubleword, FPR member) (shared EmitNativeMove, ppc64 arm): the
+//   member is the low-addressed word of the doubleword, i.e. its low 32 bits
+//   on little-endian, which is what RegisterToFloatBits reads.
+// - Loads from the stack read the payload only and extend it
+//   (EmitNativeLoad). This is where the narrow arguments of an FFI callback
+//   are re-canonicalised on arrival (STUBS-SPEC 4): NativeParameterInstr
+//   reloads them from where NativeEntryInstr::SaveArguments pushed them.
+// - A 4-byte stack location here is always native (ELFv2) memory: floats in
+//   Dart stack slots are double format (ABI-SPEC A7) and are routed through
+//   FpuTMP by the shared EmitMoveToNative/EmitMoveFromNative/EmitMoveConst
+//   (work/il/ffi/0005) before they reach this hook.
+
+// FlowGraphCompiler members: "__" is the compiler's own assembler here.
+#undef __
+#define __ assembler()->
+
+void FlowGraphCompiler::EmitNativeMoveArchitecture(
+    const compiler::ffi::NativeLocation& destination,
+    const compiler::ffi::NativeLocation& source) {
+  const auto& src_type = source.payload_type();
+  const auto& dst_type = destination.payload_type();
+
+  ASSERT(src_type.IsPrimitive());
+  ASSERT(dst_type.IsPrimitive());
+  const intptr_t src_size = src_type.SizeInBytes();
+  const intptr_t dst_size = dst_type.SizeInBytes();
+  const bool sign_or_zero_extend = dst_size > src_size;
+
+  if (source.IsRegisters()) {
+    const auto& src = source.AsRegisters();
+    ASSERT(src.num_regs() == 1);
+    const Register src_reg = src.reg_at(0);
+
+    if (destination.IsRegisters()) {
+      const auto& dst = destination.AsRegisters();
+      ASSERT(dst.num_regs() == 1);
+      const Register dst_reg = dst.reg_at(0);
+      ASSERT(destination.container_type().SizeInBytes() <=
+             compiler::target::kWordSize);
+      if (!sign_or_zero_extend) {
+        __ MoveRegister(dst_reg, src_reg);
+        return;
+      }
+      ASSERT(src_type.IsInt());
+      switch (src_type.AsPrimitive().representation()) {
+        case compiler::ffi::kInt8:
+          __ ExtendValue(dst_reg, src_reg, compiler::kByte);
+          return;
+        case compiler::ffi::kUint8:
+          __ ExtendValue(dst_reg, src_reg, compiler::kUnsignedByte);
+          return;
+        case compiler::ffi::kInt16:
+          __ ExtendValue(dst_reg, src_reg, compiler::kTwoBytes);
+          return;
+        case compiler::ffi::kUint16:
+          __ ExtendValue(dst_reg, src_reg, compiler::kUnsignedTwoBytes);
+          return;
+        case compiler::ffi::kInt32:
+          __ ExtendValue(dst_reg, src_reg, compiler::kFourBytes);
+          return;
+        case compiler::ffi::kUint32:
+          __ ExtendValue(dst_reg, src_reg, compiler::kUnsignedFourBytes);
+          return;
+        case compiler::ffi::kInt24:
+        case compiler::ffi::kInt40:
+        case compiler::ffi::kInt48:
+        case compiler::ffi::kInt56: {
+          const int shift = 64 - src_size * kBitsPerByte;
+          __ sldi(dst_reg, src_reg, shift);
+          __ sradi(dst_reg, dst_reg, shift);
+          return;
+        }
+        case compiler::ffi::kUint24:
+        case compiler::ffi::kUint40:
+        case compiler::ffi::kUint48:
+        case compiler::ffi::kUint56:
+          __ clrldi(dst_reg, src_reg, 64 - src_size * kBitsPerByte);
+          return;
+        default:
+          UNREACHABLE();
+      }
+    }
+
+    if (destination.IsFpuRegisters()) {
+      const FpuRegister dst_reg = destination.AsFpuRegisters().fpu_reg();
+      ASSERT(dst_type.IsFloat());
+      if (dst_size == 4) {
+        // A 4-byte source, or the 8-byte doubleword of an HFA split whose
+        // low word is the member.
+        ASSERT(src_size == 4 || src_size == 8);
+        __ RegisterToFloatBits(dst_reg, src_reg);
+      } else {
+        ASSERT(dst_size == 8 && src_size == 8);
+        __ mtvsrd(dst_reg, src_reg);
+      }
+      return;
+    }
+
+    ASSERT(destination.IsStack());
+    const auto& dst = destination.AsStack();
+    ASSERT(!sign_or_zero_extend);
+    const intptr_t container_size = destination.container_type().SizeInBytes();
+    compiler::OperandSize op_size;
+    switch (container_size) {
+      case 8:
+        op_size = compiler::kEightBytes;
+        break;
+      case 4:
+        op_size = compiler::kFourBytes;
+        break;
+      case 2:
+        op_size = compiler::kTwoBytes;
+        break;
+      case 1:
+        op_size = compiler::kByte;
+        break;
+      default:
+        UNREACHABLE();
+    }
+    __ StoreToOffset(src_reg, dst.base_register(), dst.offset_in_bytes(),
+                     op_size);
+    return;
+  }
+
+  if (source.IsFpuRegisters()) {
+    const FpuRegister src_reg = source.AsFpuRegisters().fpu_reg();
+    ASSERT(src_type.IsFloat());
+
+    if (destination.IsRegisters()) {
+      const auto& dst = destination.AsRegisters();
+      ASSERT(dst.num_regs() == 1);
+      const Register dst_reg = dst.reg_at(0);
+      ASSERT(src_size == dst_size);
+      if (src_size == 4) {
+        // Zero-extended single bits: a float in a GPR doubleword (ELFv2
+        // variadic, or after f13 is used up) is its low word.
+        __ FloatBitsToRegister(dst_reg, src_reg);
+      } else {
+        ASSERT(src_size == 8);
+        __ mfvsrd(dst_reg, src_reg);
+      }
+      return;
+    }
+
+    if (destination.IsFpuRegisters()) {
+      // We have not implemented conversions here, use IL convert
+      // instructions. A float is a double-format value: fmr moves either.
+      ASSERT(src_type.Equals(dst_type));
+      __ MoveUnboxedDouble(destination.AsFpuRegisters().fpu_reg(), src_reg);
+      return;
+    }
+
+    ASSERT(destination.IsStack());
+    const auto& dst = destination.AsStack();
+    switch (dst_size) {
+      case 8:
+        __ StoreDToOffset(src_reg, dst.base_register(), dst.offset_in_bytes());
+        return;
+      case 4:
+        // frsp; stfs: the low-addressed word of a stack doubleword.
+        __ StoreSToOffset(src_reg, dst.base_register(), dst.offset_in_bytes());
+        return;
+      default:
+        UNREACHABLE();
+    }
+  }
+
+  ASSERT(source.IsStack());
+  const auto& src = source.AsStack();
+  if (destination.IsRegisters()) {
+    const auto& dst = destination.AsRegisters();
+    ASSERT(dst.num_regs() == 1);
+    EmitNativeLoad(dst.reg_at(0), src.base_register(), src.offset_in_bytes(),
+                   src_type.AsPrimitive().representation());
+    return;
+  }
+  if (destination.IsFpuRegisters()) {
+    ASSERT(src_type.Equals(dst_type));
+    ASSERT(src_type.IsFloat());
+    const FpuRegister dst_reg = destination.AsFpuRegisters().fpu_reg();
+    switch (src_size) {
+      case 8:
+        __ LoadDFromOffset(dst_reg, src.base_register(), src.offset_in_bytes());
+        return;
+      case 4:
+        __ LoadSFromOffset(dst_reg, src.base_register(), src.offset_in_bytes());
+        return;
+      default:
+        UNREACHABLE();
+    }
+  }
+  ASSERT(destination.IsStack());
+  UNREACHABLE();  // Split by the shared EmitNativeMove.
+}
+
+// Loads exactly the payload and extends it to 64 bits by its signedness. The
+// odd sizes (3, 5, 6, 7 bytes: the tail chunk of an aggregate) are composed
+// in TMP and R0, which are never the destination or the base here (TMP is
+// not allocatable; R0 is never a base). The high part is loaded first, so
+// that |dst| may equal |base|.
+void FlowGraphCompiler::EmitNativeLoad(Register dst,
+                                       Register base,
+                                       intptr_t offset,
+                                       compiler::ffi::PrimitiveType type) {
+  ASSERT(dst != TMP && base != TMP);
+  switch (type) {
+    case compiler::ffi::kInt8:
+      __ LoadFromOffset(dst, base, offset, compiler::kByte);  // lbz ; extsb
+      return;
+    case compiler::ffi::kUint8:
+      __ LoadFromOffset(dst, base, offset, compiler::kUnsignedByte);
+      return;
+    case compiler::ffi::kInt16:
+      __ LoadFromOffset(dst, base, offset, compiler::kTwoBytes);  // lha
+      return;
+    case compiler::ffi::kUint16:
+      __ LoadFromOffset(dst, base, offset, compiler::kUnsignedTwoBytes);
+      return;
+    case compiler::ffi::kInt32:
+      __ LoadFromOffset(dst, base, offset, compiler::kFourBytes);  // lwa
+      return;
+    case compiler::ffi::kUint32:
+    case compiler::ffi::kFloat:
+      __ LoadFromOffset(dst, base, offset, compiler::kUnsignedFourBytes);
+      return;
+    case compiler::ffi::kInt64:
+    case compiler::ffi::kUint64:
+    case compiler::ffi::kDouble:
+      __ LoadFromOffset(dst, base, offset, compiler::kEightBytes);
+      return;
+    default:
+      break;
+  }
+
+  // 3-byte payloads: 2 + 1. 5/6-byte: 4 + 1/2. 7-byte: 4 + 2 + 1.
+  const bool is_signed = type == compiler::ffi::kInt24 ||
+                         type == compiler::ffi::kInt40 ||
+                         type == compiler::ffi::kInt48 ||
+                         type == compiler::ffi::kInt56;
+  switch (type) {
+    case compiler::ffi::kInt24:
+    case compiler::ffi::kUint24:
+      __ LoadFromOffset(TMP, base, offset + 2,
+                        is_signed ? compiler::kByte : compiler::kUnsignedByte);
+      __ sldi(TMP, TMP, 16);
+      __ LoadFromOffset(dst, base, offset, compiler::kUnsignedTwoBytes);
+      __ or_(dst, dst, TMP);
+      return;
+    case compiler::ffi::kInt40:
+    case compiler::ffi::kUint40:
+      __ LoadFromOffset(TMP, base, offset + 4,
+                        is_signed ? compiler::kByte : compiler::kUnsignedByte);
+      __ sldi(TMP, TMP, 32);
+      __ LoadFromOffset(dst, base, offset, compiler::kUnsignedFourBytes);
+      __ or_(dst, dst, TMP);
+      return;
+    case compiler::ffi::kInt48:
+    case compiler::ffi::kUint48:
+      __ LoadFromOffset(
+          TMP, base, offset + 4,
+          is_signed ? compiler::kTwoBytes : compiler::kUnsignedTwoBytes);
+      __ sldi(TMP, TMP, 32);
+      __ LoadFromOffset(dst, base, offset, compiler::kUnsignedFourBytes);
+      __ or_(dst, dst, TMP);
+      return;
+    case compiler::ffi::kInt56:
+    case compiler::ffi::kUint56:
+      __ LoadFromOffset(TMP, base, offset + 6,
+                        is_signed ? compiler::kByte : compiler::kUnsignedByte);
+      __ sldi(TMP, TMP, 16);
+      __ LoadFromOffset(R0, base, offset + 4, compiler::kUnsignedTwoBytes);
+      __ or_(TMP, TMP, R0);
+      __ sldi(TMP, TMP, 32);
+      __ LoadFromOffset(dst, base, offset, compiler::kUnsignedFourBytes);
+      __ or_(dst, dst, TMP);
+      return;
+    default:
+      UNREACHABLE();
+  }
+}
+
+#undef __
+#define __ (compiler->assembler())->
+
 }  // namespace dart
 
 #endif  // defined(TARGET_ARCH_PPC64)

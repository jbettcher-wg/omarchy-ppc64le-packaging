+// BinaryInt32OpInstr::IsSupported() is false on 64-bit targets (il.h), so the
+// instruction never reaches a 64-bit backend; every other 64-bit backend
+// defines it the same way. int32 arithmetic is done as int64 and converted.
+DEFINE_UNIMPLEMENTED_INSTRUCTION(BinaryInt32OpInstr)

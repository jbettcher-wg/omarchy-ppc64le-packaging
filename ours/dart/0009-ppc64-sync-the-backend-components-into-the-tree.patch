+// ============================================================================
+// uint32 arithmetic (zero-extended results, ABI-SPEC 7.6)
+// ============================================================================
+
+void BinaryUint32OpInstr::EmitShiftUint32(FlowGraphCompiler* compiler) {
+  Register left = locs()->in(0).reg();
+  Register out = locs()->out(0).reg();
+
+  if (locs()->in(1).IsConstant()) {
+    const int64_t shift = Integer::Cast(locs()->in(1).constant()).Value();
+    if (shift < 0) {
+      // The compiler sometimes fails to eliminate unreachable code.
+      __ Stop("Unreachable shift");
+      return;
+    }
+    ilb::EmitUint32ShiftByConstant(compiler->assembler(), op_kind(), out, left,
+                                   shift);
+  } else {
+    ilb::EmitUint32ShiftByRegister(
+        compiler->assembler(), op_kind(), out, left, locs()->in(1).reg(),
+        IsShiftCountInRange(kUint32ShiftCountLimit));
+  }
+}
+
+LocationSummary* BinaryUint32OpInstr::MakeLocationSummary(Zone* zone,
+                                                          bool opt) const {
+  const intptr_t kNumInputs = 2;
+  const intptr_t kNumTemps = 0;
+  LocationSummary* summary = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  summary->set_in(0, Location::RequiresRegister());
+  summary->set_in(1, LocationRegisterOrConstant(right()));
+  summary->set_out(0, Location::RequiresRegister());
+  return summary;
+}
+
+void BinaryUint32OpInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  if ((op_kind() == Token::kSHL) || (op_kind() == Token::kSHR) ||
+      (op_kind() == Token::kUSHR)) {
+    EmitShiftUint32(compiler);
+    return;
+  }
+  Register out = locs()->out(0).reg();
+  Register left = locs()->in(0).reg();
+  if (locs()->in(1).IsConstant()) {
+    int64_t right;
+    const bool ok = compiler::HasIntegerValue(locs()->in(1).constant(), &right);
+    RELEASE_ASSERT(ok);
+    ilb::EmitUint32OpImmediate(compiler->assembler(), op_kind(), out, left,
+                               right);
+  } else {
+    ilb::EmitUint32Op(compiler->assembler(), op_kind(), out, left,
+                      locs()->in(1).reg());
+  }
+}
+
+LocationSummary* UnaryUint32OpInstr::MakeLocationSummary(Zone* zone,
+                                                         bool opt) const {
+  const intptr_t kNumInputs = 1;
+  const intptr_t kNumTemps = 0;
+  LocationSummary* summary = new (zone)
+      LocationSummary(zone, kNumInputs, kNumTemps, LocationSummary::kNoCall);
+  summary->set_in(0, Location::RequiresRegister());
+  summary->set_out(0, Location::RequiresRegister());

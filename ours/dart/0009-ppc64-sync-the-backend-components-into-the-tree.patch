+    __ SmiUntag(TMP, right);
+    __ CompareImmediate(TMP, 63);
+    __ BranchIf(LESS_EQUAL, &in_bounds, compiler::Assembler::kNearJump);
+    __ li(TMP, 63);
+    __ Bind(&in_bounds);
+  }
+  __ SmiUntag(TMP2, left);
+  __ srad(result, TMP2, TMP);
+  __ SmiTag(result);
+}
+
+// result = left >>> right (tagged). A count above 63 gives 0. |overflow| (or
+// nullptr) is taken when the result does not fit a Smi.
+static void EmitSmiUshrByRegister(compiler::Assembler* assembler,
+                                  Register result,
+                                  Register left,
+                                  Register right,
+                                  compiler::Label* negative,
+                                  bool count_in_range,
+                                  compiler::Label* overflow) {
+  if (negative != nullptr) {
+    __ CompareImmediate(right, 0);
+    __ BranchIf(LESS, negative);
+  }
+  compiler::Label done;
+  if (count_in_range) {
+    UntagShiftCount(assembler, TMP, right);
+  } else {
+    compiler::Label in_bounds;
+    __ SmiUntag(TMP, right);
+    __ CompareImmediate(TMP, 63);
+    __ BranchIf(LESS_EQUAL, &in_bounds, compiler::Assembler::kNearJump);
+    __ li(result, 0);
+    __ Jump(&done, compiler::Assembler::kNearJump);
+    __ Bind(&in_bounds);
+  }
+  __ SmiUntag(TMP2, left);
+  __ srd(TMP, TMP2, TMP);
+  __ SmiTag(result, TMP);
+  if (overflow != nullptr) {
+    __ SmiUntag(TMP2, result);
+    __ CompareRegisters(TMP, TMP2);
+    __ BranchIf(NOT_EQUAL, overflow);
+  }
+  __ Bind(&done);
+}
+
+static void EmitSmiUshrByConstant(compiler::Assembler* assembler,
+                                  Register result,
+                                  Register left,
+                                  int64_t value,
+                                  compiler::Label* overflow) {
+  ASSERT((value >= 0) && (value <= 63));
+  __ SmiUntag(TMP, left);
+  __ srdi(TMP, TMP, value);
+  __ SmiTag(result, TMP);
+  if (overflow != nullptr) {
+    __ SmiUntag(TMP2, result);
+    __ CompareRegisters(TMP, TMP2);
+    __ BranchIf(NOT_EQUAL, overflow);
+  }
+}
+
+static void EmitSmiShrByConstant(compiler::Assembler* assembler,
+                                 Register result,
+                                 Register left,
+                                 int64_t value) {
+  ASSERT(value >= 0);
+  __ sradi(result, left, Utils::Minimum<int64_t>(value + kSmiTagSize, 63));
+  __ SmiTag(result);
+}
+
+// result = left ~/ value for a power-of-two constant |value| (+ or -),
+// rounding toward zero.
+static void EmitSmiTruncDivByPowerOfTwo(compiler::Assembler* assembler,
+                                        Register result,
+                                        Register left,
+                                        int64_t value) {
+  ASSERT(value != kMinInt64);
+  ASSERT(Utils::IsPowerOfTwo(Utils::Abs(value)));
+  const int64_t shift_count =
+      Utils::ShiftForPowerOfTwo(Utils::Abs(value)) + kSmiTagSize;
+  ASSERT((shift_count > 1) && (shift_count <= 63));
+  __ sradi(TMP, left, 63);
+  __ srdi(TMP, TMP, 64 - shift_count);  // bias: 2^shift - 1 if negative
+  __ add(TMP2, left, TMP);
+  __ sradi(result, TMP2, shift_count);
+  if (value < 0) {
+    __ neg(result, result);
+  }
+  __ SmiTag(result);
+}
+
+// result = left ~/ right or left % right on tagged Smis (Dart semantics: %
+// is never negative). The untagged operands are at most 2^62 in magnitude,
+// so divd's undefined INT64_MIN / -1 cannot occur; a zero divisor branches
+// to |zero| (nullptr when range analysis excluded it); MIN_SMI ~/ -1, which
+// does not fit a Smi, branches to |minus_one| (nullptr when excluded).
+static void EmitSmiDivMod(compiler::Assembler* assembler,
+                          Token::Kind op,
+                          Register result,
+                          Register left,
+                          Register right,
+                          compiler::Label* zero,
+                          compiler::Label* minus_one) {
+  if (zero != nullptr) {
+    __ CompareImmediate(right, 0);
+    __ BranchIf(EQUAL, zero);
+  }
+  __ SmiUntag(TMP, left);
+  __ SmiUntag(TMP2, right);
+  if (op == Token::kTRUNCDIV) {
+    __ divd(TMP, TMP, TMP2);
+    __ SmiTag(result, TMP);
+    if (minus_one != nullptr) {
+      __ SmiUntag(TMP2, result);
+      __ CompareRegisters(TMP, TMP2);
+      __ BranchIf(NOT_EQUAL, minus_one);
+    }
+    return;
+  }
+  ASSERT(op == Token::kMOD);
+  // No modsd on POWER8: r = a - (a / b) * b, with the sign of a.
+  __ divd(R0, TMP, TMP2);
+  __ mulld(R0, R0, TMP2);
+  __ subf(result, R0, TMP);
+  //  if (r < 0) r += (b < 0) ? -b : b;
+  compiler::Label done, adjust;
+  __ CompareImmediate(result, 0);
+  __ BranchIf(GREATER_EQUAL, &done, compiler::Assembler::kNearJump);
+  __ CompareImmediate(TMP2, 0);
+  __ BranchIf(GREATER_EQUAL, &adjust, compiler::Assembler::kNearJump);
+  __ subf(result, TMP2, result);
+  __ Jump(&done, compiler::Assembler::kNearJump);
+  __ Bind(&adjust);
+  __ add(result, result, TMP2);
+  __ Bind(&done);
+  __ SmiTag(result);
+}
+
+// TruncDivMod: div = left ~/ right, mod = left % right (tagged Smis).
+static void EmitSmiTruncDivMod(compiler::Assembler* assembler,
+                               Register result_div,
+                               Register result_mod,
+                               Register left,
+                               Register right,
+                               compiler::Label* zero,
+                               bool divisor_positive,
+                               bool divisor_negative,
+                               compiler::Label* minus_one) {
+  ASSERT(result_div != result_mod);
+  if (zero != nullptr) {
+    __ CompareImmediate(right, 0);
+    __ BranchIf(EQUAL, zero);
+  }
+  __ SmiUntag(TMP, left);
+  __ SmiUntag(TMP2, right);
+  __ divd(result_div, TMP, TMP2);  // |TMP| <= 2^62
+  __ mulld(R0, result_div, TMP2);
+  __ subf(result_mod, R0, TMP);
+  compiler::Label done, adjust;
+  __ CompareImmediate(result_mod, 0);
+  __ BranchIf(GREATER_EQUAL, &done, compiler::Assembler::kNearJump);
+  if (divisor_negative) {
+    __ subf(result_mod, TMP2, result_mod);
+  } else if (divisor_positive) {
+    __ add(result_mod, result_mod, TMP2);
+  } else {
+    __ CompareImmediate(TMP2, 0);
+    __ BranchIf(GREATER_EQUAL, &adjust, compiler::Assembler::kNearJump);
+    __ subf(result_mod, TMP2, result_mod);
+    __ Jump(&done, compiler::Assembler::kNearJump);
+    __ Bind(&adjust);
+    __ add(result_mod, result_mod, TMP2);
+  }
+  __ Bind(&done);
+  if (minus_one != nullptr) {
+    // MIN_SMI ~/ -1 does not fit a Smi.
+    __ MoveRegister(TMP, result_div);
+    __ SmiTag(result_div);
+    __ SmiTag(result_mod);
+    __ SmiUntag(TMP2, result_div);
+    __ CompareRegisters(TMP, TMP2);
+    __ BranchIf(NOT_EQUAL, minus_one);
+  } else {
+    __ SmiTag(result_div);
+    __ SmiTag(result_mod);
+  }
+}
+
+// result = -value (tagged). Only MIN_SMI (raw INT64_MIN) overflows, and it
+// is the only value for which -x and x are both negative. Alias-safe.
+static void EmitSmiNegate(compiler::Assembler* assembler,
+                          Register result,
+                          Register value,
+                          compiler::Label* overflow) {
+  ASSERT((result != R0) && (value != R0) && (value != TMP));
+  __ neg(R0, value);
+  __ and_rc(TMP, R0, value);  // CR0[LT] = sign(-x & x)
+  __ mr(result, R0);
+  __ BranchIfCR(true, CRF0, kCRBitLT, overflow);
+}
+
+// ----- int64 (BinaryInt64Op, UnaryInt64Op) ----------------------------------
+
+// out = left ~/ right or left % right (Dart semantics) on int64. A zero
+// divisor branches to |zero| (nullptr when range analysis excluded it).
+// -1 is special-cased unless excluded: divd is undefined for
+// INT64_MIN / -1, where Dart gives INT64_MIN (~/) and 0 (%). |tmp| is needed
+// for kMOD only; |out| may alias |left| or |right|.
+static void EmitInt64DivMod(compiler::Assembler* assembler,
+                            Token::Kind op,
+                            Register out,
+                            Register left,
+                            Register right,
+                            Register tmp,
+                            compiler::Label* zero,
+                            bool right_can_be_minus_one,
+                            bool right_is_positive,
+                            bool right_is_negative) {
+  if (zero != nullptr) {
+    __ CompareImmediate(right, 0);
+    __ BranchIf(EQUAL, zero);
+  }
+  compiler::Label done;
+  if (op == Token::kTRUNCDIV) {
+    if (right_can_be_minus_one) {
+      compiler::Label not_minus_one;
+      __ CompareImmediate(right, -1);
+      __ BranchIf(NOT_EQUAL, &not_minus_one, compiler::Assembler::kNearJump);
+      __ neg(out, left);  // INT64_MIN ~/ -1 == INT64_MIN
+      __ Jump(&done, compiler::Assembler::kNearJump);
+      __ Bind(&not_minus_one);
+    }
+    __ divd(out, left, right);
+    __ Bind(&done);
+    return;
+  }
+  ASSERT(op == Token::kMOD);
+  ASSERT((tmp != kNoRegister) && (tmp != out) && (tmp != left) &&
+         (tmp != right));
+  if (right_can_be_minus_one) {
+    __ li(tmp, 0);  // x % -1 == 0
+    __ CompareImmediate(right, -1);
+    __ BranchIf(EQUAL, &done, compiler::Assembler::kNearJump);
+  }
+  __ divd(tmp, left, right);
+  __ mulld(tmp, tmp, right);
+  __ subf(tmp, tmp, left);  // left - (left / right) * right, sign of left
+  __ CompareImmediate(tmp, 0);
+  __ BranchIf(GREATER_EQUAL, &done, compiler::Assembler::kNearJump);
+  if (right_is_positive) {
+    __ add(tmp, tmp, right);
+  } else if (right_is_negative) {
+    __ subf(tmp, right, tmp);
+  } else {
+    compiler::Label subtract;
+    __ CompareImmediate(right, 0);
+    __ BranchIf(LESS, &subtract, compiler::Assembler::kNearJump);
+    __ add(tmp, tmp, right);
+    __ Jump(&done, compiler::Assembler::kNearJump);
+    __ Bind(&subtract);
+    __ subf(tmp, right, tmp);
+  }
+  __ Bind(&done);
+  __ MoveRegister(out, tmp);
+}
+
+// out = left op shift, 0 <= shift <= 63 in a register; any other count
+// (unsigned > 63, so also a negative one) branches to |out_of_range|
+// (nullptr when range analysis proved 0..63).
+static void EmitInt64ShiftByRegister(compiler::Assembler* assembler,
+                                     Token::Kind op,
+                                     Register out,
+                                     Register left,
+                                     Register shift,
+                                     compiler::Label* out_of_range) {
+  if (out_of_range != nullptr) {
+    __ CompareImmediate(shift, 63);
+    __ BranchIf(UNSIGNED_GREATER, out_of_range);
+  }
+  MaskShiftCount(assembler, TMP, shift);
+  switch (op) {
+    case Token::kSHR:
+      __ srad(out, left, TMP);
+      break;
+    case Token::kUSHR:
+      __ srd(out, left, TMP);
+      break;
+    case Token::kSHL:
+      __ sld(out, left, TMP);
+      break;
+    default:
+      UNREACHABLE();
+  }
+}
+
+static void EmitInt64ShiftByConstant(compiler::Assembler* assembler,
+                                     Token::Kind op,
+                                     Register out,
+                                     Register left,
+                                     int64_t shift) {
+  ASSERT(shift >= 0);
+  switch (op) {
+    case Token::kSHR:
+      __ sradi(out, left, Utils::Minimum<int64_t>(shift, 63));
+      break;
+    case Token::kUSHR:
+      ASSERT(shift < 64);
+      __ srdi(out, left, shift);
+      break;
+    case Token::kSHL:
+      ASSERT(shift < 64);
+      __ sldi(out, left, shift);
+      break;
+    default:
+      UNREACHABLE();
+  }
+}
+
+// The slow path of EmitInt64ShiftByRegister: a count > 63 gives the sign
+// fill (>>) or 0 (<<, >>>); a negative count branches to |negative|.
+static void EmitInt64ShiftOutOfRange(compiler::Assembler* assembler,
+                                     Token::Kind op,
+                                     Register out,
+                                     Register left,
+                                     Register shift,
+                                     compiler::Label* negative) {
+  ASSERT((out != left) && (out != shift));
+  __ CompareImmediate(shift, 0);
+  __ BranchIf(LESS, negative);
+  switch (op) {
+    case Token::kSHR:
+      __ sradi(out, left, 63);
+      break;
+    case Token::kUSHR:
+    case Token::kSHL:
+      __ li(out, 0);
+      break;
+    default:
+      UNREACHABLE();
+  }
+}
+
+// ----- Misc -------------------------------------------------------------------
+
+// result = SmiTag(Multiply64Hash(value) & 0x3fffffff); keep in sync with
+// lib/integers.cc Multiply64Hash. |value| is untagged and is clobbered;
+// result != value.
+static void EmitHashInteger(compiler::Assembler* assembler,
+                            Register result,
+                            Register value) {
+  ASSERT((result != value) && (result != R0) && (value != R0));
+  __ li(R0, 0x2d51);
+  __ mulld(result, value, R0);   // low 64 bits of the 128-bit product
+  __ mulhdu(value, value, R0);   // high 64 bits (unsigned)
+  __ xor_(result, result, value);
+  __ srdi(value, result, 32);
+  __ xor_(result, result, value);
+  __ AndImmediate(result, result, 0x3fffffff);
+  __ SmiTag(result);
+}
+
+// dst = value clamped to 0..255 (Uint8ClampedList), value a full int64.
+static void EmitClampToUint8(compiler::Assembler* assembler,
+                             Register dst,
+                             Register value) {
+  ASSERT((dst != value) && (dst != R0) && (value != R0));
+  __ li(dst, 0xff);
+  __ cmpd(CRF0, value, dst);
+  __ isel(dst, dst, value, CRBitIndex(CRF0, kCRBitGT));  // > 255 ? 255 : v
+  __ cmpdi(CRF0, dst, 0);
+  __ isel(dst, kNoRegister, dst, CRBitIndex(CRF0, kCRBitLT));  // < 0 ? 0
+}
+
+// IfThenElse: result = cond ? Smi(true_value) : Smi(false_value), consuming
+// the pending deferred compare.
+static void EmitSelectSmi(compiler::Assembler* assembler,
+                          Condition true_condition,
+                          Register result,
+                          int64_t true_value,
+                          int64_t false_value) {
+  const int64_t diff = Utils::SubWithWrapAround(false_value, true_value);
+  if ((true_value == 0) || ((diff > 0) && Utils::IsPowerOfTwo(diff))) {
+    const int64_t t = true_value;
+    true_value = false_value;
+    false_value = t;
+    true_condition = InvertCondition(true_condition);
+  }
+  const int64_t val =
+      Utils::SubWithWrapAround(RawSmi(true_value), RawSmi(false_value));
+  if ((val > 0) && Utils::IsPowerOfTwo(val)) {
+    __ SetIf(true_condition, result);
+    __ sldi(result, result, Utils::ShiftForPowerOfTwo(val));
+  } else {
+    __ SetIf(InvertCondition(true_condition), result);
+    __ AddImmediate(result, -1);
+    __ AndImmediate(result, result, val);
+  }
+  if (false_value != 0) {
+    __ AddImmediate(result, RawSmi(false_value));
+  }
+}
+
+// Unboxed double compare of EqualityCompare/RelationalOp. The NaN-correct
+// condition (ABI-SPEC 7.7) is materialised into TMP by SetIfDouble and
+// turned into a deferred integer compare, so the caller's single
+// BranchIf/SetIf consumes it like any other condition.
+static Condition EmitDoubleComparison(compiler::Assembler* assembler,
+                                      Token::Kind kind,
+                                      FpuRegister left,
+                                      FpuRegister right) {
+  Condition cond;
+  switch (kind) {
+    case Token::kEQ:
+      cond = EQUAL;
+      break;
+    case Token::kNE:
+      cond = NOT_EQUAL;  // true when either is NaN
+      break;
+    case Token::kLT:
+      cond = LESS;
+      break;
+    case Token::kGT:
+      cond = GREATER;
+      break;
+    case Token::kLTE:
+      cond = LESS_EQUAL;
+      break;
+    case Token::kGTE:
+      cond = GREATER_EQUAL;
+      break;
+    default:
+      UNREACHABLE();
+  }
+  __ DoubleCompare(left, right);
+  __ SetIfDouble(cond, TMP);
+  __ CompareImmediate(TMP, 0);
+  return NOT_EQUAL;
+}
+
+#undef __
+#define __ (compiler->assembler())->
+// --- END IL-B SEQUENCES ---
+
+// or_ through OrRegisters, from IL code.
+static void EmitOr(FlowGraphCompiler* compiler,
+                   Register dst,
+                   Register a,
+                   Register b) {
+  OrRegisters(compiler->assembler(), dst, a, b);
+}
+
+// FP loads/stores take a base and a displacement: an element address with an
+// index register is folded into TMP first.
+static void SplitAddress(FlowGraphCompiler* compiler,
+                         const compiler::Address& address,
+                         Register* base,
+                         int32_t* offset) {
+  if (address.has_index()) {
+    __ add(TMP, address.base(), address.index());
+    *base = TMP;
+    *offset = 0;
+  } else {
+    *base = address.base();
+    *offset = address.offset();
+  }
+}
+
+static Condition EmitSmiComparisonOp(FlowGraphCompiler* compiler,
+                                     const LocationSummary& locs,
+                                     Token::Kind kind) {
+  Location left = locs.in(0);
+  Location right = locs.in(1);
+
+  Condition true_condition =
+      TokenKindToIntCondition(kind, /*is_unsigned=*/false);
+  if (right.IsConstant()) {
+    __ CompareObject(left.reg(), right.constant());
+  } else {
+    __ CompareObjectRegisters(left.reg(), right.reg());
+  }
+  return true_condition;
+}
+
+// int32/uint32 operands are canonical (ABI-SPEC 7.6), so a 64-bit register
+// compare is exact for them too; constants are compared at their width.
+static Condition EmitUnboxedIntComparisonOp(FlowGraphCompiler* compiler,
+                                            const LocationSummary& locs,
+                                            Token::Kind kind,
+                                            Representation rep) {
+  Location left = locs.in(0);
+  Location right = locs.in(1);
+  ASSERT((rep == kUnboxedInt64) || (rep == kUnboxedInt32) ||
+         (rep == kUnboxedUint32));
+  const compiler::OperandSize size =
+      (rep == kUnboxedInt64) ? compiler::kEightBytes : compiler::kFourBytes;
+
+  Condition true_condition = TokenKindToIntCondition(
+      kind, RepresentationUtils::IsUnsignedInteger(rep));
+  if (right.IsConstant()) {
+    int64_t value;
+    const bool ok = compiler::HasIntegerValue(right.constant(), &value);
+    RELEASE_ASSERT(ok);
+    __ CompareImmediate(left.reg(), value, size);
+  } else {
+    __ CompareRegisters(left.reg(), right.reg());
+  }
+  return true_condition;
+}
+
+static Condition EmitNullAwareInt64ComparisonOp(FlowGraphCompiler* compiler,
+                                                const LocationSummary& locs,
+                                                Token::Kind kind,
+                                                BranchLabels labels) {
+  ASSERT((kind == Token::kEQ) || (kind == Token::kNE));
+  const Register left = locs.in(0).reg();
+  const Register right = locs.in(1).reg();
+  const Condition true_condition =
+      TokenKindToIntCondition(kind, /*is_unsigned=*/false);
+  compiler::Label* equal_result =
+      (true_condition == EQ) ? labels.true_label : labels.false_label;
+  compiler::Label* not_equal_result =
+      (true_condition == EQ) ? labels.false_label : labels.true_label;
+
+  // Check if operands have the same value. If they don't, then they could
+  // be equal only if both of them are Mints with the same value.
+  __ CompareObjectRegisters(left, right);
+  __ BranchIf(EQ, equal_result);
+  __ and_(TMP, left, right);
+  __ BranchIfSmi(TMP, not_equal_result);
+  __ CompareClassId(left, kMintCid, TMP);
+  __ BranchIf(NE, not_equal_result);
+  __ CompareClassId(right, kMintCid, TMP);
+  __ BranchIf(NE, not_equal_result);
+  __ LoadFieldFromOffset(TMP, left, compiler::target::Mint::value_offset());
+  __ LoadFieldFromOffset(TMP2, right, compiler::target::Mint::value_offset());
+  __ CompareRegisters(TMP, TMP2);
+  return true_condition;
+}
+
+// ----- MemoryCopy helpers ----------------------------------------------------
+
+// Unsigned sizes: a copy needs no extension (and kByte would add extsb).
+static compiler::OperandSize CopySizeFor(intptr_t bytes) {
+  switch (bytes) {
+    case 1:
+      return compiler::kUnsignedByte;
+    case 2:
+      return compiler::kUnsignedTwoBytes;
+    case 4:
+      return compiler::kUnsignedFourBytes;
+    case 8:
+      return compiler::kEightBytes;
+    default:
+      UNREACHABLE();
+      return compiler::kEightBytes;
+  }
+}
+
+// Copies |count| bytes from [src_reg] to [dest_reg] and advances both. If
+// |reversed|, both point one past the end of their regions and move down.
+static void CopyBytes(FlowGraphCompiler* compiler,
+                      Register dest_reg,
+                      Register src_reg,
+                      intptr_t count,
+                      bool reversed) {
+  ASSERT(Utils::IsPowerOfTwo(count));
+  if (count == 16) {
+    const auto sz = compiler::kEightBytes;
+    const intptr_t offset = (reversed ? -1 : 1) * 8;
+    const intptr_t initial = reversed ? offset : 0;
+    __ LoadFromOffset(TMP, src_reg, initial, sz);
+    __ LoadFromOffset(TMP2, src_reg, initial + offset, sz);
+    __ AddImmediate(src_reg, 2 * offset);
+    __ StoreToOffset(TMP, dest_reg, initial, sz);
+    __ StoreToOffset(TMP2, dest_reg, initial + offset, sz);
+    __ AddImmediate(dest_reg, 2 * offset);
+    return;
+  }
+  ASSERT(count <= 8);
+  const auto sz = CopySizeFor(count);
+  const intptr_t offset = (reversed ? -1 : 1) * count;
+  const intptr_t initial = reversed ? offset : 0;
+  __ LoadFromOffset(TMP, src_reg, initial, sz);
+  __ AddImmediate(src_reg, offset);
+  __ StoreToOffset(TMP, dest_reg, initial, sz);
+  __ AddImmediate(dest_reg, offset);
+}
+
+static void CopyUpToWordMultiple(FlowGraphCompiler* compiler,
+                                 Register dest_reg,
+                                 Register src_reg,
+                                 Register length_reg,
+                                 intptr_t element_size,
+                                 bool unboxed_inputs,
+                                 bool reversed,
+                                 compiler::Label* done) {
+  ASSERT(Utils::IsPowerOfTwo(element_size));
+  if (element_size >= compiler::target::kWordSize) return;
+
+  const intptr_t element_shift = Utils::ShiftForPowerOfTwo(element_size);
+  const intptr_t base_shift =
+      (unboxed_inputs ? 0 : kSmiTagShift) - element_shift;
+  intptr_t tested_bits = 0;
+
+  __ Comment("Copying until region is a multiple of word size");
+
+  for (intptr_t bit = compiler::target::kWordSizeLog2 - 1; bit >= element_shift;
+       bit--) {
+    const intptr_t bytes = 1 << bit;
+    const intptr_t tested_bit = bit + base_shift;
+    tested_bits |= 1 << tested_bit;
+    compiler::Label skip_copy;
+    __ TestImmediate(length_reg, 1 << tested_bit);
+    __ BranchIf(ZERO, &skip_copy);
+    CopyBytes(compiler, dest_reg, src_reg, bytes, reversed);
+    __ Bind(&skip_copy);
+  }
+
+  ASSERT(tested_bits != 0);

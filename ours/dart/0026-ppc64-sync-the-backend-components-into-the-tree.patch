diff --git a/runtime/vm/compiler/assembler/assembler_ppc64.cc b/runtime/vm/compiler/assembler/assembler_ppc64.cc
index 7d22c8cc..0b1a8ef1 100644
--- a/runtime/vm/compiler/assembler/assembler_ppc64.cc
+++ b/runtime/vm/compiler/assembler/assembler_ppc64.cc
@@ -879,6 +879,16 @@ void Assembler::PopNativeCalleeSavedRegisters() {
   addi(SP, SP, kNativeCalleeSavedSize);
 }
 
+void Assembler::SaveCalleeSavedCR() {
+  mfcr(R0);
+  stw(R0, SP, kElfV2CrSaveOffset);
+}
+
+void Assembler::RestoreCalleeSavedCR() {
+  lwz(R0, SP, kElfV2CrSaveOffset);
+  mtcrf_callee_saved(R0);
+}
+
 void Assembler::CheckFpSpDist(intptr_t fp_sp_dist) {
   ASSERT(fp_sp_dist <= 0);
 #if defined(DEBUG)
diff --git a/runtime/vm/compiler/assembler/assembler_ppc64.h b/runtime/vm/compiler/assembler/assembler_ppc64.h
index e98bfb1f..f57fc97f 100644
--- a/runtime/vm/compiler/assembler/assembler_ppc64.h
+++ b/runtime/vm/compiler/assembler/assembler_ppc64.h
@@ -771,6 +771,20 @@ class MicroAssembler : public AssemblerBase {
   void mfocrf(Register rt, CRField crf) {
     Emit32(kPpcMfocrf | EncodeRT(Gpr(rt)) | EncodeFXM(CrfSrc(crf)));
   }
+  // mtcrf 0x38,r0: cr2, cr3 and cr4 from bits 8..19 of r0. The ONLY way to
+  // write the callee-saved CR fields (ABI-SPEC A14): the two entries from C
+  // (InvokeDartCode, the FFI callback stub) restore their C caller's cr2-cr4
+  // with it, through RestoreCalleeSavedCR, because an exception caught in
+  // Dart skips the epilogues of the C++ frames that would have restored them.
+  // Fixed register and mask, so scan-isa.sh can allow exactly the idiom
+  // "lwz r0,8(r1); mtcrf 56,r0".
+  void mtcrf_callee_saved(Register rs) {
+    RELEASE_ASSERT(rs == R0);
+    Emit32(kPpcMtcrf | EncodeRT(Gpr(rs)) |
+           (static_cast<uint32_t>((0x80u >> CRF2) | (0x80u >> CRF3) |
+                                  (0x80u >> CRF4))
+            << 12));
+  }
 
   // ----- LR / CTR -----
   void mflr(Register rt) { EmitX(kPpcMflr, Gpr(rt), 0, 0); }
@@ -1354,6 +1368,13 @@ class Assembler : public MicroAssembler {
   // R14-R30 then F14-F31 (kAbiPreserved*), the layout of ABI-SPEC 3.2.
   void PushNativeCalleeSavedRegisters();  // [core]
   void PopNativeCalleeSavedRegisters();   // [core]
+  // ABI-SPEC A14: at an entry from C, before anything is pushed, save CR in
+  // the C caller's CR save word, 8(SP) (ELFv2: the callee owns it):
+  // mfcr r0 ; stw r0,8(r1).
+  void SaveCalleeSavedCR();  // [core]
+  // On every return to C, after the frame is gone (SP is the caller's again):
+  // lwz r0,8(r1) ; mtcrf 56,r0. Clobbers R0.
+  void RestoreCalleeSavedCR();  // [core]
   // In DEBUG mode traps unless SP - FP == fp_sp_dist (<= 0), as on RISC-V.
   // Clobbers TMP (DEBUG only).
   void CheckFpSpDist(intptr_t fp_sp_dist);  // [core]
diff --git a/runtime/vm/compiler/assembler/disassembler_ppc64.cc b/runtime/vm/compiler/assembler/disassembler_ppc64.cc

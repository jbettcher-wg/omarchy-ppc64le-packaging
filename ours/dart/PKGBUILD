  'ba142923a296afc0558f217c9906b4e0a8e3e338ba93f46eadc8b884ceadd729'
  'a1a3e4cd0b11ba659ac4f6a388424ecf1a3026079278b27311a911716367fc5f'
)
# END generated

source=(
  'dart-sdk-fetch.sh'
  'isa30-attribute.py'
  "devtools-$_devtools_rev.zip::https://chrome-infra-packages.appspot.com/dl/dart/third_party/flutter/devtools/+/git_revision:$_devtools_rev"
  "${_patches[@]}"
)
sha256sums=(
  'cad2179f9bab2899613d6713c591b1be75b2290b38633a3b87af9fc7d89238a3'
  'f38059bccfcca8c4d0a1a747b518015702ef5b16ecf835b029ecf7f2b1fd4d4e'
  'bd823b80fd88fa9cfadfbbafce06eb99f9df3c66f94ea04d494768d0344263be'
  "${_patch_sums[@]}"
)
# Unpacked by prepare() into the DEPS path it belongs to.
noextract=("devtools-$_devtools_rev.zip")

_out=out/ReleasePPC64   # tools/utils.py GetBuildConf('release', 'ppc64')

# The programs the prebuilt Dart may run, by basename of its first non-option
# argument, and the only snapshot kind it may be asked for. Measured
# 2026-11-19 from `ninja -t commands create_sdk runtime` (M5's graph and this
# recipe's): 39 prebuilt actions, all front end.
_leaf_programs='bootstrap_gen_kernel.dill compile_platform.dart create_snapshot_entry.dart dart2js.dart gen_kernel.dart'

_env() {
  # bq's $HOME is the real home: keep pub, dartdev and analytics out of it.
  export HOME="$srcdir/home" XDG_CONFIG_HOME="$srcdir/home/.config"
  export PUB_CACHE="$srcdir/pub-cache" DART_SUPPRESS_ANALYTICS=true
  mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$PUB_CACHE"
}

# Every DEPS path (git and CIPD), plus what the fetch writes, so the gates
# hash the SDK's own files and nothing a fetch put there.
_dep_paths() {
  bash "$srcdir/dart-sdk-fetch.sh" --list "$srcdir/sdk" | cut -f2
  printf '%s\n' buildtools build/config/gclient_args.gni
}

# _tree_of <repo dir> <pathspec excludes...>: the tree git would commit.
_tree_of() {
  local d=$1; shift
  git -C "$d" add -A -f -- . "$@"
  git -C "$d" write-tree
}

prepare() {
  _env
  [[ -n $_driver_sdk ]] || { echo "ERROR: no driver SDK for _driver=$_driver (external needs _cross_pool_bootstrap=1 and an absolute _driver_external)" >&2; return 1; }
  local root=$srcdir/sdk got p

  # Fresh every time: a tree left from an earlier run fails the gates,
  # correctly but uselessly.
  rm -rf "$root"
  mkdir "$root"
  git -C "$root" init -q
  git -C "$root" remote add origin "$_url"
  git -C "$root" fetch -q --depth 1 --no-tags origin "$_commit"
  git -C "$root" -c advice.detachedHead=false checkout -q FETCH_HEAD
  cd "$root"

  # Gate 1: the tag, in git's own terms.
  [[ $(git rev-parse HEAD) == "$_commit" ]] \
    || { echo "ERROR: SDK HEAD is $(git rev-parse HEAD), not $_commit" >&2; return 1; }
  got=$(git rev-parse 'HEAD^{tree}')
  [[ $got == "$_base_tree" ]] \
    || { printf 'ERROR: tag tree is %s, expected %s\n' "$got" "$_base_tree" >&2; return 1; }
  printf 'base tree %s = tag %s\n' "$got" "$pkgver"

  # DEPS: the 39 git deps, shallow, each checked against its pin by the tool
  # (it fails on any mismatch). Also writes build/config/gclient_args.gni.
  bash "$srcdir/dart-sdk-fetch.sh" --jobs 10 "$root"
  # devtools (CIPD, checksummed source). Extract over the directory: it holds
  # a README.md tracked by the SDK itself.
  mkdir -p third_party/devtools
  bsdtar -xf "$srcdir/devtools-$_devtools_rev.zip" -C third_party/devtools
  # The CIPD zip stores its entries 0600/0700, and create_sdk copies them
  # verbatim into bin/resources/devtools: the first package build shipped 433
  # files only root could read (`dart devtools` broken for every user).
  # DevTools is web content; normalise it. build() gates every mode.
  find third_party/devtools -type d -exec chmod 755 {} +
  find third_party/devtools -type f -exec chmod 644 {} +

  local -a excl
  while IFS= read -r p; do excl+=(":(exclude)$p"); done < <(_dep_paths)

  # The port series, from the SDK root (it reaches the BoringSSL and
  # dart-lang/native checkouts with ordinary paths).
  for p in "${_patches[@]}"; do
    printf 'Applying %s\n' "$p"
    patch -Np1 -F0 --no-backup-if-mismatch -s -i "$srcdir/$p"
  done

  # Gate 2 and the DEPS gates.
  got=$(_tree_of . "${excl[@]}")
  if (( ! ${#_patches[@]} )); then
    [[ $got == "$_base_tree" ]] || { echo "ERROR: no series, but the tree is $got" >&2; return 1; }
  else
    [[ $_tree != TODO ]] || { echo "ERROR: _tree is unset but the series is not empty (got $got)" >&2; return 1; }
    [[ $got == "$_tree" ]] \
      || { printf 'ERROR: patched SDK tree is %s, expected %s\n' "$got" "$_tree" >&2; return 1; }
  fi
  printf 'patched tree %s matches (%d patches)\n' "$got" "${#_patches[@]}"
  for p in "${!_dep_trees[@]}"; do
    got=$(_tree_of "$p")
    [[ $got == "${_dep_trees[$p]}" ]] \
      || { printf 'ERROR: %s patched tree is %s, expected %s\n' "$p" "$got" "${_dep_trees[$p]}" >&2; return 1; }
    printf '%s tree %s matches\n' "$p" "$got"
  done

  # What gclient's CIPD step would have installed, replaced by system tools
  # and the chosen driver. Everything below is AFTER the gates on purpose.
  # buildtools/ is not in the SDK at all; it is CIPD's destination.
  mkdir -p buildtools/ninja tools/sdks
  ln -sfn /usr/bin/gn buildtools/gn
  ln -sfn /usr/bin/ninja buildtools/ninja/ninja
  rm -rf tools/sdks/dart-sdk
  ln -sfn "$_driver_sdk" tools/sdks/dart-sdk

  # The driver runs in the hooks below, so check what it is now, before it
  # runs (build() checks it again together with the build graph).
  _control_driver_identity

  # The two DEPS hooks the build needs (Alpine runs the same pair); the
  # others are depot_tools/clang-format, Windows, emscripten, Fuchsia and
  # generated large tests.
  python3 tools/generate_package_config.py
  python3 tools/generate_sdk_version_file.py
}

build() {
  _env
  cd sdk

  local jobs="${NINJAFLAGS##*-j}"
  [[ $jobs =~ ^[0-9]+$ ]] || jobs="${MAKEFLAGS##*-j}"
  [[ $jobs =~ ^[0-9]+$ ]] || jobs=48

  local mcpu=power9
  (( _power8_compat )) && mcpu=power8
  # --host-arch so nothing probes uname (under POWERarm uname says aarch64).
  python3 tools/gn.py --mode=release --arch=ppc64 --host-arch=ppc64 --no-rbe \
    --gn-args "ppc64_cpu=\"$mcpu\""

  _control_mcpu "$_out"
  _control_graph "$_out"
  _control_driver_identity

  ninja -C "$_out" -j"$jobs" create_sdk runtime

  local stage=$srcdir/stage
  rm -rf "$stage"
  mkdir -p "$stage"
  cp -a "$_out/dart-sdk" "$stage/dart-sdk"
  _gate_elves "$stage/dart-sdk"
  _gate_modes "$stage/dart-sdk"
  _smoke "$stage/dart-sdk"
  _gate_isa30 "$stage/dart-sdk" "$_out"
}

# Every ELF about to be installed is a 64-bit little-endian PowerPC one whose
# LOAD segments are all 64 KiB-aligned (series 0004 pins -z max-page-size;
# Dart's own ELF writer, kElfPageSize, series 0006).
_gate_elves() {
  local f bad=0 n=0 al
  while IFS= read -r -d '' f; do
    [[ $(od -An -tx1 -N4 "$f") == " 7f 45 4c 46" ]] || continue
    n=$((n + 1))
    file -b "$f" | grep -q '64-bit LSB .*PowerPC' \
      || { echo "GATE FAILED: not a ppc64le ELF: ${f#"$1"/} ($(file -b "$f" | cut -d, -f1-2))" >&2; bad=1; continue; }
    al=$(readelf -lW "$f" | awk '$1 == "LOAD" { print $NF }' | sort -u | tr '\n' ' ')
    [[ $al == '0x10000 ' ]] \
      || { echo "GATE FAILED: ${f#"$1"/} LOAD alignment is '$al', not 0x10000" >&2; bad=1; }
  done < <(find "$1" -type f -print0)
  (( n > 0 )) || { echo "GATE FAILED: no ELF files in $1" >&2; return 1; }
  (( ! bad )) || return 1
  printf 'all %d ELF files are ppc64le with 64 KiB LOAD alignment\n' "$n"
}

# Every file readable, and every directory searchable, by everyone; nothing
# writable by group or other. package() copies modes verbatim (cp -a).
_gate_modes() {
  local bad
  bad=$(find "$1" \( -type f \( ! -perm -0444 -o -perm /0022 \) \) -o \
                  \( -type d \( ! -perm -0555 -o -perm /0022 \) \) | head -5)
  [[ -z $bad ]] || { echo "GATE FAILED: bad modes, e.g.:" >&2; ls -ld $bad >&2; return 1; }
  printf 'modes: every file world-readable, every directory world-searchable, none group/other-writable\n'
}

# Same method as omarchy-ppc64le tools/isa30-pkgscan.sh and the M5 AOT scan:
# objdump decodes an ISA 3.0-only encoding as .long under -M power8 but not
# under -M power9; data in text is .long under both and cancels.
_isa30_count() {
  local n8 n9
  n8=$(objdump -d --no-show-raw-insn -M power8 "$1" 2>/dev/null | grep -cP '^\s+[0-9a-f]+:\s+\.long\b' || true)
  n9=$(objdump -d --no-show-raw-insn -M power9 "$1" 2>/dev/null | grep -cP '^\s+[0-9a-f]+:\s+\.long\b' || true)
  echo $((n8 - n9))
}

# The scanner must be able to see what it gates: one ISA 3.0 word
# (xscvhpdp vs1,vs2 = 0xf030156c, from gas -mpower9) written over the last
# word of .text in a copy of $1 must count exactly one more.
_isa30_selftest() {
  local f=$1 c=$srcdir/isa30-selftest.elf off size base got
  read -r off size < <(readelf -SW "$f" | sed 's/\[ *\([0-9]*\)\]/[\1]/' \
                         | awk '$2 == ".text" { print strtonum("0x" $5), strtonum("0x" $6) }')
  [[ -n $off && -n $size ]] || { echo "GATE FAILED: no .text in $f for the scanner self-test" >&2; return 1; }
  base=$(_isa30_count "$f")
  cp "$f" "$c"
  printf '\x6c\x15\x30\xf0' | dd of="$c" bs=1 seek=$((off + size - 4)) conv=notrunc status=none
  got=$(_isa30_count "$c")
  rm -f "$c"
  (( got == base + 1 )) \
    || { echo "GATE FAILED: the ISA 3.0 scanner self-test counted $got, want $((base + 1))" >&2; return 1; }
  printf 'isa30 scanner self-test: %d -> %d with one injected xscvhpdp\n' "$base" "$got"
}

# Installed native ELF -> the unstripped binary in $_out that create_sdk
# stripped it from (sdk/BUILD.gn's *_stripped_binary args, as args.gn shows:
# exe.stripped/dart, dartvm, dartaotruntime_product, gen_snapshot_product,
# wasm-opt). isa30-attribute.py proves each pairing: identical .text.
declare -gA _unstripped=(
  [bin/dart]=dart
  [bin/dartvm]=dartvm
  [bin/dartaotruntime]=dartaotruntime_product
  [bin/utils/gen_snapshot]=gen_snapshot_product
  [bin/utils/wasm-opt]=wasm-opt
)

# AOT snapshots (the SDK's tools and the smoke snapshot) are generated code:
# 0 ISA 3.0 instructions in both pools. Native binaries are counted only in
# the POWER9 pool. In the baseline pool a native binary may carry ISA 3.0
# only inside libgcc's IFUNC'd IEEE-128 hardware routines (-static-libgcc:
# _divkc3-hw.o, _mulkc3-hw.o, _powikf2-hw.o, float128-hw.o, float128-p10.o),
# which the pool's policy lists as benign (omarchy-ppc64le CLAUDE.local.md,
# the 2026-09-23 sweep: "the IFUNC'd float128 hardware objects from libgcc,
# the same 253 the fixed libgcc.a keeps"). isa30-attribute.py proves it per
# function on the unstripped binary -- every word in such a routine, each
# routine reached only through its IFUNC resolver -- and the installed
# (stripped) count must equal the attributed total. Measured 2026-11-19 on
# the baseline lane: 253 words per binary, all of them there.
_gate_isa30() {
  local sdk=$1 out=${2:-} f n bad=0 kind libgcc attr total
  export -f _isa30_count
  : > "$srcdir/isa30.info"
  if (( _power8_compat )); then
    libgcc=$(clang --target=powerpc64le-linux-gnu -print-libgcc-file-name)
    [[ -f $libgcc ]] || { echo "GATE FAILED: no libgcc.a ($libgcc)" >&2; return 1; }
  fi
  while read -r n f; do
    if [[ $f == bin/snapshots/* ]]; then kind=aot-snapshot; else kind=native; fi
    printf 'isa30 %8d  %-13s %s\n' "$n" "$kind" "$f" | tee -a "$srcdir/isa30.info"
    if (( n != 0 )) && [[ $kind == aot-snapshot ]]; then
      echo "GATE FAILED: $n ISA 3.0 instructions in AOT snapshot $f (Dart codegen is ISA 2.07)" >&2; bad=1
    elif (( n != 0 && _power8_compat )); then
      if [[ -z $out || -z ${_unstripped[$f]:-} ]]; then
        echo "GATE FAILED: $n ISA 3.0 instructions in $f, and no unstripped binary to attribute them (baseline pool)" >&2
        bad=1; continue
      fi
      attr=$srcdir/isa30-attr-${f//\//_}.txt
      if ! python3 "$srcdir/isa30-attribute.py" --libgcc "$libgcc" --installed "$sdk/$f" \
             "$out/${_unstripped[$f]}" > "$attr" 2>&1; then
        cat "$attr" >&2
        echo "GATE FAILED: $f: ISA 3.0 attribution failed (baseline pool: only libgcc's IFUNC'd float128 routines are allowed; reasons above)" >&2
        bad=1; continue
      fi
      total=$(sed -n 's/^RESULT ok //p' "$attr")
      if [[ $total != "$n" ]]; then
        echo "GATE FAILED: $f has $n ISA 3.0 instructions installed, $total attributed in ${_unstripped[$f]}" >&2
        bad=1; continue
      fi
      sed -n 's/^  allowed *\([0-9]*\)  \([^ ]*\).*/isa30-allowed \2 \1/p' "$attr" | sed "s#^#  $f: #" \
        | tee -a "$srcdir/isa30.info"
      printf 'isa30-allowed-total %s %d (libgcc IFUNC float128 hardware routines only)\n' "$f" "$n" \
        | tee -a "$srcdir/isa30.info"
    fi
  done < <(cd "$sdk" && find . -type f -print0 \
             | xargs -0 -n1 -P 16 bash -c '[[ $(od -An -tx1 -N4 "$1") == " 7f 45 4c 46" ]] || exit 0
                                           printf "%s %s\n" "$(_isa30_count "$1")" "${1#./}"' _ \
             | sort -k2)
  (( ! bad ))
}

# Smoke, over the exact tree package() installs: version, JIT, `dart compile
# exe` and `aot-snapshot` (both run), 64 KiB LOADs, ISA 2.07 codegen, FFI ABI.
_smoke() {
  local sdk=$1 d=$srcdir/smoke v out
  rm -rf "$d"; mkdir -p "$d"
  v=$("$sdk/bin/dart" --version 2>&1)
  [[ $v == *"$pkgver (stable)"*'"linux_ppc64"'* ]] \
    || { echo "SMOKE FAILED: dart --version: $v" >&2; return 1; }
  v=$("$sdk/bin/dartaotruntime" --version 2>&1)
  [[ $v == *"$pkgver (stable)"*'"linux_ppc64"'* ]] \
    || { echo "SMOKE FAILED: dartaotruntime --version: $v" >&2; return 1; }
  cat > "$d/smoke.dart" <<-'DART'
	import 'dart:ffi';
	int fib(int n) => n < 2 ? n : fib(n - 1) + fib(n - 2);
	void main() {
	  final m = <String, int>{};
	  for (var i = 0; i < 1000; i++) { m['k${i % 7}'] = (m['k${i % 7}'] ?? 0) + i; }
	  print('${fib(25)} ${[3, 1, 2]..sort()} ${1.5 * 3} ${m['k3']} ${Abi.current()} ${sizeOf<IntPtr>()}');
	}
	DART
  local want='75025 [1, 2, 3] 4.5 71500 linux_ppc64 8'
  out=$(timeout 300 "$sdk/bin/dart" --suppress-analytics run "$d/smoke.dart")
  [[ $out == "$want" ]] || { echo "SMOKE FAILED: JIT printed '$out', want '$want'" >&2; return 1; }
  timeout 600 "$sdk/bin/dart" --suppress-analytics compile exe "$d/smoke.dart" -o "$d/smoke.exe" > /dev/null
  out=$("$d/smoke.exe")
  [[ $out == "$want" ]] || { echo "SMOKE FAILED: compile exe printed '$out', want '$want'" >&2; return 1; }
  timeout 600 "$sdk/bin/dart" --suppress-analytics compile aot-snapshot "$d/smoke.dart" -o "$d/smoke.aot" > /dev/null
  out=$("$sdk/bin/dartaotruntime" "$d/smoke.aot")
  [[ $out == "$want" ]] || { echo "SMOKE FAILED: aot-snapshot printed '$out', want '$want'" >&2; return 1; }
  local f al
  for f in "$d/smoke.exe" "$d/smoke.aot"; do
    file -b "$f" | grep -q '64-bit LSB .*PowerPC' \
      || { echo "SMOKE FAILED: ${f##*/} is not ppc64le: $(file -b "$f" | cut -d, -f1-2)" >&2; return 1; }
    al=$(readelf -lW "$f" | awk '$1 == "LOAD" { print $NF }' | sort -u | tr '\n' ' ')
    [[ $al == '0x10000 ' ]] \
      || { echo "SMOKE FAILED: ${f##*/} LOAD alignment is '$al', not 0x10000" >&2; return 1; }
  done
  _isa30_selftest "$d/smoke.aot"
  local n; n=$(_isa30_count "$d/smoke.aot")
  (( n == 0 )) || { echo "SMOKE FAILED: $n ISA 3.0 instructions in an AOT snapshot" >&2; return 1; }
  # Ten isolates of one group take the same AOT switchable calls from
  # monomorphic to polymorphic at once: series 0032 (the A17 race fix).
  # flutter-port work/dart-ppc64-smoke/isolates10.{dart,expect}, run 3 times.
  cat > "$d/isolates10.dart" <<-'DART'
	// 10 isolates of one group run the same polymorphic call sites at once, so
	// AOT switchable calls go monomorphic -> polymorphic/megamorphic in several
	// isolates concurrently (CodePatcher::PatchSwitchableCallAt, stubs 0005).
	import 'dart:isolate';

	abstract class Op {
	  int apply(int x);
	}

	class Add extends Op {
	  final int k;
	  Add(this.k);
	  @override
	  int apply(int x) => (x + k) & 0xffffff;
	}

	class Mul extends Op {
	  final int k;
	  Mul(this.k);
	  @override
	  int apply(int x) => (x * k) & 0xffffff;
	}

	class Xor extends Op {
	  final int k;
	  Xor(this.k);
	  @override
	  int apply(int x) => (x ^ k) & 0xffffff;
	}

	class Rot extends Op {
	  @override
	  int apply(int x) => ((x << 3) | (x >> 21)) & 0xffffff;
	}

	int work(int seed) {
	  final ops = <Op>[Add(seed + 1), Mul(3), Xor(0x5a5a5a), Rot(), Add(7)];
	  var s = seed;
	  for (var round = 0; round < 50; round++) {
	    // The call site sees one receiver class first, then all of them.
	    final n = round < 5 ? 1 : ops.length;
	    for (var i = 0; i < 4000; i++) {
	      s = ops[(i + round) % n].apply(s);
	    }
	  }
	  return s;
	}

	Future<void> main() async {
	  final results = await Future.wait(
	      [for (var i = 0; i < 10; i++) Isolate.run(() => work(i))]);
	  print('isolates: ${results.length}');
	  print('results: ${results.join(' ')}');
	}
	DART
  timeout 600 "$sdk/bin/dart" --suppress-analytics compile exe "$d/isolates10.dart" -o "$d/isolates10.exe" > /dev/null
  local want10=$'isolates: 10\nresults: 4132875 4241244 12848898 15463872 11690256 14477820 16237895 7997369 14506255 1495350' i
  for i in 1 2 3; do
    out=$(timeout 300 "$d/isolates10.exe")
    [[ $out == "$want10" ]] || { echo "SMOKE FAILED: isolates10 run $i printed '$out'" >&2; return 1; }
  done
  printf 'smoke: %s; JIT, compile exe and aot-snapshot print "%s"; 64 KiB LOADs; AOT ISA 3.0: 0; 10-isolate AOT exe x3 ok\n' "$v" "$want"
}

# CONTROL, after gn gen and before the expensive part.
#
# _compiles_with <out> <ERE>: "<C/C++ compile statements> <how many of them
# get cflags matching ERE>". GN writes one `cflags = ` line per target
# file, and every cc/cxx statement in that file uses it (rule cxx: clang++
# ... ${cflags} ${cflags_cc}); the shared-library toolchain's rules are
# prefixed (clang_ppc64_shared_cxx).
_compiles_with() {
  local out=$1 re=$2 f n tot=0 hit=0
  while IFS= read -r -d '' f; do
    n=$(grep -cE '^build [^:]+\.o: ([a-z0-9_]+_)?(cc|cxx) ' "$f" || true)
    (( n )) || continue
    tot=$((tot + n))
    if grep -qE -- "^cflags = (.* )?$re( |\$)" "$f"; then hit=$((hit + n)); fi
  done < <(find "$out" -name '*.ninja' -print0)
  echo "$tot $hit"
}

# -mcpu: GN ignores CFLAGS, so assert the -mcpu that reaches the compiler, on
# every compile, and that no other CPU is named anywhere in the graph. Bun's
# 0013 is the cautionary tale: the env said power8, a table in the build said
# power9, and 349,172 ISA 3.0 instructions shipped to the baseline pool.
_control_mcpu() {
  local out=$1 want=power9 tot hit tgt seen
  (( _power8_compat )) && want=power8
  # Series 0004 adds -mcpu before --target in the compiler config, so the
  # two are matched separately; both must reach every compile.
  read -r tot hit < <(_compiles_with "$out" "-mcpu=$want")
  read -r _ tgt < <(_compiles_with "$out" '--target=powerpc64le-linux-gnu')
  (( tot > 0 )) || { echo "CONTROL FAILED: no compile statements in $out" >&2; return 1; }
  (( hit == tot && tgt == tot )) \
    || { echo "CONTROL FAILED: -mcpu=$want reaches $hit, --target=powerpc64le-linux-gnu $tgt, of $tot compiles in $out" >&2; return 1; }
  seen=$(find "$out" -name '*.ninja' -print0 | xargs -0 grep -hoE -- '-m(cpu|tune)=[^ ]+' | sort -u | tr '\n' ' ')
  [[ $seen == "-mcpu=$want " ]] \
    || { echo "CONTROL FAILED: $out names other CPUs: $seen" >&2; return 1; }
  printf 'CONTROL: -mcpu=%s on all %d compiles in %s, no other CPU\n' "$want" "$tot" "$out"
}

# The build graph runs the prebuilt Dart only for front-end programs and
# never for a machine-code snapshot, runs no binary from outside the tree,
# and names no upstream or bootstrap SDK path. The drivers are taken from
# what ninja will run (build/gn_run_binary.py compiled_action <binary>).
_control_graph() {
  local out=$1 d r prebuilt=0
  local pre=../../tools/sdks/dart-sdk/bin/dart
  local root; root=$(realpath "$srcdir/sdk")
  local -a drivers
  mapfile -t drivers < <(find "$out" -name '*.ninja' -print0 \
                           | xargs -0 grep -hoE 'gn_run_binary\.py compiled_action [^ ]+' \
                           | awk '{print $3}' | sort -u)
  # In-tree binaries this build makes run from the out dir (dartvm,
  # gen_snapshot, gen_snapshot_product); scripts may be named by absolute
  # path, and must then resolve inside the tree.
  for d in "${drivers[@]}"; do
    if [[ $d == "$pre" ]]; then prebuilt=1; continue; fi
    [[ $d == */* ]] || continue
    r=$(cd "$out" && realpath -m -- "$d")
    [[ $r == "$root"/* ]] \
      || { echo "CONTROL FAILED: ninja runs a binary from outside the tree: $d -> $r" >&2; return 1; }
  done
  (( prebuilt )) || { echo "CONTROL FAILED: no prebuilt-Dart action in $out" >&2; return 1; }
  if find "$out" \( -name '*.ninja' -o -name args.gn \) -print0 \
       | xargs -0 grep -lsE 'bootstrap-arm64|dart-bootstrap|dartsdk-linux|linux-arm64/dart-sdk' | grep -q .; then
    echo "CONTROL FAILED: an upstream or bootstrap SDK path is baked into $out" >&2; return 1
  fi
  # What the prebuilt runs for the packaged targets: the first non-option
  # argument after the binary, and any snapshot kind it is asked for.
  local cmds progs kinds p
  cmds=$(ninja -C "$out" -t commands create_sdk runtime | grep -F " compiled_action $pre ")
  progs=$(awk -v pre="$pre" '{ for (i = 1; i < NF; i++) if ($i == pre) {
              for (j = i + 1; j <= NF; j++) if ($j !~ /^-/) { n = split($j, a, "/"); print a[n]; break }
              break } }' <<< "$cmds" | sort -u | tr '\n' ' ')
  for p in $progs; do
    [[ " $_leaf_programs " == *" $p "* ]] \
      || { echo "CONTROL FAILED: the prebuilt Dart runs $p (not an expected front-end program)" >&2; return 1; }
  done
  kinds=$(grep -oE -- '--snapshot[-_]kind=[^ ]+' <<< "$cmds" | sort -u | tr '\n' ' ')
  [[ -z $kinds || $kinds == '--snapshot-kind=kernel ' ]] \
    || { echo "CONTROL FAILED: the prebuilt Dart is asked for machine-code snapshots: $kinds" >&2; return 1; }
  printf 'CONTROL: %d prebuilt-Dart actions, programs: %s; snapshot kinds: %s\n' \
    "$(wc -l <<< "$cmds")" "$progs" "${kinds:-none}"
}

# The driver itself: a native linux_ppc64 Dart from this pool, at the path
# the recipe chose. Without this a missing native bootstrap fails OPEN: an
# arm64 dart at the same path executes fine through binfmt_misc (R15, also
# inside bq's bwrap), and the build silently depends on POWERarm. A simarm64
# VM hosted on ppc64 is a PowerPC ELF too; it says linux_simarm64.
_control_driver_identity() {
  local link=$srcdir/sdk/tools/sdks/dart-sdk
  [[ -x $link/bin/dart ]] \
    || { echo "CONTROL FAILED: no prebuilt Dart at tools/sdks/dart-sdk -> $(readlink "$link") (is $_driver installed?)" >&2; return 1; }
  local driver; driver=$(readlink -f "$link/bin/dart")
  file -L "$driver" | grep -q '64-bit LSB .*PowerPC' \
    || { echo "CONTROL FAILED: the prebuilt Dart is not a ppc64le binary ($(file -bL "$driver" | cut -d, -f1-2))" >&2; return 1; }
  [[ $driver == "$_driver_sdk/bin/dart" ]] \
    || { echo "CONTROL FAILED: the prebuilt Dart is $driver, not $_driver_sdk/bin/dart" >&2; return 1; }
  local v; v=$("$driver" --version 2>&1)
  [[ $v == *'"linux_ppc64"'* ]] \
    || { echo "CONTROL FAILED: the prebuilt Dart reports $v" >&2; return 1; }
  local want=power9 have
  (( _power8_compat )) && want=baseline
  have=$(sed -n 's/^pool: //p' "$_driver_sdk/.pkginfo" 2>/dev/null)
  if [[ $have != "$want" ]]; then
    if (( _cross_pool_bootstrap )) && [[ $want == baseline && $have == power9 ]]; then
      echo 'NOTE: one-time cross-pool build: baseline dart driven by the POWER9 bootstrap'
    else
      echo "CONTROL FAILED: the prebuilt Dart is from pool '${have:-?}', this build is $want" >&2; return 1
    fi
  fi
  printf 'driver: %s %s (%s, pool %s)\ndriver sha256: %s\n' "$_driver" "$driver" "$v" "$have" \
    "$(sha256sum < "$driver" | cut -d' ' -f1)" | tee "$srcdir/driver.info"
}

check() {
  # Native by-hand makepkg only (bq passes --nocheck). The C++ unit tests
  # that matter most for this port; anything bigger (tools/test.py suites)
  # under a memory cgroup, as tools/jsc-test-runner does -- the suites have
  # memory hogs and this box has 176 threads.
  # run_vm_tests takes one exact test name (strcmp in run_vm_tests.cc), so
  # select from --list. Assembler_*: every ppc64 emitter (133 tests);
  # CodeRelocator_*: AOT PC-relative calls and trampolines (5, M5);
  # {Allocate,AllocateAligned,Free}VirtualMemory: 64 KiB pages (3). Measured
  # 2026-11-19 on the pkgtest build: 141 tests, all pass, in seconds.
  cd "sdk/$_out"
  local -a tests
  mapfile -t tests < <(./run_vm_tests --list | awk '{print $1}' \
                         | grep -E '^(Assembler_|CodeRelocator_|(Allocate|AllocateAligned|Free)VirtualMemory$)')
  (( ${#tests[@]} )) || { echo 'CHECK FAILED: no tests selected' >&2; return 1; }
  local t bad=0
  for t in "${tests[@]}"; do
    ./run_vm_tests "$t" > "$srcdir/check-$t.log" 2>&1 || { echo "CHECK FAILED: $t" >&2; bad=1; }
  done
  printf 'check: %d run_vm_tests, %s\n' "${#tests[@]}" "$( (( bad )) && echo FAILURES || echo all passed)"
  (( ! bad ))
}

package() {
  # Files only: no Dart runs here (package() is under fakeroot).
  install -d "$pkgdir/usr/lib" "$pkgdir/usr/bin"
  cp -a "$srcdir/stage/dart-sdk" "$pkgdir/usr/lib/dart"
  # Dart finds its SDK through the realpath of its executable, so symlinks
  # are enough (no wrapper script).
  ln -s ../lib/dart/bin/dart "$pkgdir/usr/bin/dart"
  ln -s ../lib/dart/bin/dartaotruntime "$pkgdir/usr/bin/dartaotruntime"
  install -Dm644 sdk/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  local pool=power9
  (( _power8_compat )) && pool=baseline
  local p dep_trees=
  for p in "${!_dep_trees[@]}"; do dep_trees+="$p=${_dep_trees[$p]} "; done
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/dart/.pkginfo" <<-INFO
	version: $pkgver
	base-commit: $_commit ($_commit_time)
	base-tree: $_base_tree
	patched-tree: $_tree
	patches: ${#_patches[@]}
	dep-trees: $dep_trees
	pool: $pool
	cxx-mcpu: $( (( _power8_compat )) && echo power8 || echo power9 )
	codegen: ISA 2.07 (POWER8) in both pools
	cross-pool bootstrap: $_cross_pool_bootstrap
	$(cat "$srcdir/driver.info")
	# ISA 3.0 instructions per installed ELF (objdump power8 vs power9):
	$(cat "$srcdir/isa30.info")
	INFO
}

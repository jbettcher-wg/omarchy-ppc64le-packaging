+// The base register of a far pool access: dst itself, or TMP when dst is R0
+// (r0 as a D-form base reads as zero).
+static Register FarPoolBase(Register dst) {
+  return dst == R0 ? TMP : dst;
 }
 
 void Assembler::LoadWordFromPoolIndex(Register dst,
                                       intptr_t index,
                                       Register pp) {
-  UNIMPLEMENTED();
+  ASSERT((pp != PP) || constant_pool_allowed());
+  ASSERT(dst != pp);
+  ASSERT(pp != R0);
+  // PP is untagged: slot offsets are multiples of 8, so ld is DS-legal.
+  const int64_t offset = target::ObjectPool::element_offset(index);
+  ASSERT(Utils::IsAligned(offset, target::kWordSize));
+  if (Utils::IsInt(16, offset)) {
+    ld(dst, pp, offset);
+  } else {
+    const int32_t hi = HighAdjusted16(offset);
+    const int32_t lo = Low16(offset);
+    RELEASE_ASSERT(static_cast<int64_t>(hi) * 65536 + lo == offset);
+    const Register base = FarPoolBase(dst);
+    addis(base, pp, hi);
+    ld(dst, base, lo);
+  }
 }
 

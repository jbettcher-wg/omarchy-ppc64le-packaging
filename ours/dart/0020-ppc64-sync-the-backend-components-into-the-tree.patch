+// The call through the Code object in pool slot |index| (ABI-SPEC 4.1):
+//   ld code_reg,idx(PP) ; li r0,entry-1 ; ldx r0,code_reg,r0 ; mtctr r0 ;
+//   bctrl
+// with the far pool form (6 words) when the slot is beyond 32 KiB.
+static void CallCodeFromPool(Assembler* assembler,
+                             intptr_t index,
+                             CodeEntryKind entry_kind) {
+  // Avoid clobbering CODE_REG when invoking code in precompiled mode.
+  // We don't actually use CODE_REG in the callee and caller might
+  // be using CODE_REG for a live value (e.g. a value that is alive
+  // across invocation of a shared stub like the one we use for
+  // allocating Mint boxes). r0 cannot be the base of the entry load, so
+  // AOT uses TMP (as RISC-V does; ARM64 uses LR).
+  const Register code_reg = FLAG_precompiled_mode ? TMP : CODE_REG;
+  assembler->LoadWordFromPoolIndex(code_reg, index);
+  assembler->Call(
+      FieldAddress(code_reg, target::Code::entry_point_offset(entry_kind)));
 }
 

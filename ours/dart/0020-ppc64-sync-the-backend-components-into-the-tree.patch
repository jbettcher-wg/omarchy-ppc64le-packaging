 void Assembler::EnterDartFrame(intptr_t frame_size, Register new_pp) {
-  UNIMPLEMENTED();
+  ASSERT(!constant_pool_allowed());
+  ASSERT(frame_size >= 0);
+  // Setup the frame. stdu stores and moves SP in one instruction, so nothing
+  // is ever written below SP (ABI-SPEC 3.6).
+  EnterFrame(0);
+
+  if (!FLAG_precompiled_mode) {
+    PushRegister(CODE_REG);  // PC marker: FP - 8
+    // Caller's PP, re-tagged for the GC: FP - 16.
+    addi(R0, PP, kHeapObjectTag);
+    PushRegister(R0);
+
+    // Load the pool pointer.
+    if (new_pp == kNoRegister) {
+      LoadPoolPointer();
+    } else {
+      MoveRegister(PP, new_pp);
+    }
+  }
+  set_constant_pool_allowed(true);
+
+  // Reserve space.
+  if (frame_size > 0) {
+    AddImmediate(SP, SP, -frame_size);
+  }
 }
 

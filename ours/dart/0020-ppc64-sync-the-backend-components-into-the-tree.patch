@@ -272,6 +272,50 @@ class Label : public ZoneAllocated {
   friend class MicroAssembler;
   DISALLOW_COPY_AND_ASSIGN(Label);
 };
+#elif defined(TARGET_ARCH_PPC64)
+// ppc64 (local, mirrors the RISC-V Label above). The two branch forms that
+// can reach an unbound label differ in reach (b: +/-32 MiB, bc: +/-32 KiB),
+// so the unresolved forward uses are kept on two chains, one per form, each
+// threaded through the displacement fields of its branches: a branch holds
+// the delta to the previous use on its chain, 0 for the first. A label is
+// linked while EITHER chain is non-empty; a label reached only by a bc is
+// linked (shared code binds a label only if IsLinked(), e.g. il.cc's
+// UnboxInstr). Assembler::Bind resolves both chains, then BindTo.
+class Label : public ZoneAllocated {
+ public:
+  Label() {}
+  ~Label() {
+    // Assert if label is being destroyed with unresolved branches pending.
+    ASSERT(!IsLinked());
+  }
+
+  intptr_t Position() const {
+    ASSERT(IsBound());
+    return position_;
+  }
+
+  bool IsBound() const { return position_ != -1; }
+  bool IsUnused() const { return !IsBound() && !IsLinked(); }
+  bool IsLinked() const {
+    return unresolved_b_ != -1 || unresolved_bc_ != -1;
+  }
+
+ private:
+  intptr_t position_ = -1;
+  // Position of the most recent unresolved use of each form, -1 if none.
+  intptr_t unresolved_b_ = -1;   // b (I-form), incl. the b of a far bc
+  intptr_t unresolved_bc_ = -1;  // bc (B-form), level 0 and kNearJump
+
+  void BindTo(intptr_t position) {
+    ASSERT(!IsBound());
+    ASSERT(!IsLinked());
+    position_ = position;
+    ASSERT(IsBound());
+  }
+
+  friend class Assembler;
+  DISALLOW_COPY_AND_ASSIGN(Label);
+};
 #else
 class Label : public ZoneAllocated {
  public:

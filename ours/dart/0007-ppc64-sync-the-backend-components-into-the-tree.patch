+
+enum PPCInstr : uint32_t {
+#define DEFINE_INSTR(Name, mnemonic, operands, word) kPpc##Name = word,
+  PPC64_INSTRUCTION_LIST(DEFINE_INSTR)
+#undef DEFINE_INSTR
+};
+
+// The bits of an instruction word that hold operands, per operand kind. For
+// a table entry (kind, templ), a word w is that instruction iff
+//   (w & ~PPCOperandFieldMask(kind)) == templ.
+// kOpNone entries (fixed words, several of which are special cases of other
+// entries: nop is ori 0,0,0, blr is bclr 20,0, ...) must be tried first.
+// [MEASURED] by the oracle: every generated case decodes to exactly the
+// entry that produced it.
+constexpr uint32_t PPCOperandFieldMask(PPCOperands kind) {
+  switch (kind) {
+    case kOpNone:
+      return 0;
+    case kOpRT_RA_SI:
+    case kOpRA_RS_UI:
+    case kOpRT_D_RA:
+    case kOpFRT_D_RA:
+      return 0x03ffffffu;
+    case kOpBF_L_RA_SI:
+    case kOpBF_L_RA_UI:
+      return 0x03bfffffu;
+    case kOpRT_DS_RA:
+    case kOpLI:
+    case kOpBO_BI_BD:
+      return 0x03fffffcu;
+    case kOpRT_RA_RB:
+    case kOpFRT_RA_RB:
+    case kOpRA_RS_RB:
+    case kOpRA_RS_SH5:
+    case kOpFRT_FRA_FRB:
+    case kOpBT_BA_BB:
+      return 0x03fff800u;
+    case kOpRT_RA:
+    case kOpRA_RS:
+    case kOpBO_BI:
+      return 0x03ff0000u;
+    case kOpRA_RS_SH6:
+      return 0x03fff802u;
+    case kOpBF_L_RA_RB:
+      return 0x03bff800u;
+    case kOpRT_RA_RB_BC:
+      return 0x03ffffc0u;
+    case kOpRA_RS_SH6_MB6:
+    case kOpRA_RS_SH6_ME6:
+      return 0x03ffffe2u;
+    case kOpRA_RS_RB_MB6:
+    case kOpRA_RS_RB_ME6:
+      return 0x03ffffe0u;
+    case kOpRA_RS_SH5_MB5_ME5:
+    case kOpRA_RS_RB_MB5_ME5:
+      return 0x03fffffeu;
+    case kOpBF_BFA:
+      return 0x039c0000u;
+    case kOpRT:
+      return 0x03e00000u;
+    case kOpRT_FXM:
+      return 0x03eff000u;
+    case kOpRA_RB:
+      return 0x001ff800u;
+    case kOpFRT_FRA_FRC:
+      return 0x03ff07c0u;
+    case kOpFRT_FRB:
+      return 0x03e0f800u;
+    case kOpBF_FRA_FRB:
+      return 0x039ff800u;
+    case kOpXT_RA:
+    case kOpRA_XS:
+      return 0x03ff0001u;
+    case kOpXT_XB:
+      return 0x03e0f803u;
+    case kOpXT_XA_XB:
+      return 0x03fff807u;
+  }
+  return 0;
+}
+
+struct PPCInstrInfo {
+  const char* mnemonic;
+  PPCOperands operands;
+  uint32_t templ;
+};
+
+// The whitelist as a table, in PPC64_INSTRUCTION_LIST order. For the
+// disassembler and for tests.
+constexpr PPCInstrInfo kPPCInstrTable[] = {
+#define DEFINE_INFO(Name, mnemonic, operands, word) {mnemonic, operands, word},
+    PPC64_INSTRUCTION_LIST(DEFINE_INFO)
+#undef DEFINE_INFO
+};
+constexpr intptr_t kPPCInstrTableLength =
+    sizeof(kPPCInstrTable) / sizeof(kPPCInstrTable[0]);
+
+// Index into kPPCInstrTable of the entry that |word| is an instance of, or
+// -1 if |word| is not a whitelisted instruction.
+constexpr intptr_t PPCLookupInstr(uint32_t word) {
+  for (intptr_t i = 0; i < kPPCInstrTableLength; i++) {
+    if ((kPPCInstrTable[i].operands == kOpNone) &&
+        (kPPCInstrTable[i].templ == word)) {
+      return i;
+    }
+  }
+  for (intptr_t i = 0; i < kPPCInstrTableLength; i++) {
+    if ((kPPCInstrTable[i].operands != kOpNone) &&
+        ((word & ~PPCOperandFieldMask(kPPCInstrTable[i].operands)) ==
+         kPPCInstrTable[i].templ)) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+// BO field values (ISA 3.0B Book I, 2.4, figure 40), without hint bits.
+enum BranchOptions {
+  kBOFalse = 4,    // Branch if CR[BI] == 0.
+  kBOTrue = 12,    // Branch if CR[BI] == 1.
+  kBOAlways = 20,  // Branch always.
+};
+
+constexpr uint32_t CRBitIndex(CRField field, CRBit bit) {
+  return static_cast<uint32_t>(field) * 4 + static_cast<uint32_t>(bit);
+}
+
+// ----- Field encoders. Callers range-check; these only place bits. -----
+
+// RT / RS / FRT / FRS / BT / BO / TO: bits 6:10.
+constexpr uint32_t EncodeRT(uint32_t r) { return (r & 31) << 21; }
+constexpr uint32_t EncodeRS(uint32_t r) { return (r & 31) << 21; }
+// RA / FRA / BA / BI: bits 11:15.
+constexpr uint32_t EncodeRA(uint32_t r) { return (r & 31) << 16; }
+// RB / FRB / BB / SH (5-bit): bits 16:20.
+constexpr uint32_t EncodeRB(uint32_t r) { return (r & 31) << 11; }
+// FRC / BC (isel) / MB (5-bit): bits 21:25.
+constexpr uint32_t EncodeRC(uint32_t r) { return (r & 31) << 6; }
+// ME (5-bit): bits 26:30.
+constexpr uint32_t EncodeME5(uint32_t me) { return (me & 31) << 1; }
+// BF: bits 6:8.  L (cmp width, 1 = 64-bit): bit 10.
+constexpr uint32_t EncodeBF(uint32_t crf) { return (crf & 7) << 23; }
+constexpr uint32_t EncodeBFA(uint32_t crf) { return (crf & 7) << 18; }
+constexpr uint32_t EncodeL(uint32_t l) { return (l & 1) << 21; }
+// SI / UI / D: bits 16:31.
+constexpr uint32_t EncodeSI(int64_t imm) {
+  return static_cast<uint32_t>(imm) & 0xffff;
+}
+constexpr uint32_t EncodeUI(uint64_t imm) {
+  return static_cast<uint32_t>(imm) & 0xffff;
+}
+// DS: bits 16:29, the displacement with its two low (zero) bits dropped.
+constexpr uint32_t EncodeDS(int64_t disp) {
+  return static_cast<uint32_t>(disp) & 0xfffc;
+}
+// 6-bit shift of MD / XS forms: sh[1:5] in bits 16:20, sh[0] in bit 30.
+constexpr uint32_t EncodeSH6(uint32_t sh) {
+  return ((sh & 31) << 11) | (((sh >> 5) & 1) << 1);
+}
+// 6-bit mask begin/end of MD / MDS forms: m[1:5] in bits 21:25, m[0] in
+// bit 26.
+constexpr uint32_t EncodeMB6(uint32_t m) {
+  return ((m & 31) << 6) | (((m >> 5) & 1) << 5);
+}
+// I-form LI: bits 6:29 (byte offset, low two bits dropped). AA is always 0.
+constexpr uint32_t EncodeLI(int64_t offset) {
+  return static_cast<uint32_t>(offset) & 0x03fffffc;
+}
+// B-form BD: bits 16:29.
+constexpr uint32_t EncodeBD(int64_t offset) {
+  return static_cast<uint32_t>(offset) & 0xfffc;
+}
+// FXM for mfocrf: one-hot, CR field 0 is the most significant bit.
+constexpr uint32_t EncodeFXM(uint32_t crf) { return (0x80u >> crf) << 12; }
+// VSX register numbers 0..63: five low bits in the usual field, the high bit
+// in the low bits of the word (TX/SX = bit 31, AX = bit 29, BX = bit 30).
+constexpr uint32_t EncodeXT(uint32_t vsr) {
+  return ((vsr & 31) << 21) | ((vsr >> 5) & 1);
+}
+constexpr uint32_t EncodeXA(uint32_t vsr) {
+  return ((vsr & 31) << 16) | (((vsr >> 5) & 1) << 2);
+}
+constexpr uint32_t EncodeXB(uint32_t vsr) {
+  return ((vsr & 31) << 11) | (((vsr >> 5) & 1) << 1);
+}
+
+// ----- Range predicates. -----
+
+constexpr bool IsInt16(int64_t v) { return (v >= -0x8000) && (v <= 0x7fff); }
+constexpr bool IsUint16(int64_t v) { return (v >= 0) && (v <= 0xffff); }
+// A displacement a DS-form instruction (ld, std, lwa, ldu, stdu) can encode.
+constexpr bool IsDSDisplacement(int64_t v) {
+  return IsInt16(v) && ((v & 3) == 0);
+}
+// Conditional branch reach: +/-32 KiB.
+constexpr intptr_t kBranch14Min = -(1 << 15);
+constexpr intptr_t kBranch14Max = (1 << 15) - 4;
+constexpr bool IsBranch14Offset(int64_t off) {
+  return (off >= kBranch14Min) && (off <= kBranch14Max) && ((off & 3) == 0);
+}
+// Unconditional branch reach: +/-32 MiB.
+constexpr intptr_t kBranch24Min = -(1 << 25);
+constexpr intptr_t kBranch24Max = (1 << 25) - 4;
+constexpr bool IsBranch24Offset(int64_t off) {
+  return (off >= kBranch24Min) && (off <= kBranch24Max) && ((off & 3) == 0);
+}
+
+// "High adjusted" and low halves of a 32-bit displacement for
+// addis rX,rB,ha ; <D-form> lo(rX).
+constexpr int32_t HighAdjusted16(int64_t v) {
+  return static_cast<int16_t>((v + 0x8000) >> 16);
+}
+constexpr int32_t Low16(int64_t v) {
+  return static_cast<int16_t>(v & 0xffff);
+}
+
+// ----- Extended mnemonics, as words. [MEASURED] by the oracle. -----
+
+constexpr uint32_t PPCLi(Register rt, int64_t si) {
+  return kPpcAddi | EncodeRT(rt) | EncodeSI(si);  // addi rt,0,si
+}
+constexpr uint32_t PPCLis(Register rt, int64_t si) {
+  return kPpcAddis | EncodeRT(rt) | EncodeSI(si);  // addis rt,0,si
+}
+constexpr uint32_t PPCMr(Register ra, Register rs) {
+  return kPpcOr | EncodeRS(rs) | EncodeRA(ra) | EncodeRB(rs);  // or ra,rs,rs
+}
+// sldi ra,rs,n == rldicr ra,rs,n,63-n
+constexpr uint32_t PPCSldi(Register ra, Register rs, uint32_t n) {
+  return kPpcRldicr | EncodeRS(rs) | EncodeRA(ra) | EncodeSH6(n) |
+         EncodeMB6(63 - n);
+}
+// srdi ra,rs,n == rldicl ra,rs,64-n,n
+constexpr uint32_t PPCSrdi(Register ra, Register rs, uint32_t n) {
+  return kPpcRldicl | EncodeRS(rs) | EncodeRA(ra) | EncodeSH6((64 - n) & 63) |
+         EncodeMB6(n);
+}
+// clrldi ra,rs,n == rldicl ra,rs,0,n   (clear the n high bits)
+constexpr uint32_t PPCClrldi(Register ra, Register rs, uint32_t n) {
+  return kPpcRldicl | EncodeRS(rs) | EncodeRA(ra) | EncodeMB6(n);
+}
+// clrrdi ra,rs,n == rldicr ra,rs,0,63-n (clear the n low bits)
+constexpr uint32_t PPCClrrdi(Register ra, Register rs, uint32_t n) {
+  return kPpcRldicr | EncodeRS(rs) | EncodeRA(ra) | EncodeMB6(63 - n);
+}
+// cmpd / cmpld / cmpw / cmplw and their immediate forms.
+constexpr uint32_t PPCCmp(CRField bf, bool is64, Register ra, Register rb) {
+  return kPpcCmp | EncodeBF(bf) | EncodeL(is64) | EncodeRA(ra) | EncodeRB(rb);
+}
+constexpr uint32_t PPCCmpl(CRField bf, bool is64, Register ra, Register rb) {
+  return kPpcCmpl | EncodeBF(bf) | EncodeL(is64) | EncodeRA(ra) | EncodeRB(rb);
+}
+constexpr uint32_t PPCCmpi(CRField bf, bool is64, Register ra, int64_t si) {
+  return kPpcCmpi | EncodeBF(bf) | EncodeL(is64) | EncodeRA(ra) | EncodeSI(si);
+}
+constexpr uint32_t PPCCmpli(CRField bf, bool is64, Register ra, uint64_t ui) {
+  return kPpcCmpli | EncodeBF(bf) | EncodeL(is64) | EncodeRA(ra) | EncodeUI(ui);
+}
+// bc with an explicit CR bit and sense; |offset| is relative to this word.
+constexpr uint32_t PPCBc(bool if_set, CRField crf, CRBit bit, int64_t offset) {
+  return kPpcBc | EncodeRT(if_set ? kBOTrue : kBOFalse) |
+         EncodeRA(CRBitIndex(crf, bit)) | EncodeBD(offset);
+}
+
+// ----- Instruction decoding. -----
+
+class Instr {
+ public:
+  enum { kInstrSize = 4, kInstrSizeLog2 = 2 };
+
+  // Breakpoint instruction filling assembler code buffers in debug mode,
+  // and the debugger's breakpoint: trap (tw 31,0,0) raises SIGTRAP.
+  static constexpr int32_t kBreakPointInstruction = kPpcTrap;
+  static constexpr int32_t kNopInstruction = kPpcNop;
+
+  static constexpr uint32_t kPrimaryOpcodeMask = 0xfc000000u;
+  // Primary opcode plus the 10-bit extended opcode and Rc/LK bit.
+  static constexpr uint32_t kXFormMask = 0xfc0007ffu;
+  // Primary opcode plus the 2-bit DS-form extended opcode.
+  static constexpr uint32_t kDSFormMask = 0xfc000003u;
+  // I-form: primary opcode, AA and LK.
+  static constexpr uint32_t kIFormMask = 0xfc000003u;
+
+  inline uint32_t InstructionBits() const {
+    return *reinterpret_cast<const uint32_t*>(this);
+  }
+  inline void SetInstructionBits(uint32_t value) {
+    *reinterpret_cast<uint32_t*>(this) = value;
+  }
+
+  inline uint32_t PrimaryOpcodeField() const { return InstructionBits() >> 26; }
+  inline Register RTField() const {
+    return static_cast<Register>((InstructionBits() >> 21) & 31);
+  }
+  inline Register RSField() const { return RTField(); }
+  inline Register RAField() const {
+    return static_cast<Register>((InstructionBits() >> 16) & 31);
+  }
+  inline Register RBField() const {
+    return static_cast<Register>((InstructionBits() >> 11) & 31);
+  }
+  inline uint32_t BOField() const { return (InstructionBits() >> 21) & 31; }
+  inline uint32_t BIField() const { return (InstructionBits() >> 16) & 31; }
+  inline uint32_t XOField10() const { return (InstructionBits() >> 1) & 1023; }
+  // Sign-extended 16-bit immediate / D-form displacement.
+  inline int32_t SIField() const {
+    return static_cast<int16_t>(InstructionBits() & 0xffff);
+  }
+  inline uint32_t UIField() const { return InstructionBits() & 0xffff; }
+  // DS-form displacement in bytes.
+  inline int32_t DSField() const {
+    return static_cast<int16_t>(InstructionBits() & 0xfffc);
+  }
+  // I-form branch offset in bytes.
+  inline int32_t LIField() const {
+    return static_cast<int32_t>((InstructionBits() & 0x03fffffc) << 6) >> 6;
+  }
+  // B-form branch offset in bytes.
+  inline int32_t BDField() const {
+    return static_cast<int16_t>(InstructionBits() & 0xfffc);
+  }
+
+  inline bool IsD(uint32_t templ) const {
+    return (InstructionBits() & kPrimaryOpcodeMask) == templ;
+  }
+  inline bool IsDS(uint32_t templ) const {
+    return (InstructionBits() & kDSFormMask) == templ;
+  }
+  inline bool IsX(uint32_t templ) const {
+    return (InstructionBits() & kXFormMask) == templ;
+  }
+  // b / bl (AA == 0).
+  inline bool IsB() const { return (InstructionBits() & kIFormMask) == kPpcB; }
+  inline bool IsBl() const { return (InstructionBits() & kIFormMask) == kPpcBl; }
+  // bc, any BO/BI (AA == 0, LK == 0).
+  inline bool IsBc() const { return (InstructionBits() & kIFormMask) == kPpcBc; }
+  inline bool IsBlr() const { return InstructionBits() == kPpcBlr; }
+  inline bool IsBctr() const { return InstructionBits() == kPpcBctr; }
+  inline bool IsBctrl() const { return InstructionBits() == kPpcBctrl; }
+  inline bool IsTrap() const { return InstructionBits() == kPpcTrap; }
+  inline bool IsNop() const { return InstructionBits() == kPpcNop; }
+  // mtctr rs / mflr rt, ...: SPR moves compare with the register masked out.
+  inline bool IsSprMove(uint32_t templ) const {
+    return (InstructionBits() & ~EncodeRT(31)) == templ;
+  }
+
+  // Instructions are read with the template "At" method.
+  static Instr* At(uword pc) { return reinterpret_cast<Instr*>(pc); }
+
+ private:
+  DISALLOW_ALLOCATION();
+  DISALLOW_IMPLICIT_CONSTRUCTORS(Instr);
+};
+
+// trap; trap -- what unused instruction space is filled with.
+const uint64_t kBreakInstructionFiller = 0x7fe000087fe00008ULL;
+
+// "or rx,rx,rx" is not a no-op for several x: it is an SMT thread-priority or
+// shared-processor hint (ISA Book II, 3.2). A register move with equal
+// operands must be elided or replaced by kPpcNop, never emitted (ABI-SPEC section 11.4).
+constexpr bool IsPriorityHintRegister(Register r) {
+  return (r == R1) || (r == R2) || (r == R3) || (r == R5) || (r == R6) ||
+         (r == R7) || (r == R26) || (r == R27) || (r == R28) || (r == R29) ||
+         (r == R30) || (r == R31);
+}
+
+// Loop headers are not aligned.
+const intptr_t kPreferredLoopAlignment = 1;
+
+}  // namespace dart
+
+#endif  // RUNTIME_VM_CONSTANTS_PPC64_H_
diff --git a/runtime/vm/cpu_ppc64.cc b/runtime/vm/cpu_ppc64.cc
new file mode 100644
index 00000000..89029f23
--- /dev/null
+++ b/runtime/vm/cpu_ppc64.cc
@@ -0,0 +1,136 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/globals.h"
+#if defined(TARGET_ARCH_PPC64)
+
+#include "vm/cpu.h"
+#include "vm/cpu_ppc64.h"
+
+#include "platform/atomic.h"
+#include "platform/utils.h"
+
+#if defined(HOST_ARCH_PPC64)
+#include <sys/auxv.h>
+#endif
+
+namespace dart {
+
+// Bits of AT_HWCAP / AT_HWCAP2 (Linux arch/powerpc/include/uapi/asm/cputable.h).
+static constexpr uint64_t kPpcFeatureHasVsx = 0x00000080;
+static constexpr uint64_t kPpcFeature2Arch207 = 0x80000000;
+static constexpr uint64_t kPpcFeature2Arch300 = 0x00800000;
+
+#if defined(HOST_ARCH_PPC64)
+// The flush stride: the smaller of the data- and instruction-cache block
+// sizes from the auxiliary vector (128 and 128 on POWER9). 32 if either is
+// missing or not a power of two: too small a stride is redundant work, never
+// incorrect. Read on first use, so FlushICache does not depend on
+// HostCPUFeatures::Init() having run.
+static RelaxedAtomic<uword> flush_stride = 0;
+
+static uword FlushStride() {
+  uword stride = flush_stride.load();
+  if (stride == 0) {
+    const uword d = getauxval(AT_DCACHEBSIZE);
+    const uword i = getauxval(AT_ICACHEBSIZE);
+    stride = (d < i) ? d : i;
+    if (stride < 16 || !Utils::IsPowerOfTwo(stride)) {
+      stride = 32;
+    }
+    flush_stride.store(stride);
+  }
+  return stride;
+}
+#endif  // defined(HOST_ARCH_PPC64)
+
+// The instruction cache is not coherent with stores on POWER, and
+// __builtin___clear_cache emits no cache maintenance on ppc64le (gcc 16:
+// nothing; clang 22: a call to libgcc's empty __clear_cache). This is the
+// five-step sequence of Power ISA Book II "Synchronization Requirements for
+// Instruction Storage" (ABI-SPEC 9.1):
+//   dcbst each block ; sync ; icbi each block ; sync ; isync
+// The start is aligned down so a partially covered first block is included.
+void CPU::FlushICache(uword start, uword size) {
+#if defined(DART_PRECOMPILED_RUNTIME)
+  UNREACHABLE();
+#else
+  if (size == 0) {
+    return;
+  }
+#if defined(HOST_ARCH_PPC64)
+  const uword stride = FlushStride();
+  const uword begin = start & ~(stride - 1);
+  const uword end = start + size;
+  for (uword p = begin; p < end; p += stride) {
+    asm volatile("dcbst 0,%0" : : "r"(p) : "memory");
+  }
+  asm volatile("sync" : : : "memory");
+  for (uword p = begin; p < end; p += stride) {
+    asm volatile("icbi 0,%0" : : "r"(p) : "memory");
+  }
+  asm volatile("sync\n\tisync" : : : "memory");
+#else
+  // Cross-compiling for ppc64: the generated code never runs on this host.
+#endif
+#endif
+}
+
+const char* CPU::Id() {
+  return "ppc64";
+}
+
+const char* HostCPUFeatures::hardware_ = nullptr;
+uint64_t HostCPUFeatures::hwcap_ = 0;
+uint64_t HostCPUFeatures::hwcap2_ = 0;
+bool HostCPUFeatures::has_isa207_ = false;
+bool HostCPUFeatures::has_isa30_ = false;
+intptr_t HostCPUFeatures::dcache_block_size_ = 0;
+intptr_t HostCPUFeatures::icache_block_size_ = 0;
+#if defined(DEBUG)
+bool HostCPUFeatures::initialized_ = false;
+#endif
+
+void HostCPUFeatures::Init() {
+#if defined(HOST_ARCH_PPC64)
+  hwcap_ = getauxval(AT_HWCAP);
+  hwcap2_ = getauxval(AT_HWCAP2);
+  dcache_block_size_ = static_cast<intptr_t>(getauxval(AT_DCACHEBSIZE));
+  icache_block_size_ = static_cast<intptr_t>(getauxval(AT_ICACHEBSIZE));
+  has_isa207_ = ((hwcap2_ & kPpcFeature2Arch207) != 0) &&
+                ((hwcap_ & kPpcFeatureHasVsx) != 0);
+  has_isa30_ = (hwcap2_ & kPpcFeature2Arch300) != 0;
+  const char* platform =
+      reinterpret_cast<const char*>(getauxval(AT_PLATFORM));
+  if (!has_isa207_) {
+    // A POWER7 would otherwise die later with SIGILL on mtvsrd.
+    FATAL(
+        "The Dart VM for ppc64 needs a POWER8 (Power ISA 2.07) or later CPU "
+        "with VSX; this host reports %s, AT_HWCAP 0x%" Px64
+        ", AT_HWCAP2 0x%" Px64 ".",
+        platform != nullptr ? platform : "an unknown platform", hwcap_,
+        hwcap2_);
+  }
+  hardware_ = strdup(platform != nullptr ? platform : "ppc64le");
+#else
+  hardware_ = strdup("ppc64 (cross-compiling)");
+#endif
+#if defined(DEBUG)
+  initialized_ = true;
+#endif
+}
+
+void HostCPUFeatures::Cleanup() {
+  DEBUG_ASSERT(initialized_);
+#if defined(DEBUG)
+  initialized_ = false;
+#endif
+  ASSERT(hardware_ != nullptr);
+  free(const_cast<char*>(hardware_));
+  hardware_ = nullptr;
+}
+
+}  // namespace dart
+
+#endif  // defined(TARGET_ARCH_PPC64)

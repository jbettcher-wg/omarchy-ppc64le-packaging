+// Called for invoking "dynamic noSuchMethod(Invocation invocation)" function
+// from the entry code of a dart function after an error in passed argument
+// name or number is detected.
+// Input parameters:
+//  LR : return address.
+//  SP : address of last argument.
+//  R7: arguments descriptor array.
+void StubCodeCompiler::GenerateCallClosureNoSuchMethodStub() {
+  __ EnterStubFrame();
+
+  // Load the receiver.
+  __ LoadCompressedSmiFieldFromOffset(
+      R5, ARGS_DESC_REG, target::ArgumentsDescriptor::size_offset());
+  __ sldi(TMP, R5, target::kWordSizeLog2 - 1);  // R5 is Smi.
+  __ add(TMP, FP, TMP);
+  __ LoadFromOffset(R9, TMP,
+                    target::frame_layout.param_end_from_fp * target::kWordSize);
+
+  // Load the function.
+  __ LoadCompressedFieldFromOffset(TMP, R9, target::Closure::function_offset());
+
+  __ PushImmediate(0);             // Result slot.
+  __ PushRegister(R9);             // Receiver.
+  __ PushRegister(TMP);            // Function
+  __ PushRegister(ARGS_DESC_REG);  // Arguments descriptor.
+
+  // Adjust arguments count.
+  __ LoadCompressedSmiFieldFromOffset(
+      R6, ARGS_DESC_REG, target::ArgumentsDescriptor::type_args_len_offset());
+  AdjustArgumentCountForTypeArguments(assembler);
+
+  // R5: Smi-tagged arguments array length.
+  PushArrayOfArguments(assembler);
+
+  const intptr_t kNumArgs = 4;
+  __ CallRuntime(kNoSuchMethodFromPrologueRuntimeEntry, kNumArgs);
+  // noSuchMethod on closures always throws an error, so it will never return.
+  __ Breakpoint();
+}
+
+//  R9: function object.
+//  R8: inline cache data object.
+// Cannot use function object from ICData as it may be the inlined
+// function and not the top-scope function.
+void StubCodeCompiler::GenerateOptimizedUsageCounterIncrement() {
+  Register func_reg = R9;
+  if (FLAG_precompiled_mode) {
+    __ Breakpoint();
+    return;
+  }
+  __ LoadFieldFromOffset(R10, func_reg,
+                         target::Function::usage_counter_offset(), kFourBytes);
+  __ AddImmediate(R10, R10, 1);
+  __ StoreFieldToOffset(R10, func_reg,
+                        target::Function::usage_counter_offset(), kFourBytes);
+}
+
+// Loads function into 'temp_reg'.
+void StubCodeCompiler::GenerateUsageCounterIncrement(Register temp_reg) {
+  if (FLAG_precompiled_mode) {
+    __ Breakpoint();
+    return;
+  }
+  if (FLAG_optimization_counter_threshold >= 0) {
+    Register func_reg = temp_reg;
+    ASSERT(temp_reg == R9);
+    __ Comment("Increment function counter");
+    __ LoadFieldFromOffset(func_reg, IC_DATA_REG,
+                           target::ICData::owner_offset());
+    __ LoadFieldFromOffset(
+        R10, func_reg, target::Function::usage_counter_offset(), kFourBytes);
+    __ AddImmediate(R10, R10, 1);
+    __ StoreFieldToOffset(R10, func_reg,
+                          target::Function::usage_counter_offset(), kFourBytes);
+  }
+}
+
+// Note: R8 must be preserved.
+// Attempt a quick Smi operation for known operations ('kind'). The ICData
+// must have been primed with a Smi/Smi check that will be used for counting
+// the invocations.
+static void EmitFastSmiOp(Assembler* assembler,
+                          Token::Kind kind,
+                          intptr_t num_args,
+                          Label* not_smi_or_overflow) {
+  __ Comment("Fast Smi op");
+  __ LoadFromOffset(R3, SP, +1 * target::kWordSize);  // Left.
+  __ LoadFromOffset(R4, SP, +0 * target::kWordSize);  // Right.
+  __ or_(TMP, R3, R4);
+  __ BranchIfNotSmi(TMP, not_smi_or_overflow);
+  switch (kind) {
+    case Token::kADD: {
+      // Overflow is synthesised from sign bits (ABI-SPEC 7.5); the sum goes
+      // to a scratch register so that R3 is intact on the overflow path.
+      __ AddBranchOverflow(R5, R3, R4, not_smi_or_overflow);
+      __ MoveRegister(R3, R5);
+      break;
+    }
+    case Token::kLT:
+    case Token::kEQ: {
+      Label is_true, done;
+      __ CompareObjectRegisters(R3, R4);
+      __ BranchIf(kind == Token::kLT ? LESS : EQUAL, &is_true,
+                  Assembler::kNearJump);
+      __ LoadObject(R3, CastHandle<Object>(FalseObject()));
+      __ Jump(&done, Assembler::kNearJump);
+      __ Bind(&is_true);
+      __ LoadObject(R3, CastHandle<Object>(TrueObject()));
+      __ Bind(&done);
+      break;
+    }
+    default:
+      UNIMPLEMENTED();
+  }
+
+  // R8: IC data object (preserved).
+  __ LoadFieldFromOffset(R9, IC_DATA_REG, target::ICData::entries_offset());
+  // R9: ic_data_array with check entries: classes and target functions.
+  __ AddImmediate(R9, R9, target::Array::data_offset() - kHeapObjectTag);
+// R9: points directly to the first ic data array element.
+#if defined(DEBUG)
+  // Check that first entry is for Smi/Smi.
+  Label error, ok;
+  const intptr_t imm_smi_cid = target::ToRawSmi(kSmiCid);
+  __ LoadCompressedSmiFromOffset(R4, R9, 0);
+  __ CompareImmediate(R4, imm_smi_cid);
+  __ BranchIf(NOT_EQUAL, &error);
+  __ LoadCompressedSmiFromOffset(R4, R9, target::kCompressedWordSize);
+  __ CompareImmediate(R4, imm_smi_cid);
+  __ BranchIf(EQUAL, &ok);
+  __ Bind(&error);
+  __ Stop("Incorrect IC data");
+  __ Bind(&ok);
+#endif
+  if (FLAG_optimization_counter_threshold >= 0) {
+    const intptr_t count_offset =
+        target::ICData::CountIndexFor(num_args) * target::kCompressedWordSize;
+    // Update counter, ignore overflow.
+    __ LoadCompressedSmiFromOffset(R4, R9, count_offset);
+    __ AddImmediate(R4, R4, target::ToRawSmi(1));
+    __ StoreToOffset(R4, R9, count_offset);
+  }
+
+  __ Ret();
+}
+
+// Saves the offset of the target entry-point (from the Function) into R14.
+//
+// Must be the first code generated, since any code before will be skipped in
+// the unchecked entry-point.
+static void GenerateRecordEntryPoint(Assembler* assembler) {
+  Label done;
+  __ LoadImmediate(R14,
+                   target::Function::entry_point_offset() - kHeapObjectTag);
+  __ Jump(&done);
+  __ BindUncheckedEntryPoint();
+  __ LoadImmediate(
+      R14, target::Function::entry_point_offset(CodeEntryKind::kUnchecked) -
+               kHeapObjectTag);
+  __ Bind(&done);
+}
+
+// Generate inline cache check for 'num_args'.
+//  R3: receiver (if instance call)
+//  R8: ICData
+//  LR: return address
+// Control flow:
+// - If receiver is null -> jump to IC miss.
+// - If receiver is Smi -> load Smi class.
+// - If receiver is not-Smi -> load receiver's class.
+// - Check if 'num_args' (including receiver) match any IC data group.
+// - Match found -> jump to target.
+// - Match not found -> jump to IC miss.
+void StubCodeCompiler::GenerateNArgsCheckInlineCacheStub(
+    intptr_t num_args,
+    const RuntimeEntry& handle_ic_miss,
+    Token::Kind kind,
+    Optimized optimized,
+    CallType type,
+    Exactness exactness) {
+  const bool save_entry_point = kind == Token::kILLEGAL;
+  if (FLAG_precompiled_mode) {
+    __ Breakpoint();
+    return;
+  }
+
+  if (save_entry_point) {
+    GenerateRecordEntryPoint(assembler);
+  }
+
+  if (optimized == kOptimized) {
+    GenerateOptimizedUsageCounterIncrement();
+  } else {
+    GenerateUsageCounterIncrement(/*temp_reg=*/R9);
+  }
+
+  ASSERT(num_args == 1 || num_args == 2);
+#if defined(DEBUG)
+  {
+    Label ok;
+    // Check that the IC data array has NumArgsTested() == num_args.
+    // 'NumArgsTested' is stored in the least significant bits of 'state_bits'.
+    __ LoadFromOffset(R9, IC_DATA_REG,
+                      target::ICData::state_bits_offset() - kHeapObjectTag,
+                      kUnsignedFourBytes);
+    ASSERT(target::ICData::NumArgsTestedShift() == 0);  // No shift needed.
+    __ AndImmediate(R9, R9, target::ICData::NumArgsTestedMask());
+    __ CompareImmediate(R9, num_args);
+    __ BranchIf(EQUAL, &ok);
+    __ Stop("Incorrect stub for IC data");
+    __ Bind(&ok);
+  }
+#endif  // DEBUG
+
+#if !defined(PRODUCT)
+  Label stepping, done_stepping;
+  if (optimized == kUnoptimized) {
+    __ Comment("Check single stepping");
+    __ LoadFromOffset(R9, THR, target::Thread::single_step_offset(),
+                      kUnsignedByte);
+    __ CompareImmediate(R9, 0);
+    __ BranchIf(NOT_EQUAL, &stepping);
+    __ Bind(&done_stepping);
+  }
+#endif
+
+  Label not_smi_or_overflow;
+  if (kind != Token::kILLEGAL) {
+    EmitFastSmiOp(assembler, kind, num_args, &not_smi_or_overflow);
+  }
+  __ Bind(&not_smi_or_overflow);
+
+  __ Comment("Extract ICData initial values and receiver cid");
+  // R8: IC data object (preserved).
+  __ LoadFieldFromOffset(R9, IC_DATA_REG, target::ICData::entries_offset());
+  // R9: ic_data_array with check entries: classes and target functions.
+  __ AddImmediate(R9, R9, target::Array::data_offset() - kHeapObjectTag);
+  // R9: points directly to the first ic data array element.
+
+  if (type == kInstanceCall) {
+    __ LoadTaggedClassIdMayBeSmi(R6, R3);
+    __ LoadFieldFromOffset(ARGS_DESC_REG, IC_DATA_REG,
+                           target::CallSiteData::arguments_descriptor_offset());
+    if (num_args == 2) {
+      __ LoadCompressedSmiFieldFromOffset(
+          R10, ARGS_DESC_REG, target::ArgumentsDescriptor::count_offset());
+      __ SmiUntag(R10);  // Untag so we can scale by the word size.
+      __ AddImmediate(R10, R10, -2);
+      // R4 <- [SP + (R10 << 3)]
+      LoadWordIndexed(assembler, R5, SP, R10);
+      __ LoadTaggedClassIdMayBeSmi(R4, R5);
+    }
+  } else {
+    __ LoadFieldFromOffset(ARGS_DESC_REG, IC_DATA_REG,
+                           target::CallSiteData::arguments_descriptor_offset());
+    __ LoadCompressedSmiFieldFromOffset(
+        R10, ARGS_DESC_REG, target::ArgumentsDescriptor::count_offset());
+    __ SmiUntag(R10);  // Untag so we can scale by the word size.
+    __ AddImmediate(R10, R10, -1);
+    // R3 <- [SP + (R10 << 3)]
+    LoadWordIndexed(assembler, R3, SP, R10);
+    __ LoadTaggedClassIdMayBeSmi(R6, R3);
+    if (num_args == 2) {
+      __ AddImmediate(R4, R10, -1);
+      // R4 <- [SP + (R4 << 3)]
+      LoadWordIndexed(assembler, R5, SP, R4);
+      __ LoadTaggedClassIdMayBeSmi(R4, R5);
+    }
+  }
+  // R6: first argument class ID as Smi.
+  // R4: second argument class ID as Smi.
+  // R7: arguments descriptor
+
+  // (simple) The loop is not unrolled.
+  Label loop, found, miss;
+  __ Comment("ICData loop");
+
+  __ Bind(&loop);
+  {
+    Label update;
+
+    __ LoadCompressedSmiFromOffset(R5, R9, 0);
+    __ CompareObjectRegisters(R6, R5);  // Class id match?
+    if (num_args == 2) {
+      __ BranchIf(NOT_EQUAL, &update);  // Continue.
+      __ LoadCompressedSmiFromOffset(R5, R9, target::kCompressedWordSize);
+      __ CompareObjectRegisters(R4, R5);  // Class id match?
+    }
+    __ BranchIf(EQUAL, &found);  // Break.
+
+    __ Bind(&update);
+
+    // Reload the cid of the first tested argument: with two arguments R5 may
+    // hold the second one, and the end-of-data test is on the first.
+    __ LoadCompressedSmiFromOffset(R5, R9, 0);
+    const intptr_t entry_size = target::ICData::TestEntryLengthFor(
+                                    num_args, exactness == kCheckExactness) *
+                                target::kCompressedWordSize;
+    __ AddImmediate(R9, R9, entry_size);  // Next entry.
+
+    __ CompareImmediate(R5, target::ToRawSmi(kIllegalCid));  // Done?
+    __ BranchIf(NOT_EQUAL, &loop);
+  }
+
+  __ Bind(&miss);
+  __ Comment("IC miss");
+
+  // Compute address of arguments.
+  __ LoadCompressedSmiFieldFromOffset(
+      R10, ARGS_DESC_REG, target::ArgumentsDescriptor::count_offset());
+  __ SmiUntag(R10);  // Untag so we can scale by the word size.
+  __ AddImmediate(R10, R10, -1);
+  // R10: argument_count - 1 (untagged).
+  // R10 <- SP + (R10 << 3)
+  __ sldi(R10, R10, target::kWordSizeLog2);
+  __ add(R10, SP, R10);
+  // R10: address of receiver.
+  // Create a stub frame as we are pushing some objects on the stack before
+  // calling into the runtime.
+  __ EnterStubFrame();
+  // Preserve IC data object and arguments descriptor array and
+  // setup space on stack for result (target code object).
+  __ PushRegister(ARGS_DESC_REG);  // Preserve arguments descriptor array.
+  __ PushRegister(IC_DATA_REG);    // Preserve IC Data.
+  if (save_entry_point) {
+    __ SmiTag(R14);
+    __ PushRegister(R14);
+  }
+  // Setup space on stack for the result (target code object).
+  __ PushImmediate(0);
+  // Push call arguments.
+  for (intptr_t i = 0; i < num_args; i++) {
+    __ LoadFromOffset(TMP, R10, -i * target::kWordSize);
+    __ PushRegister(TMP);
+  }
+  // Pass IC data object.
+  __ PushRegister(IC_DATA_REG);
+  __ CallRuntime(handle_ic_miss, num_args + 1);
+  // Remove the call arguments pushed earlier, including the IC data object.
+  __ Drop(num_args + 1);
+  // Pop returned function object into R3.
+  // Restore arguments descriptor array and IC data array.
+  __ PopRegister(FUNCTION_REG);  // Pop returned function object into R3.
+  if (save_entry_point) {
+    __ PopRegister(R14);
+    __ SmiUntag(R14);
+  }
+  __ PopRegister(IC_DATA_REG);    // Restore IC Data.
+  __ PopRegister(ARGS_DESC_REG);  // Restore arguments descriptor array.
+  __ RestoreCodePointer();
+  __ LeaveStubFrame();
+  Label call_target_function;
+  if (FLAG_precompiled_mode) {
+    GenerateDispatcherCode(assembler, &call_target_function);
+  } else {
+    __ Jump(&call_target_function);
+  }
+
+  __ Bind(&found);
+  // R9: pointer to an IC data check group.
+  const intptr_t target_offset =
+      target::ICData::TargetIndexFor(num_args) * target::kCompressedWordSize;
+  const intptr_t count_offset =
+      target::ICData::CountIndexFor(num_args) * target::kCompressedWordSize;
+  const intptr_t exactness_offset =
+      target::ICData::ExactnessIndexFor(num_args) * target::kCompressedWordSize;
+
+  Label call_target_function_through_unchecked_entry;
+  if (exactness == kCheckExactness) {
+    Label exactness_ok;
+    ASSERT(num_args == 1);
+    __ LoadCompressedSmi(R4, Address(R9, exactness_offset));
+    __ CompareImmediate(
+        R4, target::ToRawSmi(
+                StaticTypeExactnessState::HasExactSuperType().Encode()));
+    __ BranchIf(LESS, &exactness_ok);
+    __ CompareImmediate(
+        R4, target::ToRawSmi(
+                StaticTypeExactnessState::HasExactSuperType().Encode()));
+    __ BranchIf(EQUAL, &call_target_function_through_unchecked_entry);
+
+    // Check trivial exactness.
+    // Note: UntaggedICData::receivers_static_type_ is guaranteed to be not null
+    // because we only emit calls to this stub when it is not null.
+    __ LoadCompressed(
+        R5, FieldAddress(IC_DATA_REG,
+                         target::ICData::receivers_static_type_offset()));
+    __ LoadCompressed(R5, FieldAddress(R5, target::Type::arguments_offset()));
+    // R4 contains an offset to type arguments in words as a smi,
+    // hence TIMES_4. R3 is guaranteed to be non-smi because it is expected
+    // to have type arguments.
+    __ LoadIndexedPayload(R6, R3, 0, R4, TIMES_COMPRESSED_HALF_WORD_SIZE,
+                          kObjectBytes);
+    __ CompareObjectRegisters(R5, R6);
+    __ BranchIf(EQUAL, &call_target_function_through_unchecked_entry);
+
+    // Update exactness state (not-exact anymore).
+    __ LoadImmediate(
+        R4, target::ToRawSmi(StaticTypeExactnessState::NotExact().Encode()));
+    __ StoreToOffset(R4, R9, exactness_offset);
+    __ Bind(&exactness_ok);
+  }
+  __ LoadCompressedFromOffset(FUNCTION_REG, R9, target_offset);
+
+  if (FLAG_optimization_counter_threshold >= 0) {
+    __ Comment("Update caller's counter");
+    __ LoadCompressedSmiFromOffset(R4, R9, count_offset);
+    __ AddImmediate(R4, R4, target::ToRawSmi(1));
+    __ StoreToOffset(R4, R9, count_offset);
+  }
+
+  __ Comment("Call target");
+  __ Bind(&call_target_function);
+  // R3: target function.
+  __ LoadCompressedFieldFromOffset(CODE_REG, FUNCTION_REG,
+                                   target::Function::code_offset());
+  if (save_entry_point) {
+    // R14: untagged offset of the entry point field in the Function.
+    __ Jump(Address(FUNCTION_REG, R14));
+  } else {
+    __ Jump(
+        FieldAddress(FUNCTION_REG, target::Function::entry_point_offset()));
+  }
+
+  if (exactness == kCheckExactness) {
+    __ Bind(&call_target_function_through_unchecked_entry);
+    if (FLAG_optimization_counter_threshold >= 0) {
+      __ Comment("Update ICData counter");
+      __ LoadCompressedSmiFromOffset(R4, R9, count_offset);
+      __ AddImmediate(R4, R4, target::ToRawSmi(1));
+      __ StoreToOffset(R4, R9, count_offset);
+    }
+    __ Comment("Call target (via unchecked entry point)");
+    __ LoadCompressedFromOffset(FUNCTION_REG, R9, target_offset);
+    __ LoadCompressedFieldFromOffset(CODE_REG, FUNCTION_REG,
+                                     target::Function::code_offset());
+    __ Jump(FieldAddress(
+        FUNCTION_REG,
+        target::Function::entry_point_offset(CodeEntryKind::kUnchecked)));
+  }
+
+#if !defined(PRODUCT)
+  if (optimized == kUnoptimized) {
+    __ Bind(&stepping);
+    __ EnterStubFrame();
+    if (type == kInstanceCall) {
+      __ PushRegister(R3);  // Preserve receiver.
+    }
+    if (save_entry_point) {
+      __ SmiTag(R14);
+      __ PushRegister(R14);
+    }
+    __ PushRegister(IC_DATA_REG);  // Preserve IC data.
+    __ CallRuntime(kSingleStepHandlerRuntimeEntry, 0);
+    __ PopRegister(IC_DATA_REG);
+    if (save_entry_point) {
+      __ PopRegister(R14);
+      __ SmiUntag(R14);
+    }
+    if (type == kInstanceCall) {
+      __ PopRegister(R3);
+    }
+    __ RestoreCodePointer();
+    __ LeaveStubFrame();
+    __ Jump(&done_stepping);
+  }
+#endif
+}

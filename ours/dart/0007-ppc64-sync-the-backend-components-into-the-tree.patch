+// Input parameters:
+//   LR : return address.
+//   SP : address of return value.
+//   R8 : address of the native function to call.
+//   R5 : address of first argument in argument array.
+//   R4 : argc_tag including number of arguments and function kind.
+//
+// S-2. The wrappers are `void Wrapper(Dart_NativeArguments, Dart_NativeFunction)`
+// and take a POINTER to the NativeArguments, which therefore is built in
+// memory here (unlike in GenerateCallToRuntimeStub).
+static void GenerateCallNativeWithWrapperStub(Assembler* assembler,
+                                              Address wrapper) {
+  const intptr_t thread_offset = target::NativeArguments::thread_offset();
+  const intptr_t argc_tag_offset = target::NativeArguments::argc_tag_offset();
+  const intptr_t argv_offset = target::NativeArguments::argv_offset();
+  const intptr_t retval_offset = target::NativeArguments::retval_offset();
+
+  __ EnterStubFrame();
+
+  // Save exit frame information to enable stack walking as we are about
+  // to transition to native code.
+  __ StoreToOffset(FP, THR, target::Thread::top_exit_frame_info_offset());
+
+  // Mark that the thread exited generated code through a runtime call.
+  __ LoadImmediate(TMP, target::Thread::exit_through_runtime_call());
+  __ StoreToOffset(TMP, THR, target::Thread::exit_through_ffi_offset());
+
+#if defined(DEBUG)
+  CheckComingFromDartCode(assembler);
+#endif
+
+  // Mark that the thread is executing native code.
+  __ StoreToOffset(R8, THR, target::Thread::vm_tag_offset());
+
+  // Reserve space for the native arguments structure passed on the stack (the
+  // outgoing pointer parameter to the native arguments structure is passed in
+  // R3) and align frame before entering the C++ world.
+  __ ReserveAlignedFrameSpace(target::NativeArguments::StructSize());
+
+  // Initialize target::NativeArguments structure and call native function.
+  ASSERT(thread_offset == 0 * target::kWordSize);
+  ASSERT(argc_tag_offset == 1 * target::kWordSize);
+  // Set argc in target::NativeArguments: R4 already contains argc.
+  ASSERT(argv_offset == 2 * target::kWordSize);
+  // Set argv in target::NativeArguments: R5 already contains argv.
+
+  // Set retval in NativeArgs.
+  ASSERT(retval_offset == 3 * target::kWordSize);
+  __ AddImmediate(
+      R6, FP, (target::frame_layout.param_end_from_fp + 1) * target::kWordSize);
+
+  // Passing the structure by value as in runtime calls would require changing
+  // Dart API for native functions.
+  // For now, space is reserved on the stack and we pass a pointer to it.
+  __ StoreToOffset(THR, SP, thread_offset);
+  __ StoreToOffset(R4, SP, argc_tag_offset);
+  __ StoreToOffset(R5, SP, argv_offset);
+  __ StoreToOffset(R6, SP, retval_offset);
+  __ MoveRegister(R3, SP);  // Pass the pointer to the target::NativeArguments.
+
+  __ MoveRegister(R4, R8);  // Pass the function entrypoint to call.
+
+  // Call native function invocation wrapper. The structure sits just above
+  // the frame header CallCFunction pushes.
+  __ CallCFunction(wrapper);
+
+  MarkBackInDartCode(assembler);
+
+  __ LeaveStubFrame();
+  __ Ret();
+}
+
+void StubCodeCompiler::GenerateCallNoScopeNativeStub() {
+  GenerateCallNativeWithWrapperStub(
+      assembler,
+      Address(THR,
+              target::Thread::no_scope_native_wrapper_entry_point_offset()));
+}

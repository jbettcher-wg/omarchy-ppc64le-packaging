+void StubCodeCompiler::GenerateGetCStackPointerStub() {
+  __ MoveRegister(R3, SP);
+  __ Ret();
+}
+
+// Jump to a frame on the call stack.
+// LR: return address.
+// R3: program_counter.
+// R4: stack_pointer.
+// R5: frame_pointer.
+// R6: thread.
+// Does not return.
+//
+// S-10. A non-local transfer: the continuation is entered with mtctr/bctr,
+// never with blr, so the link-stack predictor is not fed an unpaired return.
+void StubCodeCompiler::GenerateJumpToFrameStub() {
+  ASSERT(kExceptionObjectReg == R3);
+  ASSERT(kStackTraceObjectReg == R4);
+  // The continuation does not rely on any callee-saved register: a catch
+  // entry reloads everything, and InvokeDartCode restores its own save area.
+  const Register kPcReg = CALLEE_SAVED_TEMP;
+  __ MoveRegister(THR, R6);
+  __ MoveRegister(kPcReg, R3);  // Program counter.
+  __ MoveRegister(SP, R4);      // Stack pointer.
+  __ MoveRegister(FP, R5);      // Frame_pointer.
+
+  // Refresh pinned registers (write barrier mask, null, dispatch table, etc).
+  __ RestorePinnedRegisters();
+  // Set the tag.
+  __ LoadImmediate(TMP, VMTag::kDartTagId);
+  __ StoreToOffset(TMP, THR, target::Thread::vm_tag_offset());
+  // Clear top exit frame.
+  __ StoreZero(Address(THR, target::Thread::top_exit_frame_info_offset()));
+  // Restore the pool pointer.
+  __ RestoreCodePointer();
+  if (FLAG_precompiled_mode) {
+    __ SetupGlobalPoolAndDispatchTable();
+  } else {
+    __ LoadPoolPointer();
+  }
+  __ JumpRegister(kPcReg);  // Jump to continuation point.
+}
+
+// Run an exception handler.  Execution comes from JumpToFrame
+// stub or from the simulator.
+//
+// The arguments are stored in the Thread object.
+// Does not return.
+static void GenerateRunExceptionHandler(Assembler* assembler,
+                                        bool unbox_exception) {
+  word offset_from_thread = 0;
+  bool ok = target::CanLoadFromThread(NullObject(), &offset_from_thread);
+  ASSERT(ok);
+  __ LoadFromOffset(R5, THR, offset_from_thread);
+
+  // Exception object.
+  __ LoadFromOffset(R3, THR, target::Thread::active_exception_offset());
+  __ StoreToOffset(R5, THR, target::Thread::active_exception_offset());
+  if (unbox_exception) {
+    compiler::Label not_smi, done;
+    __ BranchIfNotSmi(R3, &not_smi);
+    __ SmiUntag(R3);
+    __ Jump(&done);
+    __ Bind(&not_smi);
+    __ LoadFieldFromOffset(R3, R3, target::Mint::value_offset());
+    __ Bind(&done);
+  }
+
+  // StackTrace object.
+  __ LoadFromOffset(R4, THR, target::Thread::active_stacktrace_offset());
+  __ StoreToOffset(R5, THR, target::Thread::active_stacktrace_offset());
+
+  // Jump to the exception handler code: ld r0 ; mtctr r0 ; bctr (S-10).
+  __ Jump(Address(THR, target::Thread::resume_pc_offset()));
+}
+
+void StubCodeCompiler::GenerateRunExceptionHandlerStub() {
+  GenerateRunExceptionHandler(assembler, false);
+}
+
+void StubCodeCompiler::GenerateRunExceptionHandlerUnboxStub() {
+  GenerateRunExceptionHandler(assembler, true);
+}
+
+// Deoptimize a frame on the call stack before rewinding.
+// The arguments are stored in the Thread object.
+// No result.
+void StubCodeCompiler::GenerateDeoptForRewindStub() {
+  // Push zap value instead of CODE_REG.
+  __ LoadImmediate(TMP, kZapCodeReg);
+  __ PushRegister(TMP);
+
+  // Load the deopt pc into LR.
+  __ LoadFromOffset(TMP, THR, target::Thread::resume_pc_offset());
+  __ SetReturnAddress(TMP);
+  GenerateDeoptimizationSequence(assembler, kEagerDeopt);
+
+  // After we have deoptimized, jump to the correct frame.
+  __ EnterStubFrame();
+  __ CallRuntime(kRewindPostDeoptRuntimeEntry, 0);
+  __ LeaveStubFrame();
+  __ Breakpoint();
+}
+
+// Calls to the runtime to optimize the given function.
+// R9: function to be re-optimized.
+// ARGS_DESC_REG: argument descriptor (preserved).
+void StubCodeCompiler::GenerateOptimizeFunctionStub() {
+  __ LoadFromOffset(CODE_REG, THR, target::Thread::optimize_stub_offset());
+  __ EnterStubFrame();
+  __ PushRegister(ARGS_DESC_REG);
+  // Setup space on stack for the return value.
+  __ PushImmediate(0);
+  __ PushRegister(R9);
+  __ CallRuntime(kOptimizeInvokedFunctionRuntimeEntry, 1);
+  __ PopRegister(R3);             // Discard argument.
+  __ PopRegister(FUNCTION_REG);   // Get Function object
+  __ PopRegister(ARGS_DESC_REG);  // Restore argument descriptor.
+  __ LoadCompressedFieldFromOffset(CODE_REG, FUNCTION_REG,
+                                   target::Function::code_offset());
+  __ LeaveStubFrame();
+  __ Jump(FieldAddress(FUNCTION_REG, target::Function::entry_point_offset()));
+  __ Breakpoint();
+}
+
+// Does identical check (object references are equal or not equal) with special
+// checks for boxed numbers.
+//
+// S-12. There are no condition flags to return, so, as on RISC-V, the result
+// is returned as TMP zero if identical, non-zero if not; the caller does
+// CompareImmediate(TMP, 0). Clobbers left and right.
+//
+// Note: A Mint cannot contain a value that would fit in Smi.
+static void GenerateIdenticalWithNumberCheckStub(Assembler* assembler,
+                                                 const Register left,
+                                                 const Register right) {
+  Label reference_compare, check_mint;
+  // If any of the arguments is Smi do reference compare.
+  // Note: A Mint cannot contain a value that would fit in Smi.
+  __ BranchIfSmi(left, &reference_compare);
+  __ BranchIfSmi(right, &reference_compare);
+
+  // Value compare for two doubles.
+  __ CompareClassId(left, kDoubleCid, /*scratch=*/TMP);
+  __ BranchIf(NOT_EQUAL, &check_mint);
+  __ CompareClassId(right, kDoubleCid, /*scratch=*/TMP);
+  __ BranchIf(NOT_EQUAL, &reference_compare);
+
+  // Double values bitwise compare.
+  __ LoadFieldFromOffset(left, left, target::Double::value_offset());
+  __ LoadFieldFromOffset(right, right, target::Double::value_offset());
+  __ xor_(TMP, left, right);
+  __ Ret();
+
+  __ Bind(&check_mint);
+  __ CompareClassId(left, kMintCid, /*scratch=*/TMP);
+  __ BranchIf(NOT_EQUAL, &reference_compare);
+  __ CompareClassId(right, kMintCid, /*scratch=*/TMP);
+  __ BranchIf(NOT_EQUAL, &reference_compare);
+  __ LoadFieldFromOffset(left, left, target::Mint::value_offset());
+  __ LoadFieldFromOffset(right, right, target::Mint::value_offset());
+  __ xor_(TMP, left, right);
+  __ Ret();
+
+  __ Bind(&reference_compare);
+  __ xor_(TMP, left, right);
+  __ Ret();
+}
+
+// Called only from unoptimized code. All relevant registers have been saved.
+// LR: return address.
+// SP + 8: left operand.
+// SP + 0: right operand.
+// Return TMP == 0 if equal.
+void StubCodeCompiler::GenerateUnoptimizedIdenticalWithNumberCheckStub() {
+#if !defined(PRODUCT)
+  // Check single stepping.
+  Label stepping, done_stepping;
+  __ LoadFromOffset(R4, THR, target::Thread::single_step_offset(),
+                    kUnsignedByte);
+  __ CompareImmediate(R4, 0);
+  __ BranchIf(NOT_EQUAL, &stepping);
+  __ Bind(&done_stepping);
+#endif
+
+  const Register left = R4;
+  const Register right = R3;
+  __ LoadFromOffset(left, SP, 1 * target::kWordSize);
+  __ LoadFromOffset(right, SP, 0 * target::kWordSize);
+  GenerateIdenticalWithNumberCheckStub(assembler, left, right);
+
+#if !defined(PRODUCT)
+  __ Bind(&stepping);
+  __ EnterStubFrame();
+  __ CallRuntime(kSingleStepHandlerRuntimeEntry, 0);
+  __ RestoreCodePointer();
+  __ LeaveStubFrame();
+  __ Jump(&done_stepping);
+#endif
+}
+
+// Called from optimized code only.
+// LR: return address.
+// SP + 8: left operand.
+// SP + 0: right operand.
+// Return TMP == 0 if equal.
+void StubCodeCompiler::GenerateOptimizedIdenticalWithNumberCheckStub() {
+  const Register left = R4;
+  const Register right = R3;
+  __ LoadFromOffset(left, SP, 1 * target::kWordSize);
+  __ LoadFromOffset(right, SP, 0 * target::kWordSize);
+  GenerateIdenticalWithNumberCheckStub(assembler, left, right);
+}
+
+// Called from megamorphic call sites.
+//  R3: receiver (passed to target)
+//  IC_DATA_REG: MegamorphicCache (preserved)
+// Passed to target:
+//  FUNCTION_REG: target function
+//  CODE_REG: target Code
+//  ARGS_DESC_REG: arguments descriptor
+void StubCodeCompiler::GenerateMegamorphicCallStub() {
+  // Jump if receiver is a smi.
+  Label smi_case;
+  __ BranchIfSmi(R3, &smi_case);
+
+  // Loads the cid of the object.
+  __ LoadClassId(R14, R3);
+
+  Label cid_loaded;
+  __ Bind(&cid_loaded);
+  __ LoadFieldFromOffset(R4, IC_DATA_REG,
+                         target::MegamorphicCache::mask_offset());
+  __ LoadFieldFromOffset(R5, IC_DATA_REG,
+                         target::MegamorphicCache::buckets_offset());
+  // R5: cache buckets array.
+  // R4: mask as a smi.
+
+  // Make the cid into a smi.
+  __ SmiTag(R14);
+  // R14: class ID of the receiver (smi).
+
+  // Compute the table index.
+  ASSERT(target::MegamorphicCache::kSpreadFactor == 7);
+  // Use (x << 3) - x to multiply by 7.
+  __ sldi(R6, R14, 3);
+  __ subf(R6, R14, R6);
+  // R6: probe.
+  Label loop;
+  __ Bind(&loop);
+  __ and_(R6, R6, R4);
+
+  const intptr_t base = target::Array::data_offset();
+  // R6 is smi tagged, but table entries are 16 bytes, so LSL 3.
+  __ sldi(TMP, R6, target::kCompressedWordSizeLog2);
+  __ add(TMP, R5, TMP);
+  __ LoadCompressedSmiFieldFromOffset(R9, TMP, base);
+  Label probe_failed;
+  __ CompareObjectRegisters(R9, R14);
+  __ BranchIf(NOT_EQUAL, &probe_failed);
+
+  Label load_target;
+  __ Bind(&load_target);
+  // Call the target found in the cache.  For a class id match, this is a
+  // proper target for the given name and arguments descriptor.  If the
+  // illegal class id was found, the target is a cache miss handler that can
+  // be invoked as a normal Dart function.
+  __ LoadCompressed(FUNCTION_REG,
+                    FieldAddress(TMP, base + target::kCompressedWordSize));
+  __ LoadFieldFromOffset(ARGS_DESC_REG, IC_DATA_REG,
+                         target::CallSiteData::arguments_descriptor_offset());
+  if (!FLAG_precompiled_mode) {
+    __ LoadCompressed(
+        CODE_REG, FieldAddress(FUNCTION_REG, target::Function::code_offset()));
+  }
+  __ Jump(FieldAddress(FUNCTION_REG, target::Function::entry_point_offset()));
+
+  // Probe failed, check if it is a miss.
+  __ Bind(&probe_failed);
+  ASSERT(kIllegalCid == 0);
+  __ CompareImmediate(R9, 0);
+  Label miss;
+  __ BranchIf(EQUAL, &miss);  // branch if miss.
+
+  // Try next entry in the table.
+  __ AddImmediate(R6, R6, target::ToRawSmi(1));
+  __ Jump(&loop);
+
+  // Load cid for the Smi case.
+  __ Bind(&smi_case);
+  __ LoadImmediate(R14, kSmiCid);
+  __ Jump(&cid_loaded);
+
+  __ Bind(&miss);
+  GenerateSwitchableCallMissStub();
+}
+
+// Input:
+//   R3 - receiver
+//   IC_DATA_REG - icdata
+void StubCodeCompiler::GenerateICCallThroughCodeStub() {
+  Label loop, found, miss;
+  __ LoadFieldFromOffset(R14, IC_DATA_REG, target::ICData::entries_offset());
+  __ LoadFieldFromOffset(ARGS_DESC_REG, IC_DATA_REG,
+                         target::CallSiteData::arguments_descriptor_offset());
+  __ AddImmediate(R14, R14, target::Array::data_offset() - kHeapObjectTag);
+  // R14: first IC entry
+  __ LoadTaggedClassIdMayBeSmi(R4, R3);
+  // R4: receiver cid as Smi
+
+  __ Bind(&loop);
+  __ LoadCompressedSmi(R5, Address(R14, 0));
+  __ CompareObjectRegisters(R4, R5);
+  __ BranchIf(EQUAL, &found);
+  __ CompareImmediate(R5, target::ToRawSmi(kIllegalCid));
+  __ BranchIf(EQUAL, &miss);
+
+  const intptr_t entry_length =
+      target::ICData::TestEntryLengthFor(1, /*exactness_check=*/false) *
+      target::kCompressedWordSize;
+  __ AddImmediate(R14, R14, entry_length);  // Next entry.
+  __ Jump(&loop);
+
+  __ Bind(&found);
+  if (FLAG_precompiled_mode) {
+    const intptr_t entry_offset =
+        target::ICData::EntryPointIndexFor(1) * target::kCompressedWordSize;
+    __ LoadCompressed(FUNCTION_REG, Address(R14, entry_offset));
+    __ Jump(FieldAddress(FUNCTION_REG, target::Function::entry_point_offset()));
+  } else {
+    const intptr_t code_offset =
+        target::ICData::CodeIndexFor(1) * target::kCompressedWordSize;
+    __ LoadCompressed(CODE_REG, Address(R14, code_offset));
+    __ Jump(FieldAddress(CODE_REG, target::Code::entry_point_offset()));
+  }
+
+  __ Bind(&miss);
+  __ Jump(Address(THR, target::Thread::switchable_call_miss_entry_offset()));
+}
+
+// Implement the monomorphic entry check for call-sites where the receiver
+// might be a Smi.
+//
+//   R3: receiver
+//   IC_DATA_REG: MonomorphicSmiableCall object
+//
+//   R4, TMP, TMP2: clobbered
+void StubCodeCompiler::GenerateMonomorphicSmiableCheckStub() {
+  Label miss;
+  __ LoadClassIdMayBeSmi(TMP, R3);
+
+  __ LoadField(
+      TMP2,
+      FieldAddress(IC_DATA_REG,
+                   target::MonomorphicSmiableCall::expected_cid_offset()));
+  __ CompareRegisters(TMP, TMP2);
+  __ BranchIf(NOT_EQUAL, &miss);
+  __ Jump(FieldAddress(IC_DATA_REG,
+                       target::MonomorphicSmiableCall::entrypoint_offset()));
+
+  __ Bind(&miss);
+  __ Jump(Address(THR, target::Thread::switchable_call_miss_entry_offset()));
+}
+
+// Called from switchable IC calls.
+//  R3: receiver
+void StubCodeCompiler::GenerateSwitchableCallMissStub() {
+  __ LoadFromOffset(CODE_REG, THR,
+                    target::Thread::switchable_call_miss_stub_offset());
+  __ EnterStubFrame();
+  __ PushRegister(R3);  // Preserve receiver.
+
+  __ PushImmediate(0);  // Result slot.
+  __ PushImmediate(0);  // Arg0: stub out.
+  __ PushRegister(R3);  // Arg1: Receiver
+  __ CallRuntime(kSwitchableCallMissRuntimeEntry, 2);
+  __ Drop(1);
+  __ PopRegister(CODE_REG);     // result = stub
+  __ PopRegister(IC_DATA_REG);  // result = IC
+
+  __ PopRegister(R3);  // Restore receiver.
+  __ LeaveStubFrame();
+
+  __ Jump(FieldAddress(
+      CODE_REG, target::Code::entry_point_offset(CodeEntryKind::kNormal)));
+}
+
+// Called from switchable IC calls.
+//  R3: receiver
+//  IC_DATA_REG: SingleTargetCache
+// Passed to target:
+//  CODE_REG: target Code object
+void StubCodeCompiler::GenerateSingleTargetCallStub() {
+  Label miss;
+  __ LoadClassIdMayBeSmi(R4, R3);
+  __ LoadFieldFromOffset(R5, IC_DATA_REG,
+                         target::SingleTargetCache::lower_limit_offset(),
+                         kUnsignedTwoBytes);
+  __ LoadFieldFromOffset(R6, IC_DATA_REG,
+                         target::SingleTargetCache::upper_limit_offset(),
+                         kUnsignedTwoBytes);
+
+  __ CompareRegisters(R4, R5);
+  __ BranchIf(LESS, &miss);
+  __ CompareRegisters(R4, R6);
+  __ BranchIf(GREATER, &miss);
+
+  __ LoadFieldFromOffset(CODE_REG, IC_DATA_REG,
+                         target::SingleTargetCache::target_offset());
+  __ Jump(FieldAddress(IC_DATA_REG,
+                       target::SingleTargetCache::entry_point_offset()));
+
+  __ Bind(&miss);
+  __ EnterStubFrame();
+  __ PushRegister(R3);  // Preserve receiver.
+
+  __ PushImmediate(0);  // Result slot.
+  __ PushImmediate(0);  // Arg0: Stub out.
+  __ PushRegister(R3);  // Arg1: Receiver
+  __ CallRuntime(kSwitchableCallMissRuntimeEntry, 2);
+  __ Drop(1);
+  __ PopRegister(CODE_REG);     // result = stub
+  __ PopRegister(IC_DATA_REG);  // result = IC
+
+  __ PopRegister(R3);  // Restore receiver.
+  __ LeaveStubFrame();
+
+  __ Jump(FieldAddress(
+      CODE_REG, target::Code::entry_point_offset(CodeEntryKind::kMonomorphic)));
+}
+
+// (simple) No inline fast path: every typed data array is allocated by the
+// runtime.
+// TODO(ppc64): port the fast path of GenerateAllocateTypedDataArrayStub from
+// stub_code_compiler_arm64.cc if typed data allocation shows up in a profile.
+void StubCodeCompiler::GenerateAllocateTypedDataArrayStub(intptr_t cid) {
+  __ EnterStubFrame();
+  __ PushImmediate(0);                                     // Result slot.
+  __ PushImmediate(target::ToRawSmi(cid));                 // Cid
+  __ PushRegister(AllocateTypedDataArrayABI::kLengthReg);  // Array length
+  __ CallRuntime(kAllocateTypedDataRuntimeEntry, 2);
+  __ Drop(2);  // Drop arguments.
+  __ PopRegister(AllocateTypedDataArrayABI::kResultReg);
+  __ LeaveStubFrame();
+  __ Ret();
+}

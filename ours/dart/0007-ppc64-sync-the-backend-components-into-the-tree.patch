+// S-12 / contract 1: the identical stubs return TMP == 0 iff identical.
+// Each path records exactly one compare for the caller's BranchIf/SetIf.
+Condition FlowGraphCompiler::EmitEqualityRegConstCompare(
+    Register reg,
+    const Object& obj,
+    bool needs_number_check,
+    const InstructionSource& source,
+    intptr_t deopt_id) {
+  if (needs_number_check) {
+    ASSERT(!obj.IsMint() && !obj.IsDouble());
+    ASSERT(reg != TMP);
+    // The stub reads left at 8(SP) and right at 0(SP).
+    __ LoadObject(TMP, obj);
+    __ PushRegisterPair(TMP, reg);
+    if (is_optimizing()) {
+      // No breakpoints in optimized code.
+      __ BranchLink(StubCode::OptimizedIdenticalWithNumberCheck());
+      AddCurrentDescriptor(UntaggedPcDescriptors::kOther, deopt_id, source);
+    } else {
+      // Patchable to support breakpoints.
+      __ BranchLinkPatchable(StubCode::UnoptimizedIdenticalWithNumberCheck());
+      AddCurrentDescriptor(UntaggedPcDescriptors::kRuntimeCall, deopt_id,
+                           source);
+    }
+    // Discard the constant, restore 'reg'. Neither touches TMP.
+    __ Drop(1);
+    __ PopRegister(reg);
+    __ CompareImmediate(TMP, 0);
+  } else {
+    __ CompareObject(reg, obj);
+  }
+  return EQ;
+}
+
+Condition FlowGraphCompiler::EmitEqualityRegRegCompare(
+    Register left,
+    Register right,
+    bool needs_number_check,
+    const InstructionSource& source,
+    intptr_t deopt_id) {
+  if (needs_number_check) {
+    ASSERT(left != TMP);
+    ASSERT(right != TMP);
+    // left at 8(SP), right at 0(SP).
+    __ PushRegisterPair(right, left);
+    if (is_optimizing()) {
+      __ BranchLink(StubCode::OptimizedIdenticalWithNumberCheck());
+    } else {
+      __ BranchLinkPatchable(StubCode::UnoptimizedIdenticalWithNumberCheck());
+    }
+    AddCurrentDescriptor(UntaggedPcDescriptors::kRuntimeCall, deopt_id, source);
+    __ PopRegisterPair(right, left);
+    __ CompareImmediate(TMP, 0);
+  } else {
+    __ CompareObjectRegisters(left, right);
+  }
+  return EQ;
+}
+
+// A Bool's value bit: andi. r0,value,mask; true is ZERO (EQ). Only ZERO and
+// NOT_ZERO are valid after a Test (header contract).
+Condition FlowGraphCompiler::EmitBoolTest(Register value,
+                                          BranchLabels labels,
+                                          bool invert) {
+  __ Comment("BoolTest");
+  __ TestImmediate(value, compiler::target::ObjectAlignment::kBoolValueMask);
+  return invert ? NE : EQ;
+}

+void StubCodeCompiler::GenerateICCallBreakpointStub() {
+#if defined(PRODUCT)
+  __ Stop("No debugging in PRODUCT mode");
+#else
+  __ EnterStubFrame();
+  __ PushRegister(R3);           // Preserve receiver.
+  __ PushRegister(IC_DATA_REG);  // Preserve IC data.
+  __ PushImmediate(0);           // Space for result.
+  __ CallRuntime(kBreakpointRuntimeHandlerRuntimeEntry, 0);
+  __ PopRegister(CODE_REG);     // Original stub.
+  __ PopRegister(IC_DATA_REG);  // Restore IC data.
+  __ PopRegister(R3);           // Restore receiver.
+  __ LeaveStubFrame();
+  __ Jump(FieldAddress(CODE_REG, target::Code::entry_point_offset()));
+#endif  // defined(PRODUCT)
+}

+// assembler_ppc64_ext.cc: the [ext] methods of assembler_ppc64.h (Agent B,
+// phase 1): floating point, integer semantics, memory ordering. Standalone:
+// no target:: offsets, no object pool, no Thread, no call into a [vm-*]
+// method, so that it links in the tier-2 harness.
+//
+// Section numbers refer to work/abi/ABI-SPEC.md. Rules every body obeys:
+//   - R0 is the only scratch unless the header names another (TMP for the
+//     overflow helpers, FpuTMP for the FP conversions). Inputs are never R0.
+//   - No OE instruction, no mcrxr, no XER[SO] read: overflow is synthesised
+//     from sign bits into CR0 (7.5).
+//   - Every integer result narrower than 64 bits leaves the register
+//     extended by its signedness, whatever the input's upper bits were (7.6).
+//   - Only CR0 and CR7 are written (header rule R4).
+//   - Branches inside a macro (the larx/stcx. retry loops) use fixed byte
+//     offsets over a fixed-length body; branches to a caller's Label go
+//     through BranchIfCR.
+
+namespace dart {
+namespace compiler {
+
+namespace {
+
+constexpr intptr_t kInstrSize = Instr::kInstrSize;
+
+constexpr uint32_t Cr0Bit(CRBit bit) {
+  return CRBitIndex(CRF0, bit);
+}
+
+// Number of value bits of an integer OperandSize.
+intptr_t IntegerSizeInBits(OperandSize sz) {
+  switch (sz) {
+    case kByte:
+    case kUnsignedByte:
+      return 8;
+    case kTwoBytes:
+    case kUnsignedTwoBytes:
+      return 16;
+    case kFourBytes:
+    case kUnsignedFourBytes:
+      return 32;
+    case kEightBytes:
+      return 64;
+    default:
+      UNREACHABLE();
+      return 0;
+  }
+}
+
+// If |mask| (non-zero, at most 32 bits) is one contiguous run of ones,
+// stores the rlwinm MB/ME (IBM numbering within the low word) and returns
+// true. rlwinm with MB <= ME clears the upper word, so the result is the
+// zero-extended AND.
+bool ContiguousWordMask(uint64_t mask, int* mb, int* me) {
+  if ((mask == 0) || (mask > 0xffffffffu)) return false;
+  const int lo = Utils::CountTrailingZeros64(mask);
+  const int hi = 63 - Utils::CountLeadingZeros64(mask);  // hi <= 31
+  const uint64_t run =
+      ((uint64_t{1} << (hi + 1)) - 1) & ~((uint64_t{1} << lo) - 1);
+  if (run != mask) return false;
+  *mb = 31 - hi;
+  *me = 31 - lo;
+  return true;
+}
+
+// How a double condition is tested after fcmpu CR0 (7.7). |compose| asks for
+// cror CR7[EQ] = CR0[a] | CR0[b] first; the branch then tests CR7[EQ].
+struct DoubleCondition {
+  CRField crf;
+  CRBit bit;
+  bool if_set;
+  bool compose;
+  CRBit a;
+  CRBit b;
+};
+
+DoubleCondition DecodeDoubleCondition(Condition cond) {
+  switch (cond) {
+    case EQ:  // FE. False on NaN (unordered sets only FU).
+      return {CRF0, kCRBitEQ, true, false, kCRBitEQ, kCRBitEQ};
+    case NE:  // not FE. True on NaN, as Dart's != requires.
+      return {CRF0, kCRBitEQ, false, false, kCRBitEQ, kCRBitEQ};
+    case LT:  // FL.
+      return {CRF0, kCRBitLT, true, false, kCRBitLT, kCRBitLT};
+    case GT:  // FG.
+      return {CRF0, kCRBitGT, true, false, kCRBitGT, kCRBitGT};
+    case LE:  // FL | FE: "not FG" (ble) would be taken on NaN.
+      return {CRF7, kCRBitEQ, true, true, kCRBitLT, kCRBitEQ};
+    case GE:  // FG | FE: "not FL" (bge) would be taken on NaN.
+      return {CRF7, kCRBitEQ, true, true, kCRBitGT, kCRBitEQ};
+    case VS:  // FU: unordered (the ARM64 meaning of VS after fcmp).
+      return {CRF0, kCRBitSO, true, false, kCRBitSO, kCRBitSO};
+    case VC:  // not FU: ordered.
+      return {CRF0, kCRBitSO, false, false, kCRBitSO, kCRBitSO};
+    default:
+      UNREACHABLE();
+      return {CRF0, kCRBitEQ, true, false, kCRBitEQ, kCRBitEQ};
+  }
+}
+
+}  // namespace
+
+// ----- FP memory access and constants (5.2, 6.4, 7.7) ----------------------
+//
+// lfd/stfd/lfs/stfs are D-form: any int16 displacement is one instruction.
+// Otherwise the offset goes to R0 and the X-form takes it as the index
+// (R0 is legal in RB; |base| is never R0, the L1 Base() check enforces it).
+
+void Assembler::LoadDFromOffset(FpuRegister dst,
+                                Register base,
+                                int32_t offset) {
+  if (IsInt16(offset)) {
+    lfd(dst, base, offset);
+  } else {
+    LoadImmediate(R0, offset);
+    lfdx(dst, base, R0);
+  }
+}
+
+void Assembler::StoreDToOffset(FpuRegister src, Register base, int32_t offset) {
+  if (IsInt16(offset)) {
+    stfd(src, base, offset);
+  } else {
+    LoadImmediate(R0, offset);
+    stfdx(src, base, R0);
+  }
+}
+
+void Assembler::LoadSFromOffset(FpuRegister dst,
+                                Register base,
+                                int32_t offset) {
+  // lfs converts the single to the double format held by every FPR.
+  if (IsInt16(offset)) {
+    lfs(dst, base, offset);
+  } else {
+    LoadImmediate(R0, offset);
+    lfsx(dst, base, R0);
+  }
+}
+
+void Assembler::StoreSToOffset(FpuRegister src,
+                               Register base,
+                               int32_t offset,
+                               bool already_single) {
+  // stfs truncates the significand and does not round or overflow to
+  // infinity: a double that is not already single-valued must go through
+  // frsp first (7.7).
+  FpuRegister value = src;
+  if (!already_single) {
+    frsp(FpuTMP, src);
+    value = FpuTMP;
+  }
+  if (IsInt16(offset)) {
+    stfs(value, base, offset);
+  } else {
+    LoadImmediate(R0, offset);
+    stfsx(value, base, R0);
+  }
+}
+
+void Assembler::MoveUnboxedDouble(FpuRegister dst, FpuRegister src) {
+  if (dst != src) {
+    fmr(dst, src);
+  }
+}
+
+void Assembler::LoadDImmediate(FpuRegister dst, double value) {
+  const uint64_t bits = bit_cast<uint64_t>(value);
+  if (bits == 0) {
+    // +0.0 (not -0.0): zero the whole VSR, doubleword 0 is the double.
+    xxlxor(dst, dst, dst);
+    return;
+  }
+  LoadImmediate(R0, static_cast<int64_t>(bits));
+  mtvsrd(dst, R0);
+}
+
+void Assembler::LoadSImmediate(FpuRegister dst, float value) {
+  // An FPR holds the double format of the single (7.7). The conversion is
+  // done by xscvspdpn, which is what lfs does in hardware: it is exact,
+  // keeps a signalling NaN signalling, and does not depend on how the host
+  // compiler converts float to double.
+  const uint32_t bits = bit_cast<uint32_t>(value);
+  if (bits == 0) {
+    xxlxor(dst, dst, dst);
+    return;
+  }
+  LoadImmediate(R0, static_cast<int64_t>(static_cast<uint64_t>(bits) << 32));
+  mtvsrd(dst, R0);
+  xscvspdpn(dst, dst);
+}
+
+// ----- Memory ordering (8) -------------------------------------------------
+
+void Assembler::StoreStoreFence() {
+  lwsync();
+}
+
+void Assembler::LoadAcquire(Register dst,
+                            const Address& address,
+                            OperandSize size) {
+  // load ; lwsync: the lwsync orders the load before every later load and
+  // store.
+  Load(dst, address, size);
+  lwsync();
+}
+
+void Assembler::StoreRelease(Register src,
+                             const Address& address,
+                             OperandSize size) {
+  // lwsync ; store: every earlier load and store is ordered before it.
+  lwsync();
+  Store(src, address, size);
+}
+
+void Assembler::FullFence() {
+  sync();
+}
+
+// Strong CAS (8). The body between larx and stcx. is a compare and a forward
+// branch only. Layout, with fixed offsets:
+//
+//          [lwsync]                         kRelease
+//          [clrldi r0,expected,48|56]       sub-word: zero-extend expected
+//   retry: l?arx  old,0,addr
+//          cmp?   cr0,old,expected|r0
+//          bne    cr0,out                   value mismatch: +12
+//          st?cx. desired,0,addr
+//          bne    cr0,retry                 reservation lost: try again
+//   out:   [lwsync]                         kAcquire (on both paths)
+//          [extsw old,old]                  kFourBytes: canonical int32
+//          [bne cr0,mismatch]
+//
+// CR0[EQ] at "out" is 1 after a store (from stcx.) and 0 after a mismatch
+// (from the compare); lwsync and extsw leave CR0 alone.
+void Assembler::CompareAndSwap(Register addr,
+                               Register expected,
+                               Register desired,
+                               Register old,
+                               Label* mismatch,
+                               MemoryOrder order,
+                               OperandSize sz) {
+  RELEASE_ASSERT((addr != R0) && (expected != R0) && (desired != R0) &&
+                 (old != R0));
+  RELEASE_ASSERT((old != addr) && (old != expected) && (old != desired));
+
+  if (order == kRelease) {
+    lwsync();
+  }
+
+  // Sub-word larx zero-extends; compare against the zero-extended expected
+  // value, or a sign-extended caller value would never match (and the
+  // caller's retry loop would spin forever).
+  Register compare_with = expected;
+  if (sz == kUnsignedTwoBytes) {
+    clrldi(R0, expected, 48);
+    compare_with = R0;
+  } else if (sz == kUnsignedByte) {
+    clrldi(R0, expected, 56);
+    compare_with = R0;
+  }
+
+  const intptr_t retry = CodeSize();
+  switch (sz) {
+    case kEightBytes:
+      ldarx(old, kNoRegister, addr);
+      cmpd(CRF0, old, compare_with);
+      break;
+    case kFourBytes:
+    case kUnsignedFourBytes:
+      lwarx(old, kNoRegister, addr);
+      cmpw(CRF0, old, compare_with);  // Low words only.
+      break;
+    case kUnsignedTwoBytes:
+      lharx(old, kNoRegister, addr);
+      cmpw(CRF0, old, compare_with);
+      break;
+    case kUnsignedByte:
+      lbarx(old, kNoRegister, addr);
+      cmpw(CRF0, old, compare_with);
+      break;
+    default:
+      UNREACHABLE();
+  }
+  bc(kBOFalse, Cr0Bit(kCRBitEQ), 3 * kInstrSize);  // Mismatch: to "out".
+  switch (sz) {
+    case kEightBytes:
+      stdcx_(desired, kNoRegister, addr);
+      break;
+    case kFourBytes:
+    case kUnsignedFourBytes:
+      stwcx_(desired, kNoRegister, addr);
+      break;
+    case kUnsignedTwoBytes:
+      sthcx_(desired, kNoRegister, addr);
+      break;
+    case kUnsignedByte:
+      stbcx_(desired, kNoRegister, addr);
+      break;
+    default:
+      UNREACHABLE();
+  }
+  bc(kBOFalse, Cr0Bit(kCRBitEQ), retry - CodeSize());  // Lost: retry.
+  ASSERT(CodeSize() - retry == 5 * kInstrSize);
+
+  if (order == kAcquire) {
+    lwsync();
+  }
+  if (sz == kFourBytes) {
+    extsw(old, old);
+  }
+  if (mismatch != nullptr) {
+    BranchIfCR(false, CRF0, kCRBitEQ, mismatch);
+  }
+}
+
+// Strong fetch-and-op (8):
+//          [lwsync]                         kRelease
+//   retry: l?arx  old,0,addr
+//          <op>   r0,old,value
+//          st?cx. r0,0,addr
+//          bne    cr0,retry
+//          [lwsync]                         kAcquire
+//          [extsw old,old]                  kFourBytes
+void Assembler::AtomicFetchAndOp(AtomicOp op,
+                                 Register addr,
+                                 Register value,
+                                 Register old,
+                                 MemoryOrder order,
+                                 OperandSize sz) {
+  RELEASE_ASSERT((addr != R0) && (value != R0) && (old != R0));
+  RELEASE_ASSERT((old != addr) && (old != value));
+
+  if (order == kRelease) {
+    lwsync();
+  }
+  const intptr_t retry = CodeSize();
+  switch (sz) {
+    case kEightBytes:
+      ldarx(old, kNoRegister, addr);
+      break;
+    case kFourBytes:
+    case kUnsignedFourBytes:
+      lwarx(old, kNoRegister, addr);
+      break;
+    case kUnsignedTwoBytes:
+      lharx(old, kNoRegister, addr);
+      break;
+    case kUnsignedByte:
+      lbarx(old, kNoRegister, addr);
+      break;
+    default:
+      UNREACHABLE();
+  }
+  switch (op) {
+    case kAtomicAdd:
+      add(R0, old, value);
+      break;
+    case kAtomicAnd:
+      and_(R0, old, value);
+      break;
+    case kAtomicAndNot:
+      andc(R0, old, value);
+      break;
+    case kAtomicOr:
+      or_(R0, old, value);
+      break;
+  }
+  switch (sz) {
+    case kEightBytes:
+      stdcx_(R0, kNoRegister, addr);
+      break;
+    case kFourBytes:
+    case kUnsignedFourBytes:
+      stwcx_(R0, kNoRegister, addr);
+      break;
+    case kUnsignedTwoBytes:
+      sthcx_(R0, kNoRegister, addr);
+      break;
+    case kUnsignedByte:
+      stbcx_(R0, kNoRegister, addr);
+      break;
+    default:
+      UNREACHABLE();
+  }
+  bc(kBOFalse, Cr0Bit(kCRBitEQ), retry - CodeSize());  // Lost: retry.
+  ASSERT(CodeSize() - retry == 4 * kInstrSize);
+
+  if (order == kAcquire) {
+    lwsync();
+  }
+  if (sz == kFourBytes) {
+    extsw(old, old);
+  }
+}
+
+// ----- Registers, tagging, integer semantics (7.5, 7.6) ---------------------
+
+void Assembler::ExtendValue(Register dst, Register src, OperandSize sz) {
+  switch (sz) {
+    case kEightBytes:
+      if (dst != src) mr(dst, src);
+      return;
+    case kUnsignedFourBytes:
+      return clrldi(dst, src, 32);
+    case kFourBytes:
+      return extsw(dst, src);
+    case kUnsignedTwoBytes:
+      return clrldi(dst, src, 48);
+    case kTwoBytes:
+      return extsh(dst, src);
+    case kUnsignedByte:
+      return clrldi(dst, src, 56);
+    case kByte:
+      return extsb(dst, src);
+    default:
+      UNIMPLEMENTED();
+  }
+}
+
+void Assembler::ExtendAndSmiTagValue(Register dst,
+                                     Register src,
+                                     OperandSize sz) {
+  // Unsigned: rldic dst,src,1,64-1-bits keeps the low |bits| bits of src and
+  // shifts them left by the tag (one instruction, upper bits cleared).
+  // Signed: extend, then tag. Every value narrower than 64 bits fits a Smi.
+  static_assert(kSmiTagShift == 1, "rldic shift below assumes a 1-bit tag");
+  switch (sz) {
+    case kEightBytes:
+      return SmiTag(dst, src);
+    case kUnsignedFourBytes:
+      return rldic(dst, src, kSmiTagShift, 64 - kSmiTagShift - 32);
+    case kUnsignedTwoBytes:
+      return rldic(dst, src, kSmiTagShift, 64 - kSmiTagShift - 16);
+    case kUnsignedByte:
+      return rldic(dst, src, kSmiTagShift, 64 - kSmiTagShift - 8);
+    case kFourBytes:
+      extsw(dst, src);
+      return sldi(dst, dst, kSmiTagShift);
+    case kTwoBytes:
+      extsh(dst, src);
+      return sldi(dst, dst, kSmiTagShift);
+    case kByte:
+      extsb(dst, src);
+      return sldi(dst, dst, kSmiTagShift);
+    default:
+      UNIMPLEMENTED();
+  }
+}
+
+void Assembler::SmiTag(Register dst, Register src) {
+  sldi(dst, src, kSmiTagShift);
+}
+
+void Assembler::SmiUntag(Register dst, Register src) {
+  sradi(dst, src, kSmiTagShift);  // Writes XER[CA] only.
+}
+
+void Assembler::SmiTagAndBranchIfOverflow(Register reg, Label* label) {
+  // reg << 1 overflows iff bits 63 and 62 of reg differ, i.e. iff the sign
+  // of the tagged value differs from the sign of the untagged one. TMP is
+  // not needed: the sign comparison is formed in |reg| itself.
+  RELEASE_ASSERT(reg != R0);
+  add(R0, reg, reg);     // r0 = reg << 1
+  xor_rc(reg, R0, reg);  // CR0[LT] = sign(new) != sign(old)
+  mr(reg, R0);
+  BranchIfCR(true, CRF0, kCRBitLT, label);
+}
+
+// a + b overflows iff a and b have the same sign and the sum's sign differs:
+// ((s ^ a) & (s ^ b)) < 0. The sum is formed in R0 so that rd may alias
+// either input; rd serves as the second temporary before receiving the sum.
+void Assembler::AddBranchOverflow(Register rd,
+                                  Register rs1,
+                                  Register rs2,
+                                  Label* overflow) {
+  RELEASE_ASSERT((rd != R0) && (rs1 != R0) && (rs2 != R0));
+  RELEASE_ASSERT((rd != TMP) && (rs1 != TMP) && (rs2 != TMP));
+  add(R0, rs1, rs2);
+  xor_(TMP, R0, rs1);
+  xor_(rd, R0, rs2);
+  and_rc(TMP, TMP, rd);  // CR0[LT] = overflow
+  mr(rd, R0);
+  BranchIfCR(true, CRF0, kCRBitLT, overflow);
+}
+
+// a - b overflows iff a and b have different signs and the difference's
+// sign differs from a's: ((a ^ b) & (s ^ a)) < 0.
+void Assembler::SubtractBranchOverflow(Register rd,
+                                       Register rs1,
+                                       Register rs2,
+                                       Label* overflow) {
+  RELEASE_ASSERT((rd != R0) && (rs1 != R0) && (rs2 != R0));
+  RELEASE_ASSERT((rd != TMP) && (rs1 != TMP) && (rs2 != TMP));
+  subf(R0, rs2, rs1);  // r0 = rs1 - rs2
+  xor_(TMP, rs1, rs2);
+  xor_(rd, R0, rs1);
+  and_rc(TMP, TMP, rd);  // CR0[LT] = overflow
+  mr(rd, R0);
+  BranchIfCR(true, CRF0, kCRBitLT, overflow);
+}
+
+// The 128-bit product fits 64 bits iff its high half is the sign extension
+// of its low half.
+void Assembler::MultiplyBranchOverflow(Register rd,
+                                       Register rs1,
+                                       Register rs2,
+                                       Label* overflow) {
+  RELEASE_ASSERT((rd != R0) && (rs1 != R0) && (rs2 != R0));
+  RELEASE_ASSERT((rd != TMP) && (rs1 != TMP) && (rs2 != TMP));
+  mulhd(R0, rs1, rs2);
+  mulld(rd, rs1, rs2);
+  sradi(TMP, rd, 63);
+  cmpd(CRF0, R0, TMP);
+  BranchIfCR(false, CRF0, kCRBitEQ, overflow);
+}
+
+// With the sign of the constant known, a + imm overflows iff the wrapped
+// result moved the wrong way: below rs1 for imm > 0, above it for imm < 0.
+void Assembler::AddImmediateBranchOverflow(Register rd,
+                                           Register rs1,
+                                           int64_t imm,
+                                           Label* overflow) {
+  RELEASE_ASSERT((rd != R0) && (rs1 != R0));
+  RELEASE_ASSERT((rd != TMP) && (rs1 != TMP));
+  if (imm == 0) {
+    if (rd != rs1) mr(rd, rs1);
+    return;
+  }
+  if (IsInt16(imm)) {
+    addi(R0, rs1, imm);
+  } else {
+    LoadImmediate(TMP, imm);
+    add(R0, rs1, TMP);
+  }
+  cmpd(CRF0, R0, rs1);
+  mr(rd, R0);
+  BranchIfCR(true, CRF0, (imm > 0) ? kCRBitLT : kCRBitGT, overflow);
+}
+
+// a - imm overflows iff the result is above rs1 for imm > 0, below it for
+// imm < 0. Not rewritten as a + (-imm): -INT64_MIN does not exist.
+void Assembler::SubtractImmediateBranchOverflow(Register rd,
+                                                Register rs1,
+                                                int64_t imm,
+                                                Label* overflow) {
+  RELEASE_ASSERT((rd != R0) && (rs1 != R0));
+  RELEASE_ASSERT((rd != TMP) && (rs1 != TMP));
+  if (imm == 0) {
+    if (rd != rs1) mr(rd, rs1);
+    return;
+  }
+  if ((imm != kMinInt64) && IsInt16(-imm)) {
+    addi(R0, rs1, -imm);
+  } else {
+    LoadImmediate(TMP, imm);
+    subf(R0, TMP, rs1);  // r0 = rs1 - imm
+  }
+  cmpd(CRF0, R0, rs1);
+  mr(rd, R0);
+  BranchIfCR(true, CRF0, (imm > 0) ? kCRBitGT : kCRBitLT, overflow);
+}
+
+void Assembler::MultiplyImmediateBranchOverflow(Register rd,
+                                                Register rs1,
+                                                int64_t imm,
+                                                Label* overflow) {
+  RELEASE_ASSERT((rd != R0) && (rs1 != R0));
+  RELEASE_ASSERT((rd != TMP) && (rs1 != TMP));
+  LoadImmediate(TMP, imm);
+  mulhd(R0, rs1, TMP);
+  mulld(rd, rs1, TMP);
+  sradi(TMP, rd, 63);
+  cmpd(CRF0, R0, TMP);
+  BranchIfCR(false, CRF0, kCRBitEQ, overflow);
+}
+
+// For the 32-bit sizes the operation is done on the low word and the result
+// re-canonicalised (7.6); upper input bits never reach the result.
+void Assembler::AndImmediate(Register dst,
+                             Register src,
+                             int64_t imm,
+                             OperandSize sz) {
+  ASSERT((sz == kEightBytes) || (sz == kFourBytes) ||
+         (sz == kUnsignedFourBytes));
+  int mb, me;
+  if (sz != kEightBytes) {
+    ASSERT(Utils::IsInt(32, imm) || Utils::IsUint(32, imm));
+    const uint64_t mask = static_cast<uint32_t>(imm);
+    // Every form below yields a zero-extended result: andi./andis. and
+    // rlwinm (MB <= ME) clear the upper word, and the mask in R0 is
+    // zero-extended.
+    if (mask == 0) {
+      li(dst, 0);
+      return;
+    } else if (IsUint16(mask)) {
+      andi_(dst, src, mask);
+    } else if ((mask & 0xffff) == 0) {
+      andis_(dst, src, mask >> 16);
+    } else if (ContiguousWordMask(mask, &mb, &me)) {
+      rlwinm(dst, src, 0, mb, me);
+    } else {
+      RELEASE_ASSERT(src != R0);
+      LoadImmediate(R0, mask);
+      and_(dst, src, R0);
+    }
+    // An int32 result whose bit 31 may be set must be sign-extended.
+    if ((sz == kFourBytes) && ((mask & 0x80000000u) != 0)) {
+      extsw(dst, dst);
+    }
+    return;
+  }
+
+  const uint64_t mask = static_cast<uint64_t>(imm);
+  if (mask == 0) {
+    li(dst, 0);
+  } else if (imm == -1) {
+    if (dst != src) mr(dst, src);
+  } else if (IsUint16(mask)) {
+    andi_(dst, src, mask);
+  } else if ((mask & ~uint64_t{0xffff0000}) == 0) {
+    andis_(dst, src, mask >> 16);
+  } else if (ContiguousWordMask(mask, &mb, &me)) {
+    rlwinm(dst, src, 0, mb, me);
+  } else if (Utils::IsPowerOfTwo(mask + 1)) {
+    // Low mask 0..0 1..1: clear the high bits.
+    clrldi(dst, src, 64 - Utils::ShiftForPowerOfTwo(mask + 1));
+  } else if (Utils::IsPowerOfTwo(~mask + 1)) {
+    // High mask 1..1 0..0: clear the low bits.
+    clrrdi(dst, src, Utils::CountTrailingZeros64(mask));
+  } else {
+    RELEASE_ASSERT(src != R0);
+    LoadImmediate(R0, imm);
+    and_(dst, src, R0);
+  }
+}
+
+void Assembler::AndRegisters(Register dst, Register src1, Register src2) {
+  if (src2 == kNoRegister) {
+    and_(dst, dst, src1);
+  } else {
+    and_(dst, src1, src2);
+  }
+}
+
+void Assembler::OrImmediate(Register dst,
+                            Register src,
+                            int64_t imm,
+                            OperandSize sz) {
+  ASSERT((sz == kEightBytes) || (sz == kFourBytes) ||
+         (sz == kUnsignedFourBytes));
+  if (sz != kEightBytes) {
+    ASSERT(Utils::IsInt(32, imm) || Utils::IsUint(32, imm));
+    const uint64_t bits = static_cast<uint32_t>(imm);
+    Register from = src;
+    if ((bits >> 16) != 0) {
+      oris(dst, from, bits >> 16);
+      from = dst;
+    }
+    if ((bits & 0xffff) != 0) {
+      ori(dst, from, bits & 0xffff);
+      from = dst;
+    }
+    ExtendValue(dst, from, sz);
+    return;
+  }
+  const uint64_t bits = static_cast<uint64_t>(imm);
+  if (bits == 0) {
+    if (dst != src) mr(dst, src);
+  } else if (IsUint16(bits)) {
+    ori(dst, src, bits);
+  } else if (bits <= 0xffffffffu) {
+    oris(dst, src, bits >> 16);
+    if ((bits & 0xffff) != 0) ori(dst, dst, bits & 0xffff);
+  } else {
+    RELEASE_ASSERT(src != R0);
+    LoadImmediate(R0, imm);
+    or_(dst, src, R0);
+  }
+}
+
+void Assembler::XorImmediate(Register dst,
+                             Register src,
+                             int64_t imm,
+                             OperandSize sz) {
+  ASSERT((sz == kEightBytes) || (sz == kFourBytes) ||
+         (sz == kUnsignedFourBytes));
+  if (sz != kEightBytes) {
+    ASSERT(Utils::IsInt(32, imm) || Utils::IsUint(32, imm));
+    const uint64_t bits = static_cast<uint32_t>(imm);
+    Register from = src;
+    if ((bits >> 16) != 0) {
+      xoris(dst, from, bits >> 16);
+      from = dst;
+    }
+    if ((bits & 0xffff) != 0) {
+      xori(dst, from, bits & 0xffff);
+      from = dst;
+    }
+    ExtendValue(dst, from, sz);
+    return;
+  }
+  const uint64_t bits = static_cast<uint64_t>(imm);
+  if (bits == 0) {
+    if (dst != src) mr(dst, src);
+  } else if (IsUint16(bits)) {
+    xori(dst, src, bits);
+  } else if (bits <= 0xffffffffu) {
+    xoris(dst, src, bits >> 16);
+    if ((bits & 0xffff) != 0) xori(dst, dst, bits & 0xffff);
+  } else {
+    RELEASE_ASSERT(src != R0);
+    LoadImmediate(R0, imm);
+    xor_(dst, src, R0);
+  }
+}
+
+void Assembler::LslImmediate(Register dst,
+                             Register src,
+                             int32_t shift,
+                             OperandSize sz) {
+  ASSERT((sz == kEightBytes) || (sz == kFourBytes) ||
+         (sz == kUnsignedFourBytes));
+  RELEASE_ASSERT((shift >= 0) && (shift < IntegerSizeInBits(sz)));
+  if (shift == 0) {
+    return ExtendValue(dst, src, sz);
+  }
+  switch (sz) {
+    case kEightBytes:
+      return sldi(dst, src, shift);
+    case kUnsignedFourBytes:
+      // rlwinm: (low word << shift), upper word cleared.
+      return slwi(dst, src, shift);
+    case kFourBytes:
+      sldi(dst, src, shift);
+      return extsw(dst, dst);
+    default:
+      UNREACHABLE();
+  }
+}
+
+void Assembler::LsrImmediate(Register dst, int32_t shift) {
+  RELEASE_ASSERT((shift >= 0) && (shift < 64));
+  if (shift != 0) {
+    srdi(dst, dst, shift);
+  }
+}
+
+// sld uses the low 7 bits of the count: 64..127 give 0 but 128 wraps to a
+// shift by 0 (7.6). Any count >= 64 (unsigned) gives 0 here.
+void Assembler::LslRegister(Register dst, Register shift) {
+  RELEASE_ASSERT((dst != R0) && (shift != R0));
+  cmpldi(CRF0, shift, 63);
+  sld(dst, dst, shift);
+  isel(dst, kNoRegister, dst, Cr0Bit(kCRBitGT));  // count > 63 ? 0 : dst
+}
+
+void Assembler::ArithmeticShiftRightImmediate(Register dst,
+                                              Register src,
+                                              int32_t shift,
+                                              OperandSize sz) {
+  ASSERT((sz == kEightBytes) || (sz == kFourBytes));
+  RELEASE_ASSERT((shift >= 0) && (shift < IntegerSizeInBits(sz)));
+  if (sz == kFourBytes) {
+    // srawi reads the low word only and sign-extends its result; also the
+    // canonicalisation for shift == 0. Writes XER[CA] only.
+    return srawi(dst, src, shift);
+  }
+  if (shift == 0) {
+    return ExtendValue(dst, src, sz);
+  }
+  sradi(dst, src, shift);
+}
+
+void Assembler::MulImmediate(Register dst,
+                             Register src,
+                             int64_t imm,
+                             OperandSize width) {
+  ASSERT((width == kEightBytes) || (width == kFourBytes));
+  if (width == kFourBytes) {
+    // Only the low word of the constant affects the low word of the product.
+    imm = static_cast<int32_t>(imm);
+  }
+  // Positive powers of two only: Utils::IsPowerOfTwo(INT64_MIN) is true.
+  if ((imm > 0) && Utils::IsPowerOfTwo(imm)) {
+    return LslImmediate(dst, src, Utils::ShiftForPowerOfTwo(imm), width);
+  }
+  if (IsInt16(imm)) {
+    mulli(dst, src, imm);
+  } else {
+    RELEASE_ASSERT(src != R0);
+    LoadImmediate(R0, imm);
+    mulld(dst, src, R0);
+  }
+  if (width == kFourBytes) {
+    extsw(dst, dst);
+  }
+}
+
+void Assembler::CountLeadingZeroes(Register rd, Register rs) {
+  cntlzd(rd, rs);  // 64 for rs == 0. Does not clobber rs.
+}
+
+// (x - 1) & ~x has a one exactly at each trailing-zero position of x (all 64
+// for x == 0), so its population count is ctz(x) (7.5). cnttzd is ISA 3.0.
+void Assembler::CountTrailingZeroes(Register rd, Register rs) {
+  RELEASE_ASSERT(rs != R0);  // addi would read RA = 0 as zero.
+  addi(R0, rs, -1);
+  andc(R0, R0, rs);
+  popcntd(rd, R0);
+}
+
+// hash.h CombineHashes on the low words; the result is a uint32 held
+// zero-extended. slwi/srwi read only the low word, so upper input bits are
+// ignored. |other| is not clobbered.
+void Assembler::CombineHashes(Register dst, Register other) {
+  RELEASE_ASSERT((dst != R0) && (other != R0));
+  add(dst, dst, other);  // hash += other
+  slwi(R0, dst, 10);
+  add(dst, dst, R0);  // hash += hash << 10
+  srwi(R0, dst, 6);
+  xor_(dst, dst, R0);  // hash ^= hash >> 6
+  clrldi(dst, dst, 32);
+}
+
+// hash.h FinalizeHash on the low word, masked to |bit_size| bits, 0 -> 1.
+// Uses R0 only (|scratch| is not needed).
+void Assembler::FinalizeHashForSize(intptr_t bit_size,
+                                    Register hash,
+                                    Register scratch) {
+  RELEASE_ASSERT((bit_size > 0) && (bit_size <= kBitsPerInt32));
+  RELEASE_ASSERT(hash != R0);
+  slwi(R0, hash, 3);
+  add(hash, hash, R0);  // hash += hash << 3
+  srwi(R0, hash, 11);
+  xor_(hash, hash, R0);  // hash ^= hash >> 11
+  slwi(R0, hash, 15);
+  add(hash, hash, R0);                // hash += hash << 15
+  clrldi(hash, hash, 64 - bit_size);  // Size to fit (and zero-extend).
+  // hash == 0 ? 1 : hash, without a branch: cntlzd gives 64 only for 0.
+  cntlzd(R0, hash);
+  srdi(R0, R0, 6);
+  or_(hash, hash, R0);
+}
+
+// ----- Floating point (7.7) ------------------------------------------------
+
+void Assembler::DoubleCompare(FpuRegister left, FpuRegister right) {
+  fcmpu(CRF0, left, right);
+}
+
+void Assembler::BranchIfDouble(Condition cond,
+                               Label* label,
+                               JumpDistance distance) {
+  const DoubleCondition c = DecodeDoubleCondition(cond);
+  if (c.compose) {
+    cror(CRBitIndex(CRF7, kCRBitEQ), Cr0Bit(c.a), Cr0Bit(c.b));
+  }
+  BranchIfCR(c.if_set, c.crf, c.bit, label, distance);
+}
+
+void Assembler::SetIfDouble(Condition cond, Register dst) {
+  RELEASE_ASSERT(dst != R0);
+  const DoubleCondition c = DecodeDoubleCondition(cond);
+  if (c.compose) {
+    cror(CRBitIndex(CRF7, kCRBitEQ), Cr0Bit(c.a), Cr0Bit(c.b));
+  }
+  const uint32_t bit = CRBitIndex(c.crf, c.bit);
+  li(dst, 1);
+  if (c.if_set) {
+    li(R0, 0);
+    isel(dst, dst, R0, bit);  // bit ? 1 : 0
+  } else {
+    isel(dst, kNoRegister, dst, bit);  // bit ? 0 : 1
+  }
+}
+
+void Assembler::DoubleToInt64(Register dst, FpuRegister src) {
+  // Saturates: NaN and values below INT64_MIN give INT64_MIN, values above
+  // INT64_MAX give INT64_MAX.
+  fctidz(FpuTMP, src);
+  mfvsrd(dst, FpuTMP);
+}
+
+void Assembler::Int64ToDouble(FpuRegister dst, Register src) {
+  mtvsrd(dst, src);
+  fcfid(dst, dst);  // Rounds to nearest even.
+}
+
+void Assembler::FloatBitsToRegister(Register dst, FpuRegister src) {
+  // xscvdpspn leaves the single in word 0 of the VSR; word 1 is undefined in
+  // ISA 2.07, so read the doubleword and shift (7.7).
+  xscvdpspn(FpuTMP, src);
+  mfvsrd(dst, FpuTMP);
+  srdi(dst, dst, 32);
+}
+
+void Assembler::RegisterToFloatBits(FpuRegister dst, Register src) {
+  // The single goes to word 0 (the upper half of doubleword 0). The upper
+  // half of src is shifted out, so it may hold anything.
+  sldi(R0, src, 32);
+  mtvsrd(dst, R0);
+  xscvspdpn(dst, dst);
+}

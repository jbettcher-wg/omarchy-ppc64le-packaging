+// Called when invoking Dart code from C++ (VM code).
+// Input parameters:
+//   LR : points to return address.
+//   R3 : target code or entry point (in AOT mode).
+//   R4 : arguments descriptor array.
+//   R5 : arguments array.
+//   R6 : current thread.
+//   R1 : the C++ caller's stack pointer, 16-byte aligned.
+//   (R12: address of this stub; not used.)
+//
+// S-1. The entry frame of ABI-SPEC 3.2. Not saved, on purpose: CR (CR2-CR4 are
+// never written), R2 (never written; the C++ caller reloads it after an
+// indirect call), R13, the vector registers.
+void StubCodeCompiler::GenerateInvokeDartCodeStub() {
+  __ Comment("InvokeDartCodeStub");
+
+  __ EnterFrame(0);
+
+  // Push code object to PC marker slot.
+  __ LoadFromOffset(TMP, R6, target::Thread::invoke_dart_code_stub_offset());
+  __ PushRegister(TMP);
+
+  // R14..R30, then F14..F31.
+  __ PushNativeCalleeSavedRegisters();
+
+  // Set up THR, which caches the current thread in Dart code.
+  __ MoveRegister(THR, R6);
+
+  // Refresh pinned registers (write barrier mask, null, dispatch table, etc).
+  __ RestorePinnedRegisters();
+
+  // The four saved Thread words, in the order of ABI-SPEC 3.2:
+  //   FP-296 vm tag, FP-304 top resource, FP-312 exit-through-ffi,
+  //   FP-320 top exit frame info (kExitLinkSlotFromEntryFp).
+
+  // Save the current VMTag on the stack.
+  __ LoadFromOffset(TMP, THR, target::Thread::vm_tag_offset());
+  __ PushRegister(TMP);
+
+  // Save top resource and top exit frame info.
+  // StackFrameIterator reads the top exit frame info saved in this frame.
+  __ LoadFromOffset(TMP, THR, target::Thread::top_resource_offset());
+  __ StoreZero(Address(THR, target::Thread::top_resource_offset()));
+  __ PushRegister(TMP);
+
+  __ LoadFromOffset(TMP, THR, target::Thread::exit_through_ffi_offset());
+  __ PushRegister(TMP);
+  __ StoreZero(Address(THR, target::Thread::exit_through_ffi_offset()));
+
+  __ LoadFromOffset(TMP, THR, target::Thread::top_exit_frame_info_offset());
+  __ StoreZero(Address(THR, target::Thread::top_exit_frame_info_offset()));
+  // target::frame_layout.exit_link_slot_from_entry_fp must be kept in sync
+  // with the code below: PC marker (1) + GPRs (17) + FPRs (18) + 4 words.
+  COMPILE_ASSERT(kExitLinkSlotFromEntryFp ==
+                 -(1 + kAbiPreservedCpuRegCount + kAbiPreservedFpuRegCount +
+                   4));
+  ASSERT(target::frame_layout.exit_link_slot_from_entry_fp == -40);
+  __ PushRegister(TMP);
+  // In debug mode, verify that we've pushed the top exit frame info at the
+  // correct offset from FP.
+  __ EmitEntryFrameVerification();
+
+  // Mark that the thread is executing Dart code. Do this after initializing the
+  // exit link for the profiler.
+  __ LoadImmediate(TMP, VMTag::kDartTagId);
+  __ StoreToOffset(TMP, THR, target::Thread::vm_tag_offset());
+
+  // Load arguments descriptor array into R7, which is passed to Dart code.
+  COMPILE_ASSERT(ARGS_DESC_REG == R7);
+  __ MoveRegister(ARGS_DESC_REG, R4);
+
+  // Load number of arguments into R8 and adjust count for type arguments.
+  __ LoadCompressedSmiFieldFromOffset(
+      R8, ARGS_DESC_REG, target::ArgumentsDescriptor::count_offset());
+  __ LoadCompressedSmiFieldFromOffset(
+      R6, ARGS_DESC_REG, target::ArgumentsDescriptor::type_args_len_offset());
+  __ SmiUntag(R8);
+  {
+    // Include the type arguments.
+    Label no_type_args;
+    __ CompareImmediate(R6, 0);
+    __ BranchIf(EQUAL, &no_type_args, Assembler::kNearJump);
+    __ AddImmediate(R8, R8, 1);
+    __ Bind(&no_type_args);
+  }
+
+  // Compute address of 'arguments array' data area into R5.
+  __ AddImmediate(R5, R5, target::Array::data_offset() - kHeapObjectTag);
+
+  // Set up arguments for the Dart call: a plain compare-and-branch loop, no
+  // CTR loop (ABI-SPEC 2.1) (simple).
+  Label push_arguments;
+  Label done_push_arguments;
+  __ CompareImmediate(R8, 0);
+  __ BranchIf(EQUAL, &done_push_arguments);  // check if there are arguments.
+  __ LoadImmediate(R4, 0);
+  __ Bind(&push_arguments);
+  __ LoadCompressed(R6, Address(R5, 0));
+  __ PushRegister(R6);
+  __ AddImmediate(R4, R4, 1);
+  __ AddImmediate(R5, R5, target::kCompressedWordSize);
+  __ CompareRegisters(R4, R8);
+  __ BranchIf(LESS, &push_arguments);
+  __ Bind(&done_push_arguments);
+
+  if (FLAG_precompiled_mode) {
+    __ SetupGlobalPoolAndDispatchTable();
+    __ LoadImmediate(CODE_REG, 0);  // GC-safe value into CODE_REG.
+    // R3 is the entry point.
+    __ CallRegister(R3);  // R7 is the arguments descriptor array.
+  } else {
+    // We now load the pool pointer(PP) with a GC safe value as we are about to
+    // invoke dart code. We don't need a real object pool here.
+    // Smi zero does not work because PP is untagged: the callee's frame
+    // stores PP + kHeapObjectTag, which is a Smi when PP is the (tagged) null.
+    __ MoveRegister(PP, NULL_REG);
+    __ MoveRegister(CODE_REG, R3);
+    // Call the Dart code entrypoint.
+    // R7 is the arguments descriptor array.
+    __ Call(FieldAddress(CODE_REG, target::Code::entry_point_offset()));
+  }
+  __ Comment("InvokeDartCodeStub return");
+
+  // Get rid of arguments pushed on the stack.
+  __ AddImmediate(
+      SP, FP,
+      target::frame_layout.exit_link_slot_from_entry_fp * target::kWordSize);
+
+  // Restore the saved top exit frame info and top resource back into the
+  // Isolate structure.
+  __ PopRegister(TMP);
+  __ StoreToOffset(TMP, THR, target::Thread::top_exit_frame_info_offset());
+  __ PopRegister(TMP);
+  __ StoreToOffset(TMP, THR, target::Thread::exit_through_ffi_offset());
+  __ PopRegister(TMP);
+  __ StoreToOffset(TMP, THR, target::Thread::top_resource_offset());
+
+  // Restore the current VMTag from the stack.
+  __ PopRegister(TMP);
+  __ StoreToOffset(TMP, THR, target::Thread::vm_tag_offset());
+
+  __ PopNativeCalleeSavedRegisters();
+
+  // Restore the frame pointer and return (drops the PC marker). R2 is
+  // unspecified here, which ELFv2 allows after a call through a pointer.
+  __ LeaveFrame();
+  __ Ret();
+}

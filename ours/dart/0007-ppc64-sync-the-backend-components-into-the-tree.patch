+// ppc64 flow graph compiler (IL-A).
+//
+// Started from the generated shell (work/il/tools/gen-shells.py), filled in
+// in the order of M3-BOOT-PLAN section 4.3. Template: flow_graph_compiler_
+// arm64.cc for structure and raw register names through the bijection
+// (ABI-SPEC 2.3: ARM64 R0-R7 -> r3-r10, R6 -> r9); flow_graph_compiler_
+// riscv.cc where ppc64 shares RISC-V's lack of condition flags (the
+// identical stub's TMP == 0 result, EmitBoolTest, GenerateBoolToJump) and of
+// a paired load (the IC call's two pool loads).
+//
+// Status: compile-checked only (check/run-check.sh). Nothing in this file
+// has emitted or executed an instruction yet.
+//
+// Call sequences this file emits, for the code patterns of Agent C
+// (instructions_ppc64.cc, ABI-SPEC 4.1; walk back from the return address):
+//   static / stub call (BranchLink[Patchable]):
+//       ld r28,code(PP) ; li r0,entry-1 ; ldx r0,r28,r0 ; mtctr r0 ; bctrl
+//   IC / megamorphic call (EmitInstanceCallJIT, EmitMegamorphicInstanceCall):
+//       ld r28,i(PP) ; ld r8,i+8(PP) ; li r0,ep-1 ; ldx r0,r28,r0 ;
+//       mtctr r0 ; bctrl            (pool slots i and i+1: stub/target, data)
+//   type-testing-stub call (GenerateIndirectTTSCall):
+//       li r0,tts-1 ; ldx r14?,type,r0 ; ld r6,stc(PP) ; mtctr r14 ; bctrl
+//       (the scratch is TTSInternalRegs::kScratchReg)
+// Pool loads may take the far form `addis X,PP,ha ; ld dst,lo(X)` (ABI 6.2).
+
+#include "vm/globals.h"  // Needed here to get TARGET_ARCH_PPC64.
+#if defined(TARGET_ARCH_PPC64)

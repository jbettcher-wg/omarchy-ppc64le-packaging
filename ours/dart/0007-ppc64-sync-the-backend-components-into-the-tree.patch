+void BranchInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  condition()->EmitBranchCode(compiler, this);
+}
+
+// Consumes the compare EmitConditionCode recorded with exactly one BranchIf
+// (contract 6): either on the true condition or on its inverse.
+static void EmitBranchOnCondition(FlowGraphCompiler* compiler,
+                                  Condition true_condition,
+                                  BranchLabels labels) {
+  if (labels.fall_through == labels.false_label) {
+    // If the next block is the false successor we will fall through to it.
+    __ BranchIf(true_condition, labels.true_label);
+  } else {
+    // If the next block is not the false successor we will branch to it.
+    Condition false_condition = InvertCondition(true_condition);
+    __ BranchIf(false_condition, labels.false_label);
+
+    // Fall through or jump to the true successor.
+    if (labels.fall_through != labels.true_label) {
+      __ Jump(labels.true_label);
+    }
+  }
+}
+
+void ConditionInstr::EmitNativeCode(FlowGraphCompiler* compiler) {
+  compiler::Label is_true, is_false;
+  BranchLabels labels = {&is_true, &is_false, &is_false};
+  Condition true_condition = EmitConditionCode(compiler, labels);
+
+  const Register result = locs()->out(0).reg();
+  if (is_true.IsLinked() || is_false.IsLinked()) {
+    if (true_condition != kInvalidCondition) {
+      EmitBranchOnCondition(compiler, true_condition, labels);
+    }
+    compiler::Label done;
+    __ Bind(&is_false);
+    __ LoadObject(result, Bool::False());
+    __ Jump(&done, compiler::Assembler::kNearJump);
+    __ Bind(&is_true);
+    __ LoadObject(result, Bool::True());
+    __ Bind(&done);
+  } else {
+    // EmitConditionCode did not use the labels and just returned a
+    // condition: materialise it without a branch (RISC-V's form, one SetIf).
+    // true and false are at fixed offsets from null, one bit apart:
+    //   result = null + ((cond ? 0 : 1) + true_offset/2^bit) << bit.
+    ASSERT(true_condition != kInvalidCondition);
+    ASSERT(kTrueOffsetFromNull + (1 << kBoolValueBitPosition) ==
+           kFalseOffsetFromNull);
+    ASSERT(((kTrueOffsetFromNull >> kBoolValueBitPosition)
+            << kBoolValueBitPosition) == kTrueOffsetFromNull);
+    __ SetIf(InvertCondition(true_condition), result);
+    __ AddImmediate(result, kTrueOffsetFromNull >> kBoolValueBitPosition);
+    __ AddShifted(result, NULL_REG, result, kBoolValueBitPosition);
+  }
+}
+
+void ConditionInstr::EmitBranchCode(FlowGraphCompiler* compiler,
+                                    BranchInstr* branch) {
+  BranchLabels labels = compiler->CreateBranchLabels(branch);
+  Condition true_condition = EmitConditionCode(compiler, labels);
+  if (true_condition != kInvalidCondition) {
+    EmitBranchOnCondition(compiler, true_condition, labels);
+  }
+}

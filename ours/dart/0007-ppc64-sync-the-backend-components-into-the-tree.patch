new file mode 100644
index 00000000..7f13b6d5
--- /dev/null
+++ b/runtime/vm/cpu_ppc64.h
@@ -0,0 +1,93 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_VM_CPU_PPC64_H_
+#define RUNTIME_VM_CPU_PPC64_H_
+
+#if !defined(RUNTIME_VM_CPU_H_)
+#error Do not include cpu_ppc64.h directly; use cpu.h instead.
+#endif
+
+#include "vm/allocation.h"
+
+namespace dart {
+
+// 64-bit PowerPC, little-endian, ELFv2. Generated code is POWER8 (ISA 2.07)
+// only and depends on no optional feature, so the features below exist to
+// fail early on an unsupported CPU and to report what the host offers
+// (ABI-SPEC section 12). Nothing selects code by them.
+//
+// Detection reads the auxiliary vector with getauxval(), never
+// /proc/self/auxv (unreadable in a chroot) and never AT_PLATFORM string
+// matching.
+//
+// TargetCPUFeatures has no feature bits. If one is ever added it must report
+// false under --target_unknown_cpu (AOT and app-JIT snapshots), or snapshots
+// built on POWER9 will carry POWER9 code into the POWER8 pool.
+
+class HostCPUFeatures : public AllStatic {
+ public:
+  // FATAL unless the host is ISA 2.07 with VSX (POWER8 or later).
+  static void Init();
+  static void Cleanup();
+
+  // AT_PLATFORM, e.g. "power9".
+  static const char* hardware() {
+    DEBUG_ASSERT(initialized_);
+    return hardware_;
+  }
+  // AT_HWCAP / AT_HWCAP2 as the kernel reported them.
+  static uint64_t hwcap() {
+    DEBUG_ASSERT(initialized_);
+    return hwcap_;
+  }
+  static uint64_t hwcap2() {
+    DEBUG_ASSERT(initialized_);
+    return hwcap2_;
+  }
+  // ISA 2.07 + VSX: true after a successful Init() on a ppc64 host.
+  static bool has_isa207() {
+    DEBUG_ASSERT(initialized_);
+    return has_isa207_;
+  }
+  // ISA 3.0 (POWER9 and later). Informational only: no consumer.
+  static bool has_isa30() {
+    DEBUG_ASSERT(initialized_);
+    return has_isa30_;
+  }
+  // AT_DCACHEBSIZE / AT_ICACHEBSIZE (0 if the kernel did not report one).
+  static intptr_t dcache_block_size() {
+    DEBUG_ASSERT(initialized_);
+    return dcache_block_size_;
+  }
+  static intptr_t icache_block_size() {
+    DEBUG_ASSERT(initialized_);
+    return icache_block_size_;
+  }
+
+ private:
+  static const char* hardware_;
+  static uint64_t hwcap_;
+  static uint64_t hwcap2_;
+  static bool has_isa207_;
+  static bool has_isa30_;
+  static intptr_t dcache_block_size_;
+  static intptr_t icache_block_size_;
+#if defined(DEBUG)
+  static bool initialized_;
+#endif
+};
+
+class TargetCPUFeatures : public AllStatic {
+ public:
+  static void Init() { HostCPUFeatures::Init(); }
+  static void Cleanup() { HostCPUFeatures::Cleanup(); }
+  static const char* hardware() { return HostCPUFeatures::hardware(); }
+  // friz exists in ISA 2.07 (ABI-SPEC 7.7), but no IL uses it yet (M3).
+  static bool double_truncate_round_supported() { return false; }
+};
+
+}  // namespace dart
+
+#endif  // RUNTIME_VM_CPU_PPC64_H_

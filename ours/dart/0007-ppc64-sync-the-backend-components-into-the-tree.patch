+
+// ===== Section B: Agent B, phase 2 ==========================================
+//
+// Contracts kept here (work/stubs/STUBS-SPEC.md 7 and 15; ABI-SPEC 8, A1):
+//   - EnterFullSafepoint / ExitFullSafepoint clobber |scratch|, R0, TMP and
+//     CR0 (CTR and LR on the slow path) and nothing else: not TMP2 (r12), no
+//     argument or result register.
+//   - TransitionGeneratedToNative / TransitionNativeToGenerated add only
+//     their own scratch register (and TMP) to that set and never write
+//     |destination_address|.
+//   - CallRuntime loads r8 = runtime function, r7 = argument count; the
+//     CallToRuntime stub passes NativeArguments by value in r3-r6.
+//   - LeafRuntimeScope enters C only through CallCFunction, saves LR with
+//     EnterFrame, keeps r3-r10 intact up to the call, and with
+//     |preserve_registers| saves r3-r10 and f1-f13.
+//   - InitializeHeader / InitializeHeaderUntagged end with StoreStoreFence
+//     (lwsync): TARGET_HAS_FAST_WRITE_WRITE_FENCE is defined for every
+//     target in Dart 3.11.
+//   - The write-barrier filter tests the combined header bytes against
+//     WRITE_BARRIER_STATE (r27), which must hold Thread::write_barrier_mask
+//     unmodified (ABI-SPEC 8: ARM64's barrier with r27 as the mask). The
+//     barrier call clobbers LR, so LR is saved around it: ppc64 has no
+//     LR-state tracking and the barrier may run in frameless code.
+
+static void EmitSafepointCas(Assembler* a, Register scratch, bool enter);
+
+void Assembler::CallRuntime(const RuntimeEntry& entry,
+                            intptr_t argument_count,
+                            bool tsan_enter_exit) {
+  ASSERT(!entry.is_leaf());
+  USE(tsan_enter_exit);  // No thread sanitizer on ppc64.
+  // Argument count is not checked here, but in the runtime entry for a more
+  // informative error message. The inputs of the CallToRuntime stub
+  // (STUBS-SPEC 2.2) are r8 = the runtime function and r7 = the count.
+  Load(R8, Address(THR, entry.OffsetFromThread()));
+  LoadImmediate(R7, argument_count);
+  Comment("Runtime call: %s", entry.name());
+  Call(Address(THR, target::Thread::call_to_runtime_entry_point_offset()));
+}
+
+void Assembler::TransitionGeneratedToNative(Register destination_address,
+                                            Register new_exit_frame,
+                                            Register new_exit_through_ffi,
+                                            bool enter_safepoint) {
+  RELEASE_ASSERT(destination_address != new_exit_through_ffi);
+  RELEASE_ASSERT((destination_address != R0) && (destination_address != TMP));
+  // Save exit frame information to enable stack walking.
+  Store(new_exit_frame,
+        Address(THR, target::Thread::top_exit_frame_info_offset()));
+  Store(new_exit_through_ffi,
+        Address(THR, target::Thread::exit_through_ffi_offset()));
+  const Register tmp = new_exit_through_ffi;
+
+  VerifyInGenerated(tmp);
+  // Mark that the thread is executing native code.
+  Store(destination_address, Address(THR, target::Thread::vm_tag_offset()));
+  LoadImmediate(tmp, target::Thread::native_execution_state());
+  Store(tmp, Address(THR, target::Thread::execution_state_offset()));
+
+  if (enter_safepoint) {
+    EnterFullSafepoint(tmp);
+  }
+}
+
+void Assembler::TransitionNativeToGenerated(Register scratch,
+                                            bool exit_safepoint,
+                                            bool set_tag) {
+  RELEASE_ASSERT((scratch != R0) && (scratch != TMP));
+  if (exit_safepoint) {
+    ExitFullSafepoint(scratch);
+  } else {
+#if defined(DEBUG)
+    // Ensure we've already left the safepoint.
+    ASSERT(target::Thread::native_safepoint_state_acquired() != 0);
+    Label ok;
+    Load(TMP, Address(THR, target::Thread::safepoint_state_offset()));
+    LoadImmediate(scratch, target::Thread::native_safepoint_state_acquired());
+    TestRegisters(TMP, scratch);
+    BranchIf(ZERO, &ok, kNearJump);
+    Breakpoint();
+    Bind(&ok);
+#endif
+  }
+
+  VerifyNotInGenerated(TMP);
+  // Mark that the thread is executing Dart code.
+  if (set_tag) {
+    LoadImmediate(scratch, target::Thread::vm_tag_dart_id());
+    Store(scratch, Address(THR, target::Thread::vm_tag_offset()));
+  }
+  LoadImmediate(scratch, target::Thread::generated_execution_state());
+  Store(scratch, Address(THR, target::Thread::execution_state_offset()));
+
+  // Reset exit frame information in the thread (li r0,0 ; std r0,...).
+  StoreZero(Address(THR, target::Thread::top_exit_frame_info_offset()));
+  StoreZero(Address(THR, target::Thread::exit_through_ffi_offset()));
+}
+
+void Assembler::VerifyInGenerated(Register scratch) {
+#if defined(DEBUG)
+  // Verify the thread is in generated.
+  Comment("VerifyInGenerated");
+  Load(scratch, Address(THR, target::Thread::execution_state_offset()));
+  Label ok;
+  CompareImmediate(scratch, target::Thread::generated_execution_state());
+  BranchIf(EQUAL, &ok, kNearJump);
+  Breakpoint();
+  Bind(&ok);
+#endif
+}
+
+void Assembler::VerifyNotInGenerated(Register scratch) {
+#if defined(DEBUG)
+  // Verify the thread is in native or VM.
+  Comment("VerifyNotInGenerated");
+  Load(scratch, Address(THR, target::Thread::execution_state_offset()));
+  CompareImmediate(scratch, target::Thread::generated_execution_state());
+  Label ok;
+  BranchIf(NOT_EQUAL, &ok, kNearJump);
+  Breakpoint();
+  Bind(&ok);
+#endif
+}
+
+// One strong CAS on Thread::safepoint_state (STUBS-SPEC 7), addressed as
+// THR + R0 (the RA, RB form of ldarx/stdcx.), so that no address register
+// is needed:
+//
+//   enter: li r0,off ; li TMP,acquired ; lwsync               (release)
+//   exit:  li r0,off ; li TMP,unacquired
+//   retry: ldarx scratch,THR,r0 ; cmpdi scratch,<expected> ; bne slow
+//          stdcx. TMP,THR,r0 ; bne retry       (lost reservation: retry)
+//   exit:  lwsync                                             (acquire)
+//          b done
+//   slow:  ld TMP,<enter|exit>_safepoint_stub(THR)
+//          Call(FieldAddress(TMP, Code::entry_point_offset()))
+//   done:
+//
+// Between ldarx and stdcx. there is a compare and a branch only (the new
+// value is loaded before the loop). With FLAG_use_slow_path the first word is
+// "b slow" and everything else is emitted unchanged, so the length is the
+// same either way (STUBS-SPEC 7: 14 words).
+static void EmitSafepointCas(Assembler* a, Register scratch, bool enter) {
+  RELEASE_ASSERT((scratch != R0) && (scratch != TMP) && (scratch != THR));
+  const int64_t unacquired = static_cast<int64_t>(
+      target::Thread::native_safepoint_state_unacquired());
+  const int64_t acquired =
+      static_cast<int64_t>(target::Thread::native_safepoint_state_acquired());
+  const int64_t expected = enter ? unacquired : acquired;
+  const int64_t desired = enter ? acquired : unacquired;
+  const int64_t offset = target::Thread::safepoint_state_offset();
+  RELEASE_ASSERT(IsInt16(expected) && IsInt16(desired) && IsInt16(offset));
+
+  Label retry, slow, done;
+  if (FLAG_use_slow_path) {
+    a->Jump(&slow);
+  } else {
+    a->li(R0, offset);
+  }
+  a->li(TMP, desired);
+  if (enter) {
+    a->lwsync();
+  }
+  a->Bind(&retry);
+  a->ldarx(scratch, THR, R0);
+  a->cmpdi(CRF0, scratch, expected);
+  a->BranchIfCR(false, CRF0, kCRBitEQ, &slow, Assembler::kNearJump);
+  a->stdcx_(TMP, THR, R0);
+  a->BranchIfCR(false, CRF0, kCRBitEQ, &retry, Assembler::kNearJump);
+  if (!enter) {
+    a->lwsync();
+  }
+  a->Jump(&done);
+
+  a->Bind(&slow);
+  a->Load(TMP, Address(THR, enter
+                                ? target::Thread::enter_safepoint_stub_offset()
+                                : target::Thread::exit_safepoint_stub_offset()));
+  a->Call(FieldAddress(TMP, target::Code::entry_point_offset()));
+  a->Bind(&done);
+}
+
+void Assembler::EnterFullSafepoint(Register scratch) {
+  EmitSafepointCas(this, scratch, /*enter=*/true);
+}
+
+void Assembler::ExitFullSafepoint(Register scratch) {
+  EmitSafepointCas(this, scratch, /*enter=*/false);
+}
+
+// Falls through when the store needs the barrier, else branches to |done|.
+// In parallel, tests whether
+//  - object is old and not remembered and value is new, or
+//  - object is old and value is old and not marked and concurrent marking is
+//    in progress
+// (compare UntaggedObject::StorePointer). All the bits involved are in the
+// low-order header byte, which on little-endian is the byte at the header's
+// own address. Clobbers |scratch|, TMP2, R0 and CR0.
+static void EmitBarrierFilter(Assembler* a,
+                              Register object,
+                              Register value,
+                              Assembler::CanBeSmi can_value_be_smi,
+                              Register scratch,
+                              Label* done) {
+  if (can_value_be_smi == Assembler::kValueCanBeSmi) {
+    a->BranchIfSmi(value, done, Assembler::kNearJump);
+  } else {
+#if defined(DEBUG)
+    Label passed_check;
+    a->BranchIfNotSmi(value, &passed_check, Assembler::kNearJump);
+    a->Breakpoint();
+    a->Bind(&passed_check);
+#endif
+  }
+  a->Load(scratch, FieldAddress(object, target::Object::tags_offset()),
+          kUnsignedByte);
+  a->Load(TMP2, FieldAddress(value, target::Object::tags_offset()),
+          kUnsignedByte);
+  a->srdi(scratch, scratch, target::UntaggedObject::kBarrierOverlapShift);
+  a->and_(scratch, TMP2, scratch);
+  a->and_rc(scratch, scratch, WRITE_BARRIER_STATE);  // CR0[EQ]: no barrier
+  a->BranchIfCR(true, CRF0, kCRBitEQ, done, Assembler::kNearJump);
+}
+
+void Assembler::StoreBarrier(Register object,
+                             Register value,
+                             CanBeSmi can_value_be_smi,
+                             Register scratch) {
+  // x.slot = x. Barrier should have be removed at the IL level.
+  ASSERT(object != value);
+  ASSERT(object != scratch);
+  ASSERT(value != scratch);
+  ASSERT(scratch != kNoRegister);
+  RELEASE_ASSERT((object != TMP2) && (value != TMP2) && (scratch != TMP2));
+  RELEASE_ASSERT((object != R0) && (value != R0) && (scratch != R0));
+
+  Label done;
+  EmitBarrierFilter(this, object, value, can_value_be_smi, scratch, &done);
+
+  // The wrapper call (bctrl) clobbers LR, which may hold this code's return
+  // address.
+  PushLinkRegister();
+  Register object_for_call = object;
+  if (value != kWriteBarrierValueReg) {
+    // Unlikely. Only non-graph intrinsics.
+    if (object != kWriteBarrierValueReg) {
+      PushRegister(kWriteBarrierValueReg);
+    } else {
+      // The images of ARM64's R2/R3 (ABI-SPEC 2.3).
+      COMPILE_ASSERT(R5 != kWriteBarrierValueReg);
+      COMPILE_ASSERT(R6 != kWriteBarrierValueReg);
+      object_for_call = (value == R5) ? R6 : R5;
+      PushRegisterPair(kWriteBarrierValueReg, object_for_call);
+      mr(object_for_call, object);
+    }
+    mr(kWriteBarrierValueReg, value);
+  }
+
+  if (generate_invoke_write_barrier_wrapper_) {
+    generate_invoke_write_barrier_wrapper_(object_for_call);
+  } else {
+    Call(Address(THR, target::Thread::write_barrier_wrappers_thread_offset(
+                          object_for_call)));
+  }
+
+  if (value != kWriteBarrierValueReg) {
+    if (object != kWriteBarrierValueReg) {
+      PopRegister(kWriteBarrierValueReg);
+    } else {
+      PopRegisterPair(kWriteBarrierValueReg, object_for_call);
+    }
+  }
+  PopLinkRegister();
+  Bind(&done);
+}
+
+void Assembler::ArrayStoreBarrier(Register object,
+                                  Register slot,
+                                  Register value,
+                                  CanBeSmi can_value_be_smi,
+                                  Register scratch) {
+  ASSERT(object != slot);
+  ASSERT(object != value);
+  ASSERT(object != scratch);
+  ASSERT(slot != value);
+  ASSERT(slot != scratch);
+  ASSERT(value != scratch);
+  ASSERT(scratch != kNoRegister);
+  RELEASE_ASSERT((object != TMP2) && (slot != TMP2) && (value != TMP2) &&
+                 (scratch != TMP2));
+  if ((object != kWriteBarrierObjectReg) || (value != kWriteBarrierValueReg) ||
+      (slot != kWriteBarrierSlotReg)) {
+    // Spill and shuffle unimplemented, as on ARM64 and RISC-V. Currently
+    // StoreIntoArray is only used from StoreIndexInstr, which gets these
+    // exact registers from the register allocator.
+    UNIMPLEMENTED();
+  }
+
+  Label done;
+  EmitBarrierFilter(this, object, value, can_value_be_smi, scratch, &done);
+  PushLinkRegister();
+  if (generate_invoke_array_write_barrier_) {
+    generate_invoke_array_write_barrier_();
+  } else {
+    Call(Address(THR, target::Thread::array_write_barrier_entry_point_offset()));
+  }
+  PopLinkRegister();
+  Bind(&done);
+}
+
+void Assembler::VerifyStoreNeedsNoWriteBarrier(Register object,
+                                               Register value) {
+  // We can't assert the incremental barrier is not needed here, only the
+  // generational barrier. We sometimes omit the write barrier when 'value' is
+  // a constant, but we don't eagerly mark 'value' and instead assume it is also
+  // reachable via a constant pool, so it doesn't matter if it is not traced via
+  // 'object'.
+  Label done;
+  BranchIfSmi(value, &done, kNearJump);
+  Load(TMP, FieldAddress(value, target::Object::tags_offset()), kUnsignedByte);
+  TestImmediate(TMP, 1 << target::UntaggedObject::kNewOrEvacuationCandidateBit);
+  BranchIf(ZERO, &done, kNearJump);
+  Load(TMP, FieldAddress(object, target::Object::tags_offset()),
+       kUnsignedByte);
+  TestImmediate(TMP, 1 << target::UntaggedObject::kOldAndNotRememberedBit);
+  BranchIf(ZERO, &done, kNearJump);
+  Stop("Write barrier is required");
+  Bind(&done);
+}
+
+void Assembler::StoreObjectIntoObjectNoBarrier(Register object,
+                                               const Address& dest,
+                                               const Object& value,
+                                               MemoryOrder memory_order,
+                                               OperandSize size) {
+  ASSERT(IsOriginalObject(value));
+  DEBUG_ASSERT(IsNotTemporaryScopedHandle(value));
+  // No store buffer update.
+  Register src = NULL_REG;
+  if (!IsSameObject(compiler::NullObject(), value)) {
+    // Store uses R0 when the address needs an index register, so TMP is safe
+    // to use for the value.
+    src = TMP;
+    RELEASE_ASSERT((object != TMP) && (dest.base() != TMP) &&
+                   (dest.index() != TMP));
+    LoadObject(TMP, value);
+  }
+  if (memory_order == kRelease) {
+    StoreRelease(src, dest, size);
+  } else {
+    Store(src, dest, size);
+  }
+}

+// ---------------------------------------------------------------------------
+// Operands.
+// ---------------------------------------------------------------------------
+
+// base + 32-bit signed displacement, or base + index register (no scale).
+// An Address never encodes anything by itself: Assembler::Load/Store choose
+// the D-, DS- or X-form (ABI-SPEC section 5.2).
+class Address : public ValueObject {
+ public:
+  // |base| != R0: R0 in RA reads as zero (ABI-SPEC section 2.2).
+  Address(Register base, intptr_t offset)
+      : ValueObject(),
+        base_(base),
+        index_(kNoRegister),
+        offset_(static_cast<int32_t>(offset)) {
+    ASSERT((base != R0) && (base != kNoRegister));
+    RELEASE_ASSERT(Utils::IsInt(32, offset));
+  }
+  explicit Address(Register base) : Address(base, 0) {}
+  // |base| != R0; |index| may be R0 (the designated index register).
+  Address(Register base, Register index)
+      : ValueObject(), base_(base), index_(index), offset_(0) {
+    ASSERT((base != R0) && (base != kNoRegister));
+    ASSERT(index != kNoRegister);
+  }
+
+  Address(const Address& other)
+      : ValueObject(),
+        base_(other.base_),
+        index_(other.index_),
+        offset_(other.offset_) {}
+  Address& operator=(const Address& other) {
+    base_ = other.base_;
+    index_ = other.index_;
+    offset_ = other.offset_;
+    return *this;
+  }
+
+  Register base() const { return base_; }
+  // kNoRegister for a displacement address.
+  Register index() const { return index_; }
+  // 0 for an indexed address.
+  int32_t offset() const { return offset_; }
+  bool has_index() const { return index_ != kNoRegister; }
+
+ private:
+  Register base_;
+  Register index_;
+  int32_t offset_;
+};
+
+class FieldAddress : public Address {
+ public:
+  FieldAddress(Register base, intptr_t offset)
+      : Address(base, offset - kHeapObjectTag) {}
+
+  // Prevent implicit conversion of Register to intptr_t.
+  FieldAddress(Register base, Register index) = delete;
+};
+
+// ---------------------------------------------------------------------------
+// L1: MicroAssembler.
+// ---------------------------------------------------------------------------
+
+class MicroAssembler : public AssemblerBase {
+ public:
+  MicroAssembler(ObjectPoolBuilder* object_pool_builder,
+                 intptr_t far_branch_level);  // [core]
+  ~MicroAssembler();                          // [core]
+
+  // 0 on the first attempt; >= 1 after a branch-offset bailout (conditional
+  // branches to unbound labels then use the 8-byte far form).
+  intptr_t far_branch_level() const { return far_branch_level_; }
+  void set_far_branch_level(intptr_t level) { far_branch_level_ = level; }
+
+  // The only way words enter the buffer (WORK-SPLIT section 5, rule 1).
+  void Emit32(uint32_t word) {
+    AssemblerBuffer::EnsureCapacity ensured(&buffer_);
+    buffer_.Emit<uint32_t>(word);
+  }
+  uint32_t Read32(intptr_t position) {
+    return buffer_.Load<uint32_t>(position);
+  }
+  void Write32(intptr_t position, uint32_t word) {
+    buffer_.Store<uint32_t>(position, word);
+  }
+
+  // --- BEGIN L1 RAW EMITTERS ---
+  //
+  // This region references nothing but constants_ppc64.h, the assertion
+  // macros and Emit32: the encoding oracle (test/oracle) lifts it verbatim.
+  //
+  // Naming: emitters are named after the mnemonic, in lower case; record
+  // forms (Rc = 1, "x.") get a trailing underscore. Mnemonics that are C++
+  // keywords get a trailing underscore too (and_, or_, xor_, not_), so their
+  // record forms are and_rc, or_rc and xor_rc (a double underscore would be a
+  // reserved identifier). Operands are in assembler order; a D-form
+  // "lbz RT,D(RA)" is lbz(rt, ra, d). Branch displacements are byte offsets
+  // relative to the branch itself.
+  //
+  // Validators. Each checks one operand against the L1 contract and returns
+  // it unchanged. RELEASE_ASSERT, not ASSERT: every one of these is a silent
+  // miscompile if it slips through (a wrong base address, a corrupted TOC,
+  // a clobbered callee-saved CR field, a masked-off displacement bit).
+
+  // Any GPR operand: R0..R31 except R2 (TOC) and R13 (TLS) (invariant 2).
+  static Register Gpr(Register r) {
+    RELEASE_ASSERT((r >= R0) && (r <= R31) && (r != R2) && (r != R13));
+    return r;
+  }
+  // The (RA|0) operand of addi, addis and every storage access: R0 would
+  // read as the value zero, so it is not accepted (ABI-SPEC section 2.2).
+  static Register Base(Register r) {
+    RELEASE_ASSERT(r != R0);
+    return Gpr(r);
+  }
+  // The RA of ldu: also must differ from RT (invalid form otherwise).
+  static Register UpdateBase(Register ra, Register rt) {
+    RELEASE_ASSERT(ra != rt);
+    return Base(ra);
+  }
+  // An (RA|0) operand where the literal zero is wanted (larx, stcx., isel,
+  // dcbst, icbi): kNoRegister encodes RA = 0; R0 itself is still rejected.
+  static uint32_t BaseOrZero(Register r) {
+    return (r == kNoRegister) ? 0 : static_cast<uint32_t>(Base(r));
+  }
+  // F0..F31; VSR 32..63 (the VMX file) are never used (ABI-SPEC 2.1).
+  static FpuRegister Fpr(FpuRegister f) {
+    RELEASE_ASSERT((f >= F0) && (f <= F31));
+    return f;
+  }
+  // A CR field that is written: never CR2..CR4 (invariant 4).
+  static uint32_t CrfDst(CRField bf) {
+    RELEASE_ASSERT((bf >= CRF0) && (bf <= CRF7));
+    RELEASE_ASSERT((kCalleeSavedCRFields & (1 << bf)) == 0);

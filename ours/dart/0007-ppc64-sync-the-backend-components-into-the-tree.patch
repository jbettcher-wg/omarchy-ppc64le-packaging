+
+// Table-driven: an instruction word is identified by PPCLookupInstr against
+// kPPCInstrTable (PPC64_INSTRUCTION_LIST in constants_ppc64.h, the complete
+// set the backend may emit), and its operands are printed by the entry's
+// PPCOperands kind. A word that is not on the list prints as ".long 0x...":
+// the disassembler never names an instruction the backend cannot emit.
+//
+// Spelling follows GNU objdump -M power8 (register names r/f/vs/cr, the
+// extended mnemonics objdump uses: li, mr, cmpd, beq, sldi, clrldi, ...,
+// symbolic CR bits), so its output can be compared with objdump word for
+// word (test/disasm). One deliberate difference, as in the other Dart
+// disassemblers: branch targets are printed relative to the instruction
+// (".+12", ".-8"), so the output does not depend on where the code lives.
+class PPC64Decoder : public ValueObject {
+ public:
+  PPC64Decoder(char* buffer, size_t buffer_size)
+      : buffer_(buffer), buffer_size_(buffer_size), buffer_pos_(0) {
+    buffer_[0] = '\0';
+  }
+
+  // Writes the text of |word| into the buffer (0-terminated). Returns false
+  // for a word that is not a whitelisted instruction (printed as .long).
+  bool Decode(uint32_t word);
+
+ private:
+  void Print(const char* format, ...) PRINTF_ATTRIBUTE(2, 3);
+  void Gpr(uint32_t r) { Print("r%u", r); }
+  void GprOrZero(uint32_t r) {
+    if (r == 0) {
+      Print("0");
+    } else {
+      Gpr(r);
+    }
+  }
+  void Fpr(uint32_t f) { Print("f%u", f); }
+  void Vsr(uint32_t v) { Print("vs%u", v); }
+  void CrBit(uint32_t bit);
+  void Target(int64_t offset) {
+    Print(offset < 0 ? ".-%" Pd64 : ".+%" Pd64, offset < 0 ? -offset : offset);
+  }
+  // "beq", "bnelr", ...: BO 12 (branch if set) or 4 (branch if clear).
+  bool BranchMnemonic(uint32_t bo, uint32_t bi, const char* suffix);
+
+  char* buffer_;
+  size_t buffer_size_;
+  size_t buffer_pos_;
+
+  DISALLOW_COPY_AND_ASSIGN(PPC64Decoder);
+};
+
+void PPC64Decoder::Print(const char* format, ...) {
+  if (buffer_pos_ + 1 >= buffer_size_) return;
+  va_list args;
+  va_start(args, format);
+  const int n = Utils::VSNPrint(buffer_ + buffer_pos_,
+                                buffer_size_ - buffer_pos_, format, args);
+  va_end(args);
+  if (n > 0) {
+    buffer_pos_ += static_cast<size_t>(n);
+    if (buffer_pos_ >= buffer_size_) buffer_pos_ = buffer_size_ - 1;
+  }
+}
+
+// A CR bit BI = 4 * field + bit, as objdump prints it: "lt" .. "so" in CR0,
+// "4*cr7+gt" elsewhere.
+void PPC64Decoder::CrBit(uint32_t bit) {
+  static const char* const kBit[] = {"lt", "gt", "eq", "so"};
+  if (bit < 4) {
+    Print("%s", kBit[bit]);
+  } else {
+    Print("4*cr%u+%s", bit / 4, kBit[bit % 4]);
+  }
+}
+
+bool PPC64Decoder::BranchMnemonic(uint32_t bo, uint32_t bi, const char* suffix) {
+  static const char* const kIfSet[] = {"lt", "gt", "eq", "so"};
+  static const char* const kIfClear[] = {"ge", "le", "ne", "ns"};
+  if (bo != kBOTrue && bo != kBOFalse) return false;
+  Print("b%s%s", (bo == kBOTrue ? kIfSet : kIfClear)[bi % 4], suffix);
+  return true;
+}
+
+bool PPC64Decoder::Decode(uint32_t w) {
+  const intptr_t index = PPCLookupInstr(w);
+  if (index < 0) {
+    Print(".long 0x%08x", w);
+    return false;
+  }
+  const PPCInstrInfo& info = kPPCInstrTable[index];
+  const uint32_t templ = info.templ;
+  // Fields, by position (IBM bit numbers in the comments).
+  const uint32_t f6 = (w >> 21) & 31;   // 6:10   RT RS FRT BO BT
+  const uint32_t f11 = (w >> 16) & 31;  // 11:15  RA FRA BI BA
+  const uint32_t f16 = (w >> 11) & 31;  // 16:20  RB FRB SH BB
+  const uint32_t f21 = (w >> 6) & 31;   // 21:25  FRC BC MB
+  const uint32_t f26 = (w >> 1) & 31;   // 26:30  ME
+  const uint32_t bf = (w >> 23) & 7;    // 6:8
+  const bool l64 = ((w >> 21) & 1) != 0;  // 10
+  const int64_t si = static_cast<int16_t>(w & 0xffff);
+  const uint32_t ui = w & 0xffff;
+  const uint32_t sh6 = f16 | (((w >> 1) & 1) << 5);
+  const uint32_t mb6 = f21 | (((w >> 5) & 1) << 5);
+  const char* m = info.mnemonic;
+
+  switch (info.operands) {
+    case kOpNone:
+      if (templ == kPpcBclNextInstr) {
+        Print("bcl 20, ");
+        CrBit(31);
+        Print(", .+4");
+      } else {
+        Print("%s", m);
+      }
+      break;
+    case kOpRT_RA_SI:
+      if (templ == kPpcAddi && f11 == 0) {
+        Print("li r%u, %" Pd64, f6, si);
+      } else if (templ == kPpcAddis && f11 == 0) {
+        Print("lis r%u, %" Pd64, f6, si);
+      } else {
+        Print("%s r%u, r%u, %" Pd64, m, f6, f11, si);
+      }
+      break;
+    case kOpRA_RS_UI:
+      if (templ == kPpcXori && w == kPpcXori) {
+        Print("xnop");  // xori 0,0,0 (nop, ori 0,0,0, is a fixed word)
+      } else {
+        Print("%s r%u, r%u, %u", m, f11, f6, ui);
+      }
+      break;
+    case kOpBF_L_RA_SI:
+    case kOpBF_L_RA_UI:
+    case kOpBF_L_RA_RB: {
+      const bool logical = templ == kPpcCmpli || templ == kPpcCmpl;
+      const bool imm = info.operands != kOpBF_L_RA_RB;
+      Print("cmp%s%s%s ", logical ? "l" : "", l64 ? "d" : "w", imm ? "i" : "");
+      if (bf != 0) Print("cr%u, ", bf);
+      Gpr(f11);
+      if (info.operands == kOpBF_L_RA_RB) {
+        Print(", r%u", f16);
+      } else if (info.operands == kOpBF_L_RA_SI) {
+        Print(", %" Pd64, si);
+      } else {
+        Print(", %u", ui);
+      }
+      break;
+    }
+    case kOpRT_D_RA:
+      Print("%s r%u, %" Pd64 "(", m, f6, si);
+      GprOrZero(f11);
+      Print(")");
+      break;
+    case kOpFRT_D_RA:
+      Print("%s f%u, %" Pd64 "(", m, f6, si);
+      GprOrZero(f11);
+      Print(")");
+      break;
+    case kOpRT_DS_RA:
+      Print("%s r%u, %" Pd64 "(", m, f6, static_cast<int64_t>(si & ~3));
+      GprOrZero(f11);
+      Print(")");
+      break;
+    case kOpRT_RA_RB:
+    case kOpFRT_RA_RB: {
+      // Storage accesses read RA as (RA|0), the XO-form arithmetic as a
+      // register. On the list, exactly the storage mnemonics end in "x" or
+      // "x." (ldx, lhbrx, ldarx, stdcx.); add, subfe, mulhdu, ... do not.
+      const size_t len = strlen(m);
+      const bool storage =
+          (len >= 1 && m[len - 1] == 'x') ||
+          (len >= 2 && m[len - 2] == 'x' && m[len - 1] == '.');
+      Print("%s %s%u, ", m, info.operands == kOpFRT_RA_RB ? "f" : "r", f6);
+      if (storage) {
+        GprOrZero(f11);
+      } else {
+        Gpr(f11);
+      }
+      Print(", r%u", f16);
+      break;
+    }
+    case kOpRT_RA:
+      Print("%s r%u, r%u", m, f6, f11);
+      break;
+    case kOpRA_RS_RB:
+      if ((templ == kPpcOr || templ == kPpcOrRc) && f6 == f16) {
+        Print("mr%s r%u, r%u", templ == kPpcOrRc ? "." : "", f11, f6);
+      } else if (templ == kPpcNor && f6 == f16) {
+        Print("not r%u, r%u", f11, f6);
+      } else {
+        Print("%s r%u, r%u, r%u", m, f11, f6, f16);
+      }
+      break;
+    case kOpRA_RS:
+      Print("%s r%u, r%u", m, f11, f6);
+      break;
+    case kOpRA_RS_SH5:
+      Print("%s r%u, r%u, %u", m, f11, f6, f16);
+      break;
+    case kOpRA_RS_SH6:
+      Print("%s r%u, r%u, %u", m, f11, f6, sh6);
+      break;
+    // Extended mnemonics below follow objdump's choices and precedence
+    // [MEASURED, binutils 2.46: test/disasm/out/aliases.txt].
+    case kOpRA_RS_SH6_MB6: {
+      const bool rldicl = templ == kPpcRldicl || templ == kPpcRldiclRc;
+      const char* rc = templ == kPpcRldiclRc ? "." : "";
+      if (rldicl && mb6 == 0) {
+        Print("rotldi%s r%u, r%u, %u", rc, f11, f6, sh6);
+      } else if (rldicl && sh6 == 0) {
+        Print("clrldi%s r%u, r%u, %u", rc, f11, f6, mb6);
+      } else if (rldicl && sh6 + mb6 == 64) {
+        Print("srdi%s r%u, r%u, %u", rc, f11, f6, mb6);
+      } else {
+        Print("%s r%u, r%u, %u, %u", m, f11, f6, sh6, mb6);
+      }
+      break;
+    }
+    case kOpRA_RS_SH6_ME6:  // rldicr; the ME field sits where MB does
+      if (sh6 == 0) {
+        Print("clrrdi r%u, r%u, %u", f11, f6, 63 - mb6);
+      } else if (mb6 == 63 - sh6) {
+        Print("sldi r%u, r%u, %u", f11, f6, sh6);
+      } else {
+        Print("%s r%u, r%u, %u, %u", m, f11, f6, sh6, mb6);
+      }
+      break;
+    case kOpRA_RS_RB_MB6:  // rldcl
+      if (mb6 == 0) {
+        Print("rotld r%u, r%u, r%u", f11, f6, f16);
+      } else {
+        Print("%s r%u, r%u, r%u, %u", m, f11, f6, f16, mb6);
+      }
+      break;
+    case kOpRA_RS_RB_ME6:  // rldcr
+      Print("%s r%u, r%u, r%u, %u", m, f11, f6, f16, mb6);
+      break;
+    case kOpRA_RS_SH5_MB5_ME5: {
+      const char* rc = (templ == kPpcRlwinmRc) ? "." : "";
+      const bool rlwinm = templ == kPpcRlwinm || templ == kPpcRlwinmRc;
+      if (rlwinm && f21 == 0 && f26 == 31) {
+        Print("rotlwi%s r%u, r%u, %u", rc, f11, f6, f16);
+      } else if (rlwinm && f16 == 0 && f21 == 0) {
+        Print("clrrwi%s r%u, r%u, %u", rc, f11, f6, 31 - f26);
+      } else if (rlwinm && f21 == 0 && f26 == 31 - f16) {
+        Print("slwi%s r%u, r%u, %u", rc, f11, f6, f16);
+      } else if (rlwinm && f26 == 31 && f21 != 0 && f16 == 32 - f21) {
+        Print("srwi%s r%u, r%u, %u", rc, f11, f6, f21);
+      } else if (rlwinm && f16 == 0 && f26 == 31) {
+        Print("clrlwi%s r%u, r%u, %u", rc, f11, f6, f21);
+      } else {
+        Print("%s r%u, r%u, %u, %u, %u", m, f11, f6, f16, f21, f26);
+      }
+      break;
+    }
+    case kOpRA_RS_RB_MB5_ME5:
+      if (f21 == 0 && f26 == 31) {
+        Print("rotlw r%u, r%u, r%u", f11, f6, f16);
+      } else {
+        Print("%s r%u, r%u, r%u, %u, %u", m, f11, f6, f16, f21, f26);
+      }
+      break;
+    case kOpRT_RA_RB_BC:  // isel
+      if (f21 < 3) {
+        static const char* const kSuffix[] = {"lt", "gt", "eq"};
+        Print("isel%s r%u, ", kSuffix[f21], f6);
+        GprOrZero(f11);
+        Print(", r%u", f16);
+      } else {
+        Print("isel r%u, ", f6);
+        GprOrZero(f11);
+        Print(", r%u, ", f16);
+        CrBit(f21);
+      }
+      break;
+    case kOpLI: {
+      int64_t offset = static_cast<int64_t>(w & 0x03fffffc);
+      if (offset & 0x02000000) offset -= 0x04000000;
+      Print("%s ", m);
+      Target(offset);
+      break;
+    }
+    case kOpBO_BI_BD: {
+      const int64_t offset = static_cast<int16_t>(w & 0xfffc);
+      if (BranchMnemonic(f6, f11, "")) {
+        Print(" ");
+        if (f11 >= 4) Print("cr%u, ", f11 / 4);
+      } else {
+        Print("%s %u, ", m, f6);
+        CrBit(f11);
+        Print(", ");
+      }
+      Target(offset);
+      break;
+    }
+    case kOpBO_BI: {  // bclr, bcctr, bcctrl (BO 20 with BI 0 are fixed words)
+      const char* suffix = templ == kPpcBclr    ? "lr"
+                           : templ == kPpcBcctr ? "ctr"
+                                                : "ctrl";
+      if (BranchMnemonic(f6, f11, suffix)) {
+        if (f11 >= 4) Print(" cr%u", f11 / 4);
+      } else {
+        Print("%s %u, ", m, f6);
+        CrBit(f11);
+      }
+      break;
+    }
+    case kOpBT_BA_BB:
+      if (templ == kPpcCror && f11 == f16) {
+        Print("crmove ");
+      } else if (templ == kPpcCrnor && f11 == f16) {
+        Print("crnot ");
+      } else if (templ == kPpcCrxor && f6 == f11 && f11 == f16) {
+        Print("crclr ");
+        CrBit(f6);
+        break;
+      } else {
+        Print("%s ", m);
+      }
+      CrBit(f6);
+      Print(", ");
+      CrBit(f11);
+      if (f11 != f16 || (templ != kPpcCror && templ != kPpcCrnor)) {
+        Print(", ");
+        CrBit(f16);
+      }
+      break;
+    case kOpBF_BFA:
+      Print("%s cr%u, cr%u", m, bf, (w >> 18) & 7);
+      break;
+    case kOpRT:
+      Print("%s r%u", m, f6);
+      break;
+    case kOpRT_FXM:
+      Print("%s r%u, %u", m, f6, (w >> 12) & 0xff);
+      break;
+    case kOpRA_RB:
+      Print("%s ", m);
+      GprOrZero(f11);
+      Print(", r%u", f16);
+      break;
+    case kOpFRT_FRA_FRB:
+      Print("%s f%u, f%u, f%u", m, f6, f11, f16);
+      break;
+    case kOpFRT_FRA_FRC:
+      Print("%s f%u, f%u, f%u", m, f6, f11, f21);
+      break;
+    case kOpFRT_FRB:
+      Print("%s f%u, f%u", m, f6, f16);
+      break;
+    case kOpBF_FRA_FRB:
+      Print("%s cr%u, f%u, f%u", m, bf, f11, f16);
+      break;
+    case kOpXT_RA: {
+      // A VSR below 32 is an FPR: objdump names the move after it.
+      const uint32_t xt = f6 | ((w & 1) << 5);
+      const char* fpr = templ == kPpcMtvsrd    ? "mtfprd"
+                        : templ == kPpcMtvsrwa ? "mtfprwa"
+                                               : "mtfprwz";
+      if (xt < 32) {
+        Print("%s f%u, r%u", fpr, xt, f11);
+      } else {
+        Print("%s vs%u, r%u", m, xt, f11);
+      }
+      break;
+    }
+    case kOpRA_XS: {
+      const uint32_t xs = f6 | ((w & 1) << 5);
+      const char* fpr = templ == kPpcMfvsrd ? "mffprd" : "mffprwz";
+      if (xs < 32) {
+        Print("%s r%u, f%u", fpr, f11, xs);
+      } else {
+        Print("%s r%u, vs%u", m, f11, xs);
+      }
+      break;
+    }
+    case kOpXT_XB:
+      Print("%s vs%u, vs%u", m, f6 | ((w & 1) << 5), f16 | (((w >> 1) & 1) << 5));
+      break;
+    case kOpXT_XA_XB: {
+      const uint32_t xt = f6 | ((w & 1) << 5);
+      const uint32_t xa = f11 | (((w >> 2) & 1) << 5);
+      const uint32_t xb = f16 | (((w >> 1) & 1) << 5);
+      if (templ == kPpcXxlor && xa == xb) {
+        Print("xxmr vs%u, vs%u", xt, xa);
+      } else {
+        Print("%s vs%u, vs%u, vs%u", m, xt, xa, xb);
+      }
+      break;
+    }
+  }
+  return true;
+}
+
+void Disassembler::DecodeInstruction(char* hex_buffer,
+                                     intptr_t hex_size,
+                                     char* human_buffer,
+                                     intptr_t human_size,
+                                     int* out_instr_size,
+                                     const Code& code,
+                                     Object** object,
+                                     uword pc) {
+  const uint32_t word = *reinterpret_cast<uint32_t*>(pc);
+  PPC64Decoder decoder(human_buffer, human_size);
+  decoder.Decode(word);
+  Utils::SNPrint(hex_buffer, hex_size, "%08x", word);
+  if (out_instr_size != nullptr) {
+    *out_instr_size = Instr::kInstrSize;
+  }
+
+  *object = nullptr;
+  if (!code.IsNull()) {
+    *object = &Object::Handle();
+    if (!DecodeLoadObjectFromPoolOrThread(pc, code, *object)) {
+      *object = nullptr;
+    }
+  }
+}

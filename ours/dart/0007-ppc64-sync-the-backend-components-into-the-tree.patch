+struct DartCallingConvention {
+  static constexpr Register kCpuRegistersForArgs[] = {R4, R5, R6, R8, R9, R10};
+  static constexpr FpuRegister kFpuRegistersForArgs[] = {F1, F2, F3,
+                                                         F4, F5, F6};

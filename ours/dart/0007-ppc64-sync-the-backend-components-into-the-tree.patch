+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_VM_CONSTANTS_PPC64_H_
+#define RUNTIME_VM_CONSTANTS_PPC64_H_
+
+#ifndef RUNTIME_VM_CONSTANTS_H_
+#error Do not include constants_ppc64.h directly; use constants.h instead.
+#endif
+
+#include "platform/assert.h"
+#include "platform/globals.h"
+#include "platform/utils.h"
+
+#include "vm/constants_base.h"
+
+// 64-bit PowerPC, little-endian, ELFv2 ABI ("ppc64le").
+//
+// The normative description of everything in this file is
+// flutter-port/work/abi/ABI-SPEC.md. Section numbers below refer to it.
+//
+// Invariants that the whole backend relies on (ABI-SPEC section 1):
+//
+//  * Generated code never reads or writes R2 (TOC) or R13 (TLS).
+//  * Generated code is POWER8-legal (ISA 2.07). There is no emitter for any
+//    ISA 3.0 instruction; PPC64_INSTRUCTION_LIST below is the complete
+//    whitelist.
+//  * R0 reads as zero when used as the base (RA) of addi/addis and of every
+//    D-, DS- and X-form storage access. R0 is therefore never allocatable and
+//    never holds a value across a macro-assembler call; it is the
+//    macro-assembler's implicit scratch and may be used as an *index* (RB).
+//  * CR2, CR3 and CR4 are callee-saved in ELFv2 and are never written.
+//  * LR and CTR are special-purpose registers, not members of |Register|.
+
+namespace dart {
+
+enum Register {
+  R0 = 0,  // Macro-assembler scratch. Reads as 0 in RA of addi/load/store.
+  R1 = 1,  // SP (ELFv2 stack pointer, used directly as Dart SP).
+  R2 = 2,  // TOC. Never touched.
+  R3 = 3,  // C arg 0 / result.
+  R4 = 4,
+  R5 = 5,
+  R6 = 6,
+  R7 = 7,  // ARGS_DESC_REG
+  R8 = 8,  // IC_DATA_REG
+  R9 = 9,
+  R10 = 10,  // C arg 7.
+  R11 = 11,  // TMP
+  R12 = 12,  // TMP2. Also: ELFv2 global-entry address for every C call.
+  R13 = 13,  // TLS (thread pointer). Never touched.
+  R14 = 14,
+  R15 = 15,
+  R16 = 16,
+  R17 = 17,
+  R18 = 18,
+  R19 = 19,
+  R20 = 20,
+  R21 = 21,  // CALLEE_SAVED_TEMP
+  R22 = 22,  // CALLEE_SAVED_TEMP2
+  R23 = 23,
+  R24 = 24,  // kWriteBarrierSlotReg
+  R25 = 25,  // DISPATCH_TABLE_REG (AOT only)
+  R26 = 26,  // NULL_REG
+  R27 = 27,  // WRITE_BARRIER_STATE
+  R28 = 28,  // CODE_REG
+  R29 = 29,  // THR
+  R30 = 30,  // PP (untagged)
+  R31 = 31,  // FP
+  kNumberOfCpuRegisters = 32,
+  kNoRegister = -1,
+  kNoRegister2 = -2,
+
+  // Aliases.
+  SP = R1,
+  FP = R31,
+};
+
+// Floating point registers. F<n> is also VSX register VSR<n> (n = 0..31); the
+// scalar double lives in doubleword 0 of the VSR.
+enum FRegister {
+  F0 = 0,  // FpuTMP
+  F1 = 1,  // C FP arg 0 / result.
+  F2 = 2,
+  F3 = 3,
+  F4 = 4,
+  F5 = 5,
+  F6 = 6,
+  F7 = 7,
+  F8 = 8,
+  F9 = 9,
+  F10 = 10,
+  F11 = 11,
+  F12 = 12,
+  F13 = 13,  // C FP arg 12.

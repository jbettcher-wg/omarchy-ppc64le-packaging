+  kOpRA_RS_RB_MB5_ME5,  // rlwnm RA,RS,RB,MB,ME
+  kOpLI,                // b target
+  kOpBO_BI_BD,          // bc BO,BI,target
+  kOpBO_BI,             // bclr BO,BI
+  kOpBT_BA_BB,          // cror BT,BA,BB
+  kOpBF_BFA,            // mcrf BF,BFA
+  kOpRT,                // mflr RT / mtlr RS / mfcr RT

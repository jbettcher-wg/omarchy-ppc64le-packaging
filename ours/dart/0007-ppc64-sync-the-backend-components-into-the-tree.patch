+//
+// Normative: flutter-port/work/abi/ABI-SPEC.md and work/stubs/STUBS-SPEC.md
+// ("S-n" below refers to section n of STUBS-SPEC.md). The code template is
+// stub_code_compiler_arm64.cc; raw register names are translated through the
+// bijection of ABI-SPEC 2.3:
+//
+//   ARM64  R0-R7   R8-R14    R19 R20  R23  R25  R16 R17   LR
+//   ppc64  R3-R10  R14-R20   R21 R22  R23  R24  TMP TMP2  SPR (via R0)
+//
+// What differs from the template, everywhere in this file:
+//  * There is no zero register. A zero slot is PushImmediate(0); a zero store
+//    is StoreZero().
+//  * LR is not a general register. It is saved by EnterFrame/EnterStubFrame
+//    or PushLinkRegister, and moved with mflr/mtlr.
+//  * There is no separate C stack pointer. R1 is realigned by
+//    ReserveAlignedFrameSpace and recovered from FP.
+//  * C is entered only through CallCFunction (ABI-SPEC 4.2), which builds the
+//    96-byte ELFv2 frame header and puts the callee address in R12.
+//  * Flags do not exist: compares are deferred (CompareXxx + BranchIf), and a
+//    stub that "returns flags" on ARM64 returns TMP == 0 instead (S-12).
+//  * Indirect jumps go through CTR (Jump(Address), JumpRegister); a non-local
+//    transfer never uses blr (S-10).
+//  * R2 and R13 are never named. Nothing is stored below R1.
+//
+// Simplicity choices (the user prefers correct and simple over fast) are
+// marked "(simple)".
+
+#define __ assembler->
+
+namespace dart {
+
+namespace compiler {
+
+// Loads base[index * 8] into dst. Clobbers TMP.
+static void LoadWordIndexed(Assembler* assembler,
+                            Register dst,
+                            Register base,
+                            Register index) {
+  ASSERT(index != TMP);
+  ASSERT(base != TMP);
+  __ sldi(TMP, index, target::kWordSizeLog2);
+  __ Load(dst, Address(base, TMP));
+}
+
+#if defined(DEBUG)
+static void CheckComingFromDartCode(Assembler* assembler) {
+  Label ok;
+  // Check that we are always entering from Dart code.
+  __ LoadFromOffset(TMP, THR, target::Thread::vm_tag_offset());
+  __ CompareImmediate(TMP, VMTag::kDartTagId);
+  __ BranchIf(EQUAL, &ok, Assembler::kNearJump);
+  __ Stop("Not coming from Dart code.");
+  __ Bind(&ok);
+}
+#endif
+
+// Common tail of every stub that left generated code through a runtime or
+// native call: back to "executing Dart code" (S-2).
+static void MarkBackInDartCode(Assembler* assembler) {
+  // Refresh pinned registers (write barrier mask, null, dispatch table, etc).
+  __ RestorePinnedRegisters();
+
+  // Mark that the thread is executing Dart code.
+  __ LoadImmediate(TMP, VMTag::kDartTagId);
+  __ StoreToOffset(TMP, THR, target::Thread::vm_tag_offset());
+
+  // Mark that the thread has not exited generated Dart code.
+  __ StoreZero(Address(THR, target::Thread::exit_through_ffi_offset()));
+
+  // Reset exit frame information in Isolate's mutator thread structure.
+  __ StoreZero(Address(THR, target::Thread::top_exit_frame_info_offset()));
+
+  // Restore the global object pool after returning from runtime (old space is
+  // moving, so the GOP could have been relocated).
+  if (FLAG_precompiled_mode) {
+    __ SetupGlobalPoolAndDispatchTable();
+  }
+}
+
+// Ensures that [R3] is a new object, if not it will be added to the remembered
+// set via a leaf runtime call.
+//
+// WARNING: This might clobber all registers except for [R3], [THR] and [FP].
+// The caller should simply call LeaveStubFrame() and return.
+void StubCodeCompiler::EnsureIsNewOrRemembered() {
+  // If the object is not in an active TLAB, we call a leaf-runtime to add it to
+  // the remembered set and/or deferred marking worklist. This test assumes a
+  // Page's TLAB use is always ascending.
+  Label done;
+  __ AndImmediate(TMP, R3, target::kPageMask);
+  __ LoadFromOffset(TMP, TMP, target::Page::original_top_offset());
+  __ CompareRegisters(R3, TMP);
+  __ BranchIf(UNSIGNED_GREATER_EQUAL, &done);
+
+  {
+    LeafRuntimeScope rt(assembler, /*frame_size=*/0,
+                        /*preserve_registers=*/false);
+    // R3 already loaded. The entry returns its first argument.
+    __ MoveRegister(R4, THR);
+    rt.Call(kEnsureRememberedAndMarkingDeferredRuntimeEntry,
+            /*argument_count=*/2);
+  }
+
+  __ Bind(&done);
+}
+
+// Input parameters:
+//   LR : return address.
+//   SP : address of last argument in argument array.
+//   SP + 8*R7 - 8 : address of first argument in argument array.
+//   SP + 8*R7 : address of return value.
+//   R8 : address of the runtime function to call.
+//   R7 : number of arguments to the call.
+//
+// S-2. The runtime entry is `void DRT_xxx(NativeArguments)`. NativeArguments
+// is a 32-byte trivially copyable aggregate, and ELFv2 passes such an
+// aggregate BY VALUE in four consecutive doublewords, i.e. in R3..R6
+// [MEASURED: g++ 16.1.1 and clang++ 22.1.8, work/stubs/check/na-abi/]. This is
+// unlike ARM64 and RISC-V, which pass a pointer to a copy; there is no
+// in-memory NativeArguments here at all.
+void StubCodeCompiler::GenerateCallToRuntimeStub() {
+  ASSERT(target::NativeArguments::thread_offset() == 0 * target::kWordSize);
+  ASSERT(target::NativeArguments::argc_tag_offset() == 1 * target::kWordSize);
+  ASSERT(target::NativeArguments::argv_offset() == 2 * target::kWordSize);
+  ASSERT(target::NativeArguments::retval_offset() == 3 * target::kWordSize);
+  ASSERT(target::NativeArguments::StructSize() == 4 * target::kWordSize);
+
+  __ Comment("CallToRuntimeStub");
+  __ LoadFromOffset(CODE_REG, THR,
+                    target::Thread::call_to_runtime_stub_offset());
+  __ SetPrologueOffset();
+  __ EnterStubFrame();
+
+  // Save exit frame information to enable stack walking as we are about
+  // to transition to Dart VM C++ code.
+  __ StoreToOffset(FP, THR, target::Thread::top_exit_frame_info_offset());
+
+  // Mark that the thread exited generated code through a runtime call.
+  __ LoadImmediate(TMP, target::Thread::exit_through_runtime_call());
+  __ StoreToOffset(TMP, THR, target::Thread::exit_through_ffi_offset());
+
+#if defined(DEBUG)
+  CheckComingFromDartCode(assembler);
+#endif
+
+  // Mark that the thread is executing VM code.
+  __ StoreToOffset(R8, THR, target::Thread::vm_tag_offset());
+
+  // Align the frame before entering the C++ world. No space is reserved: the
+  // four NativeArguments words travel in registers, and CallCFunction adds
+  // the ELFv2 frame header (whose parameter save area is where the callee may
+  // home them).
+  __ Comment("align stack");
+  __ ReserveAlignedFrameSpace(0);
+
+  // NativeArguments.thread_
+  __ MoveRegister(R3, THR);
+  // NativeArguments.argc_tag_
+  __ MoveRegister(R4, R7);
+  // NativeArguments.argv_ = FP + (param_end_from_fp + argc) * kWordSize.
+  __ sldi(R5, R7, target::kWordSizeLog2);
+  __ add(R5, FP, R5);
+  __ AddImmediate(R5, R5,
+                  target::frame_layout.param_end_from_fp * target::kWordSize);
+  // NativeArguments.retval_: next to the first argument.
+  __ AddImmediate(R6, R5, target::kWordSize);
+
+  __ CallCFunction(R8);
+  __ Comment("CallToRuntimeStub return");
+
+  MarkBackInDartCode(assembler);
+
+  // Recovers SP from FP: no register has to carry the pre-alignment SP.
+  __ LeaveStubFrame();
+
+  // The following return can jump to a lazy-deopt stub, which assumes R3
+  // contains a return value and will save it in a GC-visible way.  We therefore
+  // have to ensure R3 does not contain any garbage value left from the C
+  // function we called (which has return type "void").
+  // (See GenerateDeoptimizationSequence::saved_result_slot_from_fp.)
+  __ LoadImmediate(R3, 0);
+  __ Ret();
+}
+
+void StubCodeCompiler::GenerateSharedStubGeneric(
+    bool save_fpu_registers,
+    intptr_t self_code_stub_offset_from_thread,
+    bool allow_return,
+    std::function<void()> perform_runtime_call) {
+  // We want the saved registers to appear like part of the caller's frame, so
+  // we push them before calling EnterStubFrame.
+  RegisterSet all_registers;
+  all_registers.AddAllNonReservedRegisters(save_fpu_registers);
+
+  // To make the stack map calculation architecture independent we do the same
+  // as on intel: the return address occupies a slot above the saved registers.
+  __ PushLinkRegister();
+  __ PushRegisters(all_registers);
+  __ LoadFromOffset(CODE_REG, THR, self_code_stub_offset_from_thread);
+  __ EnterStubFrame();
+  perform_runtime_call();
+  if (!allow_return) {
+    __ Breakpoint();
+    return;
+  }
+  __ LeaveStubFrame();
+  __ PopRegisters(all_registers);
+  __ Drop(1);  // We use the LR restored via LeaveStubFrame.
+  __ Ret();
+}
+
+void StubCodeCompiler::GenerateSharedStub(
+    bool save_fpu_registers,
+    const RuntimeEntry* target,
+    intptr_t self_code_stub_offset_from_thread,
+    bool allow_return,
+    bool store_runtime_result_in_result_register) {
+  ASSERT(!store_runtime_result_in_result_register || allow_return);
+  auto perform_runtime_call = [&]() {
+    if (store_runtime_result_in_result_register) {
+      __ PushRegister(NULL_REG);
+    }
+    __ CallRuntime(*target, /*argument_count=*/0);
+    if (store_runtime_result_in_result_register) {
+      __ PopRegister(R3);
+      __ StoreToOffset(R3, FP,
+                       target::kWordSize *
+                           StubCodeCompiler::WordOffsetFromFpToCpuRegister(
+                               SharedSlowPathStubABI::kResultReg));
+    }
+  };
+  GenerateSharedStubGeneric(save_fpu_registers,
+                            self_code_stub_offset_from_thread, allow_return,
+                            perform_runtime_call);
+}
+
+// Every register a slow-path safepoint transition must leave intact: all
+// general and floating-point registers except SP and FP (restored by the
+// frame) and R2/R13 (never named, ABI-SPEC invariant 2). Spelled out rather
+// than taken from RegisterSet::AddAllGeneralRegisters() so that this file does
+// not depend on the locations.h patch (patches/0002).
+static RegisterSet SafepointStubSavedRegisters() {
+  const uintptr_t cpu =
+      kAllCpuRegistersList &
+      ~((static_cast<uintptr_t>(1) << SPREG) |
+        (static_cast<uintptr_t>(1) << FPREG) | kAbiUntouchableCpuRegs);
+  return RegisterSet(cpu, kAllFpuRegistersList);
+}
+
+// S-7. The slow paths of Assembler::EnterFullSafepoint/ExitFullSafepoint.
+// Called with live C argument registers (enter) or live C result registers
+// (exit), from code whose stack may be misaligned by 8.
+void StubCodeCompiler::GenerateEnterSafepointStub() {
+  const RegisterSet all_registers = SafepointStubSavedRegisters();
+
+  __ EnterFrame(0);
+  __ PushRegisters(all_registers);
+
+  COMPILE_ASSERT(IsAbiPreservedRegister(CALLEE_SAVED_TEMP2));
+  __ MoveRegister(CALLEE_SAVED_TEMP2, SP);
+  __ ReserveAlignedFrameSpace(0);
+
+  __ CallCFunction(
+      Address(THR, kEnterSafepointRuntimeEntry.OffsetFromThread()));
+
+  __ MoveRegister(SP, CALLEE_SAVED_TEMP2);
+
+  __ PopRegisters(all_registers);
+  __ LeaveFrame();
+
+  __ Ret();
+}
+
+void StubCodeCompiler::GenerateExitSafepointStub() {
+  const RegisterSet all_registers = SafepointStubSavedRegisters();
+
+  __ EnterFrame(0);
+  __ PushRegisters(all_registers);
+
+  COMPILE_ASSERT(IsAbiPreservedRegister(CALLEE_SAVED_TEMP2));
+  __ MoveRegister(CALLEE_SAVED_TEMP2, SP);
+  __ ReserveAlignedFrameSpace(0);
+
+  __ VerifyNotInGenerated(TMP);
+
+  __ CallCFunction(Address(THR, kExitSafepointRuntimeEntry.OffsetFromThread()));
+
+  __ MoveRegister(SP, CALLEE_SAVED_TEMP2);
+
+  __ PopRegisters(all_registers);
+  __ LeaveFrame();
+
+  __ Ret();
+}
+
+// Calls native code within a safepoint.
+//
+// On entry:
+//   R15: target to call (CallingConventions::kFirstNonArgumentRegister)
+//   Stack: set up for native call: R1 16-byte aligned, stack-passed argument
+//          doublewords at 0(R1) upward (the argument base of ABI-SPEC 3.4)
+//   R3-R10, F1-F13: register arguments
+//
+// On exit:
+//   R21: clobbered, although normally callee-saved
+//   R16: clobbered
+//   Stack: preserved
+//   R3, R4, F1-F8: results of the native function
+//
+// S-3. The return address travels in R21, which the C callee preserves; the
+// stack is not touched, so the argument base is still R1 at the call.
+void StubCodeCompiler::GenerateCallNativeThroughSafepointStub() {
+  const Register kTargetReg = CallingConventions::kFirstNonArgumentRegister;
+  const Register kScratchReg = CallingConventions::kSecondNonArgumentRegister;
+  const Register kSavedLrReg = CallingConventions::kFfiAnyNonAbiRegister;
+  COMPILE_ASSERT(IsAbiPreservedRegister(kSavedLrReg));
+  // The transition must not disturb the C arguments or results.
+  COMPILE_ASSERT(!IsArgumentRegister(kTargetReg));
+  COMPILE_ASSERT(!IsArgumentRegister(kScratchReg));
+  COMPILE_ASSERT(kScratchReg != CallingConventions::kReturnReg);
+  COMPILE_ASSERT(kScratchReg != CallingConventions::kSecondReturnReg);
+
+  __ mflr(kSavedLrReg);
+  __ LoadImmediate(kScratchReg, target::Thread::exit_through_ffi());
+  __ TransitionGeneratedToNative(kTargetReg, FPREG, kScratchReg,
+                                 /*enter_safepoint=*/true);
+
+  // Moves the target to R12 (it had to stay out of R12 until now: the slow
+  // path of the transition calls C). Traps in DEBUG mode if R1 is misaligned.
+  __ CallCFunction(kTargetReg);
+
+  __ TransitionNativeToGenerated(kScratchReg, /*exit_safepoint=*/true);
+  __ mtlr(kSavedLrReg);
+  __ Ret();
+}
+
+void StubCodeCompiler::GenerateFfiCallTrampolineStub() {
+  // Only used by the simulators.
+  __ Breakpoint();
+}
+
+// AOT only. Position-independent: reads the PC (ABI-SPEC 6.5), with LR
+// preserved around the read so that the helper works in frameless code too.
+void StubCodeCompiler::GenerateLoadBSSEntry(BSS::Relocation relocation,
+                                            Register dst,
+                                            Register tmp) {
+  compiler::Label skip_reloc;
+  __ Jump(&skip_reloc);
+  InsertBSSRelocation(relocation);
+  __ Bind(&skip_reloc);
+
+  // Raw emitters: the distance from the relocation word is part of the
+  // sequence, and R0 carries LR across the PC read.
+  __ mflr(R0);
+  __ bcl_next_instr();
+  __ mflr(tmp);  // tmp = address of this instruction = skip_reloc + 8.
+  __ mtlr(R0);
+  __ addi(tmp, tmp, -(2 * Instr::kInstrSize + target::kWordSize));
+
+  // tmp holds the address of the relocation.
+  __ Load(dst, compiler::Address(tmp, 0));
+
+  // dst holds the relocation itself: tmp - bss_start.
+  // tmp = tmp + (bss_start - tmp) = bss_start
+  __ add(tmp, tmp, dst);
+
+  // tmp holds the start of the BSS section.
+  // Load the "get-thread" routine: *bss_start.
+  __ Load(dst, compiler::Address(tmp, 0));
+}
+
+// S-4. Destroys LR (it reads the PC with "bcl 20,31,$+4"); every use below is
+// at a point where LR is saved in the stub's own frame or is dead.
+void StubCodeCompiler::GenerateLoadFfiCallbackMetadataRuntimeFunction(
+    uword function_index,
+    Register dst) {
+  // Keep in sync with FfiCallbackMetadata::EnsureFirstTrampolinePageLocked.
+
+  // Any address inside the stub page will do.
+  __ LoadPC(dst);
+
+  // Round dst down to the page size.
+  __ AndImmediate(dst, dst, FfiCallbackMetadata::kPageMask);
+
+  // Load the function from the function table.
+  __ LoadFromOffset(dst, dst,
+                    FfiCallbackMetadata::RuntimeFunctionOffset(function_index));
+}
+
+// S-4. Entered from C through a function pointer, so (ELFv2 2.3.2.1):
+//   R12 : address of the trampoline that was called
+//   LR  : return address into the foreign caller
+//   R1  : the caller's stack pointer, 16-byte aligned; its stack-passed
+//         argument doublewords start at 96(R1)
+//   R3-R10, F1-F13 : register arguments
+// Before anything is saved only R0, R11 and R12 are free.
+void StubCodeCompiler::GenerateFfiCallbackTrampolineStub() {
+  Label body;
+
+  // One instruction per trampoline. R12 already identifies the trampoline, so
+  // no PC read is needed here (ABI-SPEC 3.5).
+  COMPILE_ASSERT(FfiCallbackMetadata::kNativeCallbackTrampolineSize ==
+                 Instr::kInstrSize);
+  for (intptr_t i = 0; i < FfiCallbackMetadata::NumCallbackTrampolinesPerPage();
+       ++i) {
+    __ Jump(&body);
+  }
+
+  ASSERT_EQUAL(__ CodeSize(),
+               FfiCallbackMetadata::kNativeCallbackTrampolineSize *
+                   FfiCallbackMetadata::NumCallbackTrampolinesPerPage());
+
+  __ Bind(&body);
+
+  const intptr_t shared_stub_start = __ CodeSize();
+
+  // Save LR and THR (callee-saved) on the C stack: two words, so the stack
+  // stays 16-byte aligned and the caller's linkage area (in particular its
+  // 24(R1) TOC slot and its parameter save area, which may not exist) is not
+  // written.
+  //   0(R1) THR    8(R1) LR
+  COMPILE_ASSERT(FfiCallbackMetadata::kNativeCallbackTrampolineStackDelta == 2);
+  __ PushLinkRegister();
+  __ PushRegister(THR);
+
+  COMPILE_ASSERT(!IsArgumentRegister(THR));
+  // The trampoline address must survive until it is moved to R3 below; the
+  // frame and push macros clobber R0 only.
+  const Register kTrampolineReg = kElfV2CalleeAddressReg;
+  COMPILE_ASSERT(kTrampolineReg == TMP2);
+
+  RegisterSet all_registers;
+  all_registers.AddAllArgumentRegisters();
+  all_registers.Add(Location::RegisterLocation(
+      CallingConventions::kPointerToReturnStructRegisterCall));
+
+  // The trampoline type and the Dart entry point come back in the only two
+  // registers that are volatile, not arguments and not results.
+  const Register kTrampolineTypeReg = TMP;
+  const Register kEntryPointReg = TMP2;
+  // Holds the address of the runtime function to call.
+  const Register kRuntimeFunctionReg = R9;
+
+  // Load the thread, verify the callback ID and exit the safepoint.
+  //
+  // We exit the safepoint inside DLRT_GetFfiCallbackMetadata in order to save
+  // code size on this shared stub.
+  {
+    __ EnterFrame(0);
+    __ PushRegisters(all_registers);
+
+    __ MoveRegister(R3, kTrampolineReg);
+
+    // We also need to look up the entry point for the trampoline. This is
+    // returned using a pointer passed to the second arg of the C function
+    // below. We aim that pointer at a reserved stack slot.
+    __ AddImmediate(SP, SP, -compiler::target::kWordSize);
+    __ MoveRegister(R4, SP);
+
+    // We also need to know if this is a sync or async callback. This is also
+    // returned by pointer.
+    __ AddImmediate(SP, SP, -compiler::target::kWordSize);
+    __ MoveRegister(R5, SP);
+
+    __ EnterFrame(0);
+    __ ReserveAlignedFrameSpace(0);
+
+    GenerateLoadFfiCallbackMetadataRuntimeFunction(
+        FfiCallbackMetadata::kGetFfiCallbackMetadata, kRuntimeFunctionReg);
+
+    __ CallCFunction(kRuntimeFunctionReg);
+    __ MoveRegister(THR, R3);
+
+    __ LeaveFrame();
+
+    // The trampoline type is at the top of the stack.
+    __ PopRegister(kTrampolineTypeReg);
+
+    // Entry point is now at the top of the stack.
+    __ PopRegister(kEntryPointReg);
+
+    __ PopRegisters(all_registers);
+    __ LeaveFrame();
+  }
+
+  Label async_callback;
+  Label sync_isolate_group_bound_callback;
+  Label done;
+
+  // If GetFfiCallbackMetadata returned a null thread, it means that the async
+  // callback was invoked after it was deleted. In this case, do nothing.
+  __ CompareImmediate(THR, 0);
+  __ BranchIf(EQUAL, &done);
+
+  // Check the trampoline type to see how the callback should be invoked.
+  __ CompareImmediate(
+      kTrampolineTypeReg,
+      static_cast<uword>(FfiCallbackMetadata::TrampolineType::kAsync));
+  __ BranchIf(EQUAL, &async_callback);
+
+  __ CompareImmediate(
+      kTrampolineTypeReg,
+      static_cast<uword>(
+          FfiCallbackMetadata::TrampolineType::kSyncIsolateGroupBound));
+  __ BranchIf(EQUAL, &sync_isolate_group_bound_callback);
+
+  // Sync callback. The entry point contains the target function, so just call
+  // it. DLRT_GetThreadForNativeCallbackTrampoline exited the safepoint, so
+  // re-enter it afterwards.
+
+  // Clobbers all volatile registers.
+  __ CallRegister(kEntryPointReg);
+
+  // Clobbers R0, TMP and R10: all volatile and none holding a result (results
+  // are in R3, R4 and F1-F8).
+  __ EnterFullSafepoint(/*scratch=*/R10);
+
+  __ Jump(&done);
+
+  __ Bind(&sync_isolate_group_bound_callback);
+
+  __ CallRegister(kEntryPointReg);
+
+  // Exit isolate group bound isolate.
+  {
+    // ELFv2 returns a homogeneous aggregate of up to eight members in F1-F8
+    // (ABI-SPEC 3.5 item 9), so all eight are kept, not just F1.
+    const RegisterSet return_registers(
+        (1 << CallingConventions::kReturnReg) |
+            (1 << CallingConventions::kSecondReturnReg),
+        (1 << F1) | (1 << F2) | (1 << F3) | (1 << F4) | (1 << F5) | (1 << F6) |
+            (1 << F7) | (1 << F8));
+
+    __ EnterFrame(0);
+    __ PushRegisters(return_registers);
+    __ ReserveAlignedFrameSpace(0);
+
+    GenerateLoadFfiCallbackMetadataRuntimeFunction(
+        FfiCallbackMetadata::kExitIsolateGroupBoundIsolate,
+        kRuntimeFunctionReg);
+
+    __ CallCFunction(kRuntimeFunctionReg);
+
+    __ AddImmediate(SP, FP, -return_registers.SpillSize());
+    __ PopRegisters(return_registers);
+    __ LeaveFrame();
+  }
+
+  __ Jump(&done);
+
+  __ Bind(&async_callback);
+
+  // Async callback. The entrypoint marshals the arguments into a message and
+  // sends it over the send port. DLRT_GetThreadForNativeCallbackTrampoline
+  // entered a temporary isolate, so exit it afterwards.
+
+  // Clobbers all volatile registers.
+  __ CallRegister(kEntryPointReg);
+
+  // Exit the temporary isolate.
+  {
+    // Straight into R12, where an ELFv2 callee expects its own address.
+    GenerateLoadFfiCallbackMetadataRuntimeFunction(
+        FfiCallbackMetadata::kExitTemporaryIsolate, kElfV2CalleeAddressReg);
+
+    // Pop THR and LR from the C stack.
+    __ PopRegister(THR);
+    __ PopLinkRegister();
+
+    // Tail-call DLRT_ExitTemporaryIsolate. It is not safe to return to this
+    // stub, since it might be deleted once DLRT_ExitTemporaryIsolate proceeds
+    // enough for VM shutdown.
+    //
+    // This is the one tail call into C in the backend (S-4): R1 and LR are
+    // the foreign caller's again, R12 holds the callee, and the callee takes
+    // no parameters, so it cannot touch a parameter save area that the
+    // foreign caller may not have allocated.
+    __ mtctr(kElfV2CalleeAddressReg);
+    __ bctr();
+    __ Breakpoint();
+  }
+
+  __ Bind(&done);
+
+  // Pop THR and LR from the C stack.
+  __ PopRegister(THR);
+  __ PopLinkRegister();
+
+  __ Ret();
+
+  ASSERT_LESS_OR_EQUAL(__ CodeSize() - shared_stub_start,
+                       FfiCallbackMetadata::kNativeCallbackSharedStubSize);
+  ASSERT_LESS_OR_EQUAL(__ CodeSize(), FfiCallbackMetadata::kPageSize);
+
+#if defined(DEBUG)
+  while (__ CodeSize() < FfiCallbackMetadata::kPageSize) {
+    __ Breakpoint();
+  }
+#endif
+}
+
+void StubCodeCompiler::GenerateDispatchTableNullErrorStub() {
+  __ EnterStubFrame();
+  __ SmiTag(DispatchTableNullErrorABI::kClassIdReg);
+  __ PushRegister(DispatchTableNullErrorABI::kClassIdReg);
+  __ CallRuntime(kDispatchTableNullErrorRuntimeEntry, /*argument_count=*/1);
+  // The NullError runtime entry does not return.
+  __ Breakpoint();
+}

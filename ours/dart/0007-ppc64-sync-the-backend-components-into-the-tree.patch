diff --git a/runtime/vm/stack_frame_ppc64.h b/runtime/vm/stack_frame_ppc64.h
new file mode 100644
index 00000000..3f5a7dc1
--- /dev/null
+++ b/runtime/vm/stack_frame_ppc64.h
@@ -0,0 +1,93 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_VM_STACK_FRAME_PPC64_H_
+#define RUNTIME_VM_STACK_FRAME_PPC64_H_
+
+#if !defined(RUNTIME_VM_STACK_FRAME_H_)
+#error Do not include stack_frame_ppc64.h directly; use stack_frame.h instead.
+#endif
+
+namespace dart {
+
+/* PPC64 Dart Frame Layout (ABI-SPEC section 3.1). Same shape as ARM64.
+
+               |                    | <- TOS
+Callee frame   | ...                |
+               | saved PP           |
+               | code object        |
+               | saved FP           |    (FP of current frame)
+               | saved LR           |    (PC of current frame)
+               +--------------------+
+Current frame  | ...               T| <- SP (R1) of current frame
+               | first local       T|
+               | caller's PP       T|    (tagged)
+               | code object       T|    (current frame's code object)
+               | caller's FP        | <- FP (R31) of current frame
+               | caller's LR        |    (PC of caller frame)
+               +--------------------+
+Caller frame   | last parameter     | <- SP of caller frame
+               |  ...               |
+
+               T against a slot indicates it needs to be traversed during GC.
+
+   These are NOT ELFv2 frames: there is no back chain at 0(R1), no linkage
+   area and no TOC save slot. R1 is 8-byte aligned in Dart code and is
+   16-byte aligned only at calls into C (Assembler::ReserveAlignedFrameSpace,
+   Assembler::CallCFunction).
+*/
+
+static constexpr int kDartFrameFixedSize = 4;  // PP, FP, LR, PC marker.
+static constexpr int kSavedPcSlotFromSp = -1;
+
+static constexpr int kFirstObjectSlotFromFp =
+    -1;  // Used by GC to traverse stack.
+static constexpr int kLastFixedObjectSlotFromFp = -2;
+
+static constexpr int kFirstLocalSlotFromFp = -3;
+static constexpr int kSavedCallerPpSlotFromFp = -2;
+static constexpr int kPcMarkerSlotFromFp = -1;
+static constexpr int kSavedCallerFpSlotFromFp = 0;
+static constexpr int kSavedCallerPcSlotFromFp = 1;
+
+static constexpr int kParamEndSlotFromFp = 1;  // One slot past last parameter.
+static constexpr int kCallerSpSlotFromFp = 2;
+static constexpr int kLastParamSlotFromEntrySp = 0;
+
+// Entry and exit frame layout (ABI-SPEC section 3.2).
+//
+//   FP +1  saved LR (return into C++)
+//   FP  0  saved FP
+//   FP -1  PC marker (InvokeDartCode stub's code object)
+//   FP -2 .. -18   R14 .. R30   (kAbiPreservedCpuRegs, 17 registers)
+//   FP -19 .. -36  F14 .. F31   (kAbiPreservedFpuRegs, 18 registers)
+//   FP -37  saved vm tag
+//   FP -38  saved top resource
+//   FP -39  saved exit-through-ffi
+//   FP -40  saved top exit frame info   <- kExitLinkSlotFromEntryFp
+static constexpr int kExitLinkSlotFromEntryFp = -40;
+COMPILE_ASSERT(kAbiPreservedCpuRegCount == 17);
+COMPILE_ASSERT(kAbiPreservedFpuRegCount == 18);
+
+// For FFI native -> Dart callbacks, this is the number of stack slots between
+// arguments passed on stack and arguments saved in callback prologue.
+//
+// 14 = return address (1) + saved frame pointer (1) + the caller's ELFv2
+// linkage area and parameter save area (kAbiCallFrameHeaderSize / 8 = 12):
+// the first stack-passed argument of a C caller is at 96(R1) on entry, not at
+// 0(R1) as on the other architectures.
+//
+// If NativeCallbackTrampolines::Enabled(), then
+// kNativeCallbackTrampolineStackDelta must be added as well.
+constexpr intptr_t kCallbackSlotsBeforeSavedArguments = 14;
+COMPILE_ASSERT(kCallbackSlotsBeforeSavedArguments ==
+               2 + kAbiCallFrameHeaderSize / 8);
+
+// For FFI calls passing in TypedData, we save it on the stack before entering
+// a Dart frame. This denotes how to get to the backed up typed data.
+static constexpr int kFfiCallerTypedDataSlotFromFp = kCallerSpSlotFromFp;
+
+}  // namespace dart
+
+#endif  // RUNTIME_VM_STACK_FRAME_PPC64_H_

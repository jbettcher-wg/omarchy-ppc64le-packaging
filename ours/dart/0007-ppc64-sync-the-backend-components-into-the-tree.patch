+// assembler_ppc64.cc: the [core] methods of assembler_ppc64.h (Agent A,
+// phase 1). Standalone: no target:: offsets, no object pool, no Thread, no
+// call into a [vm-*] method, so that it links in the tier-2 harness. The only
+// VM-side symbol it needs is compiler::BailoutWithBranchOffsetError().
+//
+// Section numbers refer to work/abi/ABI-SPEC.md.
+
+namespace dart {
+namespace compiler {
+
+MicroAssembler::MicroAssembler(ObjectPoolBuilder* object_pool_builder,
+                               intptr_t far_branch_level)
+    : AssemblerBase(object_pool_builder), far_branch_level_(far_branch_level) {
+  ASSERT(far_branch_level >= 0);
+  ASSERT(far_branch_level <= 2);
+}
+
+MicroAssembler::~MicroAssembler() {}
+
+Assembler::Assembler(ObjectPoolBuilder* object_pool_builder,
+                     intptr_t far_branch_level)
+    : MicroAssembler(object_pool_builder, far_branch_level),
+      constant_pool_allowed_(false) {}
+
+// ---------------------------------------------------------------------------
+// 2a. Memory access (section 5). The single choke point for the DS-form rule.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+using DispEmitter = void (MicroAssembler::*)(Register, Register, int64_t);
+using IndexEmitter = void (MicroAssembler::*)(Register, Register, Register);
+
+// One storage-access family: its displacement form, whether that form is
+// DS (displacement % 4 == 0), and its indexed form.
+struct AccessForm {
+  DispEmitter disp;
+  bool ds;
+  IndexEmitter index;
+};
+
+AccessForm LoadForm(OperandSize sz) {
+  switch (sz) {
+    case kByte:  // lbz, then extsb (there is no sign-extending byte load)
+    case kUnsignedByte:
+      return {&MicroAssembler::lbz, false, &MicroAssembler::lbzx};
+    case kTwoBytes:
+      return {&MicroAssembler::lha, false, &MicroAssembler::lhax};
+    case kUnsignedTwoBytes:
+      return {&MicroAssembler::lhz, false, &MicroAssembler::lhzx};
+    case kFourBytes:  // int32 results are sign-extended: lwa, never lwz (7.6)
+      return {&MicroAssembler::lwa, true, &MicroAssembler::lwax};
+    case kUnsignedFourBytes:
+      return {&MicroAssembler::lwz, false, &MicroAssembler::lwzx};
+    case kEightBytes:
+      return {&MicroAssembler::ld, true, &MicroAssembler::ldx};
+    default:
+      UNREACHABLE();
+  }
+}
+
+AccessForm StoreForm(OperandSize sz) {
+  switch (sz) {
+    case kByte:
+    case kUnsignedByte:
+      return {&MicroAssembler::stb, false, &MicroAssembler::stbx};
+    case kTwoBytes:
+    case kUnsignedTwoBytes:
+      return {&MicroAssembler::sth, false, &MicroAssembler::sthx};
+    case kFourBytes:
+    case kUnsignedFourBytes:
+      return {&MicroAssembler::stw, false, &MicroAssembler::stwx};
+    case kEightBytes:
+      return {&MicroAssembler::std, true, &MicroAssembler::stdx};
+    default:
+      UNREACHABLE();
+  }
+}
+
+bool FitsDisplacement(const AccessForm& form, int64_t offset) {
+  return form.ds ? IsDSDisplacement(offset) : IsInt16(offset);
+}
+
+// Emits one access of |form| for |address|: X-form for an index register,
+// D/DS-form when the displacement fits, else LoadImmediate(R0) + X-form.
+void EmitAccess(Assembler* assembler,
+                const AccessForm& form,
+                Register rt,
+                const Address& address,
+                bool is_store) {
+  if (address.has_index()) {
+    (assembler->*form.index)(rt, address.base(), address.index());
+    return;
+  }
+  const int32_t offset = address.offset();
+  if (FitsDisplacement(form, offset)) {
+    (assembler->*form.disp)(rt, address.base(), offset);
+    return;
+  }
+  // R0 is about to hold the offset: a stored value cannot be in R0.
+  RELEASE_ASSERT(!is_store || rt != R0);
+  assembler->LoadImmediate(R0, offset);
+  (assembler->*form.index)(rt, address.base(), R0);
+}
+
+}  // namespace
+
+void Assembler::Load(Register dst, const Address& address, OperandSize sz) {
+  EmitAccess(this, LoadForm(sz), dst, address, /*is_store=*/false);
+  if (sz == kByte) {
+    extsb(dst, dst);
+  }
+}
+
+void Assembler::Store(Register src, const Address& address, OperandSize sz) {
+  EmitAccess(this, StoreForm(sz), src, address, /*is_store=*/true);
+}
+
+void Assembler::StoreZero(const Address& address, Register temp) {
+  if (!address.has_index() &&
+      CanUseDisplacementForm(address.offset(), kEightBytes,
+                             /*is_store=*/true)) {
+    li(R0, 0);
+    Store(R0, address);
+    return;
+  }
+  // The access needs R0 (or already has an index): the zero goes elsewhere.
+  const Register zero = (temp == kNoRegister) ? TMP : temp;
+  RELEASE_ASSERT((zero != R0) && (zero != address.base()) &&
+                 (zero != address.index()));
+  li(zero, 0);
+  Store(zero, address);
+}
+
+bool Assembler::CanUseDisplacementForm(int32_t offset,
+                                       OperandSize sz,
+                                       bool is_store) {
+  return FitsDisplacement(is_store ? StoreForm(sz) : LoadForm(sz), offset);
+}
+
+intptr_t Assembler::MemoryAccessLength(int32_t offset,
+                                       OperandSize sz,
+                                       bool is_store) {
+  const intptr_t extend = (!is_store && sz == kByte) ? 1 : 0;
+  if (CanUseDisplacementForm(offset, sz, is_store)) {
+    return 1 + extend;
+  }
+  return LoadImmediateLength(offset) + 1 + extend;
+}
+
+void Assembler::AddImmediate(Register dst, Register base, int64_t imm) {
+  RELEASE_ASSERT(base != R0);  // addi would read it as zero
+  if (imm == 0) {
+    MoveRegister(dst, base);
+  } else if (IsInt16(imm)) {
+    addi(dst, base, imm);
+  } else {
+    // One form for every dst, R0 included: an addis+addi pair would read
+    // "addi r0,r0,lo" as r0 = 0 + lo (WORK-SPLIT 8, item 4).
+    LoadImmediate(R0, imm);
+    add(dst, base, R0);
+  }
+}
+
+void Assembler::AddRegisters(Register dst, Register src) {
+  add(dst, dst, src);
+}
+
+void Assembler::SubRegisters(Register dst, Register src) {
+  subf(dst, src, dst);  // dst = dst - src
+}
+
+void Assembler::AddShifted(Register dst,
+                           Register base,
+                           Register index,
+                           intptr_t shift) {
+  if (shift == 0) {
+    add(dst, base, index);
+  } else if (dst != base) {
+    sldi(dst, index, shift);
+    add(dst, base, dst);
+  } else {
+    sldi(R0, index, shift);
+    add(dst, base, R0);
+  }
+}
+
+void Assembler::ComputeElementAddress(Register dst,
+                                      Register base,
+                                      Register index,
+                                      ScaleFactor scale,
+                                      int32_t offset) {
+  RELEASE_ASSERT(dst != R0);  // the AddImmediate below reads dst as a base
+  AddShifted(dst, base, index, scale);
+  AddImmediate(dst, dst, offset);
+}
+
+void Assembler::LoadFromStack(Register dst, intptr_t depth) {
+  Load(dst, Address(SP, depth * target::kWordSize));
+}
+
+void Assembler::StoreToStack(Register src, intptr_t depth) {
+  Store(src, Address(SP, depth * target::kWordSize));
+}
+
+void Assembler::CompareToStack(Register src, intptr_t depth) {
+  ASSERT(src != TMP);
+  LoadFromStack(TMP, depth);
+  CompareRegisters(src, TMP);
+}
+
+void Assembler::CompareWithMemoryValue(Register value,
+                                       Address address,
+                                       OperandSize size) {
+  ASSERT(value != TMP);
+  Load(TMP, address, size);
+  CompareRegisters(value, TMP);
+  // A 32-bit memory value is compared as 32 bits, whatever the upper half of
+  // |value| holds.
+  if (size == kFourBytes || size == kUnsignedFourBytes) {
+    deferred_width_ = kFourBytes;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 2b. Constants (section 6.1).
+// ---------------------------------------------------------------------------
+
+intptr_t Assembler::LoadImmediateLength(int64_t imm) {
+  if (IsInt16(imm)) {
+    return 1;  // li
+  }
+  const intptr_t lo = ((imm & 0xffff) != 0) ? 1 : 0;
+  if (Utils::IsInt(32, imm)) {
+    return 1 + lo;  // lis [; ori]
+  }
+  if (Utils::IsUint(32, imm)) {
+    return 2 + lo;  // lis [; ori] ; clrldi 32
+  }
+  const intptr_t hi = LoadImmediateLength(imm >> 32);  // int32: li or lis/ori
+  const intptr_t mid = (((imm >> 16) & 0xffff) != 0) ? 1 : 0;
+  return hi + 1 + mid + lo;  // hi ; sldi 32 [; oris] [; ori]
+}
+
+void Assembler::LoadImmediate(Register dst, int64_t imm) {
+  if (IsInt16(imm)) {
+    li(dst, imm);
+    return;
+  }
+  if (Utils::IsInt(32, imm) || Utils::IsUint(32, imm)) {
+    // lis sign-extends bits 16..31 (lis r,-32768 is 0xffffffff80000000), so
+    // a uint32 with bit 31 set is cleared back to 32 bits.
+    lis(dst, static_cast<int16_t>(imm >> 16));
+    if ((imm & 0xffff) != 0) {
+      ori(dst, dst, imm & 0xffff);
+    }
+    if (!Utils::IsInt(32, imm)) {
+      clrldi(dst, dst, 32);
+    }
+    return;
+  }
+  LoadImmediate(dst, imm >> 32);  // an int32, so li or lis[/ori]
+  sldi(dst, dst, 32);
+  if (((imm >> 16) & 0xffff) != 0) {
+    oris(dst, dst, (imm >> 16) & 0xffff);
+  }
+  if ((imm & 0xffff) != 0) {
+    ori(dst, dst, imm & 0xffff);
+  }
+}
+
+void Assembler::PushImmediate(int64_t immediate) {
+  LoadImmediate(R0, immediate);
+  PushRegister(R0);
+}
+
+// ---------------------------------------------------------------------------
+// 2c. Labels and branches (section 7).
+//
+// Unresolved uses of a label are chained through the displacement fields of
+// the branches, each holding (previous use - this use), 0 for the first use.
+// There are two chains, so that a link never has to span more than its own
+// field can hold:
+//   * 24-bit b (Jump, and the b of the 8-byte far conditional form) through
+//     Label::position_ (the generic Label's link);
+//   * 4-byte bc through Label::unresolved_near_positions_[0] (the generic
+//     Label's near slot, which x64 uses the same way).
+// A near link that does not fit 14 bits means the earlier near use cannot
+// reach any target after this one either: that is the far-branch bailout.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+int32_t DecodeLI(uint32_t word) {
+  return static_cast<int32_t>((word & 0x03fffffcu) << 6) >> 6;
+}
+
+int32_t DecodeBD(uint32_t word) {
+  return static_cast<int16_t>(word & 0xfffcu);
+}
+
+uint32_t InvertBranchOption(uint32_t bo) {
+  ASSERT((bo == kBOTrue) || (bo == kBOFalse));
+  return (bo == kBOTrue) ? kBOFalse : kBOTrue;
+}
+
+}  // namespace
+
+bool Assembler::IsNearBranch(uint32_t word) {
+  return (word & Instr::kIFormMask) == kPpcBc;
+}
+
+bool Assembler::IsFarBranch(uint32_t word) {
+  return (word & Instr::kIFormMask) == kPpcB;
+}
+
+void Assembler::PatchBranch(intptr_t position, intptr_t target_position) {
+  const uint32_t word = Read32(position);
+  const int64_t offset = target_position - position;
+  if (IsFarBranch(word)) {
+    if (!IsBranch24Offset(offset)) {
+      FATAL("ppc64: b out of range (%" Pd " bytes)", offset);
+    }
+    Write32(position, (word & ~0x03fffffcu) | EncodeLI(offset));
+  } else if (IsNearBranch(word)) {
+    if (!IsBranch14Offset(offset)) {
+      FATAL("ppc64: bc out of range (%" Pd " bytes)", offset);
+    }
+    Write32(position, (word & ~0xfffcu) | EncodeBD(offset));
+  } else {
+    FATAL("ppc64: PatchBranch on a non-branch word %08x", word);
+  }
+}
+
+void Assembler::Bind(Label* label) {
+  ASSERT(!label->IsBound());
+  const intptr_t bound_pc = CodeSize();
+  while (label->IsLinked()) {
+    const intptr_t position = label->LinkPosition();
+    const int32_t link = DecodeLI(Read32(position));
+    PatchBranch(position, bound_pc);  // FATAL beyond +/-32 MiB
+    label->position_ = (link == 0) ? 0 : position + link + Label::kBias;
+  }
+  while (label->HasNear()) {
+    const intptr_t position = label->unresolved_near_positions_[0];
+    const int32_t link = DecodeBD(Read32(position));
+    if (!IsBranch14Offset(bound_pc - position)) {
+      if (far_branch_level() == 0) {
+        BailoutWithBranchOffsetError();  // retried with far branches
+      }
+      FATAL("ppc64: near conditional branch out of range");  // kNearJump
+    }
+    PatchBranch(position, bound_pc);
+    if (link == 0) {
+      label->unresolved_ = 0;
+    } else {
+      label->unresolved_near_positions_[0] = position + link;
+    }
+  }
+  label->BindTo(bound_pc);
+}
+
+void Assembler::Jump(Label* label, JumpDistance distance) {
+  ASSERT(deferred_compare_ == kNone);
+  if (label->IsBound()) {
+    b(label->Position() - CodeSize());
+    return;
+  }
+  const intptr_t position = CodeSize();
+  b(label->IsLinked() ? label->LinkPosition() - position : 0);
+  label->LinkTo(position);
+}
+
+void Assembler::Jump(const Address& address) {
+  Load(R0, address);
+  mtctr(R0);
+  bctr();
+}
+
+void Assembler::BranchIfCR(bool if_set,
+                           CRField crf,
+                           CRBit bit,
+                           Label* label,
+                           JumpDistance distance) {
+  const uint32_t bo = if_set ? kBOTrue : kBOFalse;
+  const uint32_t bi = CRBitIndex(crf, bit);
+  if (label->IsBound()) {
+    const int64_t offset = label->Position() - CodeSize();
+    if (IsBranch14Offset(offset)) {
+      bc(bo, bi, offset);
+      return;
+    }
+    if (distance == kNearJump) {
+      FATAL("ppc64: near conditional branch out of range");
+    }
+    bc(InvertBranchOption(bo), bi, 2 * Instr::kInstrSize);
+    b(label->Position() - CodeSize());
+    return;
+  }
+  const intptr_t position = CodeSize();
+  if (distance == kNearJump || far_branch_level() == 0) {
+    int64_t link = 0;
+    if (label->HasNear()) {
+      link = label->unresolved_near_positions_[0] - position;
+      if (!IsBranch14Offset(link)) {
+        // The previous near use is already out of reach of any target.
+        if (far_branch_level() == 0) {
+          BailoutWithBranchOffsetError();
+        }
+        FATAL("ppc64: near conditional branch out of range");
+      }
+    }
+    bc(bo, bi, link);
+    label->unresolved_near_positions_[0] = position;
+    label->unresolved_ = 1;
+    return;
+  }
+  // Far form: bc <inverted>,$+8 ; b target. The b carries the link.
+  bc(InvertBranchOption(bo), bi, 2 * Instr::kInstrSize);
+  const intptr_t b_position = CodeSize();
+  b(label->IsLinked() ? label->LinkPosition() - b_position : 0);
+  label->LinkTo(b_position);
+}
+
+// ----- Deferred compare (section 7.4) ---------------------------------------
+
+void Assembler::CompareRegisters(Register a, Register b) {
+  ASSERT(deferred_compare_ == kNone);
+  RELEASE_ASSERT((a != R0) && (b != R0));  // R0 is not live across L2 calls
+  deferred_compare_ = kCompareReg;
+  deferred_left_ = a;
+  deferred_reg_ = b;
+  deferred_width_ = kEightBytes;
+}
+
+void Assembler::CompareObjectRegisters(Register a, Register b) {
+  CompareRegisters(a, b);  // no compressed pointers (section 10)
+}
+
+void Assembler::CompareImmediate(Register reg,
+                                 int64_t imm,
+                                 OperandSize width) {
+  ASSERT(deferred_compare_ == kNone);
+  RELEASE_ASSERT(reg != R0);
+  RELEASE_ASSERT(width == kEightBytes || width == kFourBytes ||
+                 width == kUnsignedFourBytes);
+  deferred_compare_ = kCompareImm;
+  deferred_left_ = reg;
+  deferred_imm_ = imm;
+  deferred_width_ = width;
+}
+
+void Assembler::TestRegisters(Register a, Register b) {
+  ASSERT(deferred_compare_ == kNone);
+  RELEASE_ASSERT((a != R0) && (b != R0));
+  deferred_compare_ = kTestReg;
+  deferred_left_ = a;
+  deferred_reg_ = b;
+  deferred_width_ = kEightBytes;
+}
+
+void Assembler::TestImmediate(Register reg, int64_t imm, OperandSize width) {
+  ASSERT(deferred_compare_ == kNone);
+  RELEASE_ASSERT(reg != R0);
+  RELEASE_ASSERT(width == kEightBytes || width == kFourBytes ||
+                 width == kUnsignedFourBytes);
+  deferred_compare_ = kTestImm;
+  deferred_left_ = reg;
+  deferred_imm_ = imm;
+  deferred_width_ = width;
+}
+
+void Assembler::EmitDeferredCompare(Condition cond) {
+  RELEASE_ASSERT(deferred_compare_ != kNone);
+  RELEASE_ASSERT(cond != VS && cond != VC && cond != AL && cond != NV &&
+                 cond != kNoCondition && cond != kInvalidCondition);
+  const bool is64 = (deferred_width_ == kEightBytes);
+  const Register left = deferred_left_;
+  switch (deferred_compare_) {
+    case kCompareReg:
+      if (IsUnsignedCondition(cond)) {
+        cmpl(CRF0, is64, left, deferred_reg_);
+      } else {
+        cmp(CRF0, is64, left, deferred_reg_);
+      }
+      break;
+    case kCompareImm: {
+      const int64_t imm = deferred_imm_;
+      if (IsUnsignedCondition(cond)) {
+        if (IsUint16(imm)) {
+          cmpli(CRF0, is64, left, imm);
+        } else {
+          LoadImmediate(R0, imm);
+          cmpl(CRF0, is64, left, R0);
+        }
+      } else {
+        if (IsInt16(imm)) {
+          cmpi(CRF0, is64, left, imm);
+        } else {
+          LoadImmediate(R0, imm);
+          cmp(CRF0, is64, left, R0);
+        }
+      }
+      break;
+    }
+    case kTestReg:
+    case kTestImm: {
+      // Only ZERO / NOT_ZERO: a record form sets CR0 from the 64-bit result
+      // (section 7.6), so sign conditions of a 32-bit test would be wrong.
+      RELEASE_ASSERT(cond == ZERO || cond == NOT_ZERO);
+      const int64_t imm = deferred_imm_;
+      const bool imm16 = (deferred_compare_ == kTestImm) && IsUint16(imm);
+      const bool imm16_high = (deferred_compare_ == kTestImm) && !imm16 &&
+                              ((imm & 0xffff) == 0) && Utils::IsUint(32, imm);
+      if (imm16) {
+        andi_(R0, left, imm);  // result < 2^16: 32- and 64-bit tests agree
+      } else if (imm16_high) {
+        andis_(R0, left, imm >> 16);  // result < 2^32, zero-extended
+      } else {
+        Register right = deferred_reg_;
+        if (deferred_compare_ == kTestImm) {
+          LoadImmediate(R0, imm);
+          right = R0;
+        }
+        if (is64) {
+          and_rc(R0, left, right);
+        } else {
+          and_(R0, left, right);
+          cmpwi(CRF0, R0, 0);  // the low word only
+        }
+      }
+      break;
+    }
+    case kNone:
+      UNREACHABLE();
+  }
+  deferred_compare_ = kNone;
+}
+
+void Assembler::BranchIf(Condition cond, Label* label, JumpDistance distance) {
+  EmitDeferredCompare(cond);
+  BranchIfCR(ConditionBranchIfSet(cond), CRF0, ConditionCRBit(cond), label,
+             distance);
+}
+
+void Assembler::SetIf(Condition cond, Register dst) {
+  RELEASE_ASSERT(dst != R0);
+  EmitDeferredCompare(cond);
+  const uint32_t bit = CRBitIndex(CRF0, ConditionCRBit(cond));
+  if (ConditionBranchIfSet(cond)) {
+    // dst = bit ? 1 : 0
+    li(R0, 0);
+    li(dst, 1);
+    isel(dst, dst, R0, bit);
+  } else {
+    // dst = bit ? 0 : 1 (isel RA = 0 reads as zero)
+    li(dst, 1);
+    isel(dst, kNoRegister, dst, bit);
+  }
+}
+
+void Assembler::ZeroIf(Condition cond, Register dst, Register src) {
+  RELEASE_ASSERT((dst != R0) && (src != R0));
+  EmitDeferredCompare(cond);
+  const uint32_t bit = CRBitIndex(CRF0, ConditionCRBit(cond));
+  if (ConditionBranchIfSet(cond)) {
+    isel(dst, kNoRegister, src, bit);  // bit ? 0 : src
+  } else {
+    li(R0, 0);
+    isel(dst, src, R0, bit);  // bit ? src : 0
+  }
+}
+
+void Assembler::BranchIfZero(Register reg,
+                             Label* label,
+                             JumpDistance distance) {
+  CompareImmediate(reg, 0);
+  BranchIf(ZERO, label, distance);
+}
+
+void Assembler::BranchIfBit(Register reg,
+                            intptr_t bit_number,
+                            Condition cond,
+                            Label* label,
+                            JumpDistance distance) {
+  ASSERT(deferred_compare_ == kNone);
+  RELEASE_ASSERT(cond == ZERO || cond == NOT_ZERO);
+  RELEASE_ASSERT(bit_number >= 0 && bit_number < kBitsPerInt64);
+  // Rotate the bit into bit 63 (the LSB) and clear the rest: CR0[EQ] = !bit.
+  rldicl_(R0, reg, (kBitsPerInt64 - bit_number) & 63, 63);
+  BranchIfCR(cond == ZERO, CRF0, kCRBitEQ, label, distance);
+}
+
+void Assembler::BranchIfSmi(Register reg,
+                            Label* label,
+                            JumpDistance distance) {
+  ASSERT(deferred_compare_ == kNone);
+  andi_(R0, reg, kSmiTagMask);
+  BranchIfCR(true, CRF0, kCRBitEQ, label, distance);
+}
+
+void Assembler::BranchIfNotSmi(Register reg,
+                               Label* label,
+                               JumpDistance distance) {
+  ASSERT(deferred_compare_ == kNone);
+  andi_(R0, reg, kSmiTagMask);
+  BranchIfCR(false, CRF0, kCRBitEQ, label, distance);
+}
+
+// ---------------------------------------------------------------------------
+// 2d. Calls (section 4).
+// ---------------------------------------------------------------------------
+
+void Assembler::Call(const Address& target) {
+  Load(R0, target);
+  mtctr(R0);
+  bctrl();
+}
+
+void Assembler::CallRegister(Register target) {
+  mtctr(target);
+  bctrl();
+}
+
+void Assembler::JumpRegister(Register target) {
+  mtctr(target);
+  bctr();
+}
+
+void Assembler::CallCFunction(Register target) {
+  // ELFv2: the callee derives its TOC from its own address in R12 (4.2).
+  if (target != kElfV2CalleeAddressReg) {
+    mr(kElfV2CalleeAddressReg, target);
+  }
+#if defined(DEBUG)
+  // R1 must be 16-byte aligned at every call into C (3.4).
+  andi_(R0, SP, kAbiStackAlignment - 1);
+  bc(kBOTrue, CRBitIndex(CRF0, kCRBitEQ), 2 * Instr::kInstrSize);
+  trap();
+#endif
+  // The linkage area and parameter save area, with a null back chain.
+  addi(SP, SP, -kAbiCallFrameHeaderSize);
+  li(R0, 0);
+  std(R0, SP, kElfV2BackChainOffset);
+  mtctr(kElfV2CalleeAddressReg);
+  bctrl();
+  addi(SP, SP, kAbiCallFrameHeaderSize);
+}
+
+void Assembler::CallCFunction(const Address& target) {
+  Load(kElfV2CalleeAddressReg, target);
+  CallCFunction(kElfV2CalleeAddressReg);
+}
+
+void Assembler::ReserveAlignedFrameSpace(intptr_t frame_space) {
+  ASSERT(frame_space >= 0);
+  if (frame_space != 0) {
+    AddImmediate(SP, SP, -frame_space);
+  }
+  clrrdi(SP, SP, Utils::ShiftForPowerOfTwo(kAbiStackAlignment));
+}
+
+void Assembler::LoadPC(Register dst) {
+  bcl_next_instr();
+  mflr(dst);
+}
+
+// ---------------------------------------------------------------------------
+// 2e. Frames and the stack (section 3). SP moves before anything is stored
+// above it; nothing is ever stored below it (section 3.6).
+// ---------------------------------------------------------------------------
+
+void Assembler::PushRegister(Register r) {
+  ASSERT(r != SP);
+  stdu(r, SP, -target::kWordSize);
+}
+
+void Assembler::PopRegister(Register r) {
+  ASSERT(r != SP);
+  ld(r, SP, 0);
+  addi(SP, SP, target::kWordSize);
+}
+
+void Assembler::PushRegisterPair(Register r0, Register r1) {
+  ASSERT(r0 != SP && r1 != SP);
+  stdu(r1, SP, -target::kWordSize);
+  stdu(r0, SP, -target::kWordSize);
+}
+
+void Assembler::PopRegisterPair(Register r0, Register r1) {
+  ASSERT(r0 != SP && r1 != SP && r0 != r1);
+  ld(r0, SP, 0);
+  ld(r1, SP, target::kWordSize);
+  addi(SP, SP, 2 * target::kWordSize);
+}
+
+// RegisterSet::SpillSize() reaches RegisterSet::RegisterCount (locations.cc,
+// VM side); the inline Contains* predicates keep this file standalone.
+static intptr_t SpillSize(const RegisterSet& regs) {
+  intptr_t size = 0;
+  for (intptr_t i = 0; i < kNumberOfCpuRegisters; i++) {
+    if (regs.ContainsRegister(static_cast<Register>(i))) {
+      size += target::kWordSize;
+    }
+  }
+  for (intptr_t i = 0; i < kNumberOfFpuRegisters; i++) {
+    if (regs.ContainsFpuRegister(static_cast<FpuRegister>(i))) {
+      size += kFpuRegisterSize;
+    }
+  }
+  return size;
+}
+
+void Assembler::PushRegisters(const RegisterSet& regs) {
+  // The order in which the registers are pushed must match the order in
+  // which the registers are encoded in the safepoint's stack map (the same
+  // layout as on RISC-V: CPU registers ascending from 0(SP), FPU registers
+  // ascending above them).
+  const intptr_t size = SpillSize(regs);
+  if (size == 0) {
+    return;
+  }
+  AddImmediate(SP, SP, -size);
+  intptr_t offset = size;
+  for (intptr_t i = kNumberOfFpuRegisters - 1; i >= 0; i--) {
+    const FpuRegister reg = static_cast<FpuRegister>(i);
+    if (regs.ContainsFpuRegister(reg)) {
+      offset -= kFpuRegisterSize;
+      stfd(reg, SP, offset);
+    }
+  }
+  for (intptr_t i = kNumberOfCpuRegisters - 1; i >= 0; i--) {
+    const Register reg = static_cast<Register>(i);
+    if (regs.ContainsRegister(reg)) {
+      ASSERT(reg != SP);
+      offset -= target::kWordSize;
+      std(reg, SP, offset);
+    }
+  }
+  ASSERT(offset == 0);
+}
+
+void Assembler::PopRegisters(const RegisterSet& regs) {
+  const intptr_t size = SpillSize(regs);
+  if (size == 0) {
+    return;
+  }
+  intptr_t offset = 0;
+  for (intptr_t i = 0; i < kNumberOfCpuRegisters; i++) {
+    const Register reg = static_cast<Register>(i);
+    if (regs.ContainsRegister(reg)) {
+      ASSERT(reg != SP);
+      ld(reg, SP, offset);
+      offset += target::kWordSize;
+    }
+  }
+  for (intptr_t i = 0; i < kNumberOfFpuRegisters; i++) {
+    const FpuRegister reg = static_cast<FpuRegister>(i);
+    if (regs.ContainsFpuRegister(reg)) {
+      lfd(reg, SP, offset);
+      offset += kFpuRegisterSize;
+    }
+  }
+  ASSERT(offset == size);
+  AddImmediate(SP, SP, size);
+}
+
+void Assembler::PushRegistersInOrder(std::initializer_list<Register> regs) {
+  intptr_t offset = regs.size() * target::kWordSize;
+  AddImmediate(SP, SP, -offset);
+  for (Register reg : regs) {
+    ASSERT(reg != SP);
+    offset -= target::kWordSize;
+    Store(reg, Address(SP, offset));
+  }
+}
+
+void Assembler::PushLinkRegister() {
+  mflr(R0);
+  stdu(R0, SP, -target::kWordSize);
+}
+
+void Assembler::PopLinkRegister() {
+  ld(R0, SP, 0);
+  addi(SP, SP, target::kWordSize);
+  mtlr(R0);
+}
+
+void Assembler::EnterFrame(intptr_t frame_size) {
+  ASSERT(frame_size >= 0);
+  mflr(R0);
+  stdu(FP, SP, -2 * target::kWordSize);  // SP -= 16 and save FP, atomically
+  std(R0, SP, target::kWordSize);        // return address at FP + 8
+  mr(FP, SP);
+  if (frame_size != 0) {
+    AddImmediate(SP, SP, -frame_size);
+  }
+}
+
+void Assembler::LeaveFrame() {
+  mr(SP, FP);
+  ld(R0, SP, target::kWordSize);
+  ld(FP, SP, 0);
+  addi(SP, SP, 2 * target::kWordSize);
+  mtlr(R0);
+}
+
+void Assembler::EnterCFrame(intptr_t frame_space) {
+  // THR, PP, NULL_REG, WRITE_BARRIER_STATE, DISPATCH_TABLE_REG and CODE_REG
+  // are ELFv2 non-volatile: C preserves them, nothing to save here.
+  COMPILE_ASSERT(IsAbiPreservedRegister(THR));
+  COMPILE_ASSERT(IsAbiPreservedRegister(PP));
+  COMPILE_ASSERT(IsAbiPreservedRegister(NULL_REG));
+  COMPILE_ASSERT(IsAbiPreservedRegister(WRITE_BARRIER_STATE));
+  COMPILE_ASSERT(IsAbiPreservedRegister(DISPATCH_TABLE_REG));
+  EnterFrame(0);
+  ReserveAlignedFrameSpace(frame_space);
+}
+
+void Assembler::LeaveCFrame() {
+  LeaveFrame();
+}
+
+// The entry-frame save area of section 3.2: r14 at the highest address down
+// to r30, then f14 down to f31 at 0(SP) ("ascending register = descending
+// address"). SP moves once, first.
+static constexpr intptr_t kNativeCalleeSavedSize =
+    (kAbiPreservedCpuRegCount + kAbiPreservedFpuRegCount) * 8;
+COMPILE_ASSERT(kNativeCalleeSavedSize == 280);
+
+static intptr_t NativeCalleeSavedCpuOffset(intptr_t reg) {
+  return kNativeCalleeSavedSize - 8 * (reg - kAbiFirstPreservedCpuReg + 1);
+}
+
+static intptr_t NativeCalleeSavedFpuOffset(intptr_t reg) {
+  return 8 * (kAbiLastPreservedFpuReg - reg);
+}
+
+void Assembler::PushNativeCalleeSavedRegisters() {
+  addi(SP, SP, -kNativeCalleeSavedSize);
+  for (intptr_t r = kAbiFirstPreservedCpuReg; r <= kAbiLastPreservedCpuReg;
+       r++) {
+    std(static_cast<Register>(r), SP, NativeCalleeSavedCpuOffset(r));
+  }
+  for (intptr_t f = kAbiFirstPreservedFpuReg; f <= kAbiLastPreservedFpuReg;
+       f++) {
+    stfd(static_cast<FpuRegister>(f), SP, NativeCalleeSavedFpuOffset(f));
+  }
+}
+
+void Assembler::PopNativeCalleeSavedRegisters() {
+  for (intptr_t f = kAbiFirstPreservedFpuReg; f <= kAbiLastPreservedFpuReg;
+       f++) {
+    lfd(static_cast<FpuRegister>(f), SP, NativeCalleeSavedFpuOffset(f));
+  }
+  for (intptr_t r = kAbiFirstPreservedCpuReg; r <= kAbiLastPreservedCpuReg;
+       r++) {
+    ld(static_cast<Register>(r), SP, NativeCalleeSavedCpuOffset(r));
+  }
+  addi(SP, SP, kNativeCalleeSavedSize);
+}
+
+void Assembler::CheckFpSpDist(intptr_t fp_sp_dist) {
+  ASSERT(fp_sp_dist <= 0);
+#if defined(DEBUG)
+  Label ok;
+  subf(TMP, FP, SP);  // TMP = SP - FP
+  CompareImmediate(TMP, fp_sp_dist);
+  BranchIf(EQUAL, &ok, kNearJump);
+  trap();
+  Bind(&ok);
+#endif
+}
+
+void Assembler::MoveRegister(Register dst, Register src) {
+  // Never "or rx,rx,rx": an SMT priority hint, not a move (section 11.4).
+  if (dst != src) {
+    mr(dst, src);
+  }
+}

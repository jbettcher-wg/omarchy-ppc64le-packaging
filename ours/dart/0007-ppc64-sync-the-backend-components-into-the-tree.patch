+static inline Register ConcreteRegister(Register r) {
+  return r;
+}
+
+// Architecture-independent condition names. On PPC64 a Condition does not by
+// itself select an instruction: the compare that feeds it must be signed
+// (cmpd/cmpw) or logical (cmpld/cmplw) according to IsUnsignedCondition, and
+// the branch then tests the CR bit given by ConditionCRBit with the sense
+// given by ConditionBranchIfSet. The macro-assembler therefore defers the
+// compare until the condition is known (ABI-SPEC section 7.4), as RISC-V does.
+enum Condition {
+  kNoCondition = -1,
+  EQ = 0,   // equal
+  NE = 1,   // not equal
+  CS = 2,   // unsigned higher or same
+  CC = 3,   // unsigned lower
+  MI = 4,   // minus/negative
+  PL = 5,   // plus/positive or zero
+  VS = 6,   // overflow: NOT SUPPORTED as a branch condition (ABI-SPEC section 7.5)
+  VC = 7,   // no overflow: NOT SUPPORTED as a branch condition
+  HI = 8,   // unsigned higher
+  LS = 9,   // unsigned lower or same
+  GE = 10,  // signed greater than or equal
+  LT = 11,  // signed less than
+  GT = 12,  // signed greater than
+  LE = 13,  // signed less than or equal
+  AL = 14,  // always (unconditional)
+  NV = 15,  // never
+  kNumberOfConditions = 16,
+
+  // Platform-independent variants declared for all platforms
+  EQUAL = EQ,
+  ZERO = EQUAL,
+  NOT_EQUAL = NE,
+  NOT_ZERO = NOT_EQUAL,
+  LESS = LT,
+  LESS_EQUAL = LE,
+  GREATER_EQUAL = GE,
+  GREATER = GT,
+  UNSIGNED_LESS = CC,
+  UNSIGNED_LESS_EQUAL = LS,
+  UNSIGNED_GREATER = HI,
+  UNSIGNED_GREATER_EQUAL = CS,
+  OVERFLOW = VS,
+  NO_OVERFLOW = VC,
+
+  kInvalidCondition = 16
+};
+
+static inline Condition InvertCondition(Condition c) {
+  COMPILE_ASSERT((EQ ^ NE) == 1);
+  COMPILE_ASSERT((CS ^ CC) == 1);
+  COMPILE_ASSERT((MI ^ PL) == 1);
+  COMPILE_ASSERT((VS ^ VC) == 1);
+  COMPILE_ASSERT((HI ^ LS) == 1);
+  COMPILE_ASSERT((GE ^ LT) == 1);
+  COMPILE_ASSERT((GT ^ LE) == 1);
+  COMPILE_ASSERT((AL ^ NV) == 1);
+  ASSERT(c != AL);
+  ASSERT(c != kInvalidCondition);
+  return static_cast<Condition>(c ^ 1);
+}
+
+// True if the compare feeding |c| must be a logical compare (cmpld/cmplw).
+constexpr bool IsUnsignedCondition(Condition c) {
+  return (c == CS) || (c == CC) || (c == HI) || (c == LS);
+}
+
+// The CR bit a branch on |c| tests, after the appropriate compare.
+constexpr CRBit ConditionCRBit(Condition c) {
+  return ((c == EQ) || (c == NE))
+             ? kCRBitEQ
+             : ((c == GT) || (c == LE) || (c == HI) || (c == LS))
+                   ? kCRBitGT
+                   : kCRBitLT;  // LT, GE, CC, CS, MI, PL
+}
+
+// True if a branch on |c| is taken when ConditionCRBit(c) is 1.
+constexpr bool ConditionBranchIfSet(Condition c) {
+  return (c == EQ) || (c == LT) || (c == GT) || (c == CC) || (c == HI) ||
+         (c == MI);
+}
+
+enum ScaleFactor {
+  TIMES_1 = 0,
+  TIMES_2 = 1,
+  TIMES_4 = 2,
+  TIMES_8 = 3,
+  TIMES_16 = 4,
+  // We can't include vm/compiler/runtime_api.h, so just be explicit instead
+  // of using (dart::)kWordSizeLog2.
+  // Used for Smi-boxed indices.
+  TIMES_HALF_WORD_SIZE = kInt64SizeLog2 - 1,
+  // Used for unboxed indices.
+  TIMES_WORD_SIZE = kInt64SizeLog2,
+#if !defined(DART_COMPRESSED_POINTERS)
+  TIMES_COMPRESSED_WORD_SIZE = TIMES_WORD_SIZE,
+#else
+#error Compressed pointers are not supported on PPC64 (ABI-SPEC section 10).
+#endif
+  // Used for Smi-boxed indices.
+  TIMES_COMPRESSED_HALF_WORD_SIZE = TIMES_COMPRESSED_WORD_SIZE - 1,
+};

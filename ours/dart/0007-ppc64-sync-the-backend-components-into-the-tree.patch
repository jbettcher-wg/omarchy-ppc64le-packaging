+
+void Assembler::ExtractClassIdFromTags(Register result, Register tags) {
+  ASSERT(target::UntaggedObject::kClassIdTagPos == 12);
+  ASSERT(target::UntaggedObject::kClassIdTagSize == 20);
+  // (tags >> pos) & ((1 << size) - 1), zero-extended.
+  rldicl(result, tags, 64 - target::UntaggedObject::kClassIdTagPos,
+         64 - target::UntaggedObject::kClassIdTagSize);
+}
+
+void Assembler::ExtractInstanceSizeFromTags(Register result, Register tags) {
+  ASSERT(target::UntaggedObject::kSizeTagPos == 8);
+  ASSERT(target::UntaggedObject::kSizeTagSize == 4);
+  rldicl(result, tags, 64 - target::UntaggedObject::kSizeTagPos,
+         64 - target::UntaggedObject::kSizeTagSize);
+  sldi(result, result, target::ObjectAlignment::kObjectAlignmentLog2);
+}
+
+void Assembler::LoadClassId(Register result, Register object) {
+  // The class id is bits 12..31 of the header, all in its low-order word,
+  // which on little-endian is the word at the header's own address.
+  ASSERT(target::UntaggedObject::kClassIdTagPos +
+             target::UntaggedObject::kClassIdTagSize ==
+         32);
+  Load(result, FieldAddress(object, target::Object::tags_offset()),
+       kUnsignedFourBytes);
+  ExtractClassIdFromTags(result, result);
+}
+
+void Assembler::LoadClassById(Register result, Register class_id) {
+  ASSERT(result != class_id);
+  RELEASE_ASSERT((result != R0) && (class_id != R0));
+  const intptr_t table_offset =
+      target::IsolateGroup::cached_class_table_table_offset();
+  LoadIsolateGroup(result);
+  Load(result, Address(result, table_offset));
+  sldi(R0, class_id, target::kWordSizeLog2);
+  Load(result, Address(result, R0));
+}
+
+void Assembler::CompareClassId(Register object,
+                               intptr_t class_id,
+                               Register scratch) {
+  const Register cid = (scratch == kNoRegister) ? TMP : scratch;
+  LoadClassId(cid, object);
+  CompareImmediate(cid, class_id);
+}
+
+void Assembler::LoadClassIdMayBeSmi(Register result, Register object) {
+  ASSERT(result != object);
+  Label done;
+  LoadImmediate(result, kSmiCid);
+  BranchIfSmi(object, &done, kNearJump);
+  LoadClassId(result, object);
+  Bind(&done);
+}
+
+void Assembler::LoadTaggedClassIdMayBeSmi(Register result, Register object) {
+  if (result == object) {
+    LoadClassIdMayBeSmi(TMP, object);
+    SmiTag(result, TMP);
+  } else {
+    LoadClassIdMayBeSmi(result, object);
+    SmiTag(result);
+  }
+}
+
+void Assembler::EnsureHasClassIdInDEBUG(intptr_t cid,
+                                        Register src,
+                                        Register scratch,
+                                        bool can_be_null) {
+#if defined(DEBUG)
+  Comment("Check that object in register has cid %" Pd "", cid);
+  Label matches;
+  LoadClassIdMayBeSmi(scratch, src);
+  CompareImmediate(scratch, cid);
+  BranchIf(EQUAL, &matches, kNearJump);
+  if (can_be_null) {
+    CompareImmediate(scratch, kNullCid);
+    BranchIf(EQUAL, &matches, kNearJump);
+  }
+  Breakpoint();
+  Bind(&matches);
+#endif
+}
+
+void Assembler::RangeCheck(Register value,
+                           Register temp,
+                           intptr_t low,
+                           intptr_t high,
+                           RangeCheckCondition condition,
+                           Label* target) {
+  // value - low, compared unsigned with high - low.
+  const Condition cc =
+      (condition == kIfInRange) ? UNSIGNED_LESS_EQUAL : UNSIGNED_GREATER;
+  const Register to_check = (temp != kNoRegister) ? temp : value;
+  AddImmediate(to_check, value, -low);
+  CompareImmediate(to_check, high - low);
+  BranchIf(cc, target);
+}
+
+void Assembler::LoadInt32FromBoxOrSmi(Register result, Register value) {
+  if (result == value) {
+    ASSERT(TMP != value);
+    MoveRegister(TMP, value);
+    value = TMP;
+  }
+  ASSERT(value != result);
+  Label done;
+  // Smi: bits 1..32 of the tagged value, sign-extended (ABI-SPEC 7.6).
+  sradi(result, value, kSmiTagSize);
+  extsw(result, result);
+  BranchIfSmi(value, &done, kNearJump);
+  // Mint: the low word of the value, sign-extended (lwa).
+  Load(result, FieldAddress(value, target::Mint::value_offset()), kFourBytes);
+  Bind(&done);
+}
+
+void Assembler::LoadInt64FromBoxOrSmi(Register result, Register value) {
+  if (result == value) {
+    ASSERT(TMP != value);
+    MoveRegister(TMP, value);
+    value = TMP;
+  }
+  ASSERT(value != result);
+  Label done;
+  SmiUntag(result, value);
+  BranchIfSmi(value, &done, kNearJump);
+  Load(result, FieldAddress(value, target::Mint::value_offset()));
+  Bind(&done);
+}
+
+// dst = base + (index << scale) for a non-negative |shift|; for -1 (a Smi
+// index of byte-sized elements), base + (index >> 1). R0 holds the scaled
+// index, so every aliasing of dst, base and index is allowed.
+static void AddScaledIndex(Assembler* a,
+                           Register dst,
+                           Register base,
+                           Register index,
+                           intptr_t shift) {
+  RELEASE_ASSERT((base != R0) && (index != R0));
+  if (shift == 0) {
+    a->add(dst, base, index);
+  } else if (shift < 0) {
+    RELEASE_ASSERT(shift == -1);
+    a->sradi(R0, index, 1);
+    a->add(dst, base, R0);
+  } else {
+    a->sldi(R0, index, shift);
+    a->add(dst, base, R0);
+  }
+}
+
+void Assembler::LoadIndexedPayload(Register dst,
+                                   Register base,
+                                   int32_t payload_offset,
+                                   Register index,
+                                   ScaleFactor scale,
+                                   OperandSize sz) {
+  RELEASE_ASSERT(dst != R0);  // the base of the load below
+  AddScaledIndex(this, dst, base, index, scale);
+  Load(dst, Address(dst, payload_offset - kHeapObjectTag), sz);
+}
+
+void Assembler::LoadFieldAddressForRegOffset(Register address,
+                                             Register instance,
+                                             Register offset_in_words_as_smi) {
+  RELEASE_ASSERT(address != R0);
+  AddScaledIndex(this, address, instance, offset_in_words_as_smi,
+                 target::kWordSizeLog2 - kSmiTagShift);
+  AddImmediate(address, address, -kHeapObjectTag);
+}
+
+void Assembler::AddScaled(Register dst,
+                          Register base,
+                          Register index,
+                          ScaleFactor scale,
+                          int32_t disp) {
+  RELEASE_ASSERT(dst != R0);  // the base of the AddImmediate below
+  if (base == kNoRegister) {
+    if (scale == TIMES_1) {
+      AddImmediate(dst, index, disp);
+      return;
+    }
+    sldi(dst, index, scale);
+  } else {
+    AddScaledIndex(this, dst, base, index, scale);
+  }
+  AddImmediate(dst, dst, disp);
+}
+
+void Assembler::LoadStaticFieldAddress(Register address,
+                                       Register field,
+                                       Register scratch,
+                                       bool is_shared) {
+  RELEASE_ASSERT((address != R0) && (scratch != R0) && (address != scratch));
+  LoadFieldFromOffset(scratch, field,
+                      target::Field::host_offset_or_field_id_offset());
+  const intptr_t field_table_offset =
+      is_shared ? compiler::target::Thread::shared_field_table_values_offset()
+                : compiler::target::Thread::field_table_values_offset();
+  Load(address, Address(THR, static_cast<int32_t>(field_table_offset)));
+  AddScaledIndex(this, address, address, scratch,
+                 target::kWordSizeLog2 - kSmiTagShift);
+}
+
+bool Assembler::AddressCanHoldConstantIndex(const Object& constant,
+                                            bool is_external,
+                                            intptr_t cid,
+                                            intptr_t index_scale) {
+  // An Address holds any int32 displacement: Load/Store pick the form
+  // (ABI-SPEC 5.2).
+  if (!IsSafeSmi(constant)) return false;
+  const int64_t index = target::SmiValue(constant);
+  if (!Utils::IsInt(32, index)) return false;
+  const int64_t offset = index * index_scale + HeapDataOffset(is_external, cid);
+  return Utils::IsInt(32, offset);
+}
+
+Address Assembler::ElementAddressForIntIndex(bool is_external,
+                                             intptr_t cid,
+                                             intptr_t index_scale,
+                                             Register array,
+                                             intptr_t index) const {
+  const int64_t offset = index * index_scale + HeapDataOffset(is_external, cid);
+  RELEASE_ASSERT(Utils::IsInt(32, offset));
+  return Address(array, static_cast<int32_t>(offset));
+}
+
+void Assembler::ComputeElementAddressForIntIndex(Register address,
+                                                 bool is_external,
+                                                 intptr_t cid,
+                                                 intptr_t index_scale,
+                                                 Register array,
+                                                 intptr_t index) {
+  const int64_t offset = index * index_scale + HeapDataOffset(is_external, cid);
+  AddImmediate(address, array, offset);
+}
+
+Address Assembler::ElementAddressForRegIndex(bool is_external,
+                                             intptr_t cid,
+                                             intptr_t index_scale,
+                                             bool index_unboxed,
+                                             Register array,
+                                             Register index,
+                                             Register temp) {
+  // If unboxed, index is expected smi-tagged, (i.e, LSL 1) for all arrays.
+  const intptr_t boxing_shift = index_unboxed ? 0 : -kSmiTagShift;
+  const intptr_t shift = Utils::ShiftForPowerOfTwo(index_scale) + boxing_shift;
+  const int32_t offset = HeapDataOffset(is_external, cid);
+  ASSERT(array != temp);
+  ASSERT(index != temp);
+  if ((offset == 0) && (shift == 0)) {
+    return Address(array, index);
+  }
+  RELEASE_ASSERT((temp != kNoRegister) && (temp != R0));
+  AddScaledIndex(this, temp, array, index, shift);
+  return Address(temp, offset);
+}
+
+void Assembler::ComputeElementAddressForRegIndex(Register address,
+                                                 bool is_external,
+                                                 intptr_t cid,
+                                                 intptr_t index_scale,
+                                                 bool index_unboxed,
+                                                 Register array,
+                                                 Register index) {
+  // If unboxed, index is expected smi-tagged, (i.e, LSL 1) for all arrays.
+  const intptr_t boxing_shift = index_unboxed ? 0 : -kSmiTagShift;
+  const intptr_t shift = Utils::ShiftForPowerOfTwo(index_scale) + boxing_shift;
+  const int32_t offset = HeapDataOffset(is_external, cid);
+  RELEASE_ASSERT(address != R0);
+  AddScaledIndex(this, address, array, index, shift);
+  if (offset != 0) {
+    AddImmediate(address, address, offset);
+  }
+}
+
+void Assembler::MaybeTraceAllocation(intptr_t cid,
+                                     Label* trace,
+                                     Register temp_reg,
+                                     JumpDistance distance) {
+#if !defined(PRODUCT)
+  ASSERT(cid > 0);
+  LoadIsolateGroup(temp_reg);
+  Load(temp_reg,
+       Address(temp_reg, target::IsolateGroup::class_table_offset()));
+  Load(temp_reg,
+       Address(temp_reg,
+               target::ClassTable::allocation_tracing_state_table_offset()));
+  Load(temp_reg,
+       Address(temp_reg,
+               target::ClassTable::AllocationTracingStateSlotOffsetFor(cid)),
+       kUnsignedByte);
+  CompareImmediate(temp_reg, 0);
+  BranchIf(NOT_ZERO, trace, distance);
+#endif  // !defined(PRODUCT)
+}
+
+void Assembler::MaybeTraceAllocation(Register cid,
+                                     Label* trace,
+                                     Register temp_reg,
+                                     JumpDistance distance) {
+#if !defined(PRODUCT)
+  ASSERT(temp_reg != cid);
+  LoadIsolateGroup(temp_reg);
+  Load(temp_reg,
+       Address(temp_reg, target::IsolateGroup::class_table_offset()));
+  Load(temp_reg,
+       Address(temp_reg,
+               target::ClassTable::allocation_tracing_state_table_offset()));
+  AddRegisters(temp_reg, cid);
+  Load(temp_reg,
+       Address(temp_reg,
+               target::ClassTable::AllocationTracingStateSlotOffsetFor(0)),
+       kUnsignedByte);
+  CompareImmediate(temp_reg, 0);
+  BranchIf(NOT_ZERO, trace, distance);
+#endif  // !defined(PRODUCT)
+}
+
+void Assembler::TryAllocateObject(intptr_t cid,
+                                  intptr_t instance_size,
+                                  Label* failure,
+                                  JumpDistance distance,
+                                  Register instance_reg,
+                                  Register temp_reg) {
+  ASSERT(failure != nullptr);
+  ASSERT(instance_size != 0);
+  ASSERT(instance_reg != temp_reg);
+  ASSERT(temp_reg != kNoRegister);
+  ASSERT(Utils::IsAligned(instance_size,
+                          target::ObjectAlignment::kObjectAlignment));
+  RELEASE_ASSERT((instance_reg != R0) && (temp_reg != R0));
+  if (FLAG_inline_alloc &&
+      target::Heap::IsAllocatableInNewSpace(instance_size)) {
+    // If this allocation is traced, program will jump to failure path
+    // (i.e. the allocation stub) which will allocate the object and trace the
+    // allocation call site.
+    NOT_IN_PRODUCT(MaybeTraceAllocation(cid, failure, temp_reg));
+    Load(instance_reg, Address(THR, target::Thread::top_offset()));
+    Load(temp_reg, Address(THR, target::Thread::end_offset()));
+    // instance_reg: potential next object start.
+    AddImmediate(instance_reg, instance_reg, instance_size);
+    // Fail if heap end unsigned less than or equal to new heap top.
+    CompareRegisters(temp_reg, instance_reg);
+    BranchIf(UNSIGNED_LESS_EQUAL, failure, distance);
+    CheckAllocationCanary(instance_reg, temp_reg);
+
+    // Successfully allocated the object, now update top to point to
+    // next object start and store the class in the class field of object.
+    Store(instance_reg, Address(THR, target::Thread::top_offset()));
+    // Move instance_reg back to the start of the object and tag it.
+    AddImmediate(instance_reg, instance_reg, -instance_size + kHeapObjectTag);
+
+    const uword tags = target::MakeTagWordForNewSpaceObject(cid, instance_size);
+    LoadImmediate(temp_reg, tags);
+    InitializeHeader(temp_reg, instance_reg);
+  } else {
+    Jump(failure, distance);
+  }
+}
+
+void Assembler::TryAllocateArray(intptr_t cid,
+                                 intptr_t instance_size,
+                                 Label* failure,
+                                 Register instance,
+                                 Register end_address,
+                                 Register temp1,
+                                 Register temp2) {
+  RELEASE_ASSERT((instance != R0) && (end_address != R0) && (temp2 != R0));
+  if (FLAG_inline_alloc &&
+      target::Heap::IsAllocatableInNewSpace(instance_size)) {
+    // If this allocation is traced, program will jump to failure path
+    // (i.e. the allocation stub) which will allocate the object and trace the
+    // allocation call site.
+    NOT_IN_PRODUCT(MaybeTraceAllocation(cid, failure, temp1));
+    // Potential new object start.
+    Load(instance, Address(THR, target::Thread::top_offset()));
+    AddImmediate(end_address, instance, instance_size);
+    // Fail on unsigned overflow (instance_size > 0, so end < start).
+    CompareRegisters(end_address, instance);
+    BranchIf(UNSIGNED_LESS, failure);
+
+    // Check if the allocation fits into the remaining space.
+    // instance: potential new object start.
+    // end_address: potential next object start.
+    Load(temp2, Address(THR, target::Thread::end_offset()));
+    CompareRegisters(end_address, temp2);
+    BranchIf(UNSIGNED_GREATER_EQUAL, failure);
+    CheckAllocationCanary(instance, temp2);
+
+    // Successfully allocated the object(s), now update top to point to
+    // next object start and initialize the object.
+    Store(end_address, Address(THR, target::Thread::top_offset()));
+    AddImmediate(instance, instance, kHeapObjectTag);
+
+    // Initialize the tags.
+    // instance: new object start as a tagged pointer.
+    const uword tags = target::MakeTagWordForNewSpaceObject(cid, instance_size);
+    LoadImmediate(temp2, tags);
+    InitializeHeader(temp2, instance);
+  } else {
+    Jump(failure);
+  }
+}
+
+void Assembler::CheckAllocationCanary(Register top, Register tmp) {
+#if defined(DEBUG)
+  Label okay;
+  Load(tmp, Address(top, 0));
+  CompareImmediate(tmp, kAllocationCanary);
+  BranchIf(EQUAL, &okay, kNearJump);
+  Stop("Allocation canary");
+  Bind(&okay);
+#endif
+}
+
+void Assembler::WriteAllocationCanary(Register top) {
+#if defined(DEBUG)
+  ASSERT(top != TMP);
+  LoadImmediate(TMP, kAllocationCanary);
+  Store(TMP, Address(top, 0));
+#endif
+}
+
+void Assembler::CopyMemoryWords(Register src,
+                                Register dst,
+                                Register size,
+                                Register temp) {
+  RELEASE_ASSERT((src != R0) && (dst != R0) && (size != R0) && (temp != R0));
+  Label loop, done;
+  cmpdi(CRF0, size, 0);
+  BranchIfCR(true, CRF0, kCRBitEQ, &done, kNearJump);
+  Bind(&loop);
+  ld(temp, src, 0);
+  std(temp, dst, 0);
+  addi(src, src, target::kWordSize);
+  addi(dst, dst, target::kWordSize);
+  addi(size, size, -target::kWordSize);
+  cmpdi(CRF0, size, 0);
+  BranchIfCR(false, CRF0, kCRBitEQ, &loop, kNearJump);
+  Bind(&done);
+}
+
+void Assembler::CompareWords(Register reg1,
+                             Register reg2,
+                             intptr_t offset,
+                             Register count,
+                             Register temp,
+                             Label* equals) {
+  RELEASE_ASSERT((reg1 != R0) && (reg2 != R0) && (count != R0) &&
+                 (temp != R0) && (temp != TMP));
+  Label loop;
+  AddImmediate(reg1, reg1, offset - kHeapObjectTag);
+  AddImmediate(reg2, reg2, offset - kHeapObjectTag);
+
+  COMPILE_ASSERT(target::kWordSize == 8);
+  Bind(&loop);
+  cmpdi(CRF0, count, 0);
+  BranchIfCR(true, CRF0, kCRBitEQ, equals);
+  addi(count, count, -1);
+  ld(temp, reg1, 0);
+  ld(TMP, reg2, 0);
+  addi(reg1, reg1, target::kWordSize);
+  addi(reg2, reg2, target::kWordSize);
+  cmpd(CRF0, temp, TMP);
+  BranchIfCR(true, CRF0, kCRBitEQ, &loop, kNearJump);
+}
+
+static const RegisterSet kRuntimeCallSavedRegisters(kDartVolatileCpuRegs,
+                                                    kDartVolatileFpuRegs);
+
+#define __ assembler_->
+
+LeafRuntimeScope::LeafRuntimeScope(Assembler* assembler,
+                                   intptr_t frame_size,
+                                   bool preserve_registers)
+    : assembler_(assembler), preserve_registers_(preserve_registers) {
+  // Saves LR and FP; clobbers R0 only, so r3-r10 still hold the arguments a
+  // caller may have set up before the scope.
+  __ EnterFrame(0);
+
+  if (preserve_registers) {
+    __ PushRegisters(kRuntimeCallSavedRegisters);
+  } else {
+    // ELFv2 non-volatile: the C callee preserves them.
+    COMPILE_ASSERT(IsAbiPreservedRegister(THR));
+    COMPILE_ASSERT(IsAbiPreservedRegister(PP));
+    COMPILE_ASSERT(IsAbiPreservedRegister(CODE_REG));
+    COMPILE_ASSERT(IsAbiPreservedRegister(NULL_REG));
+    COMPILE_ASSERT(IsAbiPreservedRegister(WRITE_BARRIER_STATE));
+    COMPILE_ASSERT(IsAbiPreservedRegister(DISPATCH_TABLE_REG));
+  }
+
+  __ ReserveAlignedFrameSpace(frame_size);
+}
+
+void LeafRuntimeScope::Call(const RuntimeEntry& entry,
+                            intptr_t argument_count) {
+  ASSERT(argument_count == entry.argument_count());
+  // The target goes through TMP, not TMP2: CallCFunction moves it into r12,
+  // and "mr r12,r12" would be an SMT hint (ABI-SPEC 11.4).
+  __ Load(TMP, compiler::Address(THR, entry.OffsetFromThread()));
+  __ Store(TMP, compiler::Address(THR, target::Thread::vm_tag_offset()));
+  __ Comment("Leaf runtime call: %s", entry.name());
+  __ CallCFunction(TMP);
+  __ LoadImmediate(TMP, VMTag::kDartTagId);
+  __ Store(TMP, compiler::Address(THR, target::Thread::vm_tag_offset()));
+}
+
+LeafRuntimeScope::~LeafRuntimeScope() {
+  if (preserve_registers_) {
+    // SP might have been modified to reserve space for arguments
+    // and ensure proper alignment of the stack frame.
+    // We need to restore it before restoring registers.
+    __ AddImmediate(SP, FP, -kRuntimeCallSavedRegisters.SpillSize());
+    __ PopRegisters(kRuntimeCallSavedRegisters);
+  }
+  __ LeaveFrame();  // restores LR
+}

+// Input parameters:
+//   R5: smi-tagged argument count, may be zero.
+//   FP[target::frame_layout.param_end_from_fp + 1]: last argument.
+static void PushArrayOfArguments(Assembler* assembler) {
+  COMPILE_ASSERT(AllocateArrayABI::kLengthReg == R5);
+  COMPILE_ASSERT(AllocateArrayABI::kTypeArgumentsReg == R4);
+  COMPILE_ASSERT(AllocateArrayABI::kResultReg == R3);
+
+  // Allocate array to store arguments of caller.
+  __ LoadObject(R4, NullObject());
+  // R4: null element type for raw Array.
+  // R5: smi-tagged argument count, may be zero.
+  __ BranchLink(StubCodeAllocateArray());
+  // R3: newly allocated array.
+  // R5: smi-tagged argument count, may be zero (was preserved by the stub).
+  __ PushRegister(R3);  // Array is in R3 and on top of stack.
+  __ SmiUntag(R5);
+  __ sldi(TMP, R5, target::kWordSizeLog2);
+  __ add(R4, FP, TMP);
+  __ AddImmediate(R4, R4,
+                  target::frame_layout.param_end_from_fp * target::kWordSize);
+  __ AddImmediate(R6, R3, target::Array::data_offset() - kHeapObjectTag);
+  // R4: address of first argument on stack.
+  // R6: address of first argument in array.
+
+  Label loop, loop_exit;
+  __ Bind(&loop);
+  __ CompareImmediate(R5, 0);
+  __ BranchIf(LESS_EQUAL, &loop_exit);
+  __ LoadFromOffset(R10, R4, 0);
+  __ AddImmediate(R4, R4, -target::kWordSize);
+  __ AddImmediate(R6, R6, target::kCompressedWordSize);
+  __ AddImmediate(R5, R5, -1);
+  __ StoreCompressedIntoObject(R3, Address(R6, -target::kCompressedWordSize),
+                               R10);
+  __ Jump(&loop);
+  __ Bind(&loop_exit);
+}
+
+// Used by eager and lazy deoptimization. Preserve result in R3 if necessary.
+// This stub translates optimized frame into unoptimized frame. The optimized
+// frame can contain values in registers and on stack, the unoptimized
+// frame contains all values on stack.
+// Deoptimization occurs in following steps:
+// - Push all registers that can contain values.
+// - Call C routine to copy the stack and saved registers into temporary buffer.
+// - Adjust caller's frame to correct unoptimized frame size.
+// - Fill the unoptimized frame.
+// - Materialize objects that require allocation (e.g. Double instances).
+// GC can occur only after frame is fully rewritten.
+// Stack after EnterStubFrame() below:
+//   +------------------+
+//   | Saved PP         | <- TOS
+//   +------------------+
+//   | PC marker        |
+//   +------------------+
+//   | Saved FP         | <- FP of stub
+//   +------------------+
+//   | return-address   |  (deoptimization point)
+//   +------------------+
+//   | Saved CODE_REG   |
+//   +------------------+
+//   | ...              | <- SP of optimized frame
+//
+// Parts of the code cannot GC, part of the code can GC.
+//
+// S-9. The register block is what DeoptContext indexes by register number:
+// kNumberOfFpuRegisters doubles at the lowest addresses, then
+// kNumberOfCpuRegisters words, lowest register number at the lowest address.
+// The slots of R2 and R13 hold a zero placeholder: those registers are never
+// read or written by generated code and are never restored from the block.
+static void GenerateDeoptimizationSequence(Assembler* assembler,
+                                           DeoptStubKind kind) {
+  // DeoptimizeCopyFrame expects a Dart frame, i.e. EnterDartFrame(0), but there
+  // is no need to set the correct PC marker or load PP, since they get patched.
+  __ EnterStubFrame();
+
+  // The code in this frame may not cause GC. kDeoptimizeCopyFrameRuntimeEntry
+  // and kDeoptimizeFillFrameRuntimeEntry are leaf runtime calls.
+  const intptr_t saved_result_slot_from_fp =
+      target::frame_layout.first_local_from_fp + 1 -
+      (kNumberOfCpuRegisters - R3);
+  const intptr_t saved_exception_slot_from_fp =
+      target::frame_layout.first_local_from_fp + 1 -
+      (kNumberOfCpuRegisters - R3);
+  const intptr_t saved_stacktrace_slot_from_fp =
+      target::frame_layout.first_local_from_fp + 1 -
+      (kNumberOfCpuRegisters - R4);
+  // Result in R3 is preserved as part of saving all registers below.
+
+  // Save registers in their enumeration order: lowest register number at
+  // lowest address. SP moves first, so nothing is ever stored below it.
+  const intptr_t kCpuBlockSize = kNumberOfCpuRegisters * target::kWordSize;
+  __ AddImmediate(SP, SP, -kCpuBlockSize);
+  for (intptr_t i = 0; i < kNumberOfCpuRegisters; i++) {
+    const Register r = static_cast<Register>(i);
+    const intptr_t offset = i * target::kWordSize;
+    if ((r == CODE_REG) || (r == SP)) {
+      // Filled in below, once TMP's own slot has been written.
+    } else if ((r == R2) || (r == R13)) {
+      // Placeholder: these registers are never read and never restored.
+      __ StoreZero(Address(SP, offset));
+    } else {
+      // R0, TMP and TMP2 never hold a Dart value but are stored like the rest.
+      __ StoreToOffset(r, SP, offset);
+    }
+  }
+  // Save the original value of CODE_REG pushed before invoking this stub
+  // instead of the value used to call this stub.
+  __ LoadFromOffset(TMP, FP, 2 * target::kWordSize);
+  __ StoreToOffset(TMP, SP, CODE_REG * target::kWordSize);
+  // The value SP had before the block was allocated.
+  __ AddImmediate(TMP, SP, kCpuBlockSize);
+  __ StoreToOffset(TMP, SP, SP * target::kWordSize);
+
+  const intptr_t kFpuBlockSize = kNumberOfFpuRegisters * kFpuRegisterSize;
+  __ AddImmediate(SP, SP, -kFpuBlockSize);
+  for (intptr_t i = 0; i < kNumberOfFpuRegisters; i++) {
+    __ StoreDToOffset(static_cast<FpuRegister>(i), SP, i * kFpuRegisterSize);
+  }
+
+  {
+    __ MoveRegister(R3, SP);  // Pass address of saved registers block.
+    LeafRuntimeScope rt(assembler,
+                        /*frame_size=*/0,
+                        /*preserve_registers=*/false);
+    bool is_lazy =
+        (kind == kLazyDeoptFromReturn) || (kind == kLazyDeoptFromThrow);
+    __ LoadImmediate(R4, is_lazy ? 1 : 0);
+    rt.Call(kDeoptimizeCopyFrameRuntimeEntry, 2);
+    // Result (R3) is stack-size (FP - SP) in bytes.
+  }
+
+  if (kind == kLazyDeoptFromReturn) {
+    // Restore result into R4 temporarily.
+    __ LoadFromOffset(R4, FP, saved_result_slot_from_fp * target::kWordSize);
+  } else if (kind == kLazyDeoptFromThrow) {
+    // Restore result into R4 temporarily.
+    __ LoadFromOffset(R4, FP, saved_exception_slot_from_fp * target::kWordSize);
+    __ LoadFromOffset(R5, FP,
+                      saved_stacktrace_slot_from_fp * target::kWordSize);
+  }
+
+  // There is a Dart Frame on the stack. We must restore PP and leave frame.
+  __ RestoreCodePointer();
+  __ LeaveStubFrame();
+  __ subf(SP, R3, FP);  // SP = FP - R3.
+
+  // DeoptimizeFillFrame expects a Dart frame, i.e. EnterDartFrame(0), but there
+  // is no need to set the correct PC marker or load PP, since they get patched.
+  __ EnterStubFrame();
+
+  if (kind == kLazyDeoptFromReturn) {
+    __ PushRegister(R4);  // Preserve result as first local.
+  } else if (kind == kLazyDeoptFromThrow) {
+    __ PushRegister(R4);  // Preserve exception as first local.
+    __ PushRegister(R5);  // Preserve stacktrace as second local.
+  }
+  {
+    __ MoveRegister(R3, FP);  // Pass last FP as parameter in R3.
+    LeafRuntimeScope rt(assembler,
+                        /*frame_size=*/0,
+                        /*preserve_registers=*/false);
+    rt.Call(kDeoptimizeFillFrameRuntimeEntry, 1);
+  }
+  if (kind == kLazyDeoptFromReturn) {
+    // Restore result into R4.
+    __ LoadFromOffset(
+        R4, FP, target::frame_layout.first_local_from_fp * target::kWordSize);
+  } else if (kind == kLazyDeoptFromThrow) {
+    // Restore result into R4.
+    __ LoadFromOffset(
+        R4, FP, target::frame_layout.first_local_from_fp * target::kWordSize);
+    __ LoadFromOffset(
+        R5, FP,
+        (target::frame_layout.first_local_from_fp - 1) * target::kWordSize);
+  }
+  // Code above cannot cause GC.
+  // There is a Dart Frame on the stack. We must restore PP and leave frame.
+  __ RestoreCodePointer();
+  __ LeaveStubFrame();
+
+  // Frame is fully rewritten at this point and it is safe to perform a GC.
+  // Materialize any objects that were deferred by FillFrame because they
+  // require allocation.
+  // Enter stub frame with loading PP. The caller's PP is not materialized yet.
+  __ EnterStubFrame();
+  if (kind == kLazyDeoptFromReturn) {
+    __ PushRegister(R4);  // Preserve result, it will be GC-d here.
+  } else if (kind == kLazyDeoptFromThrow) {
+    // Preserve CODE_REG for one more runtime call.
+    __ PushRegister(CODE_REG);
+    __ PushRegister(R4);  // Preserve exception, it will be GC-d here.
+    __ PushRegister(R5);  // Preserve stacktrace, it will be GC-d here.
+  }
+
+  __ PushImmediate(0);  // Space for the result.
+  __ CallRuntime(kDeoptimizeMaterializeRuntimeEntry, 0);
+  // Result tells stub how many bytes to remove from the expression stack
+  // of the bottom-most frame. They were used as materialization arguments.
+  __ PopRegister(R5);
+  __ SmiUntag(R5);
+  if (kind == kLazyDeoptFromReturn) {
+    __ PopRegister(R3);  // Restore result.
+  } else if (kind == kLazyDeoptFromThrow) {
+    __ PopRegister(R4);  // Restore stacktrace.
+    __ PopRegister(R3);  // Restore exception.
+    __ PopRegister(CODE_REG);
+  }
+  __ LeaveStubFrame();
+  // Remove materialization arguments.
+  __ add(SP, SP, R5);
+  // The caller is responsible for emitting the return instruction.
+
+  if (kind == kLazyDeoptFromThrow) {
+    // Unoptimized frame is now ready to accept the exception. Rethrow it to
+    // find the right handler. Ask rethrow machinery to bypass debugger it
+    // was already notified about this exception.
+    __ EnterStubFrame();
+    __ PushImmediate(0);  // Space for the return value (unused).
+    __ PushRegister(R3);  // Exception
+    __ PushRegister(R4);  // Stacktrace
+    __ PushImmediate(target::ToRawSmi(1));  // Bypass debugger
+    __ CallRuntime(kReThrowRuntimeEntry, 3);
+    __ LeaveStubFrame();
+  }
+}
+
+// The continuation address is in LR (LeaveStubFrame restored it from the
+// rewritten frame). This stub was not entered by a call, so leaving it with
+// blr would pop a link-stack entry that was never pushed (S-10).
+static void JumpToContinuationInLR(Assembler* assembler) {
+  __ mflr(TMP);
+  __ JumpRegister(TMP);
+}
+
+// R3: result, must be preserved
+void StubCodeCompiler::GenerateDeoptimizeLazyFromReturnStub() {
+  // Push zap value instead of CODE_REG for lazy deopt.
+  __ LoadImmediate(TMP, kZapCodeReg);
+  __ PushRegister(TMP);
+  // Return address for "call" to deopt stub.
+  __ LoadImmediate(TMP, kZapReturnAddress);
+  __ SetReturnAddress(TMP);
+  __ LoadFromOffset(CODE_REG, THR,
+                    target::Thread::lazy_deopt_from_return_stub_offset());
+  GenerateDeoptimizationSequence(assembler, kLazyDeoptFromReturn);
+  JumpToContinuationInLR(assembler);
+}
+
+// R3: exception, must be preserved
+// R4: stacktrace, must be preserved
+void StubCodeCompiler::GenerateDeoptimizeLazyFromThrowStub() {
+  // Push zap value instead of CODE_REG for lazy deopt.
+  __ LoadImmediate(TMP, kZapCodeReg);
+  __ PushRegister(TMP);
+  // Return address for "call" to deopt stub.
+  __ LoadImmediate(TMP, kZapReturnAddress);
+  __ SetReturnAddress(TMP);
+  __ LoadFromOffset(CODE_REG, THR,
+                    target::Thread::lazy_deopt_from_throw_stub_offset());
+  GenerateDeoptimizationSequence(assembler, kLazyDeoptFromThrow);
+  JumpToContinuationInLR(assembler);
+}
+
+// Entered by a call from optimized code: blr keeps the link stack paired even
+// though the return address in the rewritten frame is a different one.
+void StubCodeCompiler::GenerateDeoptimizeStub() {
+  __ PushRegister(CODE_REG);
+  __ LoadFromOffset(CODE_REG, THR, target::Thread::deoptimize_stub_offset());
+  GenerateDeoptimizationSequence(assembler, kEagerDeopt);
+  __ Ret();
+}
+
+// R5: Smi-tagged argument count (ArgumentsDescriptor size).
+// R6: Smi-tagged type argument vector length.
+// Leaves the Smi-tagged length of the arguments array in R5.
+static void AdjustArgumentCountForTypeArguments(Assembler* assembler) {
+  Label no_type_args;
+  __ CompareImmediate(R6, 0);
+  __ BranchIf(EQUAL, &no_type_args, Assembler::kNearJump);
+  // Include the type arguments.
+  __ AddImmediate(R5, R5, target::ToRawSmi(1));
+  __ Bind(&no_type_args);
+}
+
+// IC_DATA_REG: ICData/MegamorphicCache
+static void GenerateNoSuchMethodDispatcherBody(Assembler* assembler) {
+  __ EnterStubFrame();
+
+  __ LoadFieldFromOffset(ARGS_DESC_REG, IC_DATA_REG,
+                         target::CallSiteData::arguments_descriptor_offset());
+
+  // Load the receiver.
+  __ LoadCompressedSmiFieldFromOffset(
+      R5, ARGS_DESC_REG, target::ArgumentsDescriptor::size_offset());
+  __ sldi(TMP, R5, target::kWordSizeLog2 - 1);  // R5 is Smi.
+  __ add(TMP, FP, TMP);
+  __ LoadFromOffset(R9, TMP,
+                    target::frame_layout.param_end_from_fp * target::kWordSize);
+  __ PushImmediate(0);             // Result slot.
+  __ PushRegister(R9);             // Receiver.
+  __ PushRegister(IC_DATA_REG);    // ICData/MegamorphicCache.
+  __ PushRegister(ARGS_DESC_REG);  // Arguments descriptor.
+
+  // Adjust arguments count.
+  __ LoadCompressedSmiFieldFromOffset(
+      R6, ARGS_DESC_REG, target::ArgumentsDescriptor::type_args_len_offset());
+  AdjustArgumentCountForTypeArguments(assembler);
+
+  // R5: Smi-tagged arguments array length.
+  PushArrayOfArguments(assembler);
+  const intptr_t kNumArgs = 4;
+  __ CallRuntime(kNoSuchMethodFromCallStubRuntimeEntry, kNumArgs);
+  __ Drop(4);
+  __ PopRegister(R3);  // Return value.
+  __ LeaveStubFrame();
+  __ Ret();
+}
+
+static void GenerateDispatcherCode(Assembler* assembler,
+                                   Label* call_target_function) {
+  __ Comment("NoSuchMethodDispatch");
+  // When lazily generated invocation dispatchers are disabled, the
+  // miss-handler may return null.
+  __ CompareObject(R3, NullObject());
+  __ BranchIf(NOT_EQUAL, call_target_function);
+
+  GenerateNoSuchMethodDispatcherBody(assembler);
+}
+
+// Input:
+//   ARGS_DESC_REG - arguments descriptor
+//   IC_DATA_REG - icdata/megamorphic_cache
+void StubCodeCompiler::GenerateNoSuchMethodDispatcherStub() {
+  GenerateNoSuchMethodDispatcherBody(assembler);
+}

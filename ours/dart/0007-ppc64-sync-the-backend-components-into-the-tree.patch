+  // ----- 2a. Memory access (ABI-SPEC section 5) ----------------------------
+  //
+  // The single choke point for the DS-form rule. |sz| selects the
+  // instruction family; the form is chosen from the address:
+  //
+  //   index register          -> X-form                         (1 insn)
+  //   D-form family, int16    -> D-form                         (1 insn)
+  //   DS-form family, int16 and offset % 4 == 0 -> DS-form      (1 insn)
+  //   anything else           -> LoadImmediate(R0, offset); X-form with
+  //                              RB = R0                         (2-3 insns)
+  //
+  // DS-form families: kEightBytes load/store, kFourBytes (signed) load.
+  // D-form families: everything else (byte, half, unsigned word, word store).
+  //
+  // Clobbers: R0 only, and only in the last case. Never TMP/TMP2.
+  // Requires: base != R0; for stores src != R0 when the last case applies.
+  void Load(Register dst,
+            const Address& address,
+            OperandSize sz = kEightBytes) override;  // [core]
+  void Store(Register src,
+             const Address& address,
+             OperandSize sz = kEightBytes) override;  // [core]
+  // Stores zero. Uses R0 as the value when the access needs no index
+  // register; otherwise |temp| (TMP when kNoRegister) holds the zero.
+  void StoreZero(const Address& address,
+                 Register temp = kNoRegister);  // [core]
+
+  // How many instructions Load (is_store false) or Store (is_store true)
+  // emits for Address(base, offset) with this size. Used by code that must
+  // know a sequence length in advance (patterns, size asserts). The two
+  // differ only for kByte (the load adds extsb: there is no sign-extending
+  // byte load) and kFourBytes (the load is DS-form lwa, the store D-form stw).
+  static intptr_t MemoryAccessLength(int32_t offset,
+                                     OperandSize sz,
+                                     bool is_store = false);  // [core]
+  // True if the access is a single D- or DS-form instruction.
+  static bool CanUseDisplacementForm(int32_t offset,
+                                     OperandSize sz,
+                                     bool is_store = false);  // [core]
+
+  // dst = base + imm. base != R0 (it would read as zero); dst may be R0.
+  // int16: addi. Otherwise LoadImmediate(R0, imm) ; add dst,base,R0, which
+  // clobbers R0 and is correct for every dst (an addis+addi pair is not:
+  // "addi r0,r0,lo" reads RA = R0 as zero). Never TMP/TMP2.
+  void AddImmediate(Register dst, Register base, int64_t imm);  // [core]
+  void AddImmediate(Register dst, int64_t imm) {
+    AddImmediate(dst, dst, imm);
+  }
+  void AddRegisters(Register dst, Register src);  // [core] dst += src
+  void SubRegisters(Register dst, Register src);  // [core] dst -= src
+  // dst = base + (index << shift). Clobbers R0 when dst aliases base.
+  void AddShifted(Register dst,
+                  Register base,
+                  Register index,
+                  intptr_t shift);  // [core]
+  // dst = &base[index << scale] + offset, in |dst| (commonly TMP; not R0).
+  void ComputeElementAddress(Register dst,
+                             Register base,
+                             Register index,
+                             ScaleFactor scale,
+                             int32_t offset);  // [core]
+
+  void LoadMemoryValue(Register dst, Register base, int32_t offset) {
+    LoadFromOffset(dst, base, offset, kEightBytes);
+  }
+  void StoreMemoryValue(Register src, Register base, int32_t offset) {
+    StoreToOffset(src, base, offset, kEightBytes);
+  }
+  // Stack slots by depth in words from SP.
+  void LoadFromStack(Register dst, intptr_t depth);    // [core]
+  void StoreToStack(Register src, intptr_t depth);     // [core]
+  void CompareToStack(Register src, intptr_t depth);   // [core] deferred
+  void CompareWithMemoryValue(Register value,
+                              Address address,
+                              OperandSize size = kEightBytes)
+      override;  // [core] deferred; clobbers TMP
+
+  // ----- FP memory access and constants (ABI-SPEC 5.2, 6.4, 7.7) ----------
+  // Same form rules as Load/Store (lfs/lfd/stfs/stfd are D-form). Clobbers
+  // R0 only when the offset is outside int16.
+  void LoadDFromOffset(FpuRegister dst,
+                       Register base,
+                       int32_t offset);  // [ext]
+  void StoreDToOffset(FpuRegister src,
+                      Register base,
+                      int32_t offset);  // [ext]
+  void LoadSFromOffset(FpuRegister dst,
+                       Register base,
+                       int32_t offset);  // [ext]
+  // Rounds to single first: frsp FpuTMP,src ; stfs FpuTMP,... unless
+  // |already_single|. Clobbers FpuTMP.
+  void StoreSToOffset(FpuRegister src,
+                      Register base,
+                      int32_t offset,
+                      bool already_single = false);  // [ext]

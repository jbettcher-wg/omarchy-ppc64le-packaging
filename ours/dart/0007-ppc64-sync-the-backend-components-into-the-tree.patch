+// S-5. Exactly the 12 instructions of ABI-SPEC 9.3 per allocatable register,
+// written with raw emitters so that the size cannot drift with a macro.
+void StubCodeCompiler::GenerateWriteBarrierWrappersStub() {
+  const intptr_t entry_offset =
+      target::Thread::write_barrier_entry_point_offset();
+  RELEASE_ASSERT(IsDSDisplacement(entry_offset));
+
+  for (intptr_t i = 0; i < kNumberOfCpuRegisters; ++i) {
+    if ((kDartAvailableCpuRegs & (1 << i)) == 0) continue;
+
+    Register reg = static_cast<Register>(i);
+    intptr_t start = __ CodeSize();
+    __ mflr(R0);
+    __ stdu(R0, SP, -2 * target::kWordSize);
+    __ std(kWriteBarrierObjectReg, SP, 1 * target::kWordSize);
+    if (reg == kWriteBarrierObjectReg) {
+      __ nop();  // "mr r4,r4" is an SMT hint, not a move (ABI-SPEC 11.4).
+    } else {
+      __ mr(kWriteBarrierObjectReg, reg);
+    }
+    __ ld(R0, THR, entry_offset);
+    __ mtctr(R0);
+    __ bctrl();
+    __ ld(kWriteBarrierObjectReg, SP, 1 * target::kWordSize);
+    __ ld(R0, SP, 0);
+    __ addi(SP, SP, 2 * target::kWordSize);
+    __ mtlr(R0);
+    __ blr();
+    intptr_t end = __ CodeSize();
+
+    RELEASE_ASSERT(end - start == kStoreBufferWrapperSize);
+  }
+}
+
+// Helper stub to implement Assembler::StoreIntoObject/Array.
+// Input parameters:
+//   R4: Object (old)
+//   R3: Value (old or new)
+//  R24: Slot
+// If R3 is new, add R4 to the store buffer. Otherwise R3 is old, mark R3
+// and add it to the mark list.
+//
+// S-5. Frameless: LR is live throughout and is saved only by LeafRuntimeScope
+// on the two paths that call the runtime. Clobbers R0, TMP, TMP2 and CR0;
+// the array variant also clobbers R24.
+COMPILE_ASSERT(kWriteBarrierObjectReg == R4);
+COMPILE_ASSERT(kWriteBarrierValueReg == R3);
+COMPILE_ASSERT(kWriteBarrierSlotReg == R24);
+static void GenerateWriteBarrierStubHelper(Assembler* assembler, bool cards) {
+  RegisterSet spill_set((1 << R5) | (1 << R6) | (1 << R7), 0);
+
+  // Every header bit the barrier looks at is in the low-order byte, which on
+  // little-endian is the byte at the header's own address.
+  const int32_t tags_byte_offset =
+      target::Object::tags_offset() - kHeapObjectTag;
+  ASSERT(target::UntaggedObject::kNotMarkedBit < 8);
+  ASSERT(target::UntaggedObject::kOldAndNotRememberedBit < 8);
+  ASSERT(target::UntaggedObject::kCardRememberedBit < 8);
+
+  Label skip_marking;
+  __ LoadFromOffset(TMP, R3, tags_byte_offset, kUnsignedByte);
+  __ LoadFromOffset(TMP2, THR, target::Thread::write_barrier_mask_offset(),
+                    kUnsignedByte);
+  __ and_(TMP, TMP, TMP2);
+  __ TestImmediate(TMP, target::UntaggedObject::kIncrementalBarrierMask);
+  __ BranchIf(ZERO, &skip_marking);
+
+  {
+    // Atomically clear kNotMarkedBit.
+    Label is_new, done;
+    __ PushRegisters(spill_set);
+    // R6: Untagged address of header word (larx/stcx. take no displacement).
+    __ AddImmediate(R6, R3, tags_byte_offset);
+    __ LoadImmediate(R5, 1 << target::UntaggedObject::kNotMarkedBit);
+    // Strong loop: a lost reservation is retried (REPORT-M1 section 10).
+    __ AtomicFetchAndOp(Assembler::kAtomicAndNot, /*addr=*/R6, /*value=*/R5,
+                        /*old=*/R7);
+    __ TestImmediate(R7, 1 << target::UntaggedObject::kNotMarkedBit);
+    __ BranchIf(ZERO, &done);  // Was already clear -> lost race.
+
+    __ BranchIfBit(R3, target::ObjectAlignment::kNewObjectBitPosition,
+                   NOT_ZERO, &is_new);
+
+    auto mark_stack_push = [&](intptr_t offset, const RuntimeEntry& entry) {
+      __ LoadFromOffset(R7, THR, offset);
+      __ LoadFromOffset(R5, R7, target::MarkingStackBlock::top_offset(),
+                        kUnsignedFourBytes);
+      __ sldi(R6, R5, target::kWordSizeLog2);
+      __ add(R6, R7, R6);
+      __ StoreToOffset(R3, R6, target::MarkingStackBlock::pointers_offset());
+      __ AddImmediate(R5, R5, 1);
+      __ StoreToOffset(R5, R7, target::MarkingStackBlock::top_offset(),
+                       kUnsignedFourBytes);
+      __ CompareImmediate(R5, target::MarkingStackBlock::kSize);
+      __ BranchIf(NOT_EQUAL, &done);
+
+      {
+        LeafRuntimeScope rt(assembler,
+                            /*frame_size=*/0,
+                            /*preserve_registers=*/true);
+        __ MoveRegister(R3, THR);
+        rt.Call(entry, /*argument_count=*/1);
+      }
+    };
+
+    mark_stack_push(target::Thread::old_marking_stack_block_offset(),
+                    kOldMarkingStackBlockProcessRuntimeEntry);
+    __ Jump(&done);
+
+    __ Bind(&is_new);
+    mark_stack_push(target::Thread::new_marking_stack_block_offset(),
+                    kNewMarkingStackBlockProcessRuntimeEntry);
+
+    __ Bind(&done);
+    __ PopRegisters(spill_set);
+  }
+
+  Label add_to_remembered_set, remember_card;
+  __ Bind(&skip_marking);
+  __ LoadFromOffset(TMP, R4, tags_byte_offset, kUnsignedByte);
+  __ LoadFromOffset(TMP2, R3, tags_byte_offset, kUnsignedByte);
+  __ srdi(TMP, TMP, target::UntaggedObject::kBarrierOverlapShift);
+  __ and_(TMP, TMP2, TMP);
+  __ TestImmediate(TMP, target::UntaggedObject::kGenerationalBarrierMask);
+  __ BranchIf(NOT_ZERO, &add_to_remembered_set);
+  __ Ret();
+
+  __ Bind(&add_to_remembered_set);
+  if (cards) {
+    __ LoadFromOffset(TMP, R4, tags_byte_offset, kUnsignedByte);
+    __ TestImmediate(TMP, 1 << target::UntaggedObject::kCardRememberedBit);
+    __ BranchIf(NOT_ZERO, &remember_card);
+  } else {
+#if defined(DEBUG)
+    Label ok;
+    __ LoadFromOffset(TMP, R4, tags_byte_offset, kUnsignedByte);
+    __ TestImmediate(TMP, 1 << target::UntaggedObject::kCardRememberedBit);
+    __ BranchIf(ZERO, &ok, Assembler::kNearJump);
+    __ Stop("Wrong barrier");
+    __ Bind(&ok);
+#endif
+  }
+  {
+    // Atomically clear kOldAndNotRememberedBit.
+    Label done;
+    __ PushRegisters(spill_set);
+    // R6: Untagged address of header word (larx/stcx. take no displacement).
+    __ AddImmediate(R6, R4, tags_byte_offset);
+    __ LoadImmediate(R5, 1 << target::UntaggedObject::kOldAndNotRememberedBit);
+    __ AtomicFetchAndOp(Assembler::kAtomicAndNot, /*addr=*/R6, /*value=*/R5,
+                        /*old=*/R7);
+    __ TestImmediate(R7, 1 << target::UntaggedObject::kOldAndNotRememberedBit);
+    __ BranchIf(ZERO, &done);  // Was already clear -> lost race.
+
+    // Load the StoreBuffer block out of the thread. Then load top_ out of the
+    // StoreBufferBlock and add the address to the pointers_.
+    __ LoadFromOffset(R7, THR, target::Thread::store_buffer_block_offset());
+    __ LoadFromOffset(R5, R7, target::StoreBufferBlock::top_offset(),
+                      kUnsignedFourBytes);
+    __ sldi(R6, R5, target::kWordSizeLog2);
+    __ add(R6, R7, R6);
+    __ StoreToOffset(R4, R6, target::StoreBufferBlock::pointers_offset());
+
+    // Increment top_ and check for overflow.
+    // R5: top_.
+    // R7: StoreBufferBlock.
+    __ AddImmediate(R5, R5, 1);
+    __ StoreToOffset(R5, R7, target::StoreBufferBlock::top_offset(),
+                     kUnsignedFourBytes);
+    __ CompareImmediate(R5, target::StoreBufferBlock::kSize);
+    __ BranchIf(NOT_EQUAL, &done);
+
+    {
+      LeafRuntimeScope rt(assembler,
+                          /*frame_size=*/0,
+                          /*preserve_registers=*/true);
+      __ MoveRegister(R3, THR);
+      rt.Call(kStoreBufferBlockProcessRuntimeEntry, /*argument_count=*/1);
+    }
+
+    __ Bind(&done);
+    __ PopRegisters(spill_set);
+    __ Ret();
+  }
+  if (cards) {
+    // Get card table.
+    __ Bind(&remember_card);
+    __ AndImmediate(TMP, R4, target::kPageMask);  // Page.
+    __ LoadFromOffset(TMP2, TMP,
+                      target::Page::card_table_offset());  // Card table.
+
+    // Atomically dirty the card. The card table is an array of 64-bit words
+    // (RelaxedAtomic<uword>, heap/page.h), so the update is ldarx/stdcx.
+    __ subf(R24, TMP, R24);                              // Offset in page.
+    __ srdi(R24, R24, target::Page::kBytesPerCardLog2);  // Card index.
+    // Bit mask = 1 << (index mod 64). sld takes a 7-bit count and gives 0 for
+    // 64..127 instead of wrapping, so the count is masked first.
+    COMPILE_ASSERT(target::kBitsPerWordLog2 == 6);
+    __ clrldi(R0, R24, 64 - target::kBitsPerWordLog2);
+    __ li(TMP, 1);
+    __ sld(TMP, TMP, R0);
+    __ srdi(R24, R24, target::kBitsPerWordLog2);  // Word index.
+    __ sldi(R24, R24, target::kWordSizeLog2);
+    __ add(TMP2, TMP2, R24);  // Card word address.
+    // R24 is dead now and receives the old word.
+    __ AtomicFetchAndOp(Assembler::kAtomicOr, /*addr=*/TMP2, /*value=*/TMP,
+                        /*old=*/R24);
+    __ Ret();
+  }
+}

+// ---------------------------------------------------------------------------
+// Instruction encoding.
+//
+// Every word below is [MEASURED]: work/abi/enc/run-oracle.sh builds each
+// entry of PPC64_INSTRUCTION_LIST with the field encoders of this file and
+// compares the result with GNU as and llvm-mc at -mpower8 / -mcpu=pwr8.
+// ---------------------------------------------------------------------------
+
+// Primary opcode in bits 0:5 (IBM numbering), i.e. the top six bits.
+constexpr uint32_t PPCOp(uint32_t primary) {
+  return primary << 26;
+}
+// X / XL / XFX forms: 10-bit extended opcode in bits 21:30, Rc/LK in bit 31.
+constexpr uint32_t PPCX(uint32_t primary, uint32_t xo, uint32_t rc = 0) {
+  return (primary << 26) | (xo << 1) | rc;
+}
+// XO form: OE in bit 21, 9-bit extended opcode in bits 22:30, Rc in bit 31.
+// OE is always 0: the overflow-recording forms are banned (ABI-SPEC section 11.3).
+constexpr uint32_t PPCXO(uint32_t primary, uint32_t xo, uint32_t rc = 0) {
+  return (primary << 26) | (xo << 1) | rc;
+}
+// DS form: 2-bit extended opcode in bits 30:31.
+constexpr uint32_t PPCDS(uint32_t primary, uint32_t xo) {
+  return (primary << 26) | xo;
+}
+// MD form: 3-bit extended opcode in bits 27:29.
+constexpr uint32_t PPCMD(uint32_t xo, uint32_t rc = 0) {
+  return (30u << 26) | (xo << 2) | rc;
+}
+// MDS form: 4-bit extended opcode in bits 27:30.
+constexpr uint32_t PPCMDS(uint32_t xo, uint32_t rc = 0) {
+  return (30u << 26) | (xo << 1) | rc;
+}
+// XS form (sradi): 9-bit extended opcode in bits 21:29.
+constexpr uint32_t PPCXS(uint32_t xo, uint32_t rc = 0) {
+  return (31u << 26) | (xo << 2) | rc;
+}
+// A form: 5-bit extended opcode in bits 26:30.
+constexpr uint32_t PPCA(uint32_t primary, uint32_t xo, uint32_t rc = 0) {
+  return (primary << 26) | (xo << 1) | rc;
+}
+// XX2 form: 9-bit extended opcode in bits 21:29.
+constexpr uint32_t PPCXX2(uint32_t xo) {
+  return (60u << 26) | (xo << 2);
+}
+// XX3 form: 8-bit extended opcode in bits 21:28.
+constexpr uint32_t PPCXX3(uint32_t xo) {
+  return (60u << 26) | (xo << 3);
+}
+// mfspr/mtspr with the SPR number baked in (its two 5-bit halves swapped).
+constexpr uint32_t PPCSpr(uint32_t xo, uint32_t spr) {
+  return (31u << 26) | (((spr & 0x1f) << 5 | (spr >> 5)) << 11) | (xo << 1);
+}
+
+constexpr uint32_t kSprXER = 1;  // Never read or written by generated code.
+constexpr uint32_t kSprLR = 8;
+constexpr uint32_t kSprCTR = 9;
+
+// How the operands of an instruction are packed (and, for the oracle, how
+// they are spelled in assembly source, in this order).
+enum PPCOperands {
+  kOpNone,              // fixed word
+  kOpRT_RA_SI,          // addi RT,RA,SI
+  kOpRA_RS_UI,          // ori RA,RS,UI
+  kOpBF_L_RA_SI,        // cmpi BF,L,RA,SI
+  kOpBF_L_RA_UI,        // cmpli BF,L,RA,UI
+  kOpRT_D_RA,           // lbz RT,D(RA)          (RT or RS)
+  kOpFRT_D_RA,          // lfd FRT,D(RA)         (FRT or FRS)
+  kOpRT_DS_RA,          // ld RT,DS(RA)          (RT or RS); DS % 4 == 0
+  kOpRT_RA_RB,          // ldx RT,RA,RB / add RT,RA,RB   (RT or RS)
+  kOpFRT_RA_RB,         // lfdx FRT,RA,RB        (FRT or FRS)
+  kOpRT_RA,             // neg RT,RA
+  kOpRA_RS_RB,          // and RA,RS,RB
+  kOpRA_RS,             // extsw RA,RS
+  kOpRA_RS_SH5,         // srawi RA,RS,SH
+  kOpRA_RS_SH6,         // sradi RA,RS,SH

+// Stub for compiling a function and jumping to the compiled code.
+// ARGS_DESC_REG: Arguments descriptor.
+// FUNCTION_REG: Function.
+void StubCodeCompiler::GenerateLazyCompileStub() {
+  // Preserve arg desc.
+  __ EnterStubFrame();
+  __ PushRegister(ARGS_DESC_REG);  // Save arg. desc.
+  __ PushRegister(FUNCTION_REG);   // Pass function.
+  __ CallRuntime(kCompileFunctionRuntimeEntry, 1);
+  __ PopRegister(FUNCTION_REG);   // Restore function.
+  __ PopRegister(ARGS_DESC_REG);  // Restore arg desc.
+  __ LeaveStubFrame();
+
+  __ LoadCompressedFieldFromOffset(CODE_REG, FUNCTION_REG,
+                                   target::Function::code_offset());
+  __ Jump(FieldAddress(FUNCTION_REG, target::Function::entry_point_offset()));
+}

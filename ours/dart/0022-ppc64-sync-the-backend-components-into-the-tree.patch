   const intptr_t shift = Utils::ShiftForPowerOfTwo(element_size_) -
                          (unboxed_inputs() ? 0 : kSmiTagShift);
-  if (shift < 0) {
-    // Byte elements with a Smi start: AddShifted takes 0..63 only.
-    // payload_reg is a temp, distinct from array_reg and start_reg.
-    __ sradi(payload_reg, start_reg, -shift);
-    __ add(payload_reg, array_reg, payload_reg);
-  } else {
-    __ AddShifted(payload_reg, array_reg, start_reg, shift);
-  }
+  __ AddShifted(payload_reg, array_reg, start_reg, shift);
   __ AddImmediate(payload_reg, offset);
 }
 

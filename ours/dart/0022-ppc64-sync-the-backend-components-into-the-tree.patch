@@ -1045,7 +1045,9 @@ class Assembler : public MicroAssembler {
   }
   void AddRegisters(Register dst, Register src);  // [core] dst += src
   void SubRegisters(Register dst, Register src);  // [core] dst -= src
-  // dst = base + (index << shift). Clobbers R0 when dst aliases base.
+  // dst = base + (index << shift); a negative shift is an arithmetic right
+  // shift, dst = base + (index >> -shift) (ABI-SPEC A9 #3). Clobbers R0 when
+  // dst aliases base.
   void AddShifted(Register dst,
                   Register base,
                   Register index,

   for (OperandSize sz : sizes) {
     const intptr_t n = Assembler::OperandSizeInBits(sz) / 8;
-    // r3 = address, r4 = expected, r5 = desired -> r3 = old, r9 = mismatch.
+    // r3 = address, r4 = expected, r5 = desired, r6 = &old ->
+    // r3 = 1 iff the mismatch label was taken; old stored at [r6]. (The old
+    // value is canonical for the size, so for kFourBytes it is sign-extended
+    // and must not share a register with the flag.)
     const uword cas = GenerateEntry("CompareAndSwap", [&](Assembler* a) {
       Label miss;
       a->LoadImmediate(R9, 1);
       a->CompareAndSwap(R3, R4, R5, R7, &miss, Assembler::kRelaxedNonAtomic, sz);
       a->LoadImmediate(R9, 0);
       a->Bind(&miss);
-      a->sldi(R9, R9, 62);
-      a->or_(R3, R7, R9);  // the flag in bit 62, the old value below
+      a->Store(R7, Address(R6, 0));
+      a->MoveRegister(R3, R9);
     });
     const uword fetch_add = GenerateEntry("AtomicFetchAndOp", [&](Assembler* a) {
       a->AtomicFetchAndOp(Assembler::kAtomicAdd, R3, R4, R7, Assembler::kRelease,
@@ -1487,20 +1490,28 @@ ISOLATE_UNIT_TEST_CASE(Assembler_PPC64_Atomics) {
       if (n == 4) expected = SExt32(cur);
       if (n == 2) expected = static_cast<int64_t>(static_cast<int16_t>(cur));
       if (n == 1) expected = static_cast<int64_t>(static_cast<int8_t>(cur));
+      // The value read, canonical for the size (7.6).
+      const uint64_t old_want = Extend(cur & mask, sz);
+      uint64_t old = 0;
       // Mismatch: memory unchanged, old returned, flag set.
-      int64_t r = Call(cas, reinterpret_cast<int64_t>(&words[1]),
-                       (cur ^ 1) & mask, 0x42);
-      EXPECT_EQ(1, (r >> 62) & 1);
+      EXPECT_EQ(1, Call(cas, reinterpret_cast<int64_t>(&words[1]),
+                        (cur ^ 1) & mask, 0x42,
+                        reinterpret_cast<int64_t>(&old)));
+      EXPECT_EQ(old_want, old);
+      uint64_t unchanged = 0;
+      memcpy(&unchanged, &words[1], n);
+      EXPECT_EQ(cur & mask, unchanged);
       // Match, with a sign-extended expected for the narrow sizes.
-      r = Call(cas, reinterpret_cast<int64_t>(&words[1]), expected, 0x42);
-      EXPECT_EQ(0, (r >> 62) & 1);
+      old = 0;
+      EXPECT_EQ(0, Call(cas, reinterpret_cast<int64_t>(&words[1]), expected,
+                        0x42, reinterpret_cast<int64_t>(&old)));
+      EXPECT_EQ(old_want, old);
       uint64_t now = 0;
       memcpy(&now, &words[1], n);
       EXPECT_EQ(0x42u, now);
       EXPECT_EQ(0x3c3c3c3c3c3c3c3cull, words[0]);
       EXPECT_EQ(0x3c3c3c3c3c3c3c3cull, words[2]);
-      const int64_t old = Call(fetch_add, reinterpret_cast<int64_t>(&words[1]), 5);
-      EXPECT_EQ(0x42, old);
+      EXPECT_EQ(0x42, Call(fetch_add, reinterpret_cast<int64_t>(&words[1]), 5));
       memcpy(&now, &words[1], n);
       EXPECT_EQ(0x47u, now);
     }

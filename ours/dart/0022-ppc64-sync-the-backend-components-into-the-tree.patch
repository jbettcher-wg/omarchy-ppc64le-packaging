diff --git a/runtime/vm/compiler/assembler/assembler_ppc64.cc b/runtime/vm/compiler/assembler/assembler_ppc64.cc
index 1ebe87a1..7d22c8cc 100644
--- a/runtime/vm/compiler/assembler/assembler_ppc64.cc
+++ b/runtime/vm/compiler/assembler/assembler_ppc64.cc
@@ -188,13 +188,19 @@ void Assembler::AddShifted(Register dst,
                            intptr_t shift) {
   if (shift == 0) {
     add(dst, base, index);
-  } else if (dst != base) {
-    sldi(dst, index, shift);
-    add(dst, base, dst);
-  } else {
-    sldi(R0, index, shift);
-    add(dst, base, R0);
+    return;
   }
+  // The shifted index goes to dst, or to R0 when dst is base (still read).
+  const Register scaled = (dst != base) ? dst : R0;
+  if (shift > 0) {
+    sldi(scaled, index, shift);
+  } else {
+    // A negative shift is an arithmetic right shift, as ARM64 (ASR) and
+    // RISC-V (srai) take it: e.g. -1 for a Smi index of 1-byte elements
+    // (ABI-SPEC Amendment A9 #3).
+    sradi(scaled, index, -shift);
+  }
+  add(dst, base, scaled);
 }
 
 void Assembler::ComputeElementAddress(Register dst,

@@ -729,6 +729,17 @@ static void EmitInt64ShiftOutOfRange(compiler::Assembler* assembler,
 
 // ----- Misc -------------------------------------------------------------------
 
+// Unbox<float> of a Smi: result = (float)untag(box), rounded once (fcfids,
+// ISA 2.06). fcfid + frsp would round twice for |x| > 2^53. FPRs hold the
+// single in double format (ABI-SPEC 7.7). Clobbers TMP.
+static void EmitSmiToFloat(compiler::Assembler* assembler,
+                           FpuRegister result,
+                           Register box) {
+  __ SmiUntag(TMP, box);
+  __ mtvsrd(result, TMP);
+  __ fcfids(result, result);
+}
+
 // result = SmiTag(Multiply64Hash(value) & 0x3fffffff); keep in sync with
 // lib/integers.cc Multiply64Hash. |value| is untagged and is clobbered;
 // result != value.
@@ -1186,16 +1197,11 @@ void MemoryCopyInstr::EmitComputeStartPointer(FlowGraphCompiler* compiler,
     return;
   }
   const Register start_reg = start_loc.reg();
+  // A negative shift (byte elements, Smi start) is an arithmetic right

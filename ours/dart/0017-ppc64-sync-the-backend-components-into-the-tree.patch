-// AOT only (dispatch table calls). TODO(ppc64): M3-BOOT-PLAN 4.3 item 3,
-// "AOT, later".
+// AOT dispatch table call (RISC-V's address computation, ARM64's call):
+//   sldi r11,cid,3 ; add r11,r25,r11 ;
+//   ld r0,off*8(r11)  (or li/lis r0,off*8 ; ldx r0,r11,r0) ; mtctr r0 ; bctrl
+// TMP holds the slot address; the target is staged in R0 (ABI-SPEC 4.1).
+// cid_reg (DispatchTableNullErrorABI::kClassIdReg, R3) and ARGS_DESC_REG
+// survive into the callee. Not patched, so no code pattern. Compile-checked
+// only.
 void FlowGraphCompiler::EmitDispatchTableCall(
     int32_t selector_offset,
     const Array& arguments_descriptor) {
-  UNIMPLEMENTED();
+  const auto cid_reg = DispatchTableNullErrorABI::kClassIdReg;
+  ASSERT(CanCallDart());
+  ASSERT(cid_reg != ARGS_DESC_REG);
+  if (!arguments_descriptor.IsNull()) {
+    __ LoadObject(ARGS_DESC_REG, arguments_descriptor);
+  }
+  const intptr_t offset = selector_offset - DispatchTable::kOriginElement;
+  // Would like cid_reg to be available on entry to the target function
+  // for checking purposes.
+  ASSERT(cid_reg != TMP);
+  __ AddShifted(TMP, DISPATCH_TABLE_REG, cid_reg,
+                compiler::target::kWordSizeLog2);
+  __ Call(compiler::Address(TMP, offset * compiler::target::kWordSize));
 }
 
 // S-12 / contract 1: the identical stubs return TMP == 0 iff identical.
@@ -845,12 +913,47 @@ void FlowGraphCompiler::EmitMove(Location destination,
 // FFI native-move hooks) are defined in il_ppc64_c.cc: they are IL-C's
 // (M3-BOOT-PLAN section 7; tools/gen-shells.py FGC_METHOD_OWNER).
 
-// AOT only (BSS-relative loads read the PC, ABI-SPEC 6.5).
-// TODO(ppc64): with the AOT work.
+// AOT: dst = *bss_start, found PC-relatively (ABI-SPEC 6.5). The
+// relocation word (bss_start - its own address, written by the image
+// writer) is placed in the instruction stream and jumped over:
+//   b skip ; [trap padding to 8] .quad reloc ; skip:
+//   mflr dst ; bcl 20,31,$+4 ; mflr tmp ; mtlr dst ;
+//   addi tmp,tmp,(reloc - pc) ; ld dst,0(tmp) ; add tmp,tmp,dst ;
+//   ld dst,0(tmp)
+// The PC read destroys LR, which may still hold a return address here (the
+// callers are FFI/native entry sequences), so it is kept in |dst| around
+// the read (dst is free until the relocation is loaded). Compile-checked
+// only.
 void FlowGraphCompiler::LoadBSSEntry(BSS::Relocation relocation,
                                      Register dst,
                                      Register tmp) {
-  UNIMPLEMENTED();
+  ASSERT(dst != tmp);
+  ASSERT(dst != R0 && tmp != R0);
+  compiler::Label skip_reloc;
+  __ Jump(&skip_reloc, compiler::Assembler::kNearJump);
+  InsertBSSRelocation(relocation);
+  __ Bind(&skip_reloc);
+  // The relocation word ends where skip_reloc is bound
+  // (AssemblerBase::InsertAlignedRelocation: padding, then the word).
+  const intptr_t reloc_offset = __ CodeSize() - compiler::target::kWordSize;
+
+  __ mflr(dst);
+  // LoadPC yields the address of its second instruction (the mflr).
+  const intptr_t pc_offset = __ CodeSize() + Instr::kInstrSize;
+  __ LoadPC(tmp);
+  __ mtlr(dst);
+  __ AddImmediate(tmp, reloc_offset - pc_offset);
+
+  // tmp holds the address of the relocation.
+  __ LoadFromOffset(dst, tmp, 0);
+
+  // dst holds the relocation itself: bss_start - tmp.
+  // tmp = tmp + (bss_start - tmp) = bss_start
+  __ AddRegisters(tmp, dst);
+
+  // tmp holds the start of the BSS section.
+  // Load the "get-thread" routine: *bss_start.
+  __ LoadFromOffset(dst, tmp, 0);
 }
 
 #undef __

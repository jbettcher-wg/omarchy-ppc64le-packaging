-// AOT only (M3 is JIT). The emitted shape is the contract with Agent C's
-// BareSwitchableCallPattern, which does not exist yet: left unimplemented
-// rather than guessed.
-// TODO(ppc64): AOT switchable call (M3-BOOT-PLAN 4.3 item 3, "AOT, later").
+// AOT switchable call (ARM64's structure). The target entry point and the
+// call data occupy consecutive patchable slots of the global pool (target at
+// i, data at i+1, as ARM64's LoadDoubleWordFromPoolIndex), and the AOT
+// runtime replaces slot i with an entry point (app_snapshot.cc). The target
+// is staged in R0, the Dart-call convention of ABI-SPEC 4.1 ("AOT, entry
+// point from pool: ld r0,idx(r30) ; mtctr r0 ; bctrl"), so the data load
+// comes first. Emitted, for Agent C's BareSwitchableCallPattern (walk back
+// from the return address):
+//   ld r8,(i+1)*8(PP) ; ld r0,i*8(PP) ; mtctr r0 ; bctrl
+// either pool load possibly in the far form `addis X,PP,ha ; ld dst,lo(X)`
+// (X = r8 for the data, TMP for r0; ABI-SPEC 6.2). The callee sees the
+// receiver in R3 and the data in IC_DATA_REG (the SwitchableCallMiss,
+// MonomorphicSmiableCheck, SingleTargetCall and ICCallThroughCode stubs).
+// Compile-checked only; depends on [vm-A] LoadWordFromPoolIndex.
 void FlowGraphCompiler::EmitInstanceCallAOT(const ICData& ic_data,
                                             intptr_t deopt_id,
                                             const InstructionSource& source,
                                             LocationSummary* locs,
                                             Code::EntryKind entry_kind,
                                             bool receiver_can_be_smi) {
-  UNIMPLEMENTED();
+  ASSERT(CanCallDart());
+  ASSERT(ic_data.NumArgsTested() == 1);
+  const Code& initial_stub = StubCode::SwitchableCallMiss();
+  const char* switchable_call_mode = "smiable";
+  if (!receiver_can_be_smi) {
+    switchable_call_mode = "non-smi";
+    ic_data.set_receiver_cannot_be_smi(true);
+  }
+  const UnlinkedCall& data =
+      UnlinkedCall::ZoneHandle(zone(), ic_data.AsUnlinkedCall());
+
+  compiler::ObjectPoolBuilder& op = __ object_pool_builder();
+
+  __ Comment("InstanceCallAOT (%s)", switchable_call_mode);
+  // Clear argument descriptor to keep gc happy when it gets pushed on to
+  // the stack.
+  __ LoadImmediate(ARGS_DESC_REG, 0);
+  __ LoadFromOffset(R3, SP, (ic_data.SizeWithoutTypeArgs() - 1) * kWordSize);
+
+  const auto snapshot_behavior =
+      FLAG_precompiled_mode ? compiler::ObjectPoolBuilderEntry::
+                                  kResetToSwitchableCallMissEntryPoint
+                            : compiler::ObjectPoolBuilderEntry::kSnapshotable;
+  const intptr_t stub_index = op.AddObject(
+      initial_stub, ObjectPool::Patchability::kPatchable, snapshot_behavior);
+  const intptr_t data_index =
+      op.AddObject(data, ObjectPool::Patchability::kPatchable);
+  ASSERT((stub_index + 1) == data_index);
+
+  // The AOT runtime will replace the slot in the object pool with the
+  // entrypoint address - see app_snapshot.cc.
+  __ LoadWordFromPoolIndex(IC_DATA_REG, data_index);
+  __ LoadWordFromPoolIndex(R0, stub_index);
+  __ CallRegister(R0);  // mtctr r0 ; bctrl
+
+  EmitCallsiteMetadata(source, DeoptId::kNone, UntaggedPcDescriptors::kOther,
+                       locs, pending_deoptimization_env_);
+  EmitDropArguments(ic_data.SizeWithTypeArgs());
 }
 

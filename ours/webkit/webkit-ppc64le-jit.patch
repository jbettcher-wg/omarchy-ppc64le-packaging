+    // ---- the 32-bit zero-extension invariant ----
+    void maskLow32(RegisterID reg) { m_assembler.clrldi(reg, reg, 32); }
+
+    // A scratch register that is neither of the two operands.
+    //
+    // The immediate helpers below need somewhere to materialise a constant
+    // that does not fit an instruction field. Reaching for temps<Data>()
+    // unconditionally is wrong: these helpers are also called from places
+    // that are ALREADY working in the data temp, and
+    // `addImmediate64(dataTemp, big, dataTemp)` would then load the constant
+    // over its own source and compute value+value. Picking a register that
+    // collides with neither operand makes that impossible.
+    //
+    // The cost is that such a call may clobber the OTHER temp, so a caller
+    // holding something live in one temp must not assume the other survives
+    // an immediate operation. If both are taken this asserts rather than
+    // choosing wrongly.
+    RegisterID immediateScratch(RegisterID a, RegisterID b)
+    {
+        RELEASE_ASSERT(m_allowScratchRegister);
+        if (dataTempRegister != a && dataTempRegister != b)
+            return dataTempRegister;
+        RELEASE_ASSERT(memoryTempRegister != a && memoryTempRegister != b);
+        return memoryTempRegister;
+    }
+
+    // Where to materialise a constant that has to reach a register before it
+    // can be combined with `src` into `dest`.
+    //
+    // When dest is not src, dest is already free: the constant can be built
+    // there and consumed immediately by the ALU op that overwrites it. Only
+    // the in-place form (dest == src) needs a register of its own.
+    //
+    // Preferring dest is not a peephole, it is what keeps three-address
+    // immediate operations working when both MacroAssembler temporaries are
+    // spoken for. branchTest32(cond, Address, mask) is exactly that caller:
+    // it loads the address through one temp and tests into the other, so a
+    // mask that needs materialising has nothing left to materialise into.
+    // immediateScratch's RELEASE_ASSERT fired inside the Baseline compiler
+    // for op_enumerator_put_by_val, whose mask is 0x40010 -- two bits, too
+    // far apart for andi./andis. and not a rotate-and-mask run.
+    RegisterID constantScratch(RegisterID src, RegisterID dest)
+    {
+        if (dest != src)
+            return dest;
+        return immediateScratch(src, dest);
+    }
+
+    // ---- generated stub surface (see the header comment) ----
+    // ---- add / sub ----
+    //
+    // JSC's convention, which every method below follows: the two-operand
+    // form is op(src, dest) meaning dest = dest OP src, and the three-operand
+    // form is op(a, b, dest) meaning dest = a OP b. PowerPC's subf is the
+    // other way round from both -- subf(rt, ra, rb) computes rt = rb - ra --
+    // so every subtraction here reads with its operands crossed. That is the
+    // single easiest thing to get backwards in this file.
+
+    // dest = src + value, choosing the shortest encoding that is exact.
+    void addImmediate64(RegisterID src, int64_t value, RegisterID dest)
+    {
+        if (!value) {
+            move(src, dest);
+            return;
+        }
+        if (Assembler::isValidSigned16(value)) {
+            m_assembler.addi(dest, src, static_cast<int32_t>(value));
+            return;
+        }
+        // Any signed 32-bit displacement is an addis/addi pair and needs NO
+        // scratch register at all. addi sign-extends its field, so when the
+        // low half is negative the high half has to be pre-compensated --
+        // that is what the subtraction before the shift does. Doing this
+        // without a temp is worth the arithmetic: every TrustedImm32 offset
+        // in the engine lands here, including from callers that are already
+        // using both temps.
+        // addi sign-extends its 16-bit field, so when the low half is
+        // negative the high half has to be compensated upward by one. That
+        // compensation can carry OUT of the signed 16-bit range: for any
+        // value in [0x7fff8000, 0x7fffffff] the corrected high half is
+        // +32768, which addis cannot encode. It would be truncated to
+        // -32768 and produce an address off by 2^32 -- silently, and only
+        // for a narrow band of large positive displacements. (Found by
+        // testmasm's load-with-large-offset cases, which emitted
+        // `addis rD,rA,-32768 ; addi rD,rD,-1` for an offset of +2147483647.)
+        // isValidSigned16 on the corrected half is the guard; anything it
+        // rejects goes through a register instead.
+        if (Assembler::isValidSigned32(value)) {
+            int32_t low = static_cast<int16_t>(value);
+            int64_t high = (value - low) >> 16;
+            if (Assembler::isValidSigned16(high)) {
+                RegisterID current = src;
+                if (high) {
+                    m_assembler.addis(dest, current, static_cast<int32_t>(high));
+                    current = dest;
+                }
+                if (low) {
+                    m_assembler.addi(dest, current, low);
+                    current = dest;
+                }
+                move(current, dest);
+                return;
+            }
+        }
+        RegisterID scratch = constantScratch(src, dest);
+        m_assembler.loadImmediate64(scratch, value);
+        m_assembler.add(dest, src, scratch);
+    }

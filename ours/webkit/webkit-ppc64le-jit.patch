+// i32x4.dot_i16x8_s: sums that exceed 16 bits in both directions, so a
+// halfword-width accident is visible.
+void testPPC64VectorDotProduct()
+{
+    alignas(16) const int16_t a[8] = { 300, -400, 32767, 32767, -32768, -32768, 7, -9 };
+    alignas(16) const int16_t b[8] = { 500, 600, 32767, 1, -32768, 2, 11, 13 };
+    alignas(16) uint8_t out[16];
+    ppc64RunVectorBinary(a, b, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorDotProduct(x, y, d);
+    });
+    for (unsigned i = 0; i < 4; ++i) {
+        int32_t expected = static_cast<int32_t>(a[2 * i]) * b[2 * i] + static_cast<int32_t>(a[2 * i + 1]) * b[2 * i + 1];
+        ppc64CheckLane<int32_t>(out, i, expected);
+    }
+}

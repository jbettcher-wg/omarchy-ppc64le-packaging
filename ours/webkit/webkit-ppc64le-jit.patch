+// The three-address immediate forms now materialise their constant into dest
+// when dest is not src. That is a different instruction sequence from the
+// scratch-register one, so it needs its own arithmetic check.
+void testThreeAddressImmediates(uint32_t value, uint32_t imm)
+{
+    auto check = [&] (auto&& emit, uint32_t expected) {
+        CHECK_EQ(compileAndRun<uint32_t>([&] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            // regT1, not regT0: regT0 is returnValueGPR here, and the point of
+            // these cases is the dest != src path.
+            jit.move(CCallHelpers::TrustedImm32(value), GPRInfo::regT1);
+            emit(jit);
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        }), expected);
+    };
+    check([&] (CCallHelpers& jit) { jit.and32(CCallHelpers::TrustedImm32(imm), GPRInfo::regT1, GPRInfo::returnValueGPR); }, value & imm);
+    check([&] (CCallHelpers& jit) { jit.or32(CCallHelpers::TrustedImm32(imm), GPRInfo::regT1, GPRInfo::returnValueGPR); }, value | imm);
+    check([&] (CCallHelpers& jit) { jit.xor32(CCallHelpers::TrustedImm32(imm), GPRInfo::regT1, GPRInfo::returnValueGPR); }, value ^ imm);
+    check([&] (CCallHelpers& jit) { jit.add32(CCallHelpers::TrustedImm32(imm), GPRInfo::regT1, GPRInfo::returnValueGPR); }, value + imm);
+    // ... and the in-place forms, which still take the scratch path.
+    check([&] (CCallHelpers& jit) { jit.and32(CCallHelpers::TrustedImm32(imm), GPRInfo::regT1); jit.move(GPRInfo::regT1, GPRInfo::returnValueGPR); }, value & imm);
+    check([&] (CCallHelpers& jit) { jit.or32(CCallHelpers::TrustedImm32(imm), GPRInfo::regT1); jit.move(GPRInfo::regT1, GPRInfo::returnValueGPR); }, value | imm);
+    check([&] (CCallHelpers& jit) { jit.xor32(CCallHelpers::TrustedImm32(imm), GPRInfo::regT1); jit.move(GPRInfo::regT1, GPRInfo::returnValueGPR); }, value ^ imm);
+    check([&] (CCallHelpers& jit) { jit.add32(CCallHelpers::TrustedImm32(imm), GPRInfo::regT1); jit.move(GPRInfo::regT1, GPRInfo::returnValueGPR); }, value + imm);
+}
+
+// A patchable pointer store must survive being patched, INTO THE REGISTER IT
+// WAS EMITTED FOR. The patcher rewrites the constant sequence in place, and on
+// a target where that sequence names its destination register in every word,
+// rewriting it with a fixed register silently retargets the whole thing.
+//
+// Nothing in the engine noticed, because everywhere else a patchable pointer
+// happens to live in the same register the patcher assumed. YARR is the
+// exception: storePtrWithPatch writes a backtrack return address into a frame
+// slot through a MacroAssembler temporary, and the store then read a register
+// the patch had never written. The compiled regex jumped to whatever was in
+// it.
+void testStorePtrWithPatchThenPatch(void* patchedValue)
+{
+    uint64_t cell = 0;
+    CCallHelpers jit;
+    emitFunctionPrologue(jit);
+    jit.move(CCallHelpers::TrustedImmPtr(&cell), GPRInfo::regT1);
+    // The initial value is deliberately not the patched one, so a patch that
+    // does not land is visible rather than accidentally correct.
+    MacroAssembler::DataLabelPtr label = jit.storePtrWithPatch(CCallHelpers::TrustedImmPtr(nullptr), CCallHelpers::Address(GPRInfo::regT1));
+    jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+    emitFunctionEpilogue(jit);
+    jit.ret();
+
+    LinkBuffer linkBuffer(jit, nullptr);
+    linkBuffer.patch(label, patchedValue);
+    auto code = FINALIZE_CODE(linkBuffer, JSEntryPtrTag, nullptr, "testmasm storePtrWithPatch");
+
+    CHECK_EQ(invoke<uint64_t>(code), 0);
+    CHECK_EQ(cell, std::bit_cast<uint64_t>(patchedValue));
+}

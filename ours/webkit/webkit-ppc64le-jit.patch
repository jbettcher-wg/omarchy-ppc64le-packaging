+// The 0/1-in-a-GPR form, which is the shape Air's atomic opcodes want and
+// the one place this family materialises CR0 rather than branching on it.
+// mfocrf + rlwinm has its own way of being wrong -- the wrong CR field, the
+// wrong bit, a rotate one off -- none of which the branch forms above would
+// notice, so both polarities are checked against both outcomes.
+static void testPPC64AtomicStrongCASResultRegister()
+{
+    auto compileResultForm = [] (CCallHelpers::StatusCondition cond) {
+        return compile([cond] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.atomicStrongCAS32(cond, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3,
+                CCallHelpers::BaseIndex(GPRInfo::argumentGPR0, GPRInfo::argumentGPR1, CCallHelpers::TimesFour),
+                GPRInfo::returnValueGPR);
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+    };
+
+    auto onSuccess = compileResultForm(CCallHelpers::Success);
+    auto onFailure = compileResultForm(CCallHelpers::Failure);
+
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242 };
+        CHECK_EQ(invoke<uint64_t>(onSuccess, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424242), static_cast<uint64_t>(0x99999999)), 1ull);
+        CHECK_EQ(data[1], 0x99999999u);
+    }
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242 };
+        CHECK_EQ(invoke<uint64_t>(onSuccess, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424243), static_cast<uint64_t>(0x99999999)), 0ull);
+        CHECK_EQ(data[1], 0x42424242u);
+    }
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242 };
+        CHECK_EQ(invoke<uint64_t>(onFailure, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424242), static_cast<uint64_t>(0x99999999)), 0ull);
+        CHECK_EQ(data[1], 0x99999999u);
+    }
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242 };
+        CHECK_EQ(invoke<uint64_t>(onFailure, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424243), static_cast<uint64_t>(0x99999999)), 1ull);
+        CHECK_EQ(data[1], 0x42424242u);
+    }
+    // The whole register, not just its low word: emitSetFromCR0 must leave
+    // nothing above bit 0.
+    {
+        uint32_t data[] = { 0x11111111, 0x42424242 };
+        CHECK_EQ(invoke<uint64_t>(onSuccess, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42424242), static_cast<uint64_t>(0x99999999)) >> 1, 0ull);
+    }
+}

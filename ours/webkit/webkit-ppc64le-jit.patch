+// ---- The ELFv2 argument cursor -----------------------------------------
+//
+// ELFv2 advances ONE doubleword cursor across both register files, so a
+// double consumes its GPR slot without writing it and every argument after
+// it moves up one register. These probes ARE the compiler's own placement --
+// they are ordinary C functions, compiled by the same clang that compiles
+// the engine -- so the test cannot pass by agreeing with the JIT's opinion
+// of the ABI. Before the cursor landed, the first of these received its int
+// in r4 while the callee read r5, which is the defect the DFG census
+// measured as numberToString(vm, 1, radix=0).
+
+// The probe writes through its FIRST argument, so each test owns its own
+// result and nothing is shared. testmasm runs cases concurrently across
+// threads, and file-scope result slots would race between tests rather than
+// measure anything. It also means the pointer argument checks itself: the
+// probe records the pointer it was handed, which must be the one the caller
+// passed in r3.
+struct PPC64CursorResult {
+    void* seenPointer { nullptr };
+    double seenDouble { 0 };
+    double seenDouble2 { 0 };
+    int32_t seenInt { 0 };
+};
+
+static void ppc64CursorProbePtrDoubleInt(void* out, double d, int32_t i)
+{
+    auto* result = static_cast<PPC64CursorResult*>(out);
+    result->seenPointer = out;
+    result->seenDouble = d;
+    result->seenInt = i;
+}
+
+static void ppc64CursorProbePtrDoubleDoubleInt(void* out, double d, double d2, int32_t i)
+{
+    auto* result = static_cast<PPC64CursorResult*>(out);
+    result->seenPointer = out;
+    result->seenDouble = d;
+    result->seenDouble2 = d2;
+    result->seenInt = i;
+}
+
+// (void*, double, int32_t): doublewords 0,1,2 -> r3, f1, r5. The independent
+// counters this port inherited said r3, f1, r4.
+static void testPPC64CCallCursorPointerDoubleInt()
+{
+    for (int32_t radix : { 10, -42, 0x7fffffff }) {
+        PPC64CursorResult result;
+
+        auto stub = compile([&] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.move(CCallHelpers::TrustedImm64(std::bit_cast<uint64_t>(2.5)), GPRInfo::regT0);
+            jit.move64ToDouble(GPRInfo::regT0, FPRInfo::fpRegT0);
+            jit.setupArguments<decltype(&ppc64CursorProbePtrDoubleInt)>(
+                CCallHelpers::TrustedImmPtr(&result),
+                FPRInfo::fpRegT0,
+                CCallHelpers::TrustedImm32(radix));
+            jit.move(CCallHelpers::TrustedImmPtr(std::bit_cast<void*>(&ppc64CursorProbePtrDoubleInt)), GPRInfo::nonArgGPR0);
+            jit.call(GPRInfo::nonArgGPR0, OperationPtrTag);
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(stub);
+
+        CHECK_EQ(result.seenPointer, static_cast<void*>(&result));
+        CHECK_EQ(result.seenDouble, 2.5);
+        CHECK_EQ(result.seenInt, radix);
+    }
+}
+
+// (void*, double, double, int32_t): doublewords 0,1,2,3 -> r3, f1, f2, r6.
+// Two doubles move the int two registers, which no independent-counter model
+// can express.
+static void testPPC64CCallCursorTwoDoublesThenInt()
+{
+    PPC64CursorResult result;
+
+    auto stub = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.move(CCallHelpers::TrustedImm64(std::bit_cast<uint64_t>(2.5)), GPRInfo::regT0);
+        jit.move64ToDouble(GPRInfo::regT0, FPRInfo::fpRegT0);
+        jit.move(CCallHelpers::TrustedImm64(std::bit_cast<uint64_t>(-8.25)), GPRInfo::regT0);
+        jit.move64ToDouble(GPRInfo::regT0, FPRInfo::fpRegT1);
+        jit.setupArguments<decltype(&ppc64CursorProbePtrDoubleDoubleInt)>(
+            CCallHelpers::TrustedImmPtr(&result),
+            FPRInfo::fpRegT0,
+            FPRInfo::fpRegT1,
+            CCallHelpers::TrustedImm32(77));
+        jit.move(CCallHelpers::TrustedImmPtr(std::bit_cast<void*>(&ppc64CursorProbePtrDoubleDoubleInt)), GPRInfo::nonArgGPR0);
+        jit.call(GPRInfo::nonArgGPR0, OperationPtrTag);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    invoke<void>(stub);
+
+    CHECK_EQ(result.seenPointer, static_cast<void*>(&result));
+    CHECK_EQ(result.seenDouble, 2.5);
+    CHECK_EQ(result.seenDouble2, -8.25);
+    CHECK_EQ(result.seenInt, 77);
+}

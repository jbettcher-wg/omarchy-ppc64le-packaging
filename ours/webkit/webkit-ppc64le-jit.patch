+static void testPPC64ArithmeticImmediateFormsAgainstTheCompiler()
+{
+    // Immediates chosen for their boundaries, not for variety.
+    const int32_t immediates[] = { 1, -1, 2, -2, 7, -7, 0x7fffffff, static_cast<int32_t>(0x80000000), 0x10000, -0x10000 };
+
+    const PPC64ArithForm forms[] = {
+        PPC64ArithForm::Add32Carry,
+        PPC64ArithForm::Add64Overflow,
+        PPC64ArithForm::Sub32Carry,
+        PPC64ArithForm::Sub64Overflow,
+        PPC64ArithForm::Mul64Overflow,
+    };
+
+    for (auto form : forms) {
+        const bool is32 = form == PPC64ArithForm::Add32Carry || form == PPC64ArithForm::Sub32Carry;
+
+        uint64_t valueFromImmediateForm = 0;
+        uint64_t valueFromRegisterForm = 0;
+        auto registerForm = compilePPC64ArithRegisterForm(form, &valueFromRegisterForm);
+
+        for (int32_t imm : immediates) {
+            auto immediateForm = compilePPC64ArithImmediateForm(form, imm, &valueFromImmediateForm);
+
+            // The operand values: the boundary at which this operation
+            // changes its answer for THIS immediate, its neighbours, and the
+            // extremes. Nothing here is random.
+            Vector<uint64_t> operands;
+            auto append = [&] (uint64_t value) { operands.append(value); };
+            append(0);
+            append(1);
+            append(static_cast<uint64_t>(-1));
+            append(static_cast<uint64_t>(INT64_MAX));
+            append(static_cast<uint64_t>(INT64_MAX) - 1);
+            append(static_cast<uint64_t>(INT64_MIN));
+            append(static_cast<uint64_t>(INT64_MIN) + 1);
+            append(0x00000000ffffffffull);
+            append(0x000000007fffffffull);
+            append(0x0000000080000000ull);
+            // Garbage above bit 31, which the 32-bit forms must mask away and
+            // the 64-bit forms must honour.
+            append(0x123456789abcdef0ull);
+            if (is32) {
+                uint32_t u = static_cast<uint32_t>(imm);
+                uint32_t boundary = 0u - u; // the smallest addend that carries out
+                for (int32_t delta = -2; delta <= 2; ++delta)
+                    append(static_cast<uint64_t>(static_cast<int64_t>(static_cast<int32_t>(boundary + static_cast<uint32_t>(delta)))));
+                for (int32_t delta = -2; delta <= 2; ++delta)
+                    append(static_cast<uint64_t>(static_cast<uint32_t>(u + static_cast<uint32_t>(delta))));
+            } else {
+                uint64_t positiveBoundary = static_cast<uint64_t>(INT64_MAX) - static_cast<uint64_t>(static_cast<int64_t>(imm));
+                uint64_t negativeBoundary = static_cast<uint64_t>(INT64_MIN) - static_cast<uint64_t>(static_cast<int64_t>(imm));
+                for (int64_t delta = -2; delta <= 2; ++delta) {
+                    append(positiveBoundary + static_cast<uint64_t>(delta));
+                    append(negativeBoundary + static_cast<uint64_t>(delta));
+                }
+                if (imm) {
+                    uint64_t quotient = static_cast<uint64_t>(INT64_MAX) / static_cast<uint64_t>(imm < 0 ? -static_cast<int64_t>(imm) : static_cast<int64_t>(imm));
+                    for (int64_t delta = -2; delta <= 2; ++delta) {
+                        append(quotient + static_cast<uint64_t>(delta));
+                        append(static_cast<uint64_t>(-static_cast<int64_t>(quotient)) + static_cast<uint64_t>(delta));
+                    }
+                }
+            }
+
+            for (uint64_t operand : operands) {
+                // The oracle is the compiler's own, computed on the same
+                // widths the helper works in.
+                bool expectedFlag = false;
+                uint64_t expectedValue = 0;
+                if (form == PPC64ArithForm::Add32Carry) {
+                    uint32_t sum = 0;
+                    expectedFlag = __builtin_add_overflow(static_cast<uint32_t>(operand), static_cast<uint32_t>(imm), &sum);
+                    expectedValue = sum;
+                } else if (form == PPC64ArithForm::Sub32Carry) {
+                    uint32_t difference = 0;
+                    expectedFlag = __builtin_sub_overflow(static_cast<uint32_t>(operand), static_cast<uint32_t>(imm), &difference);
+                    expectedValue = difference;
+                } else if (form == PPC64ArithForm::Add64Overflow) {
+                    int64_t sum = 0;
+                    expectedFlag = __builtin_add_overflow(static_cast<int64_t>(operand), static_cast<int64_t>(imm), &sum);
+                    expectedValue = static_cast<uint64_t>(sum);
+                } else if (form == PPC64ArithForm::Sub64Overflow) {
+                    int64_t difference = 0;
+                    expectedFlag = __builtin_sub_overflow(static_cast<int64_t>(operand), static_cast<int64_t>(imm), &difference);
+                    expectedValue = static_cast<uint64_t>(difference);
+                } else {
+                    int64_t product = 0;
+                    expectedFlag = __builtin_mul_overflow(static_cast<int64_t>(operand), static_cast<int64_t>(imm), &product);
+                    expectedValue = static_cast<uint64_t>(product);
+                }
+
+                valueFromImmediateForm = 0xccccccccccccccccull;
+                uint32_t flag = invoke<uint32_t>(immediateForm, operand);
+                if (flag != static_cast<uint32_t>(expectedFlag) || valueFromImmediateForm != expectedValue)
+                    dataLogLn("PPC64 arithmetic immediate form ", ppc64ArithFormName(form), " imm=", imm, " operand=", operand);
+                CHECK_EQ(flag, static_cast<uint32_t>(expectedFlag));
+                CHECK_EQ(valueFromImmediateForm, expectedValue);
+
+                // The control arm, same everything except where the operand
+                // lives. The 64-bit forms sign-extend their immediate; the
+                // 32-bit ones only ever look at the low word.
+                valueFromRegisterForm = 0xccccccccccccccccull;
+                uint32_t controlFlag = invoke<uint32_t>(registerForm, operand, static_cast<uint64_t>(static_cast<int64_t>(imm)));
+                if (controlFlag != static_cast<uint32_t>(expectedFlag) || valueFromRegisterForm != expectedValue)
+                    dataLogLn("PPC64 arithmetic register CONTROL ", ppc64ArithFormName(form), " imm=", imm, " operand=", operand);
+                CHECK_EQ(controlFlag, static_cast<uint32_t>(expectedFlag));
+                CHECK_EQ(valueFromRegisterForm, expectedValue);
+            }
+        }
+    }
+}

+// The same shape as the test above, built out of opcodes this target has a
+// form for. It exists because the one above appends Add64 and Ret64, which are
+// tagged 64: in AirOpcode.opcodes -- meaning x86-64 or arm64 -- so on ppc64le
+// it aborts in Inst::generate before it ever reaches the frame it was written
+// to exercise. Ten thousand live tmps put the spill slots well past POWER's
+// signed 16-bit displacement reach, which is the only way to reach
+// lowerStackArgs' extended-offset path, and the sum is a value that can only
+// come out right if every one of those addresses was computed correctly.
+void testZDefOfSpillSlotWithOffsetNeedingToBeMaterializedInARegister32()
+{
+    // As above: this is slow in Debug builds, and B3OptLevel 1 and 2 behave
+    // the same with respect to this code.
+    if (Options::defaultB3OptLevel() == 1)
+        return;
+
+    B3::Procedure proc;
+    Code& code = proc.code();
+
+    BasicBlock* root = code.addBlock();
+
+    Vector<Tmp> tmps;
+    unsigned numberOfLiveTmps = 10000;
+    for (unsigned i = 0; i < numberOfLiveTmps; ++i)
+        tmps.append(code.newTmp(GP));
+
+    Tmp one = code.newTmp(GP);
+    root->append(Move, nullptr, Arg::imm(1), one);
+
+    Tmp val = code.newTmp(GP);
+    root->append(Move, nullptr, Arg::imm(0), val);
+    for (auto tmp : tmps) {
+        root->append(Move32, nullptr, val, tmp);
+        root->append(Add32, nullptr, one, val, val);
+    }
+
+    Tmp loadResult = code.newTmp(GP);
+    Tmp sum = code.newTmp(GP);
+    root->append(Move, nullptr, Arg::imm(0), sum);
+    for (auto tmp : tmps) {
+        root->append(Move32, nullptr, tmp, loadResult);
+        root->append(Add32, nullptr, loadResult, sum, sum);
+    }
+    root->append(Move32, nullptr, sum, Tmp(GPRInfo::returnValueGPR));
+    root->append(Ret32, nullptr, Tmp(GPRInfo::returnValueGPR));
+
+    const auto result = compileAndRun<uint32_t>(proc);
+    CHECK(result == (numberOfLiveTmps * (numberOfLiveTmps - 1)) / 2);
+}
+
+// The other half of the extended-offset question. The test above reaches the
+// spill path, which is call site A in
+// AirAllocateRegistersAndStackAndGenerateCode.cpp and names the register
+// through jit.move(). lowerStackArgs is reached through an explicit Arg::stack
+// on an Inst, and it is the only one of the three that builds an Air::Tmp for
+// that register -- so it is the only one that asks whether Air's Tmp will
+// accept a reserved register named directly. One Locked slot larger than
+// POWER's signed 16-bit displacement reach is the cheapest way to ask, and a
+// value that survives a store and a load through it is an answer that cannot
+// false-pass: if the index form were rejected the address would be built in a
+// base position, where r0 encodes the literal zero, and the load would fault.
+void testStackSlotBeyondDisplacementReach()
+{
+    B3::Procedure proc;
+    Code& code = proc.code();
+    BasicBlock* root = code.addBlock();
+
+    // The access has to be out of reach of BOTH cfr and sp, because
+    // lowerStackArgs tries them in that order and only then materialises. Two
+    // slots do that with a small in-slot offset: the padding slot pushes the
+    // live one into the middle of a quarter-megabyte frame, so it is ~128 KiB
+    // from each end against a signed 16-bit displacement.
+    //
+    // The offset has to be small rather than large because Arg::Stack reports
+    // its IN-SLOT offset to Arg::isValidForm, not the frame displacement that
+    // lowerStackArgs will finally compute -- so a large in-slot offset makes
+    // the Inst fail Air's own validator (AirValidate.cpp:86) while being
+    // perfectly encodable once lowered.
+    code.addStackSlot(128 * 1024, StackSlotKind::Locked);
+    StackSlot* slot = code.addStackSlot(128 * 1024, StackSlotKind::Locked);
+
+    root->append(Move32, nullptr, Tmp(GPRInfo::argumentGPR0), Arg::stack(slot, 0));
+    root->append(Move32, nullptr, Arg::stack(slot, 0), Tmp(GPRInfo::returnValueGPR));
+    root->append(Ret32, nullptr, Tmp(GPRInfo::returnValueGPR));
+
+    CHECK(compileAndRun<int32_t>(proc, 0x12345678) == 0x12345678);
+}
+
+void testBranchAdd64Imm()
+{
+    // `BranchAdd64 ResCond, Imm, Tmp` is the one form in the 64:-tagged set
+    // that has been shown to produce wrong code which assembles cleanly, so
+    // it gets a test at the level where it is declared. B3's CheckAdd is not
+    // an instrument for it on this target: every testb3 Check* group dies in
+    // the stackmap generator before it can compare an overflow answer, and no
+    // testb3 case feeds a 64-bit CheckAdd an immediate the predicate accepts
+    // anyway. Air can ask the question directly.
+    if (!isValidForm(BranchAdd64, Arg::ResCond, Arg::Imm, Arg::Tmp))
+        return;
+
+    // Distinct from every sum below, so the two edges fail different checks: a
+    // predicate that never fires misses the overflow cases, and one that always
+    // fires takes this path for the sums.
+    constexpr int64_t overflowed = 0x5eed5eedLL;
+
+    auto run = [&] (int64_t start, int32_t addend) -> int64_t {
+        B3::Procedure proc;
+        Code& code = proc.code();
+        BasicBlock* root = code.addBlock();
+        BasicBlock* caught = code.addBlock();
+        BasicBlock* fine = code.addBlock();
+
+        Tmp tmp = code.newTmp(B3::GP);
+        root->append(Move, nullptr, Arg::bigImm(start), tmp);
+        root->append(BranchAdd64, nullptr, Arg::resCond(MacroAssembler::Overflow), Arg::imm(addend), tmp);
+        root->setSuccessors(caught, fine);
+
+        Tmp sentinel = code.newTmp(B3::GP);
+        caught->append(Move, nullptr, Arg::bigImm(overflowed), sentinel);
+        caught->append(Move, nullptr, sentinel, Tmp(GPRInfo::returnValueGPR));
+        caught->append(Ret64, nullptr, Tmp(GPRInfo::returnValueGPR));
+
+        fine->append(Move, nullptr, tmp, Tmp(GPRInfo::returnValueGPR));
+        fine->append(Ret64, nullptr, Tmp(GPRInfo::returnValueGPR));
+
+        code.resetReachability();
+        return compileAndRun<int64_t>(proc);
+    };
+
+    constexpr int64_t max = 0x7fffffffffffffffLL;
+    constexpr int64_t min = -0x7fffffffffffffffLL - 1;
+
+    // No overflow, including hard against each boundary.
+    CHECK(run(1, 41) == 42);
+    CHECK(run(max - 42, 42) == max);
+    CHECK(run(min + 42, -42) == min);
+    CHECK(run(max, -1) == max - 1);
+    CHECK(run(min, 1) == min + 1);
+
+    // Overflow, one step past each of those boundaries, in both directions.
+    CHECK(run(max - 41, 42) == overflowed);
+    CHECK(run(max, 1) == overflowed);
+    CHECK(run(min + 41, -42) == overflowed);
+    CHECK(run(min, -1) == overflowed);
+}

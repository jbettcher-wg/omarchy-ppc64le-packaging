+    void loadPair32(RegisterID base, RegisterID dest1, RegisterID dest2) { loadPair32(base, TrustedImm32(0), dest1, dest2); }
+    void loadPair32(Address address, RegisterID dest1, RegisterID dest2) { loadPair32(address.base, TrustedImm32(address.offset), dest1, dest2); }

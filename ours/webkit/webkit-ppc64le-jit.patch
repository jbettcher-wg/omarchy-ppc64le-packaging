+// ---- Half precision ----------------------------------------------------
+//
+// IEEE binary16 conversion is ISA 3.0. A half in an FPR is its raw 16-bit
+// pattern in halfword 3 of doubleword 0, the port's raw-bits float model
+// narrowed one width.
+
+static void testPPC64Float16RoundTrip()
+{
+    if (!CCallHelpers::supportsFloat16())
+        return;
+
+    // Locals, captured by the generators, so concurrent cases cannot share
+    // state -- the pattern the existing PPC64 cases below use.
+    uint16_t in = 0;
+    double asDouble = 0;
+    uint64_t back = 0;
+    uint16_t inMemory = 0;
+
+    // half -> double, through move16ToFloat16 + convertFloat16ToDouble.
+    auto halfToDouble = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.move(CCallHelpers::TrustedImmPtr(&in), GPRInfo::regT3);
+        jit.load16(CCallHelpers::Address(GPRInfo::regT3), GPRInfo::regT0);
+        jit.move16ToFloat16(GPRInfo::regT0, FPRInfo::fpRegT0);
+        jit.convertFloat16ToDouble(FPRInfo::fpRegT0, FPRInfo::fpRegT1);
+        jit.storeDouble(FPRInfo::fpRegT1, CCallHelpers::TrustedImmPtr(&asDouble));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    // double -> half, through convertDoubleToFloat16 + moveFloat16To16.
+    // moveFloat16To16 masks, so the whole 64-bit result must be the half.
+    auto doubleToHalf = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadDouble(CCallHelpers::TrustedImmPtr(&asDouble), FPRInfo::fpRegT0);
+        jit.convertDoubleToFloat16(FPRInfo::fpRegT0, FPRInfo::fpRegT1);
+        jit.moveFloat16To16(FPRInfo::fpRegT1, GPRInfo::regT1);
+        jit.move(CCallHelpers::TrustedImmPtr(&back), GPRInfo::regT3);
+        jit.store64(GPRInfo::regT1, CCallHelpers::Address(GPRInfo::regT3));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    // storeFloat16 / loadFloat16 must move halfword 3 to and from memory.
+    auto throughMemory = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.move(CCallHelpers::TrustedImmPtr(&in), GPRInfo::regT3);
+        jit.load16(CCallHelpers::Address(GPRInfo::regT3), GPRInfo::regT0);
+        jit.move16ToFloat16(GPRInfo::regT0, FPRInfo::fpRegT0);
+        // storeFloat16 takes an Address or a BaseIndex, not a TrustedImmPtr,
+        // so the destination is materialized first.
+        jit.move(CCallHelpers::TrustedImmPtr(&inMemory), GPRInfo::regT2);
+        jit.storeFloat16(FPRInfo::fpRegT0, CCallHelpers::Address(GPRInfo::regT2));
+        jit.loadFloat16(CCallHelpers::TrustedImmPtr(&inMemory), FPRInfo::fpRegT1);
+        jit.moveFloat16To16(FPRInfo::fpRegT1, GPRInfo::regT1);
+        jit.move(CCallHelpers::TrustedImmPtr(&back), GPRInfo::regT3);
+        jit.store64(GPRInfo::regT1, CCallHelpers::Address(GPRInfo::regT3));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    // Every half round-trips through double exactly. NaN payloads are
+    // quieted and shifted by the hardware, which JavaScript cannot observe,
+    // so they are excluded exactly as the handbook probe excluded them.
+    for (uint32_t h = 0; h < 0x10000; ++h) {
+        bool isNaNWithPayload = ((h & 0x7c00) == 0x7c00) && (h & 0x3ff);
+        if (isNaNWithPayload)
+            continue;
+
+        in = static_cast<uint16_t>(h);
+
+        back = 0xccccccccccccccccULL;
+        invoke<void>(halfToDouble);
+        invoke<void>(doubleToHalf);
+        CHECK_EQ(back, static_cast<uint64_t>(h));
+
+        back = 0xccccccccccccccccULL;
+        inMemory = 0xdead;
+        invoke<void>(throughMemory);
+        CHECK_EQ(back, static_cast<uint64_t>(h));
+    }
+}

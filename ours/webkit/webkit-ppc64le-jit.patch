+// The values the handbook measured against a software round-to-nearest-even
+// reference. Ties must round to even, which is what Math.f16round and
+// DataView.setFloat16 require.
+static void testPPC64Float16RoundingIsTiesToEven()
+{
+    if (!CCallHelpers::supportsFloat16())
+        return;
+
+    double asDouble = 0;
+    uint64_t back = 0;
+    uint16_t in = 0;
+
+    auto doubleToHalf = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadDouble(CCallHelpers::TrustedImmPtr(&asDouble), FPRInfo::fpRegT0);
+        jit.convertDoubleToFloat16(FPRInfo::fpRegT0, FPRInfo::fpRegT1);
+        jit.moveFloat16To16(FPRInfo::fpRegT1, GPRInfo::regT1);
+        jit.move(CCallHelpers::TrustedImmPtr(&back), GPRInfo::regT3);
+        jit.store64(GPRInfo::regT1, CCallHelpers::Address(GPRInfo::regT3));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    struct { double input; uint16_t expected; } cases[] = {
+        { 1.0, 0x3c00 },
+        { 65504.0, 0x7bff },            // the largest finite half
+        { 65520.0, 0x7c00 },            // overflows to infinity
+        { 5.9604644775390625e-08, 0x0001 }, // the smallest denormal
+        { 0.1, 0x2e66 },
+        { 2049.0, 0x6800 },             // a tie: rounds DOWN to even 2048
+        { 2051.0, 0x6802 },             // a tie: rounds UP to even 2052
+        { -0.0, 0x8000 },
+    };
+
+    for (auto& testCase : cases) {
+        asDouble = testCase.input;
+        back = 0xccccccccccccccccULL;
+        invoke<void>(doubleToHalf);
+        CHECK_EQ(back, static_cast<uint64_t>(testCase.expected));
+    }
+
+    // half -> double on the same measured values.
+    auto halfToDouble = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.move(CCallHelpers::TrustedImmPtr(&in), GPRInfo::regT3);
+        jit.load16(CCallHelpers::Address(GPRInfo::regT3), GPRInfo::regT0);
+        jit.move16ToFloat16(GPRInfo::regT0, FPRInfo::fpRegT0);
+        jit.convertFloat16ToDouble(FPRInfo::fpRegT0, FPRInfo::fpRegT1);
+        jit.storeDouble(FPRInfo::fpRegT1, CCallHelpers::TrustedImmPtr(&asDouble));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    in = 0x3c00;
+    invoke<void>(halfToDouble);
+    CHECK_EQ(asDouble, 1.0);
+
+    in = 0x7bff;
+    invoke<void>(halfToDouble);
+    CHECK_EQ(asDouble, 65504.0);
+
+    in = 0x0001;
+    invoke<void>(halfToDouble);
+    CHECK_EQ(asDouble, 5.9604644775390625e-08);
+}
+
+// The float register model (jsc-ppc64le-yarr-wasm.md section 7): a float in
+// an FPR is its raw 32-bit single in the low word of doubleword 0, and the
+// other 96 bits are don't-care. Nothing in the shared test set pins that
+// down -- testMove32ToFloatComprehensive is a register round trip and passes
+// under either model -- so these are the tests that would catch the port
+// silently reverting to ELFv2's double-format convention.
+//
+// The patterns include a signalling NaN and a denormal, which are exactly
+// where a "convert" masquerading as a "bitcast" shows up.
+static Vector<uint32_t> ppc64FloatBitPatterns()
+{
+    return Vector<uint32_t> {
+        0x00000000, // +0
+        0x80000000, // -0
+        0x3f800000, // 1
+        0xbf800000, // -1
+        0x42280000, // 42
+        0x42290000, // 42.5
+        0x3dcccccd, // (float) 0.1
+        0x7f7fffff, // FLT_MAX
+        0x00800000, // FLT_MIN (smallest normal)
+        0x00000001, // smallest denormal
+        0x807fffff, // negative denormal
+        0x7f800000, // +inf
+        0xff800000, // -inf
+        0x7fc00000, // quiet NaN
+        0x7fa55555, // SIGNALLING NaN with a payload
+        0xffa00001, // negative signalling NaN
+    };
+}
+
+// A float goes into an FPR, and the whole 64 bits of doubleword 0 come back
+// out through storeDouble. Under the model the low word is the pattern; under
+// the double model it would be the IEEE double encoding of the same value,
+// which for 42.5f is 0x4045400000000000 and for a denormal is not even close.
+static void testPPC64FloatIsRawBits()
+{
+    uint32_t input = 0;
+    uint64_t output = 0;
+
+    auto viaMove32 = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.move(CCallHelpers::TrustedImmPtr(&input), GPRInfo::regT3);
+        jit.load32(CCallHelpers::Address(GPRInfo::regT3), GPRInfo::regT0);
+        jit.move32ToFloat(GPRInfo::regT0, FPRInfo::fpRegT0);
+        jit.storeDouble(FPRInfo::fpRegT0, CCallHelpers::TrustedImmPtr(&output));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    auto viaLoadFloat = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadFloat(CCallHelpers::TrustedImmPtr(&input), FPRInfo::fpRegT0);
+        jit.storeDouble(FPRInfo::fpRegT0, CCallHelpers::TrustedImmPtr(&output));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    // The round trip back out to memory and to a GPR, which is what IPInt's
+    // f32.reinterpret_i32 and every 16-byte slot copy depend on.
+    auto roundTrip = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.move(CCallHelpers::TrustedImmPtr(&input), GPRInfo::regT3);
+        jit.load32(CCallHelpers::Address(GPRInfo::regT3), GPRInfo::regT0);
+        jit.move32ToFloat(GPRInfo::regT0, FPRInfo::fpRegT0);
+        jit.storeFloat(FPRInfo::fpRegT0, CCallHelpers::TrustedImmPtr(&output));
+        jit.loadFloat(CCallHelpers::TrustedImmPtr(&output), FPRInfo::fpRegT1);
+        jit.moveFloatTo32(FPRInfo::fpRegT1, GPRInfo::regT1);
+        jit.move(CCallHelpers::TrustedImmPtr(&output), GPRInfo::regT3);
+        jit.store64(GPRInfo::regT1, CCallHelpers::Address(GPRInfo::regT3));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    for (uint32_t pattern : ppc64FloatBitPatterns()) {
+        input = pattern;
+
+        output = 0xccccccccccccccccULL;
+        invoke<void>(viaMove32);
+        CHECK_EQ(static_cast<uint32_t>(output), pattern);
+
+        output = 0xccccccccccccccccULL;
+        invoke<void>(viaLoadFloat);
+        CHECK_EQ(static_cast<uint32_t>(output), pattern);
+
+        output = 0xccccccccccccccccULL;
+        invoke<void>(roundTrip);
+        // moveFloatTo32 zero-extends, which is the port's 32-bit invariant.
+        CHECK_EQ(output, static_cast<uint64_t>(pattern));
+    }
+}
+
+// Widening must be a bit-exact reinterpretation of the same value, signalling
+// NaN payloads included -- it is lfs semantics, not a quieting convert.
+static void testPPC64ConvertFloatToDoublePreservesBits()
+{
+    uint32_t input = 0;
+    uint64_t output = 0;
+
+    auto widen = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.move(CCallHelpers::TrustedImmPtr(&input), GPRInfo::regT3);
+        jit.load32(CCallHelpers::Address(GPRInfo::regT3), GPRInfo::regT0);
+        jit.move32ToFloat(GPRInfo::regT0, FPRInfo::fpRegT0);
+        jit.convertFloatToDouble(FPRInfo::fpRegT0, FPRInfo::fpRegT1);
+        jit.storeDouble(FPRInfo::fpRegT1, CCallHelpers::TrustedImmPtr(&output));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    for (uint32_t pattern : ppc64FloatBitPatterns()) {
+        input = pattern;
+        output = 0;
+        invoke<void>(widen);
+        // The C reference: reinterpret the pattern as a float and widen it.
+        // A signalling NaN survives as a signalling NaN with its payload in
+        // the double's mantissa; C does the same conversion, so bit equality
+        // is the right check and not an over-specification.
+        float asFloat = std::bit_cast<float>(pattern);
+        double expected = static_cast<double>(asFloat);
+        CHECK_EQ(output, std::bit_cast<uint64_t>(expected));
+    }
+}
+
+// Narrowing must ROUND (xscvdpsp), not merely reformat (xscvdpspn). 0.1 is
+// the witness: 0x3dcccccd rounded, and a different pattern unrounded.
+static void testPPC64ConvertDoubleToFloatRounds()
+{
+    double input = 0;
+    uint32_t output = 0;
+
+    auto narrow = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadDouble(CCallHelpers::TrustedImmPtr(&input), FPRInfo::fpRegT0);
+        jit.convertDoubleToFloat(FPRInfo::fpRegT0, FPRInfo::fpRegT1);
+        jit.storeFloat(FPRInfo::fpRegT1, CCallHelpers::TrustedImmPtr(&output));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    for (double value : { 0.1, 1.0, -1.0, 42.5, 1.0 / 3.0, 1e300, -1e-300,
+        std::numeric_limits<double>::infinity(), 3.4028235677973366e38 }) {
+        input = value;
+        output = 0;
+        invoke<void>(narrow);
+        CHECK_EQ(output, std::bit_cast<uint32_t>(static_cast<float>(value)));
+    }
+    input = 0.1;
+    output = 0;
+    invoke<void>(narrow);
+    CHECK_EQ(output, 0x3dcccccdU);
+}
+
+// The xv*sp family computes lane 1 independently of the other three. Preload
+// the whole register with garbage, then do the arithmetic on lane 1 only.
+static void testPPC64FloatArithmeticIgnoresOtherLanes()
+{
+    uint32_t lhs = 0;
+    uint32_t rhs = 0;
+    uint32_t output = 0;
+
+    auto addWithGarbageLanes = compile([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        // Fill both operand registers with a signalling NaN everywhere, then
+        // overwrite only the word the model uses.
+        jit.move(CCallHelpers::TrustedImm64(0x7fa555557fa55555ULL), GPRInfo::regT0);
+        jit.move64ToDouble(GPRInfo::regT0, FPRInfo::fpRegT0);
+        jit.move64ToDouble(GPRInfo::regT0, FPRInfo::fpRegT1);
+        jit.move(CCallHelpers::TrustedImmPtr(&lhs), GPRInfo::regT3);
+        jit.load32(CCallHelpers::Address(GPRInfo::regT3), GPRInfo::regT0);
+        jit.move32ToFloat(GPRInfo::regT0, FPRInfo::fpRegT0);
+        jit.move(CCallHelpers::TrustedImmPtr(&rhs), GPRInfo::regT3);
+        jit.load32(CCallHelpers::Address(GPRInfo::regT3), GPRInfo::regT1);
+        jit.move32ToFloat(GPRInfo::regT1, FPRInfo::fpRegT1);
+        jit.addFloat(FPRInfo::fpRegT0, FPRInfo::fpRegT1, FPRInfo::fpRegT2);
+        jit.storeFloat(FPRInfo::fpRegT2, CCallHelpers::TrustedImmPtr(&output));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+
+    for (float a : floatOperands()) {
+        for (float b : floatOperands()) {
+            lhs = std::bit_cast<uint32_t>(a);
+            rhs = std::bit_cast<uint32_t>(b);
+            output = 0;
+            invoke<void>(addWithGarbageLanes);
+            float got = std::bit_cast<float>(output);
+            float want = a + b;
+            // NaN payloads after arithmetic are non-deterministic; NaN-ness
+            // is what is being checked there.
+            if (std::isnan(want))
+                CHECK_EQ(std::isnan(got), true);
+            else
+                CHECK_EQ(std::bit_cast<uint32_t>(got), std::bit_cast<uint32_t>(want));
+        }
+    }
+}
+// ---- Atomic compare-and-swap -------------------------------------------
+//
+// branchAtomicWeakCAS{8,16,32,64} is ONE larx/stcx. attempt. It takes its
+// Success jump exactly when the store happened, which needs both that memory
+// held the expected value and that the reservation survived; a weak CAS is
+// allowed to fail for the second reason alone, and the DFG's retry loop
+// absorbs that. See powerpc64le-handbook jsc-ppc64le-atomics-cas.md.
+//
+// The address base arrives in argumentGPR0, the index in argumentGPR1, the
+// expected value in argumentGPR2 and the new value in argumentGPR3 -- all as
+// real arguments, so that nothing here depends on which register a
+// harness-side move would have picked. The stub returns 1 when the Success
+// jump was taken and 0 otherwise.
+template<unsigned bitSize>
+static MacroAssemblerCodeRef<JSEntryPtrTag> compilePPC64AtomicWeakCAS()
+{
+    return compile([] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+
+        constexpr auto scale = bitSize == 8 ? CCallHelpers::TimesOne
+            : bitSize == 16 ? CCallHelpers::TimesTwo
+            : bitSize == 32 ? CCallHelpers::TimesFour
+            : CCallHelpers::TimesEight;
+        CCallHelpers::BaseIndex address(GPRInfo::argumentGPR0, GPRInfo::argumentGPR1, scale);
+
+        CCallHelpers::JumpList success;
+        if constexpr (bitSize == 8)
+            success = jit.branchAtomicWeakCAS8(CCallHelpers::Success, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+        else if constexpr (bitSize == 16)
+            success = jit.branchAtomicWeakCAS16(CCallHelpers::Success, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+        else if constexpr (bitSize == 32)
+            success = jit.branchAtomicWeakCAS32(CCallHelpers::Success, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+        else
+            success = jit.branchAtomicWeakCAS64(CCallHelpers::Success, GPRInfo::argumentGPR2, GPRInfo::argumentGPR3, address);
+
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto done = jit.jump();
+        success.link(&jit);
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        done.link(&jit);
+
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+}
+
+static void testPPC64AtomicWeakCAS8()
+{
+    auto cas = compilePPC64AtomicWeakCAS<8>();
+
+    // Matching: stores, takes Success, and touches only its own element --
+    // the neighbours sit inside the same 128-byte reservation granule.
+    {
+        uint8_t data[] = { 0x11, 0x42, 0x33 };
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x42), static_cast<uint64_t>(0x99)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[0]), 0x11u);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0x99u);
+        CHECK_EQ(static_cast<unsigned>(data[2]), 0x33u);
+    }
+    // Mismatching: no store at all, and Failure rather than Success.
+    {
+        uint8_t data[] = { 0x11, 0x42, 0x33 };
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x43), static_cast<uint64_t>(0x99)), 0u);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0x42u);
+    }
+    // The Int8Array seam: the DFG's reload sign-extends, lbarx does not, so
+    // the byte 0xff arrives as the expected value 0xffffffff and must still
+    // compare equal. testPPC64AtomicWeakCASSignExtendSeam is the control
+    // that this case is measuring the mask and not the weather.
+    {
+        uint8_t data[] = { 0x11, 0xff, 0x33 };
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0xffffffff), static_cast<uint64_t>(0xfe)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0xfeu);
+    }
+    // Garbage above the byte, which no Uint8Array load produces, but which
+    // shows the mask is a width mask rather than a sign fix.
+    {
+        uint8_t data[] = { 0x11, 0xff, 0x33 };
+        CHECK_EQ(invoke<uint32_t>(cas, static_cast<void*>(data), static_cast<uint64_t>(1), static_cast<uint64_t>(0x12345678ffull), static_cast<uint64_t>(0xfe)), 1u);
+        CHECK_EQ(static_cast<unsigned>(data[1]), 0xfeu);
+    }
+}
+

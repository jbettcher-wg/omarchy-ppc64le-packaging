+                jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+                emitFunctionEpilogue(jit);
+                jit.ret();
+            });
+            invoke<void>(test, &in, &out[0]);
+            for (unsigned i = 0; i < 2; ++i) {
+                uint64_t lane;
+                memcpy(&lane, &out[i * 8], 8);
+                CHECK_EQ(lane, 0x3ff8000000000000ULL);
+            }
+        }
+
+        PPC64Assembler::forcePOWER8Paths() = false;
+    }
+}
+
+// The generated per-type names must reach the same primitive.
+void testPPC64VectorSplatGeneratedNames()
+{
+    alignas(16) uint8_t out[16];
+    auto test = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.vectorSplatInt32(GPRInfo::argumentGPR0, FPRInfo::argumentFPR0);
+        jit.storeVector(FPRInfo::argumentFPR0, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    invoke<void>(test, 0x0102030405060708ULL, &out[0]);
+    const uint8_t expected[16] = { 8,7,6,5,8,7,6,5,8,7,6,5,8,7,6,5 };
+    for (unsigned i = 0; i < 16; ++i)
+        CHECK_EQ(out[i], expected[i]);
+}
+
+// Group 2: lane extract and replace.
+//
+// The vector is bytes 0x00..0x0f -- all distinct -- so every lane at every
+// width holds a different value and a wrong lane index cannot hide. The
+// expected value is read out of the SAME buffer with memcpy, which is an
+// independent oracle: it shares no code with the JIT path.
+void testPPC64VectorExtractLaneUnsigned()
+{
+    alignas(16) uint8_t src[16];
+    for (unsigned i = 0; i < 16; ++i)
+        src[i] = static_cast<uint8_t>(i);
+
+    auto extract = [&](SIMDLane lane, unsigned index) -> uint64_t {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorExtractLane(lane, SIMDSignMode::Unsigned, CCallHelpers::TrustedImm32(index),
+                FPRInfo::argumentFPR0, GPRInfo::returnValueGPR);
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        return invoke<uint64_t>(test, &src[0]);
+    };
+
+    for (unsigned i = 0; i < 16; ++i) {
+        uint8_t expected;
+        memcpy(&expected, &src[i], 1);
+        CHECK_EQ(extract(SIMDLane::i8x16, i), static_cast<uint64_t>(expected));
+    }
+    for (unsigned i = 0; i < 8; ++i) {
+        uint16_t expected;
+        memcpy(&expected, &src[i * 2], 2);
+        CHECK_EQ(extract(SIMDLane::i16x8, i), static_cast<uint64_t>(expected));
+    }
+    for (unsigned i = 0; i < 4; ++i) {
+        uint32_t expected;
+        memcpy(&expected, &src[i * 4], 4);
+        CHECK_EQ(extract(SIMDLane::i32x4, i), static_cast<uint64_t>(expected));
+    }
+    for (unsigned i = 0; i < 2; ++i) {
+        uint64_t expected;
+        memcpy(&expected, &src[i * 8], 8);
+        CHECK_EQ(extract(SIMDLane::i64x2, i), expected);
+    }
+}
+
+// Every byte has its high bit set, so sign extension is actually exercised.
+void testPPC64VectorExtractLaneSigned()
+{

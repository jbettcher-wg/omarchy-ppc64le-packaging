+    void storeImpl(StoreKind kind, RegisterID src, const void* pointer)
+    {
+        auto temp = temps<Memory>();
+        loadImmediate(TrustedImmPtr(pointer), temp.memory());
+        emitStoreDForm(kind, src, temp.memory(), 0);
+    }

+    void addDouble(FPRegisterID src, FPRegisterID dest) { m_assembler.fadd(dest, dest, src); }
+    void addFloat(FPRegisterID a, FPRegisterID b, FPRegisterID dest) { m_assembler.xvaddsp(dest, a, b); }

+// The relaxed min/max are the one-instruction forms the specification allows,
+// and this pins THAT choice: a NaN operand yields the other operand (minNum).
+// If the lowering is ever changed to the strict NaN-propagating form these
+// rows fire, on purpose.
+void testPPC64VectorRelaxedMinMax()
+{
+    alignas(16) const float a[4] = { std::numeric_limits<float>::quiet_NaN(), 2.0f, 1.0f, -4.25f };
+    alignas(16) const float b[4] = { 2.0f, std::numeric_limits<float>::quiet_NaN(), -1.0f, 4.25f };
+    alignas(16) uint8_t out[16];
+    ppc64RunVectorBinary(a, b, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedMin(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, x, y, d);
+    });
+    ppc64CheckLane<float>(out, 0, 2.0f);
+    ppc64CheckLane<float>(out, 1, 2.0f);
+    ppc64CheckLane<float>(out, 2, -1.0f);
+    ppc64CheckLane<float>(out, 3, -4.25f);
+    ppc64RunVectorBinary(a, b, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedMax(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, x, y, d);
+    });
+    ppc64CheckLane<float>(out, 0, 2.0f);
+    ppc64CheckLane<float>(out, 1, 2.0f);
+    ppc64CheckLane<float>(out, 2, 1.0f);
+    ppc64CheckLane<float>(out, 3, 4.25f);
+
+    alignas(16) const double da[2] = { 1.0, -3.5 };
+    alignas(16) const double db[2] = { -1.0, 3.5 };
+    ppc64RunVectorBinary(da, db, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedMin(SIMDInfo { SIMDLane::f64x2, SIMDSignMode::None }, x, y, d);
+    });
+    ppc64CheckLane<double>(out, 0, -1.0);
+    ppc64CheckLane<double>(out, 1, -3.5);
+    ppc64RunVectorBinary(da, db, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedMax(SIMDInfo { SIMDLane::f64x2, SIMDSignMode::None }, x, y, d);
+    });
+    ppc64CheckLane<double>(out, 0, 1.0);
+    ppc64CheckLane<double>(out, 1, 3.5);
+}
+
+// The relaxed byte dot products. Lane 0 of `a` is 225, which is the byte the
+// handbook's reference got wrong: it is -31, and the product must say so.
+void testPPC64VectorRelaxedDot()
+{
+    alignas(16) const uint8_t a[16] = { 225, 2, 0xfd, 4, 5, 0xfa, 7, 8, 0x80, 0x7f, 11, 0xf4, 13, 14, 0xf1, 16 };
+    alignas(16) const uint8_t b[16] = { 100, 50, 3, 4, 127, 6, 7, 8, 127, 127, 11, 12, 13, 14, 15, 16 };
+    alignas(16) const int32_t c[4] = { 1000, -1000, 0x7fffff00, 7 };
+    alignas(16) uint8_t out[16];
+
+    ppc64RunVectorBinary(a, b, out, [](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+        jit.vectorRelaxedDotI8x16I7x16(x, y, d, FPRInfo::argumentFPR3);
+    });
+    int16_t dot16[8];
+    for (unsigned i = 0; i < 8; ++i) {
+        int32_t r = static_cast<int8_t>(a[2 * i]) * static_cast<int8_t>(b[2 * i]) + static_cast<int8_t>(a[2 * i + 1]) * static_cast<int8_t>(b[2 * i + 1]);
+        dot16[i] = static_cast<int16_t>(r);
+        ppc64CheckLane<int16_t>(out, i, dot16[i]);
+    }
+    ppc64CheckLane<int16_t>(out, 0, static_cast<int16_t>(-31 * 100 + 2 * 50));
+
+    auto test = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR3, 0), FPRInfo::argumentFPR2);
+        jit.vectorRelaxedDotI8x16I7x16Add(FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2, FPRInfo::argumentFPR3, FPRInfo::argumentFPR4, FPRInfo::argumentFPR5);
+        jit.storeVector(FPRInfo::argumentFPR3, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    invoke<void>(test, &a[0], &out[0], &b[0], &c[0]);
+    for (unsigned i = 0; i < 4; ++i) {
+        int32_t expected = static_cast<int32_t>(dot16[2 * i]) + dot16[2 * i + 1] + c[i];
+        ppc64CheckLane<int32_t>(out, i, expected);
+    }
+}

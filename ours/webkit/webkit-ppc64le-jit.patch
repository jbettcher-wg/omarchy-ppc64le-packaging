+// ELFv2 requires the CALLER to extend a sub-doubleword integer argument to the
+// full register, per the parameter's declared signedness, and lets the callee
+// rely on it. x86-64 SysV and AAPCS64 both let the callee read only the low 32
+// bits, so this is a ppc64-only contract -- and one the port got wrong twice.
+//
+// B3's in-place CCall lowering sign-extends Int32 now. Air's OUT-OF-LINE path
+// did not: AirLowerAfterRegAlloc builds its pre-call shuffle with
+// widthForType(), so an Int32 moved as Width32 and Move32 zero-extends. That
+// path needs a RARE block at optLevel >= 2, which no JSTests case reached, so
+// the defect was invisible to both suites.
+//
+// -16 is the witness: sign-extended it is 0xfffffffffffffff0, zero-extended
+// 0x00000000fffffff0.
+void testCallRareInt32ArgumentIsExtended()
+{
+    Procedure proc;
+    BasicBlock* root = proc.addBlock();
+    BasicBlock* common = proc.addBlock();
+    BasicBlock* rare = proc.addBlock();
+    auto arguments = cCallArgumentValues<intptr_t>(proc, root).eager();
+
+    root->appendNewControlValue(
+        proc, Branch, Origin(),
+        arguments[0],
+        FrequentedBlock(rare, FrequencyClass::Rare),
+        FrequentedBlock(common));
+
+    common->appendNewControlValue(
+        proc, Return, Origin(), common->appendNew<Const64Value>(proc, Origin(), 0));
+
+    rare->appendNewControlValue(
+        proc, Return, Origin(),
+        rare->appendNew<CCallValue>(
+            proc, Int64, Origin(),
+            rare->appendNew<ConstPtrValue>(proc, Origin(), tagCFunction<OperationPtrTag>(reportRawArgument)),
+            rare->appendNew<Const32Value>(proc, Origin(), -16)));
+
+    CHECK_EQ(compileAndRun<int64_t>(proc, true), static_cast<int64_t>(-16));
+}

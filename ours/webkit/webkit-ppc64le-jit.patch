+    // lwz zero-extends, so load32 satisfies the 32-bit invariant for free.
+    void load32(Address address, RegisterID dest) { loadImpl(LoadKind::U32, address, dest); }
+    void load32(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::U32, address, dest); }
+    void load32(const void* address, RegisterID dest) { loadImpl(LoadKind::U32, address, dest); }

+    // Rotates are native on PowerPC, in both widths.
+    void rotateRight32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 31;
+        m_assembler.rotlwi(dest, src, (32 - shift) & 31);
+        maskLow32(dest);
+    }
+
+    void rotateRight32(TrustedImm32 imm, RegisterID srcDst) { rotateRight32(srcDst, imm, srcDst); }
+
+    void rotateRight32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        // Rotating right by n is rotating left by 32 - n. subfic computes
+        // 32 - shiftAmount in one instruction.
+        rotateRight32(src, shiftAmount, dest, shiftCountScratch(src, dest));
+    }
+
+    void rotateRight32(RegisterID src, RegisterID shiftAmount, RegisterID dest, RegisterID scratch)
+    {
+        m_assembler.subfic(scratch, shiftAmount, 32);
+        m_assembler.andi_(scratch, scratch, 31);
+        m_assembler.rlwnm(dest, src, scratch, 0, 31);
+        maskLow32(dest);
+    }
+
+    void rotateRight64(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 63;
+        m_assembler.rotldi(dest, src, (64 - shift) & 63);
+    }
+
+    void rotateRight64(TrustedImm32 imm, RegisterID srcDst) { rotateRight64(srcDst, imm, srcDst); }
+
+    void rotateRight64(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        rotateRight64(src, shiftAmount, dest, shiftCountScratch(src, dest));
+    }
+
+    void rotateRight64(RegisterID src, RegisterID shiftAmount, RegisterID dest, RegisterID scratch)
+    {
+        m_assembler.subfic(scratch, shiftAmount, 64);
+        m_assembler.andi_(scratch, scratch, 63);
+        m_assembler.rldcl(dest, src, scratch, 0);
+    }
+
+    // Rotate LEFT is the native direction on this target -- rlwnm and rldcl
+    // rotate left -- which is why rotateRight above spends a subfic and a
+    // scratch register to turn n into width - n, and why these need neither.
+    // rlwnm reads the low five bits of the shift register and rldcl the low
+    // six, so the count needs no masking either.
+    void rotateLeft32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        m_assembler.rotlwi(dest, src, static_cast<uint32_t>(imm.m_value) & 31);
+        maskLow32(dest);
+    }
+
+    void rotateLeft32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        m_assembler.rlwnm(dest, src, shiftAmount, 0, 31);
+        maskLow32(dest);
+    }
+
+    void rotateLeft64(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        m_assembler.rotldi(dest, src, static_cast<uint32_t>(imm.m_value) & 63);
+    }
+
+    void rotateLeft64(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        m_assembler.rldcl(dest, src, shiftAmount, 0);
+    }
+
+    // The address-dependency trick B3 uses for consume ordering: XOR a register
+    // with itself is zero, and carries a data dependency on it. ARM64 spells it
+    // eor<32>(dest, src, src); PPC's xor is width-agnostic and the result is
+    // zero either way, so one instruction serves both widths.
+    void depend32(RegisterID src, RegisterID dest) { m_assembler.xor_(dest, src, src); }
+    void depend64(RegisterID src, RegisterID dest) { m_assembler.xor_(dest, src, src); }
+
+    // Lea64 of a base+index. x86-64 needs this form for its addressing modes;
+    // this target needs it because AirLowerStackArgs' extended-offset path
+    // BUILDS one -- POWER's X-form is base+index with no displacement, so a
+    // stack offset too large for D-form is materialised into
+    // extendedOffsetAddrRegister() (r0) and ridden as the INDEX while sp stays
+    // the base. r0 may be an index and never a base, which is why that path
+    // cannot hand back an Arg::addr the way the ARM64 arm does. A 736-byte
+    // frame already exceeds D-form reach for the SP-relative form, so
+    // testStackSlot reaches it with one 1-byte slot.
+    //
+    // Everything stages in dest, which is what makes this safe regardless of
+    // the scratch policy. Arg::isValidScale accepts only scale 1 on this
+    // target, so the scaled branch below is unreachable from Air; it is kept
+    // for any direct caller.
+    void leaIndex64(BaseIndex address, RegisterID dest)
+    {
+        if (address.scale == TimesOne)
+            m_assembler.add(dest, address.base, address.index);
+        else {
+            // Shifting into dest first would clobber base before it is read, and
+            // there is no third register to borrow. Nothing Air builds has both a
+            // scale and dest == base; if that changes this needs a Scratch operand.
+            RELEASE_ASSERT(dest != address.base);
+            m_assembler.sldi(dest, address.index, static_cast<uint32_t>(address.scale));
+            m_assembler.add(dest, address.base, dest);
+        }
+        if (address.offset)
+            addImmediate64(dest, static_cast<int64_t>(address.offset), dest);
+    }
+
+    // ---- loads ----
+    //
+    // Every load comes in three flavours (Address / BaseIndex / raw pointer)
+    // and they all funnel into loadImpl, which picks the D-form (base +
+    // displacement) or X-form (base + index) encoding. POWER8 and later
+    // handle unaligned loads and stores in hardware for all of these widths,
+    // so there is no aligned/unaligned distinction to make -- which is why
+    // load16Unaligned and load32WithUnalignedHalfWords are just the ordinary
+    // loads.
+
+    enum class LoadKind { U8, S8, U16, S16, U32, S32, U64 };
+
+    // POWER's X-form indexed loads and stores are base + index, with no
+    // displacement field and no scaling, which is exactly the shape Air asks
+    // for on this target: Arg::isValidScale accepts only 1 here, and
+    // Arg::isValidIndexForm allows a displacement only for Lea, which
+    // computes an address rather than accessing memory.
+    //
+    // Taking the form still matters for the add it saves. It is no longer a
+    // hard requirement, though: AirGenerate.cpp and
+    // AirAllocateRegistersAndStackAndGenerateCode.cpp both re-enable the macro
+    // scratch under isPPC64() -- r29 and r30 are isReserved, so the allocator
+    // cannot have handed either to a live Tmp -- which is what lets the
+    // Address forms fold an out-of-form displacement through
+    // memoryTempRegister instead of refusing it.
+    //
+    // RA is the base and RB the index, never the other way round: r0 in the RA
+    // field of any load or store encodes the literal zero rather than the
+    // register, which is measured in the handbook and is the whole reason
+    // extendedOffsetAddrRegister() can be r0 at all.
+    //
+    // isXFormBaseIndex is true for exactly the BaseIndex shapes the X-form
+    // encodes directly, which is also exactly the set Air is allowed to build
+    // on this target.
+    static bool isXFormBaseIndex(BaseIndex address)
+    {
+        return address.scale == TimesOne && !address.offset;
+    }
+
+    void emitLoadDForm(LoadKind kind, RegisterID base, int32_t offset, RegisterID dest)
+    {
+        switch (kind) {
+        case LoadKind::U8:  m_assembler.lbz(dest, base, offset); return;
+        case LoadKind::S8:  m_assembler.lbz(dest, base, offset); m_assembler.extsb(dest, dest); return;
+        case LoadKind::U16: m_assembler.lhz(dest, base, offset); return;
+        case LoadKind::S16: m_assembler.lha(dest, base, offset); return;
+        case LoadKind::U32: m_assembler.lwz(dest, base, offset); return;
+        case LoadKind::S32: m_assembler.lwa(dest, base, offset); return;
+        case LoadKind::U64: m_assembler.ld(dest, base, offset); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void emitLoadXForm(LoadKind kind, RegisterID base, RegisterID index, RegisterID dest)
+    {
+        ASSERT(base != PPC64Registers::r0);
+        switch (kind) {
+        case LoadKind::U8:  m_assembler.lbzx(dest, base, index); return;
+        case LoadKind::S8:  m_assembler.lbzx(dest, base, index); m_assembler.extsb(dest, dest); return;
+        case LoadKind::U16: m_assembler.lhzx(dest, base, index); return;
+        case LoadKind::S16: m_assembler.lhax(dest, base, index); return;
+        case LoadKind::U32: m_assembler.lwzx(dest, base, index); return;
+        case LoadKind::S32: m_assembler.lwax(dest, base, index); return;
+        case LoadKind::U64: m_assembler.ldx(dest, base, index); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    static bool loadKindNeedsDSForm(LoadKind kind) { return kind == LoadKind::U64 || kind == LoadKind::S32; }
+
+    void loadImpl(LoadKind kind, Address address, RegisterID dest)
+    {
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, loadKindNeedsDSForm(kind));
+        emitLoadDForm(kind, resolution.base, resolution.offset, dest);
+    }
+
+    void loadImpl(LoadKind kind, BaseIndex address, RegisterID dest)
+    {
+        if (isXFormBaseIndex(address)) {
+            emitLoadXForm(kind, address.base, address.index, dest);
+            return;
+        }
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), loadKindNeedsDSForm(kind));
+        emitLoadDForm(kind, resolution.base, resolution.offset, dest);
+    }
+
+    void loadImpl(LoadKind kind, const void* pointer, RegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        loadImmediate(TrustedImmPtr(pointer), temp.memory());
+        emitLoadDForm(kind, temp.memory(), 0, dest);
+    }
+
+    void load8(Address address, RegisterID dest) { loadImpl(LoadKind::U8, address, dest); }
+    void load8(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::U8, address, dest); }
+    void load8(const void* address, RegisterID dest) { loadImpl(LoadKind::U8, address, dest); }
+
+    // "SignedExtendTo32" means the byte is sign-extended into the low word
+    // and the register still satisfies the 32-bit zero-extension invariant,
+    // i.e. bits 32:63 are clear. extsb sign-extends all the way to 64, so the
+    // upper half has to be cleared again afterwards. Missing that would leave
+    // a value that compares correctly with cmpw but boxes into a corrupt
+    // JSValue.

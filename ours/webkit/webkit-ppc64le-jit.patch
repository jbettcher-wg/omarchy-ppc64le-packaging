+            jit.vectorExtractLane(lane, SIMDSignMode::Signed, CCallHelpers::TrustedImm32(index),
+                FPRInfo::argumentFPR0, GPRInfo::returnValueGPR);
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        return invoke<int64_t>(test, &src[0]);
+    };
+
+    for (unsigned i = 0; i < 16; ++i) {

+// that wrap to make INT32_MIN % -1 come out as zero; POWER's "Divide Word"
+// leaves exactly this case undefined.
+void testDiv32(int32_t dividend, int32_t divisor, int32_t expected)
+{
+    CHECK_EQ(compileAndRun<int32_t>([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.move(CCallHelpers::TrustedImm32(dividend), GPRInfo::regT0);
+        jit.move(CCallHelpers::TrustedImm32(divisor), GPRInfo::regT1);
+        jit.div32(GPRInfo::regT0, GPRInfo::regT1, GPRInfo::returnValueGPR);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    }), expected);

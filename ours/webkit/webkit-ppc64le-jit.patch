+    // Storing an immediate always goes through the data temp. The memory temp
+    // is reserved for the address, so the two never collide -- that pairing is
+    // the whole reason there are two of them.
+    template<typename ImmType, typename AddressType>
+    void storeImmImpl(StoreKind kind, ImmType imm, AddressType address)
+    {
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        storeImpl(kind, temp.data(), address);
+    }

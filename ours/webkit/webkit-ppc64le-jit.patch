+    void load16SignedExtendTo64(Address address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); }
+    void load16SignedExtendTo64(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); }
+    void load16SignedExtendTo64(const void* address, RegisterID dest) { loadImpl(LoadKind::S16, address, dest); }

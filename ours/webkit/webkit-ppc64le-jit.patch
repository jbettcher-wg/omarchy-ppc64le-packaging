+        m_assembler.srad(dest, src, maskedShiftCount(shiftAmount, 63, scratch));
+    }
+
+    void rshift64(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 0x3f;
+        if (!shift) {
+            move(src, dest);
+            return;
+        }
+        m_assembler.sradi(dest, src, shift);
+    }
+
+    void rshift64(RegisterID shiftAmount, RegisterID dest) { rshift64(dest, shiftAmount, dest); }
+    void rshift64(TrustedImm32 imm, RegisterID dest) { rshift64(dest, imm, dest); }
+
+    // Logical (zero-filling) right shift. The 32-bit form relies on the
+    // invariant: srw shifts the whole 64-bit register, so bits 32:63 must
+    // already be zero for the low word to be shifted in isolation. They are,
+    // by construction.
+    void urshift32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        RegisterID count = maskedShiftCount(shiftAmount, 31, shiftCountScratch(src, dest));
+        m_assembler.srw(dest, src, count);
+        maskLow32(dest);
+    }
+
+    void urshift32(RegisterID src, RegisterID shiftAmount, RegisterID dest, RegisterID scratch)
+    {
+        m_assembler.srw(dest, src, maskedShiftCount(shiftAmount, 31, scratch));
+        maskLow32(dest);
+    }
+
+    void urshift32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 0x1f;
+        if (!shift) {
+            move(src, dest);
+            return;
+        }
+        m_assembler.srwi(dest, src, shift);
+        maskLow32(dest);
+    }
+
+    void urshift32(TrustedImm32 imm, RegisterID shiftAmount, RegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        loadImmediate(imm, temp.memory());
+        urshift32(temp.memory(), shiftAmount, dest);
+    }
+
+    void urshift32(RegisterID shiftAmount, RegisterID dest) { urshift32(dest, shiftAmount, dest); }
+    void urshift32(TrustedImm32 imm, RegisterID dest) { urshift32(dest, imm, dest); }
+
+    void urshift64(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        RegisterID count = maskedShiftCount(shiftAmount, 63, shiftCountScratch(src, dest));
+        m_assembler.srd(dest, src, count);
+    }
+
+    void urshift64(RegisterID src, RegisterID shiftAmount, RegisterID dest, RegisterID scratch)
+    {
+        m_assembler.srd(dest, src, maskedShiftCount(shiftAmount, 63, scratch));
+    }
+
+    void urshift64(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(imm.m_value) & 0x3f;
+        if (!shift) {
+            move(src, dest);
+            return;
+        }

+    void load8SignedExtendTo32(const void* address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); maskLow32(dest); }
+
+    void load8SignedExtendTo64(Address address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); }
+    void load8SignedExtendTo64(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); }
+    void load8SignedExtendTo64(const void* address, RegisterID dest) { loadImpl(LoadKind::S8, address, dest); }
+
+    void load16(Address address, RegisterID dest) { loadImpl(LoadKind::U16, address, dest); }
+    void load16(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::U16, address, dest); }
+    void load16(const void* address, RegisterID dest) { loadImpl(LoadKind::U16, address, dest); }
+
+    void load16(ExtendedAddress address, RegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), false);
+        m_assembler.lhz(dest, resolution.base, resolution.offset);
+    }

+JSC_DEFINE_NOEXCEPT_JIT_OPERATION(floatArgsDoubleResult, double, (float a, float b))
+{
+    return static_cast<double>(a) + static_cast<double>(b);
+}
+JSC_DEFINE_NOEXCEPT_JIT_OPERATION(doubleArgsFloatResult, float, (double a, double b))
+{
+    return static_cast<float>(a + b);

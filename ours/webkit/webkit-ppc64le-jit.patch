+}
+
+// Replace must change exactly the target lane and leave the other fifteen
+// bytes alone, so the whole vector is compared, not just the lane.
+void testPPC64VectorReplaceLane()
+{
+    auto replace = [&](SIMDLane lane, unsigned index, unsigned laneBytes, uint64_t value) {
+        alignas(16) uint8_t src[16];
+        alignas(16) uint8_t out[16];
+        for (unsigned i = 0; i < 16; ++i) {
+            src[i] = static_cast<uint8_t>(i);
+            out[i] = 0xa5;
+        }
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorReplaceLane(lane, CCallHelpers::TrustedImm32(index), GPRInfo::argumentGPR2, FPRInfo::argumentFPR0);
+            jit.storeVector(FPRInfo::argumentFPR0, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &src[0], &out[0], value);
+
+        uint8_t expected[16];
+        memcpy(expected, src, 16);
+        memcpy(&expected[index * laneBytes], &value, laneBytes);
+        for (unsigned i = 0; i < 16; ++i)
+            CHECK_EQ(out[i], expected[i]);
+    };
+
+    for (unsigned i = 0; i < 16; ++i)
+        replace(SIMDLane::i8x16, i, 1, 0xc3);
+    for (unsigned i = 0; i < 8; ++i)
+        replace(SIMDLane::i16x8, i, 2, 0xc3d4);
+    for (unsigned i = 0; i < 4; ++i)
+        replace(SIMDLane::i32x4, i, 4, 0xc3d4e5f6ULL);
+    for (unsigned i = 0; i < 2; ++i)
+        replace(SIMDLane::i64x2, i, 8, 0xc3d4e5f60718293aULL);
+}
+
+void testPPC64VectorLaneFloat()
+{
+    alignas(16) uint8_t src[16];
+    for (unsigned i = 0; i < 16; ++i)
+        src[i] = static_cast<uint8_t>(0x11 * (i + 1));
+
+    // f32 extract: the raw pattern of memory word `index` must come back.
+    for (unsigned i = 0; i < 4; ++i) {
+        alignas(16) uint8_t out[16];
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorExtractLane(SIMDLane::f32x4, CCallHelpers::TrustedImm32(i), FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &src[0], &out[0]);
+        uint32_t expected;
+        memcpy(&expected, &src[i * 4], 4);
+        // xxspltw leaves the wanted word in every lane.
+        for (unsigned w = 0; w < 4; ++w) {
+            uint32_t got;
+            memcpy(&got, &out[w * 4], 4);
+            CHECK_EQ(got, expected);
+        }
+    }
+
+    // f64 extract, then f64 replace, checking the untouched half survives.
+    for (unsigned i = 0; i < 2; ++i) {
+        alignas(16) uint8_t out[16];
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorExtractLane(SIMDLane::f64x2, CCallHelpers::TrustedImm32(i), FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &src[0], &out[0]);
+        uint64_t expected;
+        memcpy(&expected, &src[i * 8], 8);
+        uint64_t got;
+        memcpy(&got, &out[0], 8);
+        CHECK_EQ(got, expected);
+    }
+
+    // The FPR source of a lane replace is a SCALAR double, which on this port
+    // lives in ISA doubleword 0 -- that is what moveDoubleTo64's mfvsrd reads.
+    // So it is loaded with loadDouble, not loadVector: building it as a
+    // 16-byte memory image and then calling its MEMORY doubleword 0 the scalar
+    // is a different claim, and a wrong one. Getting that backwards was this
+    // test's own bug, caught by the whole-vector comparison.
+    for (unsigned i = 0; i < 2; ++i) {
+        alignas(16) uint8_t out[16];
+        uint64_t scalarBits = 0xf0f1f2f3f4f5f6f7ULL;
+        double scalar;
+        memcpy(&scalar, &scalarBits, 8);
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadDouble(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            jit.vectorReplaceLane(SIMDLane::f64x2, CCallHelpers::TrustedImm32(i), FPRInfo::argumentFPR1, FPRInfo::argumentFPR0);
+            jit.storeVector(FPRInfo::argumentFPR0, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &src[0], &out[0], &scalar);
+        uint8_t expected[16];
+        memcpy(expected, src, 16);
+        memcpy(&expected[i * 8], &scalarBits, 8);
+        for (unsigned k = 0; k < 16; ++k)
+            CHECK_EQ(out[k], expected[k]);
+    }
+}
+
+// Group 3: vector bitwise. Operands are byte-distinct AND chosen so no two
+// operations agree: 0x0f-style masks would make and/andnot/select produce the
+// same answer for many bytes and hide an operand swap. The expected value is
+// computed in C from the same bytes, which shares no code with the JIT path.
+void testPPC64VectorBitwise()
+{
+    alignas(16) uint8_t a[16], b[16], out[16];
+    for (unsigned i = 0; i < 16; ++i) {
+        a[i] = static_cast<uint8_t>(0x10 * (i % 16) + i);
+        b[i] = static_cast<uint8_t>(0xa5 ^ (i * 7));
+    }
+
+    enum Op { And, Or, Xor, Andnot, Not };
+    auto run = [&](Op op) {
+        for (unsigned i = 0; i < 16; ++i)
+            out[i] = 0x5a;
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            SIMDInfo info { SIMDLane::v128, SIMDSignMode::None };
+            switch (op) {
+            case And:    jit.vectorAnd(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2); break;
+            case Or:     jit.vectorOr(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2); break;
+            case Xor:    jit.vectorXor(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2); break;
+            case Andnot: jit.vectorAndnot(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2); break;
+            case Not:    jit.vectorNot(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR2); break;
+            }
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+        for (unsigned i = 0; i < 16; ++i) {
+            uint8_t expected = 0;
+            switch (op) {
+            case And:    expected = a[i] & b[i]; break;
+            case Or:     expected = a[i] | b[i]; break;
+            case Xor:    expected = a[i] ^ b[i]; break;
+            case Andnot: expected = a[i] & static_cast<uint8_t>(~b[i]); break;
+            case Not:    expected = static_cast<uint8_t>(~a[i]); break;
+            }
+            CHECK_EQ(out[i], expected);
+        }
+    };
+    run(And); run(Or); run(Xor); run(Andnot); run(Not);
+}
+
+// bitwiseSelect's selector sense is the one thing here that can be backwards
+// and still look plausible, so the selector is NOT uniform: it mixes all-ones,
+// all-zeros and mixed bytes, which separates "takes left" from "takes right".
+void testPPC64VectorBitwiseSelect()
+{
+    alignas(16) uint8_t left[16], right[16], sel[16], out[16];
+    for (unsigned i = 0; i < 16; ++i) {
+        left[i] = static_cast<uint8_t>(0xc0 + i);
+        right[i] = static_cast<uint8_t>(0x30 + i);
+        sel[i] = (i % 4 == 0) ? 0xff : (i % 4 == 1) ? 0x00 : (i % 4 == 2) ? 0x0f : 0xf0;
+        out[i] = 0x5a;
+    }
+    auto test = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);   // left
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);   // right
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR3, 0), FPRInfo::argumentFPR2);   // selector = dest
+        jit.vectorBitwiseSelect(FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+        jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    invoke<void>(test, &left[0], &out[0], &right[0], &sel[0]);
+    for (unsigned i = 0; i < 16; ++i) {
+        // A set selector bit takes `left`, matching ARM64's bsl.
+        uint8_t expected = static_cast<uint8_t>((sel[i] & left[i]) | (static_cast<uint8_t>(~sel[i]) & right[i]));
+        CHECK_EQ(out[i], expected);
+    }
+}
+
+// Group 4: float-only vector operations.
+//
+// The rounding values are chosen against the SPEC, not against the hardware.
+// 2.5 and 3.5 separate ties-to-even from ties-away-from-zero: a round-half-up
+// implementation gives 3 and 4, ties-to-even gives 2 and 4. The negatives
+// separate floor from trunc, which agree on every positive value.
+void testPPC64VectorFloatRounding()
+{
+    alignas(16) float in32[4] = { 2.5f, 3.5f, -2.5f, -1.5f };
+    alignas(16) double in64[2] = { 2.5, -2.5 };
+    alignas(16) uint8_t out[16];
+
+    enum Op { Ceil, Floor, Trunc, Nearest };
+    auto run32 = [&](Op op, const float (&expected)[4]) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            SIMDInfo info { SIMDLane::f32x4, SIMDSignMode::None };
+            switch (op) {
+            case Ceil:    jit.vectorCeil(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1); break;
+            case Floor:   jit.vectorFloor(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1); break;
+            case Trunc:   jit.vectorTrunc(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1); break;
+            case Nearest: jit.vectorNearest(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1); break;
+            }
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &in32[0], &out[0]);
+        for (unsigned i = 0; i < 4; ++i) {
+            float got;
+            memcpy(&got, &out[i * 4], 4);
+            CHECK_EQ(got, expected[i]);
+        }
+    };
+    const float ceilE[4]    = {  3.0f,  4.0f, -2.0f, -1.0f };
+    const float floorE[4]   = {  2.0f,  3.0f, -3.0f, -2.0f };
+    const float truncE[4]   = {  2.0f,  3.0f, -2.0f, -1.0f };
+    const float nearestE[4] = {  2.0f,  4.0f, -2.0f, -2.0f };  // ties to EVEN
+    run32(Ceil, ceilE); run32(Floor, floorE); run32(Trunc, truncE); run32(Nearest, nearestE);
+
+    auto run64 = [&](Op op, const double (&expected)[2]) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            SIMDInfo info { SIMDLane::f64x2, SIMDSignMode::None };
+            switch (op) {
+            case Ceil:    jit.vectorCeil(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1); break;
+            case Floor:   jit.vectorFloor(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1); break;
+            case Trunc:   jit.vectorTrunc(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1); break;
+            case Nearest: jit.vectorNearest(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1); break;
+            }
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &in64[0], &out[0]);
+        for (unsigned i = 0; i < 2; ++i) {
+            double got;
+            memcpy(&got, &out[i * 8], 8);
+            CHECK_EQ(got, expected[i]);
+        }
+    };
+    const double ceilE64[2]    = {  3.0, -2.0 };
+    const double floorE64[2]   = {  2.0, -3.0 };
+    const double truncE64[2]   = {  2.0, -2.0 };
+    const double nearestE64[2] = {  2.0, -2.0 };
+    run64(Ceil, ceilE64); run64(Floor, floorE64); run64(Trunc, truncE64); run64(Nearest, nearestE64);
+}
+
+// Div and sqrt, with a different value in every lane so a cross-lane mix-up
+// changes an answer rather than preserving it.
+void testPPC64VectorFloatDivSqrt()
+{
+    alignas(16) uint8_t out[16];
+    {
+        alignas(16) float a[4] = { 12.0f, 20.0f, -9.0f, 7.0f };
+        alignas(16) float b[4] = {  4.0f,  8.0f,  3.0f, 2.0f };
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            jit.vectorDiv(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+        for (unsigned i = 0; i < 4; ++i) {
+            float got;
+            memcpy(&got, &out[i * 4], 4);
+            CHECK_EQ(got, a[i] / b[i]);
+        }
+    }
+    {
+        alignas(16) float a[4] = { 4.0f, 9.0f, 16.0f, 25.0f };
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorSqrt(SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None }, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);

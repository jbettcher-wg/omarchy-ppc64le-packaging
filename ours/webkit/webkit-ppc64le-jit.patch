+// branchTest32 against a memory operand loads the value through one
+// MacroAssembler temporary and tests into the other, so a mask that has to be
+// built in a register has no third register left to be built in. 0x40010 is
+// such a mask -- two bits too far apart for andi./andis. and not a
+// rotate-and-mask run -- and it is the one op_enumerator_put_by_val tests, so
+// this used to abort the Baseline compiler rather than mis-execute.
+void testBranchTestAddressWithScatteredMask(uint32_t value, uint32_t mask)
+{
+    uint32_t cell = value;
+    CHECK_EQ(compileAndRun<int>([&] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        // regT0 IS returnValueGPR on this target, so the pointer lives in regT1.
+        jit.move(CCallHelpers::TrustedImmPtr(&cell), GPRInfo::regT1);
+        jit.move(CCallHelpers::TrustedImm32(0), GPRInfo::returnValueGPR);
+        auto isZero = jit.branchTest32(CCallHelpers::Zero, CCallHelpers::Address(GPRInfo::regT1), CCallHelpers::TrustedImm32(mask));
+        jit.move(CCallHelpers::TrustedImm32(1), GPRInfo::returnValueGPR);
+        isZero.link(&jit);
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    }), (value & mask) ? 1 : 0);
+}

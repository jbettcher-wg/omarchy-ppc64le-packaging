+    // d = n + (m >>> amount), 32-bit.
+    void addUnsignedRightShift32(RegisterID n, RegisterID m, TrustedImm32 amount, RegisterID d)
+    {
+        auto temp = temps<Memory>();
+        urshift32(m, amount, temp.memory());
+        add32(n, temp.memory(), d);
+    }

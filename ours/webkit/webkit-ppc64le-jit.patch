+// The float arms of the same five functions, which land in the same commit.
+void testPPC64VectorFloatArith()
+{
+    alignas(16) float a[4] = { 1.5f, -2.25f, 3.0f, -4.5f };
+    alignas(16) float b[4] = { 0.5f, 4.0f, -1.5f, 2.0f };
+    alignas(16) uint8_t out[16];
+    enum Op { Add, Sub, Mul, Neg, Abs };
+    auto run = [&](Op op, const float (&expected)[4]) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            SIMDInfo info { SIMDLane::f32x4, SIMDSignMode::None };
+            switch (op) {
+            case Add: jit.vectorAdd(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2); break;
+            case Sub: jit.vectorSub(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2); break;
+            case Mul: jit.vectorMul(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2); break;
+            case Neg: jit.vectorNeg(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR2); break;
+            case Abs: jit.vectorAbs(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR2); break;
+            }
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+        for (unsigned i = 0; i < 4; ++i) {
+            float g; memcpy(&g, out + i * 4, 4);
+            CHECK_EQ(g, expected[i]);
+        }
+    };
+    const float addE[4] = { 2.0f, 1.75f, 1.5f, -2.5f };
+    const float subE[4] = { 1.0f, -6.25f, 4.5f, -6.5f };
+    const float mulE[4] = { 0.75f, -9.0f, -4.5f, -9.0f };
+    const float negE[4] = { -1.5f, 2.25f, -3.0f, 4.5f };
+    const float absE[4] = { 1.5f, 2.25f, 3.0f, 4.5f };
+    run(Add, addE); run(Sub, subE); run(Mul, mulE); run(Neg, negE); run(Abs, absE);
+}
+
+// Group 6: vector compares and the two CR6 reductions.
+//
+// Operand pairs are ASYMMETRIC per lane -- some lanes greater, some less,
+// some equal -- because half the wasm set is the other half with the operands
+// swapped, and a symmetric pair agrees with both lowerings. Values also cross
+// the sign boundary so signed and unsigned differ.
+void testPPC64VectorCompareInteger()
+{
+    alignas(16) uint8_t a[16], b[16], out[16];
+    for (unsigned i = 0; i < 16; ++i) {
+        a[i] = static_cast<uint8_t>(i * 17);            // 0x00..0xf0, crosses 0x80
+        b[i] = static_cast<uint8_t>((15 - i) * 17);     // the mirror, so a<b, a==b, a>b all occur
+    }
+
+    auto run = [&](MacroAssembler::RelationalCondition cond, SIMDLane lane) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            jit.compareIntegerVector(cond, SIMDInfo { lane, SIMDSignMode::None },
+                FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+    };
+
+    // i8x16, every condition. A true lane is all-ones, a false lane all-zero.
+    struct { MacroAssembler::RelationalCondition cond; int kind; } cases[] = {
+        { MacroAssembler::Equal, 0 }, { MacroAssembler::NotEqual, 1 },
+        { MacroAssembler::GreaterThan, 2 }, { MacroAssembler::LessThan, 3 },
+        { MacroAssembler::GreaterThanOrEqual, 4 }, { MacroAssembler::LessThanOrEqual, 5 },
+        { MacroAssembler::Above, 6 }, { MacroAssembler::Below, 7 },
+        { MacroAssembler::AboveOrEqual, 8 }, { MacroAssembler::BelowOrEqual, 9 },
+    };
+    for (auto& c : cases) {
+        run(c.cond, SIMDLane::i8x16);
+        for (unsigned i = 0; i < 16; ++i) {
+            int8_t sa = static_cast<int8_t>(a[i]), sb = static_cast<int8_t>(b[i]);
+            uint8_t ua = a[i], ub = b[i];
+            bool want = false;
+            switch (c.kind) {
+            case 0: want = ua == ub; break;
+            case 1: want = ua != ub; break;
+            case 2: want = sa > sb; break;
+            case 3: want = sa < sb; break;
+            case 4: want = sa >= sb; break;
+            case 5: want = sa <= sb; break;
+            case 6: want = ua > ub; break;
+            case 7: want = ua < ub; break;
+            case 8: want = ua >= ub; break;
+            case 9: want = ua <= ub; break;
+            }
+            CHECK_EQ(out[i], want ? 0xffu : 0x00u);
+        }
+    }
+
+    // i32x4 signed, which is where a byte-width confusion would show.
+    run(MacroAssembler::GreaterThan, SIMDLane::i32x4);
+    for (unsigned i = 0; i < 4; ++i) {
+        int32_t x, y; memcpy(&x, a + i * 4, 4); memcpy(&y, b + i * 4, 4);
+        uint32_t g; memcpy(&g, out + i * 4, 4);
+        CHECK_EQ(g, (x > y) ? 0xffffffffu : 0u);
+    }
+}
+
+void testPPC64VectorCompareFloat()
+{
+    const uint32_t qnan = 0x7fc00000;
+    alignas(16) uint32_t a[4] = { 0x3f800000 /*1.0*/, 0x40000000 /*2.0*/, 0x40000000 /*2.0*/, qnan };
+    alignas(16) uint32_t b[4] = { 0x40000000 /*2.0*/, 0x3f800000 /*1.0*/, 0x40000000 /*2.0*/, 0x40000000 };
+    alignas(16) uint32_t out[4];
+
+    auto run = [&](MacroAssembler::DoubleCondition cond, const bool (&want)[4]) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            jit.compareFloatingPointVector(cond, SIMDInfo { SIMDLane::f32x4, SIMDSignMode::None },
+                FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &a[0], &out[0], &b[0]);
+        for (unsigned i = 0; i < 4; ++i)
+            CHECK_EQ(out[i], want[i] ? 0xffffffffu : 0u);
+    };
+    // lane 3 has a NaN: every ORDERED comparison is false there, and only
+    // "not equal or unordered" is true -- which is the one that needs the
+    // complement, so it is the lane that separates the two lowerings.
+    const bool eqE[4]  = { false, false, true,  false };
+    const bool neE[4]  = { true,  true,  false, true  };
+    const bool gtE[4]  = { false, true,  false, false };
+    const bool geE[4]  = { false, true,  true,  false };
+    const bool ltE[4]  = { true,  false, false, false };
+    const bool leE[4]  = { true,  false, true,  false };
+    run(MacroAssembler::DoubleEqualAndOrdered, eqE);
+    run(MacroAssembler::DoubleNotEqualOrUnordered, neE);
+    run(MacroAssembler::DoubleGreaterThanAndOrdered, gtE);
+    run(MacroAssembler::DoubleGreaterThanOrEqualAndOrdered, geE);
+    run(MacroAssembler::DoubleLessThanAndOrdered, ltE);
+    run(MacroAssembler::DoubleLessThanOrEqualAndOrdered, leE);
+}
+
+// any_true and all_true are the only consumers of CR6, and they read opposite
+// bits of it. A vector with exactly ONE non-zero lane separates them: any is
+// true, all is false. All-zero and all-non-zero agree with a broken reduction
+// half the time, so both are present as well.
+void testPPC64VectorAnyAllTrue()
+{
+    auto anyTrue = [&](const uint8_t* v) -> uint64_t {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorAnyTrue(FPRInfo::argumentFPR0, GPRInfo::returnValueGPR);
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        return invoke<uint64_t>(test, v);
+    };
+    auto allTrue = [&](const uint8_t* v, SIMDLane lane) -> uint64_t {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.vectorAllTrue(SIMDInfo { lane, SIMDSignMode::None }, FPRInfo::argumentFPR0, GPRInfo::returnValueGPR);
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        return invoke<uint64_t>(test, v);
+    };
+
+    alignas(16) uint8_t zero[16] = { 0 };
+    alignas(16) uint8_t ones[16];
+    alignas(16) uint8_t oneLane[16] = { 0 };
+    for (unsigned i = 0; i < 16; ++i)
+        ones[i] = static_cast<uint8_t>(1 + i);
+    oneLane[5] = 0x01;                     // exactly one non-zero byte
+
+    CHECK_EQ(anyTrue(zero), 0ull);
+    CHECK_EQ(anyTrue(ones), 1ull);
+    CHECK_EQ(anyTrue(oneLane), 1ull);      // any is TRUE here
+    CHECK_EQ(allTrue(zero, SIMDLane::i8x16), 0ull);
+    CHECK_EQ(allTrue(ones, SIMDLane::i8x16), 1ull);
+    CHECK_EQ(allTrue(oneLane, SIMDLane::i8x16), 0ull);   // and all is FALSE
+
+    // Width matters for all_true: a 16-bit lane made of a zero and a non-zero
+    // byte is a NON-ZERO lane, so a byte-width reduction would answer false
+    // where the halfword one answers true.
+    alignas(16) uint8_t halfZero[16];
+    for (unsigned i = 0; i < 16; ++i)
+        halfZero[i] = (i % 2) ? 0x00 : 0x01;
+    CHECK_EQ(allTrue(halfZero, SIMDLane::i8x16), 0ull);
+    CHECK_EQ(allTrue(halfZero, SIMDLane::i16x8), 1ull);
+    CHECK_EQ(allTrue(halfZero, SIMDLane::i32x4), 1ull);
+    CHECK_EQ(allTrue(halfZero, SIMDLane::i64x2), 1ull);
+}
+
+// Group 7: vector shifts.
+//
+// Three things can go wrong here and each needs its own property of the data.
+//
+// The shift KIND: vsr where vsra belongs is a one-character difference that
+// assembles and runs, so every lane has its sign bit set and the logical and
+// arithmetic results differ in every lane.
+//
+// The lane WIDTH: a switch arm that reaches for the wrong width still shifts
+// every bit of the register, and agrees with the right one unless a bit has
+// to cross a lane boundary. So every byte of the data is ODD and has its top
+// bit set: a right shift then moves a one across each byte boundary and a
+// left shift moves a one back, and a narrower or wider arm reads visibly
+// differently. All four widths are exercised, including the halfword forms
+// that nothing else in this port reaches.
+//
+// The COUNT: 0, 1, w-1, w and w+1 for every width, so the hardware's masking
+// to the lane width is measured through the real lowering rather than in a
+// standalone probe -- w must agree with 0 and w+1 with 1.
+void testPPC64VectorShift()
+{
+    alignas(16) uint8_t in[16], cnt[16], out[16];
+
+    auto runVector = [&](SIMDLane lane, int kind, unsigned count) {
+        for (unsigned i = 0; i < 16; ++i)
+            cnt[i] = static_cast<uint8_t>(count);
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+            SIMDInfo info { lane, SIMDSignMode::None };
+            if (!kind)      jit.vectorUshl(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            else if (kind == 1) jit.vectorUshr(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            else            jit.vectorSshr(info, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+            jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &in[0], &out[0], &cnt[0]);
+    };
+
+    // --- byte lanes, width 8 ---
+    {
+        static const uint8_t b[16] = { 0x81, 0xc0, 0x83, 0xc2, 0x85, 0xc4, 0x87, 0xc6,
+                                      0x89, 0xc8, 0x8b, 0xca, 0x8d, 0xcc, 0x8f, 0xce };
+        memcpy(in, b, 16);
+        for (unsigned count : { 0u, 1u, 7u, 8u, 9u }) {
+            unsigned eff = count % 8;                    // what the hardware must do
+            runVector(SIMDLane::i8x16, 0, count);
+            for (unsigned i = 0; i < 16; ++i)
+                CHECK_EQ(out[i], static_cast<uint8_t>(in[i] << eff));
+            runVector(SIMDLane::i8x16, 1, count);
+            for (unsigned i = 0; i < 16; ++i)
+                CHECK_EQ(out[i], static_cast<uint8_t>(in[i] >> eff));
+            runVector(SIMDLane::i8x16, 2, count);
+            for (unsigned i = 0; i < 16; ++i)
+                CHECK_EQ(out[i], static_cast<uint8_t>(static_cast<int8_t>(in[i]) >> eff));
+        }
+    }
+
+    // --- halfword lanes, width 16 ---
+    {
+        uint16_t h[8] = { 0x8180u, 0xc001u, 0x8382u, 0xc203u, 0x8584u, 0xc405u, 0x8786u, 0xc607u };
+        memcpy(in, h, 16);
+        for (unsigned count : { 0u, 1u, 15u, 16u, 17u }) {
+            unsigned eff = count % 16;
+            runVector(SIMDLane::i16x8, 0, count);
+            for (unsigned i = 0; i < 8; ++i) { uint16_t g; memcpy(&g, out + i*2, 2); CHECK_EQ(g, static_cast<uint16_t>(h[i] << eff)); }
+            runVector(SIMDLane::i16x8, 1, count);
+            for (unsigned i = 0; i < 8; ++i) { uint16_t g; memcpy(&g, out + i*2, 2); CHECK_EQ(g, static_cast<uint16_t>(h[i] >> eff)); }
+            runVector(SIMDLane::i16x8, 2, count);
+            for (unsigned i = 0; i < 8; ++i) { uint16_t g; memcpy(&g, out + i*2, 2); CHECK_EQ(g, static_cast<uint16_t>(static_cast<int16_t>(h[i]) >> eff)); }
+        }
+    }
+
+    // --- word lanes, width 32 ---
+    {
+        uint32_t w[4] = { 0x81800000u, 0xc0000001u, 0x83820100u, 0xc2030201u };
+        memcpy(in, w, 16);
+        for (unsigned count : { 0u, 1u, 31u, 32u, 33u }) {
+            unsigned eff = count % 32;
+            runVector(SIMDLane::i32x4, 0, count);
+            for (unsigned i = 0; i < 4; ++i) { uint32_t g; memcpy(&g, out + i*4, 4); CHECK_EQ(g, static_cast<uint32_t>(w[i] << eff)); }
+            runVector(SIMDLane::i32x4, 1, count);
+            for (unsigned i = 0; i < 4; ++i) { uint32_t g; memcpy(&g, out + i*4, 4); CHECK_EQ(g, w[i] >> eff); }
+            runVector(SIMDLane::i32x4, 2, count);
+            for (unsigned i = 0; i < 4; ++i) { uint32_t g; memcpy(&g, out + i*4, 4); CHECK_EQ(g, static_cast<uint32_t>(static_cast<int32_t>(w[i]) >> eff)); }
+        }
+    }
+
+    // --- doubleword lanes, width 64 ---
+    {
+        uint64_t d[2] = { 0x8180000000000001ull, 0xc000000180000000ull };
+        memcpy(in, d, 16);
+        for (unsigned count : { 0u, 1u, 63u, 64u, 65u }) {
+            unsigned eff = count % 64;
+            runVector(SIMDLane::i64x2, 0, count);
+            for (unsigned i = 0; i < 2; ++i) { uint64_t g; memcpy(&g, out + i*8, 8); CHECK_EQ(g, static_cast<uint64_t>(d[i] << eff)); }
+            runVector(SIMDLane::i64x2, 1, count);
+            for (unsigned i = 0; i < 2; ++i) { uint64_t g; memcpy(&g, out + i*8, 8); CHECK_EQ(g, d[i] >> eff); }
+            runVector(SIMDLane::i64x2, 2, count);
+            for (unsigned i = 0; i < 2; ++i) { uint64_t g; memcpy(&g, out + i*8, 8); CHECK_EQ(g, static_cast<uint64_t>(static_cast<int64_t>(d[i]) >> eff)); }
+        }
+    }
+}
+
+// The immediate forms, which splat the count themselves. Run at two lane
+// widths from one splat helper, because the claim the helper rests on is that
+// a BYTE-wide splat serves every lane width; one width would not test it. Same
+// data as above, so a disagreement with the vector forms is visible.
+void testPPC64VectorShiftImmediate()
+{
+    alignas(16) uint8_t in[16], out[16];
+
+    auto run = [&](SIMDLane lane, int kind, unsigned count) {
+        auto test = compile([=] (CCallHelpers& jit) {
+            emitFunctionPrologue(jit);
+            jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+            SIMDInfo info { lane, SIMDSignMode::None };
+            if (!kind)      jit.vectorShl8(info, FPRInfo::argumentFPR0, CCallHelpers::TrustedImm32(count), FPRInfo::argumentFPR1);
+            else if (kind == 1) jit.vectorUshr8(info, FPRInfo::argumentFPR0, CCallHelpers::TrustedImm32(count), FPRInfo::argumentFPR1);
+            else            jit.vectorSshr8(info, FPRInfo::argumentFPR0, CCallHelpers::TrustedImm32(count), FPRInfo::argumentFPR1);
+            jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+            emitFunctionEpilogue(jit);
+            jit.ret();
+        });
+        invoke<void>(test, &in[0], &out[0]);
+    };
+
+    {
+        uint16_t h[8] = { 0x8180u, 0xc001u, 0x8382u, 0xc203u, 0x8584u, 0xc405u, 0x8786u, 0xc607u };
+        memcpy(in, h, 16);
+        for (unsigned count : { 1u, 7u, 15u }) {
+            run(SIMDLane::i16x8, 0, count);
+            for (unsigned i = 0; i < 8; ++i) { uint16_t g; memcpy(&g, out + i*2, 2); CHECK_EQ(g, static_cast<uint16_t>(h[i] << count)); }
+            run(SIMDLane::i16x8, 1, count);
+            for (unsigned i = 0; i < 8; ++i) { uint16_t g; memcpy(&g, out + i*2, 2); CHECK_EQ(g, static_cast<uint16_t>(h[i] >> count)); }
+            run(SIMDLane::i16x8, 2, count);
+            for (unsigned i = 0; i < 8; ++i) { uint16_t g; memcpy(&g, out + i*2, 2); CHECK_EQ(g, static_cast<uint16_t>(static_cast<int16_t>(h[i]) >> count)); }
+        }
+    }
+
+    {
+        uint32_t w[4] = { 0x81800000u, 0xc0000001u, 0x83820100u, 0xc2030201u };
+        memcpy(in, w, 16);
+        for (unsigned count : { 1u, 15u, 31u }) {
+            run(SIMDLane::i32x4, 0, count);
+            for (unsigned i = 0; i < 4; ++i) { uint32_t g; memcpy(&g, out + i*4, 4); CHECK_EQ(g, static_cast<uint32_t>(w[i] << count)); }
+            run(SIMDLane::i32x4, 1, count);
+            for (unsigned i = 0; i < 4; ++i) { uint32_t g; memcpy(&g, out + i*4, 4); CHECK_EQ(g, w[i] >> count); }
+            run(SIMDLane::i32x4, 2, count);
+            for (unsigned i = 0; i < 4; ++i) { uint32_t g; memcpy(&g, out + i*4, 4); CHECK_EQ(g, static_cast<uint32_t>(static_cast<int32_t>(w[i]) >> count)); }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// The BBQ/OMG tranche: saturating arithmetic, widening, narrowing, pairwise
+// and extended multiplies, the width-changing conversions, the permutes,
+// bitmask, fused multiply-add, the relaxed group, constants and the memory
+// forms. Same rules as above: lane-distinct data, whole-vector comparison,
+// and expected values computed in C that shares nothing with the JIT path.
+// Every lowering here that is not IPInt's (bitmask, the memory forms,
+// move128ToVector, the FMA aliasing cases) is probed on every lane.
+
+template<typename Emit>
+static void ppc64RunVectorUnary(const void* in, void* out, Emit emit)
+{
+    auto test = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+        emit(jit, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1);
+        jit.storeVector(FPRInfo::argumentFPR1, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    invoke<void>(test, in, out);
+}
+
+template<typename Emit>
+static void ppc64RunVectorBinary(const void* a, const void* b, void* out, Emit emit)
+{
+    auto test = compile([=] (CCallHelpers& jit) {
+        emitFunctionPrologue(jit);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR0, 0), FPRInfo::argumentFPR0);
+        jit.loadVector(CCallHelpers::Address(GPRInfo::argumentGPR2, 0), FPRInfo::argumentFPR1);
+        emit(jit, FPRInfo::argumentFPR0, FPRInfo::argumentFPR1, FPRInfo::argumentFPR2);
+        jit.storeVector(FPRInfo::argumentFPR2, CCallHelpers::Address(GPRInfo::argumentGPR1, 0));
+        emitFunctionEpilogue(jit);
+        jit.ret();
+    });
+    invoke<void>(test, a, out, b);
+}
+
+template<typename T>
+static T ppc64LaneAt(const void* bytes, unsigned index)
+{
+    T value;
+    memcpy(&value, static_cast<const uint8_t*>(bytes) + index * sizeof(T), sizeof(T));
+    return value;
+}
+
+template<typename T>
+static void ppc64CheckLane(const void* bytes, unsigned index, T expected)
+{
+    CHECK_EQ(ppc64LaneAt<T>(bytes, index), expected);
+}
+
+// Hand-picked so that SOME lanes saturate and others do not, in every one of
+// the four signedness/direction combinations; a uniform pattern would either
+// saturate everywhere or nowhere and prove nothing about the clamp.
+void testPPC64VectorSatAddSub()
+{
+    alignas(16) const uint8_t a[16] = { 0x7f, 0x80, 0x01, 0xff, 0x7e, 0x81, 0x40, 0xc0, 0x10, 0xf0, 0x55, 0xaa, 0x00, 0x7f, 0x80, 0x33 };
+    alignas(16) const uint8_t b[16] = { 0x01, 0xff, 0x7f, 0x80, 0x02, 0xfe, 0x40, 0xc0, 0xf0, 0x10, 0xab, 0x56, 0x00, 0x80, 0x7f, 0xcc };
+    alignas(16) uint8_t out[16];
+
+    auto run = [&](SIMDLane lane, SIMDSignMode mode, bool isAdd) {
+        ppc64RunVectorBinary(a, b, out, [=](CCallHelpers& jit, FPRReg x, FPRReg y, FPRReg d) {
+            if (isAdd)
+                jit.vectorAddSat(SIMDInfo { lane, mode }, x, y, d);
+            else
+                jit.vectorSubSat(SIMDInfo { lane, mode }, x, y, d);
+        });
+    };
+    auto check = [&]<typename T, typename Wide>(SIMDLane lane, SIMDSignMode mode, bool isAdd) {
+        run(lane, mode, isAdd);
+        constexpr unsigned lanes = 16 / sizeof(T);
+        constexpr Wide lo = static_cast<Wide>(std::numeric_limits<T>::min());
+        constexpr Wide hi = static_cast<Wide>(std::numeric_limits<T>::max());
+        for (unsigned i = 0; i < lanes; ++i) {
+            Wide x = ppc64LaneAt<T>(a, i), y = ppc64LaneAt<T>(b, i);
+            Wide r = isAdd ? x + y : x - y;
+            r = std::clamp(r, lo, hi);
+            ppc64CheckLane<T>(out, i, static_cast<T>(r));
+        }
+    };
+    for (bool isAdd : { true, false }) {
+        check.template operator()<int8_t, int32_t>(SIMDLane::i8x16, SIMDSignMode::Signed, isAdd);
+        check.template operator()<uint8_t, int32_t>(SIMDLane::i8x16, SIMDSignMode::Unsigned, isAdd);
+        check.template operator()<int16_t, int32_t>(SIMDLane::i16x8, SIMDSignMode::Signed, isAdd);
+        check.template operator()<uint16_t, int32_t>(SIMDLane::i16x8, SIMDSignMode::Unsigned, isAdd);
+    }
+}
+
+// Narrow: lower's lanes first, then upper's. The operands are deliberately
+// different vectors so the VRA/VRB swap the ISA needs is observable, and
+// each carries values on both sides of both saturation edges.
+void testPPC64VectorNarrow()
+{
+    alignas(16) const uint16_t lower16[8] = { 0x7fff, 0x8000, 0x0080, 0xff80, 0x00ff, 0x0100, 0xffff, 0x007f };
+    alignas(16) const uint16_t upper16[8] = { 0x1234, 0xedcc, 0x0001, 0xfffe, 0x7f00, 0x80ff, 0x0000, 0x0010 };
+    alignas(16) const uint32_t lower32[4] = { 0x7fffffffu, 0x80000000u, 0x00008000u, 0xffff8000u };
+    alignas(16) const uint32_t upper32[4] = { 0x0000ffffu, 0x00010000u, 0xffffffffu, 0x00007fffu };
+    alignas(16) uint8_t out[16];
+
+    auto check = [&]<typename From, typename To>(SIMDLane lane, SIMDSignMode mode, const void* lower, const void* upper) {
+        ppc64RunVectorBinary(lower, upper, out, [=](CCallHelpers& jit, FPRReg lo, FPRReg hi, FPRReg d) {
+            jit.vectorNarrow(SIMDInfo { lane, mode }, lo, hi, d, FPRInfo::argumentFPR3);
+        });
+        constexpr unsigned lanes = 16 / sizeof(From);
+        for (unsigned i = 0; i < 2 * lanes; ++i) {
+            int64_t v = static_cast<From>(ppc64LaneAt<From>(i < lanes ? lower : upper, i % lanes));
+            v = std::clamp<int64_t>(v, std::numeric_limits<To>::min(), std::numeric_limits<To>::max());
+            ppc64CheckLane<To>(out, i, static_cast<To>(v));
+        }
+    };
+    check.template operator()<int16_t, int8_t>(SIMDLane::i16x8, SIMDSignMode::Signed, lower16, upper16);
+    check.template operator()<int16_t, uint8_t>(SIMDLane::i16x8, SIMDSignMode::Unsigned, lower16, upper16);
+    check.template operator()<int32_t, int16_t>(SIMDLane::i32x4, SIMDSignMode::Signed, lower32, upper32);
+    check.template operator()<int32_t, uint16_t>(SIMDLane::i32x4, SIMDSignMode::Unsigned, lower32, upper32);
+}
+
+// Extend low/high, all three widths, both signednesses. Sixteen distinct
+// bytes with the sign bit set in some and clear in others, so a low/high
+// confusion moves values and a sign confusion changes them.
+void testPPC64VectorExtend()
+{
+    alignas(16) uint8_t in[16];
+    for (unsigned i = 0; i < 16; ++i)
+        in[i] = static_cast<uint8_t>(0x78 + i * 0x11);
+    alignas(16) uint8_t out[16];
+
+    auto check = [&]<typename From, typename To>(SIMDLane lane, SIMDSignMode mode, bool high) {
+        ppc64RunVectorUnary(in, out, [=](CCallHelpers& jit, FPRReg x, FPRReg d) {
+            if (high)
+                jit.vectorExtendHigh(SIMDInfo { lane, mode }, x, d);
+            else
+                jit.vectorExtendLow(SIMDInfo { lane, mode }, x, d);
+        });
+        constexpr unsigned lanes = 16 / sizeof(To);
+        for (unsigned i = 0; i < lanes; ++i)
+            ppc64CheckLane<To>(out, i, static_cast<To>(ppc64LaneAt<From>(in, i + (high ? lanes : 0))));
+    };
+    for (bool high : { false, true }) {
+        check.template operator()<int8_t, int16_t>(SIMDLane::i16x8, SIMDSignMode::Signed, high);
+        check.template operator()<uint8_t, uint16_t>(SIMDLane::i16x8, SIMDSignMode::Unsigned, high);
+        check.template operator()<int16_t, int32_t>(SIMDLane::i32x4, SIMDSignMode::Signed, high);
+        check.template operator()<uint16_t, uint32_t>(SIMDLane::i32x4, SIMDSignMode::Unsigned, high);
+        check.template operator()<int32_t, int64_t>(SIMDLane::i64x2, SIMDSignMode::Signed, high);
+        check.template operator()<uint32_t, uint64_t>(SIMDLane::i64x2, SIMDSignMode::Unsigned, high);
+    }
+}

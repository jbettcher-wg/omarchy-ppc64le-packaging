+        // false for everything else on this target, so the FPImm64 form is
+        // reachable for no other value. xxlxor clears the whole register and
+        // needs no GPR to stage through -- which is what makes the form usable
+        // at all, since Air generates with the macro scratch forbidden.
+        if (!imm.m_value) {
+            m_assembler.xxlxor(dest, dest, dest);
+            return;
+        }
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        m_assembler.mtvsrd(dest, temp.data());
+    }
+
+    // A float in an FPR is its raw 32-bit pattern in the low word of
+    // doubleword 0 (the model at the head of the floating-point section
+    // below), so these are bit moves, not conversions. mtvsrwz puts the word
+    // exactly there; mfvsrwz reads it back zero-extended, which is the
+    // port's 32-bit invariant for free.
+    void move32ToFloat(RegisterID src, FPRegisterID dest) { m_assembler.mtvsrwz(dest, src); }
+
+    void move32ToFloat(TrustedImm32 imm, FPRegisterID dest)
+    {
+        // As move64ToDouble: zero is the only value Arg::isValidFPImm32Form
+        // admits here, and xxlxor needs no GPR. Clearing all 128 bits leaves
+        // the low word of doubleword 0 zero, which is +0.0f under this port's
+        // raw-bits f32 model.
+        if (!imm.m_value) {
+            m_assembler.xxlxor(dest, dest, dest);
+            return;
+        }
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        m_assembler.mtvsrwz(dest, temp.data());
+    }
+
+    void moveFloatTo32(FPRegisterID src, RegisterID dest) { m_assembler.mfvsrwz(dest, src); }
+    // Integer add/sub on values that happen to live in FPRs: JSValue boxing
+    // adds and subtracts DoubleEncodeOffset against a raw double pattern.
+    // POWER has no integer adder in the FP unit, so the operands go through
+    // GPRs on the same mfvsrd/mtvsrd pair moveDoubleTo64/move64ToDouble use.
+    void add64(FPRegisterID a, FPRegisterID b, FPRegisterID dest)
+    {
+        auto temp = temps<Data, Memory>();
+        m_assembler.mfvsrd(temp.data(), a);
+        m_assembler.mfvsrd(temp.memory(), b);
+        m_assembler.add(temp.data(), temp.data(), temp.memory());
+        m_assembler.mtvsrd(dest, temp.data());
+    }
+
+    // dest = a - b, matching sub64(RegisterID a, RegisterID b, RegisterID dest).
+    void sub64(FPRegisterID a, FPRegisterID b, FPRegisterID dest)
+    {
+        auto temp = temps<Data, Memory>();
+        m_assembler.mfvsrd(temp.data(), a);
+        m_assembler.mfvsrd(temp.memory(), b);
+        m_assembler.subf(temp.data(), temp.memory(), temp.data());
+        m_assembler.mtvsrd(dest, temp.data());
+    }
+    // ==================================================================
+    // 128-bit vector move, load and store.
+    //
+    // A v128 lives in a VSR, and FPRegisterID n IS VSR n here, so the whole
+    // 16 bytes move -- not the scalar doubleword. Getting that wrong once is
+    // why commit 2e1a46a3a1 exists.
+    //
+    // lxvx/stxvx are ISA 3.0 AND byte-order preserving, which is what makes
+    // memory order equal wasm lane order on this little-endian target
+    // (jsc-ppc64le-wasm-simd.md section 2). The POWER8 floor has only
+    // lxvd2x/stxvd2x, which additionally SWAP the two doublewords, so the
+    // fallback pairs them with xxswapd. The gate is at run time, not compile
+    // time, so one binary serves POWER8 and POWER9 -- and note that `as`
+    // will NOT catch a mistake here: it accepts the lxvx mnemonic on POWER8
+    // and silently assembles lxvd2x instead (section 6). This port emits raw
+    // encodings, verified byte-for-byte by tools/ppc64-encoding-oracle.
+    void moveVector(FPRegisterID src, FPRegisterID dest)
+    {
+        if (src == dest)
+            return;
+        m_assembler.xxlor(dest, src, src);
+    }
+
+    void moveZeroToVector(FPRegisterID dest)
+    {
+        m_assembler.xxlxor(dest, dest, dest);
+    }
+
+    // A 128-bit constant, through the GPR temp. Memory doubleword 1 is ISA
+    // doubleword 0, which is where mtvsrd lands a GPR, so the high half goes
+    // straight into dest and the low half arrives through the FP temp and
+    // xxpermdi. Equal halves are the i64x2 splat: one materialisation.
+    void move128ToVector(v128_t value, FPRegisterID dest)
+    {
+        if (bitEquals(value, vectorAllZeros())) {
+            moveZeroToVector(dest);
+            return;
+        }
+        auto temp = temps<Data>();
+        uint64_t low = value.u64x2[0];
+        uint64_t high = value.u64x2[1];
+        if (low == high) {
+            move(TrustedImm64(static_cast<int64_t>(low)), temp.data());
+            m_assembler.mtvsrd(fpTempRegister, temp.data());
+            m_assembler.xxpermdi(dest, fpTempRegister, fpTempRegister, 0);
+            return;
+        }
+        move(TrustedImm64(static_cast<int64_t>(high)), temp.data());
+        m_assembler.mtvsrd(dest, temp.data());
+        move(TrustedImm64(static_cast<int64_t>(low)), temp.data());
+        m_assembler.mtvsrd(fpTempRegister, temp.data());
+        m_assembler.xxpermdi(dest, dest, fpTempRegister, 0);
+    }
+
+    void loadVector(Address address, FPRegisterID dest)
+    {
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, false);
+        emitLoadVector(dest, foldOffsetIntoAddressRegister(resolution, temp));
+    }
+
+    void loadVector(BaseIndex address, FPRegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), false);
+        emitLoadVector(dest, foldOffsetIntoAddressRegister(resolution, temp.memory()));
+    }
+
+    void loadVector(TrustedImmPtr address, FPRegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        loadImmediate(address, temp.memory());
+        emitLoadVector(dest, temp.memory());
+    }
+
+    void storeVector(FPRegisterID src, Address address)
+    {
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, false);
+        emitStoreVector(src, foldOffsetIntoAddressRegister(resolution, temp));
+    }
+
+    void storeVector(FPRegisterID src, BaseIndex address)
+    {
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), false);
+        emitStoreVector(src, foldOffsetIntoAddressRegister(resolution, temp.memory()));
+    }
+
+    void storeVector(FPRegisterID src, TrustedImmPtr address)
+    {
+        auto temp = temps<Memory>();
+        loadImmediate(address, temp.memory());
+        emitStoreVector(src, temp.memory());
+    }

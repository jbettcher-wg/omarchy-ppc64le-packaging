 void emitFunctionPrologue(CCallHelpers& jit)
 {
     jit.emitFunctionPrologue();
+#if CPU(PPC64LE)
+    jit.subPtr(CCallHelpers::TrustedImm32(ppc64SaveAreaSize), CCallHelpers::stackPointerRegister);
+    for (unsigned i = 0; i < ppc64SavedRegisterCount; ++i) {
+        auto reg = static_cast<CCallHelpers::RegisterID>(PPC64Registers::r25 + i);
+        // Frame-pointer relative, so a test that moves the stack pointer
+        // itself cannot disturb where these live.
+        jit.store64(reg, CCallHelpers::Address(CCallHelpers::framePointerRegister, -ppc64SaveAreaSize + static_cast<int>(i) * 8));
+    }
+#endif
 }
 
 void emitFunctionEpilogue(CCallHelpers& jit)
 {

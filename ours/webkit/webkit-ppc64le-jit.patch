+    // These USED to RELEASE_ASSERT(hasISA30()) rather than fall back, and that
+    // was a POWER8 crash rather than a missing optimisation. The callers are
+    // not obscure: i32.ctz and i64.ctz in both wasm JITs, and YarrJIT, which
+    // means ordinary JavaScript regexps. A baseline-pool build would have
+    // aborted on the first one.
+    //
+    // The temp is needed for two reasons, not one: dest may alias src, and
+    // addi's RA field has to hold the source -- r0 there reads as the literal
+    // zero. src comes from the register allocator, which never hands out r0.
+    void countTrailingZeros32(RegisterID src, RegisterID dest)
+    {
+        if (Assembler::hasISA30()) {
+            m_assembler.cnttzw(dest, src);
+            return;
+        }
+        ASSERT(src != PPC64Registers::r0);
+        auto temp = temps<Data>();
+        m_assembler.addi(temp.data(), src, -1);
+        m_assembler.andc(temp.data(), temp.data(), src);
+        // popcntw counts EACH WORD separately, so the high word holds the
+        // count of the temp's high word and has to be masked off.
+        m_assembler.popcntw(dest, temp.data());
+        maskLow32(dest);
+    }

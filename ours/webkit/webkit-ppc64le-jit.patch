+    void load32SignedExtendTo64(Address address, RegisterID dest) { loadImpl(LoadKind::S32, address, dest); }
+    void load32SignedExtendTo64(BaseIndex address, RegisterID dest) { loadImpl(LoadKind::S32, address, dest); }
+    void load32SignedExtendTo64(const void* address, RegisterID dest) { loadImpl(LoadKind::S32, address, dest); }

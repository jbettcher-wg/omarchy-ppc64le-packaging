+    void getEffectiveAddress(BaseIndex address, RegisterID dest)
+    {
+        auto resolution = resolveAddress(address, dest, false);
+        if (resolution.offset)
+            addImmediate64(resolution.base, resolution.offset, dest);
+        else
+            move(resolution.base, dest);
+    }
+    // ==================================================================
+    // Floating point.
+    //
+    // THE FLOAT REGISTER MODEL. A "float" lives in an FPR as its raw 32-bit
+    // IEEE single pattern in the low word of doubleword 0 -- ISA word 1, the
+    // word mfvsrwz reads and stfd puts at byte offset 0 -- and the other 96
+    // bits of the register are don't-care. That is the invariant ARM64
+    // (fmov<32>), X86_64 (the low xmm lane) and RISCV64 (fmv.x.w) all
+    // provide, and shared code depends on it in places that have no type
+    // information at all: IPInt's 16-byte value slots, wasm globals, packed
+    // struct and array fields, f32.reinterpret_i32. See
+    // jsc-ppc64le-yarr-wasm.md section 7.
+    //
+    // It is NOT ELFv2's model, which keeps a float in an FPR in double
+    // format -- so this port carries two conventions for one register class
+    // and converts at the seam. The seam is exactly one shape: a
+    // float-returning JIT operation, hooked once in callOperation below.
+    // Float FPR *arguments* cannot occur (CCallHelpers static_asserts them
+    // away) and every other crossing to C is through memory, where ELFv2's
+    // format for a float is the raw single -- this model's own.
+    //
+    // Mechanically: the xv*sp vector family computes each 32-bit lane
+    // independently, so f32 arithmetic is one instruction on a register
+    // whose other lanes hold garbage; lxsiwzx/stxsiwx and mtvsrwz/mfvsrwz
+    // move the word; and the two conversions to and from the double model
+    // are a splat plus xscvspdpn / xscvdpsp plus a splat.
+    // ==================================================================
+
+    void loadDouble(Address address, FPRegisterID dest)
+    {
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, false);
+        m_assembler.lfd(dest, resolution.base, resolution.offset);
+    }
+
+    void loadDouble(BaseIndex address, FPRegisterID dest)
+    {
+        if (isXFormBaseIndex(address)) {
+            ASSERT(address.base != PPC64Registers::r0);
+            m_assembler.lfdx(dest, address.base, address.index);
+            return;
+        }
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), false);
+        m_assembler.lfd(dest, resolution.base, resolution.offset);
+    }
+
+    void loadDouble(TrustedImmPtr address, FPRegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        loadImmediate(address, temp.memory());
+        m_assembler.lfd(dest, temp.memory(), 0);
+    }
+
+    // lxsiwzx/stxsiwx are X-form -- EA = (RA|0) + RB, no displacement -- so
+    // any displacement resolveAddress leaves behind is folded into a
+    // register first. With RA = r0 the form reads r0 as the literal zero,
+    // which is why the address always goes in RB.
+    RegisterID foldOffsetIntoAddressRegister(AddressResolution resolution, RegisterID scratch)
+    {
+        if (!resolution.offset)
+            return resolution.base;
+        m_assembler.addi(scratch, resolution.base, resolution.offset);
+        return scratch;
+    }
+
+    void loadFloat(Address address, FPRegisterID dest)
+    {
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, false);
+        m_assembler.lxsiwzx(dest, PPC64Registers::r0, foldOffsetIntoAddressRegister(resolution, temp));
+    }
+
+    void loadFloat(BaseIndex address, FPRegisterID dest)
+    {
+        if (isXFormBaseIndex(address)) {
+            ASSERT(address.base != PPC64Registers::r0);
+            m_assembler.lxsiwzx(dest, address.base, address.index);
+            return;
+        }
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), false);
+        m_assembler.lxsiwzx(dest, PPC64Registers::r0, foldOffsetIntoAddressRegister(resolution, temp.memory()));
+    }
+
+    void loadFloat(TrustedImmPtr address, FPRegisterID dest)
+    {
+        auto temp = temps<Memory>();
+        loadImmediate(address, temp.memory());
+        m_assembler.lxsiwzx(dest, PPC64Registers::r0, temp.memory());
+    }
+
+    void storeDouble(FPRegisterID src, Address address)
+    {
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, false);
+        m_assembler.stfd(src, resolution.base, resolution.offset);
+    }
+
+    void storeDouble(FPRegisterID src, BaseIndex address)
+    {
+        if (isXFormBaseIndex(address)) {
+            ASSERT(address.base != PPC64Registers::r0);
+            m_assembler.stfdx(src, address.base, address.index);

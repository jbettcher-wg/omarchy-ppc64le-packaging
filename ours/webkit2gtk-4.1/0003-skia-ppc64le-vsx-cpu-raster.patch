+SI void strided_load4(const float* v,
+                      Vec<4,float>& a,
+                      Vec<4,float>& b,
+                      Vec<4,float>& c,
+                      Vec<4,float>& d) {
+    __vector float a_ = vec_xl(0, v +  0),
+                   b_ = vec_xl(0, v +  4),
+                   c_ = vec_xl(0, v +  8),
+                   d_ = vec_xl(0, v + 12);
+    __vector float t0 = vec_mergeh(a_, b_),
+                   t1 = vec_mergeh(c_, d_),
+                   t2 = vec_mergel(a_, b_),
+                   t3 = vec_mergel(c_, d_);
+    a = shuffle<0,1,4,5>(join(sk_bit_cast<Vec<4,float>>(t0), sk_bit_cast<Vec<4,float>>(t1)));
+    b = shuffle<2,3,6,7>(join(sk_bit_cast<Vec<4,float>>(t0), sk_bit_cast<Vec<4,float>>(t1)));
+    c = shuffle<0,1,4,5>(join(sk_bit_cast<Vec<4,float>>(t2), sk_bit_cast<Vec<4,float>>(t3)));
+    d = shuffle<2,3,6,7>(join(sk_bit_cast<Vec<4,float>>(t2), sk_bit_cast<Vec<4,float>>(t3)));
+}
+SI void strided_load4(const int* v,
+                      Vec<4,int>& a,
+                      Vec<4,int>& b,
+                      Vec<4,int>& c,
+                      Vec<4,int>& d) {
+    __vector int a_ = vec_xl(0, v +  0),
+                 b_ = vec_xl(0, v +  4),
+                 c_ = vec_xl(0, v +  8),
+                 d_ = vec_xl(0, v + 12);
+    __vector int t0 = vec_mergeh(a_, b_),
+                 t1 = vec_mergeh(c_, d_),
+                 t2 = vec_mergel(a_, b_),
+                 t3 = vec_mergel(c_, d_);
+    a = shuffle<0,1,4,5>(join(sk_bit_cast<Vec<4,int>>(t0), sk_bit_cast<Vec<4,int>>(t1)));
+    b = shuffle<2,3,6,7>(join(sk_bit_cast<Vec<4,int>>(t0), sk_bit_cast<Vec<4,int>>(t1)));
+    c = shuffle<0,1,4,5>(join(sk_bit_cast<Vec<4,int>>(t2), sk_bit_cast<Vec<4,int>>(t3)));
+    d = shuffle<2,3,6,7>(join(sk_bit_cast<Vec<4,int>>(t2), sk_bit_cast<Vec<4,int>>(t3)));
+}

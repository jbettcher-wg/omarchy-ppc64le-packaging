+SIN Vec<N,float>  ceil(const Vec<N,float>& x) {
+#if SKVX_USE_SIMD && defined(SK_PPC_HAS_VSX)
+    if constexpr (N == 4) {
+        return sk_bit_cast<Vec<4,float>>(vec_ceil(sk_bit_cast<__vector float>(x)));
+    } else if constexpr (N > 4) {
+        return join(ceil(x.lo), ceil(x.hi));
+    }
+#endif
+    return map( ceilf, x);
+}
+SIN Vec<N,float> floor(const Vec<N,float>& x) {
+#if SKVX_USE_SIMD && defined(SK_PPC_HAS_VSX)
+    if constexpr (N == 4) {
+        return sk_bit_cast<Vec<4,float>>(vec_floor(sk_bit_cast<__vector float>(x)));
+    } else if constexpr (N > 4) {
+        return join(floor(x.lo), floor(x.hi));
+    }
+#endif
+    return map(floorf, x);
+}

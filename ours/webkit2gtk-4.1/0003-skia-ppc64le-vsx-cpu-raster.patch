+static void premul_should_swapRB_vsx(bool kSwapRB, uint32_t* dst, const uint32_t* src, int count) {
+    using VU8  = __vector unsigned char;
+    using VU16 = __vector unsigned short;
+    using VU32 = __vector unsigned int;
+
+    const VU8 alpha_splat_mask = {3,3,3,3, 7,7,7,7, 11,11,11,11, 15,15,15,15};
+    // rb16 bytes (LE): R0 at 0, B0 at 2, R1 at 4, B1 at 6, R2 at 8, B2 at 10, R3 at 12, B3 at 14.
+    // ga16 bytes (LE): G0 at 16, G1 at 20, G2 at 24, G3 at 28 (byte 17 is 0).
+    const VU8 pack_mask = kSwapRB
+        ? (VU8){2,16,0,17,  6,20,4,17, 10,24, 8,17, 14,28,12,17}
+        : (VU8){0,16,2,17,  4,20,6,17,  8,24,10,17, 12,28,14,17};
+    const VU32 alpha_sel = vec_splats((uint32_t)0xFF000000);
+
+    while (count >= 4) {
+        VU8 px = (VU8)vec_xl(0, src);
+        VU8 a_splat = vec_perm(px, px, alpha_splat_mask);
+        VU16 rb16 = div255_round_vsx(vec_mule(px, a_splat));
+        VU16 ga16 = div255_round_vsx(vec_mulo(px, a_splat));
+        VU8 rgb = vec_perm((VU8)rb16, (VU8)ga16, pack_mask);
+        VU32 out = vec_sel((VU32)rgb, (VU32)px, alpha_sel);
+        vec_xst(out, 0, dst);
+        src += 4;
+        dst += 4;
+        count -= 4;
+    }
+
+    auto proc = kSwapRB ? RGBA_to_bgrA_portable : RGBA_to_rgbA_portable;
+    proc(dst, src, count);
+}

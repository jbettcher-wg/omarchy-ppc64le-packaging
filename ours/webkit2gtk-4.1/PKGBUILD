  # directory. Regenerate with ours/webkit2gtk-4.1/make-port-tarball.sh, which
  # writes an identical copy beside every recipe that stages the port -- so
  # the sha256 below must be the same in all of them. A difference means
  # somebody packed a different port.
  ppc64le-port.tar.gz
)

# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# LocalSend 1.18.2 for ppc64le (POWER8+, little-endian, ELFv2, glibc): the
# open-source AirDrop alternative, a Flutter UI over a Rust core, built from
# source with this distribution's flutter, flutter-engine and dart.
#
# Class: local workaround (distribution packaging). Started from the AUR
# `localsend` 1.18.2-2 source recipe (same tarball, same sha256; same
# /usr/lib/localsend + /usr/bin/localsend layout) and nixpkgs'
# pkgs/by-name/lo/localsend (the cargokit bypass).
#
# Seven things about this build are worth knowing before changing it.
#
# 1. FETCH IN prepare(), BUILD OFFLINE. prepare() runs `cargo fetch --locked`
#    (crates.io, Cargo.lock's checksums) and `flutter pub get
#    --enforce-lockfile` (pub.dev, pubspec.lock's sha256s) with CARGO_HOME,
#    PUB_CACHE and HOME under $srcdir; bq shares the host's network.
#    build() runs cargo --frozen and flutter --no-pub, with Flutter's
#    download URL pointed at a closed port.
#
# 2. THE RUST LIBRARY IS BUILT BY cargo HERE, NOT BY cargokit (0002), for
#    the explicit triple, so makepkg's RUSTFLAGS (the pool's -C
#    target-cpu=pwr8|pwr9) reach the target crates and the library is gated
#    before Flutter bundles it (LOCALSEND_RUST_LIB).
#
# 3. ISA, PER POOL. POWER9 pool: every native ELF's ISA 3.0 count is
#    recorded in .pkginfo, not gated (POWER9 code is allowed there; the
#    plugins' C++ is built with -mcpu=power9 and the pool's rust std is
#    POWER9 code). Baseline pool: every native ELF must scan 0, except
#    words isa30-attribute.py (dart's, verbatim) attributes to libgcc's
#    IFUNC'd IEEE-128 *_hw routines; the Rust library must scan exactly 0,
#    which holds only when the pool's rust ships POWER8 rlibs (std, core and
#    compiler_builtins are precompiled: a pwr8 build against the POWER9
#    pool's rust measured 2,742 ISA 3.0 words). BOTH pools: lib/libapp.so
#    (Dart AOT code from flutter-engine's gen_snapshot) must scan 0. A
#    stripped libapp.so has two OBJECT symbols over its code and `objdump -d`
#    hex-dumps them (25% decoded, measured), so every scan here is
#    `objdump -D -z -j .text` with a coverage floor (>= 99% of .text words
#    decoded) and a CONTROL: one xscvhpdp written mid-.text must count 1.
#
# 4. RUNPATH. Flutter's Linux template installs plugin libraries with
#    install(FILES), which keeps CMake's build RUNPATH, an absolute path into
#    the build tree (measured on all 12 plugins). 0004 links them with
#    $ORIGIN; a gate allows only $ORIGIN (lib/) and $ORIGIN/lib (the runner).
#    flutter_rust_bridge dlopen()s librust_lib_localsend_app.so by name from
#    libflutter_linux_gtk.so, whose RUNPATH $ORIGIN finds it in lib/.
#
# 5. DEPENDS COME FROM THE BUNDLE. _sonames maps every soname the bundle's
#    ELFs NEED (outside the bundle) to its package; a NEEDED soname missing
#    from the map, or a package missing from depends, fails build(). Plus
#    the non-ELF runtime needs, below.
#
# 6. bq RUNS makepkg --nocheck: every gate is in build(). check() runs the
#    Rust core's tests (by-hand native builds only).
#
# 7. BUILD THIS NATIVELY: through bq / tools/build-ppc64le.sh, or makepkg in
#    a native shell, never inside the POWERarm aarch64 sleeve. An agent
#    reaches the native shell with:
#    ssh -n -i ~/.ssh/id_claude_omarchy -o BatchMode=yes localhost
#
# PATCHES (flutter-port work/localsend/patches; each has a Class: line):
# 0002-no-cargokit.patch            LOCAL WORKAROUND: rust_builder bundles
#      LOCALSEND_RUST_LIB instead of running cargokit (rustup, a pub get of
#      its own build tool, no ppc64le triple).
# 0003-linux-do-not-build-jni.patch LOCAL WORKAROUND: package:jni would
#      build libdartjni.so against the build host's libjvm.so and bundle it.
# 0004-linux-plugins-runpath-origin.patch UPSTREAMABLE FIX (Flutter's Linux
#      app template): plugin libraries linked with RUNPATH $ORIGIN.
# 0005-server-start-retry.patch LOCAL WORKAROUND (ppc64le port): about 1
#      launch in 480 under parallel load, tokio never runs the Rust
#      start_server task and the app stays "Offline" (cause unknown; flutter-port
#      work/localsend/hang/). startServer is timed out after 5 s and retried,
#      at most 3 attempts; each retry is logged.
# rust-toolchain.toml files are deleted: inert without rustup, and with
# rustup they would fetch the pinned 1.97.1.
#
# Kept from the AUR recipe: CXXFLAGS -Wno-error=deprecated-declarations
# (tray_manager 0.5.3 calls app_indicator_new(), deprecated in
# libayatana-appindicator 0.6.0, and plugins build with -Wall -Werror).
# Not carried over: the AUR also ships the workspace's localsend-cli and
# server binaries; this package is the app.
#
# PKGREL RULE: bump pkgrel whenever flutter, flutter-engine or the pool's
# rust is rebuilt (the bundle carries the engine library and code they made).

pkgname=localsend
pkgver=1.18.2
pkgrel=2
pkgdesc='An open source cross-platform alternative to AirDrop'
arch=('powerpc64le')
url='https://localsend.org'
license=('Apache-2.0')

_flutter_pkgver=3.41.9

# The soname -> package map behind depends (5. above), from `readelf -d` of
# every ELF in the bundle. glibc's ld64.so.2/libc/libm, libgcc_s and
# libstdc++ come with -lstdc++ and the toolchain. (A function, not a
# `declare -A`: makepkg sources this file inside a function, which would
# make the array local and leave an indexed one behind.)
_soname_pkg() {
  case $1 in
    ld64.so.2 | libc.so.6 | libm.so.6)                    echo glibc ;;
    libgcc_s.so.1)                                        echo libgcc ;;
    libstdc++.so.6)                                       echo libstdc++ ;;
    libgtk-3.so.0 | libgdk-3.so.0)                        echo gtk3 ;;
    libatk-1.0.so.0)                                      echo at-spi2-core ;;
    libcairo.so.2 | libcairo-gobject.so.2)                echo cairo ;;
    libpango-1.0.so.0 | libpangocairo-1.0.so.0)           echo pango ;;
    libharfbuzz.so.0)                                     echo harfbuzz ;;
    libgdk_pixbuf-2.0.so.0)                               echo gdk-pixbuf2 ;;
    libglib-2.0.so.0 | libgobject-2.0.so.0 | libgio-2.0.so.0) echo glib2 ;;
    libepoxy.so.0)                                        echo libepoxy ;;
    libfontconfig.so.1)                                   echo fontconfig ;;
    libz.so.1)                                            echo zlib ;;
    libayatana-appindicator3.so.1)                        echo libayatana-appindicator ;;
    libdbusmenu-glib.so.4)                                echo libdbusmenu-glib ;;
  esac
}
# ELF needs (the map's packages), then what is loaded or run without a
# NEEDED entry: rustls-platform-verifier reads the system CA store;
# path_provider_linux runs xdg-user-dir (default Downloads folder);
# url_launcher and open_dir run xdg-open and dbus-send; the .desktop icon.
depends=(
  at-spi2-core cairo fontconfig gdk-pixbuf2 glib2 glibc gtk3 harfbuzz
  libayatana-appindicator libdbusmenu-glib libepoxy libgcc libstdc++ pango zlib
  ca-certificates dbus hicolor-icon-theme xdg-user-dirs xdg-utils
)
optdepends=(
  'xdg-desktop-portal-gtk: file chooser through the portal (the launcher sets GTK_USE_PORTAL=1)'
  'networkmanager: network name and state in the UI (connectivity_plus, network_info_plus)'
)
makedepends=(
  "flutter=$_flutter_pkgver" "flutter-engine=$_flutter_pkgver"
  cargo clang cmake ninja pkgconf git binutils file python
  gtk3 libayatana-appindicator
)
options=('!lto')

# 0 = POWER9 pool, 1 = baseline (POWER8-legal) pool. build-ppc64le.sh's
# 00-power8.conf exports _power8_compat=1 and rewrites RUSTFLAGS to pwr8.
_power8_compat=${_power8_compat:-0}
_triple=powerpc64le-unknown-linux-gnu
_flutter_arch=ppc64        # flutter build linux writes build/linux/ppc64/release/bundle
_flutter_root=/usr/lib/flutter
_engine_lib=$_flutter_root/bin/cache/artifacts/engine/linux-ppc64-release/libflutter_linux_gtk.so
# Scratch builds only (flutter-port work/packaging/pkgtest/localsend/harness):
# accept a flutter built on the engine track's stage (no flutter-engine
# .pkginfo). A pool build never sets it.
_interim_engine=0

source=("$pkgname-$pkgver.tar.gz::https://github.com/localsend/localsend/archive/refs/tags/v$pkgver.tar.gz"
        0002-no-cargokit.patch
        0003-linux-do-not-build-jni.patch
        0004-linux-plugins-runpath-origin.patch
        0005-server-start-retry.patch
        isa30-attribute.py)
sha256sums=('4425dfcf2e016d6540ea44941deb4ba6568201cc47d7f08753606e6e4b2769cd'
            'b88ec8db6f98252b36a661b5821d9992947e4d555730607cd302ee439841e6a5'
            '5efc6922b10eedd9b071fbfdcd31c4686d1ba8fb61dee61d88033cbfadbc2364'
            '4275eb49b82b4eb10c05d1c482987b3f1e3a31dffbb6c12bce319f67415b7fab'
            '3b957461577bad2f34849b054776fba1407a42b813783722c22eda51abdd1d5a'
            'f38059bccfcca8c4d0a1a747b518015702ef5b16ecf835b029ecf7f2b1fd4d4e')

_pool() { (( _power8_compat )) && echo baseline || echo power9; }

_env() {
  # bq's $HOME is the real home: keep cargo, pub and flutter state out of it.
  export HOME="$srcdir/home" XDG_CONFIG_HOME="$srcdir/home/.config"
  export CARGO_HOME="$srcdir/cargo-home" PUB_CACHE="$srcdir/pub-cache"
  export DART_SUPPRESS_ANALYTICS=true FLUTTER_SUPPRESS_ANALYTICS=true CI=true
  # Same RUSTFLAGS in build() and check(), or check() recompiles everything.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  mkdir -p "$HOME" "$XDG_CONFIG_HOME"
}

# CONTROL: the flutter on PATH is the flutter package (managed, read-only),
# built for this pool, on a flutter-engine from this pool.
_control_flutter() {
  local f info=$_flutter_root/.pkginfo einfo v
  f=$(readlink -f "$(command -v flutter)")
  [[ $f == "$_flutter_root/bin/flutter" ]] \
    || { echo "CONTROL FAILED: flutter is $f, not $_flutter_root/bin/flutter" >&2; return 1; }
  [[ -f $_flutter_root/bin/cache/managed-by ]] \
    || { echo "CONTROL FAILED: $_flutter_root is not a managed SDK" >&2; return 1; }
  grep -qx "pool: $(_pool)" "$info" \
    || { echo "CONTROL FAILED: flutter is from pool '$(sed -n 's/^pool: //p' "$info")', this build is $(_pool)" >&2; return 1; }
  v=$(flutter --version 2>&1 | head -1)
  [[ $v == "Flutter $_flutter_pkgver "* ]] || { echo "CONTROL FAILED: flutter --version: $v" >&2; return 1; }
  einfo=$_flutter_root/bin/cache/artifacts/engine/.pkginfo
  if [[ -f $einfo ]]; then
    grep -qx "pool: $(_pool)" "$einfo" \
      || { echo "CONTROL FAILED: flutter-engine is from pool '$(sed -n 's/^pool: //p' "$einfo")'" >&2; return 1; }
    printf 'flutter: %s (pool %s); flutter-engine %s (pool %s)\n' "$v" "$(_pool)" \
      "$(sed -n 's/^version: //p' "$einfo")" "$(_pool)" | tee "$srcdir/flutter.info"
  elif (( _interim_engine )) && grep -q '^engine: INTERIM' "$info"; then
    printf 'flutter: %s (pool %s); engine: INTERIM (the engine track stage, no flutter-engine package)\n' \
      "$v" "$(_pool)" | tee "$srcdir/flutter.info"
  else
    echo "CONTROL FAILED: no flutter-engine .pkginfo at $einfo" >&2; return 1
  fi
}

prepare() {
  cd "$pkgname-$pkgver"
  _env
  _control_flutter
  patch -Np1 -F0 --no-backup-if-mismatch -i "$srcdir/0002-no-cargokit.patch"
  patch -Np1 -F0 --no-backup-if-mismatch -i "$srcdir/0003-linux-do-not-build-jni.patch"
  patch -Np1 -F0 --no-backup-if-mismatch -i "$srcdir/0004-linux-plugins-runpath-origin.patch"
  patch -Np1 -F0 --no-backup-if-mismatch -i "$srcdir/0005-server-start-retry.patch"
  rm -f rust-toolchain.toml packages/localsend_isolates/rust-toolchain.toml

  cargo fetch --locked --target "$_triple"

  # Generated Dart (slang, dart_mappable, freezed, flutter_rust_bridge) is
  # committed upstream: no build_runner or frb codegen. `pub get` resolves
  # the pub workspace (app, localsend_isolates, typed_isolates) against the
  # root pubspec.lock; --enforce-lockfile fails rather than re-resolving.
  # support/scripts/remove_proprietary_dependencies.sh is not run: it edits
  # pubspec.yaml (breaking --enforce-lockfile), and in_app_purchase has no
  # Linux implementation.
  (cd app && flutter pub get --enforce-lockfile)
}

# objdump -D -z -j .text: (.long under power8) - (.long under power9). -D
# decodes .text whatever its symbols say; -z keeps zero words, so coverage
# can be required (>= 99% of the .text words decoded). Prints the count;
# leaves "<decoded> <words>" in $srcdir/isa30-coverage.
_isa30_count() {
  local f=$1 words lines n8 n9
  words=$(( $(readelf -SW "$f" | sed 's/\[ *\([0-9]*\)\]/[\1]/' \
                | awk '$2 == ".text" { print strtonum("0x" $6) }') / 4 ))
  read -r lines n8 < <(objdump -D -z -j .text --no-show-raw-insn -M power8 "$f" \
    | awk '$1 ~ /^[0-9a-f]+:$/ { l++; if ($2 == ".long") n++ } END { print l + 0, n + 0 }')
  (( words > 0 && lines * 100 >= words * 99 )) \
    || { echo "GATE FAILED: objdump decoded $lines of $words .text words in $f" >&2; return 1; }
  n9=$(objdump -D -z -j .text --no-show-raw-insn -M power9 "$f" \
    | awk '$1 ~ /^[0-9a-f]+:$/ && $2 == ".long" { n++ } END { print n + 0 }')
  echo "$lines $words" > "$srcdir/isa30-coverage"
  echo $((n8 - n9))
}

# CONTROL: one xscvhpdp (0xf030156c, ISA 3.0) written over the word in the
# middle of .text must count exactly one more. Prints the unmodified count.
_isa30_selftest() {
  local f=$1 c=$srcdir/isa30-selftest.elf off size base got
  read -r off size < <(readelf -SW "$f" | sed 's/\[ *\([0-9]*\)\]/[\1]/' \
                         | awk '$2 == ".text" { print strtonum("0x" $5), strtonum("0x" $6) }')
  [[ -n $off && -n $size ]] || { echo "GATE FAILED: no .text in $f" >&2; return 1; }
  base=$(_isa30_count "$f") || return 1
  cp "$f" "$c"
  printf '\x6c\x15\x30\xf0' | dd of="$c" bs=1 seek=$((off + (size / 8) * 4)) conv=notrunc status=none
  got=$(_isa30_count "$c") || return 1
  rm -f "$c"
  (( got == base + 1 )) \
    || { echo "GATE FAILED: ISA 3.0 scanner self-test on ${f##*/}: $base -> $got, want $((base + 1))" >&2; return 1; }
  echo "$base"
}

# Baseline pool: the Rust library must scan exactly 0 (3. above). POWER9
# pool: recorded. The scanner's own control fires either way.
_gate_rust() {
  local n
  n=$(_isa30_selftest "$1") || return 1
  if (( _power8_compat && n != 0 )); then
    echo "GATE FAILED: $n ISA 3.0 instructions in ${1##*/}; the baseline pool's rust must ship POWER8 rlibs" >&2
    return 1
  fi
  printf 'rust: %s; RUSTFLAGS %s; %s ISA 3.0: %d%s (scanner control fired)\n' \
    "$(rustc -V)" "${RUSTFLAGS%% --remap-path-prefix*}" "${1##*/}" "$n" \
    "$( (( _power8_compat )) && echo ', gated = 0' || echo ', recorded (POWER9 pool)')" | tee "$srcdir/rust.info"
}

build() {
  cd "$pkgname-$pkgver"
  _env
  _control_flutter
  export FLUTTER_STORAGE_BASE_URL=http://127.0.0.1:9   # offline: fail fast

  # rustc takes pwr8/pwr9, never power8/power9; an unknown name is only a
  # warning followed by generic codegen (same guard as ours/gridcraft).
  case " ${RUSTFLAGS:-} " in
    *target-cpu=power*) echo "ERROR: RUSTFLAGS names power8/power9; rustc wants pwr8/pwr9: $RUSTFLAGS" >&2; return 1 ;;
  esac
  if (( _power8_compat )); then
    case " ${RUSTFLAGS:-} " in *target-cpu=pwr8*) ;;
      *) echo "ERROR: _power8_compat=1 but RUSTFLAGS has no target-cpu=pwr8: ${RUSTFLAGS:-<unset>}" >&2; return 1 ;;
    esac
  fi

  # 1. The Rust FFI library: plain cargo, the pool's toolchain.
  cargo build --frozen --release -p rust_lib_localsend_app --target "$_triple" --target-dir target
  export LOCALSEND_RUST_LIB="$PWD/target/$_triple/release/librust_lib_localsend_app.so"
  _gate_rust "$LOCALSEND_RUST_LIB"

  # 2. The Flutter app; tray_manager needs the -Werror relaxation (header).
  export CXXFLAGS="${CXXFLAGS:-} -Wno-error=deprecated-declarations"
  (cd app && flutter build linux --release --no-pub)

  local b=$PWD/app/build/linux/$_flutter_arch/release/bundle
  _gate_bundle "$b"
  _gate_isa30 "$b"
  _gate_depends "$b"
  _gate_leaks "$b"
  _write_pkginfo "$srcdir/pkginfo"
}

_elves() {  # every ELF in the bundle, NUL-separated
  local f
  while IFS= read -r -d '' f; do
    if [[ $(od -An -tx1 -N4 "$f") == " 7f 45 4c 46" ]]; then printf '%s\0' "$f"; fi
  done < <(find "$1" -type f -print0 | sort -z)
}

_gate_bundle() {
  local b=$1 f r al bad=0 rp seen=0
  [[ -x $b/localsend_app && -f $b/lib/libapp.so && -f $b/lib/libflutter_linux_gtk.so ]] \
    || { echo "GATE FAILED: incomplete bundle at $b" >&2; return 1; }
  cmp -s "$b/lib/librust_lib_localsend_app.so" "$LOCALSEND_RUST_LIB" \
    || { echo 'GATE FAILED: the bundled Rust library is not the one built and scanned here' >&2; return 1; }
  cmp -s "$b/lib/libflutter_linux_gtk.so" "$_engine_lib" \
    || { echo "GATE FAILED: the bundled engine is not flutter-engine's $_engine_lib" >&2; return 1; }
  [[ ! -e $b/lib/libdartjni.so ]] || { echo 'GATE FAILED: libdartjni.so in the bundle (0003)' >&2; return 1; }
  while IFS= read -r -d '' f; do
    r=${f#"$b"/}
    file -b "$f" | grep -q '^ELF 64-bit LSB .*PowerPC' \
      || { echo "GATE FAILED: $r is $(file -b "$f" | cut -d, -f1-2)" >&2; bad=1; continue; }
    al=$(readelf -lW "$f" | awk '$1 == "LOAD" { print $NF }' | sort -u | tr '\n' ' ')
    [[ $al == '0x10000 ' ]] || { echo "GATE FAILED: $r LOAD alignment '$al', want 0x10000" >&2; bad=1; }
    # RUNPATH/RPATH: $ORIGIN for lib/, $ORIGIN/lib for the runner, or none.
    rp=$(readelf -dW "$f" | sed -n 's/.*(\(RUNPATH\|RPATH\)).*\[\(.*\)\]$/\2/p')
    case $r:$rp in
      localsend_app:'$ORIGIN/lib') seen=1 ;;
      lib/*:'$ORIGIN' | lib/*:) ;;
      *) echo "GATE FAILED: $r has RUNPATH/RPATH '$rp'" >&2; bad=1 ;;
    esac
  done < <(_elves "$b")
  (( seen )) || { echo 'CONTROL FAILED: the RUNPATH check did not read the runner'"'"'s $ORIGIN/lib' >&2; bad=1; }
  ! ldd "$b/localsend_app" | grep -q 'not found' \
    || { ldd "$b/localsend_app" >&2; echo 'GATE FAILED: unresolved libraries' >&2; bad=1; }
  (( ! bad )) || return 1
  echo 'bundle: every ELF ppc64le with 64 KiB LOADs; RUNPATH $ORIGIN (lib/) and $ORIGIN/lib (runner) only; no libdartjni.so; nothing unresolved' \
    | tee "$srcdir/bundle.info"
}

# ISA policy, 3. above. Rows go to .pkginfo.
_gate_isa30() {
  local b=$1 f r n bad=0 libgcc einfo=$_flutter_root/bin/cache/artifacts/engine/.pkginfo
  local info=$srcdir/isa30.info
  : > "$info"
  n=$(_isa30_selftest "$b/lib/libapp.so") || return 1
  (( n == 0 )) || { echo "GATE FAILED: $n ISA 3.0 instructions in lib/libapp.so (Dart AOT code is ISA 2.07 in both pools)" >&2; return 1; }
  printf 'isa30 %8d  aot-elf  lib/libapp.so (%s of %s .text words decoded; mid-.text control fired)\n' 0 \
    $(cat "$srcdir/isa30-coverage") >> "$info"
  (( _power8_compat )) && libgcc=$(clang --target=powerpc64le-linux-gnu -print-libgcc-file-name)
  while IFS= read -r -d '' f; do
    r=${f#"$b"/}
    [[ $r == lib/libapp.so ]] && continue
    n=$(_isa30_count "$f") || return 1
    printf 'isa30 %8d  native   %s\n' "$n" "$r" >> "$info"
    (( _power8_compat && n )) || continue
    if [[ $r == lib/librust_lib_localsend_app.so ]]; then
      bad=1   # gated = 0 in build() already; belt and braces
    elif [[ $r == lib/libflutter_linux_gtk.so ]] && cmp -s "$f" "$_engine_lib" \
         && grep -q "^isa30-allowed-total artifacts/engine/linux-ppc64-release/libflutter_linux_gtk.so $n " "$einfo"; then
      printf 'isa30-allowed-total %s %d (flutter-engine attributed them to libgcc IFUNC float128 routines)\n' "$r" "$n" >> "$info"
    elif python3 "$srcdir/isa30-attribute.py" --libgcc "$libgcc" "$f" > "$srcdir/isa30-attr.txt" 2>&1 \
         && [[ $(sed -n 's/^RESULT ok //p' "$srcdir/isa30-attr.txt") == "$n" ]]; then
      printf 'isa30-allowed-total %s %d (libgcc IFUNC float128 hardware routines only)\n' "$r" "$n" >> "$info"
    else
      cat "$srcdir/isa30-attr.txt" >&2 2>/dev/null
      echo "GATE FAILED: $n ISA 3.0 instructions in $r (baseline pool)" >&2; bad=1
    fi
  done < <(_elves "$b")
  cat "$info"
  (( ! bad ))
}

# depends, 5. above. CONTROL: the map is consulted at all (libgtk-3.so.0).
_gate_depends() {
  local b=$1 f s p bad=0 gtk=0 need
  need=$(while IFS= read -r -d '' f; do
           readelf -dW "$f" | sed -n 's/.*(NEEDED).*\[\(.*\)\]$/\1/p'
         done < <(_elves "$b") | sort -u)
  for s in $need; do
    [[ -e $b/lib/$s ]] && continue          # in the bundle
    p=$(_soname_pkg "$s")
    [[ -n $p ]] || { echo "GATE FAILED: NEEDED $s is not in _soname_pkg (add it, and its package to depends)" >&2; bad=1; continue; }
    [[ " ${depends[*]} " == *" $p "* ]] || { echo "GATE FAILED: $s comes from $p, which is not in depends" >&2; bad=1; }
    if [[ $s == libgtk-3.so.0 ]]; then gtk=1; fi
  done
  (( gtk )) || { echo 'CONTROL FAILED: the NEEDED scan did not see libgtk-3.so.0' >&2; bad=1; }
  (( ! bad )) || return 1
  need=$(for s in $need; do [[ -e $b/lib/$s ]] || echo "$s"; done)
  printf 'depends: %d NEEDED sonames outside the bundle, all mapped to depends: %s\n' "$(wc -w <<< "$need")" \
    "$(tr '\n' ' ' <<< "$need")" | tee "$srcdir/depends.info"
}

# No installed text file may name the build tree; binary files that do are
# listed (C/C++ assertion strings carry __FILE__).
_gate_leaks() {
  local hits bins
  hits=$(grep -rIl -F "$srcdir" "$1" | head -5)
  [[ -z $hits ]] || { echo "GATE FAILED: bundle text files name the build tree:" >&2; echo "$hits" >&2; return 1; }
  bins=$(grep -rl -F "$srcdir" "$1" | sed "s#^$1/##" | tr '\n' ' ')
  printf 'leaks: no text file in the bundle names the build tree; binary files that do: %s\n' "${bins:-none}" \
    | tee "$srcdir/leaks.info"
}

_write_pkginfo() {
  cat > "$1" <<-INFO
	version: $pkgver-$pkgrel
	pool: $(_pool)
	$(cat "$srcdir/flutter.info")
	$(cat "$srcdir/rust.info")
	$(cat "$srcdir/bundle.info")
	$(cat "$srcdir/depends.info")
	$(cat "$srcdir/leaks.info")
	# ISA 3.0 instructions per bundled ELF (objdump -D -z -j .text, power8 vs
	# power9; baseline pool: 0, or libgcc's IFUNC'd float128 *_hw only):
	$(cat "$srcdir/isa30.info")
	INFO
  ! grep -qF "$srcdir" "$1" || { echo "GATE FAILED: .pkginfo names the build tree" >&2; return 1; }
}

check() {
  cd "$pkgname-$pkgver"
  _env
  # Core protocol tests (TLS via rustls+ring, keygen, HTTP, multicast):
  # 137/137 pass natively with only loopback up. The multicast/discovery
  # tests announce on every interface (where a desktop LocalSend listens on
  # 53317), so they run in a private network namespace when one can be
  # made, else unit tests only. bq never runs this (--nocheck).
  local scope=(--lib --tests)
  local -a netns=()
  if unshare -rn true 2>/dev/null; then
    netns=(unshare -rn sh -c 'ip link set lo up && exec "$@"' _)
  else
    echo "check(): no private netns available; running --lib tests only" >&2
    scope=(--lib)
  fi
  "${netns[@]}" cargo test --frozen --release -p localsend --features full \
    --target "$_triple" --target-dir target "${scope[@]}"
}

package() {
  # Files only: nothing runs here (package() is under fakeroot). makepkg's
  # strip afterwards removes symbols, not .text, so the scans hold.
  cd "$pkgname-$pkgver"
  install -d "$pkgdir/usr/lib/$pkgname"
  cp -a "app/build/linux/$_flutter_arch/release/bundle/." "$pkgdir/usr/lib/$pkgname/"
  install -Dm644 "$srcdir/pkginfo" "$pkgdir/usr/lib/$pkgname/.pkginfo"

  # A launcher script rather than the AUR's symlink, so the portal file
  # chooser is used: file_selector_linux uses GtkFileChooserNative, which in
  # GTK 3.24 goes through xdg-desktop-portal only inside a sandbox or with
  # GTK_USE_PORTAL=1.
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<-'END'
	#!/bin/sh
	: "${GTK_USE_PORTAL:=1}"
	export GTK_USE_PORTAL
	exec /usr/lib/localsend/localsend_app "$@"
	END

  # The AUR's file name and icon name. GTK sets the Wayland app_id from the
  # GApplication id, org.localsend.localsend_app (app/linux/CMakeLists.txt
  # APPLICATION_ID), so StartupWMClass carries that.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop" <<-END
	[Desktop Entry]
	Type=Application
	Name=LocalSend
	GenericName=File Transfer
	Comment=$pkgdesc
	Exec=$pkgname %U
	Icon=$pkgname
	Terminal=false
	StartupNotify=true
	StartupWMClass=org.localsend.localsend_app
	Categories=GTK;Network;FileTransfer;
	Keywords=Sharing;LAN;Files;
	END

  local s
  for s in 32 128 256 512; do
    install -Dm644 "app/assets/img/logo-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/$pkgname.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Parametric 3D CAD in Rust. Native egui/eframe with egui-wgpu for the canvas
# and winit for the window -- no webview, no Electron, no bundled JS toolchain,
# so this ports by recompiling rather than by patching. Same shape as
# ours/cadcraft.
#
# NAMING: since 0.45 the crates, binaries and app id are all SolidCraft
# (`solidcraft`, `solidcraft-cli`, io.tangencylabs.solidcraft). 0.4.0 shipped
# `solvecraft` and ai.storyteller.solvecraft; upstream dropped those names, and
# its .desktop carries X-Flatpak-RenamedFrom for launchers' pinned entries.
# The repository moved from bherbruck/solidcraft to tangency-labs/solidcraft.
#
# BRAND: LICENSE-BRAND (new in this range) covers the UI kit, look, theme, name
# and icon. It allows distributing them "as part of SolidCraft", but a *fork or
# modified build* under the SolidCraft name needs the maintainers' written
# permission. So this recipe must stay patch-free: build upstream's tag as is.
#
# The workspace is crates/*, apps/* and xtask. We build two packages:
#   solidcraft       the GUI application (apps/solidcraft)
#   solidcraft-cli   the command line tool (apps/solidcraft-cli)
# apps/solidcraft-web is a wasm32 target, not built here. `cargo build
# --workspace` would take it and fail, so the packages are named explicitly,
# exactly as upstream's packaging/linux/package.sh does.
#
# vendor/ (third-party crates with local fixes) and solidcore/ (the vendored
# kernel) are path dependencies outside the workspace, not cargo source
# replacement, so `cargo fetch --locked` still populates the registry and
# --frozen is still correct.
#
# NO GTK: rfd resolves its file dialogs through the XDG desktop portal over zbus.
#
# UPDATE CHECK: only a binary built by upstream's release workflow checks for
# updates (it sets SOLIDCRAFT_VERSION at compile time; crates/ui-egui/src/
# update.rs). We leave it unset, so this build never checks -- no patch needed.
# rust-toolchain.toml pins 1.99.1 for rustup users; the system cargo ignores it,
# and Cargo.toml's rust-version (1.95) is the real floor.
#
# ISA: nothing in this tree computes its own -mcpu, so RUSTFLAGS from the
# buildroot's makepkg.conf governs codegen -- `-C target-cpu=pwr9` for the
# POWER9 pool and pwr8 for the baseline. rustc only *warns* on an unrecognised
# target-cpu and then silently emits generic ppc64, so the name is pwr8/pwr9,
# never power8/power9. See tools/makepkg.conf.d/00-power8.conf, which asserts
# the substitution took.

pkgname=solidcraft
pkgver=0.45.0
pkgrel=1
_commit=e8ce12ef78fe76281a04b7242a9ce059ff7d5067   # refs/tags/v0.45.0
_appid=io.tangencylabs.solidcraft
pkgdesc='Parametric 3D CAD: sketch, constrain, extrude, and change a parameter to rebuild'
arch=('powerpc64le')
url='https://github.com/tangency-labs/solidcraft'
license=('Apache-2.0 OR MIT' 'LicenseRef-SolidCraft-Brand')
# Measured on 0.45.0, both lanes: the binaries link only libgcc_s, libm and
# libc directly -- x11-dl, xkbcommon-dl and ash dlopen, so the list comes from
# the SONAME strings in usr/bin/solidcraft mapped to their owning packages.
# Unchanged from 0.4.0; still no libXrandr, fontconfig or GTK.
depends=(
  glibc
  gcc-libs
  dbus                 # libdbus-1.so.3
  libglvnd             # libEGL.so.1
  libx11               # libX11.so.6, libX11-xcb.so.1
  libxcb               # libxcb.so.1
  libxcursor           # libXcursor.so.1
  libxi                # libXi.so.6
  libxkbcommon         # libxkbcommon.so.0
  libxkbcommon-x11     # libxkbcommon-x11.so.0
  wayland              # libwayland-client.so.0, libwayland-egl.so.1
  vulkan-icd-loader    # libvulkan.so.1
)
makedepends=(
  cargo
  git
  pkgconf
  rust
)
optdepends=(
  'xdg-desktop-portal: file open/save dialogs'
)
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')
options=('!lto')   # the workspace sets its own release profile (lto = "thin")

prepare() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked
}

build() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  # rustc takes pwr8/pwr9, NOT power8/power9, and an unrecognised value is a
  # *warning* followed by silently emitting generic ppc64. Checked before
  # building rather than after: a wrong name produced 125,763 ignored-processor
  # warnings in one sweep here and still exited 0.
  case " ${RUSTFLAGS:-} " in
    *target-cpu=power*)
      echo "ERROR: RUSTFLAGS names power8/power9; rustc wants pwr8/pwr9: $RUSTFLAGS" >&2
      return 1 ;;
  esac
  case " ${RUSTFLAGS:-} " in
    *target-cpu=pwr*) ;;
    *) echo "ERROR: RUSTFLAGS sets no pwr8/pwr9 target-cpu: ${RUSTFLAGS:-<unset>}" >&2
       return 1 ;;
  esac
  # A release-workflow version string would turn the update check on.
  unset SOLIDCRAFT_VERSION

  cargo build --release --frozen -p solidcraft -p solidcraft-cli
}

package() {
  cd "$pkgname"

  install -Dm755 target/release/solidcraft     "$pkgdir/usr/bin/solidcraft"
  install -Dm755 target/release/solidcraft-cli "$pkgdir/usr/bin/solidcraft-cli"

  # Upstream's own desktop entry, MIME types and AppStream metadata
  # (assets/platforms/linux since the rename). The metainfo is a template:
  # package.sh substitutes @VERSION@ and @DATE@, so do the same.
  local _p=assets/platforms/linux
  install -Dm644 "$_p/$_appid.desktop"  "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "$_p/$_appid.mime.xml" "$pkgdir/usr/share/mime/packages/$_appid.xml"
  install -d "$pkgdir/usr/share/metainfo"
  sed -e "s/@VERSION@/$pkgver/g" \
      -e "s/@DATE@/$(date -u -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y-%m-%d)/g" \
      "$_p/$_appid.metainfo.xml.in" \
      > "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"

  # The app icon now ships as exported PNGs (packaging/env.sh make_icons); the
  # CLI no longer draws it.
  local _s
  for _s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/app/linux/exports/hicolor/${_s}x${_s}/apps/$_appid.png" \
      "$pkgdir/usr/share/icons/hicolor/${_s}x${_s}/apps/$_appid.png"
  done

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  local _f
  for _f in LICENSE-APACHE LICENSE-MIT LICENSE-BRAND NOTICE ATTRIBUTION.md \
            THIRD-PARTY-LICENSES.txt; do
    install -Dm644 "$_f" "$pkgdir/usr/share/licenses/$pkgname/$_f"
  done
}

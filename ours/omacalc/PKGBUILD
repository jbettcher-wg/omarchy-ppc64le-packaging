# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# omacalc -- Omarchy's Qt Quick calculator.  Omarchy publishes it from their
# own repository; this recipe was written from upstream's bin/build and
# bin/test, and version and metadata follow Omarchy's own recipe,
# omacom/omarchy-pkgs pkgbuilds/omacalc@412a5b34c5ba (0.3.1-1, what their
# stable channel ships).
#
# ppc64le: adding powerpc64le to arch=() was the only change needed.  Plain
# Qt 6 C++/QML, nothing architecture-specific.  It builds against our Qt
# 6.11.2 set; every qt6-* module must stay at one version
# (docs/build-queue.md, version-locked sets).
#
# Packaging differences from upstream's bin/build: qmake is handed makepkg's
# CFLAGS/CXXFLAGS/LDFLAGS, and make is not forced to -j$(nproc) so bq's
# per-slot MAKEFLAGS apply.  Omarchy's omacalc.install (desktop database and
# icon cache refresh) is not carried: pacman's own hooks already do both, as
# for omacut and omawrite.
#
# Up to 0.2.2 the .desktop file and icon existed only in Omarchy's package and
# were copied into this directory out of it.  From 0.3.x upstream's tree
# carries them under pkgbuild/, byte-identical to those copies, so they are
# installed from the source tarball and the copies are gone.

pkgname=omacalc
pkgver=0.3.1
pkgrel=1
pkgdesc='Dead-simple calculator built with Qt Quick'
arch=(powerpc64le)
url='https://github.com/omacom-io/omacalc'
license=(MIT OFL-1.1)
depends=(hicolor-icon-theme qt6-base qt6-declarative xdg-desktop-portal)
makedepends=(gcc make qt6-base qt6-declarative)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0f329bac3812d5440bb00f97bad0e63fd166ea9dedc1809f339d7e1f325499ee')

_qmake() {
  qmake6 "$@" \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
}

build() {
  mkdir -p build
  cd build
  _qmake "$srcdir/$pkgname-$pkgver/omacalc.pro"
  make
}

check() {
  # Upstream's bin/test: the backend unit tests, offscreen.  Worth running on
  # this platform in particular -- a calculator's number formatting is where a
  # long-double or float-parsing difference would show.
  mkdir -p build-tests
  cd build-tests
  _qmake "$srcdir/$pkgname-$pkgver/tests/tests.pro"
  make
  QT_QPA_PLATFORM=offscreen ./tst_omacalc
}

package() {
  install -Dm755 build/omacalc "$pkgdir/usr/bin/omacalc"
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgname-$pkgver/fonts/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 "$pkgname-$pkgver/pkgbuild/omacalc.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omacalc.svg"
  install -Dm644 "$pkgname-$pkgver/pkgbuild/omacalc.desktop" "$pkgdir/usr/share/applications/omacalc.desktop"
}

new file mode 100644
index 00000000000..d2ed429c2f0
--- /dev/null
+++ b/patches/boringssl/ppc64le-target-cpu.patch
@@ -0,0 +1,25 @@
+BoringSSL's target.h enumerates the CPUs it supports and #errors on anything
+else, so ppc64le never reaches the OPENSSL_32_BIT/OPENSSL_64_BIT definitions
+that crypto_word_t and BN_ULONG are built from. That surfaced as ~8000
+"unknown type name 'crypto_word_t'" errors across 176 translation units.
+
+Add the little-endian POWER branch. This is exactly the "patching this list is
+trivial" case the comment above the #error describes: ppc64le is a standard
+64-bit two's-complement little-endian architecture, which is the bar that
+comment sets. OPENSSL_PPC64LE is referenced nowhere in the tree (only in
+third_party/benchmark, which is not built), so it selects no assembly -- the
+perlasm .S files self-guard on OPENSSL_X86_64/OPENSSL_AARCH64 and assemble to
+empty objects, leaving the portable C implementations.
+
+--- a/include/openssl/target.h	2026-09-12 01:09:16.454530697 -0600
++++ b/include/openssl/target.h	2026-09-12 01:09:16.470576012 -0600
+@@ -45,6 +45,9 @@
+ #define OPENSSL_RISCV64
+ #elif defined(__riscv) && __SIZEOF_POINTER__ == 4
+ #define OPENSSL_32_BIT
++#elif defined(__PPC64__) && defined(__LITTLE_ENDIAN__)
++#define OPENSSL_64_BIT
++#define OPENSSL_PPC64LE
+ #elif defined(__pnacl__)
+ #define OPENSSL_32_BIT
+ #define OPENSSL_PNACL
diff --git a/patches/mimalloc/ppc64le-atomic-pause.patch b/patches/mimalloc/ppc64le-atomic-pause.patch
new file mode 100644
index 00000000000..53e858b9696
--- /dev/null
+++ b/patches/mimalloc/ppc64le-atomic-pause.patch
@@ -0,0 +1,25 @@
+mi_atomic_pause() has arms for x86, aarch64 and armv7, and an #else that calls
+mi_atomic_thread_fence(mi_memory_order_seq_cst). Those two names only exist in
+mimalloc's C++ atomic shim; in a C translation unit (src/static.c) neither is
+declared, so the fallback does not compile. Nothing noticed because every
+architecture mimalloc is built on has its own arm.
+
+Add the PowerPC arm rather than fix the dead #else: "or 27,27,27" is the
+architectural SMT low-priority hint and is the direct counterpart of the
+"pause"/"isb"/"yield" the other three arms use.
+
+--- a/include/mimalloc/atomic.h	2026-09-12 01:09:16.457318916 -0600
++++ b/include/mimalloc/atomic.h	2026-09-12 01:09:16.470733202 -0600
+@@ -409,6 +409,12 @@
+ static inline void mi_atomic_pause(void) {
+   __asm__ volatile ("yield" ::: "memory");
+ }
++#elif (defined(__GNUC__) || defined(__clang__)) && (defined(__powerpc64__) || defined(__powerpc__))
++static inline void mi_atomic_pause(void) {
++  // "or 27,27,27" is the SMT low-priority hint (a no-op on single-threaded
++  // cores). This is the PowerPC spin-wait idiom, matching "pause"/"isb"/"yield".
++  __asm__ volatile ("or 27,27,27" ::: "memory");
++}
+ #else
+ static inline void mi_atomic_pause(void) {
+   mi_atomic_thread_fence(mi_memory_order_seq_cst);

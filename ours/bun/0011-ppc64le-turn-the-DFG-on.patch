+#if OS(LINUX)
+    unsigned long hwcap = getauxval(AT_HWCAP);
+    unsigned long hwcap2 = getauxval(AT_HWCAP2);
+
+    if (hwcap & PPC_FEATURE_HAS_ALTIVEC)
+        features |= 1 << static_cast<uint8_t>(PPC64CPUFeature::altivec);
+    if (hwcap & PPC_FEATURE_HAS_VSX)
+        features |= 1 << static_cast<uint8_t>(PPC64CPUFeature::vsx);
+    if (hwcap2 & PPC_FEATURE2_ARCH_2_07)
+        features |= 1 << static_cast<uint8_t>(PPC64CPUFeature::arch_2_07);
+    if (hwcap2 & PPC_FEATURE2_ARCH_3_00)
+        features |= 1 << static_cast<uint8_t>(PPC64CPUFeature::arch_3_00);
+    if (hwcap2 & PPC_FEATURE2_VEC_CRYPTO)
+        features |= 1 << static_cast<uint8_t>(PPC64CPUFeature::crypto);
+    if (hwcap2 & PPC_FEATURE2_ARCH_3_1)

+#[cfg(unix)]
+fn resolve_system_cc(buf: &mut bun_paths::PathBuffer) -> Option<ZBox> {
+    let path_env = bun_core::util::getenv_z(zstr!("PATH")).unwrap_or(b"");
+    if let Some(cc) = bun_core::util::getenv_z(zstr!("CC"))
+        && !cc.is_empty()

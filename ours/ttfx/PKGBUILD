# ttfx -- the screensaver's animation engine.
#
# Not in Arch, not in Arch POWER, not in the AUR: Omarchy publishes it from
# their own repository, so bq finds no recipe for it in any of
# local/archpower/gitlab/aur.  Written here from upstream source; version,
# metadata and file list follow Omarchy's own recipe, omacom/omarchy-pkgs
# pkgbuilds/ttfx@9fe60302264d (0.5.0-3, what their stable channel ships; their
# -2 and -3 are republishes with no recipe change).
#
# It matters more than "a screensaver" suggests: omarchy-launch-screensaver
# opens with `omarchy-cmd-missing ttfx && exit 1`, so without this the
# screensaver silently does nothing -- no error, no notification, and the idle
# timeout at 150s simply has no effect. omarchy-screensaver also pkills it by
# name, so the binary must be called exactly ttfx.
#
# Pure Rust, and rustc carries powerpc64le-unknown-linux-gnu as a first-class
# target, so this needs no porting -- only packaging.  0.5 does carry
# architecture-specific kernels (SSE2/AVX2/AVX-512 on x86_64, NEON on
# aarch64), but every one is behind #[cfg(target_arch)] with a scalar path for
# everything else, which is what powerpc64le runs.  There is no assembly
# source and no NASM (Omarchy's recipe briefly listed NASM, then dropped it as
# 0.5 is Rust only).
#
# Upstream builds a static musl binary for their own distribution. We link
# against the system glibc instead, the way every other native package here
# does (and Omarchy's own package does too); a static binary would sidestep
# the repo's own libraries for no benefit on a machine where they are present
# and correct.
#
# Sourced from the release tarball with a sha256, as Omarchy's recipe does,
# rather than the git tag earlier revisions of this recipe used: nothing in
# the build needs git, and a tag is not an integrity check.

pkgname=ttfx
pkgver=0.5.0
pkgrel=1
pkgdesc='Terminal text effects as a single static binary — Rust port of terminaltexteffects'
arch=(powerpc64le)
url='https://github.com/omacom/ttfx'
license=(MIT)
depends=(gcc-libs glibc)
makedepends=(cargo)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2882c7e47011a95f4d136303f7320da71613299840f67f88fd1385ef53d5f2a0')

prepare() {
  cd "$pkgname-$pkgver"
  # --locked so the build uses the committed Cargo.lock rather than resolving
  # fresh versions at build time; a package that resolves its own dependencies
  # is not reproducible.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release || warning "tests failed; effects are visual and the suite is thin"
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # Shell completions, generated by the binary itself, as Omarchy's package
  # ships them.
  "target/release/$pkgname" --print-completion bash |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  "target/release/$pkgname" --print-completion zsh |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
}

+++ b/arch/powerpc/platforms/powernv/npu-dma.c
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NVLink (NPU) device association helpers for POWER9 / NPU2.
+ *
+ * This is a Stage-1 revival of the code removed in commit 562d1e207d32
+ * ("powerpc/powernv: remove the nvlink support"), which landed in v5.13.
+ * Firmware (skiboot) still describes the NPU2 subsystem fully in the device
+ * tree, and NVIDIA's out-of-tree driver still contains its ibmnpu half; the
+ * only missing piece was the kernel side.
+ *
+ * Deliberately reduced relative to the v5.12 original: the ATSD / mmu_notifier
+ * context machinery (pnv_npu2_init_context() and friends) and the VFIO
+ * passthrough compound-IOMMU paths are NOT restored here. NVIDIA's driver
+ * probes for pnv_npu2_init_context() via conftest and builds without it, so
+ * omitting it costs ATS/unified-memory but not the NVLink data path.
+ *
+ * Original copyright Alistair Popple, IBM Corporation 2015.
+ */
+
+#include <linux/export.h>
+#include <linux/of.h>
+#include <linux/pci.h>
+
+#include <asm/opal.h>
+#include <asm/pci-bridge.h>
+#include <asm/pnv-pci.h>
+#include <asm/ppc-pci.h>
+
+#include "pci.h"
+
+/*
+ * Resolve a device-tree node to its struct pci_dev.
+ *
+ * pci_get_domain_bus_and_slot() takes a reference the callers here do not
+ * want -- the PE already holds one -- so it is dropped immediately. This
+ * mirrors the v5.12 behaviour exactly; callers must not rely on holding a
+ * reference to the returned device.
+ */
+static struct pci_dev *get_pci_dev(struct device_node *dn)
+{
+	struct pci_dn *pdn = PCI_DN(dn);
+	struct pci_dev *pdev;
+
+	if (!pdn)
+		return NULL;
+
+	pdev = pci_get_domain_bus_and_slot(pci_domain_nr(pdn->phb->bus),
+					   pdn->busno, pdn->devfn);
+	if (pdev)
+		pci_dev_put(pdev);
+
+	return pdev;
+}
+
+/* Given an NPU device, get the GPU it is linked to. */
+struct pci_dev *pnv_pci_get_gpu_dev(struct pci_dev *npdev)
+{
+	struct device_node *dn;
+	struct pci_dev *gpdev;
+
+	if (WARN_ON(!npdev))
+		return NULL;
+
+	if (WARN_ON(!npdev->dev.of_node))
+		return NULL;
+
+	dn = of_parse_phandle(npdev->dev.of_node, "ibm,gpu", 0);
+	if (!dn)
+		return NULL;
+
+	gpdev = get_pci_dev(dn);
+	of_node_put(dn);
+
+	return gpdev;
+}
+EXPORT_SYMBOL(pnv_pci_get_gpu_dev);
+
+/*
+ * Given a GPU, get the index'th NPU link device attached to it.
+ * NVIDIA's nv-ibmnpu.c calls this to enumerate a GPU's NVLink bricks.
+ */
+struct pci_dev *pnv_pci_get_npu_dev(struct pci_dev *gpdev, int index)
+{
+	struct device_node *dn;
+	struct pci_dev *npdev;
+
+	if (WARN_ON(!gpdev))
+		return NULL;
+
+	/* Not all PCI devices have device-tree nodes */
+	if (!gpdev->dev.of_node)
+		return NULL;
+
+	dn = of_parse_phandle(gpdev->dev.of_node, "ibm,npu", index);
+	if (!dn)
+		return NULL;
+
+	npdev = get_pci_dev(dn);
+	of_node_put(dn);
+
+	return npdev;
+}
+EXPORT_SYMBOL(pnv_pci_get_npu_dev);
+
+/*
+ * Arm the NPU translation context for one GPU.
+ *
+ * opal_npu_map_lpar() associates the GPU's BDF with an LPAR (0 = host), and
+ * opal_npu_init_context() programs the XTS so the nest MMU will translate
+ * that GPU's NVLink DMA. Without both, GPU->sysmem DMA over NVLink is
+ * untranslated and freezes the NPU PE.
+ */
+int pnv_npu2_map_lpar_dev(struct pci_dev *gpdev, unsigned int lparid,
+			  unsigned long msr)
+{
+	struct pci_dev *npdev = pnv_pci_get_npu_dev(gpdev, 0);
+	struct pci_controller *hose;
+	struct pnv_phb *nphb;
+	int ret;
+
+	if (!npdev)
+		return -ENODEV;
+
+	hose = pci_bus_to_host(npdev->bus);
+	if (!hose->dn ||
+	    !of_device_is_compatible(hose->dn, "ibm,ioda2-npu2-phb")) {
+		dev_info_once(&npdev->dev, "NVLink1 does not support contexts\n");
+		return 0;
+	}
+
+	nphb = hose->private_data;
+
+	dev_dbg(&gpdev->dev, "Map LPAR opalid=%llu lparid=%u\n",
+		nphb->opal_id, lparid);
+	/*
+	 * Radix only: skiboot expects a zero LPCR, which only means anything
+	 * for hash.
+	 */
+	ret = opal_npu_map_lpar(nphb->opal_id, pci_dev_id(gpdev), lparid, 0);
+	if (ret) {
+		dev_err(&gpdev->dev, "Error %d mapping device to LPAR\n", ret);
+		return ret;
+	}
+
+	dev_dbg(&gpdev->dev, "init context opalid=%llu msr=%lx\n",
+		nphb->opal_id, msr);
+	ret = opal_npu_init_context(nphb->opal_id, 0 /*__unused*/, msr,
+				    pci_dev_id(gpdev));
+	if (ret < 0)
+		dev_err(&gpdev->dev, "Failed to init context: %d\n", ret);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(pnv_npu2_map_lpar_dev);
+
+/* Every PCI device whose DT node carries an "ibm,npu" phandle is an NVLink GPU. */
+void pnv_npu2_map_lpar(unsigned long msr)
+{
+	struct pci_dev *gpdev = NULL;
+
+	for_each_pci_dev(gpdev) {
+		if (!gpdev->dev.of_node)
+			continue;
+		if (!of_get_property(gpdev->dev.of_node, "ibm,npu", NULL))
+			continue;
+		pnv_npu2_map_lpar_dev(gpdev, 0, msr);
+	}
+}

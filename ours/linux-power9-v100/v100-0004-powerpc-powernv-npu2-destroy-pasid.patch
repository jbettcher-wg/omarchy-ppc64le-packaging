 EXPORT_SYMBOL_GPL(pnv_npu2_unmap_lpar_dev);

+/*
+ * Tear down the nest-MMU translation context that the GPU's nest MMU holds
+ * for one PASID (one process's mm).
+ *
+ * Driver-mode ATS (NVIDIA's nvidia-uvm on kernels where the in-kernel NPU2
+ * driver was removed, >= 5.3) never asks the kernel to create or destroy
+ * per-PASID contexts: the nest MMU arms a context on demand when the first
+ * translation for a PASID happens, and nothing tears it down when the
+ * process exits. The nest MMU then keeps the dead PASID's context and TLB
+ * entries, GPU memory attributed to the process is not freed, and a
+ * recycled PID can hit stale translations.
+ *
+ * This is the inverse of the context arming that 4.18's
+ * pnv_npu2_init_context() did per process; the OPAL call matches the v4.18
+ * teardown in pnv_npu2_destroy_context()
+ * (opal_npu_destroy_context(opal_id, mm->context.id, PCI_DEVID(gpu))).
+ * Like pnv_npu2_unmap_lpar_dev() above, the NVLink1 test uses the PHB
+ * device-tree compatible string because struct pci_controller no longer
+ * carries an npu pointer.
+ *
+ * Exported non-GPL because the only consumer is NVIDIA's out-of-tree
+ * nvidia-uvm module, which is not licensed under the GPL and therefore
+ * cannot link EXPORT_SYMBOL_GPL symbols.
+ */
+int pnv_npu2_destroy_pasid(struct pci_dev *gpdev, unsigned int pasid)
+{
+	struct pci_dev *npdev = pnv_pci_get_npu_dev(gpdev, 0);
+	struct pci_controller *hose;
+	struct pnv_phb *nphb;
+	int ret;
+
+	if (!npdev)
+		return -ENODEV;
+
+	hose = pci_bus_to_host(npdev->bus);
+	if (!hose->dn ||
+	    !of_device_is_compatible(hose->dn, "ibm,ioda2-npu2-phb")) {
+		dev_info_once(&npdev->dev, "NVLink1 does not support contexts\n");
+		return 0;
+	}
+
+	nphb = hose->private_data;
+
+	dev_dbg(&gpdev->dev, "destroy pasid context opalid=%llu pasid=%u\n",
+		nphb->opal_id, pasid);
+	ret = opal_npu_destroy_context(nphb->opal_id, pasid, pci_dev_id(gpdev));
+	if (ret < 0)
+		dev_err(&gpdev->dev, "Failed to destroy pasid context: %d\n", ret);
+
+	return ret;
+}
+EXPORT_SYMBOL(pnv_npu2_destroy_pasid);
+
 /* Every PCI device whose DT node carries an "ibm,npu" phandle is an NVLink GPU. */
 void pnv_npu2_map_lpar(unsigned long msr)
 {

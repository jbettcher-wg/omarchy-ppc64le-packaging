export KBUILD_BUILD_HOST=omarchy-ppc64le
export KBUILD_BUILD_USER=$pkgbase
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

prepare() {
  cd "linux-$_kernver"

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 -i "$srcdir/$src"
  done

  echo "Setting config..."
  cp "$srcdir/config" .config
  make olddefconfig

  # The proprietary driver must be the only thing that can bind the V100s,
  # and the NVLink path needs these; stop rather than ship a kernel that
  # silently lost one of them to a Kconfig change.
  local opt
  for opt in PPC_POWERNV PPC_64K_PAGES PPC_RADIX_MMU MMU_NOTIFIER MEMORY_HOTPLUG; do
    grep -q "^CONFIG_$opt=y" .config || { echo "CONFIG_$opt is not set" >&2; return 1; }
  done
  for opt in NOVA_CORE DRM_NOVA DRM_NOUVEAU; do
    ! grep -q "^CONFIG_$opt=" .config || { echo "CONFIG_$opt must stay off" >&2; return 1; }
  done

  make -s kernelrelease > version
  local rel; rel="$(<version)"
  if [[ "${rel//-/_}" != "$pkgver" ]]; then
    echo "kernelrelease '$rel' does not match pkgver '$pkgver'" >&2
    return 1
  fi
  echo "Prepared $pkgbase version $rel"
}

build() {
  cd "linux-$_kernver"
  make KBUILD_BUILD_VERSION="$pkgrel" all
}

# The splits are linux-power9's, which are the in-tree
# scripts/package/PKGBUILD's.

_package() {
  pkgdesc="The $pkgdesc kernel and modules"

  cd "linux-$_kernver"
  local kernver="$(<version)"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"

  echo "Installing boot image..."
  install -Dm644 "$(make -s image_name)" "$modulesdir/vmlinuz"

  # Read by mkinitcpio's pacman hook: /boot/vmlinuz-linux-power9-v100.
  echo "$pkgbase" > "$modulesdir/pkgbase"

  echo "Installing modules..."
  make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=true modules_install

  if [ -d "arch/powerpc/boot/dts" ]; then
    echo "Installing dtbs..."
    make INSTALL_DTBS_PATH="$modulesdir/dtb" dtbs_install
  fi

  # remove build link, it is part of -headers
  rm -f "$modulesdir/build"
}

_package-headers() {
  pkgdesc="Headers and scripts for building modules for the $pkgdesc kernel"

  cd "linux-$_kernver"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

  if grep -q CONFIG_MODULES=y include/config/auto.conf; then
    echo "Installing build files..."
    # See linux-power9: install-extmod-build expects kbuild's environment.
    srctree="$PWD" SRCARCH=powerpc CC=gcc HOSTCC=gcc MAKE=make \
      ./scripts/package/install-extmod-build "$builddir"
  fi

  echo "Installing System.map and config..."
  mkdir -p "$builddir"
  cp System.map "$builddir/System.map"
  cp .config "$builddir/.config"
  # Not in linux-power9: nvidia-power9-v100 reads the kernel release from
  # here (/usr/src/linux-power9-v100/version), as Arch's nvidia does.
  install -Dm644 version "$builddir/version"

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

for _p in "${pkgname[@]}"; do
  eval "package_$_p() {
    $(declare -f "_package${_p#$pkgbase}")
    _package${_p#$pkgbase}
  }"
done

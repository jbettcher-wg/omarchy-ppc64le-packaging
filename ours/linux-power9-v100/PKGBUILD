# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# ppc64le: Omarchy ppc64le -- see README.md.  The kernel for one machine class:
# an IBM AC922 (8335-GTG/GTH/GTX) with Tesla V100-SXM2 GPUs on NVLink 2.0,
# driven by NVIDIA's proprietary 535 driver (nvidia-power9-v100).  It is
# linux-power9's 64K-page kernel plus nine patches that put back the NVLink
# path mainline removed and fix what broke on the way to 7.x.
#
# It is NOT a replacement for linux-power9 / linux-power9-64k.  Those are the
# general POWER9 kernels (amdgpu, nova-core for newer NVIDIA cards).  This one
# turns nova-core, drm-nova and nouveau OFF so nothing but the proprietary
# module can claim the V100s, and it changes PCI window sizing, module symbol
# licensing and EEH probing in ways only this hardware needs.

_kernver=7.2.9

pkgbase=linux-power9-v100
# CONFIG_LOCALVERSION="-v100" makes kernelrelease 7.2.9-v100; pacman has no
# '-' in pkgver, hence the underscore (the linux-power9-64k convention).
# prepare() asserts the two still agree.
pkgver=${_kernver}_v100
pkgname=("$pkgbase" "$pkgbase-headers")
# No -api-headers split: linux-power9 (4K) is the one package in the repo
# that provides linux-api-headers.

# Bump for every change to this directory.  nvidia-power9-v100 is built
# against this package's headers and must be rebuilt with it.
pkgrel=1
pkgdesc='Upstream Linux for the AC922 with NVLink V100s'
url='https://www.kernel.org/'
arch=(powerpc64le)
license=(GPL-2.0-only)
makedepends=(
  bc
  bison
  cpio
  flex
  gettext
  kmod
  libelf
  openssl
  pahole
  perl
  python
  rsync
  tar
)
# No rust/rust-src/rust-bindgen/clang: CONFIG_RUST is off here (it exists in
# linux-power9 only for nova-core, which this kernel does not build).

# As linux-power9: !buildflags keeps makepkg.conf's CFLAGS out of the kernel
# build, !strip because modules are stripped by INSTALL_MOD_STRIP=1 and
# vmlinuz must not be touched, !debug for no unstripped-vmlinux split.
options=(!strip !debug !buildflags)

source=("https://cdn.kernel.org/pub/linux/kernel/v${_kernver%%.*}.x/linux-$_kernver.tar.xz"
        # linux-power9's patches, same files, same order.  Two are absent:
        # 0006 (eeh_rmv_device self-deadlock) is in mainline 7.2.9 already,
        # 0008 (Rust on powerpc) is not needed with CONFIG_RUST off.
        # Then the V100 series, in order (README.md, "The V100 patches").
        0001-xhci-pci-no-64bit-dma-for-amd-promontory19-43fc.patch
        0002-powerpc-syscall_exit_restart-return-accumulated-exit_result.patch
        0003-xhci-pci-trb-overfetch-for-amd-promontory19-43fc.patch
        0004-powerpc-syscall-keep-seccomp-ptrace-return-value-when-syscall-skipped.patch
        0005-powerpc-interrupt-clear-exit_flags-before-irqentry_exit-exit-work.patch
        0007-powerpc-mm-do-not-grow-max_pfn-for-ZONE_DEVICE.patch
        0009-drm-amdkfd-map-gpu-numa-node-to-cpu-proximity-domain.patch
        v100-0001-powerpc-powernv-restore-npu2-nvlink-support.patch
        v100-0002-export-opal-npu-context-calls.patch
        v100-0003-restore-pnv-npu2-unmap-lpar-dev.patch
        v100-0004-powerpc-powernv-npu2-destroy-pasid.patch
        v100-0005-unflag-vma-start-write.patch
        v100-0006-module-no-proprietary-taint-inheritance.patch
        v100-0007-pci-reserve-alignment-hole-for-large-sibling-windows.patch
        v100-0008-powernv-eeh-skip-nvlink-npu-devices-without-pe.patch
        v100-0009-cpufreq-powernv-boost-on-by-default.patch
        config)

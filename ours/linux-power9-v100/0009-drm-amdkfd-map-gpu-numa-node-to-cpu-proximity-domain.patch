From: daedalao <daedalao@hotmail.com>
Subject: [PATCH] drm/amdkfd: map GPU NUMA node to CPU proximity domain, not node id

kfd_create_vcrat_image_cpu() numbers CPU proximity domains sequentially
(crat_table->num_domains) as it walks the online NUMA nodes, but
kfd_fill_gpu_direct_io_link_to_cpu() stores the GPU's raw
pdev->dev.numa_node as proximity_domain_to. On systems whose NUMA node ids
are sparse (POWER8 8335-GCA: nodes 0 and 8) a GPU on node 8 points its
IO link at proximity domain 8, which does not exist, so
kfd_parse_subtype_iolink() fails with -ENODEV and the device is dropped:

  amdgpu 0020:03:00.0: Error parsing VCRAT
  kfd kfd: Error adding device to topology
  kfd kfd: device 1002:73a1 NOT added due to errors

Resolve the NUMA node to the CPU topology device that describes it by
matching the id of the node's first CPU (what kfd_fill_cu_for_cpu() puts
in processor_id_low), and fall back to the old behaviour if no CPU device
matches.

Signed-off-by: daedalao <daedalao@hotmail.com>
---
--- a/drivers/gpu/drm/amd/amdkfd/kfd_topology.c
+++ b/drivers/gpu/drm/amd/amdkfd/kfd_topology.c
@@ -65,6 +65,29 @@
 	return device;
 }
 
+/* kfd_topology_cpu_proximity_domain_by_numa_node_no_lock - Return the
+ *	proximity domain of the CPU topology device describing NUMA node
+ *	@numa_node_id, or -1 if there is none. Virtual CRAT tables number CPU
+ *	nodes sequentially, so a sparse NUMA node id is not itself a valid
+ *	proximity domain.
+ */
+int kfd_topology_cpu_proximity_domain_by_numa_node_no_lock(int numa_node_id)
+{
+	struct kfd_topology_device *top_dev;
+	int apic_id = kfd_numa_node_to_apic_id(numa_node_id);
+
+	if (apic_id == -1)
+		return -1;
+
+	list_for_each_entry(top_dev, &topology_device_list, list) {
+		if (top_dev->node_props.cpu_cores_count &&
+		    top_dev->node_props.cpu_core_id_base == apic_id)
+			return top_dev->proximity_domain;
+	}
+
+	return -1;
+}
+
 struct kfd_topology_device *kfd_topology_device_by_proximity_domain(
 						uint32_t proximity_domain)
 {
--- a/drivers/gpu/drm/amd/amdkfd/kfd_priv.h
+++ b/drivers/gpu/drm/amd/amdkfd/kfd_priv.h
@@ -1173,6 +1173,7 @@
 						uint32_t proximity_domain);
 struct kfd_topology_device *kfd_topology_device_by_proximity_domain_no_lock(
 						uint32_t proximity_domain);
+int kfd_topology_cpu_proximity_domain_by_numa_node_no_lock(int numa_node_id);
 struct kfd_topology_device *kfd_topology_device_by_id(uint32_t gpu_id);
 struct kfd_node *kfd_device_by_id(uint32_t gpu_id);
 static inline bool kfd_irq_is_from_node(struct kfd_node *node, uint32_t node_id,
--- a/drivers/gpu/drm/amd/amdkfd/kfd_crat.c
+++ b/drivers/gpu/drm/amd/amdkfd/kfd_crat.c
@@ -2189,10 +2189,19 @@
 		kfd_find_numa_node_in_srat(kdev);
 #endif
 #ifdef CONFIG_NUMA
-	if (kdev->adev->pdev->dev.numa_node == NUMA_NO_NODE)
+	if (kdev->adev->pdev->dev.numa_node == NUMA_NO_NODE) {
 		sub_type_hdr->proximity_domain_to = 0;
-	else
-		sub_type_hdr->proximity_domain_to = kdev->adev->pdev->dev.numa_node;
+	} else {
+		int numa_node = kdev->adev->pdev->dev.numa_node;
+		int pd = kfd_topology_cpu_proximity_domain_by_numa_node_no_lock(numa_node);
+
+		/*
+		 * NUMA node ids may be sparse (e.g. POWER: 0 and 8) while
+		 * the CPU proximity domains in a virtual CRAT are dense;
+		 * resolve through the CPU topology device when possible.
+		 */
+		sub_type_hdr->proximity_domain_to = pd >= 0 ? pd : numa_node;
+	}
 #else
 	sub_type_hdr->proximity_domain_to = 0;
 #endif

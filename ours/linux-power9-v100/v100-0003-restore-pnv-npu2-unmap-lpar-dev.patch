 EXPORT_SYMBOL_GPL(pnv_npu2_map_lpar_dev);
 
+/*
+ * Tear down the NPU translation context for one GPU.
+ *
+ * The exact inverse of pnv_npu2_map_lpar_dev(): destroy the XTS entry that
+ * opal_npu_init_context() created, then point the GPU's BDF back at LPAR 0.
+ * Without this, every teardown -- VFIO taking ownership of the GPU, an NPU
+ * PE being released, a driver unbind -- leaks the OPAL-side context.
+ *
+ * Behaviour restored from v5.12 npu-dma.c:669-705.  The only change is the
+ * NVLink1 test: v5.12 used "hose->npu == NULL", and struct pci_controller
+ * no longer carries an npu pointer, so the device-tree compatible string is
+ * used instead, exactly as pnv_npu2_map_lpar_dev() above already does.
+ */
+int pnv_npu2_unmap_lpar_dev(struct pci_dev *gpdev)
+{
+	struct pci_dev *npdev = pnv_pci_get_npu_dev(gpdev, 0);
+	struct pci_controller *hose;
+	struct pnv_phb *nphb;
+	int ret;
+
+	if (!npdev)
+		return -ENODEV;
+
+	hose = pci_bus_to_host(npdev->bus);
+	if (!hose->dn ||
+	    !of_device_is_compatible(hose->dn, "ibm,ioda2-npu2-phb")) {
+		dev_info_once(&npdev->dev, "NVLink1 does not support contexts\n");
+		return 0;
+	}
+
+	nphb = hose->private_data;
+
+	dev_dbg(&gpdev->dev, "destroy context opalid=%llu\n", nphb->opal_id);
+	ret = opal_npu_destroy_context(nphb->opal_id, 0 /*__unused*/,
+				       pci_dev_id(gpdev));
+	if (ret < 0) {
+		dev_err(&gpdev->dev, "Failed to destroy context: %d\n", ret);
+		return ret;
+	}
+
+	/* Set LPID to 0 anyway, just to be safe */
+	dev_dbg(&gpdev->dev, "Map LPAR opalid=%llu lparid=0\n", nphb->opal_id);
+	ret = opal_npu_map_lpar(nphb->opal_id, pci_dev_id(gpdev), 0 /*LPID*/,
+				0 /* LPCR bits */);
+	if (ret)
+		dev_err(&gpdev->dev, "Error %d mapping device to LPAR\n", ret);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(pnv_npu2_unmap_lpar_dev);
+
 /* Every PCI device whose DT node carries an "ibm,npu" phandle is an NVLink GPU. */
 void pnv_npu2_map_lpar(unsigned long msr)
 {

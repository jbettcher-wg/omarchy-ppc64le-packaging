# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Contributor: bjarneo <https://github.com/bjarneo>
#
# cliamp -- terminal music player.  Started from the AUR `cliamp` recipe at
# its 2.0.1 revision (aur.git 0e012cbf); version and metadata now follow
# Omarchy's own recipe, omacom/omarchy-pkgs pkgbuilds/cliamp@5b2ac97b3fd5,
# which is the 2.4.1-1 that Omarchy's stable channel ships.
#
# What changed for ppc64le:
#
# - arch=(powerpc64le).  Go and every cgo dependency here (alsa-lib through
#   oto) build natively; no architecture-specific code.
# - GOTOOLCHAIN=local.  go.mod at v2.4.1 declares `go 1.26.11`; with the
#   default GOTOOLCHAIN=auto, a go older than that silently downloads a
#   prebuilt toolchain from proxy.golang.org and builds with it instead of the
#   repo's.  `local` makes an old go fail loudly instead.  The repo's go is
#   1.27.3, so nothing is lowered.
# - golang.org/x/sys v0.49.0 -> v0.50.0.  v0.49.0 moved unix.Syscall,
#   Syscall6, RawSyscall and RawSyscall6 on ppc64x into assembly that jumps to
#   package syscall's ABI0 entry through R31/CTR.  ELFv2's global entry derives
#   the TOC from R12, so in a PIE build every one of those calls returns with r2
#   pointing wherever the stale R12 put it, and the next TOC-relative access
#   lands in unrelated data.  2.4.1-1 died in lipgloss's init: x/term's isatty
#   ioctl, then mapaccess2_faststr handed a struct's field table for a map type
#   ("unexpected fault address", or "reflect: internal error: invalid method
#   index" with an empty environment).  v0.50.0 jumps through R12 and is
#   upstream's fix; drop this bump once cliamp's go.mod reaches it.
#   build() runs the binary, since check() never runs under bq.
# - GOPATH and GOCACHE under $srcdir, so the build writes nothing into $HOME.
# - Arch Go packaging flags (CGO_*FLAGS from makepkg, -mod=readonly,
#   -modcacherw, external link with makepkg's LDFLAGS) instead of upstream's
#   `-s -w`; makepkg strips anyway.

pkgname=cliamp
pkgver=2.4.1
pkgrel=2
pkgdesc='A retro terminal music player inspired by Winamp 2.x'
arch=(powerpc64le)
url='https://github.com/bjarneo/cliamp'
license=(MIT)
depends=(alsa-lib flac libvorbis libogg mpg123 ffmpeg yt-dlp)
optdepends=('pipewire-alsa: audio output on PipeWire systems'
            'pulseaudio-alsa: audio output on PulseAudio systems')
makedepends=('go>=2:1.26.11')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fb5e43513b71287cd1db39403a293436b38db2ffa73fcd820a34ba3a73d2523e')

_goenv() {
  export GOTOOLCHAIN=local
  export GOPATH="$srcdir/gopath"
  export GOCACHE="$srcdir/gocache"
  export CGO_ENABLED=1
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
}

prepare() {
  cd "$pkgname-$pkgver"
  _goenv
  # See the x/sys note above. go get rewrites go.mod and go.sum, which
  # -mod=readonly forbids, so it runs without it.
  GOFLAGS="-modcacherw" go get golang.org/x/sys@v0.50.0
  go mod download
}

build() {
  cd "$pkgname-$pkgver"
  _goenv
  go build \
    -ldflags "-linkmode=external -extldflags '$LDFLAGS' -X main.version=v$pkgver" \
    -o cliamp .
  # The x/sys v0.49.0 TOC clobber only shows at run time, so run it here.
  if go version -m cliamp | grep -qP '^\tdep\tgolang.org/x/sys\tv0\.49\.0\t'; then
    echo "cliamp: still linked against golang.org/x/sys v0.49.0" >&2
    return 1
  fi
  ./cliamp --version | grep -qxF "cliamp version v$pkgver" ||
    { echo "cliamp: the built binary does not run" >&2; return 1; }
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 cliamp "$pkgdir/usr/bin/cliamp"
  install -Dm644 cliamp.desktop "$pkgdir/usr/share/applications/cliamp.desktop"
  install -Dm644 Cliamp.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/cliamp.png"
  install -Dm644 Cliamp.png "$pkgdir/usr/share/pixmaps/cliamp.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

--- a/nvidia-drm/nvidia-drm-7x-compat.h	1969-12-31 17:00:00.000000000 -0700
+++ b/nvidia-drm/nvidia-drm-7x-compat.h	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,66 @@
+/*
+ * AC922 / Linux 7.x compatibility for nvidia-drm 535.216.03.
+ *
+ * Included from the end of nvidia-drm-conftest.h, i.e. before any kernel DRM
+ * header. Local port, not part of the NVIDIA release.
+ */
+
+#ifndef __NVIDIA_DRM_7X_COMPAT_H__
+#define __NVIDIA_DRM_7X_COMPAT_H__
+
+#include <linux/version.h>
+
+/* Tested on 7.2.9 only; where in 6.13..7.2 each change landed was not checked. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+
+#define NV_DRM_7X_COMPAT 1
+
+/* No longer pulled in indirectly: DRM_ERROR(), DRM_INFO(), DRM_DEBUG*(). */
+#include <drm/drm_print.h>
+
+/* struct drm_mode_create_dumb must be complete before nv_drm_dumb_create(). */
+#include <drm/drm_mode.h>
+
+/*
+ * struct drm_atomic_state is now struct drm_atomic_commit, with its helpers
+ * renamed to match. The kernel headers no longer contain the old names, so
+ * mapping them here cannot change anything inside those headers.
+ */
+#define drm_atomic_state                    drm_atomic_commit
+#define drm_atomic_state_init               drm_atomic_commit_init
+#define drm_atomic_state_alloc              drm_atomic_commit_alloc
+#define drm_atomic_state_clear              drm_atomic_commit_clear
+#define drm_atomic_state_default_clear      drm_atomic_commit_default_clear
+#define drm_atomic_state_default_release    drm_atomic_commit_default_release
+#define drm_atomic_state_get                drm_atomic_commit_get
+#define drm_atomic_state_put                drm_atomic_commit_put
+
+/*
+ * conftest.sh probes these with "struct drm_atomic_state", so on 7.x they all
+ * come out negative. The real answers:
+ */
+#undef  NV_DRM_ATOMIC_STATE_REF_COUNTING_PRESENT
+#define NV_DRM_ATOMIC_STATE_REF_COUNTING_PRESENT
+#undef  NV_DRM_ATOMIC_HELPER_SWAP_STATE_HAS_STALL_ARG
+#define NV_DRM_ATOMIC_HELPER_SWAP_STATE_HAS_STALL_ARG
+#undef  NV_DRM_ATOMIC_HELPER_SWAP_STATE_RETURN_INT
+#define NV_DRM_ATOMIC_HELPER_SWAP_STATE_RETURN_INT
+#undef  NV_DRM_CRTC_ATOMIC_CHECK_HAS_ATOMIC_STATE_ARG
+#define NV_DRM_CRTC_ATOMIC_CHECK_HAS_ATOMIC_STATE_ARG
+#undef  NV_DRM_PLANE_ATOMIC_CHECK_HAS_ATOMIC_STATE_ARG
+#define NV_DRM_PLANE_ATOMIC_CHECK_HAS_ATOMIC_STATE_ARG
+
+/*
+ * The per-object pointer the legacy for_each_*_in_state() iterators read:
+ * "state" became "state_to_destroy" (same meaning: the new state before
+ * drm_atomic_helper_swap_state(), the old one after).
+ */
+#define NV_DRM_OBJ_STATE state_to_destroy
+
+#endif /* >= 7.2 */
+
+#if !defined(NV_DRM_OBJ_STATE)
+#define NV_DRM_OBJ_STATE state
+#endif
+
+#endif /* __NVIDIA_DRM_7X_COMPAT_H__ */

--- a/common/inc/nv-kernel-compat-7x.h	1969-12-31 17:00:00.000000000 -0700
+++ b/common/inc/nv-kernel-compat-7x.h	1969-12-31 17:00:00.000000000 -0700
@@ -0,0 +1,71 @@
+/*
+ * Kernel-API compat shims this driver needs on 7-series trees, shared by the
+ * nvidia/uvm/drm/peermem units (which reach them at nv-linux.h's EOF) and by
+ * the nvidia-modeset unit, which includes conftest.h but never nv-linux.h --
+ * build-7x-driver12 showed that half: nvidia-modeset-linux.c:325 still had an
+ * implicit 'strncpy' (and 'returning int from a function returning char *') and
+ * :655 an implicit 'del_timer_sync'.  Every block is gated on a conftest verdict,
+ * which is why this header must be included *after* conftest.h.
+ */
+
+#ifndef NV_KERNEL_COMPAT_7X_H
+#define NV_KERNEL_COMPAT_7X_H
+
+// ---------------------------------------------------------------------
+// v7-series timer API rename (7.x include/linux/timer.h:165-167):
+//     del_timer_sync() -> timer_delete_sync(),  del_timer() -> timer_delete()
+// 6.12 still ships the old spelling, so this mapping only applies when the
+// 6.x entry point is really gone (probed by 0006's nv_del_timer_sync_present)
+// and the 7.x one is really there (nv_timer_delete_sync_present).  Without
+// this guard the 535 branch dies at its two unguarded call sites:
+//   nvidia/nv.c:3768:5: error: implicit declaration of function
+//      'del_timer_sync'   (nv_stop_rc_timer)
+//   nvidia/nv.c:3812:      del_timer_sync(&nvl->snapshot_timer.kernel_timer)
+//   (nv_stop_snapshot_timer)
+// This replaces the 0005 block, which mapped onto del_timer() -- absent
+// from 7.x just like del_timer_sync(), so it only moved the error.
+// ---------------------------------------------------------------------
+#if !defined(NV_DEL_TIMER_SYNC_PRESENT)
+#if defined(NV_TIMER_DELETE_SYNC_PRESENT)
+#define del_timer_sync(t) timer_delete_sync(t)
+#define del_timer(t) timer_delete(t)
+#else
+#error "this tree has neither the 6.x (del_timer_sync) nor the 7.x (timer_delete_sync) timer-removal API"
+#endif
+#endif
+
+
+// ---------------------------------------------------------------------
+// 7.x's fortified-string policy dropped the raw strncpy() entry point
+// altogether: include/linux/string.h has no declaration for it (6.12:70 has)
+// and System.map keeps only strncpy_from_user*, so nvidia/os-interface.c:747
+// (and linux_nvswitch.c:2028 / :2383, uvm_pmm_gpu.c:3046,
+// nvidia-modeset-linux.c:325) compile against an implicit declaration:
+//   nvidia/os-interface.c:747:5: error: implicit declaration of function
+//      'strncpy'
+// Re-implement it rather than retargeting five call sites: the call sites use
+// strncpy's *return value* too (linux_nvswitch.c:2383 returns it), so a plain
+// strscpy redirect would not type-check.  The copy below is strncpy's
+// documented behaviour verbatim (truncate, then pad the remainder with NULs)
+// built from strnlen()/memcpy()/memset(), which every supported tree has.
+// The 0006-style probe nv_strncpy_raw_present records whether the kernel
+// still declares the real one, so a 6.x tree keeps using it.
+// ---------------------------------------------------------------------
+#if !defined(NV_STRNCPY_RAW_PRESENT)
+static inline char *nv_compat_strncpy(char *dest, const char *src, size_t n)
+{
+    size_t len;
+
+    if (n == 0)
+        return dest;
+
+    len = strnlen(src, n - 1);
+    memcpy(dest, src, len);
+    memset(dest + len, 0, n - len);
+
+    return dest;
+}
+#define strncpy(d, s, n) nv_compat_strncpy(d, s, n)
+#endif
+
+#endif /* NV_KERNEL_COMPAT_7X_H */

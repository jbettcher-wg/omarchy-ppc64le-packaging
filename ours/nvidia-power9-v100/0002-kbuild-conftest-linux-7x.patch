kbuild, conftest and core shims: build 535.216.03 against Linux 7.x

Local workaround. 535.216.03 predates 7.x; none of this is ppc64le specific.

 - Kbuild: 7.x dropped the "ccflags-y += $(EXTRA_CFLAGS)" compat hook, which silently removed every flag the
   driver sets (-I for its own headers, -D__KERNEL__ -DMODULE -DNVRM). Re-add it. Give the conftest probes the
   same preincludes and C dialect kbuild uses (compiler-version.h, kconfig.h, compiler_types.h, -std=gnu11,
   -fms-extensions), without which ~250 probes fail or invert; keep them out of the version-string probe.
 - conftest.sh + nvidia.Kbuild: probes for del_timer_sync()/timer_delete_sync(), in_irq(),
   dma_map_ops.map_phys and strncpy, and address-of forms for probes 7.x made inline.
 - common/inc/nv-kernel-compat-7x.h (new), nv-linux.h, nv-time.h, nvidia-modeset-linux.c: shims selected by
   those verdicts (timer_delete_sync, in_hardirq, strscpy).
 - nvidia/nv-dma.c: use dma_map_ops.map_phys where .map_page is gone.
 - nvidia.Kbuild, nvidia-modeset.Kbuild: absolute path to the binary objects (7.x resolves $(src) differently
   for the prebuilt-object rule).

Needs kernel patch v100-0005 (linux-power9-v100): nvidia.ko's vm_flags_set() path reaches
__vma_start_write, which is GPL-only upstream.

--- a/Kbuild	2026-10-04 23:43:45.688527606 -0600
+++ b/Kbuild	2026-10-04 23:43:46.029947080 -0600
@@ -115,6 +115,12 @@
 EXTRA_CFLAGS += -DNV_SPECTRE_V2=$(NV_SPECTRE_V2)
 EXTRA_CFLAGS += -DNV_KERNEL_INTERFACE_LAYER
 
+# Kernels >= v7 dropped the "ccflags-y += $(EXTRA_CFLAGS)" compat hook that v6.12
+# still ships in scripts/Makefile.lib, so every flag in the block above (the -I$(src) pair that
+# carries this tree's own headers, -D__KERNEL__ -DMODULE -DNVRM, the -W set) is silently dropped for
+# this out-of-tree module build. Re-establish it on the driver side so one patch works on 6.x and 7.x.
+ccflags-y += $(EXTRA_CFLAGS)
+
 #
 # Detect SGI UV systems and apply system-specific optimizations.
 #
@@ -155,6 +161,56 @@
 NV_CONFTEST_CFLAGS += $(call cc-disable-warning,pointer-sign)
 NV_CONFTEST_CFLAGS += $(call cc-option,-fshort-wchar,)
 
+# The probe flags must mirror what kbuild puts in front of every kernel compile
+# (scripts/Makefile.build 'orig_initial'/'initial_compileflags'), which the probe
+# flags otherwise miss:
+#   -include <tree>/include/linux/compiler-version.h
+#   -include <tree>/include/linux/kconfig.h
+#   -include <tree>/include/linux/compiler_types.h
+#   -std=gnu11  (CC_FLAGS_DIALECT, kernel Makefile:813; also in the working Sep
+#                build's savedcmd nvidia/.nv-acpi.o.cmd)
+# Two consequences of missing them:
+# 1) IS_ENABLED()/ZERO_OR_ONE() is not yet defined when a kernel header first uses
+#    it (7.x include/linux/fortify-string.h:527 'if ((IS_ENABLED(KBUILD_EXTRA_WARN1) ||'
+#    inside fortify_memcpy_chk), so the identifier is a plain C name:
+#      error: 'KBUILD_EXTRA_WARN1' undeclared (first use in this function)
+#    which makes every probe that reaches <linux/string.h> fail -- anything
+#    including <linux/mm.h>. Because the 'functions' verdicts are inverted
+#    (conftest/sh:270), that reported the LEGACY get_user_pages shape as present
+#    and nv-mm.h:104 then called it with 8 arguments:
+#      error: too many arguments to function 'get_user_pages'; expected 4, have 8
+# 2) with gcc-toolset-15 the default dialect is C23-enough, and 7.x's own
+#    headers then stop parsing (stddef.h:11:9 'false' as enumeration constant,
+#    types.h:34:33 'bool' via typedef), corrupting the same verdicts.
+# Replaying one probe shows both fixes together:
+#   gcc -c p.c $(CF)                      -> error: 'bool' cannot be defined ...
+#   gcc -c p.c $(CF) -std=gnu11 -include .../compiler_types.h  -> rc 0
+# The preinclude list and the dialect are taken from the kernel tree so the
+# patch stays correct across kernel versions.
+NV_KERNEL_PREINCLUDE := $(NV_KERNEL_SOURCES)/include/linux/compiler-version.h \
+                        $(NV_KERNEL_SOURCES)/include/linux/kconfig.h \
+                        $(NV_KERNEL_SOURCES)/include/linux/compiler_types.h
+NV_KERNEL_PREINCLUDE_EXISTS := $(foreach h,$(filter $(NV_KERNEL_PREINCLUDE),$(wildcard $(NV_KERNEL_PREINCLUDE))),-include $(h))
+NV_CONFTEST_CFLAGS += $(NV_KERNEL_PREINCLUDE_EXISTS)
+# The version-string fragment must NOT see the preinclude trio: with -E -P every
+# non-directive line of the -included headers is echoed into the '// Kernel version:'
+# comment, which Kbuild:406 then pastes into every generated conftest header. On 7.x
+# that injects real C (include/linux/compiler_types.h:190's struct ftrace_branch_data,
+# include/linux/iversion.h's _context_unsafe_alias) into conftest/{headers,macros,
+#functions,symbols,types,generic}.h, so all ~250 probes then die on:
+#   conftest/headers.h:94:8: error: redefinition of 'struct ftrace_branch_data'
+#   (note: originally defined here include/linux/compiler_types.h:190)
+# and the generated headers' version stamp becomes a 21-line blob. It is only a
+# cosmetic version string, so give it the minimal flag set instead.
+NV_CONFTEST_VERSION_CFLAGS = $(NV_CFLAGS_FROM_CONFTEST) $(NV_KERNEL_C_DIALECT)
+# 7.x also needs the MS-extension dialect flag for include/linux/fs.h:2436's struct
+# filename layout (otherwise: 'declaration does not declare anything' plus the
+# static_assert at fs.h:2440 'sizeof(struct filename) % 64 == 0'); the kernel's own
+# compile line carries it (see savedcmd arch/powerpc/kernel/.align.o.cmd).
+NV_CONFTEST_CFLAGS += $(call cc-option,-fms-extensions,)
+NV_KERNEL_C_DIALECT := $(shell grep -Eo '(-std=[[:alnum:]]+)' $(NV_KERNEL_SOURCES)/Makefile)
+NV_CONFTEST_CFLAGS += $(NV_KERNEL_C_DIALECT)
+
 NV_CONFTEST_COMPILE_TEST_HEADERS := $(obj)/conftest/macros.h
 NV_CONFTEST_COMPILE_TEST_HEADERS += $(obj)/conftest/functions.h
 NV_CONFTEST_COMPILE_TEST_HEADERS += $(obj)/conftest/symbols.h
@@ -358,7 +414,7 @@
 
 $(obj)/conftest/uts_release: NV_GENERATE_UTS_RELEASE
 	@mkdir -p $(dir $@)
-	@NV_UTS_RELEASE="// Kernel version: `$(NV_CONFTEST_CMD) compile_tests '$(NV_CONFTEST_CFLAGS)' uts_release`"; \
+	@NV_UTS_RELEASE="// Kernel version: `$(NV_CONFTEST_CMD) compile_tests '$(NV_CONFTEST_VERSION_CFLAGS)' uts_release`"; \
 	if ! [ -f "$@" ] || [ "$$NV_UTS_RELEASE" != "`cat $@`" ]; \
 	then echo "$$NV_UTS_RELEASE" > $@; fi
 

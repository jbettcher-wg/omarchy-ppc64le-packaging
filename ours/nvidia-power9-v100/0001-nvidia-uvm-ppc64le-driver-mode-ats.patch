--- a/nvidia-uvm/uvm_va_space_mm.c	2026-10-04 23:43:45.699958349 -0600
+++ b/nvidia-uvm/uvm_va_space_mm.c	2026-10-04 23:43:45.899951519 -0600
@@ -213,8 +213,26 @@
         UVM_ENTRY_VOID(uvm_ats_invalidate(get_va_space(mn), start, end));
     }
 
+    static void uvm_mmu_notifier_release_ats(struct mmu_notifier *mn,
+                                             struct mm_struct *mm)
+    {
+        // The mm is going away. Flush every one of its translations out of
+        // the nest-MMU TLBs (full-PASID invalidate plus the required
+        // membars) before the kernel frees the pages.
+        //
+        // The 4.18 kernel-mode ATS path did this in the kernel's own
+        // mmu_notifier .release (npu-dma.c). On the 6.12 Stage-1 kernel the
+        // driver owns the notifier, and driver-mode ATS otherwise never
+        // sees a full invalidate at process exit -- exit_mmap() releases
+        // the mmu notifiers before it unmaps the VMAs -- so without this
+        // the nest MMU keeps the dead PASID's TLB entries, the GPU memory
+        // is not freed, and a recycled PID can hit stale translations.
+        UVM_ENTRY_VOID(uvm_ats_invalidate(get_va_space(mn), 0, ~0UL));
+    }
+
     static struct mmu_notifier_ops uvm_mmu_notifier_ops_ats =
     {
+        .release = uvm_mmu_notifier_release_ats,
 #if defined(NV_MMU_NOTIFIER_OPS_HAS_INVALIDATE_RANGE)
         .invalidate_range = uvm_mmu_notifier_invalidate_range_ats,
 #elif defined(NV_MMU_NOTIFIER_OPS_HAS_ARCH_INVALIDATE_SECONDARY_TLBS)

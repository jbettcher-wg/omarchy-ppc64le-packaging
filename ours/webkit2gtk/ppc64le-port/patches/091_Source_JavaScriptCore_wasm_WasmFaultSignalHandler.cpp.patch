+// context, and cannot rewrite the PC to the throw trampoline. There is
+// nothing this can usefully do, and Options::useWasmFaultSignalHandler() is
+// forced false on every such platform, so the handler is never installed --
+// but the file is compiled whenever ENABLE(WEBASSEMBLY) is on, and it did not
+// compile at all in that configuration before this arm existed. Bounds checks
+// are explicit there, which is what IPInt does unconditionally anyway.
+static SignalAction trapHandler(Signal signal, SigInfo&, PlatformRegisters&)
+{
+    RELEASE_ASSERT(signal == Signal::AccessFault);
+    return SignalAction::NotHandled;
+}

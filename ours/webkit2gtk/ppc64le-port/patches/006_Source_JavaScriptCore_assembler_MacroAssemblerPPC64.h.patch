+    void vectorReplaceLane(SIMDLane lane, TrustedImm32 laneIndex, FPRegisterID src, FPRegisterID dest)
+    {
+        unsigned index = static_cast<unsigned>(laneIndex.m_value);
+        switch (lane) {
+        case SIMDLane::f64x2:
+            // No GPR round trip: the doubleword is already where it belongs.
+            if (index)
+                m_assembler.xxpermdi(dest, src, dest, 1);
+            else
+                m_assembler.xxpermdi(dest, dest, src, 0);
+            return;
+        case SIMDLane::f32x4: {
+            // mfvsrwz reads ISA word 1, which is where this port keeps a
+            // single, so the integer path then places it by lane index.
+            //
+            // Into the MEMORY temp, not the data temp: the integer path uses
+            // the data temp as its own scratch, so handing it the scalar in
+            // that register destroyed the value before the insert and left
+            // the lane unchanged. The first BBQ run of
+            // JSTests/wasm/stress/simd-instructions-construct.js found it;
+            // testPPC64VectorReplaceLaneFloat32 now covers this arm, which
+            // the original lane-float test did not exercise.
+            auto temp = temps<Memory>();
+            m_assembler.mfvsrwz(temp.memory(), src);
+            vectorReplaceLane(SIMDLane::i32x4, laneIndex, temp.memory(), dest);
+            return;
+        }
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+    }

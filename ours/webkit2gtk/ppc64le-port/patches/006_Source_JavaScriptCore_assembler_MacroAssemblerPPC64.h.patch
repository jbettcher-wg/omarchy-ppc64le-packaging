+    void storeImpl(StoreKind kind, RegisterID src, BaseIndex address)
+    {
+        if (isXFormBaseIndex(address)) {
+            emitStoreXForm(kind, src, address.base, address.index);
+            return;
+        }
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), storeKindNeedsDSForm(kind));
+        emitStoreDForm(kind, src, resolution.base, resolution.offset);
+    }

+    // ---- integer division ----
+    //
+    // The POWER ISA leaves the divide instructions UNDEFINED for two inputs:
+    // a divisor of zero, and (for the signed forms) the most negative number
+    // divided by -1. ARM64 defines both -- sdiv/udiv return 0 for a zero
+    // divisor and INT_MIN for INT_MIN/-1 -- and JSC's shared code is written
+    // against the ARM64 guarantees, so these four reproduce them.
+    //
+    // What POWER9 actually returns, measured rather than assumed, by
+    // `divprobe.c` next to this port's notes `[MEASURED]`:
+    //
+    //     divd  INT64_MIN / -1 -> 0          ARM64: INT64_MIN
+    //     divw  INT32_MIN / -1 -> 0          ARM64: INT32_MIN
+    //     divd / divw / divdu / divwu  x / 0 -> 0    ARM64: 0
+    //
+    // So the zero-divisor case happens to agree on this machine and the
+    // INT_MIN case does not. Both are still architecturally undefined, and
+    // relying on a measured-but-undefined result is precisely the class of
+    // mistake this port keeps finding, so both are made explicit. None of
+    // this is on a path where three extra fixed-point instructions matter
+    // next to a divide.
+    //
+    // The INT_MIN/-1 correction is exact rather than a patch-up: x / -1 is
+    // -x for every x, INT_MIN included, because `neg` wraps INT_MIN to
+    // itself. So when the divisor is -1 the undefined quotient is simply
+    // discarded in favour of `neg dividend`. The selects are `isel`, so
+    // there is no branch, and the undefined divide is harmless to execute --
+    // PowerPC integer division never traps, it only leaves RT undefined (and
+    // sets OV, which nothing here reads).
+    //
+    // dest may alias either operand: it is written only by the final isel,
+    // after every read of dividend and divisor.
+
+    void div32(RegisterID dividend, RegisterID divisor, RegisterID dest)
+    {
+        // 32-bit signed divide done at 64 bits on sign-extended operands.
+        // -2^31 / -1 is then an ordinary 64-bit 2^31 whose low word is
+        // 0x80000000, bit for bit ARM64's answer, so the INT_MIN case needs
+        // no correction here -- only the zero divisor does. The operands must
+        // be sign-extended because this port keeps 32-bit values
+        // zero-extended (see the invariant above).
+        auto temp = temps<Data, Memory>();
+        m_assembler.extsw(temp.data(), dividend);
+        m_assembler.extsw(temp.memory(), divisor);
+        m_assembler.divd(temp.data(), temp.data(), temp.memory());
+        m_assembler.li(temp.memory(), 0);
+        // cmpwi reads only the low word, which is the whole of a 32-bit
+        // divisor whichever way its upper half is extended.
+        emitSelect(emitCompare32(Equal, divisor, TrustedImm32(0)), temp.memory(), temp.data(), dest);
+        maskLow32(dest);
+    }
+
+    void div64(RegisterID dividend, RegisterID divisor, RegisterID dest)
+    {
+        // At 64 bits there is no wider type to escape into, so INT64_MIN / -1
+        // has to be answered directly. `neg` is that answer.
+        auto temp = temps<Data, Memory>();
+        m_assembler.divd(temp.data(), dividend, divisor);
+        m_assembler.neg(temp.memory(), dividend);
+        emitSelect(emitCompare64(Equal, divisor, static_cast<int64_t>(-1)), temp.memory(), temp.data(), temp.data());
+        m_assembler.li(temp.memory(), 0);
+        emitSelect(emitCompare64(Equal, divisor, static_cast<int64_t>(0)), temp.memory(), temp.data(), dest);
+    }

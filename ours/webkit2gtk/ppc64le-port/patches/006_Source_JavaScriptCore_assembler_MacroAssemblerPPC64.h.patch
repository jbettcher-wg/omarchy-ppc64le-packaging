+    // instead would misreport the values that legitimately truncate to those.
+    Jump branchTruncateDoubleToInt32(FPRegisterID src, RegisterID dest, BranchTruncateType branchType = BranchIfTruncateFailed)
+    {
+        m_assembler.friz(fpTempRegister2, src);      // trunc(src), still a double

+    // one of these two, so the four-instruction cost documented at the bridge
+    // declaration is paid in exactly two functions rather than a hundred.
+    //
+    // The emitted operation is handed VRegisterIDs and may use vectorBridge2
+    // as scratch; it must not assume anything survives the call.
+    template<typename EmitOp>
+    void emitVMXUnary(FPRegisterID src, FPRegisterID dest, EmitOp emit)
+    {
+        m_assembler.xxlor(vectorBridge0VSR, src, src);
+        emit(vectorBridge0, vectorBridge0);
+        m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+    }
+
+    template<typename EmitOp>
+    void emitVMXBinary(FPRegisterID left, FPRegisterID right, FPRegisterID dest, EmitOp emit)
+    {
+        m_assembler.xxlor(vectorBridge0VSR, left, left);
+        m_assembler.xxlor(vectorBridge1VSR, right, right);
+        emit(vectorBridge0, vectorBridge0, vectorBridge1);
+        m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+    }

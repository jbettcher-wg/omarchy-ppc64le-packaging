+    // ---- byte swaps ----
+    //
+    // There is no register-to-register byte-reverse before POWER10's brh/brw/
+    // brd, so these are done with rotate-and-mask inserts, which is what gcc
+    // and clang emit for __builtin_bswap on POWER9.
+
+    void byteSwap16(RegisterID reg)
+    {
+        auto temp = temps<Data>();
+        // result = (reg >> 8 & 0xff) | (reg << 8 & 0xff00), zero-extended.
+        m_assembler.rlwinm(temp.data(), reg, 8, 16, 23);  // byte 0 -> byte 1
+        m_assembler.rlwinm(reg, reg, 24, 24, 31);         // byte 1 -> byte 0
+        m_assembler.or_(reg, reg, temp.data());
+        m_assembler.clrldi(reg, reg, 48);
+    }
+
+    void byteSwap32(RegisterID reg)
+    {
+        auto temp = temps<Data>();
+        // rotate left 8 gives bytes 2,1,0,3 in the low word; inserting the
+        // rotate-left-24 value into byte positions 0 and 2 completes the
+        // reversal. This is the classic PowerPC four-instruction bswap.
+        m_assembler.rlwinm(temp.data(), reg, 8, 0, 31);   // rotate left 8
+        m_assembler.rlwimi(temp.data(), reg, 24, 0, 7);   // insert byte
+        m_assembler.rlwimi(temp.data(), reg, 24, 16, 23); // insert byte
+        m_assembler.mr(reg, temp.data());
+        maskLow32(reg);
+    }
+
+    void byteSwap64(RegisterID reg)
+    {
+        // Reverse each 32-bit half, then swap the halves.
+        auto temp = temps<Data, Memory>();
+        m_assembler.srdi(temp.memory(), reg, 32); // high word
+        byteSwap32(reg);                          // low word reversed (uses data temp)
+        byteSwap32(temp.memory());                // high word reversed
+        m_assembler.sldi(reg, reg, 32);
+        m_assembler.or_(reg, reg, temp.memory());
+    }
+    // ---- shifts and rotates ----
+    //
+    // Two PowerPC facts drive all of these:
+    //
+    //  1. slw/srw/sraw consume SIX bits of the shift count and sld/srd/srad
+    //     SEVEN, so a count of 32 (or 64) produces zero rather than wrapping.
+    //     x86 and ARM mask the count to 5 (or 6) bits, and JSC's semantics
+    //     are x86's, so a register count must be masked before use. Skipping
+    //     this is a silent wrong answer only for counts >= 32, which is
+    //     exactly the case a test suite is least likely to cover.
+    //  2. sraw/srawi propagate the sign into the upper word, so an arithmetic
+    //     32-bit right shift breaks the zero-extension invariant and has to
+    //     be re-masked.
+
+    // Put (shiftAmount & mask) somewhere usable, without disturbing dest.
+    RegisterID maskedShiftCount(RegisterID shiftAmount, unsigned mask, RegisterID scratch)
+    {
+        m_assembler.andi_(scratch, shiftAmount, mask);
+        return scratch;
+    }
+
+    // Where the masked shift count lives.
+    //
+    // POWER's slw/srw/sld/srd do not mask their count the way x86 and ARM64
+    // do -- a count of 32 or more yields zero rather than count & 31 -- so the

+        bool isSigned = simdInfo.signMode == SIMDSignMode::Signed;
+        emitVMXUnary(input, dest, [&](VRegisterID t, VRegisterID b) {
+            if (isSigned) {
+                switch (simdInfo.lane) { // the RESULT lane
+                case SIMDLane::i16x8: high ? m_assembler.vupkhsb(t, b) : m_assembler.vupklsb(t, b); return;
+                case SIMDLane::i32x4: high ? m_assembler.vupkhsh(t, b) : m_assembler.vupklsh(t, b); return;
+                case SIMDLane::i64x2: high ? m_assembler.vupkhsw(t, b) : m_assembler.vupklsw(t, b); return;
+                default: RELEASE_ASSERT_NOT_REACHED();
+                }
+            }
+            // Zero-extension is a merge against zero: vmrgl* t, 0, b
+            // interleaves 0 b0 0 b1 ... from the memory-low half.
+            VRegisterID zero = vectorBridge2;
+            m_assembler.vxor(zero, zero, zero);
+            switch (simdInfo.lane) {
+            case SIMDLane::i16x8: high ? m_assembler.vmrghb(t, zero, b) : m_assembler.vmrglb(t, zero, b); return;
+            case SIMDLane::i32x4: high ? m_assembler.vmrghh(t, zero, b) : m_assembler.vmrglh(t, zero, b); return;
+            case SIMDLane::i64x2: high ? m_assembler.vmrghw(t, zero, b) : m_assembler.vmrglw(t, zero, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    // extmul: widen both operands as above, then multiply at the result
+    // width. The i64x2 form has no 64-bit multiply on the POWER8 floor and
+    // needs none: duplicating each wanted word (vmrg*w v, v, v) puts it in
+    // the odd position the 32x32->64 odd-word multiply reads.
+    void emitVectorExtendedMultiply(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest, bool high)
+    {
+        ASSERT(scalarTypeIsIntegral(simdInfo.lane));
+        ASSERT(simdInfo.signMode != SIMDSignMode::None);
+        bool isSigned = simdInfo.signMode == SIMDSignMode::Signed;
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            VRegisterID zero = vectorBridge2;
+            switch (simdInfo.lane) { // the RESULT lane
+            case SIMDLane::i16x8:
+                m_assembler.vxor(zero, zero, zero);
+                if (isSigned) {
+                    high ? m_assembler.vupkhsb(a, a) : m_assembler.vupklsb(a, a);
+                    high ? m_assembler.vupkhsb(b, b) : m_assembler.vupklsb(b, b);
+                } else {
+                    high ? m_assembler.vmrghb(a, zero, a) : m_assembler.vmrglb(a, zero, a);
+                    high ? m_assembler.vmrghb(b, zero, b) : m_assembler.vmrglb(b, zero, b);
+                }
+                // No plain halfword multiply exists; the multiply-add with a zero addend is one.
+                m_assembler.vmladduhm(t, a, b, zero);
+                return;
+            case SIMDLane::i32x4:
+                if (isSigned) {
+                    high ? m_assembler.vupkhsh(a, a) : m_assembler.vupklsh(a, a);
+                    high ? m_assembler.vupkhsh(b, b) : m_assembler.vupklsh(b, b);
+                } else {
+                    m_assembler.vxor(zero, zero, zero);
+                    high ? m_assembler.vmrghh(a, zero, a) : m_assembler.vmrglh(a, zero, a);
+                    high ? m_assembler.vmrghh(b, zero, b) : m_assembler.vmrglh(b, zero, b);
+                }
+                m_assembler.vmuluwm(t, a, b);
+                return;
+            case SIMDLane::i64x2:
+                high ? m_assembler.vmrghw(a, a, a) : m_assembler.vmrglw(a, a, a);
+                high ? m_assembler.vmrghw(b, b, b) : m_assembler.vmrglw(b, b, b);
+                isSigned ? m_assembler.vmulosw(t, a, b) : m_assembler.vmulouw(t, a, b);
+                return;
+            default:
+                RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    // After a doubleword-to-word conversion into vectorBridge0: one word per
+    // doubleword into memory lanes 0 and 1, zero into lanes 2 and 3.
+    void emitVectorPackDoublewordsToLowWords(FPRegisterID dest)
+    {
+        m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+        // VRA's words land in the memory-high half: the zero there, the results below.
+        m_assembler.vpkudum(vectorBridge0, vectorBridge2, vectorBridge0);
+        m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+    }
+
+    // dest = (negateProduct ? -mul1 : mul1) * mul2 + addend, one rounding.
+    // xvmadda* accumulates into XT, so the addend has to start in the
+    // register that becomes the result; dest can be that register only if no
+    // multiplicand still to be read lives there.
+    void emitVectorFusedMultiplyAdd(SIMDInfo simdInfo, FPRegisterID mul1, FPRegisterID mul2, FPRegisterID addend, FPRegisterID dest, bool negateProduct)
+    {
+        bool isFloat = simdInfo.lane == SIMDLane::f32x4;
+        RELEASE_ASSERT(isFloat || simdInfo.lane == SIMDLane::f64x2);
+        FPRegisterID a = mul1;
+        if (negateProduct) {
+            isFloat ? m_assembler.xvnegsp(fpTempRegister, mul1) : m_assembler.xvnegdp(fpTempRegister, mul1);
+            a = fpTempRegister;
+        }
+        auto multiplyAddInto = [&](FPRegisterID accumulator) {
+            isFloat ? m_assembler.xvmaddasp(accumulator, a, mul2) : m_assembler.xvmaddadp(accumulator, a, mul2);
+        };
+        if (dest == addend) {
+            multiplyAddInto(dest);
+            return;
+        }
+        bool destIsMultiplicand = dest == mul2 || (dest == mul1 && !negateProduct);
+        if (!destIsMultiplicand) {
+            moveVector(addend, dest);
+            multiplyAddInto(dest);
+            return;
+        }
+        moveVector(addend, fpTempRegister2);
+        multiplyAddInto(fpTempRegister2);
+        moveVector(fpTempRegister2, dest);
+    }
+
+    // Memory doubleword d (0 = bytes 0-7, 1 = bytes 8-15) into a GPR.
+    // mfvsrd reads ISA doubleword 0, which IS memory doubleword 1, so only
+    // memory doubleword 0 needs the swap.
+    void emitVectorDoublewordToGPR(FPRegisterID src, unsigned memoryDoubleword, RegisterID dest)
+    {
+        if (memoryDoubleword) {
+            m_assembler.mfvsrd(dest, src);
+            return;
+        }
+        m_assembler.xxpermdi(fpTempRegister2, src, src, 3);
+        m_assembler.mfvsrd(dest, fpTempRegister2);
+    }
+
+    // Put the ISA doubleword 0 of `value` into memory doubleword d of `dest`,
+    // keeping dest's other half.
+    void emitVectorMergeDoubleword(FPRegisterID dest, FPRegisterID value, unsigned memoryDoubleword)
+    {
+        if (memoryDoubleword)
+            m_assembler.xxpermdi(dest, value, dest, 1);
+        else
+            m_assembler.xxpermdi(dest, dest, value, 0);
+    }
+
+    // The ISA30/POWER8 seam for 128-bit memory access. RA is r0, which reads
+    // as the literal zero in the base position, so the folded address
+    // register is the X-form index.
+    void emitLoadVector(FPRegisterID dest, RegisterID addressRegister)
+    {
+        if (Assembler::hasISA30()) {
+            m_assembler.lxvx(dest, PPC64Registers::r0, addressRegister);
+            return;
+        }
+        m_assembler.lxvd2x(dest, PPC64Registers::r0, addressRegister);
+        m_assembler.xxswapd(dest, dest);
+    }
+
+    void emitStoreVector(FPRegisterID src, RegisterID addressRegister)
+    {
+        if (Assembler::hasISA30()) {
+            m_assembler.stxvx(src, PPC64Registers::r0, addressRegister);
+            return;
+        }
+        // src must not be clobbered, so the swap goes through the FP temp.
+        m_assembler.xxswapd(fpTempRegister, src);
+        m_assembler.stxvd2x(fpTempRegister, PPC64Registers::r0, addressRegister);
+    }

+            m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+            return;
+        case SIMDLane::i16x8:
+            RELEASE_ASSERT(index < 8);
+            m_assembler.xxlor(vectorBridge0VSR, src, src);
+            m_assembler.vsplth(vectorBridge0, vectorBridge0, 7 - index);
+            m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+            return;
+        case SIMDLane::i32x4:
+        case SIMDLane::f32x4:
+            RELEASE_ASSERT(index < 4);
+            m_assembler.xxspltw(dest, src, 3 - index);
+            return;
+        case SIMDLane::i64x2:
+        case SIMDLane::f64x2:
+            RELEASE_ASSERT(index < 2);
+            m_assembler.xxpermdi(dest, src, src, index ? 0 : 3);
+            return;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+    }
+    DEFINE_SIMD_FUNCS(vectorDupElement);
+
+    // EXTRACT a sixteen-byte window from the pair (n, m). The contract B3 is
+    // written against is ARM64's EXT:
+    //
+    //     result.mem[i] = (i + k < 16) ? n.mem[i + k] : m.mem[i + k - 16]
+    //
+    // vsldoi does exactly this in one VMX instruction, with the operands the
+    // other way round. Its ISA definition shifts the concatenation
+    // (VRA || VRB) left by SHB bytes in BIG-endian byte order; translated
+    // through the little-endian memory image, where memory byte j is ISA byte
+    // 15 - j, that is
+    //
+    //     dest.mem[j] = (j >= SHB) ? VRA.mem[j - SHB] : VRB.mem[j - SHB + 16]
+    //
+    // and SHB = 16 - k turns the second line into the first with VRA = m and
+    // VRB = n. So the pair is passed SWAPPED relative to ARM64 -- the same
+    // class of trap as the xxsel operand sense and the vpk* (upper, lower)
+    // order, and the reason the derivation is written out rather than
+    // asserted.
+    //
+    // k == 0 would need SHB == 16, which the four-bit field cannot hold. It
+    // is the identity on n.
+    void vectorExtractPair(SIMDInfo simdInfo, TrustedImm32 firstLane, FPRegisterID n, FPRegisterID m, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::i8x16);
+        unsigned k = static_cast<unsigned>(firstLane.m_value);
+        RELEASE_ASSERT(k < 16);
+        if (!k) {
+            moveVector(n, dest);
+            return;
+        }
+        emitVMXBinary(m, n, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            m_assembler.vsldoi(t, a, b, 16 - k);
+        });
+    }
+    // ==================================================================
+    // Vector splat.
+    //
+    // mtvsrd lands a GPR in ISA doubleword 0, so the scalar's low byte is
+    // ISA byte 7, its low halfword ISA halfword 3 and its low word ISA word
+    // 1 -- which is where the element indices below come from. The f32 pair
+    // needs no conversion: this port keeps a single as its raw 32-bit
+    // pattern in ISA word 1 of the FPR already.
+    //
+    // The word and doubleword cases are pure VSX and address the JSC vector
+    // register directly. The byte and halfword cases have no VSX form on the
+    // POWER8 floor -- xxspltib is ISA 3.0, and it takes an immediate rather
+    // than a register anyway -- so they go through VMX vspltb/vsplth, which
+    // cannot name a VSR below 32, so they go through the bridge above.
+    void vectorSplat(SIMDLane lane, RegisterID src, FPRegisterID dest)
+    {
+        switch (lane) {
+        case SIMDLane::i8x16:
+            m_assembler.mtvsrd(vectorBridge0VSR, src);
+            m_assembler.vspltb(vectorBridge0, vectorBridge0, 7);
+            m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+            return;
+        case SIMDLane::i16x8:
+            m_assembler.mtvsrd(vectorBridge0VSR, src);
+            m_assembler.vsplth(vectorBridge0, vectorBridge0, 3);
+            m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+            return;
+        case SIMDLane::i32x4:
+            m_assembler.mtvsrd(fpTempRegister, src);
+            m_assembler.xxspltw(dest, fpTempRegister, 1);
+            return;
+        case SIMDLane::i64x2:
+            m_assembler.mtvsrd(fpTempRegister, src);
+            m_assembler.xxpermdi(dest, fpTempRegister, fpTempRegister, 0);
+            return;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+    }
+
+    void vectorSplat(SIMDLane lane, FPRegisterID src, FPRegisterID dest)
+    {
+        switch (lane) {
+        case SIMDLane::f32x4:
+            m_assembler.xxspltw(dest, src, 1);
+            return;
+        case SIMDLane::f64x2:
+            m_assembler.xxpermdi(dest, src, src, 0);
+            return;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+    }
+
+    // The per-type names BBQ and B3 also call are GENERATED from the
+    // lane-parameterised primitive, exactly as ARM64 and x86_64 generate
+    // theirs. They are not a second hand-maintained naming scheme.
+    DEFINE_SIMD_FUNCS(vectorSplat);
+    // ==================================================================
+    // Vector floating-point: the float-only operations.
+    //
+    // WHAT AN f32x4 LANE IS, stated rather than inherited. This port keeps a
+    // SCALAR f32 as its raw single in ISA word 1 of doubleword 0
+    // (jsc-ppc64le-yarr-wasm.md section 7). A VECTOR of four f32 lanes is a
+    // different question, and the answer is the ordinary one: four packed
+    // IEEE singles, memory order equal to wasm lane order, exactly as x86 and
+    // ARM64 have them. The two models are not the same statement and only
+    // touch at one point -- memory word k is ISA word 3-k, so the scalar
+    // position, ISA word 1, is wasm LANE 2 of the vector view. Nothing here
+    // converts between single and double format, so the raw-bits model is
+    // neither used nor disturbed; xv*sp operate on all four lanes in place.
+    //
+    // Only operations that exist solely for floating-point lanes are in this
+    // group. add, sub, mul, neg and abs also have integer lanes, and those are
+    // VMX-form, so they wait on the register-model decision
+    // (jsc-ppc64le-vector-register-model.md) rather than being written twice.
+    //
+    // min, max, pmin and pmax are float-only but are NOT here: wasm's NaN and
+    // signed-zero rules do not match the one-instruction VSX behaviour, and
+    // jsc-ppc64le-wasm-simd.md section 5 gives them six instructions each.
+    // They need values chosen against the spec, not against the hardware.
+    void vectorDiv(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4)
+            m_assembler.xvdivsp(dest, left, right);
+        else if (simdInfo.lane == SIMDLane::f64x2)
+            m_assembler.xvdivdp(dest, left, right);
+        else
+            RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void vectorSqrt(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4)
+            m_assembler.xvsqrtsp(dest, input);
+        else if (simdInfo.lane == SIMDLane::f64x2)
+            m_assembler.xvsqrtdp(dest, input);
+        else
+            RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    // The four roundings. xvr*ic is round-to-nearest with ties to EVEN, which
+    // is what wasm's f32x4.nearest wants, so no fixup is needed.
+    void vectorCeil(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4)
+            m_assembler.xvrspip(dest, input);
+        else if (simdInfo.lane == SIMDLane::f64x2)
+            m_assembler.xvrdpip(dest, input);
+        else
+            RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void vectorFloor(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4)
+            m_assembler.xvrspim(dest, input);
+        else if (simdInfo.lane == SIMDLane::f64x2)
+            m_assembler.xvrdpim(dest, input);
+        else
+            RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void vectorTrunc(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4)
+            m_assembler.xvrspiz(dest, input);
+        else if (simdInfo.lane == SIMDLane::f64x2)
+            m_assembler.xvrdpiz(dest, input);
+        else
+            RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void vectorNearest(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4)
+            m_assembler.xvrspic(dest, input);
+        else if (simdInfo.lane == SIMDLane::f64x2)
+            m_assembler.xvrdpic(dest, input);
+        else
+            RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    // ==================================================================
+    // Vector float compares, min/max, and the saturating conversions.
+    //
+    // The hardware-versus-specification differences here were probed rather
+    // than read, and there are exactly two of them
+    // (jsc-ppc64le-vector-conversions.md section 1):
+    //
+    //   * xvmin/xvmax are minNum/maxNum -- given a NaN operand they return
+    //     the OTHER one. wasm wants the NaN. Signed zeros are already right
+    //     in both operand orders, so the obvious compare-and-select "fix"
+    //     would make those worse.
+    //   * xvcvspsxws maps NaN to INT_MIN. wasm wants 0. Range saturation,
+    //     -0.0 and truncation direction are all already correct, and the
+    //     UNSIGNED form needs no repair at all.
+    //
+    // Everything else in this group is one instruction.
+    void vectorConvert(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        ASSERT(simdInfo.lane == SIMDLane::i32x4);
+        if (simdInfo.signMode == SIMDSignMode::Signed)
+            m_assembler.xvcvsxwsp(dest, input);
+        else
+            m_assembler.xvcvuxwsp(dest, input);
+    }
+
+    void vectorTruncSat(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f64x2) {
+            // The *_zero forms. The dp->word conversions write each result
+            // into BOTH words of its doubleword (jsc-ppc64le-vector-conversions.md
+            // section 1.4), so the doubleword-wide NaN mask lines up with
+            // them, and vpkudum then keeps one word per doubleword and
+            // supplies the zero lanes. The conversion writes the bridge
+            // register directly: VSX fields are six bits wide.
+            if (simdInfo.signMode == SIMDSignMode::Unsigned)
+                m_assembler.xvcvdpuxws(vectorBridge0VSR, input);
+            else {
+                m_assembler.xvcmpeqdp(fpTempRegister, input, input);
+                m_assembler.xvcvdpsxws(vectorBridge0VSR, input);
+                m_assembler.xxland(vectorBridge0VSR, vectorBridge0VSR, fpTempRegister);
+            }
+            emitVectorPackDoublewordsToLowWords(dest);
+            return;
+        }
+        RELEASE_ASSERT(simdInfo.lane == SIMDLane::f32x4);
+        if (simdInfo.signMode == SIMDSignMode::Unsigned) {
+            // Already gives 0 for NaN and for every negative input.
+            m_assembler.xvcvspuxws(dest, input);
+            return;
+        }
+        // Build the not-NaN mask BEFORE converting, so dest may alias input.
+        m_assembler.xvcmpeqsp(fpTempRegister, input, input);
+        m_assembler.xvcvspsxws(dest, input);
+        m_assembler.xxland(dest, dest, fpTempRegister);
+    }
+
+    // min/max: six instructions, and the addition is what supplies the NaN --
+    // no constant and no memory access. Any NaN operand propagates through it.
+    //
+    // The integer lanes arrive here too -- BBQ's non-x86 arm routes every
+    // min/max through these two -- and are one VMX instruction each, signed
+    // or unsigned by the SIMDInfo. The merged layer had only the float arms,
+    // so i8x16.min_s reached the float RELEASE_ASSERT: found by the targeted
+    // wasm arith test under BBQ, not by review.
+    void vectorMin(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        if (scalarTypeIsIntegral(simdInfo.lane)) {
+            emitVectorIntegerMinMax(simdInfo, left, right, dest, true);
+            return;
+        }
+        emitVectorMinMax(simdInfo, left, right, dest, true);
+    }
+
+    void vectorMax(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        if (scalarTypeIsIntegral(simdInfo.lane)) {
+            emitVectorIntegerMinMax(simdInfo, left, right, dest, false);
+            return;
+        }
+        emitVectorMinMax(simdInfo, left, right, dest, false);
+    }
+
+    // The pseudo-minimum and pseudo-maximum the specification defines as a
+    // plain `b < a ? b : a`, with NO NaN special case -- so two instructions
+    // and no repair. Getting min and pmin the same way round would be a
+    // conformance bug that only NaN inputs could see.
+    void vectorPmin(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest, FPRegisterID scratch)
+    {
+        ASSERT(scalarTypeIsFloatingPoint(simdInfo.lane));
+        emitVectorCompareGreater(simdInfo, left, right, scratch);
+        m_assembler.xxsel(dest, left, right, scratch);
+    }
+
+    void vectorPmax(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest, FPRegisterID scratch)
+    {
+        ASSERT(scalarTypeIsFloatingPoint(simdInfo.lane));
+        emitVectorCompareGreater(simdInfo, right, left, scratch);
+        m_assembler.xxsel(dest, left, right, scratch);
+    }
+
+    // ==================================================================
+    // Vector shifts.
+    //
+    // The count is a VECTOR, one per lane, and POWER masks it to the lane
+    // width in hardware. Measured here at 0, 1, w-1, w and w+1 for every
+    // width: a byte count of 8 behaves as 0 and 9 as 1, a word count of 32 as
+    // 0 and 33 as 1, a doubleword count of 64 as 0 and 65 as 1.
+    //
+    // Unlike ARM64 there is no negated-count convention: ARM64 has only a
+    // left shift and reads a negative count as a right shift, whereas POWER
+    // has vsl, vsr and vsra as three separate instructions. Adopting that
+    // convention here would mean a run-time sign test to undo something that
+    // exists only because of another instruction set.
+    //
+    // The immediate forms splat the count as a BYTE for every lane width,
+    // which is what ARM64 does too: only the low bits of each lane's count
+    // are read, and the count is already masked below the lane width.
+    void vectorUshl(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID shift, FPRegisterID dest)
+    {
+        emitVMXBinary(input, shift, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: m_assembler.vslb(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vslh(t, a, b); return;
+            case SIMDLane::i32x4: m_assembler.vslw(t, a, b); return;
+            case SIMDLane::i64x2: m_assembler.vsld(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void vectorUshr(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID shift, FPRegisterID dest)
+    {
+        emitVMXBinary(input, shift, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: m_assembler.vsrb(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vsrh(t, a, b); return;
+            case SIMDLane::i32x4: m_assembler.vsrw(t, a, b); return;
+            case SIMDLane::i64x2: m_assembler.vsrd(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void vectorSshr(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID shift, FPRegisterID dest)
+    {
+        emitVMXBinary(input, shift, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: m_assembler.vsrab(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vsrah(t, a, b); return;
+            case SIMDLane::i32x4: m_assembler.vsraw(t, a, b); return;
+            case SIMDLane::i64x2: m_assembler.vsrad(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    // Put a constant shift count in every byte of fpTempRegister. Byte width
+    // serves every lane width because each lane reads only the low bits of
+    // its own count, and the caller has already reduced the count below the
+    // lane width.
+    void emitSplatShiftCount(TrustedImm32 shift)
+    {
+        auto temp = temps<Data>();
+        move(shift, temp.data());
+        vectorSplat(SIMDLane::i8x16, temp.data(), fpTempRegister);
+    }
+
+    void vectorShl8(SIMDInfo simdInfo, FPRegisterID input, TrustedImm32 shift, FPRegisterID dest)
+    {
+        emitSplatShiftCount(shift);
+        vectorUshl(simdInfo, input, fpTempRegister, dest);
+    }
+
+    void vectorUshr8(SIMDInfo simdInfo, FPRegisterID input, TrustedImm32 shift, FPRegisterID dest)
+    {
+        emitSplatShiftCount(shift);
+        vectorUshr(simdInfo, input, fpTempRegister, dest);
+    }
+
+    void vectorSshr8(SIMDInfo simdInfo, FPRegisterID input, TrustedImm32 shift, FPRegisterID dest)
+    {
+        emitSplatShiftCount(shift);
+        vectorSshr(simdInfo, input, fpTempRegister, dest);
+    }
+
+    // ==================================================================
+    // Vector compares, and the two reductions that read CR6.
+    //
+    // POWER gives equality and greater-than, signed and unsigned, per lane
+    // width. Everything else in the wasm set is one of those with the
+    // operands SWAPPED, complemented with xxlnor, or both. Operand swapping
+    // is the class that produced xxsel's reversed sense, so the tests assert
+    // asymmetric operand pairs: a symmetric pair agrees with the swapped and
+    // unswapped lowering alike.
+    //
+    // THE COMPARES DO NOT TOUCH CR6, deliberately. The recording forms exist
+    // and are separately named in the assembler, and only the two reductions
+    // below use them. Emitting a recording form here would leave the vector
+    // result identical and clobber CR6, so nothing in a SIMD test would
+    // notice -- and this port keeps every synthesised condition in a CR field
+    // (the XER-avoidance policy below), so a gratuitously clobbered field is
+    // a real hazard rather than a stylistic one. It uses CR0 and CR7 today,
+    // not CR6, which makes the mistake invisible rather than harmless.
+    void compareIntegerVector(RelationalCondition cond, SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        bool swap = false;
+        bool invert = false;
+        VectorCompareKind kind = VectorCompareKind::Equal;
+        switch (cond) {
+        case RelationalCondition::Equal:              kind = VectorCompareKind::Equal; break;
+        case RelationalCondition::NotEqual:           kind = VectorCompareKind::Equal; invert = true; break;
+        case RelationalCondition::GreaterThan:        kind = VectorCompareKind::GreaterSigned; break;
+        case RelationalCondition::LessThan:           kind = VectorCompareKind::GreaterSigned; swap = true; break;
+        case RelationalCondition::GreaterThanOrEqual: kind = VectorCompareKind::GreaterSigned; swap = true; invert = true; break;
+        case RelationalCondition::LessThanOrEqual:    kind = VectorCompareKind::GreaterSigned; invert = true; break;
+        case RelationalCondition::Above:              kind = VectorCompareKind::GreaterUnsigned; break;
+        case RelationalCondition::Below:              kind = VectorCompareKind::GreaterUnsigned; swap = true; break;
+        case RelationalCondition::AboveOrEqual:       kind = VectorCompareKind::GreaterUnsigned; swap = true; invert = true; break;
+        case RelationalCondition::BelowOrEqual:       kind = VectorCompareKind::GreaterUnsigned; invert = true; break;
+        default: RELEASE_ASSERT_NOT_REACHED();
+        }
+        FPRegisterID a = swap ? right : left;
+        FPRegisterID b = swap ? left : right;
+        emitVMXBinary(a, b, dest, [&](VRegisterID t, VRegisterID x, VRegisterID y) {
+            emitVectorCompareVMX(kind, simdInfo.lane, t, x, y);
+        });
+        if (invert)
+            m_assembler.xxlnor(dest, dest, dest);
+    }
+
+    void compareIntegerVectorWithZero(RelationalCondition cond, SIMDInfo simdInfo, FPRegisterID vector, FPRegisterID dest)
+    {
+        bool swap = false;
+        bool invert = false;
+        VectorCompareKind kind = VectorCompareKind::Equal;
+        switch (cond) {
+        case RelationalCondition::Equal:              kind = VectorCompareKind::Equal; break;
+        case RelationalCondition::NotEqual:           kind = VectorCompareKind::Equal; invert = true; break;
+        case RelationalCondition::GreaterThan:        kind = VectorCompareKind::GreaterSigned; break;
+        case RelationalCondition::LessThan:           kind = VectorCompareKind::GreaterSigned; swap = true; break;
+        case RelationalCondition::GreaterThanOrEqual: kind = VectorCompareKind::GreaterSigned; swap = true; invert = true; break;
+        case RelationalCondition::LessThanOrEqual:    kind = VectorCompareKind::GreaterSigned; invert = true; break;
+        default: RELEASE_ASSERT_NOT_REACHED();
+        }
+        m_assembler.xxlor(vectorBridge0VSR, vector, vector);
+        m_assembler.vxor(vectorBridge1, vectorBridge1, vectorBridge1);
+        if (swap)
+            emitVectorCompareVMX(kind, simdInfo.lane, vectorBridge0, vectorBridge1, vectorBridge0);
+        else
+            emitVectorCompareVMX(kind, simdInfo.lane, vectorBridge0, vectorBridge0, vectorBridge1);
+        m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+        if (invert)
+            m_assembler.xxlnor(dest, dest, dest);
+    }
+
+    // The VSX float compares are the ORDERED forms, which is what wasm wants:
+    // a NaN operand gives false. "not equal or unordered" is therefore the
+    // complement of ordered equality, and is true for a NaN -- which is why
+    // it is the only member of the set that needs the complement.
+    void compareFloatingPointVector(DoubleCondition cond, SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        RELEASE_ASSERT(scalarTypeIsFloatingPoint(simdInfo.lane));
+        bool isFloat = simdInfo.lane == SIMDLane::f32x4;
+        switch (cond) {
+        case DoubleCondition::DoubleEqualAndOrdered:
+            isFloat ? m_assembler.xvcmpeqsp(dest, left, right) : m_assembler.xvcmpeqdp(dest, left, right);
+            return;
+        case DoubleCondition::DoubleNotEqualOrUnordered:
+            isFloat ? m_assembler.xvcmpeqsp(dest, left, right) : m_assembler.xvcmpeqdp(dest, left, right);
+            m_assembler.xxlnor(dest, dest, dest);
+            return;
+        case DoubleCondition::DoubleGreaterThanAndOrdered:
+            isFloat ? m_assembler.xvcmpgtsp(dest, left, right) : m_assembler.xvcmpgtdp(dest, left, right);
+            return;
+        case DoubleCondition::DoubleGreaterThanOrEqualAndOrdered:
+            isFloat ? m_assembler.xvcmpgesp(dest, left, right) : m_assembler.xvcmpgedp(dest, left, right);
+            return;
+        case DoubleCondition::DoubleLessThanAndOrdered:
+            isFloat ? m_assembler.xvcmpgtsp(dest, right, left) : m_assembler.xvcmpgtdp(dest, right, left);
+            return;
+        case DoubleCondition::DoubleLessThanOrEqualAndOrdered:
+            isFloat ? m_assembler.xvcmpgesp(dest, right, left) : m_assembler.xvcmpgedp(dest, right, left);
+            return;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+    }
+
+    // THE TWO CR6 READERS. Measured, not read from the manual: a recording
+    // compare of a vector against zero sets CR6 bit 0 when EVERY lane is
+    // equal (so the vector is all zero) and CR6 bit 2 when NO lane is equal
+    // (so every lane is non-zero). CR6 occupies CR bits 24-27, so bit 0 is
+    // CR bit 24 and bit 2 is CR bit 26; the rlwinm rotates the wanted one to
+    // bit 31 and masks it.
+    void vectorAnyTrue(FPRegisterID vector, RegisterID dest)
+    {
+        m_assembler.xxlor(vectorBridge0VSR, vector, vector);
+        m_assembler.vxor(vectorBridge1, vectorBridge1, vectorBridge1);
+        // Byte width is enough: v128.any_true asks whether ANY BIT is set.
+        m_assembler.vcmpequb_(vectorBridge2, vectorBridge0, vectorBridge1);
+        m_assembler.mfcr(dest);
+        m_assembler.rlwinm(dest, dest, 25, 31, 31);   // CR bit 24 -> bit 31
+        m_assembler.xori(dest, dest, 1);              // all-zero means NOT any
+    }
+
+    void vectorAllTrue(SIMDInfo simdInfo, FPRegisterID vector, RegisterID dest)
+    {
+        m_assembler.xxlor(vectorBridge0VSR, vector, vector);
+        m_assembler.vxor(vectorBridge1, vectorBridge1, vectorBridge1);
+        // Here the lane width matters: all_true asks whether every LANE is
+        // non-zero, and a byte compare would answer a different question.
+        switch (simdInfo.lane) {
+        case SIMDLane::i8x16: m_assembler.vcmpequb_(vectorBridge2, vectorBridge0, vectorBridge1); break;
+        case SIMDLane::i16x8: m_assembler.vcmpequh_(vectorBridge2, vectorBridge0, vectorBridge1); break;
+        case SIMDLane::i32x4: m_assembler.vcmpequw_(vectorBridge2, vectorBridge0, vectorBridge1); break;
+        case SIMDLane::i64x2: m_assembler.vcmpequd_(vectorBridge2, vectorBridge0, vectorBridge1); break;
+        default: RELEASE_ASSERT_NOT_REACHED();
+        }
+        m_assembler.mfcr(dest);
+        m_assembler.rlwinm(dest, dest, 27, 31, 31);   // CR bit 26 -> bit 31
+    }
+
+    // ==================================================================
+    // Vector arithmetic: add, subtract, multiply, negate, absolute value.
+    //
+    // Each of these has BOTH an integer and a floating-point lane set, and
+    // both arms land together. Writing one and leaving the other to assert
+    // would ship a function that aborts for half its declared domain.
+    //
+    // The float arms are VSX and address the registers directly. The integer
+    // arms are VMX-form -- there is no VSX integer vector add on the POWER8
+    // floor -- so they go through the bridge and cost four instructions.
+    void vectorAdd(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4) {
+            m_assembler.xvaddsp(dest, left, right);
+            return;
+        }
+        if (simdInfo.lane == SIMDLane::f64x2) {
+            m_assembler.xvadddp(dest, left, right);
+            return;
+        }
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: m_assembler.vaddubm(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vadduhm(t, a, b); return;
+            case SIMDLane::i32x4: m_assembler.vadduwm(t, a, b); return;
+            case SIMDLane::i64x2: m_assembler.vaddudm(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void vectorSub(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4) {
+            m_assembler.xvsubsp(dest, left, right);
+            return;
+        }
+        if (simdInfo.lane == SIMDLane::f64x2) {
+            m_assembler.xvsubdp(dest, left, right);
+            return;
+        }
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: m_assembler.vsububm(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vsubuhm(t, a, b); return;
+            case SIMDLane::i32x4: m_assembler.vsubuwm(t, a, b); return;
+            case SIMDLane::i64x2: m_assembler.vsubudm(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void vectorMul(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4) {
+            m_assembler.xvmulsp(dest, left, right);
+            return;
+        }
+        if (simdInfo.lane == SIMDLane::f64x2) {
+            m_assembler.xvmuldp(dest, left, right);
+            return;
+        }
+        // wasm has no i8x16.mul, and BBQ scalarizes i64x2.mul itself because
+        // the single instruction for it, vmulld, is ISA 3.1 and therefore
+        // POWER10. So only the halfword and word forms arrive here.
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i16x8:
+                // There is no plain halfword multiply: vmladduhm is a
+                // multiply-add, and a zero addend makes it one.
+                m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+                m_assembler.vmladduhm(t, a, b, vectorBridge2);
+                return;
+            case SIMDLane::i32x4: m_assembler.vmuluwm(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void vectorNeg(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4) {
+            m_assembler.xvnegsp(dest, input);
+            return;
+        }
+        if (simdInfo.lane == SIMDLane::f64x2) {
+            m_assembler.xvnegdp(dest, input);
+            return;
+        }
+        emitVMXUnary(input, dest, [&](VRegisterID t, VRegisterID b) {
+            m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: m_assembler.vsububm(t, vectorBridge2, b); return;
+            case SIMDLane::i16x8: m_assembler.vsubuhm(t, vectorBridge2, b); return;
+            case SIMDLane::i32x4: m_assembler.vsubuwm(t, vectorBridge2, b); return;
+            case SIMDLane::i64x2: m_assembler.vsubudm(t, vectorBridge2, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void vectorAbs(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4) {
+            m_assembler.xvabssp(dest, input);
+            return;
+        }
+        if (simdInfo.lane == SIMDLane::f64x2) {
+            m_assembler.xvabsdp(dest, input);
+            return;
+        }
+        // max(a, 0 - a), signed. At the most negative value the negation
+        // wraps to itself and the maximum returns it -- which is what wasm
+        // specifies: i8x16.abs(-128) is -128.
+        emitVMXUnary(input, dest, [&](VRegisterID t, VRegisterID b) {
+            m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16:
+                m_assembler.vsububm(vectorBridge2, vectorBridge2, b);
+                m_assembler.vmaxsb(t, b, vectorBridge2);
+                return;
+            case SIMDLane::i16x8:
+                m_assembler.vsubuhm(vectorBridge2, vectorBridge2, b);
+                m_assembler.vmaxsh(t, b, vectorBridge2);
+                return;
+            case SIMDLane::i32x4:
+                m_assembler.vsubuwm(vectorBridge2, vectorBridge2, b);
+                m_assembler.vmaxsw(t, b, vectorBridge2);
+                return;
+            case SIMDLane::i64x2:
+                m_assembler.vsubudm(vectorBridge2, vectorBridge2, b);
+                m_assembler.vmaxsd(t, b, vectorBridge2);
+                return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    // ==================================================================
+    // Vector bitwise. The VSX logical group is bit-for-bit lane-agnostic, so
+    // these are one instruction each and the SIMDInfo is only asserted.
+    // No VMX form is involved, so this group does not depend on how the
+    // register-model question is settled.
+    void vectorAnd(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::v128);
+        m_assembler.xxland(dest, left, right);
+    }
+
+    void vectorOr(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::v128);
+        m_assembler.xxlor(dest, left, right);
+    }
+
+    void vectorXor(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::v128);
+        m_assembler.xxlxor(dest, left, right);
+    }
+
+    // wasm v128.andnot is `left & ~right`, and xxlandc is XA & ~XB in exactly
+    // that order -- one instruction, no operand swap.
+    void vectorAndnot(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::v128);
+        m_assembler.xxlandc(dest, left, right);
+    }
+
+    void vectorNot(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::v128);
+        m_assembler.xxlnor(dest, input, input);
+    }
+
+    // ARM64's bsl computes (sel & left) | (~sel & right) with the selector in
+    // the destination. xxsel computes (XA & ~XC) | (XB & XC), so the selector
+    // is XC and the SENSE IS THE OTHER WAY ROUND: a set selector bit takes XB.
+    // left therefore goes in XB and right in XA. XT == XC is safe because the
+    // selector is read before the result is written.
+    void vectorBitwiseSelect(FPRegisterID left, FPRegisterID right, FPRegisterID inputBitsAndDest)
+    {
+        m_assembler.xxsel(inputBitsAndDest, right, left, inputBitsAndDest);
+    }
+
+    // ==================================================================
+    // Saturating arithmetic, widening, narrowing, and the pairwise and
+    // extended multiplies.
+    //
+    // All VMX-form, so all through the bridge. The lowerings are IPInt's
+    // (llint/InPlaceInterpreter64.asm, the ipint_simd_* handlers), which the
+    // wasm corpus exercises; what is new here is the register plumbing. Two
+    // lane-order facts recur (jsc-ppc64le-wasm-simd.md section 2): the ISA's
+    // "high" half is the memory-HIGH half, so vupkh*/vmrgh* are wasm's *_high
+    // and vupkl*/vmrgl* its *_low; and the packs write VRA into the
+    // memory-high half, so wasm's (lower, upper) pair goes in as (upper, lower).
+    //
+    // The shared contract's lane argument is not uniform, and getting it
+    // wrong is a silently wrong width rather than a crash: ExtendLow/High and
+    // MulLow/High carry the RESULT lane; Narrow, ExtaddPairwise, ConvertLow,
+    // Promote and Demote carry the SOURCE lane (B3ReduceStrength.cpp says so
+    // for ExtaddPairwise in as many words; the x86 arms confirm the rest).
+    void vectorAddSat(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        ASSERT(simdInfo.signMode != SIMDSignMode::None);
+        bool isSigned = simdInfo.signMode == SIMDSignMode::Signed;
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: isSigned ? m_assembler.vaddsbs(t, a, b) : m_assembler.vaddubs(t, a, b); return;
+            case SIMDLane::i16x8: isSigned ? m_assembler.vaddshs(t, a, b) : m_assembler.vadduhs(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void vectorSubSat(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        ASSERT(simdInfo.signMode != SIMDSignMode::None);
+        bool isSigned = simdInfo.signMode == SIMDSignMode::Signed;
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: isSigned ? m_assembler.vsubsbs(t, a, b) : m_assembler.vsububs(t, a, b); return;
+            case SIMDLane::i16x8: isSigned ? m_assembler.vsubshs(t, a, b) : m_assembler.vsubuhs(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    // The "us" packs take SIGNED input and saturate to the unsigned range,
+    // which is what narrow_u is. The lane is the SOURCE width.
+    void vectorNarrow(SIMDInfo simdInfo, FPRegisterID lower, FPRegisterID upper, FPRegisterID dest, FPRegisterID)
+    {
+        ASSERT(simdInfo.signMode != SIMDSignMode::None);
+        bool isSigned = simdInfo.signMode == SIMDSignMode::Signed;
+        // upper in VRA, which becomes the memory-high half; lower in VRB.
+        emitVMXBinary(upper, lower, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i16x8: isSigned ? m_assembler.vpkshss(t, a, b) : m_assembler.vpkshus(t, a, b); return;
+            case SIMDLane::i32x4: isSigned ? m_assembler.vpkswss(t, a, b) : m_assembler.vpkswus(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void vectorExtendLow(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest) { emitVectorExtend(simdInfo, input, dest, false); }
+    void vectorExtendHigh(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest) { emitVectorExtend(simdInfo, input, dest, true); }
+
+    // The trailing scratch is x86's; POWER's vmul*e/vmul*o need none. It gets
+    // ARM64's InvalidFPRReg default (MacroAssemblerARM64.h) so that Air can
+    // declare the four-operand form and not burn a dead FP Tmp per extmul.
+    void vectorMulLow(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest, FPRegisterID = InvalidFPRReg) { emitVectorExtendedMultiply(simdInfo, left, right, dest, false); }
+    void vectorMulHigh(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest, FPRegisterID = InvalidFPRReg) { emitVectorExtendedMultiply(simdInfo, left, right, dest, true); }
+
+    void vectorPopcnt(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::i8x16);
+        emitVMXUnary(input, dest, [&](VRegisterID t, VRegisterID b) {
+            m_assembler.vpopcntb(t, b);
+        });
+    }
+
+    void vectorAvgRound(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16: m_assembler.vavgub(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vavguh(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    // i16x8.q15mulr_sat_s. vmhraddshs rounds and saturates in the one
+    // instruction, including the only case that needs saturating:
+    // (-32768 * -32768) is 32767. The relaxed form is permitted to be the same.
+    void vectorMulSat(FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+            m_assembler.vmhraddshs(t, a, b, vectorBridge2);
+        });
+    }
+
+    void vectorRelaxedQ15Mulr(FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        vectorMulSat(left, right, dest);
+    }
+
+    // i32x4.dot_i16x8_s. The pairing is within a word, which byte order
+    // cannot disturb.
+    void vectorDotProduct(FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+            m_assembler.vmsumshm(t, a, b, vectorBridge2);
+        });
+    }
+
+    // extadd_pairwise: the dot product against a vector of ones. There is no
+    // multiply-sum into halfwords, so the byte form is the even and the odd
+    // widening products added -- the same sum, each halfword of the result
+    // being one even and one odd byte. The lane is the SOURCE width.
+    void vectorExtaddPairwise(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        ASSERT(simdInfo.signMode != SIMDSignMode::None);
+        bool isSigned = simdInfo.signMode == SIMDSignMode::Signed;
+        emitVMXUnary(input, dest, [&](VRegisterID t, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16:
+                m_assembler.vspltisb(vectorBridge2, 1);
+                if (isSigned) {
+                    m_assembler.vmulesb(vectorBridge1, b, vectorBridge2);
+                    m_assembler.vmulosb(t, b, vectorBridge2);
+                } else {
+                    m_assembler.vmuleub(vectorBridge1, b, vectorBridge2);
+                    m_assembler.vmuloub(t, b, vectorBridge2);
+                }
+                m_assembler.vadduhm(t, t, vectorBridge1);
+                return;
+            case SIMDLane::i16x8:
+                m_assembler.vspltish(vectorBridge1, 1);
+                m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+                isSigned ? m_assembler.vmsumshm(t, b, vectorBridge1, vectorBridge2) : m_assembler.vmsumuhm(t, b, vectorBridge1, vectorBridge2);
+                return;
+            default:
+                RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    // The relaxed byte dot products. relaxed_dot_i8x16_i7x16_s is the
+    // halfword pairwise sum above with a real second operand; the _add form
+    // then widens pairwise to words against ones and adds the accumulator.
+    // Both multiply signed bytes, which is exact over the i7 range and
+    // implementation-defined outside it, as the relaxed specification allows.
+    void vectorRelaxedDotI8x16I7x16(FPRegisterID left, FPRegisterID right, FPRegisterID dest, FPRegisterID)
+    {
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            m_assembler.vmulesb(vectorBridge2, a, b);
+            m_assembler.vmulosb(t, a, b);
+            m_assembler.vadduhm(t, t, vectorBridge2);
+        });
+    }
+
+    void vectorRelaxedDotI8x16I7x16Add(FPRegisterID left, FPRegisterID right, FPRegisterID addend, FPRegisterID dest, FPRegisterID, FPRegisterID)
+    {
+        m_assembler.xxlor(vectorBridge0VSR, left, left);
+        m_assembler.xxlor(vectorBridge1VSR, right, right);
+        m_assembler.vmulesb(vectorBridge2, vectorBridge0, vectorBridge1);
+        m_assembler.vmulosb(vectorBridge0, vectorBridge0, vectorBridge1);
+        m_assembler.vadduhm(vectorBridge0, vectorBridge0, vectorBridge2);
+        m_assembler.vspltish(vectorBridge1, 1);
+        m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+        m_assembler.vmsumshm(vectorBridge0, vectorBridge0, vectorBridge1, vectorBridge2);
+        // right is dead, so its bridge register takes the addend.
+        m_assembler.xxlor(vectorBridge1VSR, addend, addend);
+        m_assembler.vadduwm(vectorBridge0, vectorBridge0, vectorBridge1);
+        m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+    }
+
+    // ==================================================================
+    // The width-changing conversions (jsc-ppc64le-vector-conversions.md
+    // section 1.4). Every VSX instruction here lands its result in the wrong
+    // word positions and needs a word-granularity fix: the dp->sp and dp->int
+    // forms DUPLICATE each result into both words of its doubleword, which
+    // vpkudum against zero undoes while supplying the zero lanes; xvcvspdp
+    // reads ISA words 0 and 2 -- memory lanes 3 and 1 -- so promote merges
+    // the wanted low lanes into those positions first. The VSX conversions
+    // name the bridge register directly, their fields being six bits wide,
+    // which saves a copy in each direction. The lane is the SOURCE width.
+    void vectorPromote(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::f32x4);
+        // [w2, w2, w3, w3] in ISA order: memory lanes 1 and 0 at the words xvcvspdp reads.
+        m_assembler.xxmrglw(dest, input, input);
+        m_assembler.xvcvspdp(dest, dest);
+    }
+
+    void vectorDemote(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        ASSERT_UNUSED(simdInfo, simdInfo.lane == SIMDLane::f64x2);
+        m_assembler.xvcvdpsp(vectorBridge0VSR, input);
+        emitVectorPackDoublewordsToLowWords(dest);
+    }
+
+    void vectorConvertLow(SIMDInfo simdInfo, FPRegisterID input, FPRegisterID dest)
+    {
+        ASSERT(simdInfo.lane == SIMDLane::i32x4);
+        ASSERT(simdInfo.signMode != SIMDSignMode::None);
+        m_assembler.xxlor(vectorBridge0VSR, input, input);
+        if (simdInfo.signMode == SIMDSignMode::Signed) {
+            m_assembler.vupklsw(vectorBridge0, vectorBridge0);
+            m_assembler.xvcvsxddp(dest, vectorBridge0VSR);
+            return;
+        }
+        m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+        m_assembler.vmrglw(vectorBridge0, vectorBridge2, vectorBridge0);
+        m_assembler.xvcvuxddp(dest, vectorBridge0VSR);
+    }
+
+    // ==================================================================
+    // Relaxed SIMD: fused multiply-add, min/max, and the two permutes.
+    //
+    // relaxed_madd is a*b + c with one rounding: xvmadda* with the addend in
+    // XT. relaxed_nmadd is -(a*b) + c. The instruction shaped for it,
+    // xvnmsuba*, computes -(a*b - c), which differs from fma(-a, b, c) in one
+    // place: an EXACT-ZERO result is -0 rather than +0, because the sign of
+    // an exact zero is that of the subtraction it came from. The
+    // specification's reference is fma(-a, b, c), and ARM64's fmls and x86's
+    // mul-then-sub both give +0 there, so this negates a first and uses the
+    // positive form: one more instruction. IPInt's handler uses xvnmsuba*
+    // and therefore differs from BBQ in that one sign bit.
+    void vectorFusedMulAdd(SIMDInfo simdInfo, FPRegisterID mul1, FPRegisterID mul2, FPRegisterID addend, FPRegisterID dest, FPRegisterID)
+    {
+        emitVectorFusedMultiplyAdd(simdInfo, mul1, mul2, addend, dest, false);
+    }
+
+    void vectorFusedNegMulAdd(SIMDInfo simdInfo, FPRegisterID mul1, FPRegisterID mul2, FPRegisterID addend, FPRegisterID dest, FPRegisterID)
+    {
+        emitVectorFusedMultiplyAdd(simdInfo, mul1, mul2, addend, dest, true);
+    }
+
+    // The one-instruction minNum/maxNum that the relaxed specification
+    // permits; vectorMin/vectorMax above are the strict forms with the NaN
+    // repair.
+    void vectorRelaxedMin(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4)
+            m_assembler.xvminsp(dest, left, right);
+        else if (simdInfo.lane == SIMDLane::f64x2)
+            m_assembler.xvmindp(dest, left, right);
+        else
+            RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void vectorRelaxedMax(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest)
+    {
+        if (simdInfo.lane == SIMDLane::f32x4)
+            m_assembler.xvmaxsp(dest, left, right);
+        else if (simdInfo.lane == SIMDLane::f64x2)
+            m_assembler.xvmaxdp(dest, left, right);
+        else
+            RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    // i8x16.swizzle: a control lane of 16 or more must read as zero. vpermr
+    // takes its index modulo 32, so 16..31 would select VRA and anything
+    // above wraps; the mask is therefore built from the ORIGINAL control and
+    // applied afterwards, and VRA may simply be `a` again. The POWER8 arm is
+    // vperm, which indexes ISA bytes -- index k there is memory byte 15-k --
+    // so the control is complemented: ~k has the same low five bits as 31-k,
+    // and five bits is all vperm reads. The same instruction serves the
+    // relaxed form, whose out-of-range result is unconstrained.
+    void vectorSwizzle(FPRegisterID a, FPRegisterID control, FPRegisterID dest)
+    {
+        m_assembler.xxlor(vectorBridge0VSR, a, a);
+        m_assembler.xxlor(vectorBridge1VSR, control, control);
+        m_assembler.vspltisb(vectorBridge2, 15);
+        m_assembler.vcmpgtub(vectorBridge2, vectorBridge1, vectorBridge2); // the lanes whose index exceeds 15
+        if (Assembler::hasISA30())
+            m_assembler.vpermr(vectorBridge0, vectorBridge0, vectorBridge0, vectorBridge1);
+        else {
+            m_assembler.vnor(vectorBridge1, vectorBridge1, vectorBridge1);
+            m_assembler.vperm(vectorBridge0, vectorBridge0, vectorBridge0, vectorBridge1);
+        }
+        m_assembler.vandc(vectorBridge0, vectorBridge0, vectorBridge2);
+        m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+    }
+
+    // i8x16.shuffle over the 32-byte table a||b. vpermr selects VRB for
+    // 0..15 and VRA for 16..31, both in memory order -- wasm's numbering
+    // exactly -- so VRA = b and VRB = a, and the complemented-control vperm
+    // derivation gives the same operand order. Shuffle immediates are
+    // validated below 32, so there is no mask. Unlike ARM64's tbl2, a and b
+    // need not be adjacent registers; the shared signature is kept so the
+    // BBQ arm is one line.
+    void vectorSwizzle2(FPRegisterID a, FPRegisterID b, FPRegisterID control, FPRegisterID dest)
+    {
+        m_assembler.xxlor(vectorBridge0VSR, a, a);
+        m_assembler.xxlor(vectorBridge1VSR, b, b);
+        m_assembler.xxlor(vectorBridge2VSR, control, control);
+        if (Assembler::hasISA30())
+            m_assembler.vpermr(vectorBridge0, vectorBridge1, vectorBridge0, vectorBridge2);
+        else {
+            m_assembler.vnor(vectorBridge2, vectorBridge2, vectorBridge2);
+            m_assembler.vperm(vectorBridge0, vectorBridge1, vectorBridge0, vectorBridge2);
+        }
+        m_assembler.xxlor(dest, vectorBridge0VSR, vectorBridge0VSR);
+    }
+
+    // ==================================================================
+    // Bitmask: the sign bit of every lane, lane i at bit i.
+    //
+    // POWER has no movemask. vgbbd transposes the 8x8 bit matrix of each
+    // doubleword, so the TOP byte of each doubleword collects the eight sign
+    // bits of that doubleword's bytes, with lane order equal to bit order:
+    // memory byte 7 holds lanes 0-7 and memory byte 15 lanes 8-15. The wider
+    // lanes are first packed down to bytes with the SATURATING packs, which
+    // preserve every lane's sign, against a zero VRB so the lanes land in the
+    // memory-high half and a single mfvsrd reads them. i64x2 needs no vector
+    // work at all. This lowering is the port's own rather than IPInt's (which
+    // loops over the bytes in memory), so it is probed lane by lane in
+    // testmasm rather than inherited.
+    void vectorBitmask(SIMDInfo simdInfo, FPRegisterID vector, RegisterID dest)
+    {
+        auto temp = temps<Data>();
+        switch (simdInfo.lane) {
+        case SIMDLane::i64x2:
+            emitVectorDoublewordToGPR(vector, 0, temp.data());    // lane 0
+            m_assembler.mfvsrd(dest, vector);                      // lane 1 is ISA doubleword 0
+            m_assembler.rldicl(dest, dest, 1, 63);                 // its sign to bit 0
+            m_assembler.rldicl(temp.data(), temp.data(), 1, 63);
+            m_assembler.sldi(dest, dest, 1);
+            m_assembler.or_(dest, dest, temp.data());
+            return;
+        case SIMDLane::i8x16:
+            m_assembler.xxlor(vectorBridge0VSR, vector, vector);
+            m_assembler.vgbbd(vectorBridge0, vectorBridge0);
+            m_assembler.mfvsrd(dest, vectorBridge0VSR);                    // top byte: lanes 8-15
+            emitVectorDoublewordToGPR(vectorBridge0VSR, 0, temp.data());   // top byte: lanes 0-7
+            m_assembler.rldicl(dest, dest, 8, 56);
+            m_assembler.rldicl(temp.data(), temp.data(), 8, 56);
+            m_assembler.sldi(dest, dest, 8);
+            m_assembler.or_(dest, dest, temp.data());
+            return;
+        case SIMDLane::i16x8:
+            m_assembler.xxlor(vectorBridge0VSR, vector, vector);
+            m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+            m_assembler.vpkshss(vectorBridge0, vectorBridge0, vectorBridge2);
+            m_assembler.vgbbd(vectorBridge0, vectorBridge0);
+            m_assembler.mfvsrd(dest, vectorBridge0VSR);
+            m_assembler.rldicl(dest, dest, 8, 56);
+            return;
+        case SIMDLane::i32x4:
+            m_assembler.xxlor(vectorBridge0VSR, vector, vector);
+            m_assembler.vxor(vectorBridge2, vectorBridge2, vectorBridge2);
+            m_assembler.vpkswss(vectorBridge0, vectorBridge0, vectorBridge2);
+            m_assembler.vpkshss(vectorBridge0, vectorBridge0, vectorBridge2);
+            m_assembler.vgbbd(vectorBridge0, vectorBridge0);
+            m_assembler.mfvsrd(dest, vectorBridge0VSR);
+            // The four lanes occupied ISA bytes 0-3: the high nibble of the top byte.
+            m_assembler.rldicl(dest, dest, 4, 60);
+            return;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+    }
+    template<PtrTag resultTag, PtrTag locationTag>
+    static CodePtr<resultTag> readCallTarget(CodeLocationCall<locationTag> call)
+    {
+        return CodePtr<resultTag>::fromTaggedPtr(Assembler::readCallTarget(call.dataLocation()));
+    }
+
+    template<PtrTag tag>
+    static void replaceWithVMHalt(CodeLocationLabel<tag> instructionStart)
+    {
+        Assembler::replaceWithVMHalt(instructionStart.dataLocation());
+    }
+
+    template<PtrTag startTag, PtrTag destTag>
+    static void replaceWithJump(CodeLocationLabel<startTag> instructionStart, CodeLocationLabel<destTag> destination)
+    {
+        Assembler::replaceWithJump(instructionStart.dataLocation(), destination.dataLocation());
+    }
+
+    template<PtrTag startTag>
+    static void replaceWithNops(CodeLocationLabel<startTag> instructionStart, size_t memoryToFillWithNopsInBytes)
+    {
+        Assembler::replaceWithNops(instructionStart.dataLocation(), memoryToFillWithNopsInBytes);
+    }
+
+    // branchPtrWithPatch puts the five-word constant ladder FIRST, so the
+    // start of the branch and the start of the patchable constant are the
+    // same address, and replaceWithJump's one-word overwrite lands on the
+    // ladder's first word. revertJumpReplacementToPatch rewrites all five.
+    template<PtrTag tag>
+    static CodeLocationLabel<tag> startOfBranchPtrWithPatchOnRegister(CodeLocationDataLabelPtr<tag> label)
+    {
+        return label.labelAtOffset(0);
+    }
+
+    template<PtrTag tag>
+    static void revertJumpReplacementToBranchPtrWithPatch(CodeLocationLabel<tag> instructionStart, RegisterID rd, void* initialValue)
+    {
+        Assembler::revertJumpReplacementToPatch(instructionStart.dataLocation(), rd, initialValue);
+    }
+
+    // Three-way, unlike RISCV64's two-way: on PowerPC a tail call is `b` and
+    // a call is `bl`, and they differ in the LK bit that writeJumpSite sets
+    // from its `link` argument, so the tail case cannot share the call path.
+    template<PtrTag tag>
+    static void linkCall(void* code, Call call, CodePtr<tag> function)
+    {
+        if (!call.isFlagSet(Call::Near))
+            Assembler::linkPointer(code, call.m_label, function.taggedPtr());
+        else if (call.isFlagSet(Call::Tail))
+            Assembler::linkJump(code, call.m_label, function.untaggedPtr());
+        else
+            Assembler::linkCall(code, call.m_label, function.untaggedPtr());
+    }
+
+    template<PtrTag callTag, PtrTag destTag>
+    static void repatchCall(CodeLocationCall<callTag> call, CodeLocationLabel<destTag> destination)
+    {
+        Assembler::repatchPointer(call.dataLocation(), destination.taggedPtr());
+    }
+
+    template<PtrTag callTag, PtrTag destTag>
+    static void repatchCall(CodeLocationCall<callTag> call, CodePtr<destTag> destination)
+    {
+        Assembler::repatchPointer(call.dataLocation(), destination.taggedPtr());
+    }
+    // ==================================================================
+    // Control transfer.
+    //
+    // THE CENTRAL ABI RULE OF THIS PORT, and the thing most likely to be got
+    // wrong: a call to a C/C++ function and a call to generated code need
+    // DIFFERENT sequences, and the difference is not cosmetic.
+    //
+    // ELFv2 requires the CALLER to own a 32-byte linkage area at r1. A
+    // non-leaf callee writes its return address to 16(r1) -- its caller's
+    // frame -- before establishing a frame of its own, and may write CR to
+    // 8(r1). So a C call must move sp down by 32 first, or the callee
+    // scribbles on whatever the caller had there.
+    //
+    // A JavaScript call must do the exact opposite: sp at a JS call already
+    // points at the callee's new JS frame, and the callee's prologue writes
+    // CallerFrame and ReturnPC relative to it. Moving sp by 32 there shifts
+    // the whole frame and corrupts everything.
+    //
+    // The LLInt hit precisely this: jsc-ppc64le-port.md section 5.3 records
+    // `std 2, 24(1)` landing in the Callee slot of a live JS frame, so
+    // handleHostCall() received a callee equal to r2. offlineasm/ppc64.rb
+    // answered it by making them two different instructions (`call` versus
+    // `ppc64JSCall`) rather than one with a flag. The MacroAssembler cannot
+    // do that -- call(RegisterID, PtrTag) and call(Address, PtrTag) are each
+    // used for both -- so the discriminator here is the PtrTag's callee
+    // type, which JSCPtrTag.h already records for every tag.
+    //
+    // maxFrameExtentForSlowPathCall (32 on this target) is a SEPARATE
+    // reservation, made by the caller for outgoing stack arguments; pokes go
+    // to sp+0.. and, after this sequence moves sp down by 32, land exactly
+    // where ELFv2 puts the first stack parameter. The two do not overlap.
+    // ==================================================================
+
+    static constexpr bool callTargetIsNativeCode(PtrTag tag)
+    {
+        switch (tag) {
+#define JSC_PPC64_CALLEE_TYPE_CASE(name, calleeTypeValue, callerTypeValue) \
+        case JSC::name: return (calleeTypeValue) == PtrTagCalleeType::Native;
+        FOR_EACH_JSC_PTRTAG(JSC_PPC64_CALLEE_TYPE_CASE)
+#undef JSC_PPC64_CALLEE_TYPE_CASE
+        // CFunctionPtrTag is WTF's, not JSC's, so FOR_EACH_JSC_PTRTAG does
+        // not cover it -- but it is the one tag outside that list whose whole
+        // meaning is the answer to this question. bun:ffi calls its target
+        // with it, and an arbitrary C function is exactly what needs the
+        // linkage area, the r12 entry-point register and the r2 save. This is
+        // a classification, not a guess; every other unlisted tag still stops
+        // below.
+        case CFunctionPtrTag:
+            return true;
+        default:
+            break;
+        }
+        // A tag that is not in JSC's list reached a call. Rather than guess
+        // which ABI it wants, stop: guessing "generated code" corrupts the
+        // stack of a C callee, and guessing "C" corrupts a JS frame.
+        RELEASE_ASSERT_NOT_REACHED();
+        return false;
+    }
+
+    // r2 is the TOC pointer and is invariant across the whole engine
+    // (jsc-ppc64le-port.md section 5.3): never written by generated code,
+    // saved and restored around every call that could go through a linker
+    // stub. The explicit restore makes this correct whatever the linker does
+    // with the call site.
+    // True while generating a call whose caller has already reserved the
+    // 32-byte ELFv2 linkage area inside its own frame. Air does: see
+    // computeCCallingConvention, which asks for 32 + 8 * doublewords. In that
+    // case this must NOT move sp -- the argument stores have already been
+    // emitted at their callArg offsets from the current sp, and pushing here
+    // would put every one of them 32 bytes above where the callee looks.
+    bool m_cCallLinkageAreaIsReserved { false };
+
+    void emitCCallLinkageAreaSetup()
+    {
+        if (!m_cCallLinkageAreaIsReserved)
+            m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, -32);
+        // 0(r1) is the ELFv2 BACK CHAIN, and this stores the JS call frame
+        // pointer into it rather than the previous r1. That is deliberate,
+        // and it is what makes DECLARE_CALL_FRAME work on this target.
+        //
+        // JSC operations recover their CallFrame* with
+        //   DECLARE_CALL_FRAME(vm) == __builtin_frame_address(1)
+        // (interpreter/CallFrame.h). That identity holds on x86_64 and ARM64
+        // only because JSC deliberately makes callFrameRegister the SAME
+        // register the C compiler uses as a frame pointer -- rbp and x29. On
+        // PowerPC there is no such coincidence available: the C frame chain
+        // runs through r1's back chain, while cfr is r31. An operation
+        // reading __builtin_frame_address(1) here gets the JIT's stack
+        // pointer, not its call frame, and then reads garbage out of
+        // [cfr + CodeBlock].
+        //
+        // Planting cfr in the back-chain slot bridges the two: the callee's
+        // own prologue makes __builtin_frame_address(1) our r1, and one more
+        // dereference -- the back chain -- yields cfr. It is also a coherent
+        // chain to walk, because JSC's [cfr + 0] is CallerFrame, which is the
+        // back-chain convention already.
+        //
+        // The other half of this lives in the CPU(PPC64LE) arm of
+        // DECLARE_CALL_FRAME; neither half is correct without the other.
+        m_assembler.std(framePointerRegister, PPC64Registers::r1, 0);
+        m_assembler.std(PPC64Registers::r2, PPC64Registers::r1, 24);
+    }
+
+    void emitCCallLinkageAreaTeardown()
+    {
+        m_assembler.ld(PPC64Registers::r2, PPC64Registers::r1, 24);
+        if (!m_cCallLinkageAreaIsReserved)
+            m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, 32);
+    }
+
+    // call(), for a caller whose frame already holds the linkage area. The
+    // back chain and the TOC slot are still written -- they are what make
+    // DECLARE_CALL_FRAME work here -- but in place, at 0(r1) and 24(r1) of the
+    // frame the caller already sized for them.
+    template<typename... Args>
+    Call callWithReservedLinkageArea(Args&&... args)
+    {
+        bool saved = m_cCallLinkageAreaIsReserved;
+        m_cCallLinkageAreaIsReserved = true;
+        Call result = call(std::forward<Args>(args)...);
+        m_cCallLinkageAreaIsReserved = saved;
+        return result;
+    }
+
+    Jump jump()
+    {
+        auto label = m_assembler.label();
+        m_assembler.insn(Assembler::nopInsn());
+        m_assembler.insn(Assembler::unlinkedBranchInsn(false));
+        return Jump(label);
+    }
+
+    // farJump is a tail transfer: no return address, so no linkage area is
+    // needed even when the target is C code (ThunkGenerators does that once,
+    // for operationCompareStringEq). The callee will write its return
+    // address into 16(r1) of whatever frame is current, which for a tail
+    // jump is the frame our own caller already provided.
+    void emitIndirectJump(RegisterID target)
+    {
+        m_assembler.mtctr(target);
+        m_assembler.bctr();
+    }
+
+    // A TAIL call into a C function has the same ELFv2 entry requirement as a
+    // call: the callee's global entry point computes its own TOC from r12, so
+    // r12 must hold the entry address. emitIndirectCall says this for the call
+    // case; farJump used to discard the tag and emit a bare mtctr/bctr, so a
+    // tail call into a C operation entered with a stale r12 and the callee
+    // derived a garbage r2 from it. Nothing faults at the jump: intra-module
+    // code in this binary needs no TOC, so the wrong r2 survives until the
+    // first PLT-routed libc call inside the operation. It surfaced as a
+    // SIGSEGV in __plt_malloc under JSRopeString::resolveRope, reached from
+    // the DFG's stringEqualThunkGenerator slow path, which tail-calls
+    // operationCompareStringEq.
+    //
+    // No linkage area is set up here, and none is wanted: a tail call reuses
+    // the caller's frame and the callee returns past us to the original
+    // caller.
+    //
+    // callTargetIsNativeCode() cannot be reused: it RELEASE_ASSERTs on tags
+    // outside FOR_EACH_JSC_PTRTAG, and farJump is reached with NoPtrTag among
+    // others. The two tags that mean "a C function" are named explicitly.
+    //
+    // This predicate USED TO BE AN OVER-APPROXIMATION and is not any more.
+    // OperationPtrTag once covered both C operations and the LLInt and IPInt
+    // entry points, which are native code entered from generated code but are
+    // not C functions and do not obey the platform ABI. The entry thunks now
+    // carry LLIntEntryPtrTag, a tag in OperationPtrTag's own category added
+    // for exactly this distinction (runtime/JSCPtrTag.h). Everything this
+    // function gates -- the r12 the ELFv2 global entry needs, and the back
+    // chain the callee reads as its CallFrame* -- is now asked of a target
+    // that genuinely wants it, and of no other.
+    //
+    // The list below is hand-written because the distinction it draws does
+    // not exist in the category table: OperationPtrTag and LLIntEntryPtrTag
+    // are deliberately the SAME (Native callee, JIT caller) pair, since on
+    // every other architecture they are the same thing. So the list is made
+    // checkable instead of trusted: a new tag landing in that category fails
+    // this build until somebody decides which side of the ABI it is on.
+    static constexpr bool jumpTargetIsNativeCode(PtrTag tag)
+    {
+        return tag == OperationPtrTag || tag == CFunctionPtrTag;
+    }
+
+#define JSC_PPC64_CLASSIFY_NATIVE_CALLEE_JIT_CALLER_TAG(name, calleeTypeValue, callerTypeValue) \
+    static_assert((calleeTypeValue) != PtrTagCalleeType::Native \
+        || (callerTypeValue) != PtrTagCallerType::JIT \
+        || JSC::name == JSC::OperationPtrTag || JSC::name == JSC::LLIntEntryPtrTag, \
+        "A new (Native callee, JIT caller) PtrTag exists. PPC64LE has to know whether its " \
+        "target is a C function -- which needs r12 at its global entry and reads cfr out of " \
+        "the back chain at 0(r1) -- or generated code, which needs neither. Classify it in " \
+        "jumpTargetIsNativeCode().");
+    FOR_EACH_JSC_PTRTAG(JSC_PPC64_CLASSIFY_NATIVE_CALLEE_JIT_CALLER_TAG)
+#undef JSC_PPC64_CLASSIFY_NATIVE_CALLEE_JIT_CALLER_TAG
+
+    // THE TAIL-TRANSFER HALF OF THE LINKAGE AREA, and the history that
+    // decides its shape.
+    //
+    // A C function entered from JSC-generated code finds its CallFrame* at
+    // 0(incoming r1). That is this port's invariant, not ELFv2's: the back
+    // chain would ordinarily hold the caller's r1, and
+    // emitCCallLinkageAreaSetup plants cfr there instead so that
+    // DECLARE_CALL_FRAME -- *(void**)__builtin_frame_address(1) on this
+    // target -- yields the JS frame. A call has a producer. A TAIL JUMP into
+    // a C function had none, so JITOperationPrologueCallFrameTracer wrote
+    // whatever was last poked at 0(sp) into vm.topCallFrame, and every
+    // consumer of that -- exception unwinding, StackVisitor behind
+    // Error.stack, the sampling profiler -- read garbage. The store below is
+    // that missing producer.
+    //
+    // It could not be written until the discriminator was right, and the
+    // first attempt proved it the hard way. Planted for every
+    // jumpTargetIsNativeCode() tag, it was an immediate SIGSEGV in
+    // llint_program_prologue on `jsc -e "print(1+1)"`, with r1 == r31 at the
+    // fault [MEASURED, twice, four months apart]. The reason is that
+    // OperationPtrTag then covered two different callees. Preprocessed with
+    // this build's flags, four native-tag farJump sites exist on this target:
+    // LLIntThunks.cpp:95, :122 and :133, whose target is offlineasm LLInt and
+    // IPInt code, and ThunkGenerators.cpp:743, whose target is
+    // operationCompareStringEq. The first three are ENTRY thunks, entered
+    // with r1 == cfr because the callee's frame is not pushed yet, so 0(r1)
+    // is the live JS frame's CallerFrame slot and storing cfr there makes a
+    // frame its own caller. LLInt entry points also have no global entry
+    // point and never read r12: llint_program_prologue begins `mflr r0`, not
+    // `addis r2,r12` [MEASURED, objdump]. Both halves of what this function
+    // does were being asked of code that wanted neither.
+    //
+    // Those thunks now carry LLIntEntryPtrTag and this only fires for a
+    // genuine C tail call. The precondition it needs is the one the design
+    // left [CODE] and that is now checked: at such a site 0(r1)..31(r1) is
+    // dead scratch owned by the current frame. It holds at the one site that
+    // reaches here, because the stringEqual thunk pops back to its JIT
+    // caller's sp before jumping and both tiers reserve the extent below
+    // their locals -- JIT::frameRegisterCountFor adds
+    // maxFrameExtentForSlowPathCallInRegisters to numCalleeLocals, and
+    // Graph::frameRegisterCount takes the max of it and the parameter slots.
+    // The callee's own prologue is what consumes that reservation, and it is
+    // visible in the shipped object: operationCompareStringEq opens
+    // `stdu r1,-176(r1)` then `std r0,192(r1)`, which is its LR into 16 of
+    // OUR frame, and then `ld r3,0(r31); ld r3,0(r3)`, which is
+    // DECLARE_CALL_FRAME reading the word stored below [MEASURED, objdump].
+    // Thirty-two bytes is exactly the linkage area the callee assumes, and
+    // maxFrameExtentForSlowPathCall = 32 is the only thing keeping it off a
+    // DFG local.
+    //
+    // No sp adjustment: a tail jump reuses the caller's frame, which already
+    // has those 32 bytes. No r2 save: r2 is invariant across the engine, the
+    // callee re-derives it from r12 at its global entry, and it returns past
+    // us to the original JIT caller with that value.
+    //
+    // testmasm's testPPC64TailCallBackChainSeam measures all three shapes
+    // from one frame with the same reader.
+    //
+    // Designed in powerpc64le-handbook docs/jsc-ppc64le-tail-call-seam.md,
+    // whose site census and precondition are corrected by its erratum.
+    void emitIndirectJump(RegisterID target, PtrTag tag)
+    {
+        if (jumpTargetIsNativeCode(tag)) {

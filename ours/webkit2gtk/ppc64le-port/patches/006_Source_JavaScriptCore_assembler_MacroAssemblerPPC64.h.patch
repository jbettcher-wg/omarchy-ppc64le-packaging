+    // ---- ResultCondition: the state of a value that an operation produced ----
+
+    static CRTest crTestForResult(ResultCondition cond)
+    {
+        switch (cond) {
+        case Zero:           return { CRBit::EQ, true };
+        case NonZero:        return { CRBit::EQ, false };
+        case Signed:         return { CRBit::LT, true };
+        case PositiveOrZero: return { CRBit::LT, false };
+        case Overflow:
+        case Carry:
+            // These do not come from comparing a result against zero; the
+            // arithmetic helpers below produce their own CRTest. Reaching
+            // here means a caller asked for one on an operation that cannot
+            // produce it.
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+        return { CRBit::EQ, true };
+    }
+
+    CRTest emitTestResult32(ResultCondition cond, RegisterID value)
+    {
+        m_assembler.cmpwi(CRField::CR0, value, 0);
+        return crTestForResult(cond);
+    }
+
+    CRTest emitTestResult64(ResultCondition cond, RegisterID value)
+    {
+        m_assembler.cmpdi(CRField::CR0, value, 0);
+        return crTestForResult(cond);
+    }

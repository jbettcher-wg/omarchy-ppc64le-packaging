+    // ==================================================================
+    // Strong compare-and-swap.
+    //
+    // The sibling of the weak form above, and the whole difference is one
+    // inner loop. A STRONG CAS fails only on a genuine value mismatch. It
+    // may not report failure because the reservation was lost, and on an
+    // LL/SC machine a lost reservation is the only other way a stcx. can
+    // fail, so the stcx. result -- and only the stcx. result -- is retried.
+    // The compare is INSIDE that retry because after a failed stcx. the
+    // location may hold anything: a CAS that re-stores without re-comparing
+    // is not a CAS, it is a store that waited.
+    //
+    //         sync                       leading barrier, ONCE
+    //     1:  l{b,h,w,d}arx  rD,0,ea
+    //         cmpl{w,d}      cr0,rD,expected
+    //         bne            cr0,2f      genuine mismatch: leave, CR0.EQ = 0
+    //         st{b,h,w,d}cx. new,0,ea    CR0.EQ = stored
+    //         bne            cr0,1b      reservation lost: reload, RE-COMPARE
+    //     2:  lwsync                     trailing barrier, BOTH paths
+    //         mr             expected,rD the value seen
+    //
+    // The leading `sync` is outside the loop, which is where gcc puts it and
+    // is not an optimisation to be second-guessed: a sync orders everything
+    // before it against everything after it, including a re-executed larx,
+    // so repeating it per lap would be correct and useless. It is also still
+    // outside the reservation window, so the executed window on the storing
+    // path holds one compare and one guard branch and nothing else, exactly
+    // as the weak form's does. Everything section 3 of
+    // jsc-ppc64le-atomics-cas.md says about the leading-sync convention
+    // applies here unchanged, including why `lwsync` in its place would be
+    // a bug that only many threads find: lwsync has no StoreLoad edge, and
+    // StoreLoad is precisely what sequential consistency adds to
+    // acquire/release. Do not reach for the ARM64 shape either. ldaxr/stlxr
+    // give a CAS loop SC semantics on the instructions themselves, which is
+    // why MacroAssemblerARM64's atomics have no barriers near them;
+    // transplanting that here compiles, passes every single-threaded test,
+    // and is wrong.
+    //
+    // WHERE THE LOOP CLOSES IS A CORRECTNESS PROPERTY, not a style choice.
+    // The retry edge is on the stcx. only. Closing it over the mismatch as
+    // well would make the sign-extension seam below -- which costs the weak
+    // form a wrong answer that the DFG's outer loop turns into a hang --
+    // hang INSIDE this primitive, where there is no outer loop to absorb it
+    // and no tier below to fall back to. As written, a mismatch always
+    // leaves, so the worst a missing mask can do here is report Failure for
+    // a CAS that should have succeeded.
+    //
+    // The clrldi is that mask, and it is load-bearing for the same reason it
+    // is in the weak form: lbarx and lharx zero-extend while the callers'
+    // sub-word loads sign-extend, so the expected value of the byte 0xff
+    // arrives as 0xffffffff and would never compare equal to 0x000000ff.
+    // All four larx/stcx. widths are ISA 2.07 -- POWER8, this port's floor
+    // (docs/power8-baseline-power9-paths.md) -- so there is no hasISA30()
+    // gate here and both generations execute identical code.
+    //
+    // Status arrives in CR0.EQ for the compare and for the stcx. alike, and
+    // no barrier and no `mr` writes a condition register, so by the join it
+    // means "the store happened" on either path. Two finishers consume it:
+    // makeBranch for the branch form, and emitSetFromCR0 -- mfocrf plus
+    // rlwinm, gcc's own `mfcr 3,128; rlwinm 3,3,3,1` -- for the form that
+    // owes its caller a 0/1 in a GPR. ISA 3.0's `setb` would shorten the
+    // second by one instruction and is deliberately not used: it would be
+    // the only ISA-3.0 dependency in this family, for an optimisation, on a
+    // path that would then differ between POWER8 and POWER9.
+    //
+    // See powerpc64le-handbook jsc-ppc64le-atomics-cas.md sections 4 and 5.
+    // ==================================================================
+
+    // Leaves the CAS status in CR0.EQ (1 = the store happened) and the value
+    // it saw in expectedAndResult. Every public strong form below is this
+    // plus a finisher.
+    template<unsigned bitSize, typename AddressType>
+    void emitAtomicStrongCAS(RegisterID expectedAndResult, RegisterID newValue, AddressType address)
+    {
+        static_assert(bitSize == 8 || bitSize == 16 || bitSize == 32 || bitSize == 64);
+        auto temp = temps<Data, Memory>();
+
+        // As in the weak form: the effective address is finished before the
+        // barrier and before any reservation exists, because larx and stcx.
+        // have no D-form and because nothing may compute, load or store
+        // between a larx and its stcx. Note that it is also finished before
+        // the LOOP, so a retry re-executes the larx and nothing else.
+        auto resolution = resolveAddress(address, temp.memory());
+        RegisterID effectiveAddress = resolution.base;
+        if (resolution.offset) {
+            addImmediate64(resolution.base, static_cast<int64_t>(resolution.offset), temp.memory());
+            effectiveAddress = temp.memory();
+        }
+
+        if constexpr (bitSize < 32)
+            m_assembler.clrldi(expectedAndResult, expectedAndResult, 64 - bitSize);
+
+        memoryFence();
+
+        auto reload = label();
+        loadAndReserve<bitSize>(temp.data(), effectiveAddress);
+        if constexpr (bitSize == 64)
+            m_assembler.cmpld(CRField::CR0, temp.data(), expectedAndResult);
+        else
+            m_assembler.cmplw(CRField::CR0, temp.data(), expectedAndResult);
+        // A genuine mismatch leaves the loop with CR0.EQ clear, which is
+        // already the answer both finishers want. The guard word of this
+        // branch is the only instruction between the larx and the stcx. on
+        // the storing path; its `b` word is skipped there.
+        auto mismatch = makeBranch({ CRBit::EQ, false });
+        storeConditional<bitSize>(newValue, effectiveAddress);
+        // The one retry edge: the store-conditional failed, so the
+        // reservation was lost and nothing was written. Reload and compare
+        // again against the same expected value, which is still the
+        // caller's -- expectedAndResult is not written until the join.
+        makeBranch({ CRBit::EQ, false }).linkTo(reload, this);
+
+        // The storing path falls through to here; the mismatching path
+        // branches here. CR0.EQ distinguishes them and survives both of the
+        // instructions below.
+        mismatch.link(this);
+        loadFence();
+        move(temp.data(), expectedAndResult);
+    }
+

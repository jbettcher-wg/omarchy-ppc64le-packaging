+    {
+        m_assembler.mtvsrwa(dest, src); // sign-extend: the value is an int32
+        m_assembler.fcfid(dest, dest);
+    }
+
+    void convertInt32ToDouble(TrustedImm32 imm, FPRegisterID dest)
+    {
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        convertInt32ToDouble(temp.data(), dest);
+    }
+
+    // mtvsrwa sign-extends the int32 across doubleword 0, so ISA word 1 --
+    // where the model keeps a float -- holds the original value and word 0
+    // holds its sign extension. xvcvsxwsp converts each word independently,
+    // so lane 1 comes out as (float)src with one rounding.
+    void convertInt32ToFloat(RegisterID src, FPRegisterID dest)
+    {
+        m_assembler.mtvsrwa(dest, src);
+        m_assembler.xvcvsxwsp(dest, dest);
+    }
+
+    void convertUInt32ToDouble(RegisterID src, FPRegisterID dest)
+    {
+        m_assembler.mtvsrwz(dest, src); // zero-extend: the value is a uint32
+        m_assembler.fcfidu(dest, dest);
+    }
+
+    // Symmetric with convertInt32ToFloat above: mtvsrwz puts the zero-extended
+    // word where mtvsrwa puts the sign-extended one, and the vector convert
+    // leaves the single in ISA word 1, which is where the float register model
+    // wants it. No xscvdpsp/xxspltw tail is needed -- that is only for the
+    // scalar fcfid*s path the 64-bit conversions take.
+    void convertUInt32ToFloat(RegisterID src, FPRegisterID dest)
+    {
+        m_assembler.mtvsrwz(dest, src); // zero-extend: the value is a uint32
+        m_assembler.xvcvuxwsp(dest, dest);
+    }
+
+    void convertInt64ToDouble(RegisterID src, FPRegisterID dest)
+    {
+        m_assembler.mtvsrd(dest, src);
+        m_assembler.fcfid(dest, dest);
+    }
+
+    // No vector form takes a 64-bit integer, so this goes through the scalar
+    // single conversion and then into the model. The narrowing is exact: the
+    // value is already single-valued after fcfids.
+    void convertInt64ToFloat(RegisterID src, FPRegisterID dest)
+    {
+        m_assembler.mtvsrd(dest, src);
+        m_assembler.fcfids(dest, dest);
+        m_assembler.xscvdpsp(dest, dest);
+        m_assembler.xxspltw(dest, dest, 0);
+    }
+
+    void convertUInt64ToDouble(RegisterID src, FPRegisterID dest)
+    {
+        m_assembler.mtvsrd(dest, src);
+        m_assembler.fcfidu(dest, dest);
+    }
+
+    void convertUInt64ToFloat(RegisterID src, FPRegisterID dest)
+    {
+        m_assembler.mtvsrd(dest, src);
+        m_assembler.fcfidus(dest, dest);
+        m_assembler.xscvdpsp(dest, dest);
+        m_assembler.xxspltw(dest, dest, 0);
+    }
+
+    // The two crossings between the float model and the double model.
+    //
+    // xscvspdpn reads its single from ISA word 0 and the model keeps it in
+    // word 1, so widening splats word 1 across the register first; it is the
+    // non-signalling form because JSC moves raw patterns through here and a
+    // signalling NaN's payload must survive. Narrowing is the reverse:
+    // xscvdpsp ROUNDS (xscvdpspn does not -- it differs on a third of all
+    // inputs) and writes ISA word 0, so the splat puts it back in word 1.
+    // ISA 2.07 defines only word 0 for xscvdpsp; POWER9 happens to write
+    // word 1 as well, and this does not rely on that.
+    void convertFloatToDouble(FPRegisterID src, FPRegisterID dest)
+    {
+        m_assembler.xxspltw(dest, src, 1);
+        m_assembler.xscvspdpn(dest, dest);
+    }
+
+    void convertDoubleToFloat(FPRegisterID src, FPRegisterID dest)
+    {
+        m_assembler.xscvdpsp(dest, src);
+        m_assembler.xxspltw(dest, dest, 0);
+    }
+
+    // Truncations round toward zero and SATURATE on overflow, which is the
+    // ARM64 fcvtz* behaviour JSC expects; NaN becomes zero for the unsigned
+    // forms and the minimum value for the signed ones. Callers that need to
+    // know whether the value was representable use
+    // branchTruncateDoubleToInt32 instead.
+    //
+    // fctiw* leaves its 32-bit result in the low word of the FPR, and
+    // mfvsrwz brings that word back zero-extended -- which is exactly the
+    // 32-bit invariant, at no extra cost.
+    void truncateDoubleToInt32(FPRegisterID src, RegisterID dest)
+    {
+        m_assembler.fctiwz(fpTempRegister, src);
+        m_assembler.mfvsrwz(dest, fpTempRegister);
+    }
+
+    void truncateDoubleToUint32(FPRegisterID src, RegisterID dest)
+    {
+        m_assembler.fctiwuz(fpTempRegister, src);
+        m_assembler.mfvsrwz(dest, fpTempRegister);
+    }
+
+    void truncateDoubleToInt64(FPRegisterID src, RegisterID dest)
+    {
+        m_assembler.fctidz(fpTempRegister, src);
+        m_assembler.mfvsrd(dest, fpTempRegister);
+    }
+
+    void truncateDoubleToUint64(FPRegisterID src, RegisterID dest)
+    {
+        m_assembler.fctiduz(fpTempRegister, src);
+        m_assembler.mfvsrd(dest, fpTempRegister);
+    }
+
+    // The four-argument form exists because x86 needs scratch registers to
+    // do an unsigned 64-bit conversion. PowerPC has the instruction, so the
+    // scratches are unused.
+    void truncateDoubleToUint64(FPRegisterID src, RegisterID dest, FPRegisterID, FPRegisterID) { truncateDoubleToUint64(src, dest); }
+
+    // VSX has no truncation of a single that matches fctiw*'s saturation and
+    // NaN behaviour (xvcvspsxws differs on both), so a float truncation
+    // widens into the double model first and reuses the validated pair. The
+    // temporary is fpTempRegister2 because truncateDoubleTo* uses
+    // fpTempRegister itself.
+    FPRegisterID widenFloatToDoubleTemp(FPRegisterID src)
+    {
+        convertFloatToDouble(src, fpTempRegister2);
+        return fpTempRegister2;
+    }
+
+    void truncateFloatToInt32(FPRegisterID src, RegisterID dest) { truncateDoubleToInt32(widenFloatToDoubleTemp(src), dest); }
+    void truncateFloatToUint32(FPRegisterID src, RegisterID dest) { truncateDoubleToUint32(widenFloatToDoubleTemp(src), dest); }
+    void truncateFloatToInt64(FPRegisterID src, RegisterID dest) { truncateDoubleToInt64(widenFloatToDoubleTemp(src), dest); }
+    void truncateFloatToUint64(FPRegisterID src, RegisterID dest) { truncateDoubleToUint64(widenFloatToDoubleTemp(src), dest); }
+    void truncateFloatToUint64(FPRegisterID src, RegisterID dest, FPRegisterID, FPRegisterID) { truncateFloatToUint64(src, dest); }
+    // ---- stack ----
+    //
+    // ELFv2 requires r1 to stay 16-byte aligned at all times, so a single
+    // push moves it by 16 and not by 8. ARM64 does the same for the same
+    // reason. pushToSaveByteOffset() below reports that to the generic code
+    // that reasons about how much a push consumed.
+
+    void push(RegisterID src)
+    {
+        m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, -16);
+        m_assembler.std(src, PPC64Registers::r1, 0);
+    }
+
+    void push(TrustedImm32 imm)
+    {
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        push(temp.data());
+    }
+
+    void pop(RegisterID dest)
+    {
+        m_assembler.ld(dest, PPC64Registers::r1, 0);
+        m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, 16);
+    }
+
+    // Matches ARM64's stp/ldp ordering: the first register goes at the lower
+    // address. That ordering is what makes pushPair(fp, lr) produce the
+    // CallerFrame/ReturnPC layout JSC expects.
+    void pushPair(RegisterID first, RegisterID second)
+    {
+        m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, -16);
+        m_assembler.std(first, PPC64Registers::r1, 0);
+        m_assembler.std(second, PPC64Registers::r1, 8);
+    }
+
+    void popPair(RegisterID first, RegisterID second)
+    {
+        m_assembler.ld(first, PPC64Registers::r1, 0);
+        m_assembler.ld(second, PPC64Registers::r1, 8);
+        m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, 16);
+    }
+
+    static constexpr ptrdiff_t pushToSaveByteOffset() { return 16; }
+    // The reason (and any extra datum) are left in the two temp registers so
+    // they show up in the register dump of the resulting crash, then `trap`
+    // raises SIGTRAP. This is the ARM64 shape.
+    void abortWithReason(AbortReason reason)
+    {
+        move(TrustedImm32(static_cast<int32_t>(reason)), dataTempRegister);
+        breakpoint();
+    }
+
+    void abortWithReason(AbortReason reason, intptr_t misc)
+    {
+        move(TrustedImm64(misc), memoryTempRegister);
+        abortWithReason(reason);
+    }
+    // ==================================================================
+    // Compare-and-swap.
+    //
+    // ONE larx/stcx. attempt, with no inner loop. That is what "weak" means:
+    // the CAS may report failure although memory held the expected value,
+    // because the reservation was lost for any of the reasons Book II
+    // section 1.7.4.1 lists. The only caller today is the DFG's typed-array
+    // Atomics arm -- compileAtomicsReadModifyWrite in DFGSpeculativeJIT64.cpp
+    // -- which already owns the retry loop and has to, because Atomics.add
+    // computes its new value from the old one and must recompute it after a
+    // mismatch. Its loop absorbs a value mismatch, a lost reservation and a
+    // spurious failure identically, so a strong CAS in here would be a loop
+    // inside a loop re-storing against an expected value nobody rechecked.
+    //
+    // Every Atomics.* on a typed array is that loop, INCLUDING load and
+    // store, so the barriers below are the only barriers those two
+    // operations get. Sequential consistency -- the ordering JavaScript
+    // specifies Atomics with -- has to be assembled from parts, because
+    // larx/stcx. order nothing by themselves: a full `sync` before the larx,
+    // and an `lwsync` after the stcx. on BOTH the stored and the mismatched
+    // path. This is the leading-sync convention, and joining it is not a free
+    // choice: the same SharedArrayBuffer word is reached from other threads
+    // by the C++ slow paths in AtomicsObject.cpp, which gcc and clang compile
+    // leading-sync, and mixing the two conventions in one program leaves an
+    // SC store and an SC load with no full barrier between them. Substituting
+    // `lwsync` for the leading `sync` would be measurably cheaper and would
+    // drop the StoreLoad edge, which is precisely the edge sequential
+    // consistency adds to acquire/release.
+    //
+    // The `sync` sits OUTSIDE the reservation window deliberately -- gcc's
+    // and the kernel's placement, not clang's. The window from larx to stcx.
+    // holds one compare and one branch and nothing else, because while it is
+    // open any store from any other thread anywhere in the 128-byte
+    // reservation granule fails the stcx. and costs the caller another lap,
+    // with the sync paid again.
+    //
+    // See powerpc64le-handbook jsc-ppc64le-atomics-cas.md.
+    // ==================================================================
+
+    template<unsigned bitSize>
+    void loadAndReserve(RegisterID dest, RegisterID address)
+    {
+        // r0 in an RA field reads as the literal zero, so these are plain
+        // register-indirect accesses: EA = 0 + address.
+        if constexpr (bitSize == 8)
+            m_assembler.lbarx(dest, PPC64Registers::r0, address);
+        else if constexpr (bitSize == 16)
+            m_assembler.lharx(dest, PPC64Registers::r0, address);
+        else if constexpr (bitSize == 32)
+            m_assembler.lwarx(dest, PPC64Registers::r0, address);
+        else
+            m_assembler.ldarx(dest, PPC64Registers::r0, address);
+    }
+
+    template<unsigned bitSize>
+    void storeConditional(RegisterID source, RegisterID address)
+    {
+        // The widths must pair with the larx above. A reservation taken by
+        // lbarx and closed by stwcx. is the architecturally undefined case
+        // even at the same address, which is why one bitSize dispatches both
+        // halves and they can never be mixed.
+        if constexpr (bitSize == 8)
+            m_assembler.stbcx_(source, PPC64Registers::r0, address);
+        else if constexpr (bitSize == 16)
+            m_assembler.sthcx_(source, PPC64Registers::r0, address);
+        else if constexpr (bitSize == 32)
+            m_assembler.stwcx_(source, PPC64Registers::r0, address);
+        else
+            m_assembler.stdcx_(source, PPC64Registers::r0, address);
+    }
+
+    // stcx. reports success in CR0[EQ], not in a register. ARM64's
+    // storeCondRel* hands the caller a status GPR to test; this hands back a
+    // Jump taken when the reservation was LOST, which is the same control
+    // flow with three fewer instructions per lap -- no mfcr/rlwinm/xori to
+    // materialise a status that is immediately branched on anyway.
+    //
+    // Pair it with loadAndReserve/storeConditional of the SAME bitSize, and
+    // keep the window between them as short as the architecture note above
+    // requires.
+    Jump branchStoreConditionalFailed() { return makeBranch({ CRBit::EQ, false }); }
+
+    // popcntw/popcntd are POWER7, so the FPRegisterID temp the shared
+    // signature carries (ARM64 routes through a vector popcount) is unused
+    // here. The 32-bit form needs no mask: popcntw's result is 0..32.
+    void countPopulation32(RegisterID src, RegisterID dst) { m_assembler.popcntw(dst, src); }
+    void countPopulation64(RegisterID src, RegisterID dst) { m_assembler.popcntd(dst, src); }
+    void countPopulation32(RegisterID src, RegisterID dst, FPRegisterID) { countPopulation32(src, dst); }
+    void countPopulation64(RegisterID src, RegisterID dst, FPRegisterID) { countPopulation64(src, dst); }
+
+    // dest = minuend - mulLeft * mulRight. maddld is ISA 3.0 and would need a
+    // negated addend, so this is the POWER8-legal pair. mulld's low doubleword
+    // is correct whatever the operands' signs.
+    void multiplySub64(RegisterID mulLeft, RegisterID mulRight, RegisterID minuend, RegisterID dest)
+    {
+        auto temp = temps<Data>();
+        m_assembler.mulld(temp.data(), mulLeft, mulRight);
+        m_assembler.subf(dest, temp.data(), minuend);
+    }
+
+    // The atomic read-modify-writes BBQ needs, in x86's `lock xadd`/`xchg`
+    // shape: the operation is applied to memory and the register is left
+    // holding the OLD value.
+    //
+    // The address must have no displacement, which is not a restriction
+    // imposed here -- larx and stcx. have no D-form, so the effective address
+    // has to be final before any reservation exists, and the existing
+    // storeCondImpl asserts the same thing. BBQ satisfies it by construction:
+    // "For Atomic access, we need SimpleAddress (uoffset = 0)", folding the
+    // offset into the pointer register before building the Address
+    // (WasmBBQJIT64.cpp).
+    //
+    // Ordering is this port's leading-sync convention, matching
+    // emitAtomicStrongCAS: sync ahead of the loop, lwsync after it. Nothing is
+    // emitted between the larx and the stcx. but the arithmetic itself.
+    template<unsigned bitSize, bool isAdd>
+    void emitAtomicRMW(RegisterID reg, Address address)
+    {
+        static_assert(bitSize == 8 || bitSize == 16 || bitSize == 32 || bitSize == 64);
+        RELEASE_ASSERT(!address.offset);
+        auto temp = temps<Data, Memory>();
+        // The operand has to outlive a failed stcx., because reg is where the
+        // loaded value goes and is therefore destroyed on every iteration.
+        RegisterID operand = temp.data();
+        move(reg, operand);
+
+        memoryFence();
+        auto reload = label();
+        loadAndReserve<bitSize>(reg, address.base);
+        RegisterID toStore = operand;
+        if constexpr (isAdd) {
+            // A 64-bit add is right for every width: stcx. of 8, 16 or 32 bits
+            // writes only the low bits, and the loaded value was zero-extended
+            // by lbarx/lharx/lwarx, so the sum's low bits are the wrapped
+            // result the width wants.
+            m_assembler.add(temp.memory(), reg, operand);
+            toStore = temp.memory();
+        }
+        storeConditional<bitSize>(toStore, address.base);
+        makeBranch({ CRBit::EQ, false }).linkTo(reload, this);
+        loadFence();
+    }
+
+    void atomicXchgAdd8(RegisterID reg, Address address) { emitAtomicRMW<8, true>(reg, address); }
+    void atomicXchgAdd16(RegisterID reg, Address address) { emitAtomicRMW<16, true>(reg, address); }
+    void atomicXchgAdd32(RegisterID reg, Address address) { emitAtomicRMW<32, true>(reg, address); }
+    void atomicXchgAdd64(RegisterID reg, Address address) { emitAtomicRMW<64, true>(reg, address); }
+    void atomicXchg8(RegisterID reg, Address address) { emitAtomicRMW<8, false>(reg, address); }
+    void atomicXchg16(RegisterID reg, Address address) { emitAtomicRMW<16, false>(reg, address); }
+    void atomicXchg32(RegisterID reg, Address address) { emitAtomicRMW<32, false>(reg, address); }
+    void atomicXchg64(RegisterID reg, Address address) { emitAtomicRMW<64, false>(reg, address); }
+
+    // ==================================================================
+    // The load-linked / store-conditional pair B3 lowers atomics onto for any
+    // target without a single-instruction CAS. ARM64 reaches these the same way
+    // whenever it has no LSE: B3LowerToAir's atomic lowering builds the retry
+    // loop itself and asks the MacroAssembler only for the two halves.
+    //
+    // THE STATUS POLARITY IS INVERTED RELATIVE TO THE HARDWARE, and that is the
+    // contract, not a mistake. ARM64's stxr writes 0 to its status register on
+    // SUCCESS, and the loop B3 builds ends in
+    //   BranchTest32 Zero, boolResult -> doneBlock, reloopBlock
+    // so zero means done. PPC's stcx. is the other way round: it sets CR0[EQ] on
+    // success. CRTest { CRBit::EQ, false } is what reconciles them --
+    // emitSetFromCR0 appends an `xori dest, dest, 1` when branchIfSet is false --
+    // so these write 0 on success and 1 on failure, like ARM64.
+    //
+    // The barriers are split across the pair because B3 splits them: the fenced
+    // variants are selected together by loadLinkOpcode/storeCondOpcode on
+    // atomic->hasFence(), so LoadLinkAcq + StoreCondRel reassemble this port's
+    // existing seq_cst RMW shape -- leading `sync` before the larx, trailing
+    // `lwsync` after the stcx. -- which is the leading-sync convention
+    // jsc-ppc64le-atomics-cas.md 3.2 says must not be mixed within a program.
+    // Putting the release half BEFORE the stcx. instead would leave the pair with
+    // no trailing barrier at all and no acquire edge.
+    //
+    // One cost worth naming: B3 puts the load inside the retry loop, so the
+    // leading `sync` is paid on every lap. gcc hoists it out of the loop
+    // (3.1 of the same document). Correct, and more expensive than the
+    // hand-written CAS above, which keeps its sync outside the window.
+    //
+    // Air hands these a SimpleAddr, which is an Address with no displacement.
+    // That is asserted rather than folded: larx and stcx. have no D-form, so a
+    // displacement would need a staging register, and Air generates under
+    // DisallowMacroScratchRegisterUsage.
+    // ==================================================================
+
+    template<unsigned bitSize>
+    void loadLinkImpl(Address address, RegisterID dest, bool acquire)
+    {
+        RELEASE_ASSERT(!address.offset);
+        if (acquire)
+            memoryFence();
+        loadAndReserve<bitSize>(dest, address.base);
+    }
+
+    template<unsigned bitSize>
+    void storeCondImpl(RegisterID src, Address address, RegisterID result, bool release)
+    {
+        RELEASE_ASSERT(!address.offset);
+        storeConditional<bitSize>(src, address.base);
+        emitSetFromCR0({ CRBit::EQ, false }, result);
+        if (release)
+            loadFence();
+    }
+
+    void loadLink8(Address address, RegisterID dest) { loadLinkImpl<8>(address, dest, false); }
+    void loadLinkAcq8(Address address, RegisterID dest) { loadLinkImpl<8>(address, dest, true); }
+    void storeCond8(RegisterID src, Address address, RegisterID result) { storeCondImpl<8>(src, address, result, false); }
+    void storeCondRel8(RegisterID src, Address address, RegisterID result) { storeCondImpl<8>(src, address, result, true); }
+
+    void loadLink16(Address address, RegisterID dest) { loadLinkImpl<16>(address, dest, false); }
+    void loadLinkAcq16(Address address, RegisterID dest) { loadLinkImpl<16>(address, dest, true); }
+    void storeCond16(RegisterID src, Address address, RegisterID result) { storeCondImpl<16>(src, address, result, false); }
+    void storeCondRel16(RegisterID src, Address address, RegisterID result) { storeCondImpl<16>(src, address, result, true); }
+
+    void loadLink32(Address address, RegisterID dest) { loadLinkImpl<32>(address, dest, false); }
+    void loadLinkAcq32(Address address, RegisterID dest) { loadLinkImpl<32>(address, dest, true); }
+    void storeCond32(RegisterID src, Address address, RegisterID result) { storeCondImpl<32>(src, address, result, false); }
+    void storeCondRel32(RegisterID src, Address address, RegisterID result) { storeCondImpl<32>(src, address, result, true); }
+
+    void loadLink64(Address address, RegisterID dest) { loadLinkImpl<64>(address, dest, false); }
+    void loadLinkAcq64(Address address, RegisterID dest) { loadLinkImpl<64>(address, dest, true); }
+    void storeCond64(RegisterID src, Address address, RegisterID result) { storeCondImpl<64>(src, address, result, false); }
+    void storeCondRel64(RegisterID src, Address address, RegisterID result) { storeCondImpl<64>(src, address, result, true); }
+
+    template<unsigned bitSize>
+    JumpList branchAtomicWeakCASImpl(StatusCondition cond, RegisterID expectedAndClobbered, RegisterID newValue, BaseIndex address)
+    {
+        static_assert(bitSize == 8 || bitSize == 16 || bitSize == 32 || bitSize == 64);
+        auto temp = temps<Data, Memory>();
+
+        // The effective address is finished BEFORE the barrier and before the
+        // reservation exists. larx and stcx. have no D-form, so a
+        // displacement has to be folded in here, and once the reservation is
+        // held nothing may compute, load or store.
+        auto resolution = resolveAddress(address, temp.memory());
+        RegisterID effectiveAddress = resolution.base;
+        if (resolution.offset) {
+            addImmediate64(resolution.base, static_cast<int64_t>(resolution.offset), temp.memory());
+            effectiveAddress = temp.memory();
+        }
+
+        // THE SIGN-EXTENSION SEAM, and it is load-bearing. lbarx and lharx
+        // zero-extend, but the expected value arrived from the DFG's
+        // loadFromIntTypedArray, which uses load8SignedExtendTo32 for an
+        // Int8Array: the expected value of the byte 0xff is 0xffffffff.
+        // Without this mask the compare below never succeeds, the store is
+        // skipped, and the DFG's loop reloads the same -1 and tries again --
+        // forever. That failure is not a crash and not a wrong answer, it is
+        // a HANG on the first Atomics.sub of a negative Int8Array element,
+        // at the DFG tier only. This is the compiler's own `rlwinm 4,4,0,0xff`
+        // from the same sequence. The register is documented clobberable and
+        // the DFG keeps its result in a separate copy, so the mask is free.
+        // At 32 and 64 bits nothing is masked: cmplw reads only bits 32:63,
+        // and cmpld reads the whole register.
+        if constexpr (bitSize < 32)
+            m_assembler.clrldi(expectedAndClobbered, expectedAndClobbered, 64 - bitSize);
+
+        memoryFence();
+        loadAndReserve<bitSize>(temp.data(), effectiveAddress);
+        if constexpr (bitSize == 64)
+            m_assembler.cmpld(CRField::CR0, temp.data(), expectedAndClobbered);
+        else
+            m_assembler.cmplw(CRField::CR0, temp.data(), expectedAndClobbered);
+        // A one-word guard -- the same primitive makeBranch is built from --
+        // skipping the store-conditional when CR0.EQ is clear. On that path
+        // CR0.EQ stays 0, which is already the answer the status branch
+        // wants, and the reservation left standing is harmless: the next larx
+        // anywhere replaces it. The stcx. is reachable by this guard falling
+        // through and from nowhere else, which is the rule that keeps a
+        // stcx. from ever meeting a reservation it did not take.
+        m_assembler.insn(Assembler::conditionalGuardInsn(Assembler::BOFalse, crBitIndex(CRField::CR0, CRBit::EQ)));
+        storeConditional<bitSize>(newValue, effectiveAddress);
+        loadFence();
+
+        // CR0.EQ now means "the store happened", on either path: the compare
+        // cleared it on a mismatch and the stcx. recorded it on an attempt,
+        // and no barrier writes a condition register.
+        return JumpList(makeBranch({ CRBit::EQ, cond == Success }));
+    }

+    void emitVectorIntegerMinMax(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest, bool isMin)
+    {
+        ASSERT(simdInfo.signMode != SIMDSignMode::None);
+        bool isSigned = simdInfo.signMode == SIMDSignMode::Signed;
+        emitVMXBinary(left, right, dest, [&](VRegisterID t, VRegisterID a, VRegisterID b) {
+            switch (simdInfo.lane) {
+            case SIMDLane::i8x16:
+                if (isMin) isSigned ? m_assembler.vminsb(t, a, b) : m_assembler.vminub(t, a, b);
+                else isSigned ? m_assembler.vmaxsb(t, a, b) : m_assembler.vmaxub(t, a, b);
+                return;
+            case SIMDLane::i16x8:
+                if (isMin) isSigned ? m_assembler.vminsh(t, a, b) : m_assembler.vminuh(t, a, b);
+                else isSigned ? m_assembler.vmaxsh(t, a, b) : m_assembler.vmaxuh(t, a, b);
+                return;
+            case SIMDLane::i32x4:
+                if (isMin) isSigned ? m_assembler.vminsw(t, a, b) : m_assembler.vminuw(t, a, b);
+                else isSigned ? m_assembler.vmaxsw(t, a, b) : m_assembler.vmaxuw(t, a, b);
+                return;
+            case SIMDLane::i64x2:
+                if (isMin) isSigned ? m_assembler.vminsd(t, a, b) : m_assembler.vminud(t, a, b);
+                else isSigned ? m_assembler.vmaxsd(t, a, b) : m_assembler.vmaxud(t, a, b);
+                return;
+            default:
+                RELEASE_ASSERT_NOT_REACHED();
+            }
+        });
+    }
+
+    void emitVectorMinMax(SIMDInfo simdInfo, FPRegisterID left, FPRegisterID right, FPRegisterID dest, bool isMin)
+    {
+        bool isFloat = simdInfo.lane == SIMDLane::f32x4;
+        RELEASE_ASSERT(isFloat || simdInfo.lane == SIMDLane::f64x2);
+
+        // ok = (left == left) & (right == right): zero in any lane where
+        // either operand is NaN, since NaN compares unequal to itself.
+        if (isFloat) {
+            m_assembler.xvcmpeqsp(fpTempRegister, left, left);
+            m_assembler.xvcmpeqsp(fpTempRegister2, right, right);
+        } else {
+            m_assembler.xvcmpeqdp(fpTempRegister, left, left);
+            m_assembler.xvcmpeqdp(fpTempRegister2, right, right);
+        }
+        m_assembler.xxland(fpTempRegister, fpTempRegister, fpTempRegister2);
+
+        // left + right is a NaN in exactly the lanes where either was one.
+        if (isFloat)
+            m_assembler.xvaddsp(fpTempRegister2, left, right);
+        else
+            m_assembler.xvadddp(fpTempRegister2, left, right);
+
+        // dest may alias left or right; both are dead after this point.
+        if (isFloat)
+            isMin ? m_assembler.xvminsp(dest, left, right) : m_assembler.xvmaxsp(dest, left, right);
+        else
+            isMin ? m_assembler.xvmindp(dest, left, right) : m_assembler.xvmaxdp(dest, left, right);
+
+        // A set ok bit takes XB, the min/max; a clear one takes XA, the NaN.
+        m_assembler.xxsel(dest, fpTempRegister2, dest, fpTempRegister);
+    }

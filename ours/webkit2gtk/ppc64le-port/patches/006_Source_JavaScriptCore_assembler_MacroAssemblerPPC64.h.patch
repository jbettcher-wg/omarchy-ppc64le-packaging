+    JumpList branchAtomicStrongCASImpl(StatusCondition cond, RegisterID expectedAndResult, RegisterID newValue, AddressType address)
+    {
+        emitAtomicStrongCAS<bitSize>(expectedAndResult, newValue, address);
+        return JumpList(makeBranch({ CRBit::EQ, cond == Success }));
+    }

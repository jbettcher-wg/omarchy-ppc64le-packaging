+    // The JS frame prologue/epilogue pair. This must produce exactly the
+    // frame the LLInt builds, because the two call each other:
+    //   [cfr + 0] CallerFrame (the caller's cfr)
+    //   [cfr + 8] ReturnPC
+    // which is what offlineasm's `push cfr, lr` lowers to. r0 is the shuttle
+    // for the link register -- not a pooled temporary, because the very
+    // first instruction of a prologue runs before anything has been saved
+    // and must not destroy a caller's register. That was defect 1 of the
+    // LLInt bring-up.
+    void pushFramePointerAndLinkRegister()
+    {
+        m_assembler.mflr(PPC64Registers::r0);
+        m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, -16);
+        m_assembler.std(framePointerRegister, PPC64Registers::r1, 0);
+        m_assembler.std(PPC64Registers::r0, PPC64Registers::r1, 8);
+    }
+
+    void popFramePointerAndLinkRegister()
+    {
+        m_assembler.ld(PPC64Registers::r0, PPC64Registers::r1, 8);
+        m_assembler.ld(framePointerRegister, PPC64Registers::r1, 0);
+        m_assembler.mtlr(PPC64Registers::r0);
+        m_assembler.addi(PPC64Registers::r1, PPC64Registers::r1, 16);
+    }
+    // ==================================================================
+    // Comparisons.
+    //
+    // On PowerPC the signedness of a comparison is a property of the COMPARE
+    // instruction, not of the branch: cmpw/cmpd are signed, cmplw/cmpld
+    // unsigned, and both set the same LT/GT/EQ bits. So every one of these
+    // returns a CRTest saying which CR0 bit the caller should look at and in
+    // which sense, and the caller turns that into either a branch or a 0/1
+    // value. Nothing may be emitted between the compare and its use, because
+    // CR0 is scratch.
+    //
+    // The 32-bit compares need no extension of their operands: cmpw and
+    // cmplw read only bits 32:63.
+    // ==================================================================
+
+    static bool isUnsigned(RelationalCondition cond)
+    {
+        return Assembler::isUnsignedCondition(static_cast<Assembler::Condition>(cond));
+    }
+
+    CRTest emitCompare32(RelationalCondition cond, RegisterID left, RegisterID right)
+    {
+        if (isUnsigned(cond))
+            m_assembler.cmplw(CRField::CR0, left, right);
+        else
+            m_assembler.cmpw(CRField::CR0, left, right);
+        return crTestFor(cond);
+    }
+
+    CRTest emitCompare32(RelationalCondition cond, RegisterID left, TrustedImm32 imm)
+    {
+        if (isUnsigned(cond)) {
+            uint32_t value = static_cast<uint32_t>(imm.m_value);
+            if (value <= 0xffff) {
+                m_assembler.cmplwi(CRField::CR0, left, value);
+                return crTestFor(cond);
+            }
+        } else if (Assembler::isValidSigned16(imm.m_value)) {
+            m_assembler.cmpwi(CRField::CR0, left, imm.m_value);
+            return crTestFor(cond);
+        }
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        return emitCompare32(cond, left, temp.data());
+    }
+
+    CRTest emitCompare64(RelationalCondition cond, RegisterID left, RegisterID right)
+    {
+        if (isUnsigned(cond))
+            m_assembler.cmpld(CRField::CR0, left, right);
+        else
+            m_assembler.cmpd(CRField::CR0, left, right);
+        return crTestFor(cond);
+    }
+
+    CRTest emitCompare64(RelationalCondition cond, RegisterID left, int64_t value)
+    {
+        if (isUnsigned(cond)) {
+            if (value >= 0 && value <= 0xffff) {
+                m_assembler.cmpldi(CRField::CR0, left, static_cast<uint32_t>(value));
+                return crTestFor(cond);
+            }
+        } else if (Assembler::isValidSigned16(value)) {
+            m_assembler.cmpdi(CRField::CR0, left, static_cast<int32_t>(value));
+            return crTestFor(cond);
+        }
+        auto temp = temps<Data>();
+        m_assembler.loadImmediate64(temp.data(), value);
+        return emitCompare64(cond, left, temp.data());
+    }
+
+    // A TrustedImm32 compared against a 64-bit register means the
+    // sign-extended value.
+    CRTest emitCompare64(RelationalCondition cond, RegisterID left, TrustedImm32 imm)
+    {
+        return emitCompare64(cond, left, static_cast<int64_t>(imm.m_value));
+    }

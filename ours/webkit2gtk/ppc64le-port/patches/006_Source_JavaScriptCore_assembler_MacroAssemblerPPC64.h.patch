+    void emitLoadDForm(LoadKind kind, RegisterID base, int32_t offset, RegisterID dest)
+    {
+        switch (kind) {
+        case LoadKind::U8:  m_assembler.lbz(dest, base, offset); return;
+        case LoadKind::S8:  m_assembler.lbz(dest, base, offset); m_assembler.extsb(dest, dest); return;
+        case LoadKind::U16: m_assembler.lhz(dest, base, offset); return;
+        case LoadKind::S16: m_assembler.lha(dest, base, offset); return;
+        case LoadKind::U32: m_assembler.lwz(dest, base, offset); return;
+        case LoadKind::S32: m_assembler.lwa(dest, base, offset); return;
+        case LoadKind::U64: m_assembler.ld(dest, base, offset); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void emitLoadXForm(LoadKind kind, RegisterID base, RegisterID index, RegisterID dest)
+    {
+        ASSERT(base != PPC64Registers::r0);
+        switch (kind) {
+        case LoadKind::U8:  m_assembler.lbzx(dest, base, index); return;
+        case LoadKind::S8:  m_assembler.lbzx(dest, base, index); m_assembler.extsb(dest, dest); return;
+        case LoadKind::U16: m_assembler.lhzx(dest, base, index); return;
+        case LoadKind::S16: m_assembler.lhax(dest, base, index); return;
+        case LoadKind::U32: m_assembler.lwzx(dest, base, index); return;
+        case LoadKind::S32: m_assembler.lwax(dest, base, index); return;
+        case LoadKind::U64: m_assembler.ldx(dest, base, index); return;
+        }

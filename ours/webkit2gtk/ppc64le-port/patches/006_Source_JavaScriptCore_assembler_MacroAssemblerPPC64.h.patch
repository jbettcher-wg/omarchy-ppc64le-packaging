+#pragma once
+
+#include <wtf/Platform.h>
+
+#if ENABLE(ASSEMBLER) && CPU(PPC64LE)
+
+#include "AbstractMacroAssembler.h"
+#include "PPC64Assembler.h"
+#include "TargetAssemblerDefinitions.h"
+
+// MacroAssemblerPPC64 -- STAGE b2: COMPILE-ONLY.
+//
+// Why this file exists in this shape. PlatformEnable.h:944 forces
+// ENABLE_ASSEMBLER=1 for every non-C_LOOP build, so a MacroAssembler<Arch>
+// must COMPILE before the native LLInt can be built at all -- even with
+// ENABLE_JIT=OFF, where nothing in here is ever executed. The milestone this
+// file serves is "a jsc built with the native LLInt runs", not "the JIT
+// works".
+//
+// So every operation below is a stub that fails loudly:
+// UNREACHABLE_FOR_PLATFORM() aborts with the file and line. NOT a silent
+// empty body -- an empty body would compile, link, run, and quietly emit
+// nothing, which is the single worst failure mode available here. If a
+// non-JIT path ever does reach one of these, the crash names it.
+//
+// The method surface is deliberately the same as MacroAssemblerRISCV64's
+// public surface. RISCV64 is the closest structural template in the tree
+// (64-bit, no SIMD, two scratch registers, most recent from-scratch port),
+// and matching it method-for-method is what makes the ~40 generic call sites
+// elsewhere in JSC compile without per-site #ifs.
+//
+// Filling these in is stage c of jsc-ppc64le-port.md. The register
+// assignment, the compare/branch pairing, the 32-bit zero-extension
+// invariant and the r2/TOC rule are all already settled by
+// offlineasm/ppc64.rb and documented in that file's section 5; a real
+// implementation must follow them, because LLInt and JIT code share the
+// callee-saved half of the register file.
+
+#define MACRO_ASSEMBLER_PPC64_TEMPLATED_NOOP_METHOD(methodName) \
+    template<typename... Args> void methodName(Args&&...) = delete;
+#define MACRO_ASSEMBLER_PPC64_TEMPLATED_NOOP_METHOD_WITH_RETURN(methodName, returnType) \
+    template<typename... Args> returnType methodName(Args&&...) = delete;
+
+namespace JSC {
+
+using Assembler = TARGET_ASSEMBLER;
+
+class MacroAssemblerPPC64 : public AbstractMacroAssembler<Assembler> {
+public:
+    // A VMX register number. Distinct from FPRegisterID, which is a VSR
+    // number: vr(n) IS VSR(32+n), so the same value names a different
+    // physical register in each space and the two must not be interchangeable.
+    using VRegisterID = Assembler::VRegisterID;
+
+    static constexpr unsigned numGPRs = 32;
+    static constexpr unsigned numFPRs = 32;
+
+    // `b` reaches +-32 MiB; anything further needs the seven-word ladder.
+    static constexpr size_t nearJumpRange = 32 * MB;
+
+    // r28-r30 are offlineasm's temporary pool; the MacroAssembler takes the
+    // top two of them, as jsc-ppc64le-port.md section 5.2 specifies. The two
+    // code streams never share a live temporary -- only the callee-saved
+    // registers, cfr and sp are shared state.
+    static constexpr RegisterID dataTempRegister = PPC64Registers::r29;
+    static constexpr RegisterID memoryTempRegister = PPC64Registers::r30;
+
+    // VOLATILE, deliberately. These were f30/f31, which are callee-saved and
+    // which nothing saves: the VM entry frame preserves f14-f25 only, so JIT
+    // code using them corrupted the floating-point state of the C++ that
+    // called into the engine. f13 and f0 are the two volatile FPRs left over
+    // once FPRInfo's allocatable set is f1-f12.
+    // ==================================================================
+    // THE VMX BRIDGE, and why this port copies in and out of it.
+    //
+    // POWER's integer vector arithmetic, compares, shifts, narrows and
+    // permutes exist ONLY as VMX-form instructions, which carry 5-bit fields
+    // naming vr0-vr31 -- and vr(n) is VSR(32+n). This port's FPRegisterID
+    // space is VSR 0-31, so a VMX instruction cannot name a JSC vector
+    // register at all. There is no VSX-form integer vector add on the POWER8
+    // floor: `xvaddubm` is not an instruction.
+    //
+    // THE COST, MEASURED (jsc-ppc64le-vector-register-model.md section 3):
+    // a binary VMX operation is FOUR instructions here where a native
+    // register bank would use ONE -- bridge in, bridge in, operate, bridge
+    // out. A unary one is three. Aliasing does not help: the VMX instruction
+    // must read AND write registers in the vr range whatever the operands
+    // alias, so the bridge-out is never avoidable.
+    //
+    // THE 1x IS NOT AVAILABLE, and that is a decision rather than an
+    // oversight. Reaching it requires the register ALLOCATOR to place values
+    // in VSR 32-63, which means they must be Regs that Air can see. Making
+    // them so has two consequences that were measured rather than guessed:
+    // conservativeWidth() is Width128 for any FPR, so every added register
+    // would carry m_upperBits into every derived RegisterSet and make
+    // ScratchRegisterAllocator's Width128 arm live -- an arm that enabling
+    // BBQ makes reachable anyway -- and reservedHardwareRegisters() asserts
+    // that no FPR is ever reserved, so the obvious containment is blocked.
+    // The 4x was accepted deliberately against that risk.
+    //
+    // THE INVARIANT THIS ROUTE DEPENDS ON:
+    //
+    //     Nothing may ever be live in a bridge register across an
+    //     instruction boundary the port can suspend at.
+    //
+    // Bridge in, operate, bridge out is ONE emitted sequence, and that is
+    // what makes the route sound. MacroAssembler::probe cannot see these
+    // registers at all -- Probe::CPUState gives this port `double fprs[]`
+    // and the `v128_t vectors[]` arm is gated to X86_64 and ARM64 -- so a
+    // value held in one across a probe point, an OSR exit or a call would be
+    // lost silently. Any future use that spans a boundary breaks this and
+    // must not be written.
+    //
+    // vr8-vr11 are the choice because ELFv2 makes v0-v19 volatile, so there
+    // is no callee-save duty, and IPInt uses vr8-vr11 only as within-handler
+    // scratch, never across a dispatch, while its value stack lives in
+    // vr0-vr7.
+    static constexpr VRegisterID vectorBridge0 = PPC64Registers::vr8;
+    static constexpr VRegisterID vectorBridge1 = PPC64Registers::vr9;
+    // A third, for the forms that need a zero operand -- vxor against itself
+    // supplies one with no constant and no memory access.
+    static constexpr VRegisterID vectorBridge2 = PPC64Registers::vr10;
+    static constexpr FPRegisterID vectorBridge0VSR = PPC64Registers::vsrForVR(vectorBridge0);
+    static constexpr FPRegisterID vectorBridge1VSR = PPC64Registers::vsrForVR(vectorBridge1);
+    static constexpr FPRegisterID vectorBridge2VSR = PPC64Registers::vsrForVR(vectorBridge2);
+
+    // THE PREMISE, CHECKED RATHER THAN COMMENTED. The bridge registers work
+    // only because they lie OUTSIDE the modelled FP register file, so the
+    // allocator can never hand them to anything. If the file ever grows to
+    // cover them this fails, and the bridge must be removed rather than
+    // quietly clobbering whatever the allocator put there.
+    static_assert(static_cast<unsigned>(vectorBridge0VSR) >= Assembler::numberOfFPRegisters()
+        && static_cast<unsigned>(vectorBridge1VSR) >= Assembler::numberOfFPRegisters()
+        && static_cast<unsigned>(vectorBridge2VSR) >= Assembler::numberOfFPRegisters(),
+        "A vector bridge register is inside the FP register file: the bridge is now unsafe. "
+        "See jsc-ppc64le-vector-register-model.md.");
+
+    static constexpr FPRegisterID fpTempRegister = PPC64Registers::f13;
+    static constexpr FPRegisterID fpTempRegister2 = PPC64Registers::f0;
+
+    static constexpr RegisterID InvalidGPRReg = PPC64Registers::InvalidGPRReg;
+    // The FP counterpart, re-exported here exactly as MacroAssemblerARM64.h
+    // re-exports ARM64Registers::InvalidFPRReg: it is what the unused-scratch
+    // parameters default to.
+    static constexpr FPRegisterID InvalidFPRReg = PPC64Registers::InvalidFPRReg;
+
+    static constexpr RegisterID stackPointerRegister = PPC64Registers::r1;
+    static constexpr RegisterID framePointerRegister = PPC64Registers::r31;
+
+    // There is deliberately no `linkRegister`. On PowerPC the link register
+    // is an SPR reached through mflr/mtlr, not a GPR, so there is no GPRReg
+    // that names it. Anything that wants to move the return address through
+    // the register allocator has to be written for this port rather than
+    // inherited from ARM64/RISCV64 -- and it should be a compile error here,
+    // not a plausible-looking wrong register.
+
+    RegisterID scratchRegister()
+    {
+        return dataTempRegister;
+    }
+
+    enum TempRegisterType : int8_t {
+        Data,
+        Memory,
+    };
+
+    template<TempRegisterType... RegisterTypes>
+    struct TempRegister {
+        RegisterID data()
+        {
+            static_assert(((RegisterTypes == Data) || ...));
+            return dataTempRegister;
+        }
+
+        RegisterID memory()
+        {
+            static_assert(((RegisterTypes == Memory) || ...));
+            return memoryTempRegister;
+        }
+    };
+
+    template<TempRegisterType RegisterType>
+    struct LazyTempRegister {
+        LazyTempRegister(bool allowScratchRegister)
+            : m_allowScratchRegister(allowScratchRegister)
+        {
+            static_assert(RegisterType == Data || RegisterType == Memory);
+        }
+
+        operator RegisterID()
+        {
+            RELEASE_ASSERT(m_allowScratchRegister);
+            if constexpr (RegisterType == Data)
+                return dataTempRegister;
+            if constexpr (RegisterType == Memory)
+                return memoryTempRegister;
+            return InvalidGPRReg;
+        }
+
+        bool m_allowScratchRegister;
+    };
+
+    template<TempRegisterType... RegisterTypes>
+    auto temps() -> TempRegister<RegisterTypes...>
+    {
+        RELEASE_ASSERT(m_allowScratchRegister);
+        return { };
+    }
+
+    template<TempRegisterType RegisterType>
+    auto lazyTemp() -> LazyTempRegister<RegisterType>
+    {
+        return { m_allowScratchRegister };
+    }
+
+    // frin is ties-away-from-zero, not ties-to-even, so the rounding
+    // primitives JSC wants are the VSX xsrdpi* family. They exist on POWER8,
+    // so this is true -- but nothing below implements them yet.
+    static bool supportsFloatingPointRounding() { return true; }
+    // IEEE binary16 conversion is ISA 3.0 (POWER9): xscvhpdp/xscvdphp, plus
+    // the lxsihzx/stxsihx halfword moves. The brief that first raised this
+    // had it inverted -- what arrives with ISA 3.1 (POWER10) is BFLOAT16,
+    // xvcvbf16spn/xvcvspbf16. Measured on the AC922: `as -mpower8` rejects
+    // all six instructions, `as -mpower9` assembles them, they execute, and
+    // xscvdphp matches a software round-to-nearest-even reference on every
+    // probe value with zero round-trip mismatches over all 2^16 halves.
+    //
+    // Runtime rather than compile-time because one jsc binary from the
+    // POWER8 pool may run on either generation, and because a wrong answer
+    // here is a SIGILL rather than a slow path. On a machine without ISA 3.0
+    // this stays false and upstream's existing guards route every float16
+    // producer to the generic WTF::Float16 paths in C++ -- the same paths
+    // x86_64 runs today. ARM64 answers this the same way, with a runtime
+    // feature test.
+    static bool supportsFloat16() { return Assembler::hasISA30(); }
+    static bool supportsCountPopulation() { return true; } // popcntw / popcntd
+
+    // On PowerPC the signedness of a comparison lives in the COMPARE
+    // instruction (cmpw/cmpd versus cmplw/cmpld), not in the branch, so the
+    // Assembler::Condition these map onto carries both halves: which compare
+    // to emit and which CR bit to test.
+    enum RelationalCondition {
+        Equal = Assembler::ConditionEQ,
+        NotEqual = Assembler::ConditionNE,
+        Above = Assembler::ConditionGTU,
+        AboveOrEqual = Assembler::ConditionGEU,
+        Below = Assembler::ConditionLTU,
+        BelowOrEqual = Assembler::ConditionLEU,
+        GreaterThan = Assembler::ConditionGT,
+        GreaterThanOrEqual = Assembler::ConditionGE,
+        LessThan = Assembler::ConditionLT,
+        LessThanOrEqual = Assembler::ConditionLE,
+    };
+
+    static constexpr RelationalCondition invert(RelationalCondition cond)
+    {
+        return static_cast<RelationalCondition>(Assembler::invert(static_cast<Assembler::Condition>(cond)));
+    }
+
+    enum ResultCondition {
+        Carry, // <- not implemented
+        Overflow,
+        Signed,
+        PositiveOrZero,
+        Zero,
+        NonZero,
+    };
+
+    enum ZeroCondition {
+        IsZero,
+        IsNonZero,
+    };
+
+    enum DoubleCondition {
+        DoubleEqualAndOrdered,
+        DoubleNotEqualAndOrdered,
+        DoubleGreaterThanAndOrdered,
+        DoubleGreaterThanOrEqualAndOrdered,
+        DoubleLessThanAndOrdered,
+        DoubleLessThanOrEqualAndOrdered,
+        DoubleEqualOrUnordered,
+        DoubleNotEqualOrUnordered,
+        DoubleGreaterThanOrUnordered,
+        DoubleGreaterThanOrEqualOrUnordered,
+        DoubleLessThanOrUnordered,
+        DoubleLessThanOrEqualOrUnordered,
+    };
+
+    enum BranchTruncateType { BranchIfTruncateFailed, BranchIfTruncateSuccessful };
+
+    static ptrdiff_t maxJumpReplacementSize() { return Assembler::maxJumpReplacementSize(); }
+    static ptrdiff_t patchableJumpSize() { return Assembler::patchableJumpSize(); }
+
+    // The handful of operations that are implemented for real, because they
+    // are one instruction each and because a wrong barrier is worse than an
+    // absent one.
+    void nop() { m_assembler.nop(); }
+    void breakpoint() { m_assembler.trap(); }
+    void breakpoint(uint16_t) { m_assembler.trap(); }
+
+    // Power ISA Book II: sync is the full barrier (StoreLoad included),
+    // lwsync orders everything but StoreLoad. See
+    // powerpc64le-handbook memory-ordering-and-atomics.md.
+    void memoryFence() { m_assembler.sync(); }
+    void storeFence() { m_assembler.lwsync(); }
+    void loadFence() { m_assembler.lwsync(); }
+
+    // ==================================================================
+    // Infrastructure the real implementations below are built on.
+    // ==================================================================
+    //
+    // THE 32-BIT INVARIANT. A 32-bit value is held ZERO-EXTENDED in its
+    // 64-bit register, the same as an ARM64 `w` register. So every *32 op
+    // that produces a value finishes with `clrldi rD, rD, 32`. Two
+    // consequences worth stating because they are easy to get wrong:
+    //
+    //   - Compares do NOT need the extension, because cmpw/cmplw read only
+    //     the low word. That is why branch32 is cheaper here than on RISC-V,
+    //     which has to mask before every comparison.
+    //   - load32 is `lwz` (zero-extending) and therefore already satisfies
+    //     the invariant; load32SignedExtendTo64 is `lwa` and deliberately
+    //     does NOT, because its whole purpose is a sign-extended 64-bit
+    //     result.
+    //
+    // THE r0 TRAP. In the RA field of a D-form or X-form address, register 0
+    // does not mean r0 -- it means the literal constant 0. So r0 can never be
+    // used as a base register, and `addi rD, r0, n` is `li rD, n`, not
+    // "r0 + n". r0 is used here only as a fixed scratch inside sequences that
+    // never use it as a base (the LR shuttle, mainly), never as an allocatable
+    // temporary. r2 (TOC) and r13 (TLS) are never written at all.
+
+    // Which CR0 bit a condition tests, and whether it branches when that bit
+    // is set or clear. On PowerPC the SIGNEDNESS lives in the compare
+    // instruction (cmpw/cmpd vs cmplw/cmpld), not in the branch, so LT and
+    // LTU both come out as "the LT bit"; it is emitCompare* that differs.
+    struct CRTest {
+        CRBit bit;
+        bool branchIfSet;
+        // Integer comparisons all land in CR0. Floating-point conditions
+        // that are a disjunction of two CR bits (LT|GT, GT|EQ, EQ|SO, ...)
+        // have to be composed with cror into a bit of a DIFFERENT field --
+        // cr7 here -- because the OR would otherwise overwrite one of the
+        // bits it is reading. probes/nanbranch.c in the handbook is the
+        // measurement behind that: ble and bge fire on NaN, so an ordered
+        // "less or equal" really is a two-bit disjunction and the result
+        // must not land back in cr0.
+        CRField field = CRField::CR0;
+    };
+
+    static CRTest crTestFor(Assembler::Condition cond)
+    {
+        switch (cond) {
+        case Assembler::ConditionEQ:  return { CRBit::EQ, true };
+        case Assembler::ConditionNE:  return { CRBit::EQ, false };
+        case Assembler::ConditionLT:
+        case Assembler::ConditionLTU: return { CRBit::LT, true };
+        case Assembler::ConditionGE:
+        case Assembler::ConditionGEU: return { CRBit::LT, false };
+        case Assembler::ConditionGT:
+        case Assembler::ConditionGTU: return { CRBit::GT, true };
+        case Assembler::ConditionLE:
+        case Assembler::ConditionLEU: return { CRBit::GT, false };
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+        return { CRBit::EQ, true };
+    }
+
+    static CRTest crTestFor(RelationalCondition cond)
+    {
+        return crTestFor(static_cast<Assembler::Condition>(cond));
+    }
+
+    // ---- immediates ----
+
+    // ZERO-extended, deliberately, because that is what ARM64 does and
+    // because AssemblyHelpers::boxInt32() is a bare `or64` with the number
+    // tag: an int32 whose upper half is not zero produces a corrupt JSValue.
+    // (MacroAssemblerRISCV64 sign-extends here instead. The two cannot both
+    // be what JSC depends on; ARM64 is the one that is exercised, so ARM64 is
+    // the one to match.) Anything that genuinely wants a sign-extended 64-bit
+    // constant asks for it with TrustedImm64, or goes through
+    // loadSignExtendedImmediate32 below.
+    void loadImmediate(TrustedImm32 imm, RegisterID dest)
+    {
+        m_assembler.loadImmediate64(dest, static_cast<int64_t>(static_cast<uint32_t>(imm.m_value)));
+    }
+
+    // The 64-bit-operand reading of a TrustedImm32: addPtr(TrustedImm32(-16),
+    // stackPointerRegister) has to subtract 16, not add 4294967280. Every
+    // 64-bit ALU operation taking a TrustedImm32 uses this one.
+    void loadSignExtendedImmediate32(int32_t value, RegisterID dest)
+    {
+        m_assembler.loadImmediate64(dest, static_cast<int64_t>(value));
+    }
+
+    void loadImmediate(TrustedImm64 imm, RegisterID dest)
+    {
+        m_assembler.loadImmediate64(dest, imm.m_value);
+    }
+
+    void loadImmediate(TrustedImmPtr imm, RegisterID dest)
+    {
+        m_assembler.loadImmediate64(dest, reinterpret_cast<int64_t>(imm.m_value));
+    }
+
+    // ---- address resolution ----
+    //
+    // Every memory operand is reduced to a (base register, signed 16-bit
+    // displacement) pair, materialising into `destination` only when it has
+    // to. `requiresDSForm` is passed by the callers that will emit ld/std/lwa:
+    // those are DS-form, whose displacement field drops its low two bits, so
+    // a displacement that is not a multiple of 4 has to go through a register
+    // even though it fits in 16 bits. Confusing D-form with DS-form is the
+    // single easiest way to emit a silently wrong address here, so the flag
+    // is explicit at every call site rather than inferred.
+
+    struct AddressResolution {
+        RegisterID base;
+        int32_t offset;
+    };
+
+    template<typename RegisterType>
+    AddressResolution resolveAddress(Address address, RegisterType destination, bool requiresDSForm = false)
+    {
+        if (requiresDSForm ? Assembler::isValidDSForm(address.offset) : Assembler::isValidDForm(address.offset))
+            return { address.base, address.offset };
+
+        RegisterID dest = destination;
+        // addImmediate64 reads `base` and writes `dest`, and is safe when the
+        // two are the same register; materialising the constant into `dest`
+        // first would not be.
+        addImmediate64(address.base, static_cast<int64_t>(address.offset), dest);
+        return { dest, 0 };
+    }
+
+    template<typename RegisterType>
+    AddressResolution resolveAddress(BaseIndex address, RegisterType destination, bool requiresDSForm = false)
+    {
+        RegisterID dest = destination;
+
+        // dest = base + (index << scale)
+        //
+        // The scaled index needs somewhere to live, and it CANNOT be `dest`
+        // when `dest` is also `base` or `index`: the shift would destroy the
+        // operand the following add still has to read. getEffectiveAddress
+        // passes a caller register as `dest`, and JSC calls it with dest ==
+        // base all the time (it is how an array element address is formed),
+        // so this is not a corner case. testmasm's testGetEffectiveAddress
+        // is the regression test.
+        if (address.scale != TimesOne) {
+            RegisterID shifted = dest;
+            if (dest == address.base || dest == address.index)
+                shifted = immediateScratch(address.base, address.index);
+            m_assembler.sldi(shifted, address.index, static_cast<uint32_t>(address.scale));
+            m_assembler.add(dest, address.base, shifted);
+        } else
+            m_assembler.add(dest, address.base, address.index);
+
+        if (!address.offset)
+            return { dest, 0 };
+
+        if (requiresDSForm ? Assembler::isValidDSForm(address.offset) : Assembler::isValidDForm(address.offset))
+            return { dest, address.offset };
+
+        // The displacement does not fit the instruction form. addImmediate64
+        // knows how to fold it in, including the case where compensating for
+        // addi's sign extension carries the high half out of range.
+        addImmediate64(dest, static_cast<int64_t>(address.offset), dest);
+        return { dest, 0 };
+    }
+
+    template<typename RegisterType>
+    AddressResolution resolveAddress(ExtendedAddress address, RegisterType destination, bool requiresDSForm = false)
+    {
+        int64_t offset = static_cast<int64_t>(address.offset);
+        if (Assembler::isValidSigned16(offset) && (!requiresDSForm || !(offset & 3)))
+            return { address.base, static_cast<int32_t>(offset) };
+
+        RegisterID dest = destination;
+        m_assembler.loadImmediate64(dest, offset);
+        m_assembler.add(dest, address.base, dest);
+        return { dest, 0 };
+    }
+
+    // An AbsoluteAddress is a bare pointer; there is no base register, so the
+    // pointer itself has to be materialised.
+    template<typename RegisterType>
+    AddressResolution resolveAddress(AbsoluteAddress address, RegisterType destination, bool = false)
+    {
+        RegisterID dest = destination;
+        m_assembler.loadImmediate64(dest, reinterpret_cast<int64_t>(address.m_ptr));
+        return { dest, 0 };
+    }
+
+    // ---- the 32-bit zero-extension invariant ----
+    void maskLow32(RegisterID reg) { m_assembler.clrldi(reg, reg, 32); }
+
+    // A scratch register that is neither of the two operands.
+    //
+    // The immediate helpers below need somewhere to materialise a constant
+    // that does not fit an instruction field. Reaching for temps<Data>()
+    // unconditionally is wrong: these helpers are also called from places
+    // that are ALREADY working in the data temp, and
+    // `addImmediate64(dataTemp, big, dataTemp)` would then load the constant
+    // over its own source and compute value+value. Picking a register that
+    // collides with neither operand makes that impossible.
+    //
+    // The cost is that such a call may clobber the OTHER temp, so a caller
+    // holding something live in one temp must not assume the other survives
+    // an immediate operation. If both are taken this asserts rather than
+    // choosing wrongly.
+    RegisterID immediateScratch(RegisterID a, RegisterID b)
+    {
+        RELEASE_ASSERT(m_allowScratchRegister);
+        if (dataTempRegister != a && dataTempRegister != b)
+            return dataTempRegister;
+        RELEASE_ASSERT(memoryTempRegister != a && memoryTempRegister != b);
+        return memoryTempRegister;
+    }
+
+    // Where to materialise a constant that has to reach a register before it
+    // can be combined with `src` into `dest`.
+    //
+    // When dest is not src, dest is already free: the constant can be built
+    // there and consumed immediately by the ALU op that overwrites it. Only
+    // the in-place form (dest == src) needs a register of its own.
+    //
+    // Preferring dest is not a peephole, it is what keeps three-address
+    // immediate operations working when both MacroAssembler temporaries are
+    // spoken for. branchTest32(cond, Address, mask) is exactly that caller:
+    // it loads the address through one temp and tests into the other, so a
+    // mask that needs materialising has nothing left to materialise into.
+    // immediateScratch's RELEASE_ASSERT fired inside the Baseline compiler
+    // for op_enumerator_put_by_val, whose mask is 0x40010 -- two bits, too
+    // far apart for andi./andis. and not a rotate-and-mask run.
+    RegisterID constantScratch(RegisterID src, RegisterID dest)
+    {
+        if (dest != src)
+            return dest;
+        return immediateScratch(src, dest);
+    }

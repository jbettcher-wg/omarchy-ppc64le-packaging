+
+    void signExtend32ToPtr(RegisterID src, RegisterID dest) { signExtend32To64(src, dest); }
+    void signExtend32ToPtr(TrustedImm32 imm, RegisterID dest) { signExtend32To64(imm, dest); }
+    // ---- logical ----
+    //
+    // Note on CR0: andi. and andis. are the only AND-immediate encodings, and
+    // both write CR0 whether you want it or not. That is harmless here
+    // because CR0 is scratch between a compare and its branch -- every
+    // comparison in this file emits the compare and the branch as one unit,
+    // so nothing else is ever live in CR0 across an unrelated instruction.
+
+    // A 64-bit AND mask that rotate-and-mask can do in one instruction:
+    // either the low n bits (clrldi) or all but the low n bits (clrrdi).
+    // JSC's masks are frequently of this shape, and the alternative is a
+    // five-word constant plus an `and`.
+    bool tryAndImmediate64(RegisterID src, uint64_t mask, RegisterID dest)
+    {
+        if (!mask) {
+            m_assembler.li(dest, 0);
+            return true;
+        }
+        if (mask == ~uint64_t(0)) {
+            move(src, dest);
+            return true;
+        }
+        // Low run: mask == 2^n - 1.
+        if (!(mask & (mask + 1))) {
+            unsigned n = WTF::fastLog2(mask + 1);
+            m_assembler.rldicl(dest, src, 0, 64 - n);
+            return true;
+        }
+        // High run: ~mask == 2^n - 1, i.e. the low n bits are cleared.
+        uint64_t inverted = ~mask;
+        if (!(inverted & (inverted + 1))) {
+            unsigned n = WTF::fastLog2(inverted + 1);
+            m_assembler.rldicr(dest, src, 0, 63 - n);
+            return true;
+        }
+        return false;
+    }
+
+    void andImmediate64(RegisterID src, uint64_t mask, RegisterID dest)
+    {
+        if (tryAndImmediate64(src, mask, dest))
+            return;
+        if (!(mask & ~uint64_t(0xffff))) {
+            m_assembler.andi_(dest, src, static_cast<uint32_t>(mask));
+            return;
+        }
+        if (!(mask & ~uint64_t(0xffff0000))) {
+            m_assembler.andis_(dest, src, static_cast<uint32_t>(mask >> 16));
+            return;
+        }
+        RegisterID scratch = constantScratch(src, dest);
+        m_assembler.loadImmediate64(scratch, static_cast<int64_t>(mask));
+        m_assembler.and_(dest, src, scratch);
+    }

+    {
+        if (bitEquals(value, vectorAllZeros())) {
+            moveZeroToVector(dest);
+            return;
+        }
+        auto temp = temps<Data>();
+        uint64_t low = value.u64x2[0];
+        uint64_t high = value.u64x2[1];
+        if (low == high) {

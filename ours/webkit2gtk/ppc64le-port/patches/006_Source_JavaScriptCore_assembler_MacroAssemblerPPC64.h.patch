+    // ==================================================================
+    // Branches.
+    //
+    // A conditional branch is the two-word site described in
+    // PPC64Assembler.h: the guard word tests the INVERTED condition and
+    // skips the second word, which is the `b` that link time points at the
+    // target. Two words, always, whether the target turns out near or far.
+    //
+    // Everything below funnels through makeBranch, so there is exactly one
+    // place where a condition becomes machine code.
+    // ==================================================================
+
+    Jump makeBranch(CRTest test)
+    {
+        auto label = m_assembler.label();
+        // Guard: branch over the following word when the condition does NOT
+        // hold, hence BOFalse for a branch-if-set test and vice versa.
+        m_assembler.insn(Assembler::conditionalGuardInsn(
+            test.branchIfSet ? Assembler::BOFalse : Assembler::BOTrue,
+            crBitIndex(test.field, test.bit)));
+        m_assembler.insn(Assembler::unlinkedBranchInsn(false));
+        return Jump(label);
+    }

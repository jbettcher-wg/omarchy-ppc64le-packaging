+    // ==================================================================
+    // Lane extract and replace.
+    //
+    // Memory order IS wasm lane order here, and mfvsrd/mtvsrd touch ISA
+    // doubleword 0, which is MEMORY BYTES 8-15 -- the HIGH memory doubleword.
+    // So wasm lane 1 of an i64x2 is ISA doubleword 0 and wasm lane 0 is ISA
+    // doubleword 1, and the xxpermdi selectors below follow from that and
+    // nothing else. Every path is VSX or GPR: no VMX form is used, so this
+    // group does not depend on how the VMX/VSX register-model question
+    // (jsc-ppc64le-vector-register-model.md) is settled.
+    //
+    // xxpermdi XT,XA,XB,DM takes XT doubleword 0 from XA (DM bit 1 picks
+    // which) and XT doubleword 1 from XB (DM bit 0).
+    void vectorExtractLane(SIMDLane lane, SIMDSignMode signMode, TrustedImm32 laneIndex, FPRegisterID src, RegisterID dest)
+    {
+        unsigned index = static_cast<unsigned>(laneIndex.m_value);
+        unsigned laneBits = 8u << (static_cast<unsigned>(lane) - static_cast<unsigned>(SIMDLane::i8x16));
+        unsigned lanesPerDoubleword = 64 / laneBits;
+        unsigned memoryDoubleword = index / lanesPerDoubleword;
+        unsigned within = index % lanesPerDoubleword;
+
+        emitVectorDoublewordToGPR(src, memoryDoubleword, dest);
+        if (laneBits < 64) {
+            // Rotate the wanted field down to bit 0 and mask to its width.
+            unsigned shift = (64 - laneBits * within) % 64;
+            m_assembler.rldicl(dest, dest, shift, 64 - laneBits);
+            if (signMode == SIMDSignMode::Signed) {
+                if (laneBits == 8)
+                    m_assembler.extsb(dest, dest);
+                else if (laneBits == 16)
+                    m_assembler.extsh(dest, dest);
+                else
+                    m_assembler.extsw(dest, dest);
+            }
+        }
+    }

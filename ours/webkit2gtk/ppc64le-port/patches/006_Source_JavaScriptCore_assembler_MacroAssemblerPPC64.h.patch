+    void moveDoubleConditionally64(RelationalCondition cond, RegisterID left, RegisterID right, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitCompare64(cond, left, right), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionally64(RelationalCondition cond, RegisterID left, TrustedImm32 right, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitCompare64(cond, left, right), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionallyDouble(DoubleCondition cond, FPRegisterID a, FPRegisterID b, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitDoubleCompare(cond, a, b), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionallyFloat(DoubleCondition cond, FPRegisterID a, FPRegisterID b, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitFloatCompare(cond, a, b), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionallyDoubleWithZero(DoubleCondition cond, FPRegisterID reg, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitDoubleCompareWithZero(cond, reg), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionallyFloatWithZero(DoubleCondition cond, FPRegisterID reg, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitFloatCompareWithZero(cond, reg), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionallyTest32(ResultCondition cond, RegisterID reg, RegisterID mask, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitTest32(cond, reg, mask), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionallyTest32(ResultCondition cond, RegisterID reg, TrustedImm32 mask, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitTest32(cond, reg, mask), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionallyTest64(ResultCondition cond, RegisterID reg, RegisterID mask, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitTest64(cond, reg, mask), thenCase, elseCase, dest);
+    }
+
+    void moveDoubleConditionallyTest64(ResultCondition cond, RegisterID reg, TrustedImm32 mask, FPRegisterID thenCase, FPRegisterID elseCase, FPRegisterID dest)
+    {
+        emitSelectDouble(emitTest64(cond, reg, mask), thenCase, elseCase, dest);
+    }
+    // ---- half precision ----
+    //
+    // A float16 in an FPR is its raw 16-bit IEEE pattern in halfword 3 of
+    // doubleword 0 (bits 48:63); the other 112 bits are don't-care. That is
+    // the port's raw-bits float model narrowed one width: the float lives in
+    // word 1, the half in the low half of that word.
+    //
+    // Every one of these asserts supportsFloat16() rather than trusting the
+    // caller. Upstream consults the predicate at parse time, in the fixup
+    // phase and in the ICs, but ArithF16Round has a single parse-time guard
+    // while the fixup phase, FTLCapabilities and the FTL lowering accept the
+    // node unconditionally, so anything that synthesises it outside the
+    // parser reaches these primitives. On a POWER8 machine that would be a
+    // SIGILL on an instruction the CPU does not have; the assert fails with
+    // a line that says why instead.
+    void loadFloat16(Address address, FPRegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, false);
+        m_assembler.lxsihzx(dest, PPC64Registers::r0, foldOffsetIntoAddressRegister(resolution, temp));
+    }
+
+    void loadFloat16(BaseIndex address, FPRegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), false);
+        m_assembler.lxsihzx(dest, PPC64Registers::r0, foldOffsetIntoAddressRegister(resolution, temp.memory()));
+    }
+
+    void loadFloat16(TrustedImmPtr address, FPRegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        auto temp = temps<Memory>();
+        loadImmediate(address, temp.memory());
+        m_assembler.lxsihzx(dest, PPC64Registers::r0, temp.memory());
+    }
+
+    void storeFloat16(FPRegisterID src, Address address)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        auto temp = lazyTemp<Memory>();
+        auto resolution = resolveAddress(address, temp, false);
+        m_assembler.stxsihx(src, PPC64Registers::r0, foldOffsetIntoAddressRegister(resolution, temp));
+    }
+
+    void storeFloat16(FPRegisterID src, BaseIndex address)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        auto temp = temps<Memory>();
+        auto resolution = resolveAddress(address, temp.memory(), false);
+        m_assembler.stxsihx(src, PPC64Registers::r0, foldOffsetIntoAddressRegister(resolution, temp.memory()));
+    }
+
+    // Reads halfword 3. Exact by construction: every half is representable
+    // as a double.
+    void convertFloat16ToDouble(FPRegisterID src, FPRegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        m_assembler.xscvhpdp(dest, src);
+    }
+
+    // Writes halfword 3, rounding under the FPSCR, which by default is
+    // round-to-nearest-even -- exactly what Math.f16round and
+    // DataView.setFloat16 require. Measured against a software RNE
+    // reference: ties round to even (2049 -> 6800, 2051 -> 6802), 65520
+    // overflows to inf, and the smallest denormal survives. The instruction
+    // also zeroes bits 0:47 of the doubleword, which this model does not
+    // rely on.
+    void convertDoubleToFloat16(FPRegisterID src, FPRegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        m_assembler.xscvdphp(dest, src);
+    }
+
+    void moveZeroToFloat16(FPRegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        m_assembler.xxlxor(dest, dest, dest);
+    }
+
+    // mtvsrwz zero-extends the word into word 1, so halfword 3 is the GPR's
+    // low sixteen bits.
+    void move16ToFloat16(RegisterID src, FPRegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        m_assembler.mtvsrwz(dest, src);
+    }
+
+    void move16ToFloat16(TrustedImm32 imm, FPRegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        auto temp = temps<Data>();
+        loadImmediate(imm, temp.data());
+        m_assembler.mtvsrwz(dest, temp.data());
+    }
+
+    // The mask is what makes bits 16:31 don't-care: without it a later
+    // mtvsrwz from this GPR would carry whatever the upper halfword held
+    // back into the register.
+    void moveFloat16To16(FPRegisterID src, RegisterID dest)
+    {
+        RELEASE_ASSERT(supportsFloat16());
+        m_assembler.mfvsrwz(dest, src);
+        m_assembler.clrldi(dest, dest, 48);
+    }
+};

+        m_assembler.mfvsrwz(dest, fpTempRegister);
+        m_assembler.mtvsrwa(fpTempRegister, dest);
+        m_assembler.fcfid(fpTempRegister, fpTempRegister);
+        m_assembler.fcmpu(CRField::CR0, fpTempRegister, fpTempRegister2);

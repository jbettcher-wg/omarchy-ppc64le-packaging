+    // ==================================================================
+    // Arithmetic that branches on overflow or carry.
+    //
+    // None of this touches XER. Reading XER back into a CR field needs
+    // mcrxrx, which is ISA 3.0 (POWER9-only), and the LuaJIT ppc64le port's
+    // correction ledger records XER manipulation as both slow and easy to
+    // get subtly wrong. Every test below is a comparison instead, which is
+    // POWER8-clean and can be reasoned about directly:
+    //
+    //   32-bit overflow: do the arithmetic EXACTLY in 64 bits on
+    //     sign-extended operands, then ask whether the 64-bit result still
+    //     equals the sign-extension of its own low word. This is the idiom
+    //     V8 and SpiderMonkey use on this target.
+    //   64-bit add overflow: the sign test ((r^a) & (r^b)) < 0.
+    //   64-bit sub overflow: ((a^b) & (a^r)) < 0.
+    //   64-bit mul overflow: the high half must equal the sign-extension of
+    //     the low half.
+    //   carry (unsigned): the result of an add is smaller than an operand;
+    //     the borrow of a subtract is a < b.
+    //
+    // Where a third scratch is needed, `dest` is used for it -- but only
+    // after both source operands have been read for the last time, which is
+    // why the instruction order in these helpers is not free to change.
+    // ==================================================================
+
+    // THE ALIASING CONTRACT OF THIS FAMILY, and why it needs stating.
+    //
+    // temps<>() hands every caller the same two physical registers and tracks
+    // nothing, so it cannot tell an outer method that has staged a value into
+    // memoryTempRegister from an inner one about to overwrite it. Every
+    // immediate entry point below stages its operand exactly there --
+    // `loadImmediate(imm, temp.memory())` and then passes temp.memory() as a
+    // source -- so `b` routinely IS memoryTempRegister, and the Address form
+    // of branchAdd32 does the same for `a`. A helper that writes a temp before
+    // its last read of the operand that lives in it silently computes
+    // something else. Two helpers did, and neither had a caller that could
+    // reach it, which is exactly why nothing noticed.
+    //
+    // So: each helper reads every source operand before writing any temp that
+    // could be that operand, and states which aliases it tolerates with a
+    // RELEASE_ASSERT at emit time. The assertion is the list; there is no
+    // hand-maintained table anywhere else, and a new entry point that stages
+    // an operand somewhere new trips it instead of miscompiling.
+
+    CRTest emitAdd32Overflow(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // b is read after the first write to dataTempRegister.
+        RELEASE_ASSERT(b != dataTempRegister);
+        auto temp = temps<Data, Memory>();
+        m_assembler.extsw(temp.data(), a);
+        m_assembler.extsw(temp.memory(), b);
+        m_assembler.add(temp.data(), temp.data(), temp.memory());
+        m_assembler.extsw(temp.memory(), temp.data());
+        m_assembler.cmpd(CRField::CR0, temp.data(), temp.memory());
+        m_assembler.clrldi(dest, temp.data(), 32);
+        return { CRBit::EQ, false }; // differ => overflowed int32
+    }
+
+    CRTest emitAdd32OverflowImm(RegisterID src, int32_t value, RegisterID dest)
+    {
+        auto temp = temps<Data, Memory>();
+        m_assembler.extsw(temp.data(), src);
+        addImmediate64(temp.data(), static_cast<int64_t>(value), temp.data());
+        m_assembler.extsw(temp.memory(), temp.data());
+        m_assembler.cmpd(CRField::CR0, temp.data(), temp.memory());
+        m_assembler.clrldi(dest, temp.data(), 32);
+        return { CRBit::EQ, false };
+    }
+
+    CRTest emitAdd32Carry(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // a is read again after the add writes dataTempRegister. b may be
+        // memoryTempRegister -- the immediate form always makes it so -- and
+        // a may be too, from the Address form; both are read before anything
+        // writes it.
+        RELEASE_ASSERT(a != dataTempRegister);
+        auto temp = temps<Data, Memory>();
+        // The add goes FIRST because it is the only instruction that reads b,
+        // and the clrldi below writes the register b may be living in. With
+        // the two the other way round, branchAdd32(Carry, src, imm, dest)
+        // computed src + zext32(src) and compared it against zext32(src):
+        // a wrong value, not merely a wrong flag.
+        m_assembler.add(temp.data(), a, b);
+        m_assembler.clrldi(temp.memory(), a, 32);
+        m_assembler.clrldi(temp.data(), temp.data(), 32);
+        m_assembler.cmpld(CRField::CR0, temp.data(), temp.memory());
+        m_assembler.mr(dest, temp.data());
+        return { CRBit::LT, true }; // sum < addend => carried out
+    }
+
+    CRTest emitSub32Overflow(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // b is read after the first write to dataTempRegister.
+        RELEASE_ASSERT(b != dataTempRegister);
+        auto temp = temps<Data, Memory>();
+        m_assembler.extsw(temp.data(), a);
+        m_assembler.extsw(temp.memory(), b);
+        m_assembler.subf(temp.data(), temp.memory(), temp.data());
+        m_assembler.extsw(temp.memory(), temp.data());
+        m_assembler.cmpd(CRField::CR0, temp.data(), temp.memory());
+        m_assembler.clrldi(dest, temp.data(), 32);
+        return { CRBit::EQ, false };
+    }
+
+    CRTest emitSub32Carry(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // Both operands are read a second time by the subf below, after both
+        // temps have been written. That is safe for the alias that actually
+        // occurs -- b == memoryTempRegister, from the immediate form -- but
+        // only because the value it was overwritten with is zext32 of itself,
+        // which is congruent mod 2^32 and the result is masked to 32 bits
+        // anyway. It is not safe the other way round: a in memoryTempRegister
+        // would be read back as zext32(b).
+        RELEASE_ASSERT(a != memoryTempRegister && b != dataTempRegister);
+        auto temp = temps<Data, Memory>();
+        m_assembler.clrldi(temp.data(), a, 32);
+        m_assembler.clrldi(temp.memory(), b, 32);
+        m_assembler.cmpld(CRField::CR0, temp.data(), temp.memory());
+        m_assembler.subf(dest, b, a);
+        m_assembler.clrldi(dest, dest, 32);
+        return { CRBit::LT, true }; // a < b => borrow
+    }
+
+    CRTest emitMul32Overflow(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // |a|, |b| < 2^31, so the exact product fits comfortably in 64 bits
+        // and mulld cannot itself overflow.
+        // b is read after the first write to dataTempRegister.
+        RELEASE_ASSERT(b != dataTempRegister);
+        auto temp = temps<Data, Memory>();
+        m_assembler.extsw(temp.data(), a);
+        m_assembler.extsw(temp.memory(), b);
+        m_assembler.mulld(temp.data(), temp.data(), temp.memory());
+        m_assembler.extsw(temp.memory(), temp.data());
+        m_assembler.cmpd(CRField::CR0, temp.data(), temp.memory());
+        m_assembler.clrldi(dest, temp.data(), 32);
+        return { CRBit::EQ, false };
+    }
+
+    CRTest emitNeg32Overflow(RegisterID srcDest)
+    {
+        // The only int32 whose negation overflows is INT32_MIN.
+        auto temp = temps<Data, Memory>();
+        m_assembler.extsw(temp.data(), srcDest);
+        m_assembler.neg(temp.data(), temp.data());
+        m_assembler.extsw(temp.memory(), temp.data());
+        m_assembler.cmpd(CRField::CR0, temp.data(), temp.memory());
+        m_assembler.clrldi(srcDest, temp.data(), 32);
+        return { CRBit::EQ, false };
+    }
+
+    CRTest emitAdd64Overflow(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // b may be memoryTempRegister, because branchAdd64(Overflow, src,
+        // TrustedImm32, dest) stages it there; a may be dest, because
+        // branchAdd64(cond, TrustedImm32, dest) passes dest as a. Both of
+        // those are tolerated below and the order is what tolerates them.
+        // a may not be either temp and b may not be dataTempRegister; no
+        // entry point in this file does that.
+        RELEASE_ASSERT(a != dataTempRegister && a != memoryTempRegister && b != dataTempRegister);
+        auto temp = temps<Data, Memory>();
+        m_assembler.add(temp.data(), a, b);              // r
+        // r ^ b comes FIRST, and into memoryTempRegister, because this is the
+        // last read of b and memoryTempRegister is where b may be living. The
+        // other order -- r ^ a into the memory temp, then r ^ b -- read a b
+        // that had just been overwritten with r ^ a, which collapses the
+        // predicate ((r^a) & (r^b)) < 0 into ((r^a) & a) < 0. That misses
+        // EVERY overflow of a positive immediate and invents overflows for a
+        // negative a, and no random-input test can find it: with a 32-bit
+        // immediate an overflow only exists when a is within 2^31 of a
+        // boundary, so uniform operands produce no overflows to disagree
+        // about at all.
+        m_assembler.xor_(temp.memory(), temp.data(), b); // r ^ b -- last read of b
+        m_assembler.xor_(dest, temp.data(), a);          // r ^ a -- last read of a
+        m_assembler.and_(temp.memory(), temp.memory(), dest);
+        m_assembler.cmpdi(CRField::CR0, temp.memory(), 0);
+        m_assembler.mr(dest, temp.data());
+        return { CRBit::LT, true };
+    }
+
+    CRTest emitSub64Overflow(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // b's last read is the xor that writes memoryTempRegister, in the same
+        // instruction, so b may be that register -- which the immediate form
+        // makes it. a is read up to the third instruction, which writes dest
+        // in the same instruction, so a may be dest but neither temp.
+        RELEASE_ASSERT(a != dataTempRegister && a != memoryTempRegister && b != dataTempRegister);
+        auto temp = temps<Data, Memory>();
+        m_assembler.subf(temp.data(), b, a);             // r = a - b
+        m_assembler.xor_(temp.memory(), a, b);           // a ^ b
+        m_assembler.xor_(dest, a, temp.data());          // a ^ r -- last read of a
+        m_assembler.and_(temp.memory(), temp.memory(), dest);
+        m_assembler.cmpdi(CRField::CR0, temp.memory(), 0);
+        m_assembler.mr(dest, temp.data());
+        return { CRBit::LT, true };
+    }
+
+    CRTest emitMul64Overflow(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // Both operands are read again by the mulld, after mulhd has written
+        // dataTempRegister; the mulld writes memoryTempRegister in the same
+        // instruction that reads them, so that one is fine.
+        RELEASE_ASSERT(a != dataTempRegister && b != dataTempRegister);
+        auto temp = temps<Data, Memory>();
+        m_assembler.mulhd(temp.data(), a, b);
+        m_assembler.mulld(temp.memory(), a, b);          // last read of a and b
+        m_assembler.sradi(dest, temp.memory(), 63);      // sign-extension of the low half
+        m_assembler.cmpd(CRField::CR0, temp.data(), dest);
+        m_assembler.mr(dest, temp.memory());
+        return { CRBit::EQ, false };
+    }
+
+    CRTest emitNeg64Overflow(RegisterID srcDest)
+    {
+        RegisterID scratch = immediateScratch(srcDest, srcDest);
+        m_assembler.loadImmediate64(scratch, std::numeric_limits<int64_t>::min());
+        m_assembler.cmpd(CRField::CR0, srcDest, scratch);
+        m_assembler.neg(srcDest, srcDest);
+        return { CRBit::EQ, true };
+    }
+
+    CRTest emitAdd64Carry(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // a is read again by the compare, after the add has written
+        // dataTempRegister. b is read once, by the add itself, so b may be
+        // either temp -- which is what makes the immediate form safe here and
+        // not in emitAdd32Carry.
+        RELEASE_ASSERT(a != dataTempRegister);
+        auto temp = temps<Data>();
+        m_assembler.add(temp.data(), a, b);
+        m_assembler.cmpld(CRField::CR0, temp.data(), a);
+        m_assembler.mr(dest, temp.data());
+        return { CRBit::LT, true };
+    }
+
+    CRTest emitSub64Carry(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        m_assembler.cmpld(CRField::CR0, a, b);
+        m_assembler.subf(dest, b, a);
+        return { CRBit::LT, true };
+    }

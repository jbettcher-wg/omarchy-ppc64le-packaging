+    void vectorExtractLane(SIMDLane lane, TrustedImm32 laneIndex, FPRegisterID src, FPRegisterID dest)
+    {
+        unsigned index = static_cast<unsigned>(laneIndex.m_value);
+        switch (lane) {
+        case SIMDLane::f32x4:
+            // A single is kept as its raw pattern in ISA word 1, and splatting
+            // the wanted word puts it there whichever lane it came from.
+            m_assembler.xxspltw(dest, src, 3 - index);
+            return;
+        case SIMDLane::f64x2:
+            m_assembler.xxpermdi(dest, src, src, index ? 0 : 3);
+            return;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+    }
+
+    void vectorReplaceLane(SIMDLane lane, TrustedImm32 laneIndex, RegisterID src, FPRegisterID dest)
+    {
+        unsigned index = static_cast<unsigned>(laneIndex.m_value);
+        unsigned laneBits = 8u << (static_cast<unsigned>(lane) - static_cast<unsigned>(SIMDLane::i8x16));
+        unsigned lanesPerDoubleword = 64 / laneBits;
+        unsigned memoryDoubleword = index / lanesPerDoubleword;
+        unsigned within = index % lanesPerDoubleword;
+
+        auto temp = temps<Data>();
+        RegisterID scratch = temp.data();
+        if (laneBits == 64)
+            m_assembler.mtvsrd(fpTempRegister, src);
+        else {
+            emitVectorDoublewordToGPR(dest, memoryDoubleword, scratch);
+            // Rotate the target field to bit 0, insert, rotate back. rldimi's
+            // mask always runs to bit 63, so the field has to be at the bottom.
+            unsigned down = (64 - laneBits * within) % 64;
+            unsigned up = (laneBits * within) % 64;
+            if (down)
+                m_assembler.rldicl(scratch, scratch, down, 0);
+            m_assembler.rldimi(scratch, src, 0, 64 - laneBits);
+            if (up)
+                m_assembler.rldicl(scratch, scratch, up, 0);
+            m_assembler.mtvsrd(fpTempRegister, scratch);
+        }
+        emitVectorMergeDoubleword(dest, fpTempRegister, memoryDoubleword);
+    }

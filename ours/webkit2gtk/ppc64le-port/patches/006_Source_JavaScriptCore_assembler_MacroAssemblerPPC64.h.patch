+    void and32(RegisterID src, RegisterID dest) { and32(src, dest, dest); }
+
+    void and32(RegisterID a, RegisterID b, RegisterID dest)
+    {
+        // The inputs are NOT guaranteed clean, so the output must be masked.
+        //
+        // This used to assume otherwise -- "every 32-bit producer re-masks, so
+        // the invariant does hold on entry" -- and that is false under B3.
+        // AirOpcode.opcodes declares And32/Or32/Xor32 as ZD:G:32, which is a
+        // promise that the def's upper 32 bits are ZERO, and B3 relies on it:
+        // it lowers Trunc to nothing at all (B3LowerToAir.cpp, case Trunc), so
+        // a 64-bit value flows into a 32-bit operation with a dirty upper
+        // word, and the greedy allocator coalesces away the Move32 that would
+        // otherwise have cleaned it because the def width is already <= 32.
+        //
+        // The consequence was not subtle. With FTL on, `a & b` returned NaN
+        // for every input: the operands arrive boxed (0xFFFE...), the bare
+        // `and` kept the tag bits, and adding NumberTag to an already-tagged
+        // value produces a double pattern. A dirty value used as an index
+        // instead yields a wild address, which is the shape of several of the
+        // SIGSEGVs.
+        //
+        // testb3 cannot see this: it reads results back as C int32, which
+        // discards exactly the bits that are wrong.
+        m_assembler.and_(dest, a, b);
+        maskLow32(dest);
+    }

+    // one asks whether src is an integer at all, so the round trip has to be
+    // compared against `src` itself and never against trunc(src) -- the same
+    // thing ARM64 does with fcvtns/scvtf. Delegating to the truncating form
+    // made JITDivGenerator decide that 21/4 "is actually an integer" and
+    // hand JavaScript back the number 5.
+    void branchConvertDoubleToInt32(FPRegisterID src, RegisterID dest, JumpList& failureCases, FPRegisterID, bool negZeroCheck = true)
+    {
+        m_assembler.fctiwz(fpTempRegister, src);     // saturating 32-bit convert
+        m_assembler.mfvsrwz(dest, fpTempRegister);
+        m_assembler.mtvsrwa(fpTempRegister, dest);
+        m_assembler.fcfid(fpTempRegister, fpTempRegister);

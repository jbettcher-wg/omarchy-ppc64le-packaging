+    // ---- generated stub surface (see the header comment) ----
+    // ---- add / sub ----
+    //
+    // JSC's convention, which every method below follows: the two-operand
+    // form is op(src, dest) meaning dest = dest OP src, and the three-operand
+    // form is op(a, b, dest) meaning dest = a OP b. PowerPC's subf is the
+    // other way round from both -- subf(rt, ra, rb) computes rt = rb - ra --
+    // so every subtraction here reads with its operands crossed. That is the
+    // single easiest thing to get backwards in this file.
+
+    // dest = src + value, choosing the shortest encoding that is exact.
+    void addImmediate64(RegisterID src, int64_t value, RegisterID dest)
+    {
+        if (!value) {
+            move(src, dest);
+            return;
+        }
+        if (Assembler::isValidSigned16(value)) {
+            m_assembler.addi(dest, src, static_cast<int32_t>(value));
+            return;
+        }
+        // Any signed 32-bit displacement is an addis/addi pair and needs NO
+        // scratch register at all. addi sign-extends its field, so when the
+        // low half is negative the high half has to be pre-compensated --
+        // that is what the subtraction before the shift does. Doing this
+        // without a temp is worth the arithmetic: every TrustedImm32 offset
+        // in the engine lands here, including from callers that are already
+        // using both temps.
+        // addi sign-extends its 16-bit field, so when the low half is
+        // negative the high half has to be compensated upward by one. That
+        // compensation can carry OUT of the signed 16-bit range: for any
+        // value in [0x7fff8000, 0x7fffffff] the corrected high half is
+        // +32768, which addis cannot encode. It would be truncated to
+        // -32768 and produce an address off by 2^32 -- silently, and only
+        // for a narrow band of large positive displacements. (Found by
+        // testmasm's load-with-large-offset cases, which emitted
+        // `addis rD,rA,-32768 ; addi rD,rD,-1` for an offset of +2147483647.)
+        // isValidSigned16 on the corrected half is the guard; anything it
+        // rejects goes through a register instead.
+        if (Assembler::isValidSigned32(value)) {
+            int32_t low = static_cast<int16_t>(value);
+            int64_t high = (value - low) >> 16;
+            if (Assembler::isValidSigned16(high)) {
+                RegisterID current = src;
+                if (high) {
+                    m_assembler.addis(dest, current, static_cast<int32_t>(high));
+                    current = dest;
+                }
+                if (low) {
+                    m_assembler.addi(dest, current, low);
+                    current = dest;
+                }
+                move(current, dest);
+                return;
+            }
+        }
+        RegisterID scratch = constantScratch(src, dest);
+        m_assembler.loadImmediate64(scratch, value);
+        m_assembler.add(dest, src, scratch);
+    }

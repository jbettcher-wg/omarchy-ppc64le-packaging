+    CRTest emitTest32(ResultCondition cond, RegisterID reg, TrustedImm32 mask)
+    {
+        if (mask.m_value == -1)
+            return emitTestResult32(cond, reg);
+        auto temp = temps<Data>();
+        and32(mask, reg, temp.data());
+        return emitTestResult32(cond, temp.data());
+    }
+
+    CRTest emitTest32(ResultCondition cond, RegisterID reg, RegisterID mask)
+    {
+        if (reg == mask)
+            return emitTestResult32(cond, reg);
+        auto temp = temps<Data>();
+        m_assembler.and_(temp.data(), reg, mask);
+        return emitTestResult32(cond, temp.data());
+    }
+
+    CRTest emitTest64(ResultCondition cond, RegisterID reg, TrustedImm32 mask)
+    {
+        if (mask.m_value == -1)
+            return emitTestResult64(cond, reg);
+        auto temp = temps<Data>();

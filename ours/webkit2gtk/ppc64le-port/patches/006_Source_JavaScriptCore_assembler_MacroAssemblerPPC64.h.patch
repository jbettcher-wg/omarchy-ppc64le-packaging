+    void emitVectorCompareVMX(VectorCompareKind kind, SIMDLane lane, VRegisterID t, VRegisterID a, VRegisterID b)
+    {
+        switch (kind) {
+        case VectorCompareKind::Equal:
+            switch (lane) {
+            case SIMDLane::i8x16: m_assembler.vcmpequb(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vcmpequh(t, a, b); return;
+            case SIMDLane::i32x4: m_assembler.vcmpequw(t, a, b); return;
+            case SIMDLane::i64x2: m_assembler.vcmpequd(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        case VectorCompareKind::GreaterSigned:
+            switch (lane) {
+            case SIMDLane::i8x16: m_assembler.vcmpgtsb(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vcmpgtsh(t, a, b); return;
+            case SIMDLane::i32x4: m_assembler.vcmpgtsw(t, a, b); return;
+            case SIMDLane::i64x2: m_assembler.vcmpgtsd(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        case VectorCompareKind::GreaterUnsigned:
+            switch (lane) {
+            case SIMDLane::i8x16: m_assembler.vcmpgtub(t, a, b); return;
+            case SIMDLane::i16x8: m_assembler.vcmpgtuh(t, a, b); return;
+            case SIMDLane::i32x4: m_assembler.vcmpgtuw(t, a, b); return;
+            case SIMDLane::i64x2: m_assembler.vcmpgtud(t, a, b); return;
+            default: RELEASE_ASSERT_NOT_REACHED();
+            }
+        }
+        RELEASE_ASSERT_NOT_REACHED();

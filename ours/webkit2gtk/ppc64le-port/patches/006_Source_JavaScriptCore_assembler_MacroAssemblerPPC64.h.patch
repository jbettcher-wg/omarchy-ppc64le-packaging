+    // ---- floating-point conditions ----
+    //
+    // fcmpu sets exactly one of LT, GT, EQ, SO in its target field: SO means
+    // "unordered", i.e. at least one operand is NaN, and in that case LT, GT
+    // and EQ are all clear. Six of JSC's twelve DoubleConditions are single
+    // bits of that; the other six are disjunctions of two, which need a
+    // cror. The result of that cror MUST land in a different field from its
+    // inputs, which is what cr7 is reserved for -- cr2 to cr4 are
+    // callee-saved and are never written by this port.
+    CRTest emitDoubleConditionFromCR0(DoubleCondition cond)
+    {
+        constexpr CRField source = CRField::CR0;
+        constexpr CRField composed = CRField::CR7;
+        auto composeInto = [&](CRBit first, CRBit second) -> CRTest {
+            m_assembler.cror(crBitIndex(composed, CRBit::LT),
+                crBitIndex(source, first), crBitIndex(source, second));
+            return { CRBit::LT, true, composed };
+        };
+
+        switch (cond) {
+        // Single-bit tests.
+        case DoubleEqualAndOrdered:                return { CRBit::EQ, true };
+        case DoubleGreaterThanAndOrdered:          return { CRBit::GT, true };
+        case DoubleLessThanAndOrdered:             return { CRBit::LT, true };
+        // "or unordered" complements of the above: NaN clears the tested bit,
+        // so testing it as FALSE already includes the unordered case.
+        case DoubleNotEqualOrUnordered:            return { CRBit::EQ, false };
+        case DoubleGreaterThanOrEqualOrUnordered:  return { CRBit::LT, false };
+        case DoubleLessThanOrEqualOrUnordered:     return { CRBit::GT, false };
+        // Two-bit disjunctions.

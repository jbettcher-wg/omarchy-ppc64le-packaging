+        uint32_t bits = static_cast<uint32_t>(width.m_value);
+        RELEASE_ASSERT(shift < 32 && bits >= 1 && bits <= 32 && shift + bits <= 32);
+        // rldic rotates left by `shift` then clears the top (64 - shift -
+        // bits) bits, which is exactly "mask to width, then shift up".
+        m_assembler.rldic(dest, src, shift, 64 - shift - bits);
+    }

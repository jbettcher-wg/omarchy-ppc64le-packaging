+    // ---- bitfields ----
+    //
+    // These are PowerPC's home ground: rldicl/rlwinm do a rotate and a mask
+    // in one instruction, so ARM64's ubfx/ubfiz map across exactly.
+
+    // dest = (src >> lsb) & ((1 << width) - 1), within 32 bits.
+    void extractUnsignedBitfield32(RegisterID src, TrustedImm32 lsb, TrustedImm32 width, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(lsb.m_value);
+        uint32_t bits = static_cast<uint32_t>(width.m_value);
+        RELEASE_ASSERT(shift < 32 && bits >= 1 && bits <= 32 && shift + bits <= 32);
+        // Rotate right by `shift` (i.e. left by 64 - shift) and clear all but
+        // the low `bits`. Done in the 64-bit form so the result is
+        // zero-extended and the 32-bit invariant holds.
+        m_assembler.rldicl(dest, src, (64 - shift) & 63, 64 - bits);
+    }
+
+    void extractUnsignedBitfield64(RegisterID src, TrustedImm32 lsb, TrustedImm32 width, RegisterID dest)
+    {
+        uint32_t shift = static_cast<uint32_t>(lsb.m_value);
+        uint32_t bits = static_cast<uint32_t>(width.m_value);
+        RELEASE_ASSERT(shift < 64 && bits >= 1 && bits <= 64 && shift + bits <= 64);
+        m_assembler.rldicl(dest, src, (64 - shift) & 63, 64 - bits);
+    }

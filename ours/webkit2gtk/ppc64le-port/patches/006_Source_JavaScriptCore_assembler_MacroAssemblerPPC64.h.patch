+    void emitStoreDForm(StoreKind kind, RegisterID src, RegisterID base, int32_t offset)
+    {
+        switch (kind) {
+        case StoreKind::S8:  m_assembler.stb(src, base, offset); return;
+        case StoreKind::S16: m_assembler.sth(src, base, offset); return;
+        case StoreKind::S32: m_assembler.stw(src, base, offset); return;
+        case StoreKind::S64: m_assembler.std(src, base, offset); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }
+
+    void emitStoreXForm(StoreKind kind, RegisterID src, RegisterID base, RegisterID index)
+    {
+        ASSERT(base != PPC64Registers::r0);
+        switch (kind) {
+        case StoreKind::S8:  m_assembler.stbx(src, base, index); return;
+        case StoreKind::S16: m_assembler.sthx(src, base, index); return;
+        case StoreKind::S32: m_assembler.stwx(src, base, index); return;
+        case StoreKind::S64: m_assembler.stdx(src, base, index); return;
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+    }

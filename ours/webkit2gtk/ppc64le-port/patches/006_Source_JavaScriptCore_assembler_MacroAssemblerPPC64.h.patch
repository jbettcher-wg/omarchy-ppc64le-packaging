+    // then clear the upper half again. That is not redundant: extsb of a
+    // negative byte sets bits 32:63, and boxInt32 would then produce a
+    // corrupt JSValue.
+
+    void zeroExtend8To32(RegisterID src, RegisterID dest) { m_assembler.clrldi(dest, src, 56); }
+    void zeroExtend16To32(RegisterID src, RegisterID dest) { m_assembler.clrldi(dest, src, 48); }
+    void zeroExtend32ToWord(RegisterID src, RegisterID dest) { m_assembler.clrldi(dest, src, 32); }
+
+    void signExtend8To32(RegisterID src, RegisterID dest) { m_assembler.extsb(dest, src); maskLow32(dest); }
+    void signExtend16To32(RegisterID src, RegisterID dest) { m_assembler.extsh(dest, src); maskLow32(dest); }
+
+    void zeroExtend8To64(RegisterID src, RegisterID dest) { m_assembler.clrldi(dest, src, 56); }
+    void zeroExtend16To64(RegisterID src, RegisterID dest) { m_assembler.clrldi(dest, src, 48); }

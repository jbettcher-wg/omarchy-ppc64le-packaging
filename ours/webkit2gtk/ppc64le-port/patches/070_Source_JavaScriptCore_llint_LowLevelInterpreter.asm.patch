+# r25 (t10) and r28-r30 (the offlineasm temporary pool) are nonvolatile in
+# ELFv2 but scratch as far as offlineasm is concerned; r26/r27 (t11/t12) are
+# unused by the interpreter today but are saved anyway so that a future use
+# cannot silently corrupt a C++ caller. These two macros bracket the VM entry:
+# the save area is the CalleeRegisterSaveSize headroom at the top of the entry
+# frame, addressed off cfr (= r31) because sp moves throughout doVMEntry.
+#
+# They are written with `emit` because offlineasm has no names for the
+# temporary pool -- and could not use them if it had, since emitting the save
+# through offlineasm would itself allocate a temporary.
+macro preserveNonvolatileTemporaries()
+    if PPC64
+        emit "std 25, -8(31)"
+        emit "std 26, -16(31)"
+        emit "std 27, -24(31)"
+        emit "std 28, -32(31)"
+        emit "std 29, -40(31)"
+        emit "std 30, -48(31)"
+    end
+end
+
+# Restores the above and leaves sp == cfr, ready for functionEpilogue(). On
+# every other CPU CalleeRegisterSaveSize is 0 and this is the `subp cfr,
+# CalleeRegisterSaveSize, sp` it replaces.
+macro restoreNonvolatileTemporariesAndResetSP()
+    if PPC64
+        emit "ld 25, -8(31)"
+        emit "ld 26, -16(31)"
+        emit "ld 27, -24(31)"
+        emit "ld 28, -32(31)"
+        emit "ld 29, -40(31)"
+        emit "ld 30, -48(31)"
+        move cfr, sp
+    else
+        subp cfr, CalleeRegisterSaveSize, sp
+    end
+end

diff --git a/Source/JavaScriptCore/jit/CCallHelpers.cpp b/Source/JavaScriptCore/jit/CCallHelpers.cpp
index d2f8135bbe..2d4c2d69ab 100644
--- a/Source/JavaScriptCore/jit/CCallHelpers.cpp
+++ b/Source/JavaScriptCore/jit/CCallHelpers.cpp
@@ -95,6 +95,10 @@ void CCallHelpers::emitCTIThunkPrologue(bool returnAddressAlreadyTagged)
     push(X86Registers::ebp); // return address pushed by the call instruction
 #elif CPU(ARM64) || CPU(RISCV64)
     pushPair(framePointerRegister, linkRegister);
+#elif CPU(PPC64LE)
+    // No linkRegister GPR on PowerPC: the return address lives in an SPR and

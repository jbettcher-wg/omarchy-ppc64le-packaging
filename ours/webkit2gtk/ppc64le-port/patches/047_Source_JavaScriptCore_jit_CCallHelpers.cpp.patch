@@ -113,6 +117,8 @@ void CCallHelpers::emitCTIThunkEpilogue()
     pop(X86Registers::ebp); // Return address left on stack
 #elif CPU(ARM64) || CPU(RISCV64)
     popPair(framePointerRegister, linkRegister);
+#elif CPU(PPC64LE)
+    popFramePointerAndLinkRegister();
 #else

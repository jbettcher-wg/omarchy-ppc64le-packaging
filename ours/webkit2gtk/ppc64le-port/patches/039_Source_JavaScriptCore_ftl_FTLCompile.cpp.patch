+            jit.moveToLinkRegister(GPRInfo::argumentGPR1);
 #else
             jit.move(GPRInfo::argumentGPR1, CCallHelpers::linkRegister);
             jit.untagPtr(NoPtrTag, CCallHelpers::linkRegister);

diff --git a/Source/JavaScriptCore/jit/RegisterAtOffset.h b/Source/JavaScriptCore/jit/RegisterAtOffset.h
index eaf0f6cbab..479fa7d324 100644
--- a/Source/JavaScriptCore/jit/RegisterAtOffset.h
+++ b/Source/JavaScriptCore/jit/RegisterAtOffset.h
@@ -47,8 +47,12 @@ public:
     {
         ASSERT(!(offset & 0b11));
         ASSERT(width == conservativeWidthWithoutVectors(reg) || Options::useWasmSIMD());
-        ASSERT(reg.index() < (1 << 6));
-        ASSERT(Reg::last().index() < (1 << 6));
+        // Derived from m_regIndex's width rather than written as a literal:

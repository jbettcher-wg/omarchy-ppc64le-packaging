-    unsigned m_regIndex : 7 { Reg().index() };
+    static constexpr unsigned s_regIndexBits = 7;
+    static constexpr unsigned s_maxRegIndexPlusOne = 1u << s_regIndexBits;
+
+    unsigned m_regIndex : s_regIndexBits { Reg().index() };
     unsigned m_width : 1 { false };
-    ptrdiff_t m_offsetBits : (sizeof(ptrdiff_t) * CHAR_BIT - 7 - 1) { 0 };
+    ptrdiff_t m_offsetBits : (sizeof(ptrdiff_t) * CHAR_BIT - s_regIndexBits - 1) { 0 };
 };
 

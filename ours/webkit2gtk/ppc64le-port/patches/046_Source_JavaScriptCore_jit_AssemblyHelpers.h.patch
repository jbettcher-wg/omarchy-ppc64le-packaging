@@ -256,7 +256,7 @@ public:
 
     void emitRestoreSavedTagRegisters()
     {
-#if CPU(ARM64) || CPU(RISCV64)
+#if CPU(ARM64) || CPU(RISCV64) || CPU(PPC64LE)
         popPair(GPRInfo::numberTagRegister, GPRInfo::notCellMaskRegister);

+#if CPU(PPC64LE)
+    // PowerPC's link register is an SPR, not a GPR, so there is no
+    // `linkRegister` to pass to pushPair the way ARM64 and RISCV64 do. The
+    // frame this builds is nevertheless byte-for-byte the one they build,
+    // and the one offlineasm's `push cfr, lr` builds in the LLInt:
+    //   [cfr + 0] CallerFrame, [cfr + 8] ReturnPC.
+    // That identity is load-bearing -- JIT code and LLInt code call each
+    // other and unwind through each other's frames.
+    void emitFunctionPrologue()
+    {
+        pushFramePointerAndLinkRegister();
+        move(stackPointerRegister, framePointerRegister);
+    }
+
+    void emitFunctionEpilogueWithEmptyFrame()
+    {
+        popFramePointerAndLinkRegister();
+    }
+
+    void emitFunctionEpilogue()
+    {
+        move(framePointerRegister, stackPointerRegister);
+        emitFunctionEpilogueWithEmptyFrame();
+    }
+
+    ALWAYS_INLINE void preserveReturnAddressAfterCall(RegisterID reg)
+    {
+        moveFromLinkRegister(reg);
+    }
+
+    ALWAYS_INLINE void restoreReturnAddressBeforeReturn(RegisterID reg)
+    {
+        moveToLinkRegister(reg);
+    }
+
+    ALWAYS_INLINE void restoreReturnAddressBeforeReturn(Address address)
+    {
+        loadToLinkRegister(address);
+    }
+#endif
+
     void getArityPadding(VM&, unsigned numberOfParameters, GPRReg argumentCountIncludingThisGPR, GPRReg paddingOutputGPR, GPRReg scratchGPR0, GPRReg scratchGPR1, JumpList& stackOverflow);
 

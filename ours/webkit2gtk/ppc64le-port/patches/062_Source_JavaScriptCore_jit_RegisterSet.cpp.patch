+RegisterSet RegisterSet::vmEntryPreservedTemporaries()
+{
+    RegisterSet result;
+#if CPU(PPC64LE)
+    // ONLY the MacroAssembler's two temps, and the reason is that they are
+    // RESERVED: Air never allocates them, nothing holds a live value in them
+    // across a call, and AirHandleCalleeSaves merges them into every Air
+    // procedure's save list anyway (macroClobberedGPRs() & calleeSaveRegisters()
+    // when isPPC64()), so they turn up in a list with no buffer slot through no
+    // fault of the procedure. Dropping them on unwind loses nothing.
+    //
+    // r25-r28 are deliberately NOT here even though preserveNonvolatileTemporaries()
+    // in llint/LowLevelInterpreter.asm saves all six of r25-r30 and they are
+    // equally absent from vmCalleeSaveRegisters(). They are ALLOCATABLE --
+    // GPRInfo names r25-r27 regT10-regT12 -- so an Air procedure can hold a
+    // live JSValue in one across a throw, and the entry-frame copy is how the
+    // handler gets it back. Skipping them instead cost two tests that had been
+    // passing: stress/generator-fib-ftl-and-string.js and
+    // stress/arrowfunction-run-10000-1.js died in
+    // operationValueAddProfiledNoOptimize with a JSValue that failed
+    // downcast<JSObject> in JSCell::toPrimitive -- a value that was dropped on
+    // the way out rather than restored. The asm macro restores the registers
+    // the VM ENTRY saw, which is what a C++ caller needs and not what an
+    // intermediate JS handler needs.
+    //
+    // Doing r25-r28 properly means giving them real slots in
+    // VMEntryRecord::calleeSaveRegistersBuffer, which is a wider change (the
+    // buffer size, the slot map, and the LLInt assembly that writes it). Until
+    // then they still reach the RELEASE_ASSERT below, and some of the residual
+    // SIGABRTs are expected to be exactly that.
+    static_assert(PPC64Registers::r29 == MacroAssembler::dataTempRegister);
+    static_assert(PPC64Registers::r30 == MacroAssembler::memoryTempRegister);
+    result.add(PPC64Registers::r29);
+    result.add(PPC64Registers::r30);
+#endif
+    return result;
+}
+
+RegisterSet RegisterSet::unrecordableCalleeSaveRegisters()
+{
+    RegisterSet result;
+#if CPU(PPC64LE)
+    // ELFv2 makes r14-r28 and f14-f31 nonvolatile, but VMEntryRecord's
+    // calleeSaveRegistersBuffer only has slots for r14-r24 and f14-f25 --
+    // which is what NUMBER_OF_CALLEE_SAVES_REGISTERS and
+    // copyCalleeSavesToBuffer in LowLevelInterpreter.asm are sized and written
+    // for. The difference is r25-r28 and f26-f31, and Air allocating one of
+    // those puts it in a save list that an unwind cannot look up.
+    result = calleeSaveRegisters();
+    result.exclude(vmCalleeSaveRegisters());
 #endif
     return result;
 }

diff --git a/Source/JavaScriptCore/bytecode/InlineCacheCompiler.h b/Source/JavaScriptCore/bytecode/InlineCacheCompiler.h
index 1ded120aa4..e73fb71315 100644
--- a/Source/JavaScriptCore/bytecode/InlineCacheCompiler.h
+++ b/Source/JavaScriptCore/bytecode/InlineCacheCompiler.h
@@ -28,6 +28,13 @@
 #if ENABLE(JIT)
 
 #include "AccessCase.h"
+// This header declares members returning CCallHelpers::Jump and
+// CCallHelpers::JumpList, so it needs the complete type. In an
+// ENABLE_DFG_JIT=ON build it got one by accident, through
+// CallLinkInfo.h -> ... -> a DFG header that includes CCallHelpers.h; with
+// the DFG off that path disappears and the declarations fail to compile.
+// Depend on it directly rather than on a transitive accident.
+#include "CCallHelpers.h"
 #include "InlineCacheHandler.h"
 #include "JITStubRoutine.h"
 #include "JSFunctionInlines.h"
@@ -447,6 +454,12 @@ static constexpr size_t prologueSizeInBytesDataIC = 4;
 static constexpr size_t prologueSizeInBytesDataIC = 0;
 #elif CPU(RISCV64)
 static constexpr size_t prologueSizeInBytesDataIC = 0;
+#elif CPU(PPC64LE)
+// Zero for the same reason as ARM64/RISCV64: the return address is in a link
+// register, not on the stack, so a DataIC leaf needs no prologue at all. The
+// spill of LR is deferred to emitDataICPrepareForCall, which only runs on the
+// paths that actually make a call.
+static constexpr size_t prologueSizeInBytesDataIC = 0;
 #else
 #error "unsupported architecture"
 #endif

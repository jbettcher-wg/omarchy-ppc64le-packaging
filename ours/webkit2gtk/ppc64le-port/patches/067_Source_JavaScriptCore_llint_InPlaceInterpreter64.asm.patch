+# ---- PPC64 (VSX) SIMD helpers ------------------------------------------
+#
+# Register conventions for every PPC64 arm in this section: IPInt v0-v7 are
+# vr0-vr7 = VSR32-39, all volatile in ELFv2; vr8-vr19 are free scratch here.
+# VMX mnemonics (v*) take the vr number and VSX mnemonics (xv*/xx*) take the
+# VSR number, so vr0 is "0" to vspltb and "32" to xxspltw. t0 is r3; ft0 is
+# f1, which is VSR1. Exactly one instruction per emit line: ppc64.rb sizes an
+# emit as 4 bytes when it computes branch reach.
+#
+# Lane order: this target is little-endian and the ISA numbers vector
+# elements big-endian, so ISA byte k is memory byte 15-k, and memory order is
+# what wasm calls lane order. Every cross-lane instruction below therefore
+# either swaps its operands or reverses its element index relative to the
+# big-endian reading of the ISA manual. The lane-order facts are [MEASURED],
+# not read: see powerpc64le-handbook/docs/jsc-ppc64le-wasm-simd.md.
+#
+# ISA level is recorded per macro because it decides which package pool a
+# binary may ship in. IPInt is compiled ahead of time into the jsc/bun
+# binary, so an ISA 3.0 encoding in any handler makes the whole binary
+# POWER9-only, which a POWER8-legal package may not be. Everything here is
+# ISA 2.07 (POWER8-legal) unless the comment says otherwise. Never inline an
+# ISA 3.0 mnemonic in an arm -- put it behind a macro here, so that a future
+# POWER8 variant is a swap in one place. The POWER8 equivalents are
+# tabulated in the handbook doc named above.
+#
+# Note on lxvx/stxvx, which ppc64.rb already emits for loadv/storev/pushv/
+# popv: "as -mpower8" ACCEPTS both and silently assembles them as
+# lxvd2x/stxvd2x, a different encoding with doubleword-swapped little-endian
+# semantics [MEASURED: 7c001a19 vs 7c001e99]. A POWER8-targeted build would
+# therefore miscompile silently rather than fail to assemble. See the
+# handbook doc.
+
+macro ppcSplatInt8()
+    # ISA 2.07. mtvsrd lands r3 in ISA doubleword 0, so the low byte is ISA
+    # byte 7. vspltb UIM is ISA (big-endian) numbering on any endianness.
+    emit "mtvsrd 32, 3"
+    emit "vspltb 0, 0, 7"
+end
+
+macro ppcSplatInt16()
+    # ISA 2.07. Low halfword of ISA doubleword 0 is ISA halfword 3.
+    emit "mtvsrd 32, 3"
+    emit "vsplth 0, 0, 3"
+end
+
+macro ppcSplatInt32()
+    # ISA 2.07. Low word of ISA doubleword 0 is ISA word 1.
+    emit "mtvsrd 32, 3"
+    emit "vspltw 0, 0, 1"
+end
+
+macro ppcSplatInt64()
+    # ISA 2.07. xxspltd is an xxpermdi extended mnemonic, not ISA 3.0.
+    emit "mtvsrd 32, 3"
+    emit "xxspltd 32, 32, 0"
+end
+
+macro ppcSplatFloat32()
+    # ISA 2.07. popFloat32 lowers to lfd, so the slot low eight bytes are in
+    # ISA doubleword 0 of f1 = VSR1 and the raw single sits in ISA word 1 --
+    # the f32 raw-bits model of jsc-ppc64le-yarr-wasm.md section 7.
+    emit "xxspltw 32, 1, 1"
+end
+
+macro ppcSplatFloat64()
+    # ISA 2.07.
+    emit "xxspltd 32, 1, 0"
+end
+
+# -- bitwise ------------------------------------------------------------
+#
+# All ISA 2.06 (the VSX logical group) and so POWER8-legal. These act on
+# whole registers, so the little-endian lane reversal cannot reach them.
+
+macro ppcVectorNot()
+    # ISA 2.06. NOR of the value with itself is NOT.
+    emit "xxlnor 32, 32, 32"
+end
+
+macro ppcVectorAnd()
+    # ISA 2.06.
+    emit "xxland 32, 32, 33"
+end
+
+macro ppcVectorAndnot()
+    # ISA 2.06. wasm v128.andnot is a AND NOT b, and xxlandc is XA AND NOT XB
+    # in that order, so no operand swap. (x86 vpandn is the other way round,
+    # which is why its arm above reads backwards.)
+    emit "xxlandc 32, 32, 33"
+end
+
+macro ppcVectorOr()
+    # ISA 2.06.
+    emit "xxlor 32, 32, 33"
+end
+
+macro ppcVectorXor()
+    # ISA 2.06.
+    emit "xxlxor 32, 32, 33"
+end
+
+macro ppcVectorBitselect()
+    # ISA 2.06. v0 = a, v1 = b, v2 = selector c; wasm wants (a AND c) OR
+    # (b AND NOT c). xxsel XT,XA,XB,XC is (XA AND NOT XC) OR (XB AND XC), so
+    # feeding XA = b and XB = a gives exactly that in one instruction.
+    emit "xxsel 32, 33, 32, 34"
+end
+
+# -- any_true / all_true ------------------------------------------------
+#
+# Both read CR6 from a recording vector compare against zero, which is how
+# this target avoids a movemask. For vcmpequX. the CR6 bits are
+# [0] = every lane compared equal, [2] = no lane compared equal.
+#
+# any_true is "the vector is not all zero" = NOT CR6[0] of a byte compare
+# against zero. all_true is "no lane equalled zero" = CR6[2] of a compare at
+# the lane width. CR6 occupies CR bits 24..27 counting from the most
+# significant, so rlwinm rotates left by 25 to bring bit 24 to the bottom and
+# by 27 to bring bit 26 down; the 31,31 mask also clears the upper word, so
+# the result is a clean 0 or 1 for pushInt32. vr8 is the zero: it is volatile
+# in ELFv2 and outside IPInt v0-v7.
+
+macro ppcVectorAnyTrue()
+    # ISA 2.07 (vcmpequb. is 2.03, xxlxor 2.06).
+    emit "xxlxor 40, 40, 40"
+    emit "vcmpequb. 8, 0, 8"
+    emit "mfcr 3"
+    emit "rlwinm 3, 3, 25, 31, 31"
+    emit "xori 3, 3, 1"
+end
+
+macro ppcVectorAllTrueInt8()
+    # ISA 2.03.
+    emit "xxlxor 40, 40, 40"
+    emit "vcmpequb. 8, 0, 8"
+    emit "mfcr 3"
+    emit "rlwinm 3, 3, 27, 31, 31"
+end
+
+macro ppcVectorAllTrueInt16()
+    # ISA 2.03.
+    emit "xxlxor 40, 40, 40"
+    emit "vcmpequh. 8, 0, 8"
+    emit "mfcr 3"
+    emit "rlwinm 3, 3, 27, 31, 31"
+end
+
+macro ppcVectorAllTrueInt32()
+    # ISA 2.03.
+    emit "xxlxor 40, 40, 40"
+    emit "vcmpequw. 8, 0, 8"
+    emit "mfcr 3"
+    emit "rlwinm 3, 3, 27, 31, 31"
+end
+
+macro ppcVectorAllTrueInt64()
+    # ISA 2.07: vcmpequd. is the one instruction in this family that POWER7
+    # lacks. Still inside the POWER8 floor.
+    emit "xxlxor 40, 40, 40"
+    emit "vcmpequd. 8, 0, 8"
+    emit "mfcr 3"
+    emit "rlwinm 3, 3, 27, 31, 31"
+end
+
+# -- permutes -----------------------------------------------------------
+#
+# These used to be the only POWER9-only code in the SIMD arms, because
+# vpermr is ISA 3.0. They are POWER8-legal now, and for ONE instruction:
+#
+#     vpermr VRT, VRA, VRB, VRC  ==  vnor VRC, VRC, VRC ; vperm VRT, VRA, VRB, VRC
+#
+# with the operand order unchanged. vperm indexes bytes in big-endian
+# register order and masks the index to five bits, and ~k taken mod 32 is
+# 31 - k for every k below 32 -- so complementing the control vector is the
+# whole conversion, with no constant to materialise. (That is the same
+# identity MacroAssemblerPPC64's vectorSwizzle/vectorSwizzle2 use for their
+# POWER8 arms, where it is exercised through forcePOWER8Paths().)
+#
+# Taking it unconditionally rather than gating it costs POWER9 one
+# instruction at two interpreter sites, which is not worth a build-time
+# switch reaching into the .asm. It does clobber the control vector, which is
+# safe here because it is dead after the permute in both macros -- in
+# ppcVectorSwizzle the vcmpgtub that reads the original indices runs first.
+
+macro ppcVectorShuffle()
+    # v0 = a, v1 = b, v2 = the 16 immediate indices. vpermr selects VRB for
+    # 0..15 and VRA for 16..31, both in memory order, which is wasm numbering
+    # exactly, so VRA = b and VRB = a and the control vector is used as it
+    # stands. VRT aliases VRB, which is safe.
+    emit "vnor 2, 2, 2"
+    emit "vperm 0, 1, 0, 2"
+end
+
+macro ppcVectorSwizzle()
+    # v0 = a, v1 = indices. Indices 16..31 land on the zero vector; anything
+    # above that wraps modulo 32, so the out-of-range lanes are masked off
+    # afterwards rather than trusted to the permute.
+    emit "xxlxor 40, 40, 40"
+    emit "vspltisb 9, 15"
+    emit "vcmpgtub 9, 1, 9"
+    emit "vnor 1, 1, 1"
+    emit "vperm 0, 8, 0, 1"
+    emit "vandc 0, 0, 9"
+end
+
+# -- relaxed SIMD fused multiply and dot ---------------------------------
+
+macro ppcRelaxedMaddFloat32()
+    # ISA 2.06. v0 = a, v1 = b, v2 = c. xvmaddasp is XT = XA*XB + XT, so the
+    # addend must start in the destination and a has to be copied aside.
+    emit "xxlor 40, 32, 32"
+    emit "xxlor 32, 34, 34"
+    emit "xvmaddasp 32, 40, 33"
+end
+
+macro ppcRelaxedNmaddFloat32()
+    # ISA 2.06. xvnmsubasp is XT - XA*XB, which is -(a*b) + c.
+    emit "xxlor 40, 32, 32"
+    emit "xxlor 32, 34, 34"
+    emit "xvnmsubasp 32, 40, 33"
+end
+
+macro ppcRelaxedMaddFloat64()
+    # ISA 2.06.
+    emit "xxlor 40, 32, 32"
+    emit "xxlor 32, 34, 34"
+    emit "xvmaddadp 32, 40, 33"
+end
+
+macro ppcRelaxedNmaddFloat64()
+    # ISA 2.06.
+    emit "xxlor 40, 32, 32"
+    emit "xxlor 32, 34, 34"
+    emit "xvnmsubadp 32, 40, 33"
+end
+
+macro ppcRelaxedDotInt16()
+    # ISA 2.03. Signed byte products, ISA-even and ISA-odd, summed in pairs.
+    emit "vmulesb 8, 0, 1"
+    emit "vmulosb 9, 0, 1"
+    emit "vadduhm 0, 8, 9"
+end
+
+macro ppcRelaxedDotAddInt32()
+    # ISA 2.03. The halfword dot above, widened pairwise to words against a
+    # vector of ones, then the addend in v2.
+    emit "vmulesb 8, 0, 1"
+    emit "vmulosb 9, 0, 1"
+    emit "vadduhm 8, 8, 9"
+    emit "vspltish 9, 1"
+    emit "xxlxor 43, 43, 43"
+    emit "vmsumshm 8, 8, 9, 11"
+    emit "vadduwm 0, 8, 2"
+end
+

+JSC_DECLARE_NOEXCEPT_JIT_OPERATION(ctiMasmProbeTrampoline, void, ());
+// Note: there is deliberately no JSC_ANNOTATE_JIT_OPERATION_PROBE here. That
+// macro registers a pointer with the ARM64E pointer-authentication validation
+// list and is not defined in this tree outside that configuration.
+
+using namespace PPC64Registers;
+
+// ===================================================================
+// MacroAssembler::probe() for ELFv2 / ppc64le.
+//
+// The probe spills the entire CPUState to a Probe::State on the stack, calls
+// executeJSCJITProbe(), and then reloads every register from that state --
+// so a probe handler can read AND write the machine state, including sp and
+// pc. jsc-ppc64le-port.md section 16 records the design; the ELFv2-specific
+// parts are:
+//
+//  * The LINKAGE AREA. ELFv2 gives the CALLEE the right to write 16(r1) and
+//    24(r1) of its caller's frame (the LR and TOC save slots). JIT code does
+//    not reserve that area (jsc-ppc64le-port.md section 5.3: every C call
+//    carries its own), so this trampoline reserves 32 bytes at the bottom of
+//    its own frame and keeps the invariant r27 == r1 + LINKAGE_AREA_SIZE
+//    everywhere it makes a call.
+//
+//  * The BACK CHAIN. 0(r1) is stored with the previous r1 so the frame chain
+//    a debugger walks stays intact. Note this is the ORDINARY back chain, not
+//    the cfr-in-the-back-chain trick emitCCallLinkageAreaSetup() plays for
+//    JIT operations: executeJSCJITProbe() is a plain extern "C" function and
+//    does not use DECLARE_CALL_FRAME.
+//
+//  * r2 / the TOC. Generated code keeps r2 = the process TOC invariant, so it
+//    is already correct on entry here. It is saved to 24(r1) and reloaded
+//    around each outgoing call, which is correct whatever the linker does
+//    with the call site, and the symbol is marked `.localentry ..., 1`
+//    ("single entry, does not set up r2, preserves r2") exactly as the LLInt
+//    entry points and WTF::currentStackPointer() are.
+//
+//  * LR and CTR are SPRs, not GPRs. The probe site must spill LR (the call to
+//    this trampoline overwrites it) and CTR (the mtctr/bctrl call sequence
+//    overwrites it) before making the call, because by the time the
+//    trampoline runs both are already gone.
+//
+//  * CR and XER need no spill at the site. Nothing between the probe site and
+//    the first instruction of this trampoline writes either: the site emits
+//    only addi/std/mflr/mfctr/the li-ladder/mtctr/bctrl, and none of those is
+//    a record form or a carry/overflow form. They are captured here instead.
+//
+//  * Returning. PowerPC has TWO indirect branch registers, so unlike ARM64 --
+//    which must choose between honouring a modified lr and a modified pc --
+//    this implementation resumes through CTR (bctr) while loading LR from the
+//    state, and therefore supports a probe that changes BOTH lr and pc in one
+//    invocation. The cost is the mirror image: cpu.spr(ctr) is captured for
+//    inspection but is NOT restored, because CTR is the register the return
+//    branch itself uses. CTR is volatile in ELFv2 and is live only inside a
+//    call sequence, so nothing in JSC observes it across a probe.
+//
+//  * The FPRs are saved with stfd and reloaded with lfd, which move all 64
+//    bits without conversion. That is the whole of the floating-point state
+//    this port's CPUState models: under the raw-bits f32 model
+//    (jsc-ppc64le-yarr-wasm.md section 7) an f32 in an FPR is its 32-bit
+//    single pattern in the low word of doubleword 0 and "the other 96 bits of
+//    the VSR are don't-care", so doubleword 0 is exactly the observable
+//    state. VSR high halves, VMX v32-v63 and FPSCR are not modelled by
+//    Probe::CPUState on this target and are not saved.
+// ===================================================================
+
+#define PTR_SIZE 8
+#define GPREG_SIZE 8
+#define FPREG_SIZE 8
+
+#define PROBE_PROBE_FUNCTION_OFFSET (0 * PTR_SIZE)
+#define PROBE_ARG_OFFSET (1 * PTR_SIZE)
+#define PROBE_INITIALIZE_STACK_FUNCTION_OFFSET (2 * PTR_SIZE)
+#define PROBE_INITIALIZE_STACK_ARG_OFFSET (3 * PTR_SIZE)
+#define PROBE_CONTEXT_STATE_SIZE (4 * PTR_SIZE)
+
+#define PROBE_FIRST_GPREG_OFFSET PROBE_CONTEXT_STATE_SIZE
+#define PROBE_CPU_R0_OFFSET (PROBE_FIRST_GPREG_OFFSET + (0 * GPREG_SIZE))
+#define PROBE_CPU_R1_OFFSET (PROBE_FIRST_GPREG_OFFSET + (1 * GPREG_SIZE))
+#define PROBE_CPU_R2_OFFSET (PROBE_FIRST_GPREG_OFFSET + (2 * GPREG_SIZE))
+#define PROBE_CPU_R3_OFFSET (PROBE_FIRST_GPREG_OFFSET + (3 * GPREG_SIZE))

+
+// A 64-bit little-endian PowerPC (ELFv2) instruction encoder.
+//
+// Every field packer below states the big-endian bit numbering the Power ISA
+// uses, because the ISA book numbers bits from the most significant end and
+// the shifts here are from the least significant end. `bit BE n` is
+// `1u << (31 - n)`.
+//
+// The encodings are re-derived from Power ISA v3.0B, Book I, and checked
+// against the assemblers rather than against the author's memory. The
+// encoding oracle lives in the handbook repository
+// (tools/ppc64-encoding-oracle/): it lifts the form packers and instruction
+// emitters below verbatim into a standalone harness, emits every instruction
+// with distinctive operands, assembles the same mnemonics with clang's
+// integrated assembler and with GNU as, and diffs the words. As of
+// 2026-09-11 that is 223/223 identical against both, and a one-bit change to
+// an extended opcode is caught (negative control run). A form packer that is
+// wrong is a silent miscompile that no MacroAssembler unit test would
+// localise, so the oracle, not the reading, is the evidence.
+
+namespace JSC {
+
+namespace PPC64Registers {
+
+enum RegisterID : int8_t {
+#define REGISTER_ID(id, name, r, cs) id,
+    FOR_EACH_GP_REGISTER(REGISTER_ID)
+#undef REGISTER_ID
+
+#define REGISTER_ALIAS(id, name, alias) id = alias,
+    FOR_EACH_REGISTER_ALIAS(REGISTER_ALIAS)
+#undef REGISTER_ALIAS
+
+    InvalidGPRReg = -1,
+};
+
+enum SPRegisterID : int8_t {
+#define REGISTER_ID(id, name) id,
+    FOR_EACH_SP_REGISTER(REGISTER_ID)
+#undef REGISTER_ID
+
+    InvalidSPReg = -1,
+};
+
+enum FPRegisterID : int8_t {
+#define REGISTER_ID(id, name, r, cs) id,
+    FOR_EACH_FP_REGISTER(REGISTER_ID)
+#undef REGISTER_ID
+
+    InvalidFPRReg = -1,
+};
+
+// ---------------------------------------------------------------------
+// VMX / Altivec register numbers, and why they are a separate type.
+//
+// POWER has two overlapping views of one 64-register file. VSX instructions
+// carry 6-bit fields naming all 64 VSRs; VMX instructions carry 5-bit fields
+// naming vr0-vr31, and vr(n) IS VSR(32+n). The same field VALUE therefore
+// means a different physical register depending on which encoding space the
+// instruction belongs to -- `vspltb 8,9,7` is v8 and v9, while
+// `xxlor 40,41,42` is the same two registers under their VSR names.
+//
+// FPRegisterID is a VSR number. VRegisterID is a VMX number. They are
+// deliberately distinct types so that passing one where the other is wanted
+// does not compile, because the failure mode if it did would be a silently
+// wrong register rather than a diagnostic.
+enum VRegisterID : uint8_t {
+    vr0 = 0, vr1, vr2, vr3, vr4, vr5, vr6, vr7,
+    vr8, vr9, vr10, vr11, vr12, vr13, vr14, vr15,
+    vr16, vr17, vr18, vr19, vr20, vr21, vr22, vr23,
+    vr24, vr25, vr26, vr27, vr28, vr29, vr30, vr31,
+};
+
+// The one legitimate crossing between the two spaces.
+static constexpr FPRegisterID vsrForVR(VRegisterID vr)
+{
+    return static_cast<FPRegisterID>(32 + static_cast<unsigned>(vr));
+}
+
+} // namespace PPC64Registers
+
+// Condition-register field and bit. cr0 is the working field for integer
+// compares; cr7 is where composed floating-point conditions land (a cror
+// must not write the field it reads, and cr1-cr4 are either callee-saved or
+// the FP-status field).
+enum class CRField : uint8_t { CR0 = 0, CR1, CR2, CR3, CR4, CR5, CR6, CR7 };
+enum class CRBit : uint8_t { LT = 0, GT = 1, EQ = 2, SO = 3 };
+
+constexpr unsigned crBitIndex(CRField field, CRBit bit)
+{
+    return unsigned(field) * 4 + unsigned(bit);
+}
+
+// Special-purpose register numbers used by the encoder.
+enum class SPRNumber : uint32_t { XER = 1, LR = 8, CTR = 9 };
+
+class PPC64Assembler {
+public:
+    using RegisterID = PPC64Registers::RegisterID;
+    using SPRegisterID = PPC64Registers::SPRegisterID;
+    using FPRegisterID = PPC64Registers::FPRegisterID;
+    // A VMX register number, distinct from FPRegisterID's VSR number: vr(n)
+    // IS VSR(32+n), so the same value names a different register in each space.
+    using VRegisterID = PPC64Registers::VRegisterID;
+
+    static constexpr RegisterID firstRegister() { return PPC64Registers::r0; }
+    static constexpr RegisterID lastRegister() { return PPC64Registers::r31; }
+    static constexpr unsigned numberOfRegisters() { return lastRegister() - firstRegister() + 1; }
+
+    static constexpr SPRegisterID firstSPRegister() { return PPC64Registers::pc; }
+    static constexpr SPRegisterID lastSPRegister() { return PPC64Registers::xer; }
+    static constexpr unsigned numberOfSPRegisters() { return lastSPRegister() - firstSPRegister() + 1; }
+
+    static constexpr FPRegisterID firstFPRegister() { return PPC64Registers::f0; }
+    static constexpr FPRegisterID lastFPRegister() { return PPC64Registers::f31; }
+    static constexpr unsigned numberOfFPRegisters() { return lastFPRegister() - firstFPRegister() + 1; }
+
+    static ASCIILiteral gprName(RegisterID id)
+    {
+        ASSERT(id >= firstRegister() && id <= lastRegister());
+        static constexpr ASCIILiteral nameForRegister[numberOfRegisters()] = {
+#define REGISTER_NAME(id, name, r, cs) name,
+            FOR_EACH_GP_REGISTER(REGISTER_NAME)
+#undef REGISTER_NAME
+        };
+        return nameForRegister[id];
+    }
+
+    static ASCIILiteral sprName(SPRegisterID id)
+    {
+        ASSERT(id >= firstSPRegister() && id <= lastSPRegister());
+        static constexpr ASCIILiteral nameForRegister[numberOfSPRegisters()] = {
+#define REGISTER_NAME(id, name) name,
+            FOR_EACH_SP_REGISTER(REGISTER_NAME)
+#undef REGISTER_NAME
+        };
+        return nameForRegister[id];
+    }
+
+    static ASCIILiteral fprName(FPRegisterID id)
+    {
+        ASSERT(id >= firstFPRegister() && id <= lastFPRegister());
+        static constexpr ASCIILiteral nameForRegister[numberOfFPRegisters()] = {
+#define REGISTER_NAME(id, name, r, cs) name,
+            FOR_EACH_FP_REGISTER(REGISTER_NAME)
+#undef REGISTER_NAME
+        };
+        return nameForRegister[id];
+    }
+
+    PPC64Assembler() { }
+
+    AssemblerBuffer& buffer() LIFETIME_BOUND { return m_buffer; }
+
+    // ------------------------------------------------------------------
+    // Immediate predicates. PowerPC's D-form displacement is a signed 16-bit
+    // field; DS-form (ld/ldu/lwa/std/stdu) drops the low two bits, so its
+    // displacement must additionally be a multiple of 4. Logical immediates
+    // (andi./ori/xori and their "is" forms) are UNSIGNED 16-bit -- a negative
+    // value must go through a register. Getting these two families confused
+    // is the single easiest way to emit a silently wrong instruction, so the
+    // predicates are named for the form, not for the width.
+    // ------------------------------------------------------------------
+
+    static constexpr bool isValidSigned16(int64_t value)
+    {
+        return value >= -0x8000 && value <= 0x7fff;
+    }
+
+    static constexpr bool isValidUnsigned16(int64_t value)
+    {
+        return value >= 0 && value <= 0xffff;
+    }
+
+    static constexpr bool isValidDForm(int64_t offset)
+    {
+        return isValidSigned16(offset);
+    }
+
+    static constexpr bool isValidDSForm(int64_t offset)
+    {
+        return isValidSigned16(offset) && !(offset & 3);
+    }
+
+    static constexpr bool isValidSigned32(int64_t value)
+    {
+        return value >= INT64_C(-0x80000000) && value <= INT64_C(0x7fffffff);
+    }
+
+    // A value that `lis`+`ori` (or a bare addi/lis) can materialise without
+    // the full five-instruction ladder.
+    static constexpr bool isValidLoadImmediateShort(int64_t value)
+    {
+        if (isValidSigned16(value))
+            return true;
+        if (isValidSigned32(value) && !(value & 0xffff))
+            return true;
+        return false;
+    }
+
+    // ------------------------------------------------------------------
+    // Form packers. Power ISA v3.0B Book I chapter 1.6.
+    // ------------------------------------------------------------------
+
+    // I-form: OPCD(0:5) LI(6:29) AA(30) LK(31)
+    static uint32_t formI(uint32_t opcd, int32_t li, bool aa, bool lk)
+    {
+        ASSERT(!(li & 3));
+        ASSERT(li >= -0x2000000 && li <= 0x1fffffc);
+        return (opcd << 26) | (uint32_t(li) & 0x03fffffc) | (uint32_t(aa) << 1) | uint32_t(lk);
+    }
+
+    // B-form: OPCD(0:5) BO(6:10) BI(11:15) BD(16:29) AA(30) LK(31)
+    static uint32_t formB(uint32_t opcd, uint32_t bo, uint32_t bi, int32_t bd, bool aa, bool lk)
+    {
+        ASSERT(!(bd & 3));
+        ASSERT(bd >= -0x8000 && bd <= 0x7ffc);
+        ASSERT(bo < 32 && bi < 32);
+        return (opcd << 26) | (bo << 21) | (bi << 16) | (uint32_t(bd) & 0xfffc) | (uint32_t(aa) << 1) | uint32_t(lk);
+    }
+
+    // D-form: OPCD(0:5) RT(6:10) RA(11:15) D(16:31)
+    static uint32_t formD(uint32_t opcd, uint32_t rt, uint32_t ra, int32_t d)
+    {
+        ASSERT(rt < 32 && ra < 32);
+        return (opcd << 26) | (rt << 21) | (ra << 16) | (uint32_t(d) & 0xffff);
+    }
+
+    // DS-form: OPCD(0:5) RT(6:10) RA(11:15) DS(16:29) XO(30:31)
+    static uint32_t formDS(uint32_t opcd, uint32_t rt, uint32_t ra, int32_t ds, uint32_t xo)
+    {
+        ASSERT(rt < 32 && ra < 32 && xo < 4);
+        ASSERT(!(ds & 3));
+        return (opcd << 26) | (rt << 21) | (ra << 16) | (uint32_t(ds) & 0xfffc) | xo;
+    }
+
+    // X-form: OPCD(0:5) RT(6:10) RA(11:15) RB(16:20) XO(21:30) Rc(31)
+    static uint32_t formX(uint32_t opcd, uint32_t rt, uint32_t ra, uint32_t rb, uint32_t xo, bool rc)
+    {
+        ASSERT(rt < 32 && ra < 32 && rb < 32 && xo < 1024);
+        return (opcd << 26) | (rt << 21) | (ra << 16) | (rb << 11) | (xo << 1) | uint32_t(rc);
+    }
+
+    // XO-form: OPCD(0:5) RT(6:10) RA(11:15) RB(16:20) OE(21) XO(22:30) Rc(31)
+    static uint32_t formXO(uint32_t opcd, uint32_t rt, uint32_t ra, uint32_t rb, bool oe, uint32_t xo, bool rc)
+    {
+        ASSERT(rt < 32 && ra < 32 && rb < 32 && xo < 512);
+        return (opcd << 26) | (rt << 21) | (ra << 16) | (rb << 11) | (uint32_t(oe) << 10) | (xo << 1) | uint32_t(rc);
+    }
+
+    // XL-form: OPCD(0:5) BT(6:10) BA(11:15) BB(16:20) XO(21:30) LK(31)
+    static uint32_t formXL(uint32_t opcd, uint32_t bt, uint32_t ba, uint32_t bb, uint32_t xo, bool lk)
+    {
+        ASSERT(bt < 32 && ba < 32 && bb < 32 && xo < 1024);
+        return (opcd << 26) | (bt << 21) | (ba << 16) | (bb << 11) | (xo << 1) | uint32_t(lk);
+    }
+
+    // XFX-form for mfspr/mtspr: the 10-bit SPR field is stored with its two
+    // 5-bit halves SWAPPED (spr(5:9) then spr(0:4)). Power ISA v3.0B says
+    // "the order of the two 5-bit halves of the SPR number is reversed".
+    static uint32_t formXFXSPR(uint32_t opcd, uint32_t rst, uint32_t spr, uint32_t xo)
+    {
+        ASSERT(rst < 32 && spr < 1024);
+        uint32_t encoded = ((spr & 0x1f) << 5) | ((spr >> 5) & 0x1f);
+        return (opcd << 26) | (rst << 21) | (encoded << 11) | (xo << 1);
+    }
+
+    // XFX-form for mfocrf/mtocrf: FXM(12:19) with bit 11 set to 1.
+    static uint32_t formXFXCR(uint32_t opcd, uint32_t rst, uint32_t fxm, bool oneBit, uint32_t xo)
+    {
+        ASSERT(rst < 32 && fxm < 256);
+        return (opcd << 26) | (rst << 21) | (uint32_t(oneBit) << 20) | (fxm << 12) | (xo << 1);
+    }
+
+    // M-form: OPCD(0:5) RS(6:10) RA(11:15) RB/SH(16:20) MB(21:25) ME(26:30) Rc(31)
+    static uint32_t formM(uint32_t opcd, uint32_t rs, uint32_t ra, uint32_t shb, uint32_t mb, uint32_t me, bool rc)
+    {
+        RELEASE_ASSERT(shb < 32 && mb < 32 && me < 32);
+        return (opcd << 26) | (rs << 21) | (ra << 16) | (shb << 11) | (mb << 6) | (me << 1) | uint32_t(rc);
+    }
+
+    // MD-form: OPCD(0:5) RS(6:10) RA(11:15) sh(16:20) mb(21:26) XO(27:29) sh[5](30) Rc(31)
+    // Both the 6-bit shift and the 6-bit mask boundary are split, high bit
+    // last. This is the form of rldicl/rldicr/rldic/rldimi.
+    static uint32_t formMD(uint32_t rs, uint32_t ra, uint32_t sh, uint32_t mbme, uint32_t xo, bool rc)
+    {
+        RELEASE_ASSERT(sh < 64 && mbme < 64 && xo < 8);
+        uint32_t shLow = sh & 0x1f;
+        uint32_t shHigh = (sh >> 5) & 1;
+        uint32_t mLow = mbme & 0x1f;
+        uint32_t mHigh = (mbme >> 5) & 1;
+        return (30u << 26) | (rs << 21) | (ra << 16) | (shLow << 11) | (mLow << 6) | (mHigh << 5) | (xo << 2) | (shHigh << 1) | uint32_t(rc);
+    }
+
+    // MDS-form: OPCD(0:5) RS(6:10) RA(11:15) RB(16:20) mb(21:26) XO(27:30) Rc(31)
+    static uint32_t formMDS(uint32_t rs, uint32_t ra, uint32_t rb, uint32_t mbme, uint32_t xo, bool rc)
+    {
+        RELEASE_ASSERT(mbme < 64 && xo < 16);
+        uint32_t mLow = mbme & 0x1f;
+        uint32_t mHigh = (mbme >> 5) & 1;
+        return (30u << 26) | (rs << 21) | (ra << 16) | (rb << 11) | (mLow << 6) | (mHigh << 5) | (xo << 1) | uint32_t(rc);
+    }
+
+    // XS-form (sradi only): OPCD RS RA sh(16:20) XO(21:29) sh[5](30) Rc(31)
+    static uint32_t formXS(uint32_t rs, uint32_t ra, uint32_t sh, uint32_t xo, bool rc)
+    {
+        RELEASE_ASSERT(sh < 64);
+        uint32_t shLow = sh & 0x1f;
+        uint32_t shHigh = (sh >> 5) & 1;
+        return (31u << 26) | (rs << 21) | (ra << 16) | (shLow << 11) | (xo << 2) | (shHigh << 1) | uint32_t(rc);
+    }
+
+    // A-form (floating point): OPCD FRT FRA FRB FRC XO(26:30) Rc(31)
+    static uint32_t formA(uint32_t opcd, uint32_t frt, uint32_t fra, uint32_t frb, uint32_t frc, uint32_t xo, bool rc)
+    {
+        ASSERT(xo < 32);
+        return (opcd << 26) | (frt << 21) | (fra << 16) | (frb << 11) | (frc << 6) | (xo << 1) | uint32_t(rc);
+    }
+
+    // XX2-form (VSX, one source): OPCD T(6:10) reserved(11:15) B(16:20) XO(21:29) BX(30) TX(31)
+    static uint32_t formXX2(uint32_t opcd, uint32_t t, uint32_t b, uint32_t xo)
+    {
+        uint32_t tx = (t >> 5) & 1;
+        uint32_t bx = (b >> 5) & 1;
+        return (opcd << 26) | ((t & 0x1f) << 21) | ((b & 0x1f) << 11) | (xo << 2) | (bx << 1) | tx;
+    }
+
+    // XX2-form with a 5-bit sub-opcode in the reserved field: OPCD T(6:10)
+    // SUB(11:15) B(16:20) XO(21:29) BX(30) TX(31). The half-precision
+    // conversions are one XO (347) split by that field -- 16 is xscvhpdp,
+    // 17 is xscvdphp -- which is why formXX2, whose 11:15 is always zero,
+    // cannot express them.
+    static uint32_t formXX2Sub(uint32_t opcd, uint32_t t, uint32_t sub, uint32_t b, uint32_t xo)
+    {
+        ASSERT(sub < 32);
+        uint32_t tx = (t >> 5) & 1;
+        uint32_t bx = (b >> 5) & 1;
+        return (opcd << 26) | ((t & 0x1f) << 21) | (sub << 16) | ((b & 0x1f) << 11) | (xo << 2) | (bx << 1) | tx;
+    }
+
+    // XX3-form (VSX, two sources): OPCD T A B XO(22:28) AX(29) BX(30) TX(31)
+    static uint32_t formXX3(uint32_t opcd, uint32_t t, uint32_t a, uint32_t b, uint32_t xo)
+    {
+        uint32_t tx = (t >> 5) & 1;
+        uint32_t ax = (a >> 5) & 1;
+        uint32_t bx = (b >> 5) & 1;
+        return (opcd << 26) | ((t & 0x1f) << 21) | ((a & 0x1f) << 16) | ((b & 0x1f) << 11) | (xo << 3) | (ax << 2) | (bx << 1) | tx;
+    }
+
+    // XX2-form with a 2-bit UIM (xxspltw only): OPCD T(6:10) /(11:13)
+    // UIM(14:15) B(16:20) XO(21:29) BX(30) TX(31)
+    static uint32_t formXX2UIM(uint32_t opcd, uint32_t t, uint32_t uim, uint32_t b, uint32_t xo)
+    {
+        RELEASE_ASSERT(uim < 4);
+        uint32_t tx = (t >> 5) & 1;
+        uint32_t bx = (b >> 5) & 1;
+        return (opcd << 26) | ((t & 0x1f) << 21) | (uim << 16) | ((b & 0x1f) << 11) | (xo << 2) | (bx << 1) | tx;
+    }
+
+    // XX1-form (indexed VSX load/store): OPCD T(6:10) RA(11:15) RB(16:20)
+    // XO(21:30) TX(31). There is no displacement: EA = (RA|0) + RB.
+    static uint32_t formXX1(uint32_t opcd, uint32_t t, uint32_t ra, uint32_t rb, uint32_t xo)
+    {
+        uint32_t tx = (t >> 5) & 1;
+        return (opcd << 26) | ((t & 0x1f) << 21) | (ra << 16) | (rb << 11) | (xo << 1) | tx;
+    }
+
+    // X-form with a VSR destination or source (mtvsrd / mfvsrd family): the
+    // VSR number's high bit is the last bit of the instruction.
+    static uint32_t formXVSRGPR(uint32_t vsr, uint32_t ra, uint32_t xo)
+    {
+        uint32_t x = (vsr >> 5) & 1;
+        return (31u << 26) | ((vsr & 0x1f) << 21) | (ra << 16) | (xo << 1) | x;
+    }
+
+    // ------------------------------------------------------------------
+    // Instruction emitters
+    // ------------------------------------------------------------------
+
+    void insn(uint32_t instruction) { m_buffer.putInt(instruction); }
+
+    // --- fixed-point arithmetic -------------------------------------------
+    void addi(RegisterID rt, RegisterID ra, int32_t si) { insn(formD(14, rt, ra, si)); }
+    void addis(RegisterID rt, RegisterID ra, int32_t si) { insn(formD(15, rt, ra, si)); }
+    void addic(RegisterID rt, RegisterID ra, int32_t si) { insn(formD(12, rt, ra, si)); }
+    void addic_(RegisterID rt, RegisterID ra, int32_t si) { insn(formD(13, rt, ra, si)); }
+    void subfic(RegisterID rt, RegisterID ra, int32_t si) { insn(formD(8, rt, ra, si)); }
+    void mulli(RegisterID rt, RegisterID ra, int32_t si) { insn(formD(7, rt, ra, si)); }
+
+    // `li rt, si` and `lis rt, si` are addi/addis with RA=0, where RA=0 means
+    // the literal zero rather than r0.
+    void li(RegisterID rt, int32_t si) { insn(formD(14, rt, 0, si)); }
+    void lis(RegisterID rt, int32_t si) { insn(formD(15, rt, 0, si)); }
+
+    void add(RegisterID rt, RegisterID ra, RegisterID rb) { insn(formXO(31, rt, ra, rb, false, 266, false)); }
+    void add_(RegisterID rt, RegisterID ra, RegisterID rb) { insn(formXO(31, rt, ra, rb, false, 266, true)); }
+    void addo(RegisterID rt, RegisterID ra, RegisterID rb) { insn(formXO(31, rt, ra, rb, true, 266, false)); }
+    void addc(RegisterID rt, RegisterID ra, RegisterID rb) { insn(formXO(31, rt, ra, rb, false, 10, false)); }
+    void adde(RegisterID rt, RegisterID ra, RegisterID rb) { insn(formXO(31, rt, ra, rb, false, 138, false)); }
+    void addze(RegisterID rt, RegisterID ra) { insn(formXO(31, rt, ra, 0, false, 202, false)); }

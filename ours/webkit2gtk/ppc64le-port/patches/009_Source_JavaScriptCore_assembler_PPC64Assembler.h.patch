+    // The condition is baked into word 0 at EMISSION time and is never
+    // rewritten, so one link routine serves both conditional and
+    // unconditional sites: it only ever rewrites word 1. That is what makes
+    // Jump::link() -- which does not know whether the site it is linking was
+    // conditional -- correct here without having to recover the condition by
+    // disassembling the site, the way RISCV64Assembler::LinkBranchImpl has to.
+    //
+    // Two words is enough even though the executable pool can be larger than
+    // `b` reaches. `b` covers +-32 MiB (nearJumpRange), and JSTests asks for
+    // pools well past that by name (--jitMemoryReservationSize=268435456), so
+    // ENABLE(JUMP_ISLANDS) is on for this target: when a link or relink finds
+    // its target out of reach, writeJumpSite() retargets the branch at an
+    // ISLAND -- a single `b` allocated in the island region of the
+    // neighbouring RegionAllocator -- and islands chain to span any distance.
+    // The branch word itself stays one word wide, which is what keeps the
+    // site two words and keeps relinking a single aligned store.
+    //
+    // An island needs nothing from ELFv2: it is a plain branch, so no linkage
+    // area, no r12 entry-point register and no TOC save. It cannot disturb
+    // r2, and the conditional guard in word 0 is untouched by any of this.
+    // jsc-ppc64le-port.md section 16 records the design.
+    //
+    // Calls whose target is NOT in the pool -- i.e. calls to C++ -- do not use
+    // this site at all. They use the seven-word pointer-call site below, whose
+    // first five words are the 64-bit constant ladder that linkPointer() and
+    // repatchPointer() rewrite, followed by `mtctr r12 ; bctrl`. r12 is the
+    // ELFv2 indirect-call target register, which is exactly what the callee's
+    // global entry point expects.
+    // ------------------------------------------------------------------
+
+    static constexpr unsigned jumpSiteWords = 2;
+    static constexpr ptrdiff_t jumpSizeInBytes = jumpSiteWords * sizeof(uint32_t);
+
+    // The seven-word site used only by call(PtrTag), where the target is a
+    // C++ function outside the executable pool.
+    static constexpr unsigned pointerCallSiteWords = fixedLoadImmediate64Size + 2;
+
+    static constexpr ptrdiff_t maxJumpReplacementSize() { return jumpSizeInBytes; }
+    static constexpr ptrdiff_t patchableJumpSize() { return jumpSizeInBytes; }
+
+    static constexpr bool isValidNearBranchOffset(int64_t offset)
+    {
+        return !(offset & 3) && offset >= INT64_C(-0x2000000) && offset <= INT64_C(0x1fffffc);
+    }
+
+    // Can a single `b` at `from` reach `to`? `from` is the address of the
+    // BRANCH WORD, not of the two-word site, because that is what the
+    // displacement is measured from. ExecutableAllocator uses this to decide
+    // whether one more island is needed to continue a chain.
+    static ALWAYS_INLINE bool canEmitJump(void* from, void* to)
+    {
+        return isValidNearBranchOffset(reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(from));
+    }
+
+    // Write the body of an island: one unconditional branch, nothing else.
+    // islandSizeInBytes in ExecutableAllocator.cpp is 4 for this target and
+    // this is the function that has to agree with it.
+    template<RepatchingInfo repatch>
+    static void fillNearTailCall(void* from, void* to)
+    {
+        static_assert((*repatch).contains(RepatchingFlag::Flush));
+        uint32_t* location = static_cast<uint32_t*>(from);
+        RELEASE_ASSERT(roundUpToMultipleOf<sizeof(uint32_t)>(location) == location);
+        intptr_t offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(location);
+        RELEASE_ASSERT(isValidNearBranchOffset(offset));
+        uint32_t branch = formI(18, int32_t(offset), false, false);
+        machineCodeCopy<noFlush(repatch)>(location, &branch, sizeof(uint32_t));
+        cacheFlush(location, sizeof(uint32_t));
+    }
+
+    static void* getRelocatedAddress(void* code, AssemblerLabel label)
+    {
+        ASSERT(label.isSet());
+        return reinterpret_cast<void*>(reinterpret_cast<ptrdiff_t>(code) + label.offset());
+    }
+
+    static int getDifferenceBetweenLabels(AssemblerLabel a, AssemblerLabel b)
+    {
+        return b.offset() - a.offset();
+    }
+
+    size_t codeSize() const { return m_buffer.codeSize(); }
+
+    static unsigned getCallReturnOffset(AssemblerLabel call)
+    {
+        ASSERT(call.isSet());
+        return call.offset();
+    }
+
+    AssemblerLabel labelIgnoringWatchpoints() { return m_buffer.label(); }
+
+    AssemblerLabel labelForWatchpoint()
+    {
+        AssemblerLabel result = m_buffer.label();
+        if (static_cast<int>(result.offset()) != m_indexOfLastWatchpoint)
+            result = label();
+        m_indexOfLastWatchpoint = result.offset();
+        m_indexOfTailOfLastWatchpoint = result.offset() + maxJumpReplacementSize();
+        return result;
+    }
+
+    AssemblerLabel label()
+    {
+        AssemblerLabel result = m_buffer.label();
+        while (static_cast<int>(result.offset()) < m_indexOfTailOfLastWatchpoint) [[unlikely]] {
+            nop();
+            result = m_buffer.label();
+        }
+        return result;
+    }
+
+    unsigned debugOffset() { return m_buffer.debugOffset(); }
+
+    // The placeholder word is `ori r0, r0, tag`: a nop with a tag in its
+    // immediate field, so an unlinked site is recognisable and a site that is
+    // executed unlinked does nothing rather than branching somewhere random.
+    enum class PlaceholderTag : uint32_t { Jump = 1, Call = 2, TailCall = 3, Branch = 4, Pointer = 5 };
+
+    static uint32_t placeholderInsn(PlaceholderTag tag)
+    {
+        return formD(24, 0, 0, int32_t(uint32_t(tag)));
+    }
+
+    // The placeholder for a five-word constant ladder, which unlike the other
+    // placeholders has to remember which register the ladder will target:
+    // linkPointer() reads it back out of RT. `ori rd, rd, tag` keeps the tag
+    // in the immediate field, so an unlinked site is still recognisable, and
+    // keeps the instruction harmless if it is ever executed unlinked.
+    static uint32_t pointerPlaceholderInsn(RegisterID rd)
+    {
+        return formD(24, rd, rd, int32_t(uint32_t(PlaceholderTag::Pointer)));
+    }
+
+    static constexpr uint32_t nopInsn() { return formD(24, 0, 0, 0); }
+
+    // Emit the guard word of a two-word site. `guard` is either a nop (for an
+    // unconditional jump or a call) or an already-encoded `bc !cond, +8`.
+    // The caller then emits the branch word through one of the helpers below.
+    void emitJumpSiteGuard(uint32_t guard) { insn(guard); }
+
+    // The unlinked branch word. It is a self-branch (`b .`), NOT a nop: a site
+    // that is somehow executed before being linked then hangs at a single
+    // known address instead of falling through into whatever follows, which
+    // would be an arbitrary wrong execution. Linking always overwrites it.
+    static constexpr uint32_t unlinkedBranchInsn(bool link)
+    {
+        return formI(18, 0, false, link);
+    }
+
+    // A conditional guard: branch AROUND the following `b` when the condition
+    // is FALSE, i.e. invert the caller's condition. `bo`/`bi` must already be
+    // the inverted test.
+    static uint32_t conditionalGuardInsn(uint32_t bo, unsigned bi)
+    {
+        return formB(16, bo, bi, 8, false, false); // skip the next word
+    }
+
+    template<typename F>
+    void jumpPlaceholder(const F& functor)
+    {
+        insn(nopInsn());
+        functor();
+    }
+
+    template<typename F>
+    void branchPlaceholder(const F& functor)
+    {
+        // The functor emits BOTH words of a conditional site: the guard and
+        // the branch. Unlike RISCV64's, this placeholder adds nothing of its
+        // own, because the condition has to be in the guard from the start.
+        functor();
+    }
+
+    template<typename F>
+    void nearCallPlaceholder(const F& functor)
+    {
+        insn(nopInsn());
+        functor();
+    }
+
+    // ---- the two-word jump/branch site ----
+
+    // Rewrite word 1 of a two-word site so it branches to `target`. Word 0 --
+    // the condition guard -- is deliberately left alone.
+    template<RepatchingInfo repatch = jitMemcpyRepatchFlush>
+    static void writeJumpSite(uint32_t* location, void* target, bool link)
+    {
+        uint32_t* branchWord = &location[jumpSiteWords - 1];
+#if ENABLE(JUMP_ISLANDS)
+        // Out of `b` range: go via an island instead. The Memcpy flag selects
+        // which writer the island body is published with, exactly as on
+        // ARM64 -- this path is taken at link time (JIT memcpy) and at
+        // repatch time (either), and the two must not be confused under a
+        // configuration that write-protects JIT memory.
+        if (!canEmitJump(branchWord, target)) [[unlikely]] {
+            if constexpr ((*repatch).contains(RepatchingFlag::Memcpy))
+                target = ExecutableAllocator::singleton().getJumpIslandToUsingMemcpy(branchWord, target);
+            else
+                target = ExecutableAllocator::singleton().getJumpIslandToUsingJITMemcpy(branchWord, target);
+        }
+#endif
+        intptr_t offset = reinterpret_cast<intptr_t>(target) - reinterpret_cast<intptr_t>(branchWord);
+        // Not an ASSERT: out of range here is a silently truncated branch to
+        // the wrong address. With islands enabled the hook above has already
+        // brought the target into range, so this firing means the island
+        // machinery itself handed back something unreachable.
+        RELEASE_ASSERT(isValidNearBranchOffset(offset));
+        *branchWord = formI(18, int32_t(offset), false, link);
+    }
+
+    static void* readJumpSite(const uint32_t* location)
+    {
+        uint32_t last = location[jumpSiteWords - 1];
+        RELEASE_ASSERT((last >> 26) == 18);
+        int32_t field = int32_t(last & 0x03fffffc);
+        if (field & 0x02000000)
+            field |= int32_t(0xfc000000);
+        return reinterpret_cast<void*>(reinterpret_cast<intptr_t>(&location[jumpSiteWords - 1]) + field);
+    }
+
+    static void linkJump(void* code, AssemblerLabel from, void* to)
+    {
+        ASSERT(from.isSet());
+        if (!from.isSet())
+            return;
+        uint32_t* location = reinterpret_cast<uint32_t*>(reinterpret_cast<uintptr_t>(code) + from.offset());
+        writeJumpSite(location, to, false);
+    }
+
+    void linkJump(AssemblerLabel from, AssemblerLabel to)
+    {
+        RELEASE_ASSERT(from.isSet() && to.isSet());
+        if (!from.isSet() || !to.isSet())
+            return;
+        void* target = reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(m_buffer.data()) + to.offset());
+        linkJump(m_buffer.data(), from, target);
+    }
+
+    static void linkCall(void* code, AssemblerLabel from, void* to)
+    {
+        uint32_t* location = reinterpret_cast<uint32_t*>(reinterpret_cast<uintptr_t>(code) + from.offset());
+        writeJumpSite(location, to, true);
+    }
+
+    // ---- the seven-word pointer-call site (calls out to C++) ----
+
+    void emitPointerCallSitePlaceholder()
+    {
+        for (unsigned i = 0; i < fixedLoadImmediate64Size; ++i)
+            insn(pointerPlaceholderInsn(PPC64Registers::r12));
+        mtctr(PPC64Registers::r12);
+        bctrl();
+    }
+
+    static void linkPointer(void* code, AssemblerLabel where, void* valuePtr)
+    {
+        uint32_t* location = reinterpret_cast<uint32_t*>(reinterpret_cast<uintptr_t>(code) + where.offset());
+        writeFixedLoadImmediate64(location, readFixedLoadImmediate64Register(location), reinterpret_cast<int64_t>(valuePtr));
+    }
+
+    static void* readPointer(void* where)
+    {
+        return reinterpret_cast<void*>(readFixedLoadImmediate64(static_cast<const uint32_t*>(where)));
+    }
+
+    static void repatchPointer(void* where, void* valuePtr)
+    {
+        uint32_t* location = static_cast<uint32_t*>(where);
+        writeFixedLoadImmediate64(location, readFixedLoadImmediate64Register(location), reinterpret_cast<int64_t>(valuePtr));
+        cacheFlush(location, sizeof(uint32_t) * fixedLoadImmediate64Size);
+    }
+
+    template<RepatchingInfo repatch = jitMemcpyRepatchFlush>
+    static void relinkJump(void* from, void* to)
+    {
+        writeJumpSite<repatch>(static_cast<uint32_t*>(from), to, false);
+        if constexpr ((*repatch).contains(RepatchingFlag::Flush))
+            flushJump(from);
+    }
+
+    template<RepatchingInfo repatch = jitMemcpyRepatchFlush>
+    static void relinkCall(void* from, void* to)
+    {
+        writeJumpSite<repatch>(static_cast<uint32_t*>(from), to, true);
+        if constexpr ((*repatch).contains(RepatchingFlag::Flush))
+            flushCall(from);
+    }
+
+    template<RepatchingInfo repatch = jitMemcpyRepatchFlush>
+    static void relinkTailCall(void* from, void* to)
+    {
+        relinkJump<repatch>(from, to);
+    }
+
+    static void flushJump(void* from) { cacheFlush(from, jumpSizeInBytes); }
+    static void flushCall(void* from) { cacheFlush(from, jumpSizeInBytes); }
+    static void flushTailCall(void* from) { flushJump(from); }
+
+#if ENABLE(JUMP_ISLANDS)
+    // Used by prepareForAtomicRepatchNearCallConcurrently(): resolve the
+    // destination NOW, so that the subsequent relink is a single store of an
+    // already-in-range branch and never has to allocate anything while
+    // another thread is executing the site.
+    //
+    // Unlike ARM64's pair, the jump and call forms are identical here. On
+    // ARM64 a near call's CodeLocation points PAST the branch, so the call
+    // form has to step back one instruction; on this port both nearCall() and
+    // nearTailCall() label the START of the two-word site, which is also what
+    // relinkCall() and relinkJump() are handed.
+    static void* prepareForAtomicRelinkJumpConcurrently(void* from, void* to)
+    {
+        uint32_t* branchWord = &static_cast<uint32_t*>(from)[jumpSiteWords - 1];
+        if (canEmitJump(branchWord, to))
+            return to;
+        return ExecutableAllocator::singleton().getJumpIslandToConcurrently(branchWord, to);
+    }
+
+    static void* prepareForAtomicRelinkCallConcurrently(void* from, void* to)
+    {
+        return prepareForAtomicRelinkJumpConcurrently(from, to);
+    }
+#endif
+
+    static void replaceWithVMHalt(void* where)
+    {
+        uint32_t* location = static_cast<uint32_t*>(where);
+        location[0] = trapInstruction;
+        cacheFlush(location, sizeof(uint32_t));
+    }
+
+    // Unlike writeJumpSite(), this one also clears the guard word: the site
+    // being replaced was not necessarily a jump site at all, so word 0 must
+    // be made unconditional rather than left as whatever was there.
+    static void replaceWithJump(void* from, void* to)
+    {
+        uint32_t* location = static_cast<uint32_t*>(from);
+        uint32_t* branchWord = &location[jumpSiteWords - 1];
+#if ENABLE(JUMP_ISLANDS)
+        if (!canEmitJump(branchWord, to)) [[unlikely]]
+            to = ExecutableAllocator::singleton().getJumpIslandToUsingJITMemcpy(branchWord, to);
+#endif
+        intptr_t offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(branchWord);
+        RELEASE_ASSERT(isValidNearBranchOffset(offset));
+        // Publish the branch word BEFORE the guard word. Until the guard is
+        // overwritten the site still does whatever it did before; once the
+        // guard becomes a nop the branch beneath it is already the correct
+        // one. The reverse order would expose a nop followed by a stale word.
+        uint32_t branch = formI(18, int32_t(offset), false, false);
+        machineCodeCopy<memcpyRepatch>(branchWord, &branch, sizeof(uint32_t));
+        cacheFlush(branchWord, sizeof(uint32_t));
+        uint32_t guard = nopInsn();
+        machineCodeCopy<memcpyRepatch>(&location[0], &guard, sizeof(uint32_t));
+        cacheFlush(location, jumpSizeInBytes);
+    }
+
+    static void replaceWithNops(void* from, size_t memoryToFillWithNopsInBytes)
+    {
+        fillNops(from, memoryToFillWithNopsInBytes);
+        cacheFlush(from, memoryToFillWithNopsInBytes);
+    }
+
+    // Unlike linkPointer/repatchPointer this one cannot read the destination
+    // register back out of the site: replaceWithJump has overwritten word 0
+    // with a branch. The register comes from the caller, which generic JSC
+    // code hands it.
+    static void revertJumpReplacementToPatch(void* from, RegisterID rd, void* valuePtr)
+    {
+        uint32_t* location = static_cast<uint32_t*>(from);
+        writeFixedLoadImmediate64(location, rd, reinterpret_cast<int64_t>(valuePtr));
+        cacheFlush(location, sizeof(uint32_t) * fixedLoadImmediate64Size);
+    }
+
+    // The counterpart of repatchPointer(): a CodeLocationCall produced by
+    // call(PtrTag) points at the five-word constant ladder, not at a branch.
+    static void* readCallTarget(void* from)
+    {
+        return reinterpret_cast<void*>(readFixedLoadImmediate64(static_cast<const uint32_t*>(from)));
+    }
+
+    static void fillNops(void* base, size_t size)
+    {
+        uint32_t* ptr = static_cast<uint32_t*>(base);
+        RELEASE_ASSERT(roundUpToMultipleOf<sizeof(uint32_t)>(ptr) == ptr);
+        RELEASE_ASSERT(!(size % sizeof(uint32_t)));
+
+        uint32_t nopInsn = formD(24, 0, 0, 0);
+        for (size_t i = 0, n = size / sizeof(uint32_t); i < n; ++i)
+            machineCodeCopy<memcpyRepatch>(&ptr[i], &nopInsn, sizeof(uint32_t));
+    }
+
+    // ------------------------------------------------------------------
+    // Instruction cache publication.
+    //
+    // __builtin___clear_cache() performs NO cache maintenance on ppc64le:
+    // gcc 16.1 expands it to nothing, and clang 22.1 lowers it to
+    // __clear_cache@GCC_3.0 in libgcc_s, which is a prologue and a blr.
+    // Measured on this box, 2026-08-13; the SpiderMonkey ppc64 port found the
+    // same. POWER's instruction cache is not coherent with the data cache, so
+    // the sequence from Power ISA Book II ("Synchronization Requirements for
+    // Instruction Storage") has to be written out by hand.
+    //
+    // The stride is the SMALLER of AT_DCACHEBSIZE and AT_ICACHEBSIZE: dcbst
+    // and icbi operate on blocks of their own cache and the two sizes are not
+    // architecturally required to match. A stride below the true block size
+    // is redundant work, never incorrect, so a missing or non-power-of-two
+    // auxv value falls back to 32.
+    //
+    // Residual and inherent: a thread already executing inside the modified
+    // range does not run the isync, so it can retire the old instruction.
+    // Callers that patch live code must keep both the old and the new word
+    // correct.
+    // ------------------------------------------------------------------
+
+    static size_t cacheLineSize()
+    {
+        // Constant-initialised, so no __cxa_guard_acquire: cacheFlush is
+        // reachable from contexts where re-entering a guard would deadlock.
+        static std::atomic<size_t> cached { 0 };
+        size_t size = cached.load(std::memory_order_relaxed);
+        if (size) [[likely]]
+            return size;
+
+        unsigned long chosen = 0;
+#if OS(LINUX)
+        unsigned long dblock = ::getauxval(AT_DCACHEBSIZE);
+        unsigned long iblock = ::getauxval(AT_ICACHEBSIZE);
+        if (dblock && iblock)
+            chosen = std::min(dblock, iblock);
+        else
+            chosen = dblock ? dblock : iblock;
+#endif
+        if (!chosen || (chosen & (chosen - 1)))
+            chosen = 32;
+
+        size = static_cast<size_t>(chosen);
+        cached.store(size, std::memory_order_relaxed);
+        return size;
+    }
+
+    static void cacheFlush(void* code, size_t size)
+    {
+        if (!size)
+            return;
+
+        const size_t blockSize = cacheLineSize();
+        const uintptr_t base = reinterpret_cast<uintptr_t>(code);
+        const uintptr_t end = base + size;
+        const uintptr_t begin = base & ~static_cast<uintptr_t>(blockSize - 1);
+
+        for (uintptr_t p = begin; p < end; p += blockSize)
+            asm volatile("dcbst 0,%0" :: "r"(p) : "memory");
+        asm volatile("sync" ::: "memory");
+        for (uintptr_t p = begin; p < end; p += blockSize)
+            asm volatile("icbi 0,%0" :: "r"(p) : "memory");
+        asm volatile("sync; isync" ::: "memory");
+    }
+
+    // POWER9 / ISA 3.0 gating, the SpiderMonkey pattern. The LLInt as
+    // generated uses no ISA 3.0 mnemonic, so this only matters once the
+    // MacroAssembler starts emitting mcrxrx / cnttz* / setb / mod*.
+    // Forcing the POWER8 path on POWER9 silicon is the only way the
+    // fallbacks stay tested: a path reachable only on hardware nobody runs
+    // CI on is untested code (power8-baseline-power9-paths.md). testmasm
+    // flips this to exercise both arms of every hasISA30() seam.
+    static bool& forcePOWER8Paths()
+    {
+        static bool force = false;
+        return force;
+    }
+
+    static bool hasISA30()
+    {
+        if (forcePOWER8Paths()) [[unlikely]]
+            return false;
+#if OS(LINUX) && defined(PPC_FEATURE2_ARCH_3_00)
+        static std::atomic<int> cached { -1 };
+        int value = cached.load(std::memory_order_relaxed);
+        if (value < 0) {
+            value = (::getauxval(AT_HWCAP2) & PPC_FEATURE2_ARCH_3_00) ? 1 : 0;
+            cached.store(value, std::memory_order_relaxed);
+        }
+        return !!value;
+#else
+        return false;
+#endif
+    }
+
+    // ------------------------------------------------------------------
+    // Conditions.
+    //
+    // On PowerPC a compare and a branch are separate instructions and the
+    // signedness lives in the COMPARE, not in the branch. The Condition here
+    // therefore has to carry both: which compare to emit, and which CR bit to
+    // test. MacroAssemblerPPC64 keeps that pairing.
+    // ------------------------------------------------------------------
+
+    enum Condition {
+        ConditionEQ,
+        ConditionNE,
+        ConditionLT,   // signed
+        ConditionLE,   // signed
+        ConditionGT,   // signed
+        ConditionGE,   // signed
+        ConditionLTU,  // unsigned
+        ConditionLEU,  // unsigned
+        ConditionGTU,  // unsigned
+        ConditionGEU,  // unsigned
+    };
+
+    static constexpr Condition invert(Condition cond)
+    {
+        switch (cond) {
+        case ConditionEQ: return ConditionNE;
+        case ConditionNE: return ConditionEQ;
+        case ConditionLT: return ConditionGE;
+        case ConditionLE: return ConditionGT;
+        case ConditionGT: return ConditionLE;
+        case ConditionGE: return ConditionLT;
+        case ConditionLTU: return ConditionGEU;
+        case ConditionLEU: return ConditionGTU;
+        case ConditionGTU: return ConditionLEU;
+        case ConditionGEU: return ConditionLTU;
+        }
+        return ConditionEQ;
+    }
+
+    static constexpr bool isUnsignedCondition(Condition cond)
+    {
+        return cond >= ConditionLTU;
+    }
+
+protected:
+    AssemblerBuffer m_buffer;
+    int m_indexOfLastWatchpoint { INT_MIN };
+    int m_indexOfTailOfLastWatchpoint { INT_MIN };
+};

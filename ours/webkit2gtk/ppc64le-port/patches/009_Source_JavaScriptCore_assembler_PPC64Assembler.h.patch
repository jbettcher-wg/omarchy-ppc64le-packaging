+    //
+    // Every word of the ladder -- and of the placeholder that stands in for
+    // one before linking -- is a D-form instruction whose RT field is the
+    // destination, so bits 21:25 of word 0 identify it in both states. A
+    // patcher MUST recover the register this way instead of assuming one:
+    // moveWithPatch() emits the ladder into whatever register its caller
+    // asked for, and only the call-site placeholder uses r12.
+    static RegisterID readFixedLoadImmediate64Register(const uint32_t* where)
+    {
+        return static_cast<RegisterID>((where[0] >> 21) & 0x1f);
+    }
+
+    static int64_t readFixedLoadImmediate64(const uint32_t* where)
+    {
+        uint64_t hi = uint64_t(uint16_t(where[0] & 0xffff)) << 16;
+        hi |= uint16_t(where[1] & 0xffff);
+        uint64_t lo = uint64_t(uint16_t(where[3] & 0xffff)) << 16;
+        lo |= uint16_t(where[4] & 0xffff);
+        return int64_t((hi << 32) | lo);
+    }
+
+    void emitFixedLoadImmediate64(RegisterID rd, int64_t value)
+    {
+        uint32_t words[fixedLoadImmediate64Size];
+        writeFixedLoadImmediate64(words, rd, value);
+        for (unsigned i = 0; i < fixedLoadImmediate64Size; ++i)
+            insn(words[i]);
+    }

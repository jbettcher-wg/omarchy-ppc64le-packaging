+    // ------------------------------------------------------------------
+    // 64-bit immediate materialisation. The ladder is the standard five-word
+    // one (lis/ori/rldicr/oris/ori), shortened whenever the value permits.
+    // Any shorter path must produce EXACTLY the same register contents; the
+    // sign extension of addi/addis is what the compensations below are for.
+    // ------------------------------------------------------------------
+
+    static unsigned sizeOfLoadImmediate64(int64_t value)
+    {
+        if (PPC64Assembler::isValidSigned16(value))
+            return 1;
+        if (PPC64Assembler::isValidSigned32(value))
+            return (value & 0xffff) ? 2 : 1;
+        if (!(value >> 32) || (value >> 32) == -1)
+            return 2;
+        unsigned count = 1; // lis for bits 48:63
+        if ((value >> 32) & 0xffff)
+            count++; // ori
+        count++; // rldicr
+        if ((value >> 16) & 0xffff)
+            count++; // oris
+        if (value & 0xffff)
+            count++; // ori
+        return count;
+    }
+
+    void loadImmediate64(RegisterID rd, int64_t value)
+    {
+        if (isValidSigned16(value)) {
+            li(rd, int32_t(value));
+            return;
+        }
+
+        if (isValidSigned32(value)) {
+            // addis sign-extends its 16-bit field into bits 32:47 and beyond,
+            // which is exactly right for a signed 32-bit value.
+            lis(rd, int32_t(int16_t(value >> 16)));
+            if (value & 0xffff)
+                ori(rd, rd, uint32_t(value) & 0xffff);
+            return;
+        }
+
+        int32_t hi32 = int32_t(value >> 32);
+        uint32_t lo32 = uint32_t(uint64_t(value) & 0xffffffff);
+
+        lis(rd, int16_t(hi32 >> 16));
+        if (uint32_t(hi32) & 0xffff)
+            ori(rd, rd, uint32_t(hi32) & 0xffff);
+        rldicr(rd, rd, 32, 31);
+        if (lo32 >> 16)
+            oris(rd, rd, lo32 >> 16);
+        if (lo32 & 0xffff)
+            ori(rd, rd, lo32 & 0xffff);
+    }

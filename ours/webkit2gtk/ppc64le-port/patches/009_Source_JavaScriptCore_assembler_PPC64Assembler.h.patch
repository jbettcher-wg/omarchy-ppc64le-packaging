+    // Write a 64-bit constant into an already-emitted fixed-width ladder.
+    // The ladder written here is always five words, so that a repatch never
+    // has to move anything: unused slots become `nop`. `patchLoadImmediate64`
+    // and `readLoadImmediate64` are the only two functions that may assume
+    // this layout.
+    static constexpr unsigned fixedLoadImmediate64Size = 5;
+
+    static void writeFixedLoadImmediate64(uint32_t* where, RegisterID rd, int64_t value)
+    {
+        uint32_t hi32 = uint32_t(uint64_t(value) >> 32);
+        uint32_t lo32 = uint32_t(uint64_t(value) & 0xffffffff);
+        where[0] = formD(15, rd, 0, int32_t(int16_t(hi32 >> 16)));                // lis rd, hi16
+        where[1] = formD(24, rd, rd, int32_t(hi32 & 0xffff));                     // ori rd, rd, hi lo16
+        where[2] = formMD(rd, rd, 32, 31, 1, false);                              // rldicr rd, rd, 32, 31
+        where[3] = formD(25, rd, rd, int32_t(lo32 >> 16));                        // oris rd, rd, lo hi16
+        where[4] = formD(24, rd, rd, int32_t(lo32 & 0xffff));                     // ori rd, rd, lo lo16
+    }

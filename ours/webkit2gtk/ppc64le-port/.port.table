AFTER|Source/JavaScriptCore/llint/LowLevelInterpreter.asm|macro entry(kind, initialize)\n    global _%kind%_entry\n    _%kind%_entry:\n        functionPrologue()\n        pushCalleeSaves()|\n        if PPC64\n            # Called directly from C++ (JSC::LLInt::initialize). The body\n            # materialises 500-odd opcode addresses through the temporary\n            # pool, so r28-r30 are certainly clobbered. Give them back.\n            emit "addi 1, 1, -80"\n            emit "std 25, 32(1)"\n            emit "std 26, 40(1)"\n            emit "std 27, 48(1)"\n            emit "std 28, 56(1)"\n            emit "std 29, 64(1)"\n            emit "std 30, 72(1)"\n        end

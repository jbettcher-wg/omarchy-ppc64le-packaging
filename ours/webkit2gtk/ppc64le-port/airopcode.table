ADDBLOCK|Lshift32 U:G:32, U:G:32, ZD:G:32|\n# POWER's shift instructions do not mask their count the way x86 and ARM64 do\n# -- a count of 32 or more yields zero rather than count & 31 -- so the mask is\n# a real instruction and it needs a register to put the result in. Air\n# generates with the MacroAssembler's scratch registers forbidden\n# (AirGenerate.cpp DisallowMacroScratchRegisterUsage), because the allocator\n# may have given r29 or r30 to a live Tmp, so the register has to come from\n# Air. It is declared here the way ARM64 declares BranchMul's scratch and the\n# way the spill-to-spill Move above declares its own: a fourth operand in the\n# Scratch role, which the allocator sizes and spills like any other Tmp.\n#\n# Only the register form is declared. The immediate form needs no scratch, and\n# is unreachable here until Arg::isValidImmForm answers for this target.\nppc64: Lshift32 U:G:32, U:G:32, ZD:G:32, S:G:32\n    Tmp, Tmp, Tmp, Tmp
ADDBLOCK|Lshift64 U:G:64, U:G:64, D:G:64|\n# A Scratch operand for the masked shift count, as for Lshift32 above.\nppc64: Lshift64 U:G:64, U:G:64, D:G:64, S:G:64\n    Tmp, Tmp, Tmp, Tmp
ADDBLOCK|Rshift32 U:G:32, U:G:32, ZD:G:32|\n# A Scratch operand for the masked shift count, as for Lshift32 above.\nppc64: Rshift32 U:G:32, U:G:32, ZD:G:32, S:G:32\n    Tmp, Tmp, Tmp, Tmp
ADDBLOCK|Rshift64 U:G:64, U:G:64, D:G:64|\n# A Scratch operand for the masked shift count, as for Lshift32 above.\nppc64: Rshift64 U:G:64, U:G:64, D:G:64, S:G:64\n    Tmp, Tmp, Tmp, Tmp
ADDBLOCK|Urshift32 U:G:32, U:G:32, ZD:G:32|\n# A Scratch operand for the masked shift count, as for Lshift32 above.\nppc64: Urshift32 U:G:32, U:G:32, ZD:G:32, S:G:32\n    Tmp, Tmp, Tmp, Tmp
ADDBLOCK|Urshift64 U:G:64, U:G:64, D:G:64|\n# A Scratch operand for the masked shift count, as for Lshift32 above.\nppc64: Urshift64 U:G:64, U:G:64, D:G:64, S:G:64\n    Tmp, Tmp, Tmp, Tmp
ADDBLOCK|RotateRight32 U:G:32, U:G:32, ZD:G:32|\n# A Scratch operand for the masked shift count, as for Lshift32 above.\nppc64: RotateRight32 U:G:32, U:G:32, ZD:G:32, S:G:32\n    Tmp, Tmp, Tmp, Tmp
ADDBLOCK|RotateRight64 U:G:64, U:G:64, D:G:64|\n# A Scratch operand for the masked shift count, as for Lshift32 above.\nppc64: RotateRight64 U:G:64, U:G:64, D:G:64, S:G:64\n    Tmp, Tmp, Tmp, Tmp
ADDBLOCK|RotateLeft32 U:G:32, UZD:G:32|\n# No Scratch operand, unlike RotateRight above: rotate left is the native\n# direction here, so there is no width - n to compute.\nppc64: RotateLeft32 U:G:32, U:G:32, ZD:G:32\n    Tmp, Tmp, Tmp\n    Tmp, Imm, Tmp
ADDBLOCK|RotateLeft64 U:G:64, UD:G:64|\nppc64: RotateLeft64 U:G:64, U:G:64, D:G:64\n    Tmp, Tmp, Tmp\n    Tmp, Imm, Tmp

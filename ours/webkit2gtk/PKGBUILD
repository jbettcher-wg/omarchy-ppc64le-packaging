prepare() {
  cd webkitgtk-$pkgver

  if [[ $CARCH == powerpc64le ]]; then
    # The ppc64le JavaScriptCore JIT port: LLInt, Baseline, DFG, FTL (so B3
    # and Air), YARR and all three WebAssembly tiers. Without it this target
    # falls back to CLoop, which is the interpreter only -- the installed
    # 2.50.4 package is such a build and has no ppc64 JIT symbols at all.
    #
    # Not a single patch. stage.sh explains why and applies four layers; it is
    # self-contained and fails loudly rather than half-applying. Referenced
    # from $startdir because it is a directory of 126 files rather than
    # something source=() can carry -- which means a clean-chroot build has to
    # copy the whole recipe directory in, not just the source=() entries.
    # makechrootpkg does; a hand-rolled chroot has to be told to.
    "$startdir/ppc64le-port/stage.sh" .
  fi
}

build() {
  local cmake_options=(
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_LIBDIR=lib
    -D CMAKE_INSTALL_LIBEXECDIR=lib
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_SKIP_RPATH=ON
    -D ENABLE_DOCUMENTATION=ON
    -D ENABLE_MINIBROWSER=ON
    -D ENABLE_SPEECH_SYNTHESIS=OFF
    -D PORT=GTK
    -D USE_FLITE=OFF
    -D USE_GTK4=OFF
    -D USE_LIBBACKTRACE=OFF
    -D USE_SOUP2=OFF
  )

  if [[ $CARCH == powerpc64le ]]; then
    # GCC, not clang: clang's integrated assembler accepts ISA 3.0 encodings
    # even at -mcpu=power8, so a POWER9-only instruction would build clean
    # here and SIGILL on a POWER8. GNU as rejects it, which is what keeps the
    # repository's POWER8 baseline honest.
    export CC=gcc CXX=g++

    # bmalloc's libpas is enabled only for x86-64 and arm64 on Linux
    # (BPlatform.h), and nothing else is selected by default, so a bare
    # configure dies on "libpas, mimalloc, or system malloc needs to be
    # specified". mimalloc is vendored in Source/bmalloc/mimalloc and is what
    # RISC-V -- the other 64-bit JIT target without libpas -- defaults to.
    cmake_options+=(
      -D USE_MIMALLOC=ON
      -D USE_SYSTEM_MALLOC=OFF
    )

    # skcms' musttail is x86/arm only; -mminimal-toc keeps the TOC inside its
    # 64 KiB addressing window in translation units this large.
    CFLAGS+=' -DSKCMS_HAS_MUSTTAIL=0 -mminimal-toc'
    CXXFLAGS+=' -DSKCMS_HAS_MUSTTAIL=0 -mminimal-toc'
    # The final link otherwise peaks past what this machine will give it.
    LDFLAGS+=' -Wl,--no-keep-memory'
  else
    # Upstream prefers Clang
    # https://gitlab.archlinux.org/archlinux/packaging/packages/webkitgtk-6.0/-/issues/4
    export CC=clang CXX=clang++
    LDFLAGS+=" -fuse-ld=lld"

    # JITted code crashes when CET is used
    CFLAGS+=' -fcf-protection=none'
    CXXFLAGS+=' -fcf-protection=none'
  fi

  # Skia uses malloc_usable_size
  CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

  # Honour makepkg.conf's -j rather than letting Ninja pick nproc+2 on its own.
  # cmake --build reads CMAKE_BUILD_PARALLEL_LEVEL and passes it through as
  # ninja's -j; without it a 176-thread machine starts 178 compiles and the
  # box stops being usable for anything else. Matched as a pattern rather than
  # by stripping, so "-j144 --other-flag" parses.
  local _jobs=
  [[ ${MAKEFLAGS-} =~ -j[[:space:]]*([0-9]+) ]] && _jobs="${BASH_REMATCH[1]}"
  [[ -n $_jobs ]] && export CMAKE_BUILD_PARALLEL_LEVEL="$_jobs"

  cmake -S webkitgtk-$pkgver -B build -G Ninja "${cmake_options[@]}"
  cmake --build build
}

package_webkit2gtk-4.1() {
  provides+=(
    libjavascriptcoregtk-4.1.so
    libwebkit2gtk-4.1.so
  )
  optdepends=(
    'geoclue: Geolocation support'
    'gst-libav: nonfree media decoding'
    'gst-plugins-bad: media decoding'
    'gst-plugins-good: media decoding'
  )

  DESTDIR="$pkgdir" cmake --install build

  rm -r "$pkgdir/usr/bin"

  mkdir -p doc/usr/share
  mv {"$pkgdir",doc}/usr/share/doc

  cd webkitgtk-$pkgver
  find Source -name 'COPYING*' -or -name 'LICENSE*' -print0 | sort -z |
    while IFS= read -d $'\0' -r _f; do
      echo "### $_f ###"
      cat "$_f"
      echo
    done |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_webkit2gtk-4.1-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mv doc/* "$pkgdir"
}


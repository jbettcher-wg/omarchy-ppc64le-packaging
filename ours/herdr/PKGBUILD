# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# herdr -- terminal workspace manager for AI coding agents.  Started from the
# AUR `herdr` recipe at 0.8.2; version and metadata (url, license, conflicts,
# replaces, file list) follow Omarchy's own recipe, omacom/omarchy-pkgs
# pkgbuilds/herdr@954a4774257e, the 0.9.5-1 their stable channel ships.
#
# What changed for ppc64le:
#
# - arch=(powerpc64le).
# - herdr-build-rs-powerpc64le.patch: crates/ghostty-vt/build.rs maps rust
#   targets to zig targets through a fixed table and panics on powerpc64le.
#   One row added.  (0.9 moved the table there from the top-level build.rs.)
#   Portability fix worth sending upstream.
# - libghostty-vt-no-bundled-runtimes-ppc64le.patch: the static
#   libghostty-vt bundles zig's compiler_rt and ubsan_rt; on powerpc64le the
#   patch leaves both out, since herdr links the archive from Rust, whose
#   compiler_builtins and libgcc provide those routines.
#   * zig 0.16's compiler_rt object has 103 .eh_frame FDEs relocated against
#     an undefined, nameless symbol. They all resolve to address 0, so GNU ld
#     fails the final link with ".eh_frame_hdr refers to overlapping FDEs".
#     Linked alone, that one object reproduces it; the archive's other 11
#     link clean. That is our zig 0.16.0-2 (upstream source + our ELFv2
#     C-ABI patch, built against Arch POWER's llvm21); whether upstream zig
#     has the same fault has not been tested yet.
#   * Without compiler_rt, ubsan_rt is left needing __extendxftf2 (an x87
#     long-double conversion libgcc on ppc64le cannot have). Nothing calls
#     ubsan_rt: libghostty-vt builds ReleaseFast, and no object in the
#     archive references a __ubsan_handle_* symbol.
# - zig.  The ghostty-vt crate's build.rs compiles the vendored libghostty-vt
#   with zig (honouring $ZIG), and libghostty-vt's src/build/zig.zig
#   requireZig() rejects any zig whose minor version differs from its
#   minimum_zig_version -- 0.16.0 since herdr 0.9.1.  Upstream's recipe
#   downloads ziglang.org's prebuilt x86_64/aarch64 zig 0.16.0 for that; here
#   it is the repo's zig 0.16.0, built from source.  Up to 0.8.2 this needed
#   zig0.15 (/usr/bin/zig-0.15) instead; that makedepend is gone.
# - The zig has to carry zig-ppc64le-elfv2-c-abi.patch, and makedepends pins
#   the first build that does (zig 0.16.0-2; zig0.15 0.15.2-2 for 0.8.2).
#   Without it zig lowers by-value C structs wrongly on ELFv2, and herdr
#   0.8.2-1's server segfaulted in ghostty_terminal_grid_ref(): rustc passed
#   the 24-byte GhosttyPoint in r4-r6 and out_ref in r7, zig read the point
#   from r9 and out_ref from the stack.  See packages/zig.
# - The AUR's fetch loop (re-scanning every build.zig.zon for URLs until no
#   new ones appear) is replaced by `zig build --fetch=all`, which walks the
#   same dependency tree and fills the same global cache.
# - CARGO_HOME and the zig caches under $srcdir, so the build writes nothing
#   into $HOME.  The repo's rust (1:1.98.1) builds it; upstream's
#   rust-toolchain.toml pin (1.96.1) is inert without rustup.
#
# What changed that is not ppc64le:
#
# - herdr.service, a systemd *user* unit for the headless server (since 0.8.2-3).
#   Launched the usual way -- a client in a terminal spawning the server as its
#   child -- the server lands in app-graphical.slice, so a compositor restart
#   or a desktop logout takes every workspace with it. Nothing about the server
#   needs a graphical session: its socket and session.json live in
#   ~/.config/herdr, not a runtime directory. The unit puts it directly under
#   the user manager, where that is true.
#
#   Deliberately not enabled by the package. Enabling it reparents whatever
#   server is running, which costs the current workspaces, so it is the
#   admin's call when to pay that. `loginctl enable-linger` is the other half:
#   without it the user manager stops with the last login session and takes
#   the unit with it.
#
#   Not a ppc64le fix -- it would apply to any herdr package, upstream
#   included, and is worth sending there.

pkgname=herdr
pkgver=0.9.5
pkgrel=1
pkgdesc='Herdr terminal workspace manager for AI coding agents'
arch=(powerpc64le)
url='https://github.com/herdrdev/herdr'
license=(Apache-2.0)
depends=(gcc-libs glibc)
makedepends=(cargo git 'zig>=0.16.0-2')
replaces=(omarchy-herdr)
conflicts=(omarchy-herdr)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        herdr-build-rs-powerpc64le.patch
        libghostty-vt-no-bundled-runtimes-ppc64le.patch
        herdr.service)
sha256sums=('a2486b09a8153630f6a19e72606ba1c961a6194bce13c09cba67ccce5e4252de'
            'fe4e28c66b038ef92a888406d64a985ca450c42ac5d8e9bb5ac545d5fd11904c'
            '483bb41ca00d4f6fd1422fcdaa3e91e130cf4a3841af66f13b9762c23b516f63'
            'efe7d27a4c990af67a1875004c718b0691ba42a766939fe2016d08cd1166a9d4')

_env() {
  export CARGO_HOME="$srcdir/cargo-home"
  export ZIG=/usr/bin/zig
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
  export ZIG_LOCAL_CACHE_DIR="$srcdir/zig-local-cache"
}

prepare() {
  cd "$pkgname-$pkgver"
  _env
  patch -Np1 -i "$srcdir/herdr-build-rs-powerpc64le.patch"
  patch -Np1 -i "$srcdir/libghostty-vt-no-bundled-runtimes-ppc64le.patch"

  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"

  cd vendor/libghostty-vt
  "$ZIG" build --fetch=all
}

build() {
  cd "$pkgname-$pkgver"
  _env
  export HERDR_BUILD_CHANNEL=stable
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # User unit, not system: the server is per-user and keeps its state under
  # ~/.config/herdr. See the header for why it is not enabled here.
  install -Dm644 "$srcdir/herdr.service" \
    "$pkgdir/usr/lib/systemd/user/herdr.service"
}

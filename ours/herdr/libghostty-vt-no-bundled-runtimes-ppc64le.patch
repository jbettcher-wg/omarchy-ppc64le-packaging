+        // powerpc64le: leave zig's runtimes out, since herdr links this archive
+        // from Rust, whose compiler_builtins and libgcc provide the routines.
+        // - zig 0.16's compiler_rt object carries 103 .eh_frame FDEs relocated
+        //   against an undefined, nameless symbol; they all land at address 0
+        //   and GNU ld refuses the link (".eh_frame_hdr refers to overlapping
+        //   FDEs").
+        // - ubsan_rt then needs __extendxftf2, an x87 long-double conversion
+        //   that only zig's compiler_rt supplies and libgcc on ppc64le cannot.
+        //   Nothing calls it: ReleaseFast leaves no __ubsan_handle_* reference.
+        if (target.result.cpu.arch == .powerpc64le) {
+            lib.bundle_compiler_rt = false;
+            lib.bundle_ubsan_rt = false;
+        }
+

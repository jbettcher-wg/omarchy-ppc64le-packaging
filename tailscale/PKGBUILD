# ppc64le: added powerpc64le to arch(), and pinned the ISA floor to POWER8 in
# build(). Imported with tools/fetch.sh tailscale; Arch POWER does not carry
# this pkgbase, so it lands at the top level where Arch's flat namespace maps.
#
# The ISA pin deviates from the crush recipe's "leave GOPPC64 to the pool" on
# purpose. A mesh VPN daemon gains nothing measurable from ISA 3.0, so there is
# no reason to carry a POWER9 variant or a _power8_compat toggle for it -- and
# an unpinned Go build is actively unsafe here, because this tree's go
# toolchain bakes in power9 as its own default (`go env GOPPC64` answers
# power9). Any build that does not load the baseline pool's power8 drop-in
# would therefore emit ISA 3.0 silently and take an illegal instruction on
# POWER8: the gum 2.0.0-1 bug. Pinned in the recipe, so the artifact is
# POWER8-legal whichever pool builds it.
#
# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: Morten Linderud <foxboron@archlinux.org>
# Contributor: David Anderson <dave@natulte.net>

pkgname=tailscale
pkgver=1.102.4
pkgrel=1
pkgdesc="A mesh VPN that makes it easy to connect your devices, wherever they are."
arch=('x86_64' 'powerpc64le')
url="https://tailscale.com"
license=("MIT")
makedepends=("git" "go")
depends=("glibc")
backup=("etc/default/tailscaled")
# Important: Check if the version has been published before updating
# pkgctl version check
source=("git+https://github.com/tailscale/tailscale.git#tag=v${pkgver}")
sha256sums=('d1e8505267332acbf31d216d86b7e63a1035f905e8b155b089f63ffc99558888')

options=(!lto)

prepare() {
    cd "${pkgname}"
    go mod vendor
}

build() {
    cd "${pkgname}"

    # POWER8 ISA floor. Two separate knobs reach the two halves of a cgo
    # build, and neither one reaches the other:
    #   GOPPC64          the Go compiler's own target level. No CFLAGS value
    #                    reaches it, and the toolchain default is power9 here.
    #   CFLAGS/CXXFLAGS  the cgo C objects and the external link below. The
    #                    POWER9 pool sets -mcpu=power9 in these; rewrite it
    #                    the way the baseline drop-in does.
    if [[ ${CARCH} == powerpc64le ]]; then
        export GOPPC64=power8
        CFLAGS="${CFLAGS//power9/power8}"
        CXXFLAGS="${CXXFLAGS//power9/power8}"
    fi

    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    # -trimpath: without it the Go file-path strings record the buildroot, and
    # this package ships ONE artifact to both pools -- so the POWER9 pool would
    # get a binary whose strings name /var/tmp/omarchy-bq-ppc64le, and the two
    # pools could never produce an identical file. Measured on 1.102.4-1: 300
    # such strings in tailscale, 539 in tailscaled. Every other Go recipe in this
    # tree already passes it.
    # -buildvcs=false: prepare() runs `go mod vendor`, which dirties the work
    # tree, so the VCS stamp Go embeds by itself came out "<commit>-dirty" and
    # `tailscale version` showed it. The commit is already passed explicitly in
    # GO_LDFLAGS below, so the embedded one is redundant as well as wrong.
    export GOFLAGS="-buildmode=pie -mod=readonly -modcacherw -trimpath -buildvcs=false"
    GO_LDFLAGS="\
        -linkmode=external \
        -X tailscale.com/version.longStamp=${pkgver} \
        -X tailscale.com/version.shortStamp=$(cut -d+ -f1 <<< "${pkgver}") \
        -X tailscale.com/version.gitCommitStamp=$(git rev-parse v"${pkgver}")"

    for cmd in ./cmd/tailscale ./cmd/tailscaled; do
        go build -v -tags xversion -ldflags "$GO_LDFLAGS" "$cmd"
    done
}

#TODO: Figure out why tests are failing
# check() {

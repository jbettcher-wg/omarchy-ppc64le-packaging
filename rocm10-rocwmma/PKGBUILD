# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>
# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=rocm10-rocwmma
# Upstream project name, deliberately separate from $pkgname: ours is renamed
# so the ROCm 7 generation can stay in the pool, while the tarball, the URL
# and the directory inside the archive still use the upstream name.
_project=rocwmma
pkgver=7.2.4
pkgrel=1
pkgdesc='Library for accelerating mixed precision matrix multiplication'
arch=('x86_64' 'powerpc64le')
url='https://rocm.docs.amd.com/projects/rocWMMA/en/latest/'
license=('MIT')
depends=(
    'rocm10-hip-runtime-amd'
    'openmp'
    'rocm10-rocblas'
    'rocm10-core'
)
makedepends=(
    'doxygen'
    'ninja'
    'cmake'
    'rocm-cmake'
    'rocm10-llvm'
    'rocm10-toolchain'
)
_git='https://github.com/ROCmSoftwarePlatform/rocWMMA'
# Both ROCm generations install into /opt/rocm with identical paths, so without
# these pacman cannot swap them: it reports a wall of "exists in both" file
# conflicts and the only way through is --overwrite, which resolves the wrong
# way round -- a swap done that way left rocm-core 7.2.4's 19 files on disk
# while rocm10-core was recorded as owning them, and /opt/rocm/.info/version
# still read 7.2.4.
#
# conflicts, deliberately WITHOUT replaces: replaces would make every -Syu
# migrate ROCm 7 users to ROCm 10, and ROCm 10 dropped gfx900, which is the
# entire reason the rocm7 generation exists. conflicts asks instead.
# provides keeps existing dependents resolvable across the swap -- llama.cpp-hip
# depends on rocblas and hip-runtime-amd by name.
conflicts=('rocwmma')
provides=("rocwmma=$pkgver")

source=("$_project-$pkgver.tar.gz::$_git/archive/rocm-$pkgver.tar.gz")
sha256sums=('5e2cd91647ece7ccdfe4d0f3b801f174a218d2bcb3d4537ea6ab650da09d6096')
_dirname="$(basename "$_git")-$(basename "${source[0]}" .tar.gz)"
options=(!lto)

build() {
    local cmake_args=(
        -Wno-dev
        -B build
        -G Ninja
        -S "$_dirname"
        -D CMAKE_POLICY_VERSION_MINIMUM=3.5
        -D CMAKE_BUILD_TYPE=None
        -D CMAKE_CXX_COMPILER=amdclang++
        -D CMAKE_INSTALL_PREFIX=/opt/rocm
        -D ROCWMMA_BUILD_TESTS=OFF
        -D ROCWMMA_BUILD_SAMPLES=OFF
        -D ROCM_SYMLINK_LIBS=OFF
        -D HIP_PLATFORM=amd
        -D CMAKE_CXX_FLAGS="${CXXFLAGS} -fcf-protection=none"
        # Explicit, not $(rocm-supported-gfx): that reports whatever the installed
        # rocm-toolchain claims, including targets ROCm 10 dropped.
        -D GPU_TARGETS="${ROCWMMA_GPU_TARGETS:-gfx1100;gfx1101;gfx1102;gfx1200;gfx1201}"
    )
    cmake "${cmake_args[@]}"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

-  if (src != dest) {
-    xs_mr(dest, src);
+  uint32_t uimm = uint32_t(imm.value);
+  if (is_uintN(uimm, 16)) {
+    // andi. zeroes bits 16..63: the result is a non-negative int32 that is
+    // already canonical (sign-extended), whatever src's high half held.
+    as_andi_rc(dest, src, uimm);
+    return;

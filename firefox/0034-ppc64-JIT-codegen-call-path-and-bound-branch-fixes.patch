+
+BEGIN_TEST(testJitMacroAssembler_ppc64BoundBranchPrefix) {
+  TempAllocator tempAlloc(&cx->tempLifoAlloc());
+  JitContext jcx(cx);
+  StackMacroAssembler masm(cx, tempAlloc);
+  AutoCreatedBy acb(masm, __func__);
+
+  PrepareJit(masm);
+
+  AllocatableGeneralRegisterSet gprs(GeneralRegisterSet::Volatile());
+  Register counter = gprs.takeAny();
+  Register acc = gprs.takeAny();
+  Register mul = gprs.takeAny();
+  Register tmp = gprs.takeAny();
+  // f0 is ScratchDoubleReg; f1-f3 are volatile and not used by masm.
+  FloatRegister fcur = f1;
+  FloatRegister fnext = f2;
+
+  for (int farIdx = 0; farIdx < 2; farIdx++) {
+    bool far = farIdx != 0;
+    // Overflow back-edge: iteration 1 multiplies 2^62 by 2 (overflows, loops),
+    // iteration 2 multiplies by 1 (no overflow, exits).
+    {
+      Label loop;
+      masm.movePtr(ImmWord(2), mul);
+      PPCEmitCountedLoopHead(masm, counter, &loop, far);
+      masm.movePtr(mul, tmp);
+      masm.movePtr(ImmWord(1), mul);
+      masm.movePtr(ImmWord(uintptr_t(1) << 62), acc);
+      masm.branchMulPtr(Assembler::Overflow, tmp, acc, &loop);
+      PPCEmitRecordCount(masm, counter, PPCCaseOverflow, far);
+    }
+
+    // NotOverflow back-edge: iteration 1 multiplies by 1 (loops), iteration 2
+    // multiplies 2^62 by 2 (overflows, exits).
+    {
+      Label loop;
+      masm.movePtr(ImmWord(1), mul);
+      PPCEmitCountedLoopHead(masm, counter, &loop, far);
+      masm.movePtr(mul, tmp);
+      masm.movePtr(ImmWord(2), mul);
+      masm.movePtr(ImmWord(uintptr_t(1) << 62), acc);
+      masm.as_mulldo(acc, acc, tmp);
+      masm.ma_b(Assembler::NotOverflow, &loop);
+      PPCEmitRecordCount(masm, counter, PPCCaseNotOverflow, far);
+    }
+
+    // DoubleUnordered back-edge: NaN on iteration 1 (loops), then 1.0.
+    {
+      Label loop;
+      masm.loadConstantDouble(JS::GenericNaN(), fnext);
+      PPCEmitCountedLoopHead(masm, counter, &loop, far);
+      masm.moveDouble(fnext, fcur);
+      masm.loadConstantDouble(1.0, fnext);
+      masm.branchDouble(Assembler::DoubleUnordered, fcur, fcur, &loop);
+      PPCEmitRecordCount(masm, counter, PPCCaseDoubleUnordered, far);
+    }
+
+    // DoubleOrdered back-edge: 1.0 on iteration 1 (loops), NaN on iteration 2.
+    {
+      Label loop;
+      masm.loadConstantDouble(1.0, fnext);
+      PPCEmitCountedLoopHead(masm, counter, &loop, far);
+      masm.moveDouble(fnext, fcur);
+      masm.loadConstantDouble(JS::GenericNaN(), fnext);
+      masm.branchDouble(Assembler::DoubleOrdered, fcur, fcur, &loop);
+      PPCEmitRecordCount(masm, counter, PPCCaseDoubleOrdered, far);
+    }
+
+    // Controls: double conditions that do emit a CR fixup before the bc
+    // (crandc for DoubleLessThan, cror for DoubleGreaterThanOrUnordered).
+    {
+      FloatRegister fbound = f3;
+      Label loop;
+      masm.loadConstantDouble(0.5, fbound);
+      masm.loadConstantDouble(0.0, fnext);
+      PPCEmitCountedLoopHead(masm, counter, &loop, far);
+      masm.moveDouble(fnext, fcur);
+      masm.loadConstantDouble(1.0, fnext);
+      masm.branchDouble(Assembler::DoubleLessThan, fcur, fbound, &loop);
+      PPCEmitRecordCount(masm, counter, PPCCaseDoubleLessThan, far);
+
+      Label loop2;
+      masm.loadConstantDouble(JS::GenericNaN(), fnext);
+      PPCEmitCountedLoopHead(masm, counter, &loop2, far);
+      masm.moveDouble(fnext, fcur);
+      masm.loadConstantDouble(0.0, fnext);
+      masm.branchDouble(Assembler::DoubleGreaterThanOrUnordered, fcur, fbound,
+                        &loop2);
+      PPCEmitRecordCount(masm, counter, PPCCaseDoubleGreaterThanOrUnordered,
+                         far);
+    }
+  }
+
+  for (auto& row : PPCCaseCounts) {
+    for (intptr_t& count : row) {
+      count = -1;
+    }
+  }
+  CHECK(ExecuteJit(cx, masm));
+  bool ok = true;
+  for (int far = 0; far < 2; far++) {
+    for (int i = 0; i < PPCCaseCount; i++) {
+      if (PPCCaseCounts[far][i] != 2 * kPPCIncs) {
+        fprintf(stderr,
+                "ppc64 bound %s back-edge %s: count %d, expected %d\n",
+                far ? "far" : "near", PPCCaseNames[i],
+                int(PPCCaseCounts[far][i]), 2 * kPPCIncs);
+        ok = false;
+      }
+    }
+  }
+  CHECK(ok);
+  return true;
+}
+END_TEST(testJitMacroAssembler_ppc64BoundBranchPrefix)
+
+#endif

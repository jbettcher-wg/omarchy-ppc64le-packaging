-  and32(imm, dest);
+  unsigned mb, me;
+  if (IsContigMask32(uimm, mb, me)) {
+    // rlwinm.SH=0 ANDs with the contiguous mask (IsContigMask32 never
+    // returns a wrapping mask, so bits 0..31 of the result are zero); record
+    // form sets CR0 like the andi. path above. If the mask excludes bit 31
+    // (mb > 0) the result is non-negative and therefore canonical.

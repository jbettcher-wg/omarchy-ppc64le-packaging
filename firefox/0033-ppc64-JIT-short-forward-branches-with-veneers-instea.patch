+  Instruction* branchInst = buffer->getInst(branch);
+  Instruction* veneerInst = buffer->getInst(veneer);
+  uint32_t enc = branchInst->encode();
+  MOZ_ASSERT(IsShortChainBc(enc), "deadline does not belong to a short bc");

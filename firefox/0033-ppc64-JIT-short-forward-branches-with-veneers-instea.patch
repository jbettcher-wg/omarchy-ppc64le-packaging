-      Instruction* i1 = ((Instruction*)inst)->next();
-      more = (i1->encode() != LabelBase::INVALID_OFFSET);
-      if (more) {
-        next = BufferOffset(i1->encode());
+    while (b.assigned()) {
+      // Read the link before the element gets patched.
+      BufferOffset next = nextLink(b);
+      Instruction* inst = editSrc(b);
+      uint32_t enc = inst->encode();
+      if (IsShortChainBc(enc) || IsShortChainB(enc)) {
+        bindShortBranch(b, next, boff);
+      } else {
+        bind((InstImm*)inst, b.getOffset(), boff.getOffset());
       }
-      bind(inst, b.getOffset(), boff.getOffset());
       b = next;
-    } while (more);
+    }
   }

+    // bc, so this always fits the 26-bit field.
+    veneerLink = branch.getOffset() + link - veneer.getOffset();
+    MOZ_ASSERT(veneerLink != 0);
+    MOZ_ASSERT(JOffImm26::IsInRange(veneerLink));
+  }
+  veneerInst->setData(EncodeBDisplacement(uint32_t(PPC_b), veneerLink));
+
+  int32_t toVeneer = veneer.getOffset() - branch.getOffset();
+  MOZ_ASSERT(toVeneer > 0 && toVeneer <= BcMaxForwardOffset);

-void Assembler::PatchShortRangeBranchToVeneer(PPCBuffer*, unsigned rangeIdx,
+void Assembler::PatchShortRangeBranchToVeneer(PPCBuffer* buffer,
+                                              unsigned rangeIdx,
                                               BufferOffset deadline,
                                               BufferOffset veneer) {
-  // PPC64 does not use short-range branch tracking (NumShortBranchRanges = 0).
-  MOZ_CRASH("PatchShortRangeBranchToVeneer: should not be called");
+  // Called from AssemblerBufferWithConstantPools::finishPool() for a forward
+  // `bc` to a still-unbound label that is about to go out of range. `veneer`
+  // is one instruction slot (after the pool guard/header/data, so it is
+  // never on the fall-through path) at or before `deadline`.
+  //
+  // Reconstruct the branch from (rangeIdx, deadline), then splice the veneer
+  // into the label-use chain right after it:
+  //
+  //   label -> ... -> bc -> next -> ...   becomes
+  //   label -> ... -> bc -> veneer(b) -> next -> ...
+  //
+  // The bc's link now points at the veneer, which is also its branch target
+  // until bind(): bindShortBranch() either retargets the bc directly (target
+  // in reach) or leaves it pointing at the veneer, which is bound like any
+  // other short `b` in the chain.
+  MOZ_RELEASE_ASSERT(rangeIdx == BcRangeIdx);

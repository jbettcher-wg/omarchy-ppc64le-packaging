+// dest = lhs + imm (64-bit imm, lhs a canonical int32), branching to
+// |overflow| when the int32 add overflows. The 64-bit sum goes to a scratch,
+// dest gets its sign-extension, and the two differ exactly on overflow:
+// addi/add + extsw + cmpd + bne, with no separate copy of lhs into dest.
+static void AddImm32CheckOverflow(MacroAssembler& masm, Register lhs,
+                                  int64_t imm, Register dest,
+                                  Label* overflow) {
+  UseScratchRegisterScope temps(masm);
+  Register scratch = temps.Acquire();
+  MOZ_ASSERT(scratch != dest && scratch != lhs);
+  if (is_intN(imm, 16)) {
+    masm.as_addi(scratch, lhs, int16_t(imm));
+  } else {
+    masm.movePtr(ImmWord(uint64_t(imm)), scratch);
+    masm.as_add(scratch, lhs, scratch);
+  }
+  masm.as_extsw(dest, scratch);
+  masm.as_cmpd(scratch, dest);
+  masm.ma_b(Assembler::NotEqual, overflow);
+}

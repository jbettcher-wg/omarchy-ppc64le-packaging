+// Called once the code is at its final address (executableCopy; like
+// arm64's executableCopy, which retargets pending branches the same way).
+// call(ImmPtr) / jump(ImmPtr) emit a 10-slot absolute stanza
+//   [load64 rX] x8, mtctr rX, bctr[l]
+// When the target is other JIT code (a trampoline) within +/-32 MiB of the
+// stanza, turn it into a direct branch:
+//   call: slot [0] = b .+36, slot [9] = bl target   (2 insns executed)
+//   jump: slot [0] = b target                       (1 insn executed)
+// so the call is predicted from the branch target in the I-stream and the
+// return is predicted by the link stack, instead of going through mtctr and
+// the count cache. A call keeps its return address (end of the stanza), so
+// safepoints, OSI points and frame walking are unaffected.
+//
+// Only RelocationKind::HARDCODED entries are rewritten. Their stanza value is
+// never read back: no jump relocation is recorded for them (GC tracing only
+// decodes JITCODE entries) and no patcher targets them (ToggleCall and
+// PatchWrite_NearCall write whole stanzas or only touch toggledCall, which is
+// JITCODE). JITCODE entries are left alone. Targets outside JIT executable
+// memory (C++ functions) are left alone too: ELFv2 callees need r12 = entry
+// to set up their TOC, and they are out of `bl` range anyway. Nothing here
+// changes the stanza footprint (kNoPoolPatchableBranchInsns).
+void Assembler::shortenNearJitBranches(uint8_t* buffer) {
+  for (const RelativePatch& rp : jumps_) {
+    if (rp.kind != RelocationKind::HARDCODED ||
+        !AddressIsInExecutableMemory(rp.target)) {
+      continue;
+    }
+    Instruction* i0 = (Instruction*)(buffer + rp.offset.getOffset());
+    uint32_t rd = Load64StanzaDestReg(i0);
+    uint32_t mtctr = PPC_mtspr | (rd << 21) | PPC_SPR(spr_ctr);
+    if (i0[8].encode() != mtctr ||
+        ExtractLoad64Value(i0) != uint64_t(uintptr_t(rp.target))) {
+      continue;
+    }
+    bool isCall;
+    if (i0[9].encode() == (uint32_t(PPC_bctr) | uint32_t(LinkB))) {
+      isCall = true;
+    } else if (i0[9].encode() == uint32_t(PPC_bctr)) {
+      isCall = false;
+    } else {
+      continue;
+    }
+    Instruction* branch = isCall ? &i0[9] : &i0[0];
+    intptr_t disp = intptr_t(rp.target) - intptr_t(branch);
+    if (!JOffImm26::IsInRange(disp)) {
+      continue;
+    }
+    if (isCall) {
+      i0[9].setData(PPC_b | JOffImm26(disp).encode() | LinkB);
+      i0[0].setData(PPC_b | JOffImm26(9 * sizeof(Instruction)).encode());
+    } else {
+      i0[0].setData(PPC_b | JOffImm26(disp).encode());
+    }
+  }
+}

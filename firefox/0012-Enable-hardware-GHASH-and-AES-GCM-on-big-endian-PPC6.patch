 .set PT, 3
 .set CT, 4
@@ -1039,13 +1057,31 @@ addi	TOCP,TOCP,(.TOC.-ppc_aes_gcmCRYPT)@l
     ld           26,-48(SP);
     ld           25,-56(SP);
     blr
-.size ppc_aes_gcmCRYPT, . - ppc_aes_gcmCRYPT

         'dependencies': [
           'ghash.gyp:ghash-aes-ppc_c_lib',
         ],
@@ -46,6 +50,32 @@
           'HAVE_PLATFORM_GHASH'
         ]
       }],
+      # gcm.c must see the same __ALTIVEC__/__VSX__ visibility as

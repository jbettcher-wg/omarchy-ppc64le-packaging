# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Upstream maintainer: David Heinemeier Hansson <david@hey.com>
# Contributor: Antonio Rojas <arojas@archlinux.org>
# Contributor: tinywrkb <tinywrkb@gmail.com>
#
# Omarchy's fork of power-profiles-daemon: 0.30 plus profiles for NVIDIA RTX
# Spark and Snapdragon X CPUs. Omarchy 4.5's migration runs
# `pacman -S --ask 4 omarchy-power-profiles-daemon` to swap it in for
# power-profiles-daemon. Taken from upstream's own recipe
# (github.com/omacom/omarchy-pkgs, pkgbuilds/omarchy-power-profiles-daemon at
# 3280e02b7d5e) with its four patches; the version is Omarchy's stable channel
# (pkgs.omarchy.org/stable omarchy-power-profiles-daemon 0.30-3). omarchy-pkgs
# HEAD is at 0.30-9 with five more patches; this is the set stable carries.
#
# ppc64le: powerpc64le added to arch=(). The C has no architecture-specific
# code, and every driver the patches add is selected by name -- apple-cpufreq,
# scmi, qcom-cpufreq-hw, or cppc_cpufreq with an RTX Spark DMI processor
# record -- so on POWER (powernv-cpufreq, no DMI) the daemon probes exactly as
# our stock power-profiles-daemon 0.30-1 does. The git source's checksum was
# checked against makepkg's own computation (git archive of tag 0.30, commit
# 5b4994c8a912), and the patches against tag 0.30 in the order prepare()
# applies them.
#
# The swap: conflicts=(power-profiles-daemon) is what lets `pacman -S --ask 4`
# remove ours (--ask 4 answers the conflict question yes), and provides keeps
# anything that depends on power-profiles-daemon satisfied. provides is
# versioned, unlike upstream's, so a versioned dependency is satisfied too.
# There is deliberately no replaces=(): that would make every -Syu swap the
# daemon on its own, which is the migration's decision, not the repo's.

pkgname=omarchy-power-profiles-daemon
_pkgname=power-profiles-daemon
pkgver=0.30
pkgrel=1
pkgdesc='Makes power profiles handling available over D-Bus (with NVIDIA RTX Spark and Snapdragon X CPU profiles)'
url='https://gitlab.freedesktop.org/upower/power-profiles-daemon'
license=(GPL-3.0-only)
arch=(x86_64 aarch64 powerpc64le)
depends=(glib2
         glibc
         libgcc
         libgudev
         polkit
         upower)
optdepends=('python-gobject: for powerprofilesctl')
makedepends=(bash-completion
             git
             glib2-devel
             python-argparse-manpage
             python-shtab
             meson)
checkdepends=(python-dbusmock
              python-isort
              python-mccabe
              umockdev)
provides=("power-profiles-daemon=$pkgver")
conflicts=(power-profiles-daemon)
source=(git+https://gitlab.freedesktop.org/upower/$_pkgname#tag=$pkgver
        nvidia-rtx-spark-power-profiles.patch
        balanced-performance-spelling.patch
        cpufreq-boost-driver.patch
        cpufreq-caps.patch)
sha256sums=('e955e833b01cbff9b5b00349592239e58c559d717eb49f3371f42932676e7a40'
            '5c3e350afd1baf668aca5d64d9692ec816f72d90ed93aec1f655aeb0d75b2bf1'
            '5fa8b0073ee25fe8c655b23235445fee5d55a089650a17e89e0df9909f8173de'
            'd22145fec7c753f78b606a3de2437299d6ff74c33b8aa70b87cfd4ecda9225a0'
            '79c6958cd8b5642a238300f89cb2e2549a6fcc323b1933bf8cad5b2479ffd6c9')

prepare() {
  cd $_pkgname
  # NVIDIA's RTX Spark (N1X) cppc_cpufreq driver. It sets an energy
  # performance preference per core type, which only takes effect with CPPC
  # autonomous selection on (Omarchy's N1x setup turns it on with a udev rule,
  # as NVIDIA's power-knobs package does), and a governor per profile and power
  # source: schedutil, which lets the kernel's energy-aware scheduling run, in
  # power-saver and on battery in balanced, and performance otherwise.
  # Drop it once upstream merges it:
  # https://gitlab.freedesktop.org/upower/power-profiles-daemon/-/merge_requests/236
  patch -p1 -i "$srcdir/nvidia-rtx-spark-power-profiles.patch"

  # Merged upstream after 0.30 (!238, !237): accept the kernel's
  # balanced-performance spelling, and add a generic cpufreq driver that
  # uses the boost switch on Apple Silicon.
  patch -p1 -i "$srcdir/balanced-performance-spelling.patch"
  patch -p1 -i "$srcdir/cpufreq-boost-driver.patch"
  # Snapdragon X (scmi, qcom-cpufreq-hw) has no energy preference, so this
  # caps each cluster's maximum frequency: 60% in power-saver, 75% in
  # balanced, none in performance. Proposed upstream as !239.
  patch -p1 -i "$srcdir/cpufreq-caps.patch"
}

build() {
  meson $_pkgname build \
    --prefix /usr \
    --libexec lib \
    --sysconfdir /usr/share \
    -Dzshcomp=/usr/share/zsh/site-functions \
    -Dbashcomp=enabled \
    -Dmanpage=enabled
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # Run powerprofilesctl with the system Python, not whichever python3 a mise
  # or venv puts first on PATH, which lacks PyGObject.
  sed -i '1c #!/usr/bin/python3' "$pkgdir/usr/bin/powerprofilesctl"
}

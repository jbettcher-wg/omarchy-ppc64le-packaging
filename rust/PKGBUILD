# Contributor: userwithuid <userwithuid@gmail.com>
# ppc64le: Omarchy ppc64le -- see README.md.  Arch POWER's recipe, narrowed to
# little-endian POWER9: the big-endian ELFv2 hotfix and the powerpc/espresso
# branches are gone, and the shipped compiler is built -C target-cpu=pwr9.
# rustc-dev (1.99.1) is split out as Arch does (their bbcb9b5 + 44ca714):
# chromium 157's crubit links rustc's own crates, so it needs the compiler
# libraries that a plain install leaves out.

# LTO passes may not produce any output for quite some time
# especially on slower systems
apb_output_timeout=7200

pkgbase=rust
pkgname=(
  rust
  rust-src
  rust-wasm
  rustc-dev
)
epoch=1
pkgver=1.99.1
pkgrel=1
pkgdesc="Systems programming language focused on safety, speed and concurrency"
url=https://www.rust-lang.org/
arch=(powerpc64le)
license=("Apache-2.0 OR MIT")
options=(
  !emptydirs
  !lto
)
depends=(
  curl
  gcc
  gcc-libs
  libgit2
  libssh2
  llvm-libs
)
makedepends=(
  clang
  cmake
  libffi
  lld
  llvm
  llvm-libs
  ninja
  perl
  python
  rust
  wasi-libc
  wasm-component-ld
)
checkdepends=(
  gdb
  procps-ng
)
source=(
  # Upstream ships .tar.gz and .tar.xz of the same tree, each with its own
  # .asc from the same key; Arch POWER fetches the .gz, this takes the .xz.
  "https://static.rust-lang.org/dist/rustc-$pkgver-src.tar.xz"{,.asc}
  # Patch bootstrap so that rust-analyzer-proc-macro-srv
  # is in /usr/lib instead of /usr/libexec
  0001-bootstrap-Change-libexec-dir.patch

  # Put bash completions where they belong
  0002-bootstrap-Change-bash-completion-dir.patch

  # Fix build with system rustc
  # https://github.com/rust-lang/rust/issues/143735
  0003-bootstrap-Workaround-for-system-stage0.patch

  # Use our *-pc-linux-gnu targets, making LTO with clang simpler
  0004-compiler-Change-LLVM-targets.patch

  # Use our target-specific GCC linkers (aarch64-linux-gnu-gcc etc.); only
  # matters when cross-compiling to those targets
  0006-compiler-Use-target-specific-GCC-linkers.patch

  # Prefer "lib" over "lib64"
  0008-compiler-Swap-primary-and-secondary-lib-dirs.patch

  # The patch files are Arch's 1.99.1 set, unchanged (the b2sums match theirs).
  # Not taken: Arch's 0005 makes ld.lld the default linker flavor for every
  # target, ppc64le included, and this recipe links with gcc (lld = false
  # below); 0007 is riscv64-musl only. Arch POWER's hotfix-abi.powerpc64.elfv2
  # stays dropped: powerpc64le is ELFv2 upstream, it only ever fixed the
  # big-endian target.
)
b2sums=('b200e9114673449d5a3d227289e308f1a55450b3e887f7322324f2d9098407e03308eabc15084f90d3798f7af4a8c395da4a7973a23858af05a1f3b1de949cca'
        'SKIP'

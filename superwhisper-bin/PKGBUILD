# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Upstream maintainer: Omarchy <https://omarchy.org>
#
# Superwhisper, Omarchy 4.5's default dictation backend. Taken from upstream's
# own recipe (github.com/omacom/omarchy-pkgs, pkgbuilds/superwhisper-bin at
# 06dec62d15); the version is Omarchy's stable channel (pkgs.omarchy.org/stable
# superwhisper-bin 1.3.1-1). Omarchy's migrations compare versions against
# theirs, so our pkgrel stays above it.
#
# ppc64le: Superwhisper is closed source and published for x86_64 and aarch64
# only. POWER installs the vendor's signed aarch64 build and runs it under
# POWERarm, which every POWER install carries with its ArchLinuxARM-vk guest
# root. Everything ppc64le-specific is behind a CARCH test or in a
# *_powerpc64le array; x86_64 and aarch64 build exactly as upstream does.
# README.md explains each piece and the bump procedure:
#  - the aarch64 archive, verified with the same minisign key;
#  - the aarch64 libraries the guest root lacks (GTK4 for the recording pill
#    and tray icon, fontconfig and xkbcommon for the settings window), pinned
#    in guest.manifest by guest-resolve.py and served from POWERarm's
#    snapshot, since Arch Linux ARM keeps only the current version of each;
#  - a native python3 shim, so the helper scripts use the host's Python;
#  - a launcher that pins the vk guest root and sets the library path, and a
#    unit drop-in that waits for POWERarm to build that root;
#  - no fcitx5 addon: it is an aarch64 module for the host's native fcitx5.
#    Dictation is pasted instead.

pkgname=superwhisper-bin
pkgver=1.3.1
_version=1.3.1
pkgrel=1.1
pkgdesc='Local and cloud voice dictation with Superwhisper'
arch=('x86_64' 'aarch64' 'powerpc64le')
url='https://superwhisper.com'
license=('LicenseRef-proprietary' 'MIT')
provides=('superwhisper')
conflicts=('superwhisper')

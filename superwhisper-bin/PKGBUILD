for _i in "${!_guest_pkgs[@]}"; do
  source_powerpc64le+=("$_snapshot/${_guest_pkgs[_i]}")
  sha256sums_powerpc64le+=("${_guest_sha256[_i]}")
  noextract+=("${_guest_pkgs[_i]#*/}")
done
unset _i

prepare() {
  minisign -Vm "superwhisper-$pkgver-$_varch.tar.zst" -x "superwhisper-$pkgver-$_varch.tar.zst.minisig" -p linux-release.pub
  bsdtar -xf "superwhisper-$pkgver-$_varch.tar.zst"
  local bundle="superwhisper-omarchy-$_varch-$_version"
  [[ $(< "$bundle/VERSION") == "$_version" ]] || return 1
  # Qt 6.12 adds a Color type that shadows Omarchy's palette singleton.
  python - "superwhisper-omarchy-$_varch-$_version/app/assets/omarchy-plugin/superwhisper-panel" <<'PYTHON'
from pathlib import Path
import re
import sys

for path in Path(sys.argv[1]).glob("*.qml"):
  original = path.read_text()
  updated = re.sub(r"(?<![\w.])Color\b", "Commons.Color", original)
  if updated != original:
    alias = r"(?m)^import qs\.Commons(?: [0-9.]+)? as Commons[ \t]*$"
    if not re.search(alias, updated):
      updated, imports = re.subn(r"(?m)^(import qs\.Commons(?: [0-9.]+)?[ \t]*)$", r"\1\nimport qs.Commons as Commons", updated, count=1)
      if imports != 1:
        raise SystemExit(f"Cannot qualify palette import in {path}")
    if len(re.findall(alias, updated)) != 1 or re.search(r"(?<![\w.])Color\b", updated):
      raise SystemExit(f"Invalid palette references in {path}")
    path.write_text(updated)
PYTHON
  if [[ $CARCH == powerpc64le ]]; then
    _prepare_powerarm "$bundle"
  fi
}

# ppc64le: what the POWERarm launcher relies on in the vendor's archive. A
# release that changes any of it has to be looked at, not packaged.
_prepare_powerarm() {
  local app=$1/app
  # run.sh puts its own lib/ first and keeps ours behind it, then runs bin/.
  grep -Fq 'export LD_LIBRARY_PATH="$loop_dir/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"' "$app/run.sh" \
    || { error "run.sh no longer appends to LD_LIBRARY_PATH"; return 1; }
  grep -Fq 'exec "$loop_dir/bin/superwhisper" "$@"' "$app/run.sh" \
    || { error "run.sh no longer runs bin/superwhisper"; return 1; }
  # Every executable is the aarch64 build POWERarm runs.
  local f
  for f in "$app"/bin/*; do
    readelf -h "$f" | grep -q 'Machine:.*AArch64' \
      || { error "${f##*/} is not an aarch64 executable"; return 1; }
  done
}

build() {
  [[ $CARCH == powerpc64le ]] || return 0
  local bundle="superwhisper-omarchy-$_varch-$_version"

  # The guest libraries: from each pinned package, only the usr/lib members
  # guest-resolve.py found the aarch64 build needs (the library and its
  # soname symlink). Data files come from the host's /usr/share.
  rm -rf powerarm
  mkdir -p powerarm/lib powerarm/bin
  local i lib tmp members
  for i in "${!_guest_pkgs[@]}"; do
    members=()
    for lib in ${_guest_libs[i]}; do members+=("usr/lib/$lib"); done
    tmp=$(mktemp -d -p "$srcdir")
    bsdtar -xf "${_guest_pkgs[i]#*/}" -C "$tmp" "${members[@]}"
    cp -a "$tmp/usr/lib/." powerarm/lib/
    rm -rf "$tmp"
  done
  _check_guest_closure "$bundle/app" powerarm/lib

  # A native python3 for the helper scripts (host-python3.c says why).
  ${CC:-cc} $CPPFLAGS $CFLAGS $LDFLAGS -o powerarm/bin/python3 host-python3.c
}

# ppc64le: every library the aarch64 build loads must be in the vendor's lib/,
# in the guest libraries, or in the floor the guest root provides: glibc, the
# gcc runtime, and the GPU and thunked libraries (guest-resolve.py's FLOOR).
# This is what fails when a release needs something guest.manifest lacks.
_check_guest_closure() {
  local app=$1 lib=$2 f so missing=()
  local floor='^(ld-linux-aarch64\.so\.1|lib(c|m|dl|pthread|rt|resolv|util)\.so\.[0-9]+|libgcc_s\.so\.1|libstdc\+\+\.so\.6|libgomp\.so\.1|libatomic\.so\.1|libvulkan\.so\.1|lib(GL|GLX|EGL|OpenGL|GLdispatch)\.so\.[0-9]+|libgbm\.so\.1|libdrm(_[a-z0-9]+)?\.so\.[0-9]+|libwayland-[a-z]+\.so\.[0-9]+|libxshmfence\.so\.1|libasound\.so\.2)$'
  while IFS= read -r -d '' f; do
    [[ $(head -c4 "$f") == $'\x7fELF' ]] || continue
    while read -r so; do
      [[ $so =~ $floor || -e $app/lib/$so || -e $lib/$so ]] || missing+=("${f#"$srcdir"/}: $so")
    done < <(readelf -dW "$f" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p')
  done < <(find "$app/bin" "$app/lib" "$lib" -type f -not -path '*/lib/fcitx5/*' -print0)
  # Loaded with dlopen, so no DT_NEEDED names them.
  for so in libgtk4-layer-shell.so.0 libhunspell-1.7.so.0; do
    [[ -e $lib/$so ]] || missing+=("dlopen: $so")
  done
  if (( ${#missing[@]} )); then
    printf '  %s\n' "${missing[@]}" >&2
    error "the guest libraries do not cover the aarch64 build; rerun guest-resolve.py"
    return 1
  fi
}

package() {
  local bundle="superwhisper-omarchy-$_varch-$_version"
  install -dm755 "$pkgdir/opt/superwhisper"
  cp -a --no-preserve=ownership "$bundle/app/." "$pkgdir/opt/superwhisper/"
  # Omarchy owns its Dictation menu; omit the portable installer's menu writer.
  rm -f "$pkgdir/opt/superwhisper/scripts/omarchy-menu-rows.py"
  install -Dm755 superwhisper "$pkgdir/usr/bin/superwhisper"
  install -Dm644 superwhisper.service "$pkgdir/usr/lib/systemd/user/superwhisper.service"
  install -Dm644 superwhisper.desktop "$pkgdir/usr/share/applications/superwhisper.desktop"
  install -Dm644 superwhisper-url.desktop "$pkgdir/usr/share/applications/superwhisper-url.desktop"
  install -Dm755 setup-user "$pkgdir/usr/share/superwhisper/setup-user"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$bundle"/licenses/*
  install -Dm644 "$bundle/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$bundle/app/assets/linux-status/SuperwhisperTUI.ttf" "$pkgdir/usr/share/fonts/superwhisper/SuperwhisperTUI.ttf"
  for size in 16 32 64 128 256 512 1024; do
    install -Dm644 "$bundle/app/assets/app-icon/$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/superwhisper.png"
  done
  install -dm755 "$pkgdir/usr/share/fcitx5/addon"
  sed 's|@LIBRARY@|/opt/superwhisper/lib/fcitx5/libsuperwhisper-fcitx5|' \
    "$bundle/app/assets/fcitx5/superwhisper.conf.in" > "$pkgdir/usr/share/fcitx5/addon/superwhisper.conf"
  if [[ $CARCH == powerpc64le ]]; then
    _package_powerarm
  fi
}

_package_powerarm() {
  local opt=$pkgdir/opt/superwhisper
  # The fcitx5 addon is an aarch64 module for the host's native fcitx5, which
  # cannot load it. Without it Superwhisper pastes, as it does without fcitx5.
  rm -r "$opt/lib/fcitx5" "$pkgdir/usr/share/fcitx5"
  # Upstream's launcher stays as it is, behind ours.
  install -Dm755 superwhisper "$opt/powerarm/superwhisper"
  install -Dm755 superwhisper-powerarm "$pkgdir/usr/bin/superwhisper"
  install -Dm755 powerarm/bin/python3 "$opt/powerarm/bin/python3"
  cp -a --no-preserve=ownership powerarm/lib "$opt/powerarm/lib"
  install -Dm644 superwhisper-powerarm.conf "$pkgdir/usr/lib/systemd/user/superwhisper.service.d/powerarm.conf"
  install -Dm644 guest.manifest "$pkgdir/usr/share/doc/$pkgname/guest.manifest" 2>/dev/null || true
}
